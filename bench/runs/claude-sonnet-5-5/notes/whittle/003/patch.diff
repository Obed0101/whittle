diff --git a/notes/app.js b/notes/app.js
new file mode 100644
index 0000000..74819b7
--- /dev/null
+++ b/notes/app.js
@@ -0,0 +1,432 @@
+'use strict';
+const KEY = 'notes.v1';
+const VERSION = 1;
+const TRASH_DAYS = 30;
+const $ = s => document.querySelector(s);
+
+let data = { version: VERSION, notes: [], settings: { theme: 'auto', sort: 'updated' } };
+let readOnly = false;
+let view = 'all', query = '', selId = null, mode = 'edit';
+let saveTimer = null, toastTimer = null;
+
+/* ---------- storage ---------- */
+function normNote(n) {
+  const now = Date.now();
+  return {
+    id: String(n.id || uid()),
+    title: String(n.title || ''),
+    body: String(n.body || ''),
+    tags: Array.isArray(n.tags) ? [...new Set(n.tags.map(t => String(t).trim().toLowerCase()).filter(Boolean))] : [],
+    pinned: !!n.pinned,
+    archived: !!n.archived,
+    trashed: Number(n.trashed) || null,
+    created: Number(n.created) || now,
+    updated: Number(n.updated) || Number(n.created) || now,
+  };
+}
+function uid() { return crypto.randomUUID ? crypto.randomUUID() : Date.now().toString(36) + Math.random().toString(36).slice(2); }
+function parse(raw) {
+  const d = JSON.parse(raw);
+  const obj = Array.isArray(d) ? { notes: d } : d;
+  if (!obj || !Array.isArray(obj.notes)) throw new Error('bad format');
+  return obj;
+}
+function load() {
+  let raw;
+  try { raw = localStorage.getItem(KEY); } catch (e) { banner('Browser storage is unavailable; notes will not be saved. Use Export to keep a copy.'); return; }
+  if (!raw) return;
+  try {
+    const d = parse(raw);
+    if (d.version > VERSION) { readOnly = true; banner('These notes were saved by a newer version of the app. Editing is disabled to avoid data loss.'); }
+    data = { version: VERSION, notes: d.notes.map(normNote), settings: { ...data.settings, ...(d.settings || {}) } };
+  } catch (e) {
+    try { localStorage.setItem(KEY + '.corrupt', raw); } catch (_) {}
+    readOnly = true;
+    banner('Saved notes could not be read. The raw data was kept under "' + KEY + '.corrupt"; saving is disabled.');
+  }
+}
+function save() {
+  clearTimeout(saveTimer); saveTimer = null;
+  if (readOnly) return;
+  try {
+    localStorage.setItem(KEY, JSON.stringify(data));
+    $('#saved').textContent = 'Saved';
+  } catch (e) {
+    banner('Could not save (storage full or blocked). Export your notes to avoid losing changes.');
+    $('#saved').textContent = 'Not saved';
+  }
+}
+function scheduleSave() { $('#saved').textContent = 'Saving…'; clearTimeout(saveTimer); saveTimer = setTimeout(save, 300); }
+function banner(msg) { const b = $('#banner'); b.textContent = msg; b.hidden = false; }
+
+/* ---------- helpers ---------- */
+const byId = id => data.notes.find(n => n.id === id);
+const cur = () => (selId && byId(selId)) || null;
+function fmt(ts) {
+  const d = new Date(ts), now = new Date();
+  if (d.toDateString() === now.toDateString()) return d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
+  return d.toLocaleDateString([], { month: 'short', day: 'numeric', year: d.getFullYear() === now.getFullYear() ? undefined : 'numeric' });
+}
+function toast(msg, actionLabel, action) {
+  const t = $('#toast');
+  t.firstElementChild.textContent = msg;
+  const b = t.lastElementChild;
+  b.hidden = !action;
+  b.textContent = actionLabel || '';
+  b.onclick = () => { t.hidden = true; if (action) action(); };
+  t.hidden = false;
+  clearTimeout(toastTimer);
+  toastTimer = setTimeout(() => { t.hidden = true; }, 7000);
+}
+function isEmpty(n) { return !n.title.trim() && !n.body.trim() && !n.tags.length; }
+function visible() {
+  const q = query.trim().toLowerCase();
+  let list = data.notes.filter(n => {
+    if (view === 'trash') { if (!n.trashed) return false; }
+    else if (n.trashed) return false;
+    else if (view === 'archive') { if (!n.archived) return false; }
+    else if (q) { /* search spans archive too */ }
+    else if (n.archived) return false;
+    if (view.startsWith('tag:') && !n.tags.includes(view.slice(4))) return false;
+    if (q && !(n.title + '\n' + n.body + '\n' + n.tags.join(' ')).toLowerCase().includes(q)) return false;
+    return true;
+  });
+  const s = data.settings.sort;
+  list.sort((a, b) => {
+    if (view !== 'trash' && a.pinned !== b.pinned) return a.pinned ? -1 : 1;
+    if (s === 'title') return (a.title || 'zzz').localeCompare(b.title || 'zzz');
+    return b[s] - a[s];
+  });
+  return list;
+}
+
+/* ---------- markdown ---------- */
+function esc(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
+function inline(s) {
+  const codes = [];
+  s = esc(s).replace(/`([^`]+)`/g, (_, c) => { codes.push(c); return '\u0000' + (codes.length - 1) + '\u0000'; });
+  s = s.replace(/\[([^\]]+)\]\(((?:https?:\/\/|mailto:)[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>')
+    .replace(/(^|[\s(])(https?:\/\/[^\s<)]+)/g, '$1<a href="$2" target="_blank" rel="noopener noreferrer">$2</a>')
+    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
+    .replace(/(^|[^*\w])\*([^*\s][^*]*)\*/g, '$1<em>$2</em>')
+    .replace(/~~([^~]+)~~/g, '<del>$1</del>');
+  return s.replace(/\u0000(\d+)\u0000/g, (_, i) => '<code>' + codes[i] + '</code>');
+}
+function render(md) {
+  const L = md.split('\n'), out = [];
+  let i = 0;
+  while (i < L.length) {
+    const l = L[i];
+    let m;
+    if (/^```/.test(l)) {
+      const buf = []; i++;
+      while (i < L.length && !/^```/.test(L[i])) buf.push(L[i++]);
+      i++;
+      out.push('<pre><code>' + esc(buf.join('\n')) + '</code></pre>');
+    } else if ((m = /^(#{1,4})\s+(.*)/.exec(l))) { out.push(`<h${m[1].length}>${inline(m[2])}</h${m[1].length}>`); i++; }
+    else if (/^\s*([-*_])(\s*\1){2,}\s*$/.test(l)) { out.push('<hr>'); i++; }
+    else if (/^>/.test(l)) {
+      const buf = [];
+      while (i < L.length && /^>/.test(L[i])) buf.push(L[i++].replace(/^>\s?/, ''));
+      out.push('<blockquote>' + inline(buf.join('<br>')) + '</blockquote>');
+    } else if (/^\s*([-*+]|\d+\.)\s/.test(l)) {
+      const ordered = /^\s*\d+\./.test(l), items = [];
+      while (i < L.length && /^\s*([-*+]|\d+\.)\s/.test(L[i])) {
+        const t = /^\s*(?:[-*+]|\d+\.)\s+\[( |x)\]\s(.*)/i.exec(L[i]);
+        if (t) {
+          const done = t[1].toLowerCase() === 'x';
+          items.push(`<li class="task${done ? ' done' : ''}"><input type="checkbox" data-line="${i}"${done ? ' checked' : ''}> <span>${inline(t[2])}</span></li>`);
+        } else items.push('<li>' + inline(L[i].replace(/^\s*(?:[-*+]|\d+\.)\s+/, '')) + '</li>');
+        i++;
+      }
+      out.push((ordered ? '<ol>' : '<ul>') + items.join('') + (ordered ? '</ol>' : '</ul>'));
+    } else if (!l.trim()) i++;
+    else {
+      const buf = [];
+      while (i < L.length && L[i].trim() && !/^(```|#{1,4}\s|>|\s*([-*+]|\d+\.)\s)/.test(L[i])) buf.push(L[i++]);
+      out.push('<p>' + inline(buf.join('\n')).replace(/\n/g, '<br>') + '</p>');
+    }
+  }
+  return out.join('') || '<p class="empty">Nothing to preview.</p>';
+}
+
+/* ---------- rendering ---------- */
+const VIEW_NAMES = { all: 'All notes', archive: 'Archive', trash: 'Trash' };
+function renderSide() {
+  const live = data.notes.filter(n => !n.trashed);
+  const counts = { all: live.filter(n => !n.archived).length, archive: live.filter(n => n.archived).length, trash: data.notes.length - live.length };
+  document.querySelectorAll('#nav button').forEach(b => {
+    b.setAttribute('aria-current', String(b.dataset.view === view));
+    b.querySelector('.count').textContent = counts[b.dataset.view] || '';
+  });
+  const tags = {};
+  live.filter(n => !n.archived).forEach(n => n.tags.forEach(t => { tags[t] = (tags[t] || 0) + 1; }));
+  const nav = $('#tagNav');
+  nav.textContent = '';
+  const names = Object.keys(tags).sort();
+  if (!names.length) { const p = document.createElement('p'); p.className = 'hint'; p.textContent = 'No tags yet.'; nav.append(p); }
+  names.forEach(t => {
+    const b = document.createElement('button');
+    b.dataset.view = 'tag:' + t;
+    b.setAttribute('aria-current', String(view === 'tag:' + t));
+    const a = document.createElement('span'); a.textContent = '#' + t;
+    const c = document.createElement('span'); c.className = 'count'; c.textContent = tags[t];
+    b.append(a, c);
+    nav.append(b);
+  });
+  if (view.startsWith('tag:') && !tags[view.slice(4)]) { view = 'all'; renderAll(); }
+}
+function renderList() {
+  const list = visible(), ul = $('#list');
+  ul.textContent = '';
+  $('#viewTitle').textContent = query.trim() ? `Search: “${query.trim()}”` : view.startsWith('tag:') ? '#' + view.slice(4) : VIEW_NAMES[view];
+  $('#emptyTrash').hidden = view !== 'trash' || !list.length;
+  const e = $('#empty');
+  e.hidden = !!list.length;
+  e.textContent = query.trim() ? 'No notes match your search.' : view === 'trash' ? `Trash is empty. Deleted notes stay here for ${TRASH_DAYS} days.` : view === 'archive' ? 'No archived notes.' : view === 'all' ? 'No notes yet. Press “+ New” to write your first.' : 'No notes with this tag.';
+  for (const n of list) {
+    const li = document.createElement('li'), b = document.createElement('button');
+    b.className = 'item'; b.dataset.id = n.id;
+    b.setAttribute('aria-current', String(n.id === selId));
+    const t = document.createElement('div'); t.className = 't';
+    const tt = document.createElement('span'); tt.textContent = n.title.trim() || 'Untitled';
+    t.append(tt);
+    if (n.pinned) { const p = document.createElement('span'); p.textContent = '📌'; p.title = 'Pinned'; t.append(p); }
+    const s = document.createElement('div'); s.className = 's';
+    s.textContent = n.body.split('\n').find(x => x.trim()) || 'No content';
+    const d = document.createElement('div'); d.className = 'd';
+    const dt = document.createElement('span'); dt.textContent = fmt(n.updated);
+    d.append(dt);
+    n.tags.slice(0, 3).forEach(g => { const x = document.createElement('em'); x.textContent = '#' + g; d.append(x); });
+    b.append(t, s, d); li.append(b); ul.append(li);
+  }
+}
+function renderEditor(full) {
+  const n = cur();
+  $('#noNote').hidden = !!n;
+  $('#editor').hidden = !n;
+  document.body.dataset.pane = n ? 'editor' : 'list';
+  if (!n) return;
+  const trashed = !!n.trashed, ro = trashed || readOnly;
+  if (full) {
+    $('#title').value = n.title;
+    $('#body').value = n.body;
+  }
+  $('#title').readOnly = $('#body').readOnly = ro;
+  $('#tagInput').hidden = ro;
+  $('#pinBtn').textContent = n.pinned ? 'Unpin' : 'Pin';
+  $('#pinBtn').setAttribute('aria-pressed', String(n.pinned));
+  $('#archiveBtn').textContent = n.archived ? 'Unarchive' : 'Archive';
+  $('#delBtn').textContent = trashed ? 'Delete forever' : 'Delete';
+  $('#restoreBtn').hidden = !trashed;
+  $('#pinBtn').hidden = $('#archiveBtn').hidden = trashed;
+  $('#modeBtn').textContent = mode === 'edit' ? 'Preview' : 'Edit';
+  $('#body').hidden = mode !== 'edit';
+  $('#preview').hidden = mode === 'edit';
+  if (mode !== 'edit') $('#preview').innerHTML = render(n.body);
+  const tg = $('#tags');
+  tg.querySelectorAll('button').forEach(b => b.remove());
+  n.tags.forEach(t => {
+    const b = document.createElement('button');
+    b.textContent = '#' + t + (ro ? '' : ' ×'); b.dataset.tag = t;
+    b.setAttribute('aria-label', ro ? 'Tag ' + t : 'Remove tag ' + t);
+    b.disabled = ro;
+    tg.insertBefore(b, $('#tagInput'));
+  });
+  updateMeta();
+}
+function updateMeta() {
+  const n = cur(); if (!n) return;
+  const words = (n.body.match(/\S+/g) || []).length;
+  $('#meta').textContent = `${words} word${words === 1 ? '' : 's'} · ${n.body.length} chars · edited ${fmt(n.updated)} · created ${fmt(n.created)}` + (n.trashed ? ' · in trash' : '');
+}
+function renderAll(full) { renderSide(); renderList(); renderEditor(full); applyTheme(); $('#sort').value = data.settings.sort; }
+
+/* ---------- actions ---------- */
+function touch(n) { n.updated = Date.now(); scheduleSave(); }
+function select(id, full = true) {
+  const prev = cur();
+  if (prev && prev.id !== id && isEmpty(prev) && !prev.trashed) data.notes = data.notes.filter(n => n !== prev);
+  selId = id;
+  renderAll(full);
+}
+function newNote() {
+  if (readOnly) return;
+  if (view === 'trash' || view === 'archive') view = 'all';
+  query = ''; $('#search').value = '';
+  const n = normNote({ id: uid(), tags: view.startsWith('tag:') ? [view.slice(4)] : [] });
+  data.notes.push(n);
+  mode = 'edit';
+  save();
+  select(n.id);
+  $('#title').focus();
+}
+function nextAfter(n) {
+  const l = visible(), i = l.indexOf(n);
+  return (l[i + 1] || l[i - 1] || {}).id || null;
+}
+function leave(n) { const nx = nextAfter(n); return nx; }
+function trash(n) {
+  const nx = leave(n);
+  n.trashed = Date.now();
+  save(); selId = nx; renderAll(true);
+  toast('Note moved to trash', 'Undo', () => { n.trashed = null; save(); selId = n.id; renderAll(true); });
+}
+function restore(n) {
+  const nx = leave(n);
+  n.trashed = null; save(); selId = nx; renderAll(true);
+  toast('Note restored', 'Undo', () => { n.trashed = Date.now(); save(); renderAll(true); });
+}
+function purge(n) {
+  if (!confirm('Delete this note forever? This cannot be undone.')) return;
+  const nx = leave(n);
+  data.notes = data.notes.filter(x => x !== n);
+  save(); selId = nx; renderAll(true);
+}
+function toggleArchive(n) {
+  const nx = leave(n), was = n.archived;
+  n.archived = !was; save(); selId = view === 'all' || view === 'archive' || view.startsWith('tag:') ? nx : n.id;
+  renderAll(true);
+  toast(was ? 'Note unarchived' : 'Note archived', 'Undo', () => { n.archived = was; save(); selId = n.id; renderAll(true); });
+}
+function addTag(raw) {
+  const n = cur(); if (!n || n.trashed || readOnly) return;
+  const t = raw.trim().replace(/^#/, '').toLowerCase().replace(/\s+/g, '-');
+  if (!t || n.tags.includes(t)) return;
+  n.tags.push(t); touch(n); renderAll(false);
+}
+function download(name, text, type) {
+  const a = document.createElement('a');
+  a.href = URL.createObjectURL(new Blob([text], { type }));
+  a.download = name;
+  document.body.append(a); a.click(); a.remove();
+  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
+}
+const stamp = () => new Date().toISOString().slice(0, 10);
+function applyTheme() {
+  const t = data.settings.theme;
+  const dark = t === 'dark' || (t === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
+  document.documentElement.dataset.dark = dark ? '1' : '0';
+  $('#themeBtn').textContent = 'Theme: ' + t;
+}
+function purgeOld() {
+  const cutoff = Date.now() - TRASH_DAYS * 864e5;
+  const keep = data.notes.filter(n => !n.trashed || n.trashed > cutoff);
+  if (keep.length !== data.notes.length) { data.notes = keep; save(); }
+}
+function goBack() {
+  if (document.body.classList.contains('menu-open')) return closeMenu();
+  const n = cur();
+  if (n && isEmpty(n)) data.notes = data.notes.filter(x => x !== n);
+  selId = null; renderAll();
+}
+function closeMenu() { document.body.classList.remove('menu-open'); $('#scrim').hidden = true; }
+
+/* ---------- events ---------- */
+$('#newBtn').onclick = newNote;
+$('#search').oninput = e => { query = e.target.value; renderList(); };
+$('#sort').onchange = e => { data.settings.sort = e.target.value; save(); renderList(); };
+$('#list').onclick = e => { const b = e.target.closest('.item'); if (b) select(b.dataset.id); };
+$('#list').onkeydown = e => {
+  if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
+  const items = [...document.querySelectorAll('.item')], i = items.indexOf(document.activeElement);
+  if (i < 0) return;
+  e.preventDefault();
+  (items[i + (e.key === 'ArrowDown' ? 1 : -1)] || items[i]).focus();
+};
+function navClick(e) {
+  const b = e.target.closest('button'); if (!b) return;
+  view = b.dataset.view; query = ''; $('#search').value = '';
+  if (cur() && !visible().includes(cur())) selId = null;
+  closeMenu(); renderAll(true);
+}
+$('#nav').onclick = $('#tagNav').onclick = navClick;
+$('#menuBtn').onclick = () => { document.body.classList.add('menu-open'); $('#scrim').hidden = false; };
+$('#scrim').onclick = closeMenu;
+$('#backBtn').onclick = goBack;
+$('#themeBtn').onclick = () => { const o = ['auto', 'light', 'dark']; data.settings.theme = o[(o.indexOf(data.settings.theme) + 1) % 3]; save(); applyTheme(); };
+$('#title').oninput = e => { const n = cur(); if (!n || n.trashed) return; n.title = e.target.value; touch(n); renderList(); updateMeta(); };
+$('#body').oninput = e => { const n = cur(); if (!n || n.trashed) return; n.body = e.target.value; touch(n); renderList(); updateMeta(); };
+$('#pinBtn').onclick = () => { const n = cur(); n.pinned = !n.pinned; touch(n); renderAll(false); };
+$('#modeBtn').onclick = () => { mode = mode === 'edit' ? 'preview' : 'edit'; renderEditor(false); if (mode === 'edit') $('#body').focus(); };
+$('#archiveBtn').onclick = () => toggleArchive(cur());
+$('#delBtn').onclick = () => { const n = cur(); n.trashed ? purge(n) : trash(n); };
+$('#restoreBtn').onclick = () => restore(cur());
+$('#mdBtn').onclick = () => {
+  const n = cur(), name = (n.title.trim() || 'note').replace(/[\\/:*?"<>|]+/g, '-').slice(0, 80);
+  download(name + '.md', (n.title.trim() ? '# ' + n.title.trim() + '\n\n' : '') + n.body + '\n', 'text/markdown');
+};
+$('#emptyTrash').onclick = () => {
+  const gone = data.notes.filter(n => n.trashed);
+  if (!gone.length || !confirm(`Permanently delete ${gone.length} note(s) in the trash?`)) return;
+  data.notes = data.notes.filter(n => !n.trashed); selId = null; save(); renderAll(true);
+  toast('Trash emptied', 'Undo', () => { data.notes.push(...gone); save(); renderAll(true); });
+};
+$('#preview').onclick = e => {
+  const c = e.target.closest('input[type=checkbox]'), n = cur();
+  if (!c || !n || n.trashed || readOnly) return;
+  const L = n.body.split('\n'), i = +c.dataset.line;
+  L[i] = L[i].replace(/\[( |x)\]/i, c.checked ? '[x]' : '[ ]');
+  n.body = L.join('\n'); touch(n); renderEditor(true); renderList();
+};
+$('#tags').onclick = e => {
+  const b = e.target.closest('button'), n = cur(); if (!b || !n) return;
+  n.tags = n.tags.filter(t => t !== b.dataset.tag); touch(n); renderAll(false);
+};
+$('#tagInput').onkeydown = e => {
+  const i = e.target;
+  if (e.key === 'Enter' || e.key === ',') { e.preventDefault(); addTag(i.value); i.value = ''; $('#tagInput').focus(); }
+  else if (e.key === 'Backspace' && !i.value) { const n = cur(); if (n && n.tags.length) { n.tags.pop(); touch(n); renderAll(false); $('#tagInput').focus(); } }
+};
+$('#tagInput').onblur = e => { if (e.target.value.trim()) { addTag(e.target.value); e.target.value = ''; } };
+
+$('#exportBtn').onclick = () => download(`notes-backup-${stamp()}.json`, JSON.stringify(data, null, 2), 'application/json');
+$('#importBtn').onclick = () => $('#importFile').click();
+$('#importFile').onchange = async e => {
+  const f = e.target.files[0]; e.target.value = '';
+  if (!f || readOnly) return;
+  try {
+    const d = parse(await f.text());
+    if (d.version > VERSION) throw new Error('newer');
+    let added = 0, updated = 0;
+    for (const raw of d.notes) {
+      const n = normNote(raw), ex = byId(n.id);
+      if (!ex) { data.notes.push(n); added++; }
+      else if (n.updated > ex.updated) { Object.assign(ex, n); updated++; }
+    }
+    save(); renderAll(true);
+    toast(`Imported ${added} new, ${updated} updated`);
+  } catch (err) {
+    toast('Import failed: not a valid notes backup file');
+  }
+};
+
+document.addEventListener('keydown', e => {
+  const mod = e.ctrlKey || e.metaKey, k = e.key.toLowerCase();
+  const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName);
+  if (mod && k === 'n') { e.preventDefault(); newNote(); }
+  else if (mod && k === 'k') { e.preventDefault(); document.body.dataset.pane = 'list'; $('#search').focus(); $('#search').select(); }
+  else if (mod && k === 'e' && cur()) { e.preventDefault(); $('#modeBtn').click(); }
+  else if (!typing && !mod && e.key === '/') { e.preventDefault(); $('#search').focus(); }
+  else if (e.key === 'Escape') {
+    if (document.activeElement === $('#search') && query) { query = ''; $('#search').value = ''; renderList(); }
+    else if (cur() || document.body.classList.contains('menu-open')) goBack();
+  }
+});
+window.addEventListener('beforeunload', () => { if (saveTimer) save(); });
+document.addEventListener('visibilitychange', () => { if (document.hidden && saveTimer) save(); });
+matchMedia('(prefers-color-scheme: dark)').addEventListener('change', applyTheme);
+window.addEventListener('storage', e => {
+  if (e.key !== KEY || readOnly) return;
+  const editing = cur() && (document.activeElement === $('#title') || document.activeElement === $('#body'));
+  try {
+    const d = parse(e.newValue || '{"notes":[]}');
+    data = { version: VERSION, notes: d.notes.map(normNote), settings: { ...data.settings, ...(d.settings || {}) } };
+  } catch (_) { return; }
+  if (selId && !cur()) selId = null;
+  renderAll(!editing);
+});
+
+load();
+purgeOld();
+renderAll(true);
