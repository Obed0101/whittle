+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="color-scheme" content="light dark">
+<title>Notes</title>
+<link rel="stylesheet" href="style.css">
+</head>
+<body data-pane="list">
+<div id="banner" role="alert" hidden></div>
+<div class="app">
+  <div id="scrim" hidden></div>
+  <aside id="sidebar" aria-label="Navigation">
+    <h1>Notes</h1>
+    <nav id="nav" aria-label="Views">
+      <button data-view="all">All notes <span class="count"></span></button>
+      <button data-view="archive">Archive <span class="count"></span></button>
+      <button data-view="trash">Trash <span class="count"></span></button>
+    </nav>
+    <h2>Tags</h2>
+    <nav id="tagNav" aria-label="Tags"></nav>
+    <div class="side-foot">
+      <button id="themeBtn" title="Switch theme"></button>
+      <button id="exportBtn">Export all</button>
+      <button id="importBtn">Import</button>
+      <input type="file" id="importFile" accept="application/json,.json" hidden>
+      <p class="hint">Shortcuts: <kbd>Ctrl/⌘ N</kbd> new, <kbd>Ctrl/⌘ K</kbd> or <kbd>/</kbd> search, <kbd>Ctrl/⌘ E</kbd> edit/preview, <kbd>Esc</kbd> back.</p>
+    </div>
+  </aside>
+
+  <section id="listpane" aria-label="Note list">
+    <div class="list-head">
+      <button id="menuBtn" class="icon" aria-label="Open menu">☰</button>
+      <input id="search" type="search" placeholder="Search notes…" aria-label="Search notes">
+      <button id="newBtn" class="primary" title="New note (Ctrl/⌘ N)">+ New</button>
+    </div>
+    <div class="list-sub">
+      <strong id="viewTitle"></strong>
+      <label>Sort
+        <select id="sort" aria-label="Sort notes">
+          <option value="updated">Last edited</option>
+          <option value="created">Created</option>
+          <option value="title">Title</option>
+        </select>
+      </label>
+      <button id="emptyTrash" hidden>Empty trash</button>
+    </div>
+    <ul id="list" aria-label="Notes"></ul>
+    <p id="empty" class="empty" hidden></p>
+  </section>
+
+  <main id="editorpane" aria-label="Editor">
+    <div id="noNote" class="empty big">Select a note or create a new one.</div>
+    <div id="editor" hidden>
+      <div class="toolbar">
+        <button id="backBtn" class="icon" aria-label="Back to list">←</button>
+        <button id="pinBtn" aria-pressed="false"></button>
+        <button id="modeBtn" title="Toggle edit / preview (Ctrl/⌘ E)"></button>
+        <button id="archiveBtn"></button>
+        <button id="mdBtn" title="Download as Markdown">Export .md</button>
+        <button id="delBtn" class="danger"></button>
+        <button id="restoreBtn" hidden>Restore</button>
+      </div>
+      <input id="title" placeholder="Title" aria-label="Title" maxlength="200">
+      <div id="tags" class="tags"><input id="tagInput" placeholder="Add tag…" aria-label="Add tag" maxlength="40"></div>
+      <textarea id="body" placeholder="Write something… Markdown supported: # headings, **bold**, *italic*, `code`, - [ ] tasks, lists, > quotes, [links](https://…)" aria-label="Note body"></textarea>
+      <div id="preview" class="preview" hidden></div>
+      <div class="status"><span id="meta"></span><span id="saved"></span></div>
+    </div>
+  </main>
+</div>
+<div id="toast" role="status" aria-live="polite" hidden><span></span><button></button></div>
+<script src="app.js"></script>
+</body>
+</html>
diff --git a/notes/style.css b/notes/style.css
new file mode 100644
index 0000000..14ecb3d
--- /dev/null
+++ b/notes/style.css
@@ -0,0 +1,97 @@
+:root {
+  --bg: #f6f6f4; --panel: #ffffff; --side: #efefeb; --text: #1d1d1b; --muted: #6b6b66;
+  --line: #dcdcd6; --accent: #2f6fed; --accent-text: #fff; --sel: #e6eefe; --danger: #c42b2b;
+  --code: #eeeeea; --toast: #1d1d1b; --toast-text: #fff;
+}
+:root[data-dark="1"] {
+  --bg: #161617; --panel: #1e1e20; --side: #19191b; --text: #e8e8e4; --muted: #9a9a94;
+  --line: #333336; --accent: #6b9bff; --accent-text: #0c1424; --sel: #26324d; --danger: #ff7b7b;
+  --code: #2a2a2d; --toast: #e8e8e4; --toast-text: #161617;
+}
+* { box-sizing: border-box; }
+html, body { height: 100%; margin: 0; }
+body { font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; background: var(--bg); color: var(--text); }
+button, input, select, textarea { font: inherit; color: inherit; }
+button { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 5px 10px; cursor: pointer; }
+button:hover { border-color: var(--muted); }
+button.primary { background: var(--accent); color: var(--accent-text); border-color: var(--accent); }
+button.danger { color: var(--danger); }
+button.icon { padding: 5px 9px; }
+button[aria-pressed="true"] { background: var(--sel); border-color: var(--accent); }
+:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
+[hidden] { display: none !important; }
+kbd { background: var(--code); border-radius: 3px; padding: 0 4px; font-size: 12px; }
+
+.app { display: grid; grid-template-columns: 220px 320px 1fr; height: 100%; }
+#sidebar { background: var(--side); border-right: 1px solid var(--line); padding: 14px 10px; overflow-y: auto; display: flex; flex-direction: column; gap: 4px; }
+#sidebar h1 { font-size: 20px; margin: 0 6px 10px; }
+#sidebar h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 14px 6px 4px; }
+#sidebar nav { display: flex; flex-direction: column; gap: 2px; }
+#sidebar nav button { text-align: left; border: 0; background: none; display: flex; justify-content: space-between; padding: 6px 8px; }
+#sidebar nav button:hover { background: var(--sel); }
+#sidebar nav button[aria-current="true"] { background: var(--sel); font-weight: 600; }
+.count { color: var(--muted); font-weight: 400; }
+.side-foot { margin-top: auto; display: flex; flex-direction: column; gap: 6px; padding-top: 14px; }
+.hint { font-size: 12px; color: var(--muted); margin: 6px 2px 0; }
+
+#listpane { background: var(--panel); border-right: 1px solid var(--line); display: flex; flex-direction: column; min-height: 0; }
+.list-head { display: flex; gap: 6px; padding: 10px; }
+.list-head input { flex: 1; min-width: 0; }
+#menuBtn, #backBtn { display: none; }
+input[type=search], #title, #tagInput, select { background: var(--bg); border: 1px solid var(--line); border-radius: 6px; padding: 6px 9px; }
+.list-sub { display: flex; align-items: center; gap: 8px; padding: 0 10px 8px; font-size: 13px; color: var(--muted); }
+.list-sub strong { color: var(--text); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.list-sub select { padding: 2px 4px; font-size: 13px; }
+#list { list-style: none; margin: 0; padding: 0; overflow-y: auto; flex: 1; }
+#list li { border-top: 1px solid var(--line); }
+.item { display: block; width: 100%; text-align: left; border: 0; border-radius: 0; background: none; padding: 10px 12px; }
+.item[aria-current="true"] { background: var(--sel); }
+.item .t { font-weight: 600; display: flex; gap: 6px; }
+.item .t span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.item .s { color: var(--muted); font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.item .d { color: var(--muted); font-size: 12px; display: flex; gap: 8px; }
+.item .d em { font-style: normal; color: var(--accent); }
+.empty { color: var(--muted); text-align: center; padding: 30px 16px; }
+.empty.big { margin-top: 20vh; }
+
+#editorpane { min-width: 0; min-height: 0; background: var(--panel); }
+#editor { display: flex; flex-direction: column; height: 100%; padding: 10px 24px 8px; gap: 8px; }
+.toolbar { display: flex; flex-wrap: wrap; gap: 6px; }
+#title { font-size: 22px; font-weight: 700; background: none; border: 0; border-bottom: 1px solid var(--line); border-radius: 0; padding: 6px 0; }
+.tags { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
+.tags button { border-radius: 99px; padding: 1px 9px; font-size: 13px; background: var(--sel); }
+.tags input { border-radius: 99px; padding: 1px 10px; font-size: 13px; width: 120px; }
+#body { flex: 1; resize: none; border: 0; background: none; outline: 0; line-height: 1.6; min-height: 0; padding: 4px 0; font-family: inherit; }
+.preview { flex: 1; overflow-y: auto; line-height: 1.6; }
+.preview h1, .preview h2, .preview h3, .preview h4 { margin: 1em 0 .4em; line-height: 1.25; }
+.preview p, .preview ul, .preview ol, .preview blockquote, .preview pre { margin: .5em 0; }
+.preview code { background: var(--code); padding: 1px 4px; border-radius: 4px; font-size: .92em; }
+.preview pre { background: var(--code); padding: 10px; border-radius: 6px; overflow-x: auto; }
+.preview pre code { padding: 0; background: none; }
+.preview blockquote { border-left: 3px solid var(--line); padding-left: 12px; color: var(--muted); }
+.preview a { color: var(--accent); }
+.preview hr { border: 0; border-top: 1px solid var(--line); }
+.preview li.task { list-style: none; margin-left: -1.2em; }
+.preview li.task.done span { text-decoration: line-through; color: var(--muted); }
+.status { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); }
+
+#banner { background: var(--danger); color: #fff; padding: 8px 14px; position: fixed; top: 0; left: 0; right: 0; z-index: 30; text-align: center; }
+#toast { position: fixed; bottom: 18px; left: 50%; transform: translateX(-50%); background: var(--toast); color: var(--toast-text); padding: 8px 14px; border-radius: 8px; display: flex; gap: 12px; align-items: center; z-index: 20; box-shadow: 0 4px 16px #0004; }
+#toast button { background: none; color: inherit; border-color: currentColor; padding: 1px 8px; }
+#scrim { position: fixed; inset: 0; background: #0006; z-index: 9; }
+
+@media (max-width: 1000px) {
+  .app { grid-template-columns: 320px 1fr; }
+  #sidebar { position: fixed; inset: 0 auto 0 0; width: 250px; z-index: 10; transform: translateX(-100%); visibility: hidden; transition: transform .2s, visibility .2s; }
+  body.menu-open #sidebar { transform: none; visibility: visible; }
+  #menuBtn { display: block; }
+}
+@media (max-width: 700px) {
+  .app { grid-template-columns: 1fr; }
+  #editorpane, #listpane { grid-area: 1 / 1; }
+  body[data-pane="list"] #editorpane, body[data-pane="editor"] #listpane { display: none; }
+  #backBtn { display: block; }
+  #editor { padding: 10px 14px 8px; }
+  button, input, select { min-height: 38px; }
+}
+@media (prefers-reduced-motion: reduce) { * { transition: none !important; scroll-behavior: auto !important; } }
