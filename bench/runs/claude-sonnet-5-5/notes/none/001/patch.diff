+  scheduleSave(); renderList(); updateFoot(n); renderMode();
+}
+
+function setMode(m) { prefs.mode = m; writeNow(); renderMode(); if (m === 'edit' && current() && !current().trashedAt) el.body.focus(); }
+
+/* ---------- import / export ---------- */
+function download(name, text, type) {
+  const a = document.createElement('a');
+  a.href = URL.createObjectURL(new Blob([text], { type }));
+  a.download = name; document.body.append(a); a.click(); a.remove();
+  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
+}
+function exportAll() {
+  writeNow();
+  const d = new Date().toISOString().slice(0, 10);
+  download(`notes-backup-${d}.json`, JSON.stringify({ app: 'notes', version: 1, exported: Date.now(), notes }, null, 2), 'application/json');
+  toast(`Exported ${notes.length} notes`);
+}
+function exportMarkdown() {
+  const n = current(); if (!n) return;
+  const name = (n.title.trim() || 'untitled').replace(/[\\/:*?"<>|]+/g, '-').slice(0, 80) + '.md';
+  download(name, (n.title.trim() ? '# ' + n.title.trim() + '\n\n' : '') + n.body + '\n', 'text/markdown');
+}
+function importFile(file) {
+  const r = new FileReader();
+  r.onload = () => {
+    try {
+      const data = JSON.parse(r.result);
+      const arr = Array.isArray(data) ? data : data.notes;
+      if (!Array.isArray(arr)) throw new Error('bad format');
+      let added = 0, updated = 0;
+      for (const raw of arr) {
+        if (!raw || typeof raw !== 'object') continue;
+        const n = normalize(raw);
+        const ex = byId(n.id);
+        if (!ex) { notes.push(n); added++; }
+        else if (n.updated > ex.updated) { Object.assign(ex, n); updated++; }
+      }
+      writeNow(); renderAll();
+      toast(`Imported: ${added} new, ${updated} updated`);
+    } catch (e) { toast('That file is not a valid notes backup.'); }
+  };
+  r.readAsText(file);
+}
+
+/* ---------- theme ---------- */
+const mq = window.matchMedia('(prefers-color-scheme: dark)');
+function applyTheme() {
+  const dark = prefs.theme === 'dark' || (prefs.theme === 'auto' && mq.matches);
+  document.documentElement.dataset.eff = dark ? 'dark' : 'light';
+}
+
+/* ---------- events ---------- */
+function bind() {
+  $('#newBtn').onclick = $('#emptyNew').onclick = newNote;
+  el.views.onclick = (e) => { const b = e.target.closest('button'); if (b) setView(b.dataset.view); };
+  el.tags.onclick = (e) => { const b = e.target.closest('button'); if (b) setView('tag:' + b.dataset.tag); };
+  el.list.onclick = (e) => { const b = e.target.closest('.item'); if (b) select(b.dataset.id); };
+  el.list.onkeydown = (e) => {
+    if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
+    e.preventDefault();
+    const items = [...el.list.querySelectorAll('.item')];
+    const i = items.indexOf(document.activeElement);
+    const next = items[Math.max(0, Math.min(items.length - 1, i + (e.key === 'ArrowDown' ? 1 : -1)))];
+    if (next) { select(next.dataset.id); el.list.querySelector(`.item[data-id="${next.dataset.id}"]`)?.focus(); }
+  };
+  el.search.oninput = () => {
+    query = el.search.value; renderList();
+    const items = visibleNotes();
+    if (items.length && !items.some((n) => n.id === currentId)) { currentId = items[0].id; renderSidebar(); renderEditor(); if (isMobile()) el.app.dataset.pane = 'list'; }
+  };
+  el.search.onkeydown = (e) => { if (e.key === 'Escape') { el.search.value = ''; el.search.oninput(); el.search.blur(); } if (e.key === 'Enter') { const f = visibleNotes()[0]; if (f) select(f.id, { focus: true }); } };
+  el.sort.value = prefs.sort;
+  el.sort.onchange = () => { prefs.sort = el.sort.value; writeNow(); renderList(); };
+
+  el.title.oninput = el.body.oninput = onEdit;
+  el.title.onkeydown = (e) => { if (e.key === 'Enter') { e.preventDefault(); el.body.focus(); } };
+  el.body.onkeydown = onBodyKey;
+  el.tagInput.onkeydown = (e) => {
+    if (e.key === 'Enter' || e.key === ',') { e.preventDefault(); addTag(el.tagInput.value); el.tagInput.value = ''; }
+    else if (e.key === 'Backspace' && !el.tagInput.value) { const n = current(); if (n && n.tags.length) removeTag(n.tags[n.tags.length - 1]); }
+  };
+  el.tagInput.onchange = () => { if (el.tagInput.value) { addTag(el.tagInput.value); el.tagInput.value = ''; } };
+  el.tagInput.onblur = () => { if (el.tagInput.value.trim()) { addTag(el.tagInput.value); el.tagInput.value = ''; } };
+  el.tagBox.onclick = (e) => { const b = e.target.closest('[data-rm]'); if (b) removeTag(b.dataset.rm); else if (!e.target.closest('input')) el.tagInput.focus(); };
+  el.preview.onclick = (e) => { const c = e.target.closest('input[type=checkbox]'); if (c) { e.preventDefault(); toggleCheckbox(+c.dataset.line); } };
+
+  $('#editMode').onclick = () => setMode('edit');
+  $('#previewMode').onclick = () => setMode('preview');
+  $('#pinBtn').onclick = togglePin;
+  $('#archiveBtn').onclick = toggleArchive;
+  $('#deleteBtn').onclick = trashNote;
+  $('#restoreBtn').onclick = restoreNote;
+  $('#purgeBtn').onclick = purgeNote;
+  $('#mdBtn').onclick = exportMarkdown;
+  $('#backBtn').onclick = () => { dropIfEmpty(); renderAll(); el.app.dataset.pane = 'list'; };
+  $('#menuBtn').onclick = () => { el.app.dataset.pane = 'menu'; };
+
+  $('#themeBtn').onclick = () => { prefs.theme = { auto: 'light', light: 'dark', dark: 'auto' }[prefs.theme]; applyTheme(); writeNow(); renderSidebar(); };
+  mq.addEventListener('change', applyTheme);
+  $('#exportBtn').onclick = exportAll;
+  $('#importBtn').onclick = () => $('#importFile').click();
+  $('#importFile').onchange = (e) => { if (e.target.files[0]) importFile(e.target.files[0]); e.target.value = ''; };
+  $('#helpBtn').onclick = () => $('#help').showModal();
+
+  document.addEventListener('keydown', (e) => {
+    const mod = e.metaKey || e.ctrlKey;
+    const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName);
+    if (e.altKey && !mod && e.code === 'KeyN') { e.preventDefault(); newNote(); }
+    else if (mod && !e.shiftKey && e.key.toLowerCase() === 'e' && current()) { e.preventDefault(); setMode(prefs.mode === 'edit' ? 'preview' : 'edit'); }
+    else if (e.key === '/' && !typing && !mod) { e.preventDefault(); if (isMobile()) el.app.dataset.pane = 'list'; el.search.focus(); el.search.select(); }
+  });
+
+  window.addEventListener('beforeunload', () => { if (saveTimer) writeNow(); });
+  document.addEventListener('visibilitychange', () => { if (document.hidden && saveTimer) writeNow(); });
+  window.addEventListener('storage', (e) => {
+    if (e.key !== NOTES_KEY) return;
+    if (saveTimer) writeNow();
+    try { notes = JSON.parse(e.newValue || '[]').map(normalize); } catch (_) { return; }
+    if (currentId && !byId(currentId)) currentId = null;
+    renderAll();
+  });
+}
+
+/* ---------- init ---------- */
+function init() {
+  load();
+  applyTheme();
+  bind();
+  const first = visibleNotes()[0];
+  currentId = first ? first.id : null;
+  el.app.dataset.pane = 'list';
+  renderAll();
+  if (!notes.length && !prefs.seeded) {
+    prefs.seeded = true;
+    const now = Date.now();
+    notes.push(normalize({
+      id: uid(), created: now, updated: now, tags: ['welcome'], pinned: true,
+      title: 'Welcome to Notes',
+      body: '# Welcome\n\nEverything is saved automatically in this browser.\n\n- Write in **Markdown** (switch to Preview with Ctrl/⌘+E)\n- Add #tags, pin, archive, and search everything\n- Deleted notes stay in Trash for 30 days\n\n## Checklist\n\n- [ ] Create your first note\n- [x] Open the app\n\n> Tip: use **Export backup** in the sidebar regularly — browser storage can be cleared.\n',
+    }));
+    currentId = notes[0].id; writeNow(); renderAll();
+  }
+}
+init();
+})();
diff --git a/notes/index.html b/notes/index.html
new file mode 100644
index 0000000..d228574
--- /dev/null
