+(() => {
+'use strict';
+
+const NOTES_KEY = 'notes-app.v1.notes';
+const PREFS_KEY = 'notes-app.v1.prefs';
+const TRASH_DAYS = 30;
+
+const $ = (s) => document.querySelector(s);
+const el = {
+  app: $('#app'), views: $('#views'), tags: $('#tags'), list: $('#list'), search: $('#search'),
+  sort: $('#sort'), viewTitle: $('#viewTitle'), editor: $('#editor'), empty: $('#emptyState'),
+  title: $('#title'), body: $('#body'), preview: $('#preview'), tagBox: $('#tagBox'),
+  tagInput: $('#tagInput'), tagSuggest: $('#tagSuggest'), status: $('#status'), foot: $('#foot'),
+  toast: $('#toast'),
+};
+
+let notes = [];
+let prefs = { theme: 'auto', sort: 'updated', mode: 'edit' };
+let view = 'all';           // all | pinned | archive | trash | tag:<name>
+let query = '';
+let currentId = null;
+let saveTimer = null;
+let toastTimer = null;
+let storageOk = true;
+
+/* ---------- utils ---------- */
+const esc = (s) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+const uid = () => (crypto.randomUUID ? crypto.randomUUID() : Date.now().toString(36) + Math.random().toString(36).slice(2));
+const byId = (id) => notes.find((n) => n.id === id);
+const current = () => byId(currentId);
+const isEmpty = (n) => !n.title.trim() && !n.body.trim() && !n.tags.length;
+const isMobile = () => window.matchMedia('(max-width: 760px)').matches;
+
+function fmtDate(ts) {
+  const d = new Date(ts), now = new Date();
+  if (d.toDateString() === now.toDateString()) return d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
+  const opts = d.getFullYear() === now.getFullYear() ? { month: 'short', day: 'numeric' } : { year: 'numeric', month: 'short', day: 'numeric' };
+  return d.toLocaleDateString([], opts);
+}
+
+/* ---------- storage ---------- */
+function normalize(n) {
+  const now = Date.now();
+  return {
+    id: String(n.id || uid()),
+    title: String(n.title || ''),
+    body: String(n.body || ''),
+    tags: Array.isArray(n.tags) ? [...new Set(n.tags.map((t) => String(t).trim().toLowerCase()).filter(Boolean))] : [],
+    pinned: !!n.pinned, archived: !!n.archived,
+    trashedAt: n.trashedAt ? Number(n.trashedAt) : null,
+    created: Number(n.created) || now,
+    updated: Number(n.updated) || Number(n.created) || now,
+  };
+}
+function load() {
+  try {
+    const raw = localStorage.getItem(NOTES_KEY);
+    notes = raw ? JSON.parse(raw).map(normalize) : [];
+    Object.assign(prefs, JSON.parse(localStorage.getItem(PREFS_KEY) || '{}'));
+  } catch (e) {
+    console.error('Failed to load', e);
+    // keep the unreadable data around instead of overwriting it
+    try { localStorage.setItem(NOTES_KEY + '.corrupt-' + Date.now(), localStorage.getItem(NOTES_KEY)); } catch (_) {}
+    notes = [];
+    toast('Saved data was unreadable; a copy was kept aside.');
+  }
+  const cutoff = Date.now() - TRASH_DAYS * 864e5;
+  notes = notes.filter((n) => !(n.trashedAt && n.trashedAt < cutoff));
+}
+function writeNow() {
+  clearTimeout(saveTimer); saveTimer = null;
+  try {
+    localStorage.setItem(NOTES_KEY, JSON.stringify(notes));
+    localStorage.setItem(PREFS_KEY, JSON.stringify(prefs));
+    storageOk = true;
+  } catch (e) {
+    if (storageOk) toast('Could not save — storage is full or blocked. Export a backup!');
+    storageOk = false;
+  }
+}
+function scheduleSave() {
+  setStatus('Saving…');
+  clearTimeout(saveTimer);
+  saveTimer = setTimeout(() => { writeNow(); setStatus(storageOk ? 'Saved' : 'Not saved'); }, 300);
+}
+function setStatus(t) { el.status.textContent = t; }
+
+/* ---------- toast ---------- */
+function toast(msg, actionLabel, action) {
+  clearTimeout(toastTimer);
+  el.toast.innerHTML = '';
+  const s = document.createElement('span'); s.textContent = msg; el.toast.append(s);
+  if (actionLabel) {
+    const b = document.createElement('button'); b.textContent = actionLabel;
+    b.onclick = () => { action(); el.toast.hidden = true; };
+    el.toast.append(b);
+  }
+  el.toast.hidden = false;
+  toastTimer = setTimeout(() => { el.toast.hidden = true; }, actionLabel ? 7000 : 3500);
+}
+
+/* ---------- filtering ---------- */
+function inView(n) {
+  if (view === 'trash') return !!n.trashedAt;
+  if (n.trashedAt) return false;
+  if (view === 'archive') return n.archived;
+  if (n.archived) return false;
+  if (view === 'pinned') return n.pinned;
+  if (view.startsWith('tag:')) return n.tags.includes(view.slice(4));
+  return true;
+}
+function visibleNotes() {
+  const words = query.toLowerCase().split(/\s+/).filter(Boolean);
+  const list = notes.filter((n) => {
+    if (!inView(n)) return false;
+    if (!words.length) return true;
+    const hay = (n.title + '\n' + n.body + '\n' + n.tags.join(' ')).toLowerCase();
+    return words.every((w) => hay.includes(w));
+  });
+  const s = prefs.sort;
+  list.sort((a, b) => {
+    if (view !== 'trash' && a.pinned !== b.pinned) return a.pinned ? -1 : 1;
+    if (s === 'title') return (a.title || '~').localeCompare(b.title || '~', undefined, { sensitivity: 'base' });
+    if (s === 'created') return b.created - a.created;
+    return b.updated - a.updated;
+  });
+  return list;
+}
+
+/* ---------- rendering ---------- */
+function renderSidebar() {
+  const live = notes.filter((n) => !n.trashedAt);
+  const counts = {
+    all: live.filter((n) => !n.archived).length,
+    pinned: live.filter((n) => !n.archived && n.pinned).length,
+    archive: live.filter((n) => n.archived).length,
+    trash: notes.length - live.length,
+  };
+  el.views.querySelectorAll('button').forEach((b) => {
+    b.classList.toggle('active', b.dataset.view === view);
+    b.querySelector('.count').textContent = counts[b.dataset.view] || '';
+  });
+  const tagCount = {};
+  live.filter((n) => !n.archived).forEach((n) => n.tags.forEach((t) => { tagCount[t] = (tagCount[t] || 0) + 1; }));
+  const names = Object.keys(tagCount).sort();
+  el.tags.innerHTML = '';
+  if (!names.length) {
+    const p = document.createElement('div'); p.className = 'count'; p.style.padding = '4px 10px'; p.textContent = 'No tags yet'; el.tags.append(p);
+  }
+  names.forEach((t) => {
+    const b = document.createElement('button');
+    b.dataset.tag = t;
+    b.classList.toggle('active', view === 'tag:' + t);
+    b.innerHTML = `<span>#${esc(t)}</span><span class="count">${tagCount[t]}</span>`;
+    el.tags.append(b);
+  });
+  el.tagSuggest.innerHTML = names.map((t) => `<option value="${esc(t)}">`).join('');
+  $('#themeBtn').textContent = 'Theme: ' + prefs.theme;
+}
+
+function snippet(body) {
+  const line = body.split('\n').map((l) => l.replace(/^[#>\-*+\s]+(\[[ xX]\]\s*)?/, '').trim()).find(Boolean) || '';
+  return line.slice(0, 120);
+}
+function viewLabel() {
+  if (view.startsWith('tag:')) return '#' + view.slice(4);
+  return { all: 'All notes', pinned: 'Pinned', archive: 'Archive', trash: 'Trash (deleted after ' + TRASH_DAYS + ' days)' }[view];
+}
+function renderList() {
+  const items = visibleNotes();
+  el.viewTitle.textContent = viewLabel() + (query ? ` — ${items.length} result${items.length === 1 ? '' : 's'}` : '');
+  el.list.innerHTML = '';
+  if (!items.length) {
+    const d = document.createElement('li'); d.className = 'list-empty';
+    d.textContent = query ? 'No notes match your search.' : view === 'all' ? 'No notes yet. Create your first one!' : 'Nothing here.';
+    el.list.append(d); return;
+  }
+  const frag = document.createDocumentFragment();
+  for (const n of items) {
+    const li = document.createElement('li');
+    const b = document.createElement('button');
+    b.className = 'item' + (n.id === currentId ? ' sel' : '');
+    b.dataset.id = n.id; b.setAttribute('role', 'option'); b.setAttribute('aria-selected', n.id === currentId);
+    b.innerHTML = `<div class="t">${n.pinned ? '📌 ' : ''}${esc(n.title.trim() || 'Untitled')}</div>
+      <div class="s">${esc(snippet(n.body)) || '&nbsp;'}</div>
+      <div class="m"><span>${fmtDate(n.updated)}</span>${n.tags.slice(0, 3).map((t) => `<span class="tg">${esc(t)}</span>`).join('')}</div>`;
+    li.append(b); frag.append(li);
+  }
+  el.list.append(frag);
+}
+
+function renderTagChips(n) {
+  el.tagBox.querySelectorAll('.chip').forEach((c) => c.remove());
+  const ro = !!n.trashedAt;
+  n.tags.forEach((t) => {
+    const c = document.createElement('span'); c.className = 'chip';
+    c.append(document.createTextNode(t));
+    if (!ro) {
+      const x = document.createElement('button'); x.textContent = '×'; x.setAttribute('aria-label', 'Remove tag ' + t); x.dataset.rm = t;
+      c.append(x);
+    }
+    el.tagBox.insertBefore(c, el.tagInput);
+  });
+  el.tagInput.hidden = ro;
+}
+
+function updateFoot(n) {
+  const words = (n.body.trim().match(/\S+/g) || []).length;
+  el.foot.innerHTML = `<span>${words} word${words === 1 ? '' : 's'}</span><span>${n.body.length} characters</span>` +
+    `<span>Created ${new Date(n.created).toLocaleString()}</span><span>Edited ${new Date(n.updated).toLocaleString()}</span>`;
+}
+
+function renderMode() {
+  const n = current();
+  const preview = prefs.mode === 'preview';
+  $('#editMode').classList.toggle('active', !preview);
+  $('#previewMode').classList.toggle('active', preview);
+  el.body.hidden = preview; el.preview.hidden = !preview;
+  if (preview && n) el.preview.innerHTML = renderMarkdown(n.body, !n.trashedAt);
+}
+
+function renderEditor() {
+  const n = current();
+  el.editor.hidden = !n; el.empty.hidden = !!n;
+  if (!n) return;
+  const trashed = !!n.trashedAt;
+  el.editor.classList.toggle('readonly', trashed);
+  if (el.title.value !== n.title) el.title.value = n.title;
+  if (el.body.value !== n.body) el.body.value = n.body;
+  el.title.readOnly = el.body.readOnly = trashed;
+  $('#pinBtn').style.background = n.pinned ? 'var(--sel)' : '';
+  $('#pinBtn').title = n.pinned ? 'Unpin' : 'Pin';
+  $('#archiveBtn').title = n.archived ? 'Unarchive' : 'Archive';
+  $('#archiveBtn').style.background = n.archived ? 'var(--sel)' : '';
+  for (const id of ['#pinBtn', '#archiveBtn', '#deleteBtn']) $(id).hidden = trashed;
+  $('#restoreBtn').hidden = $('#purgeBtn').hidden = !trashed;
+  renderTagChips(n); updateFoot(n); renderMode();
+  setStatus('');
+}
+
+function renderAll() { renderSidebar(); renderList(); renderEditor(); }
+
+/* ---------- markdown ---------- */
+function inline(src) {
+  const stash = [];
+  let s = esc(src).replace(/`([^`]+)`/g, (_, c) => { stash.push('<code>' + c + '</code>'); return '\u0000' + (stash.length - 1) + '\u0000'; });
+  s = s.replace(/\[([^\]]+)\]\(((?:https?:\/\/|mailto:)[^\s)]+)\)/g, (_, t, u) => { stash.push(`<a href="${u}" target="_blank" rel="noopener noreferrer">${t}</a>`); return '\u0000' + (stash.length - 1) + '\u0000'; });
+  s = s.replace(/(^|[\s(])(https?:\/\/[^\s<]*[^\s<.,;:!?)])/g, (_, p, u) => { stash.push(`<a href="${u}" target="_blank" rel="noopener noreferrer">${u}</a>`); return p + '\u0000' + (stash.length - 1) + '\u0000'; });
+  s = s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
+    .replace(/__(.+?)__/g, '<strong>$1</strong>')
+    .replace(/~~(.+?)~~/g, '<del>$1</del>')
+    .replace(/\*(?!\s)([^*]+?)\*/g, '<em>$1</em>')
+    .replace(/(^|\W)_([^_]+)_(?=\W|$)/g, '$1<em>$2</em>');
+  return s.replace(/\u0000(\d+)\u0000/g, (_, i) => stash[+i]);
+}
+
+// base: source line number of lines[0] (for interactive checkboxes) or null when not interactive
+function renderMarkdown(src, interactive = true, lines = null, base = 0) {
+  lines = lines || src.replace(/\r/g, '').split('\n');
+  const out = [];
+  const listRe = /^(\s*)([-*+]|\d+\.)\s+(.*)$/;
+  const blockStart = (l) => /^(#{1,6}\s|```|>|\s*([-*+]|\d+\.)\s|(-{3,}|\*{3,})\s*$)/.test(l);
+  let i = 0;
+  while (i < lines.length) {
+    const line = lines[i];
+    let m;
+    if (!line.trim()) { i++; continue; }
+    if (/^```/.test(line)) {
+      const buf = []; i++;
+      while (i < lines.length && !/^```/.test(lines[i])) buf.push(lines[i++]);
+      i++;
+      out.push('<pre><code>' + esc(buf.join('\n')) + '</code></pre>'); continue;
+    }
+    if ((m = line.match(/^(#{1,6})\s+(.*?)\s*#*\s*$/))) { out.push(`<h${m[1].length}>${inline(m[2])}</h${m[1].length}>`); i++; continue; }
+    if (/^(-{3,}|\*{3,})\s*$/.test(line)) { out.push('<hr>'); i++; continue; }
+    if (/^>/.test(line)) {
+      const start = i, buf = [];
+      while (i < lines.length && /^>/.test(lines[i])) buf.push(lines[i++].replace(/^>\s?/, ''));
+      out.push('<blockquote>' + renderMarkdown('', false, buf, start) + '</blockquote>'); continue;
+    }
+    if (listRe.test(line)) {
+      const stack = []; let html = '';
+      while (i < lines.length && (m = lines[i].match(listRe))) {
+        const level = Math.floor(m[1].replace(/\t/g, '  ').length / 2);
+        const tag = /\d/.test(m[2]) ? 'ol' : 'ul';
+        let text = m[3], cls = '', box = '';
+        const t = text.match(/^\[([ xX])\]\s+(.*)$/);
+        if (t) {
+          const done = t[1] !== ' ';
+          text = t[2]; cls = done ? ' class="task done"' : ' class="task"';
+          box = `<input type="checkbox" data-line="${base + i}"${done ? ' checked' : ''}${interactive ? '' : ' disabled'}> `;
+        }
+        while (stack.length && stack[stack.length - 1].level > level) html += '</li></' + stack.pop().tag + '>';
+        const top = stack[stack.length - 1];
+        if (top && top.level === level) {
+          html += '</li>';
+          if (top.tag !== tag) { html += '</' + stack.pop().tag + '><' + tag + '>'; stack.push({ tag, level }); }
+        } else { html += '<' + tag + '>'; stack.push({ tag, level }); }
+        html += `<li${cls}>${box}<span>${inline(text)}</span>`;
+        i++;
+      }
+      while (stack.length) html += '</li></' + stack.pop().tag + '>';
+      out.push(html); continue;
+    }
+    const buf = [];
+    while (i < lines.length && lines[i].trim() && (buf.length === 0 || !blockStart(lines[i]))) buf.push(inline(lines[i++]));
+    out.push('<p>' + buf.join('<br>') + '</p>');
+  }
+  return out.join('\n');
+}
+
+/* ---------- actions ---------- */
+function touch(n) { n.updated = Date.now(); }
+
+function dropIfEmpty() {
+  const n = current();
+  if (n && !n.trashedAt && isEmpty(n)) notes = notes.filter((x) => x !== n);
+}
+function select(id, { focus = false } = {}) {
+  if (id !== currentId) { dropIfEmpty(); }
+  currentId = id && byId(id) ? id : null;
+  renderAll();
+  if (currentId && isMobile()) el.app.dataset.pane = 'editor';
+  if (focus && currentId) (el.title.value ? el.body : el.title).focus();
+}
+function setView(v) {
+  dropIfEmpty();
+  view = v; query = ''; el.search.value = '';
+  const items = visibleNotes();
+  currentId = items[0] ? items[0].id : null;
+  renderAll();
+  if (isMobile()) el.app.dataset.pane = 'list';
+}
+function newNote() {
+  dropIfEmpty();
+  if (view === 'trash' || view === 'archive' || view === 'pinned' || query) { view = view.startsWith('tag:') ? view : 'all'; }
+  query = ''; el.search.value = '';
+  const now = Date.now();
+  const n = normalize({ id: uid(), created: now, updated: now, tags: view.startsWith('tag:') ? [view.slice(4)] : [] });
+  notes.push(n);
+  prefs.mode = 'edit';
+  currentId = n.id;
+  writeNow();
+  renderAll();
+  if (isMobile()) el.app.dataset.pane = 'editor';
+  el.title.focus();
+}
+function changeAndSave(fn, msg, undoFn) {
+  const n = current(); if (!n) return;
+  const snapshot = { ...n, tags: [...n.tags] };
+  fn(n); touch(n);
+  writeNow();
+  const items = visibleNotes();
+  if (!items.includes(n)) { currentId = items[0] ? items[0].id : null; if (isMobile()) el.app.dataset.pane = 'list'; }
+  renderAll();
+  if (msg) toast(msg, 'Undo', () => {
+    const t = byId(snapshot.id); if (!t) return;
+    Object.assign(t, snapshot); writeNow(); currentId = t.id; renderAll();
+  });
+}
+function togglePin() { changeAndSave((n) => { n.pinned = !n.pinned; }); }
+function toggleArchive() { changeAndSave((n) => { n.archived = !n.archived; }, current().archived ? 'Note unarchived' : 'Note archived'); }
+function trashNote() {
+  const n = current(); if (!n) return;
+  if (isEmpty(n)) { notes = notes.filter((x) => x !== n); currentId = null; setView(view); return; }
+  changeAndSave((x) => { x.trashedAt = Date.now(); x.pinned = false; }, 'Moved to trash');
+}
+function restoreNote() { changeAndSave((n) => { n.trashedAt = null; n.archived = false; }, 'Note restored'); }
+function purgeNote() {
+  const n = current(); if (!n) return;
+  if (!confirm('Permanently delete this note? This cannot be undone.')) return;
+  notes = notes.filter((x) => x !== n);
+  const items = visibleNotes(); currentId = items[0] ? items[0].id : null;
+  writeNow(); renderAll();
+  if (isMobile()) el.app.dataset.pane = 'list';
+}
+function addTag(raw) {
+  const n = current(); if (!n || n.trashedAt) return;
+  const t = raw.trim().replace(/^#+/, '').toLowerCase().replace(/\s+/g, '-');
+  if (!t || n.tags.includes(t)) return;
+  n.tags.push(t); touch(n); scheduleSave(); renderSidebar(); renderList(); renderTagChips(n);
+}
+function removeTag(t) {
+  const n = current(); if (!n) return;
+  n.tags = n.tags.filter((x) => x !== t); touch(n); scheduleSave(); renderSidebar(); renderList(); renderTagChips(n);
+}
+
+/* ---------- editing ---------- */
+function onEdit() {
+  const n = current(); if (!n || n.trashedAt) return;
+  n.title = el.title.value; n.body = el.body.value; touch(n);
+  scheduleSave(); renderList(); updateFoot(n);
+}
+
+function insertText(text) {
+  el.body.focus();
+  if (!document.execCommand || !document.execCommand('insertText', false, text)) {
+    el.body.setRangeText(text, el.body.selectionStart, el.body.selectionEnd, 'end');
+    onEdit();
+  }
+}
+function wrapSelection(mark) {
+  const { selectionStart: a, selectionEnd: b, value } = el.body;
+  insertText(mark + value.slice(a, b) + mark);
+  if (a === b) el.body.selectionStart = el.body.selectionEnd = a + mark.length;
+}
+function onBodyKey(e) {
+  const mod = e.metaKey || e.ctrlKey;
+  if (mod && !e.shiftKey && !e.altKey && e.key.toLowerCase() === 'b') { e.preventDefault(); wrapSelection('**'); return; }
+  if (mod && !e.shiftKey && !e.altKey && e.key.toLowerCase() === 'i') { e.preventDefault(); wrapSelection('*'); return; }
+  if (e.key === 'Tab' && !mod && !e.altKey) {
+    // keep Tab for focus movement, except on list lines where it indents
+    const { selectionStart: s, value } = el.body;
+    const ls = value.lastIndexOf('\n', s - 1) + 1;
+    const lineText = value.slice(ls, value.indexOf('\n', s) === -1 ? value.length : value.indexOf('\n', s));
+    if (/^\s*([-*+]|\d+\.)\s/.test(lineText) && !e.shiftKey) {
+      e.preventDefault();
+      el.body.setSelectionRange(ls, ls); insertText('  ');
+      el.body.setSelectionRange(s + 2, s + 2);
+    }
+    return;
+  }
+  if (e.key !== 'Enter' || e.shiftKey || mod || e.altKey || e.isComposing) return;
+  const { selectionStart: s, selectionEnd: end, value } = el.body;
+  if (s !== end) return;
+  const ls = value.lastIndexOf('\n', s - 1) + 1;
+  const before = value.slice(ls, s);
+  const m = before.match(/^(\s*)([-*+]|(\d+)\.)(\s+\[[ xX]\])?\s+(.*)$/) || before.match(/^(\s*)([-*+]|(\d+)\.)(\s+\[[ xX]\])?\s+()$/);
+  if (!m) return;
+  e.preventDefault();
+  if (!m[5].trim()) { // empty item: end the list
+    el.body.setSelectionRange(ls, s);
+    if (!document.execCommand || !document.execCommand('delete')) { el.body.setRangeText('', ls, s, 'end'); onEdit(); }
+    return;
+  }
