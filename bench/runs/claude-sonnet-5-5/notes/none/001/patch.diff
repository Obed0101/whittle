+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Notes</title>
+<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%234f6df5'/%3E%3Cpath d='M9 10h14M9 16h14M9 22h8' stroke='white' stroke-width='2.5' stroke-linecap='round'/%3E%3C/svg%3E">
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<div id="app" data-pane="list">
+
+  <aside id="sidebar" aria-label="Navigation">
+    <div class="brand">Notes</div>
+    <button id="newBtn" class="primary" title="New note (Alt+N)">+ New note</button>
+    <nav id="views" aria-label="Views">
+      <button data-view="all">All notes <span class="count"></span></button>
+      <button data-view="pinned">Pinned <span class="count"></span></button>
+      <button data-view="archive">Archive <span class="count"></span></button>
+      <button data-view="trash">Trash <span class="count"></span></button>
+    </nav>
+    <div class="section-title">Tags</div>
+    <nav id="tags" aria-label="Tags"></nav>
+    <div class="side-foot">
+      <button id="themeBtn" title="Change theme">Theme: auto</button>
+      <button id="exportBtn" title="Download all notes as JSON">Export backup</button>
+      <button id="importBtn" title="Import notes from a JSON backup">Import backup</button>
+      <button id="helpBtn">Shortcuts</button>
+      <input type="file" id="importFile" accept="application/json,.json" hidden>
+    </div>
+  </aside>
+
+  <section id="listPane" aria-label="Note list">
+    <div class="list-head">
+      <button id="menuBtn" class="icon mobile-only" aria-label="Back to menu" hidden>☰</button>
+      <input id="search" type="search" placeholder="Search notes  ( / )" aria-label="Search notes" autocomplete="off">
+      <select id="sort" aria-label="Sort notes">
+        <option value="updated">Last edited</option>
+        <option value="created">Created</option>
+        <option value="title">Title</option>
+      </select>
+    </div>
+    <div id="viewTitle" class="view-title"></div>
+    <ul id="list" role="listbox" aria-label="Notes"></ul>
+  </section>
+
+  <main id="editorPane">
+    <div id="emptyState" class="empty" hidden>
+      <p>No note selected</p>
+      <button id="emptyNew" class="primary">+ New note</button>
+    </div>
+
+    <div id="editor" hidden>
+      <div class="toolbar">
+        <button id="backBtn" class="icon mobile-only" aria-label="Back to list">←</button>
+        <div class="seg" role="group" aria-label="Mode">
+          <button id="editMode">Edit</button>
+          <button id="previewMode">Preview</button>
+        </div>
+        <span id="status" class="status" aria-live="polite"></span>
+        <span class="spacer"></span>
+        <button id="pinBtn" class="icon" title="Pin">📌</button>
+        <button id="mdBtn" class="icon" title="Download as Markdown">⬇</button>
+        <button id="archiveBtn" class="icon" title="Archive">🗄</button>
+        <button id="deleteBtn" class="icon danger" title="Move to trash">🗑</button>
+        <button id="restoreBtn" class="icon" title="Restore" hidden>Restore</button>
+        <button id="purgeBtn" class="icon danger" title="Delete forever" hidden>Delete forever</button>
+      </div>
+      <input id="title" class="title" placeholder="Title" aria-label="Title" maxlength="200">
+      <div id="tagBox" class="tagbox" aria-label="Tags">
+        <input id="tagInput" placeholder="Add tag…" aria-label="Add tag" maxlength="40" list="tagSuggest">
+        <datalist id="tagSuggest"></datalist>
+      </div>
+      <textarea id="body" placeholder="Write something… Markdown is supported." aria-label="Note body" spellcheck="true"></textarea>
+      <div id="preview" class="preview" hidden></div>
+      <div id="foot" class="foot"></div>
+    </div>
+  </main>
+</div>
+
+<dialog id="help">
+  <h2>Keyboard shortcuts</h2>
+  <table>
+    <tr><td><kbd>Alt</kbd>+<kbd>N</kbd></td><td>New note</td></tr>
+    <tr><td><kbd>/</kbd></td><td>Search</td></tr>
+    <tr><td><kbd>Ctrl/⌘</kbd>+<kbd>E</kbd></td><td>Toggle edit / preview</td></tr>
+    <tr><td><kbd>Ctrl/⌘</kbd>+<kbd>B</kbd> / <kbd>I</kbd></td><td>Bold / italic selection</td></tr>
+    <tr><td><kbd>Enter</kbd></td><td>Continue lists and checklists</td></tr>
+    <tr><td><kbd>↑</kbd> <kbd>↓</kbd></td><td>Move through the note list</td></tr>
+    <tr><td><kbd>Esc</kbd></td><td>Clear search / close dialogs</td></tr>
+  </table>
+  <h3>Markdown</h3>
+  <p>Headings <code>#</code>, <b>bold</b> <code>**</code>, <i>italic</i> <code>*</code>, <code>`code`</code>, fenced code, lists, nested lists, checklists <code>- [ ]</code>, quotes <code>&gt;</code>, links, <code>---</code>. Checkboxes can be ticked in Preview.</p>
+  <form method="dialog"><button class="primary">Close</button></form>
+</dialog>
+
+<div id="toast" role="status" aria-live="polite" hidden></div>
+<script src="app.js"></script>
+</body>
+</html>
diff --git a/notes/style.css b/notes/style.css
new file mode 100644
index 0000000..190c3b0
--- /dev/null
+++ b/notes/style.css
@@ -0,0 +1,112 @@
+:root {
+  --bg: #ffffff; --bg2: #f6f7f9; --bg3: #eceef2; --fg: #1d2027; --muted: #6b7280;
+  --border: #e1e4ea; --accent: #4f6df5; --accent-fg: #fff; --sel: #e8edff;
+  --danger: #d93b3b; --code: #f1f3f6; --radius: 8px;
+  --font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
+  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  color-scheme: light;
+}
+:root[data-eff="dark"] {
+  --bg: #16181d; --bg2: #1c1f26; --bg3: #262a33; --fg: #e6e8ee; --muted: #8b93a3;
+  --border: #2b303b; --accent: #7188ff; --accent-fg: #101216; --sel: #26304f;
+  --danger: #ff6b6b; --code: #23272f; color-scheme: dark;
+}
+* { box-sizing: border-box; }
+html, body { height: 100%; margin: 0; }
+body { font: 15px/1.5 var(--font); background: var(--bg); color: var(--fg); }
+button, input, select, textarea { font: inherit; color: inherit; }
+button { cursor: pointer; background: none; border: 0; border-radius: var(--radius); padding: 6px 10px; text-align: left; }
+button:hover { background: var(--bg3); }
+button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: -1px; }
+button.primary { background: var(--accent); color: var(--accent-fg); text-align: center; font-weight: 600; }
+button.primary:hover { filter: brightness(1.08); }
+button.icon { text-align: center; min-width: 34px; }
+button.danger:hover { color: var(--danger); }
+[hidden] { display: none !important; }
+
+#app { display: grid; grid-template-columns: 220px 320px 1fr; height: 100%; }
+#sidebar { background: var(--bg2); border-right: 1px solid var(--border); padding: 14px 10px; display: flex; flex-direction: column; gap: 6px; overflow-y: auto; }
+.brand { font-weight: 700; font-size: 18px; padding: 2px 10px 8px; }
+#views, #tags { display: flex; flex-direction: column; gap: 1px; }
+#views button, #tags button { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
+#views button.active, #tags button.active { background: var(--sel); font-weight: 600; }
+#tags button span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.count { color: var(--muted); font-size: 12px; font-weight: 400; }
+.section-title { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); padding: 12px 10px 2px; }
+.side-foot { margin-top: auto; display: flex; flex-direction: column; gap: 1px; padding-top: 10px; border-top: 1px solid var(--border); color: var(--muted); font-size: 13px; }
+
+#listPane { border-right: 1px solid var(--border); display: flex; flex-direction: column; min-height: 0; }
+.list-head { display: flex; gap: 6px; padding: 10px; }
+#search, #sort { background: var(--bg2); border: 1px solid var(--border); border-radius: var(--radius); padding: 7px 10px; min-width: 0; }
+#search { flex: 1; }
+.view-title { padding: 0 14px 6px; font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }
+#list { list-style: none; margin: 0; padding: 0 6px 10px; overflow-y: auto; flex: 1; }
+#list li { margin: 0; }
+.item { display: block; width: 100%; padding: 9px 10px; border-radius: var(--radius); border-bottom: 1px solid transparent; }
+.item.sel { background: var(--sel); }
+.item .t { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.item .s { color: var(--muted); font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.item .m { color: var(--muted); font-size: 12px; display: flex; gap: 6px; align-items: center; margin-top: 2px; overflow: hidden; }
+.item .tg { background: var(--bg3); border-radius: 10px; padding: 0 7px; white-space: nowrap; }
+.list-empty { color: var(--muted); text-align: center; padding: 40px 16px; }
+
+#editorPane { min-width: 0; min-height: 0; display: flex; }
+#editor { display: flex; flex-direction: column; flex: 1; min-width: 0; max-width: 900px; margin: 0 auto; padding: 0 24px; }
+.empty { margin: auto; text-align: center; color: var(--muted); display: flex; flex-direction: column; gap: 12px; align-items: center; }
+.empty button { padding: 8px 18px; }
+.toolbar { display: flex; align-items: center; gap: 4px; padding: 10px 0; }
+.spacer { flex: 1; }
+.status { color: var(--muted); font-size: 12px; margin-left: 8px; }
+.seg { display: inline-flex; background: var(--bg3); border-radius: var(--radius); padding: 2px; }
+.seg button { padding: 3px 12px; font-size: 13px; }
+.seg button.active { background: var(--bg); box-shadow: 0 1px 2px rgba(0,0,0,.15); }
+.title { border: 0; background: none; font-size: 26px; font-weight: 700; padding: 6px 0; width: 100%; }
+.title:focus-visible { outline: none; }
+.tagbox { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; padding: 4px 0 10px; border-bottom: 1px solid var(--border); }
+.chip { background: var(--bg3); border-radius: 12px; padding: 1px 4px 1px 10px; font-size: 13px; display: inline-flex; align-items: center; gap: 2px; }
+.chip button { padding: 0 6px; line-height: 1.4; color: var(--muted); }
+.tagbox input { border: 0; background: none; font-size: 13px; min-width: 100px; flex: 1; padding: 3px 2px; }
+.tagbox input:focus-visible { outline: none; }
+#body { flex: 1; resize: none; border: 0; background: none; padding: 14px 0; font-family: var(--mono); font-size: 14.5px; line-height: 1.65; min-height: 0; }
+#body:focus-visible { outline: none; }
+.preview { flex: 1; overflow-y: auto; padding: 14px 0; min-height: 0; overflow-wrap: anywhere; }
+.foot { color: var(--muted); font-size: 12px; padding: 8px 0 12px; border-top: 1px solid var(--border); display: flex; gap: 14px; flex-wrap: wrap; }
+.readonly .title, .readonly #body { opacity: .75; }
+
+.preview h1, .preview h2, .preview h3, .preview h4 { line-height: 1.25; margin: 1.2em 0 .4em; }
+.preview h1 { font-size: 1.7em; } .preview h2 { font-size: 1.4em; } .preview h3 { font-size: 1.2em; }
+.preview h1:first-child, .preview h2:first-child, .preview p:first-child { margin-top: 0; }
+.preview p { margin: .6em 0; }
+.preview code { background: var(--code); padding: 1px 5px; border-radius: 4px; font-family: var(--mono); font-size: .9em; }
+.preview pre { background: var(--code); padding: 12px; border-radius: var(--radius); overflow-x: auto; }
+.preview pre code { padding: 0; background: none; }
+.preview blockquote { margin: .6em 0; padding: 0 14px; border-left: 3px solid var(--border); color: var(--muted); }
+.preview a { color: var(--accent); }
+.preview hr { border: 0; border-top: 1px solid var(--border); margin: 1.2em 0; }
+.preview ul, .preview ol { padding-left: 1.5em; margin: .4em 0; }
+.preview li.task { list-style: none; margin-left: -1.3em; }
+.preview li.task input { margin-right: 6px; }
+.preview li.done > span { text-decoration: line-through; color: var(--muted); }
+
+#toast { position: fixed; left: 50%; bottom: 20px; transform: translateX(-50%); background: var(--fg); color: var(--bg); padding: 9px 16px; border-radius: var(--radius); display: flex; gap: 14px; align-items: center; z-index: 10; box-shadow: 0 4px 16px rgba(0,0,0,.25); }
+#toast button { color: var(--accent); background: none; padding: 0; font-weight: 600; }
+#toast button:hover { background: none; text-decoration: underline; }
+dialog { border: 1px solid var(--border); border-radius: 12px; background: var(--bg); color: var(--fg); max-width: 460px; }
+dialog::backdrop { background: rgba(0,0,0,.4); }
+dialog td { padding: 3px 12px 3px 0; }
+kbd { background: var(--bg3); border-radius: 4px; padding: 1px 6px; font: 12px var(--mono); }
+dialog p { color: var(--muted); }
+
+.mobile-only { display: none; }
+@media (max-width: 1000px) { #app { grid-template-columns: 190px 280px 1fr; } }
+@media (max-width: 760px) {
+  #app { display: block; }
+  #sidebar, #listPane, #editorPane { height: 100%; width: 100%; border: 0; display: none; }
+  #app[data-pane="menu"] #sidebar { display: flex; }
+  #app[data-pane="list"] #listPane { display: flex; }
+  #app[data-pane="editor"] #editorPane { display: flex; }
+  #editor { padding: 0 14px; }
+  .mobile-only { display: inline-block; }
+  .mobile-only[hidden] { display: inline-block !important; }
+}
+@media print { #sidebar, #listPane, .toolbar, .tagbox, .foot { display: none !important; } #app { display: block; } }
