+  insertText('\n' + m[1] + marker + (m[4] ? ' [ ]' : '') + ' ');
+}
+
+function toggleCheckbox(line) {
+  const n = current(); if (!n || n.trashedAt) return;
+  const lines = n.body.split('\n');
+  if (!/\[[ xX]\]/.test(lines[line] || '')) return;
+  lines[line] = lines[line].replace(/\[([ xX])\]/, (_, c) => (c === ' ' ? '[x]' : '[ ]'));
