+    trashed: n.trashed ? num(n.trashed, now) : null,
+    created, updated: num(n.updated, created),
+  };
+}
+function load() {
+  try { const p = JSON.parse(localStorage.getItem(K_PREFS)); if (p && typeof p === 'object') Object.assign(prefs, p); } catch (e) {}
