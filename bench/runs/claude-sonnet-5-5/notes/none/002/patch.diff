+$('#toolbar').addEventListener('mousedown', e => e.preventDefault()); // keep textarea focus/selection
+$('#toolbar').addEventListener('click', e => { const b = e.target.closest('[data-fmt]'); if (b) format(b.dataset.fmt); });
+
+el.body.addEventListener('keydown', e => {
