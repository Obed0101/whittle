+  return h;
+}
+const renderMd = src => blocks(src.replace(/\r\n?/g, '\n').split('\n'), 0);
+
+/* ---------- state & storage ---------- */
+const K_DATA = 'notes.v1.data', K_PREFS = 'notes.v1.prefs';
+let notes = [];
+let prefs = { theme: 'auto', font: '15', mode: 'edit', sort: 'updated', view: 'all', tag: null };
+const ui = { sel: null, query: '', pane: 'list' };
+let storageWarned = false;
+
+function sanitize(n) {
+  if (!n || typeof n !== 'object') return null;
+  const now = Date.now();
+  const num = (v, d) => (typeof v === 'number' && isFinite(v) ? v : d);
+  const created = num(n.created, now);
+  return {
+    id: typeof n.id === 'string' && n.id ? n.id.replace(/[^\w-]/g, '') || uid() : uid(),
+    title: typeof n.title === 'string' ? n.title.slice(0, 300) : '',
