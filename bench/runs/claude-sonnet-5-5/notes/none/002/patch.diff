+/* ---------- rendering: sidebar & list ---------- */
+const VIEW_NAMES = { all: 'All notes', pinned: 'Pinned', archive: 'Archive', trash: 'Trash' };
+
+function renderSidebar() {
+  const c = { all: 0, pinned: 0, archive: 0, trash: 0 };
+  const tagCount = {};
+  for (const n of notes) {
+    if (n.trashed) { c.trash++; continue; }
