+
+/* text editing helpers */
+function replaceRange(s, e, text, selS, selE) {
+  const ta = el.body;
+  ta.focus(); ta.setSelectionRange(s, e);
+  let ok = false;
+  try { ok = text === '' ? document.execCommand('delete') : document.execCommand('insertText', false, text); } catch (x) {}
