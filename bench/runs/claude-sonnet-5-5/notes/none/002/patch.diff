+      out.push('<blockquote>' + blocks(buf, base + start) + '</blockquote>');
+      continue;
+    }
+    if (RE.item.test(line)) {
+      const items = [];
+      while (i < lines.length) {
+        const im = RE.item.exec(lines[i]);
+        if (im) { items.push({ indent: indentOf(im[1]), ol: /\d/.test(im[2]), text: im[3], line: base + i }); i++; }
+        else if (!lines[i].trim() && i + 1 < lines.length && RE.item.test(lines[i + 1])) i++;
+        else break;
+      }
+      out.push(renderList(items));
+      continue;
+    }
+    const buf = [];
+    while (i < lines.length && lines[i].trim() && (buf.length === 0 || !startsBlock(lines[i], lines[i + 1]))) buf.push(lines[i++]);
+    out.push('<p>' + buf.map(inline).join('<br>') + '</p>');
+  }
+  return out.join('\n');
+}
+function renderList(items) {
+  const stack = [];
+  let h = '';
+  const open = it => { h += it.ol ? '<ol>' : '<ul>'; stack.push({ indent: it.indent, ol: it.ol }); };
+  const close = () => { h += '</li>' + (stack.pop().ol ? '</ol>' : '</ul>'); };
+  for (const it of items) {
+    while (stack.length && stack[stack.length - 1].indent > it.indent) close();
+    const top = stack[stack.length - 1];
+    if (top && top.indent === it.indent) {
+      if (top.ol === it.ol) h += '</li>'; else { close(); open(it); }
+    } else open(it);
+    const t = /^\[([ xX])\]\s+(.*)$/.exec(it.text);
+    if (t) {
