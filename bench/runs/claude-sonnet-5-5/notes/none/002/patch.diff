+      i++;
+      out.push('<pre><code>' + esc(buf.join('\n')) + '</code></pre>');
+      continue;
+    }
+    if ((m = RE.heading.exec(line))) {
+      out.push(`<h${m[1].length}>${inline(m[2])}</h${m[1].length}>`);
+      i++; continue;
+    }
+    if (RE.hr.test(line)) { out.push('<hr>'); i++; continue; }
+
+    if (line.includes('|') && i + 1 < lines.length && lines[i + 1].includes('|') && lines[i + 1].includes('-') && RE.tableSep.test(lines[i + 1])) {
+      const head = cells(line), aligns = cells(lines[i + 1]).map(c => c.startsWith(':') && c.endsWith(':') ? 'center' : c.endsWith(':') ? 'right' : '');
+      i += 2;
+      const rows = [];
+      while (i < lines.length && lines[i].trim() && lines[i].includes('|')) rows.push(cells(lines[i++]));
+      const td = (tag, c, k) => `<${tag}${aligns[k] ? ` style="text-align:${aligns[k]}"` : ''}>${inline(c || '')}</${tag}>`;
+      out.push('<table><thead><tr>' + head.map((c, k) => td('th', c, k)).join('') + '</tr></thead><tbody>' +
+        rows.map(r => '<tr>' + head.map((_, k) => td('td', r[k], k)).join('') + '</tr>').join('') + '</tbody></table>');
+      continue;
+    }
+    if (RE.quote.test(line)) {
+      const start = i, buf = [];
