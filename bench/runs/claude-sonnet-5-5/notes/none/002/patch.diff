+}
+function inline(s) {
+  const st = [];
+  const put = h => '\u0000' + (st.push(h) - 1) + '\u0000';
+  s = s.replace(/\u0000/g, '');
+  s = s.replace(/(`+)([^`]|[^`][\s\S]*?[^`])\1(?!`)/g, (m, b, c) => put('<code>' + esc(c.trim()) + '</code>'));
+  s = esc(s);
