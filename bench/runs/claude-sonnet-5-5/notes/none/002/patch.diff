+      <tr><td><kbd>Ctrl/⌘</kbd> <kbd>Alt</kbd> <kbd>N</kbd></td><td>New note</td></tr>
+      <tr><td><kbd>Ctrl/⌘</kbd> <kbd>K</kbd></td><td>Search</td></tr>
+      <tr><td><kbd>Ctrl/⌘</kbd> <kbd>Shift</kbd> <kbd>P</kbd></td><td>Cycle edit / split / preview</td></tr>
+      <tr><td><kbd>Ctrl/⌘</kbd> <kbd>B</kbd> / <kbd>I</kbd></td><td>Bold / italic</td></tr>
+      <tr><td><kbd>Alt</kbd> <kbd>↑</kbd> / <kbd>↓</kbd></td><td>Previous / next note</td></tr>
+      <tr><td><kbd>Tab</kbd> / <kbd>Shift Tab</kbd></td><td>Indent / outdent</td></tr>
+      <tr><td><kbd>Esc</kbd></td><td>Leave editor / clear search</td></tr>
+    </table>
+    <h3>Danger zone</h3>
+    <div class="btn-row"><button type="button" id="btn-wipe" class="danger">Delete all notes…</button></div>
+    <div class="dlg-foot"><button class="primary">Done</button></div>
+  </form>
+</dialog>
+
+<script src="app.js"></script>
+</body>
+</html>
diff --git a/notes/style.css b/notes/style.css
new file mode 100644
index 0000000..035640c
--- /dev/null
+++ b/notes/style.css
@@ -0,0 +1,205 @@
+:root {
+  --bg: #f6f5f2; --panel: #ffffff; --side: #efede8; --text: #1f2328; --muted: #6b7078;
+  --border: #dcd9d2; --accent: #b8860b; --accent-bg: #f6ecc9; --accent-text: #fff;
+  --hover: #00000009; --sel: #f3e7b8; --danger: #c0352b; --code-bg: #f0eee9;
+  --shadow: 0 8px 30px #00000026;
+  --fs: 15px;
+  color-scheme: light;
+}
+:root[data-theme="dark"] {
+  --bg: #17181a; --panel: #1e1f22; --side: #151618; --text: #e4e4e1; --muted: #8e939b;
+  --border: #33353a; --accent: #e0b43a; --accent-bg: #3a3218; --accent-text: #1a1500;
+  --hover: #ffffff0d; --sel: #3a3218; --danger: #ef6b5f; --code-bg: #2a2b2f;
+  --shadow: 0 8px 30px #00000080;
+  color-scheme: dark;
+}
+@media (prefers-color-scheme: dark) {
+  :root[data-theme="auto"] {
+    --bg: #17181a; --panel: #1e1f22; --side: #151618; --text: #e4e4e1; --muted: #8e939b;
+    --border: #33353a; --accent: #e0b43a; --accent-bg: #3a3218; --accent-text: #1a1500;
+    --hover: #ffffff0d; --sel: #3a3218; --danger: #ef6b5f; --code-bg: #2a2b2f;
+    --shadow: 0 8px 30px #00000080;
+    color-scheme: dark;
+  }
+}
+
+* { box-sizing: border-box; }
+html, body { height: 100%; margin: 0; }
+body {
+  font: 14px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
+  background: var(--bg); color: var(--text); overflow: hidden;
+}
+[hidden] { display: none !important; }
+.grow { flex: 1; }
+.muted { color: var(--muted); font-size: 13px; }
+
+button, select, input, textarea { font: inherit; color: inherit; }
+button {
+  background: var(--panel); border: 1px solid var(--border); border-radius: 6px;
+  padding: 5px 10px; cursor: pointer; white-space: nowrap;
+}
+button:hover { background: var(--hover); }
+button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, .note:focus-visible {
+  outline: 2px solid var(--accent); outline-offset: 1px;
+}
+button.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-text); font-weight: 600; }
+button.primary:hover { filter: brightness(1.08); }
+button.danger { color: var(--danger); }
+button.ghost { border-color: transparent; background: none; color: var(--muted); }
+button.ghost:hover { background: var(--hover); color: var(--text); }
+button.link { border: 0; background: none; padding: 0 6px; font-size: 12px; }
+button.link:hover { text-decoration: underline; background: none; }
+button.icon { padding: 4px 9px; font-size: 16px; line-height: 1; }
+button.on { background: var(--accent-bg); border-color: var(--accent); }
+select { background: var(--panel); border: 1px solid var(--border); border-radius: 6px; padding: 3px 6px; }
+input[type=search], .ed-title, #tag-input { background: transparent; border: 0; }
+
+/* Layout */
+.app { display: grid; grid-template-columns: 220px 330px 1fr; height: 100%; }
+.sidebar { background: var(--side); border-right: 1px solid var(--border); padding: 14px 10px; display: flex; flex-direction: column; overflow-y: auto; }
+.brand { font-weight: 700; font-size: 18px; padding: 2px 10px 12px; letter-spacing: .2px; }
+.views button, .tags-nav button {
+  display: flex; width: 100%; justify-content: space-between; align-items: center; gap: 8px;
+  background: none; border: 0; padding: 6px 10px; border-radius: 6px; text-align: left;
+}
+.views button:hover, .tags-nav button:hover { background: var(--hover); }
+.views button.active, .tags-nav button.active { background: var(--sel); font-weight: 600; }
+.lbl { overflow: hidden; text-overflow: ellipsis; }
+.count { color: var(--muted); font-size: 12px; font-weight: 400; }
+.side-title { margin: 18px 10px 6px; font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
+.tags-nav { flex: 1; min-height: 40px; }
+.tags-nav .none { padding: 4px 10px; color: var(--muted); font-size: 13px; }
+.side-foot { padding-top: 10px; border-top: 1px solid var(--border); margin-top: 10px; }
+.side-foot button { width: 100%; text-align: left; }
+.scrim { display: none; }
+
+.list-pane { background: var(--panel); border-right: 1px solid var(--border); display: flex; flex-direction: column; min-width: 0; min-height: 0; }
+.list-head { display: flex; gap: 8px; padding: 10px; border-bottom: 1px solid var(--border); align-items: center; }
+.list-head input { flex: 1; min-width: 0; border: 1px solid var(--border); border-radius: 6px; padding: 6px 10px; background: var(--bg); }
+.menu-btn { display: none; }
+.list-meta { display: flex; align-items: center; gap: 6px; padding: 6px 12px; color: var(--muted); font-size: 12px; border-bottom: 1px solid var(--border); }
+.list-meta select { font-size: 12px; }
+#list-title { font-weight: 600; text-transform: uppercase; letter-spacing: .06em; font-size: 11px; }
+.note-list { list-style: none; margin: 0; padding: 0; overflow-y: auto; flex: 1; }
+.note { padding: 10px 14px; border-bottom: 1px solid var(--border); cursor: pointer; }
+.note:hover { background: var(--hover); }
+.note.sel { background: var(--sel); }
+.note .t { font-weight: 600; display: flex; gap: 6px; align-items: baseline; }
+.note .t span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.note .pin { color: var(--accent); font-size: 11px; font-weight: 700; }
+.note .untitled { color: var(--muted); font-weight: 400; font-style: italic; }
+.note .s { color: var(--muted); font-size: 13px; margin-top: 2px; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-word; }
+.note .m { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 5px; font-size: 11px; color: var(--muted); align-items: center; }
+.tagpill { background: var(--code-bg); border-radius: 9px; padding: 0 7px; font-size: 11px; }
+.empty-list { padding: 30px 20px; text-align: center; color: var(--muted); }
+mark { background: var(--accent-bg); color: inherit; border-radius: 2px; }
+
+/* Editor */
+.editor-pane { min-width: 0; min-height: 0; display: flex; flex-direction: column; background: var(--panel); }
+.no-note { margin: auto; text-align: center; color: var(--muted); padding: 20px; }
+.no-note h2 { color: var(--text); margin: 0 0 6px; }
+.editor { display: flex; flex-direction: column; height: 100%; min-height: 0; }
+.trash-bar { display: flex; gap: 8px; align-items: center; padding: 8px 16px; background: var(--accent-bg); border-bottom: 1px solid var(--border); font-size: 13px; flex-wrap: wrap; }
+.ed-head { display: flex; gap: 10px; align-items: center; padding: 10px 16px 4px; flex-wrap: wrap; }
+.ed-title { flex: 1 1 200px; min-width: 0; font-size: 22px; font-weight: 700; padding: 4px 0; }
+.seg { display: inline-flex; }
+.seg button { border-radius: 0; margin-left: -1px; }
+.seg button:first-child { border-radius: 6px 0 0 6px; margin-left: 0; }
+.seg button:last-child { border-radius: 0 6px 6px 0; }
+.actions { display: flex; gap: 6px; }
+.toolbar { display: flex; gap: 4px; padding: 4px 16px; flex-wrap: wrap; }
+.toolbar button { padding: 2px 8px; font-size: 13px; border-color: transparent; background: none; color: var(--muted); }
+.toolbar button:hover { background: var(--hover); color: var(--text); }
+.tag-row { padding: 2px 16px 8px; border-bottom: 1px solid var(--border); }
+.chips { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
+.chip { background: var(--code-bg); border-radius: 12px; padding: 1px 4px 1px 10px; font-size: 12px; display: inline-flex; align-items: center; gap: 2px; }
+.chip button { border: 0; background: none; padding: 0 5px; color: var(--muted); font-size: 14px; line-height: 1.2; }
+.chip button:hover { color: var(--danger); }
+#tag-input { min-width: 90px; flex: 1; padding: 3px 2px; font-size: 13px; }
+.panes { flex: 1; display: grid; grid-template-columns: 1fr; min-height: 0; }
+.panes[data-mode="split"] { grid-template-columns: 1fr 1fr; }
+.panes[data-mode="edit"] .preview { display: none; }
+.panes[data-mode="preview"] .ed-body { display: none; }
+.ed-body {
+  resize: none; border: 0; outline: 0; padding: 14px 16px; background: transparent; min-height: 0;
+  font: var(--fs)/1.6 ui-monospace, "SF Mono", Menlo, Consolas, monospace; tab-size: 2;
+}
+.panes[data-mode="split"] .ed-body { border-right: 1px solid var(--border); }
+.ed-body:read-only { opacity: .75; }
+.preview { overflow-y: auto; padding: 14px 20px 40px; min-height: 0; }
+.ed-foot { display: flex; gap: 14px; padding: 6px 16px; border-top: 1px solid var(--border); font-size: 12px; color: var(--muted); }
+.editor.readonly .toolbar, .editor.readonly .tag-row #tag-input { display: none; }
+
+/* Markdown */
+.md { font-size: 15px; line-height: 1.65; overflow-wrap: anywhere; }
+.md > :first-child { margin-top: 0; }
+.md h1, .md h2, .md h3, .md h4, .md h5, .md h6 { margin: 1.2em 0 .4em; line-height: 1.25; }
+.md h1 { font-size: 1.7em; border-bottom: 1px solid var(--border); padding-bottom: .2em; }
+.md h2 { font-size: 1.4em; border-bottom: 1px solid var(--border); padding-bottom: .15em; }
+.md h3 { font-size: 1.15em; }
+.md h4, .md h5, .md h6 { font-size: 1em; }
+.md p, .md ul, .md ol, .md blockquote, .md pre, .md table { margin: 0 0 .85em; }
+.md ul, .md ol { padding-left: 1.6em; }
+.md ul ul, .md ol ol, .md ul ol, .md ol ul { margin: 0; }
+.md li.task { list-style: none; margin-left: -1.3em; }
+.md li.task input { margin-right: .5em; cursor: pointer; transform: translateY(1px); }
+.md li.done { color: var(--muted); text-decoration: line-through; }
+.md blockquote { border-left: 3px solid var(--accent); margin-left: 0; padding: 0 1em; color: var(--muted); }
+.md code { background: var(--code-bg); padding: .1em .35em; border-radius: 4px; font: .9em ui-monospace, "SF Mono", Menlo, Consolas, monospace; }
+.md pre { background: var(--code-bg); padding: 12px 14px; border-radius: 8px; overflow-x: auto; }
+.md pre code { background: none; padding: 0; }
+.md a { color: var(--accent); }
+.md hr { border: 0; border-top: 1px solid var(--border); margin: 1.4em 0; }
+.md table { border-collapse: collapse; display: block; overflow-x: auto; }
+.md th, .md td { border: 1px solid var(--border); padding: 4px 10px; }
+.md th { background: var(--code-bg); }
+.md img { max-width: 100%; }
+.md .placeholder { color: var(--muted); font-style: italic; }
+
+/* Toasts & dialog */
+.toasts { position: fixed; left: 50%; bottom: 20px; transform: translateX(-50%); display: flex; flex-direction: column; gap: 8px; z-index: 50; align-items: center; }
+.toast { background: var(--text); color: var(--bg); padding: 8px 14px; border-radius: 8px; box-shadow: var(--shadow); display: flex; gap: 12px; align-items: center; }
+.toast button { background: none; border: 0; color: var(--accent); font-weight: 700; padding: 0; }
+:root[data-theme="light"] .toast button { color: #f0c64a; }
+dialog { background: var(--panel); color: var(--text); border: 1px solid var(--border); border-radius: 12px; padding: 0; width: min(520px, 94vw); box-shadow: var(--shadow); max-height: 92vh; }
+dialog::backdrop { background: #0006; }
+.dlg { padding: 18px 22px; }
+.dlg h2 { margin: 0 0 12px; }
+.dlg h3 { margin: 18px 0 6px; font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
+.row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; }
+.btn-row { display: flex; gap: 8px; flex-wrap: wrap; }
+.dlg-foot { text-align: right; margin-top: 18px; }
+.keys { border-collapse: collapse; font-size: 13px; width: 100%; }
+.keys td { padding: 3px 0; }
+.keys td:first-child { white-space: nowrap; padding-right: 14px; }
+kbd { background: var(--code-bg); border: 1px solid var(--border); border-radius: 4px; padding: 0 5px; font: 11px ui-monospace, Menlo, monospace; }
+
+/* Responsive */
+.back-btn { display: none; }
+@media (max-width: 1100px) {
+  .app { grid-template-columns: 300px 1fr; }
+  .sidebar { position: fixed; z-index: 30; top: 0; bottom: 0; left: 0; width: 250px; transform: translateX(-100%); transition: transform .18s; box-shadow: var(--shadow); }
+  .app.menu-open .sidebar { transform: none; }
+  .app.menu-open .scrim { display: block; position: fixed; inset: 0; background: #0005; z-index: 20; }
+  .menu-btn { display: inline-block; }
+  .split-only { display: none; }
+}
+@media (max-width: 720px) {
+  .app { grid-template-columns: 1fr; }
+  .app[data-pane="list"] .editor-pane { display: none; }
+  .app[data-pane="editor"] .list-pane { display: none; }
+  .back-btn { display: inline-block; }
+  .ed-head { padding: 8px 10px 2px; }
+  .ed-title { font-size: 19px; flex-basis: 140px; }
+  .actions { width: 100%; flex-wrap: wrap; }
+  .toolbar, .tag-row, .ed-foot { padding-left: 10px; padding-right: 10px; }
+  .ed-body { padding: 12px 10px; }
+  #st-dates { display: none; }
+}
+@media print {
+  .sidebar, .list-pane, .ed-head, .toolbar, .tag-row, .ed-foot, .trash-bar { display: none !important; }
+  body { overflow: visible; background: #fff; color: #000; }
+  .app { display: block; height: auto; }
+  .panes[data-mode] .ed-body { display: none; }
+  .panes[data-mode] .preview { display: block; overflow: visible; }
+}
