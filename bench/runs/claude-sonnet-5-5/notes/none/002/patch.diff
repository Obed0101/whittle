+}
+function persist() { setSaveStatus('Saving…'); clearTimeout(saveTimer); saveTimer = setTimeout(persistNow, 250); }
+function savePrefs() { try { localStorage.setItem(K_PREFS, JSON.stringify(prefs)); } catch (e) {} }
+function setSaveStatus(t) { $('#st-save').textContent = t; }
+
+/* ---------- queries ---------- */
+const byId = id => notes.find(n => n.id === id);
+const isActive = n => !n.archived && !n.trashed;
+function inView(n) {
+  switch (prefs.view) {
+    case 'pinned': return isActive(n) && n.pinned;
+    case 'archive': return n.archived && !n.trashed;
+    case 'trash': return !!n.trashed;
+    default: return isActive(n);
+  }
+}
+function terms() { return ui.query.toLowerCase().split(/\s+/).filter(Boolean); }
+function matches(n, ts) {
+  if (!ts.length) return true;
+  const hay = (n.title + '\n' + n.body + '\n' + n.tags.join(' ')).toLowerCase();
+  return ts.every(t => t.startsWith('#') && t.length > 1 ? n.tags.some(g => g.includes(t.slice(1))) : hay.includes(t));
+}
+function visible() {
+  const ts = terms();
