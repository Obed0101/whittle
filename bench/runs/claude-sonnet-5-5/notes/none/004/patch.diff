@@ -0,0 +1,150 @@
+:root {
+  --bg: #ffffff; --bg2: #f6f5f2; --bg3: #ecebe6; --fg: #1f1f1d; --muted: #77756e;
+  --border: #e2e0d9; --accent: #c78d0a; --accent-fg: #fff; --sel: #fbf1d3;
+  --danger: #c0392b; --code-bg: #f1efe9; --shadow: 0 6px 24px rgba(0,0,0,.15);
+  --fs: 16px; --editor-font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
+}
+:root[data-theme="dark"] {
+  --bg: #1b1b1a; --bg2: #232322; --bg3: #2d2d2b; --fg: #e8e6e0; --muted: #98958c;
+  --border: #353532; --accent: #e0a526; --accent-fg: #1b1b1a; --sel: #3a3220;
+  --danger: #ef6a5b; --code-bg: #2a2a28; --shadow: 0 6px 24px rgba(0,0,0,.5);
+}
+@media (prefers-color-scheme: dark) {
+  :root[data-theme="auto"] {
+    --bg: #1b1b1a; --bg2: #232322; --bg3: #2d2d2b; --fg: #e8e6e0; --muted: #98958c;
+    --border: #353532; --accent: #e0a526; --accent-fg: #1b1b1a; --sel: #3a3220;
+    --danger: #ef6a5b; --code-bg: #2a2a28; --shadow: 0 6px 24px rgba(0,0,0,.5);
+  }
+}
+* { box-sizing: border-box; }
+html, body { height: 100%; margin: 0; }
+body { font: 14px/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background: var(--bg); color: var(--fg); }
+button, input, select, textarea { font: inherit; color: inherit; }
+button { cursor: pointer; border: 1px solid var(--border); background: var(--bg2); border-radius: 6px; padding: 5px 10px; }
+button:hover { background: var(--bg3); }
+button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, .note-item:focus-visible {
+  outline: 2px solid var(--accent); outline-offset: 1px; }
+button.primary { background: var(--accent); color: var(--accent-fg); border-color: var(--accent); font-weight: 600; }
+button.primary:hover { filter: brightness(1.08); }
+button.ghost { border-color: transparent; background: transparent; }
+button.ghost:hover { background: var(--bg3); }
+button.danger { color: var(--danger); border-color: var(--danger); background: transparent; }
+button.danger:hover { background: var(--danger); color: #fff; }
+button.small { padding: 3px 8px; font-size: 12px; }
+input[type=text], input[type=search], select { background: var(--bg); border: 1px solid var(--border); border-radius: 6px; padding: 6px 8px; }
+.hidden { display: none !important; }
+.muted { color: var(--muted); }
+.small { font-size: 12px; }
+.spacer { flex: 1; }
+
+.app { display: grid; grid-template-columns: 210px 320px 1fr; height: 100%; }
+
+/* sidebar */
+.sidebar { background: var(--bg2); border-right: 1px solid var(--border); padding: 14px 10px; display: flex; flex-direction: column; gap: 8px; overflow-y: auto; }
+.brand { font-weight: 700; font-size: 18px; padding: 0 6px 4px; }
+.nav { display: flex; flex-direction: column; gap: 1px; }
+.nav button { display: flex; justify-content: space-between; align-items: center; text-align: left; border: 0; background: transparent; padding: 6px 8px; border-radius: 6px; width: 100%; }
+.nav button:hover { background: var(--bg3); }
+.nav button.active { background: var(--sel); font-weight: 600; }
+.nav .count { color: var(--muted); font-size: 12px; font-weight: 400; }
+.nav-heading { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); padding: 8px 8px 0; }
+.sidebar-foot { margin-top: auto; }
+.sidebar-foot button { width: 100%; text-align: left; }
+
+/* list */
+.list-pane { border-right: 1px solid var(--border); display: flex; flex-direction: column; min-height: 0; }
+.list-head { padding: 12px; display: flex; flex-direction: column; gap: 8px; border-bottom: 1px solid var(--border); }
+.list-head input { width: 100%; }
+.list-tools { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
+.list-title { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.list-tools select { padding: 3px 6px; font-size: 12px; }
+.note-list { list-style: none; margin: 0; padding: 0; overflow-y: auto; flex: 1; }
+.note-item { padding: 10px 14px; border-bottom: 1px solid var(--border); cursor: pointer; }
+.note-item:hover { background: var(--bg2); }
+.note-item.active { background: var(--sel); }
+.note-item .row1 { display: flex; justify-content: space-between; gap: 8px; }
+.note-item .t { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.note-item .t.untitled { color: var(--muted); font-weight: 400; font-style: italic; }
+.note-item .d { color: var(--muted); font-size: 11px; white-space: nowrap; }
+.note-item .snip { color: var(--muted); font-size: 12px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; margin-top: 2px; word-break: break-word; }
+.note-item .tg { margin-top: 4px; display: flex; flex-wrap: wrap; gap: 4px; }
+.tag { font-size: 11px; background: var(--bg3); border-radius: 10px; padding: 1px 8px; }
+mark { background: #ffd95a; color: #000; border-radius: 2px; }
+.no-results { padding: 30px 16px; text-align: center; color: var(--muted); }
+
+/* editor */
+.editor-pane { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
+.empty-state { margin: auto; text-align: center; color: var(--muted); display: flex; flex-direction: column; gap: 12px; align-items: center; }
+.editor { display: flex; flex-direction: column; flex: 1; min-height: 0; padding: 0 28px 10px; }
+.editor-bar { display: flex; align-items: center; gap: 4px; padding: 10px 0; flex-wrap: wrap; }
+.seg { display: inline-flex; border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
+.seg button { border: 0; border-radius: 0; background: transparent; }
+.seg button.on { background: var(--accent); color: var(--accent-fg); }
+.back, .menu { display: none; }
+.list-title { flex: 1; }
+.title { font-size: 1.7em; font-weight: 700; border: 0 !important; background: transparent !important; padding: 6px 0 !important; width: 100%; font-family: var(--editor-font); }
+.title:focus { outline: none; }
+.tag-box { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; padding-bottom: 8px; }
+#chips { display: contents; }
+.chip { display: inline-flex; align-items: center; gap: 4px; background: var(--bg3); border-radius: 12px; padding: 2px 4px 2px 10px; font-size: 12px; }
+.chip button { border: 0; background: transparent; padding: 0 5px; line-height: 1; color: var(--muted); border-radius: 50%; }
+.chip button:hover { color: var(--danger); }
+.tag-box input { border: 0; background: transparent; padding: 3px 0; width: 120px; font-size: 12px; }
+.tag-box input:focus { outline: none; }
+.toolbar { display: flex; gap: 4px; flex-wrap: wrap; padding-bottom: 8px; border-bottom: 1px solid var(--border); }
+.toolbar button { padding: 2px 9px; font-size: 12px; background: transparent; }
+.body, .preview { flex: 1; min-height: 0; width: 100%; overflow-y: auto; padding: 14px 0; font-family: var(--editor-font); font-size: var(--fs); line-height: 1.65; }
+.body { border: 0; resize: none; background: transparent; tab-size: 2; }
+.body:focus { outline: none; }
+.editor-foot { display: flex; justify-content: space-between; gap: 12px; padding-top: 6px; border-top: 1px solid var(--border); flex-wrap: wrap; }
+
+/* markdown */
+.preview h1, .preview h2, .preview h3, .preview h4 { line-height: 1.25; margin: 1.1em 0 .4em; }
+.preview h1 { font-size: 1.7em; } .preview h2 { font-size: 1.4em; } .preview h3 { font-size: 1.15em; }
+.preview > :first-child { margin-top: 0; }
+.preview p { margin: .6em 0; }
+.preview code { background: var(--code-bg); padding: .1em .35em; border-radius: 4px; font: .9em ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
+.preview pre { background: var(--code-bg); padding: 12px; border-radius: 8px; overflow-x: auto; }
+.preview pre code { padding: 0; background: none; }
+.preview blockquote { margin: .6em 0; padding: 0 14px; border-left: 3px solid var(--accent); color: var(--muted); }
+.preview a { color: var(--accent); }
+.preview hr { border: 0; border-top: 1px solid var(--border); margin: 1.2em 0; }
+.preview ul, .preview ol { padding-left: 1.5em; margin: .5em 0; }
+.preview li.task { list-style: none; margin-left: -1.3em; }
+.preview li.task.done > span { text-decoration: line-through; color: var(--muted); }
+.preview li.task input { margin-right: 6px; }
+.preview table { border-collapse: collapse; margin: .8em 0; }
+.preview th, .preview td { border: 1px solid var(--border); padding: 4px 10px; }
+.preview th { background: var(--bg2); }
+.preview .nothing { color: var(--muted); font-style: italic; }
+
+/* toast & dialog */
+.toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); background: var(--fg); color: var(--bg); padding: 9px 14px; border-radius: 8px; box-shadow: var(--shadow); display: flex; gap: 14px; align-items: center; z-index: 10; }
+.toast button { background: transparent; color: var(--accent); border: 0; font-weight: 700; padding: 0; }
+dialog { border: 1px solid var(--border); border-radius: 12px; background: var(--bg); color: var(--fg); padding: 0; width: min(520px, 94vw); box-shadow: var(--shadow); }
+dialog::backdrop { background: rgba(0,0,0,.4); }
+.dlg { padding: 20px 22px; max-height: 88vh; overflow-y: auto; }
+.dlg h2 { margin: 0 0 8px; } .dlg h3 { margin: 18px 0 6px; font-size: 13px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
+.row { display: flex; justify-content: space-between; align-items: center; padding: 4px 0; }
+.row-btns { display: flex; gap: 8px; flex-wrap: wrap; margin: 8px 0; }
+.row-btns.end { justify-content: flex-end; margin-top: 18px; }
+.keys td { padding: 2px 12px 2px 0; }
+kbd { background: var(--bg3); border: 1px solid var(--border); border-radius: 4px; padding: 0 5px; font: 12px ui-monospace, Menlo, monospace; }
+
+/* narrower screens: one pane at a time */
+@media (max-width: 900px) {
+  .app { grid-template-columns: 170px 280px 1fr; }
+}
+@media (max-width: 720px) {
+  .app { grid-template-columns: 1fr; position: relative; }
+  .sidebar, .list-pane, .editor-pane { grid-area: 1 / 1; }
+  .sidebar { display: none; flex-direction: row; flex-wrap: wrap; padding: 8px; border-right: 0; border-bottom: 1px solid var(--border); }
+  .app:not(.show-editor) .editor-pane { display: none; }
+  .app.show-editor .list-pane, .app.show-editor .sidebar { display: none; }
+  .list-pane { border-right: 0; }
+  .back, .menu { display: inline-block; }
+  .editor { padding: 0 14px 10px; }
+  .app.show-nav .sidebar { display: flex; }
+  .app.show-nav .list-pane { display: none; }
+}
+@media print { .sidebar, .list-pane, .editor-bar, .toolbar, .editor-foot, .tag-box { display: none !important; } .app { display: block; } }
