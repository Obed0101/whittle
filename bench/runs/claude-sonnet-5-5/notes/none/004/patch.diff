+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Notes</title>
+<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23d9a21b'/%3E%3Cpath d='M9 10h14M9 16h14M9 22h8' stroke='white' stroke-width='3' stroke-linecap='round'/%3E%3C/svg%3E">
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<div id="app" class="app">
+
+  <aside id="sidebar" class="sidebar" aria-label="Navigation">
+    <div class="brand">Notes</div>
+    <button id="newBtn" class="primary" title="New note (n)">+ New note</button>
+    <nav id="nav" class="nav"></nav>
+    <div class="nav-heading">Tags</div>
+    <nav id="tagNav" class="nav tags"></nav>
+    <div class="sidebar-foot">
+      <button id="settingsBtn" class="ghost" title="Settings, backup &amp; help">Settings &amp; backup</button>
+    </div>
+  </aside>
+
+  <section id="listPane" class="list-pane" aria-label="Note list">
+    <div class="list-head">
+      <input id="search" type="search" placeholder="Search notes  ( / )" autocomplete="off" aria-label="Search notes">
+      <div class="list-tools">
+        <button id="menuBtn" class="ghost small menu" title="Folders &amp; tags">☰</button>
+        <span id="listTitle" class="list-title"></span>
+        <select id="sort" aria-label="Sort notes">
+          <option value="updated">Last edited</option>
+          <option value="created">Date created</option>
+          <option value="title">Title A–Z</option>
+        </select>
+      </div>
+      <button id="emptyTrash" class="danger small hidden">Empty trash</button>
+    </div>
+    <ul id="list" class="note-list"></ul>
+  </section>
+
+  <main id="editorPane" class="editor-pane" aria-label="Editor">
+    <div id="empty" class="empty-state">
+      <p>Select a note or create a new one.</p>
+      <button id="emptyNew" class="primary">+ New note</button>
+    </div>
+
+    <div id="editor" class="editor hidden">
+      <div class="editor-bar">
+        <button id="backBtn" class="ghost back" title="Back to list">←</button>
+        <div class="seg" role="tablist">
+          <button id="modeEdit" role="tab">Edit</button>
+          <button id="modePreview" role="tab">Preview</button>
+        </div>
+        <div class="spacer"></div>
+        <span id="saveState" class="muted small" aria-live="polite"></span>
+        <button id="pinBtn" class="ghost" title="Pin / unpin"></button>
+        <button id="archiveBtn" class="ghost" title="Archive / unarchive"></button>
+        <button id="exportBtn" class="ghost" title="Download as Markdown">Export</button>
+        <button id="trashBtn" class="ghost" title="Move to trash"></button>
+        <button id="restoreBtn" class="ghost hidden">Restore</button>
+        <button id="deleteBtn" class="danger small hidden">Delete forever</button>
+      </div>
+
+      <input id="title" class="title" type="text" placeholder="Title" aria-label="Title" maxlength="200">
+      <div id="tagBox" class="tag-box">
+        <span id="chips"></span>
+        <input id="tagInput" type="text" placeholder="Add tag…" list="tagList" aria-label="Add tag" maxlength="40">
+        <datalist id="tagList"></datalist>
+      </div>
+
+      <div id="toolbar" class="toolbar">
+        <button data-act="h" title="Heading">H</button>
+        <button data-act="bold" title="Bold (Ctrl+B)"><b>B</b></button>
+        <button data-act="italic" title="Italic (Ctrl+I)"><i>I</i></button>
+        <button data-act="code" title="Code">&lt;/&gt;</button>
+        <button data-act="link" title="Link (Ctrl+K in editor)">Link</button>
+        <button data-act="ul" title="Bullet list">• List</button>
+        <button data-act="task" title="Checklist">☑ Tasks</button>
+        <button data-act="quote" title="Quote">“ ”</button>
+      </div>
+
+      <textarea id="body" class="body" placeholder="Start writing…  Markdown is supported." aria-label="Note body" spellcheck="true"></textarea>
+      <div id="preview" class="preview hidden"></div>
+
+      <div class="editor-foot muted small">
+        <span id="stats"></span>
+        <span id="dates"></span>
+      </div>
+    </div>
+  </main>
+</div>
+
+<div id="toast" class="toast hidden" role="status"></div>
+
+<dialog id="settings">
+  <form method="dialog" class="dlg">
+    <h2>Settings &amp; backup</h2>
+
+    <h3>Appearance</h3>
+    <label class="row">Theme
+      <select id="theme">
+        <option value="auto">Match system</option>
+        <option value="light">Light</option>
+        <option value="dark">Dark</option>
+      </select>
+    </label>
+    <label class="row">Font size
+      <select id="fontSize">
+        <option value="14">Small</option>
+        <option value="16">Medium</option>
+        <option value="18">Large</option>
+      </select>
+    </label>
+    <label class="row">Editor font
+      <select id="fontFamily">
+        <option value="sans">Sans-serif</option>
+        <option value="serif">Serif</option>
+        <option value="mono">Monospace</option>
+      </select>
+    </label>
+
+    <h3>Backup</h3>
+    <p class="muted small">Notes live only in this browser. Download a backup regularly.</p>
+    <div class="row-btns">
+      <button type="button" id="backupBtn">Download backup (JSON)</button>
+      <button type="button" id="importBtn">Import backup…</button>
+      <input id="importFile" type="file" accept="application/json,.json" class="hidden">
+    </div>
+    <p id="storageInfo" class="muted small"></p>
+
+    <h3>Keyboard shortcuts</h3>
+    <table class="keys">
+      <tr><td><kbd>n</kbd></td><td>New note</td></tr>
+      <tr><td><kbd>/</kbd> or <kbd>Ctrl/⌘ K</kbd></td><td>Search</td></tr>
+      <tr><td><kbd>Ctrl/⌘ E</kbd></td><td>Toggle edit / preview</td></tr>
+      <tr><td><kbd>Ctrl/⌘ B</kbd> / <kbd>I</kbd></td><td>Bold / italic (in editor)</td></tr>
+      <tr><td><kbd>↑</kbd> <kbd>↓</kbd></td><td>Move through the note list</td></tr>
+      <tr><td><kbd>Esc</kbd></td><td>Clear search / leave editor</td></tr>
+      <tr><td><kbd>?</kbd></td><td>This dialog</td></tr>
+    </table>
+    <p class="muted small">Markdown: # headings, **bold**, *italic*, `code`, ``` code blocks, - lists, - [ ] tasks, &gt; quotes, tables, [links](https://…).</p>
+
+    <div class="row-btns end"><button class="primary">Done</button></div>
+  </form>
+</dialog>
+
+<script src="app.js"></script>
+</body>
+</html>
diff --git a/notes/style.css b/notes/style.css
new file mode 100644
