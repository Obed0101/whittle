+:root {
+  --bg: #ffffff; --bg2: #f6f6f4; --bg3: #ececE8; --fg: #1d1d1b; --muted: #77766f;
+  --border: #e1e0da; --accent: #c98a0b; --accent-fg: #fff; --sel: #fbf0d6;
+  --danger: #c0392b; --code-bg: #f1f0ec; --link: #1a64c8;
+  --font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
+  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  color-scheme: light;
+}
+:root[data-theme="dark"] {
+  --bg: #1b1b1a; --bg2: #232322; --bg3: #2d2d2b; --fg: #e8e7e2; --muted: #8e8d86;
+  --border: #353533; --accent: #e8a317; --accent-fg: #1b1b1a; --sel: #3a3220;
+  --danger: #ef6a5b; --code-bg: #2a2a28; --link: #6cb0ff;
+  color-scheme: dark;
+}
+* { box-sizing: border-box; }
+html, body { height: 100%; margin: 0; }
+body { font: 15px/1.5 var(--font); background: var(--bg); color: var(--fg); overflow: hidden; }
+button, input, select, textarea { font: inherit; color: inherit; }
+button { cursor: pointer; background: var(--bg2); border: 1px solid var(--border); border-radius: 6px; padding: 5px 10px; }
+button:hover { background: var(--bg3); }
+button:focus-visible, input:focus-visible, select:focus-visible, .note-item:focus-visible, .nav-item:focus-visible {
+  outline: 2px solid var(--accent); outline-offset: 1px;
+}
+button.primary { background: var(--accent); color: var(--accent-fg); border-color: transparent; font-weight: 600; }
+button.primary:hover { filter: brightness(1.08); }
+button.ghost { background: none; border-color: transparent; color: var(--muted); }
+button.ghost:hover { background: var(--bg3); color: var(--fg); }
+button.icon { background: none; border-color: transparent; padding: 4px 8px; font-size: 16px; line-height: 1.2; }
+button.icon:hover { background: var(--bg3); }
+button.icon.on { color: var(--accent); }
+kbd { font: 12px var(--mono); background: var(--bg3); border: 1px solid var(--border); border-radius: 4px; padding: 1px 5px; }
+.muted { color: var(--muted); }
+.only-mobile { display: none; }
+
+#app { display: grid; grid-template-columns: 220px 320px 1fr; height: 100%; }
+
+/* sidebar */
+#sidebar { background: var(--bg2); border-right: 1px solid var(--border); display: flex; flex-direction: column; padding: 14px 10px; overflow: hidden; }
+.brand { font-weight: 700; font-size: 18px; padding: 0 8px 12px; letter-spacing: .3px; }
+#new-btn { margin: 0 4px 12px; padding: 8px; }
+.nav-item { display: flex; justify-content: space-between; align-items: center; width: 100%; text-align: left;
+  background: none; border: 0; border-radius: 6px; padding: 6px 8px; }
+.nav-item:hover { background: var(--bg3); }
+.nav-item.active { background: var(--sel); font-weight: 600; }
+.nav-item .count { color: var(--muted); font-size: 12px; font-weight: 400; }
+.side-title { font-size: 11px; text-transform: uppercase; letter-spacing: .8px; color: var(--muted); padding: 14px 8px 4px; }
+#tags { flex: 1; overflow-y: auto; min-height: 0; }
+.side-foot { display: flex; gap: 4px; padding-top: 8px; border-top: 1px solid var(--border); }
+.side-foot .ghost:nth-child(2) { flex: 1; }
+
+/* list */
+#list-pane { border-right: 1px solid var(--border); display: flex; flex-direction: column; min-width: 0; min-height: 0; }
+.list-head { display: flex; gap: 6px; padding: 10px; border-bottom: 1px solid var(--border); }
+#search { flex: 1; min-width: 0; padding: 6px 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg); }
+#sort { border: 1px solid var(--border); border-radius: 6px; background: var(--bg); padding: 4px; }
+#list-title { padding: 8px 14px 4px; font-size: 12px; color: var(--muted); display: flex; justify-content: space-between; align-items: center; min-height: 30px; }
+#list-title button { font-size: 12px; padding: 2px 8px; }
+#list { overflow-y: auto; flex: 1; min-height: 0; }
+.note-item { padding: 10px 14px; border-bottom: 1px solid var(--border); cursor: pointer; }
+.note-item:hover { background: var(--bg2); }
+.note-item.active { background: var(--sel); }
+.note-top { display: flex; gap: 6px; align-items: baseline; }
+.note-title { font-weight: 600; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.note-title.untitled { color: var(--muted); font-style: italic; font-weight: 500; }
+.note-date { font-size: 12px; color: var(--muted); white-space: nowrap; }
+.note-snip { color: var(--muted); font-size: 13px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; word-break: break-word; }
+.note-tags { margin-top: 4px; display: flex; gap: 4px; flex-wrap: wrap; }
+.tag-pill { font-size: 11px; background: var(--bg3); border-radius: 10px; padding: 0 7px; color: var(--muted); }
+mark { background: #ffe58a; color: #222; border-radius: 2px; }
+.list-empty { padding: 30px 20px; text-align: center; color: var(--muted); }
+
+/* editor */
+#editor-pane { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
+#empty-state { flex: 1; display: flex; align-items: center; justify-content: center; text-align: center; color: var(--muted); padding: 20px; }
+#editor { display: flex; flex-direction: column; flex: 1; min-height: 0; }
+#editor[hidden], #empty-state[hidden] { display: none; }
+.toolbar { display: flex; align-items: center; gap: 2px; padding: 6px 10px; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
+.toolbar .spacer { flex: 1; }
+.fmt { display: flex; gap: 2px; }
+.fmt button { background: none; border-color: transparent; padding: 3px 8px; min-width: 28px; }
+.fmt button:hover { background: var(--bg3); }
+.modes { display: flex; margin-right: 8px; }
+.modes button { border-radius: 0; padding: 3px 9px; font-size: 13px; }
+.modes button:first-child { border-radius: 6px 0 0 6px; }
+.modes button:last-child { border-radius: 0 6px 6px 0; }
+.modes button + button { border-left: 0; }
+.modes button.on { background: var(--accent); color: var(--accent-fg); border-color: var(--accent); }
+#banner { background: var(--sel); padding: 8px 16px; display: flex; gap: 10px; align-items: center; border-bottom: 1px solid var(--border); font-size: 14px; }
+#banner[hidden] { display: none; }
+#title { border: 0; background: none; font-size: 26px; font-weight: 700; padding: 16px 20px 4px; width: 100%; outline: none; }
+#tagbar { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 4px 20px 10px; }
+#chips { display: contents; }
+.chip { background: var(--bg3); border-radius: 12px; padding: 1px 4px 1px 10px; font-size: 13px; display: inline-flex; align-items: center; gap: 2px; }
+.chip button { background: none; border: 0; padding: 0 5px; color: var(--muted); font-size: 15px; line-height: 1; }
+.chip button:hover { color: var(--danger); background: none; }
+#tag-input { border: 0; background: none; outline: none; font-size: 13px; min-width: 90px; flex: 1; }
+#panes { flex: 1; display: grid; min-height: 0; border-top: 1px solid var(--border); }
+#panes.mode-edit { grid-template-columns: 1fr; }
+#panes.mode-edit #preview { display: none; }
+#panes.mode-preview { grid-template-columns: 1fr; }
+#panes.mode-preview #body { display: none; }
+#panes.mode-split { grid-template-columns: 1fr 1fr; }
+#panes.mode-split #preview { border-left: 1px solid var(--border); }
+#body { resize: none; border: 0; outline: none; background: none; padding: 16px 20px; font: 14px/1.6 var(--mono); min-height: 0; tab-size: 2; }
+#preview { overflow-y: auto; padding: 16px 20px; min-height: 0; }
+.statusbar { display: flex; justify-content: space-between; gap: 10px; padding: 4px 16px; font-size: 12px; color: var(--muted); border-top: 1px solid var(--border); }
+
+/* markdown */
+.md { word-wrap: break-word; }
+.md > :first-child { margin-top: 0; }
+.md h1, .md h2, .md h3, .md h4, .md h5, .md h6 { margin: 1.2em 0 .5em; line-height: 1.25; }
+.md h1 { font-size: 1.7em; } .md h2 { font-size: 1.4em; } .md h3 { font-size: 1.2em; }
+.md h4, .md h5, .md h6 { font-size: 1em; }
+.md p { margin: .6em 0; }
+.md a { color: var(--link); }
+.md code { font: .9em var(--mono); background: var(--code-bg); padding: 1px 5px; border-radius: 4px; }
+.md pre { background: var(--code-bg); padding: 12px 14px; border-radius: 8px; overflow-x: auto; }
+.md pre code { background: none; padding: 0; }
+.md blockquote { margin: .8em 0; padding: 0 14px; border-left: 3px solid var(--accent); color: var(--muted); }
+.md ul, .md ol { padding-left: 1.6em; margin: .4em 0; }
+.md li.task { list-style: none; margin-left: -1.3em; }
+.md li.task input { margin-right: 6px; cursor: pointer; }
+.md li.task.done > span { text-decoration: line-through; color: var(--muted); }
+.md hr { border: 0; border-top: 1px solid var(--border); margin: 1.2em 0; }
+.md table { border-collapse: collapse; margin: .8em 0; display: block; overflow-x: auto; }
+.md th, .md td { border: 1px solid var(--border); padding: 4px 10px; }
+.md th { background: var(--bg2); }
+
+/* misc */
+#toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); background: #2b2b29; color: #f2f2ee;
+  padding: 9px 16px; border-radius: 8px; box-shadow: 0 4px 18px rgba(0,0,0,.3); display: flex; gap: 14px; align-items: center; z-index: 50; }
+#toast[hidden] { display: none; }
+#toast button { background: none; border: 0; color: #f5c451; font-weight: 600; padding: 0; }
+dialog { border: 1px solid var(--border); border-radius: 10px; background: var(--bg); color: var(--fg); max-width: 520px; width: calc(100% - 32px); padding: 20px; }
+dialog::backdrop { background: rgba(0,0,0,.4); }
+dialog h3 { margin-top: 0; }
+dialog table td { padding: 3px 12px 3px 0; vertical-align: top; }
+dialog .row { display: flex; gap: 8px; flex-wrap: wrap; margin: 12px 0; }
+dialog form { text-align: right; }
+
+/* mobile */
+@media (max-width: 860px) {
+  .only-mobile { display: inline-block; }
+  #app { grid-template-columns: 1fr; }
+  #sidebar { position: fixed; left: 0; top: 0; bottom: 0; width: 260px; z-index: 30; transform: translateX(-100%); transition: transform .2s; }
+  #app.show-sidebar #sidebar { transform: none; box-shadow: 4px 0 24px rgba(0,0,0,.25); }
+  #scrim { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.35); z-index: 20; }
+  #app.show-sidebar #scrim { display: block; }
+  #editor-pane { display: none; }
+  #app.show-editor #editor-pane { display: flex; }
+  #app.show-editor #list-pane { display: none; }
+  #panes.mode-split { grid-template-columns: 1fr; grid-template-rows: 1fr 1fr; }
+  #panes.mode-split #preview { border-left: 0; border-top: 1px solid var(--border); }
+  #title { font-size: 22px; }
+  .fmt button { padding: 3px 6px; min-width: 24px; }
+}
+@media print {
+  #sidebar, #list-pane, .toolbar, #tagbar, .statusbar, #body { display: none !important; }
+  body { overflow: visible; } #app { display: block; height: auto; }
+  #preview { display: block !important; overflow: visible; }
+}
