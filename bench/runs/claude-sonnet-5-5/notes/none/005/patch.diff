+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Notes</title>
+<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23e8a317'/%3E%3Cpath d='M9 9h14M9 16h14M9 23h9' stroke='%23fff' stroke-width='3' stroke-linecap='round'/%3E%3C/svg%3E">
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<div id="app">
+  <div id="scrim"></div>
+
+  <aside id="sidebar" aria-label="Navigation">
+    <div class="brand">Notes</div>
+    <button id="new-btn" class="primary" title="New note (Ctrl/Cmd+Alt+N)">+ New note</button>
+    <nav id="views"></nav>
+    <div class="side-title">Tags</div>
+    <div id="tags"></div>
+    <div class="side-foot">
+      <button id="theme-btn" class="ghost" title="Change theme"></button>
+      <button id="data-btn" class="ghost" title="Export / import">Data</button>
+      <button id="help-btn" class="ghost" title="Keyboard shortcuts">?</button>
+    </div>
+  </aside>
+
+  <section id="list-pane" aria-label="Notes list">
+    <div class="list-head">
+      <button id="menu-btn" class="icon only-mobile" title="Menu" aria-label="Menu">☰</button>
+      <input id="search" type="search" placeholder="Search notes…  ( / )" autocomplete="off" aria-label="Search">
+      <select id="sort" title="Sort by" aria-label="Sort">
+        <option value="updated">Modified</option>
+        <option value="created">Created</option>
+        <option value="title">Title</option>
+      </select>
+    </div>
+    <div id="list-title"></div>
+    <div id="list" role="list"></div>
+  </section>
+
+  <main id="editor-pane">
+    <div id="empty-state">
+      <div>
+        <h2>No note selected</h2>
+        <p>Pick a note from the list or press <kbd>Ctrl/Cmd</kbd>+<kbd>Alt</kbd>+<kbd>N</kbd> to start a new one.</p>
+      </div>
+    </div>
+    <div id="editor" hidden>
+      <div class="toolbar">
+        <button id="back-btn" class="icon only-mobile" title="Back" aria-label="Back">←</button>
+        <div class="fmt" id="fmt">
+          <button data-fmt="h" title="Heading">H</button>
+          <button data-fmt="b" title="Bold (Ctrl/Cmd+B)"><b>B</b></button>
+          <button data-fmt="i" title="Italic (Ctrl/Cmd+I)"><i>I</i></button>
+          <button data-fmt="code" title="Code">&lt;/&gt;</button>
+          <button data-fmt="link" title="Link (Ctrl/Cmd+K in editor)">🔗</button>
+          <button data-fmt="ul" title="Bullet list">•</button>
+          <button data-fmt="task" title="Checklist">☑</button>
+          <button data-fmt="quote" title="Quote">❝</button>
+        </div>
+        <div class="spacer"></div>
+        <div class="modes" id="modes">
+          <button data-mode="edit">Edit</button>
+          <button data-mode="split">Split</button>
+          <button data-mode="preview">Preview</button>
+        </div>
+        <button id="pin-btn" class="icon" title="Pin"></button>
+        <button id="archive-btn" class="icon" title="Archive">🗄</button>
+        <button id="dup-btn" class="icon" title="Duplicate">⧉</button>
+        <button id="download-btn" class="icon" title="Download as Markdown">⬇</button>
+        <button id="delete-btn" class="icon" title="Move to trash">🗑</button>
+      </div>
+      <div id="banner" hidden></div>
+      <input id="title" type="text" placeholder="Title" autocomplete="off" aria-label="Title" maxlength="200">
+      <div id="tagbar">
+        <div id="chips"></div>
+        <input id="tag-input" type="text" placeholder="Add tag…" list="tag-suggest" autocomplete="off" aria-label="Add tag">
+        <datalist id="tag-suggest"></datalist>
+      </div>
+      <div id="panes" class="mode-split">
+        <textarea id="body" placeholder="Write something… Markdown is supported." spellcheck="true" aria-label="Note body"></textarea>
+        <div id="preview" class="md"></div>
+      </div>
+      <div class="statusbar"><span id="meta"></span><span id="stats"></span></div>
+    </div>
+  </main>
+</div>
+
+<div id="toast" role="status" aria-live="polite" hidden></div>
+
+<dialog id="help-dlg">
+  <h3>Keyboard shortcuts</h3>
+  <table>
+    <tr><td><kbd>Ctrl/Cmd</kbd>+<kbd>Alt</kbd>+<kbd>N</kbd></td><td>New note</td></tr>
+    <tr><td><kbd>/</kbd> or <kbd>Ctrl/Cmd</kbd>+<kbd>K</kbd></td><td>Search</td></tr>
+    <tr><td><kbd>↑</kbd> <kbd>↓</kbd> (in search or list)</td><td>Move between notes</td></tr>
+    <tr><td><kbd>Ctrl/Cmd</kbd>+<kbd>E</kbd></td><td>Cycle Edit / Split / Preview</td></tr>
+    <tr><td><kbd>Ctrl/Cmd</kbd>+<kbd>B</kbd> / <kbd>I</kbd></td><td>Bold / italic (in editor)</td></tr>
+    <tr><td><kbd>Ctrl/Cmd</kbd>+<kbd>K</kbd> (in editor)</td><td>Insert link</td></tr>
+    <tr><td><kbd>Tab</kbd> / <kbd>Shift</kbd>+<kbd>Tab</kbd></td><td>Indent / outdent lines</td></tr>
+    <tr><td><kbd>Enter</kbd> in a list</td><td>Continue the list</td></tr>
+    <tr><td><kbd>Esc</kbd></td><td>Clear search / close dialogs</td></tr>
+  </table>
+  <p class="muted">Search supports <code>#tag</code> terms. Markdown: headings, **bold**, *italic*, ~~strike~~, `code`, fenced code, lists, [ ] checklists (clickable in preview), quotes, tables, links, rules.</p>
+  <form method="dialog"><button class="primary">Close</button></form>
+</dialog>
+
+<dialog id="data-dlg">
+  <h3>Your data</h3>
+  <p class="muted">Notes are stored in this browser only (localStorage). Export a backup regularly.</p>
+  <div class="row">
+    <button id="export-json">Export all (JSON)</button>
+    <button id="export-md">Export all (Markdown, one file)</button>
+    <button id="import-btn">Import JSON…</button>
+    <input id="import-file" type="file" accept="application/json,.json" hidden>
+  </div>
+  <p id="data-info" class="muted"></p>
+  <form method="dialog"><button class="primary">Close</button></form>
+</dialog>
+
+<script src="app.js"></script>
+</body>
+</html>
