+}
+function defaultState() {
+  const b = {
+    id: uid(), name: 'My Board',
+    labels: [
+      { id: uid(), name: 'Work', color: COLORS[4] }, { id: uid(), name: 'Personal', color: COLORS[3] },
+      { id: uid(), name: 'Urgent', color: COLORS[0] }, { id: uid(), name: 'Idea', color: COLORS[5] },
