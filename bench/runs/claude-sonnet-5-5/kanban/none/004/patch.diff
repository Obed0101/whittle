+:root {
+  --bg: #f3f4f8; --surface: #ffffff; --col: #e8eaf1; --text: #1b1d2a; --muted: #6b7086;
+  --border: #d5d8e3; --accent: #4f46e5; --accent-text: #fff; --danger: #d92d3a;
+  --warn: #b7791f; --ok: #1f8a56; --shadow: 0 1px 2px rgba(20,22,40,.12);
+  --shadow-lg: 0 12px 40px rgba(20,22,40,.28);
+  color-scheme: light;
+}
+:root[data-theme="dark"] {
+  --bg: #14151c; --surface: #23252f; --col: #1b1c25; --text: #e8eaf2; --muted: #9195ab;
+  --border: #353847; --accent: #818cf8; --accent-text: #11121a; --danger: #ff6b76;
+  --warn: #f0b429; --ok: #4cc38a; --shadow: 0 1px 2px rgba(0,0,0,.5);
+  --shadow-lg: 0 12px 40px rgba(0,0,0,.6);
+  color-scheme: dark;
+}
+* { box-sizing: border-box; }
+html, body { height: 100%; margin: 0; }
+body {
+  display: flex; flex-direction: column; background: var(--bg); color: var(--text);
+  font: 14px/1.4 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+}
+button, input, select, textarea { font: inherit; color: inherit; }
+[hidden] { display: none !important; }
+
+/* top bar */
+.topbar {
+  display: flex; align-items: center; gap: 8px; padding: 10px 14px; flex-wrap: wrap;
+  background: var(--surface); border-bottom: 1px solid var(--border);
+}
+.brand { font-size: 22px; color: var(--accent); line-height: 1; }
+.spacer { flex: 1; }
+.topbar select, .topbar input[type=search] {
+  background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 6px 8px; max-width: 180px;
+}
+.topbar input[type=search] { width: 200px; }
+#boardSelect { font-weight: 600; max-width: 220px; }
+.btn {
+  background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 6px 10px; cursor: pointer;
+}
+.btn:hover:not(:disabled) { border-color: var(--accent); }
+.btn:disabled { opacity: .4; cursor: default; }
+.btn.icon { width: 34px; padding: 6px 0; text-align: center; }
+.btn.primary { background: var(--accent); color: var(--accent-text); border-color: var(--accent); font-weight: 600; }
+.btn.danger { color: var(--danger); }
+:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
+
+/* board */
+.board {
+  flex: 1; min-height: 0; display: flex; align-items: flex-start; gap: 12px; padding: 14px;
+  overflow-x: auto; overflow-y: hidden;
+}
+.column {
+  flex: 0 0 300px; max-height: 100%; display: flex; flex-direction: column;
+  background: var(--col); border-radius: 12px; border: 1px solid var(--border);
+}
+.column.dragging { opacity: .45; }
+.col-head { display: flex; align-items: center; gap: 8px; padding: 10px 10px 6px 12px; cursor: grab; }
+.col-title { flex: 1; margin: 0; font-size: 14px; font-weight: 700; cursor: pointer; overflow-wrap: anywhere; }
+.done-mark { color: var(--ok); font-weight: 700; }
+.count { font-size: 12px; color: var(--muted); background: var(--bg); border-radius: 10px; padding: 1px 8px; }
+.count.over { background: var(--danger); color: #fff; }
+.icon-btn { background: none; border: 0; cursor: pointer; border-radius: 6px; padding: 2px 8px; color: var(--muted); font-size: 16px; }
+.icon-btn:hover { background: var(--bg); color: var(--text); }
+.cards { flex: 1; min-height: 24px; overflow-y: auto; padding: 4px 8px; display: flex; flex-direction: column; gap: 8px; }
+.card {
+  background: var(--surface); border: 1px solid var(--border); border-radius: 9px; padding: 9px 10px;
+  box-shadow: var(--shadow); cursor: pointer; position: relative;
+}
+.card:hover { border-color: var(--accent); }
+.card.dragging { opacity: .35; }
+.card.done .card-title { text-decoration: line-through; color: var(--muted); }
+.card[data-prio="high"] { border-left: 4px solid var(--danger); }
+.card[data-prio="med"] { border-left: 4px solid #f5a524; }
+.card[data-prio="low"] { border-left: 4px solid #3b82f6; }
+.card-title { overflow-wrap: anywhere; white-space: pre-wrap; }
+.chips { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 6px; }
+.chip {
+  font-size: 11px; font-weight: 600; color: #fff; padding: 1px 8px; border-radius: 10px; border: 0;
+  text-shadow: 0 1px 1px rgba(0,0,0,.25);
+}
+.meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; font-size: 12px; color: var(--muted); }
+.badge { padding: 0 6px; border-radius: 6px; background: var(--bg); }
+.badge.overdue { background: var(--danger); color: #fff; }
+.badge.soon { background: var(--warn); color: #fff; }
+.badge.complete { background: var(--ok); color: #fff; }
+.drop-ph { height: 38px; border: 2px dashed var(--accent); border-radius: 9px; background: color-mix(in srgb, var(--accent) 12%, transparent); flex: none; }
+.col-ph { flex: 0 0 300px; align-self: stretch; border: 2px dashed var(--accent); border-radius: 12px; background: color-mix(in srgb, var(--accent) 10%, transparent); }
+.empty-hint { color: var(--muted); text-align: center; padding: 10px 0; font-size: 12px; }
+.add-card {
+  margin: 4px 8px 8px; text-align: left; background: none; border: 0; border-radius: 8px; padding: 7px 8px;
+  color: var(--muted); cursor: pointer;
+}
+.add-card:hover { background: var(--bg); color: var(--text); }
+.composer { padding: 4px 8px 8px; display: flex; flex-direction: column; gap: 6px; }
+.composer textarea, .field, .cm-title, .cm-desc, .cl-text {
+  width: 100%; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 7px 9px; resize: vertical;
+}
+.composer textarea { resize: none; }
+.composer-actions { display: flex; gap: 6px; align-items: center; }
+.add-col { flex: 0 0 300px; background: color-mix(in srgb, var(--col) 60%, transparent); border: 2px dashed var(--border);
+  border-radius: 12px; padding: 10px; color: var(--muted); cursor: pointer; text-align: left; }
+.add-col:hover { color: var(--text); border-color: var(--accent); }
+.add-col-form { flex: 0 0 300px; background: var(--col); border-radius: 12px; padding: 10px; display: flex; flex-direction: column; gap: 6px; border: 1px solid var(--border); }
+.no-match { color: var(--muted); padding: 40px; margin: auto; text-align: center; }
+
+/* menu */
+.menu {
+  position: fixed; z-index: 50; background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
+  box-shadow: var(--shadow-lg); padding: 4px; min-width: 190px; display: flex; flex-direction: column;
+}
+.menu hr { border: 0; border-top: 1px solid var(--border); margin: 4px 0; width: 100%; }
+.menu-item { background: none; border: 0; text-align: left; padding: 7px 10px; border-radius: 6px; cursor: pointer; }
+.menu-item:hover:not(:disabled), .menu-item:focus-visible { background: var(--bg); }
+.menu-item:disabled { opacity: .4; cursor: default; }
+.menu-item.danger { color: var(--danger); }
+
+/* dialogs */
+dialog {
+  border: 1px solid var(--border); border-radius: 14px; background: var(--surface); color: var(--text);
+  box-shadow: var(--shadow-lg); padding: 0; width: min(720px, 94vw); max-height: 92vh;
+}
+dialog.small { width: min(420px, 94vw); }
+dialog::backdrop { background: rgba(10,12,24,.5); }
+.dlg { padding: 18px; display: flex; flex-direction: column; gap: 12px; max-height: 92vh; overflow-y: auto; }
+.dlg h3 { margin: 0; font-size: 17px; }
+.dlg-actions { display: flex; gap: 8px; justify-content: flex-end; }
+.cm { display: grid; grid-template-columns: 1fr 220px; gap: 18px; }
+.cm-title { font-size: 18px; font-weight: 700; }
+.cm-desc { min-height: 110px; }
+.cm-side { display: flex; flex-direction: column; gap: 10px; }
+.cm-side label, .sect-label { font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); font-weight: 700; display: block; margin-bottom: 3px; }
+.cm-side .btn { text-align: left; width: 100%; }
+.chip-toggle { opacity: .4; cursor: pointer; }
+.chip-toggle.on { opacity: 1; outline: 2px solid var(--text); outline-offset: 1px; }
+.cl-row { display: flex; align-items: center; gap: 6px; margin-bottom: 5px; }
+.cl-row input[type=checkbox] { width: 16px; height: 16px; flex: none; }
+.cl-text { padding: 4px 8px; }
+.cl-row.done .cl-text { text-decoration: line-through; color: var(--muted); }
+.progress { height: 6px; border-radius: 4px; background: var(--bg); overflow: hidden; margin-bottom: 8px; }
+.progress > div { height: 100%; background: var(--ok); transition: width .15s; }
+.foot-note { font-size: 12px; color: var(--muted); }
+.lbl-row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
+.swatches { display: flex; gap: 4px; }
+.swatch { width: 20px; height: 20px; border-radius: 50%; border: 2px solid transparent; cursor: pointer; padding: 0; }
+.swatch.on { border-color: var(--text); }
+.arch-row { display: flex; gap: 8px; align-items: center; padding: 6px 0; border-bottom: 1px solid var(--border); }
+.arch-row .t { flex: 1; overflow-wrap: anywhere; }
+.arch-row small { color: var(--muted); display: block; }
+.kbd-list { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 0; }
+kbd { background: var(--bg); border: 1px solid var(--border); border-radius: 5px; padding: 1px 6px; font: 12px ui-monospace, monospace; }
+
+.toasts { position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; gap: 8px; z-index: 100; align-items: center; }
+.toast { background: #22242f; color: #fff; padding: 9px 14px; border-radius: 10px; box-shadow: var(--shadow-lg); display: flex; gap: 14px; align-items: center; }
+.toast button { background: none; border: 0; color: #a5b4fc; font-weight: 700; cursor: pointer; }
+
+@media (max-width: 700px) {
+  .column, .add-col, .add-col-form { flex-basis: 85vw; }
+  .board { scroll-snap-type: x proximity; }
+  .column { scroll-snap-align: start; }
+  .cm { grid-template-columns: 1fr; }
+  .topbar select, .topbar input[type=search] { max-width: none; flex: 1 1 120px; }
+}
+@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
