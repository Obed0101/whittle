+  return el;
+}
+
+function composerEl(col) {
+  if (adding !== col.id) return h('button', { class: 'add-card', onclick: () => { adding = col.id; addingCol = false; renderBoard(); } }, '+ Add card');
+  const close = () => { adding = null; renderBoard(); };
