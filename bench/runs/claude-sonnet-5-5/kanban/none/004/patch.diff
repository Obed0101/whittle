+document.addEventListener('pointerdown', (e) => { if (menuEl && !menuEl.contains(e.target)) closeMenu(); });
+
+function modal(content, { small = false, onclose } = {}) {
+  const d = h('dialog', { class: small ? 'small' : '' }, content);
+  document.body.append(d);
+  d.addEventListener('close', () => { d.remove(); if (onclose) onclose(); });
+  d.addEventListener('mousedown', (e) => { d._down = e.target === d; });
