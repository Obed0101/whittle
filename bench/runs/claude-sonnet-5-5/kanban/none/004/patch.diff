+function normalize(s) {
+  if (!s || !Array.isArray(s.boards) || !s.boards.length) throw new Error('No boards found in file');
+  const boards = s.boards.map((b) => {
+    b = b && typeof b === 'object' ? b : {};
+    const labels = (Array.isArray(b.labels) ? b.labels : []).map((l) => ({ id: str(l && l.id) || uid(), name: str(l && l.name), color: str(l && l.color) || COLORS[7] }));
