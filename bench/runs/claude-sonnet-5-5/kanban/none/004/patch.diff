+    else if (d < 0) { cls += ' overdue'; txt = 'Overdue · ' + txt; }
+    else if (d === 0) { cls += ' soon'; txt = 'Today'; }
+    else if (d === 1) { cls += ' soon'; txt = 'Tomorrow'; }
