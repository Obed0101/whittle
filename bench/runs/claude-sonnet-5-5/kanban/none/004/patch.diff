+
+/* ---------- rendering ---------- */
+function render() { renderTopbar(); renderBoard(); }
+
+function renderTopbar() {
+  const sel = $('#boardSelect');
+  sel.replaceChildren(...state.boards.map((b) => h('option', { value: b.id, selected: b.id === state.active }, b.name)));
+  const b = board();
+  if (filters.label && filters.label !== '__none' && !labelById(filters.label)) filters.label = '';
