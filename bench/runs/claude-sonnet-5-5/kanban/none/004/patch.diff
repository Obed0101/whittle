+}
+function normCard(c) {
+  c = c && typeof c === 'object' ? c : {};
+  return {
+    id: str(c.id) || uid(), title: str(c.title, 'Untitled') || 'Untitled', desc: str(c.desc),
+    labels: Array.isArray(c.labels) ? c.labels.filter((x) => typeof x === 'string') : [],
+    due: validDay(c.due) ? c.due : '', prio: PRIOS.some((p) => p[0] === c.prio) ? c.prio : 'none',
+    checklist: (Array.isArray(c.checklist) ? c.checklist : []).map((i) => ({ id: str(i && i.id) || uid(), text: str(i && i.text), done: !!(i && i.done) })),
