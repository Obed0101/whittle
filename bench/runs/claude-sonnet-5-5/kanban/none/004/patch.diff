+  lf.value = filters.label;
+  $('#dueFilter').value = filters.due;
+  $('#clearFilters').hidden = !filtering();
+  document.title = `${b.name} · Kanban`;
+}
+
+let scrollMemo = {};
+function renderBoard() {
+  const el = $('#board');
+  const prevX = el.scrollLeft;
+  scrollMemo = {};
+  el.querySelectorAll('.column').forEach((c) => { scrollMemo[c.dataset.id] = c.querySelector('.cards').scrollTop; });
+  const b = board();
+  const total = b.columns.reduce((n, c) => n + c.cards.filter((x) => matches(x, c)).length, 0);
+  el.replaceChildren(...b.columns.map(columnEl), addColumnEl());
+  if (filtering() && !total) el.insertBefore(h('div', { class: 'no-match' }, 'No cards match the current filters.'), el.querySelector('.add-col, .add-col-form'));
+  el.scrollLeft = prevX;
+  el.querySelectorAll('.column').forEach((c) => { if (scrollMemo[c.dataset.id]) c.querySelector('.cards').scrollTop = scrollMemo[c.dataset.id]; });
+  const ta = el.querySelector('.composer textarea') || el.querySelector('.add-col-form input');
+  const ae = document.activeElement;
+  if (ta && (!ae || ae === document.body || el.contains(ae)) && !document.querySelector('dialog[open]')) { ta.focus({ preventScroll: true }); ta.scrollIntoView({ block: 'nearest', inline: 'nearest' }); }
+}
+
+function columnEl(col) {
+  const visible = col.cards.filter((c) => matches(c, col));
+  const over = col.wip && col.cards.length > col.wip;
+  const countText = filtering() ? `${visible.length} of ${col.cards.length}` : col.wip ? `${col.cards.length}/${col.wip}` : String(col.cards.length);
+  const head = h('div', { class: 'col-head', draggable: true,
+    ondragstart: (e) => {
+      drag = { type: 'col', id: col.id };
