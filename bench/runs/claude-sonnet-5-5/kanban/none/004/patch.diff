+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Kanban</title>
+<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%234f46e5'/%3E%3Crect x='6' y='7' width='6' height='18' rx='2' fill='%23fff'/%3E%3Crect x='14' y='7' width='6' height='11' rx='2' fill='%23fff' opacity='.85'/%3E%3Crect x='22' y='7' width='4' height='14' rx='2' fill='%23fff' opacity='.7'/%3E%3C/svg%3E">
+<link rel="stylesheet" href="styles.css">
+</head>
+<body>
+<header class="topbar">
+  <div class="brand" aria-hidden="true">▦</div>
+  <select id="boardSelect" aria-label="Board"></select>
+  <button id="boardMenuBtn" class="btn" title="Board options">Board ▾</button>
+  <div class="spacer"></div>
+  <input id="search" type="search" placeholder="Search cards  ( / )" aria-label="Search cards">
+  <select id="labelFilter" aria-label="Filter by label"></select>
+  <select id="dueFilter" aria-label="Filter by due date">
+    <option value="">Any due date</option>
+    <option value="overdue">Overdue</option>
+    <option value="week">Due in 7 days</option>
+    <option value="none">No due date</option>
+  </select>
+  <button id="clearFilters" class="btn" hidden>Clear filters</button>
+  <button id="undoBtn" class="btn icon" title="Undo (Ctrl/⌘+Z)" aria-label="Undo">↶</button>
+  <button id="redoBtn" class="btn icon" title="Redo (Ctrl/⌘+Shift+Z)" aria-label="Redo">↷</button>
+  <button id="themeBtn" class="btn icon" title="Toggle theme" aria-label="Toggle theme">◐</button>
+  <button id="helpBtn" class="btn icon" title="Keyboard shortcuts (?)" aria-label="Help">?</button>
+</header>
+<main id="board" class="board" aria-label="Kanban board"></main>
+<div id="toasts" class="toasts" aria-live="polite"></div>
+<input type="file" id="importFile" accept="application/json,.json" hidden>
+<noscript><p style="padding:2rem">This app needs JavaScript enabled.</p></noscript>
+<script src="app.js"></script>
+</body>
+</html>
