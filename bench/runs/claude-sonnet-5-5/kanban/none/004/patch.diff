+    });
+    return { id: str(b.id) || uid(), name: str(b.name, 'Board') || 'Board', labels, columns, archive: (Array.isArray(b.archive) ? b.archive : []).map(normCard) };
+  });
+  return { boards, active: boards.some((b) => b.id === s.active) ? s.active : boards[0].id };
+}
+function load() {
+  try {
+    const raw = localStorage.getItem(KEY);
+    if (raw) return normalize(JSON.parse(raw));
+  } catch (e) { console.error('Could not load saved data', e); }
+  return defaultState();
+}
+
+let state = load();
+let filters = { q: '', label: '', due: '' };
+let adding = null;      // column id with open composer
+let addingCol = false;  // "add column" form open
+const undoStack = [];
+const redoStack = [];
+
+const board = () => state.boards.find((b) => b.id === state.active) || state.boards[0];
+const snapshot = () => JSON.stringify({ boards: state.boards, active: state.active });
+function snap() {
+  const s = snapshot();
+  if (undoStack[undoStack.length - 1] !== s) { undoStack.push(s); if (undoStack.length > 60) undoStack.shift(); }
+  redoStack.length = 0;
+}
+function restore(s) { state = normalize(JSON.parse(s)); }
+function undo() {
+  const cur = snapshot();
+  while (undoStack.length && undoStack[undoStack.length - 1] === cur) undoStack.pop();
+  if (!undoStack.length) return toast('Nothing to undo');
+  redoStack.push(cur); restore(undoStack.pop()); save(); render(); toast('Undone');
+}
+function redo() {
+  if (!redoStack.length) return toast('Nothing to redo');
+  undoStack.push(snapshot()); restore(redoStack.pop()); save(); render(); toast('Redone');
+}
+let saveWarned = false;
+function save() {
+  try { localStorage.setItem(KEY, snapshot()); saveWarned = false; }
+  catch (e) { if (!saveWarned) { saveWarned = true; toast('⚠ Could not save to browser storage. Export a backup!'); } }
+}
+/** Run a mutation with undo support, then persist and re-render. */
+function act(fn) { snap(); fn(); save(); render(); }
+function touch(card) { card.updated = Date.now(); save(); renderBoard(); }
+
+function findCard(id) {
+  for (const col of board().columns) {
+    const i = col.cards.findIndex((c) => c.id === id);
+    if (i >= 0) return { col, i, card: col.cards[i] };
+  }
+  return null;
+}
+function moveCard(id, toColId, beforeId) {
+  const loc = findCard(id);
+  const to = board().columns.find((c) => c.id === toColId);
+  if (!loc || !to) return;
+  loc.col.cards.splice(loc.i, 1);
+  let idx = beforeId ? to.cards.findIndex((c) => c.id === beforeId) : -1;
+  if (idx < 0) idx = to.cards.length;
+  to.cards.splice(idx, 0, loc.card);
+  if (to.done && !loc.card.doneAt) loc.card.doneAt = Date.now();
+  if (!to.done) delete loc.card.doneAt;
+  if (loc.col !== to) {
+    loc.card.updated = Date.now();
+    if (to.wip && to.cards.length > to.wip) toast(`“${to.title}” is over its limit (${to.cards.length}/${to.wip})`);
+  }
+}
+const labelById = (id) => board().labels.find((l) => l.id === id);
+
+/* ---------- filtering ---------- */
+const filtering = () => !!(filters.q || filters.label || filters.due);
+function matches(card, col) {
+  if (filters.q) {
+    const q = filters.q.toLowerCase();
+    const hay = [card.title, card.desc, ...card.checklist.map((i) => i.text), ...card.labels.map((l) => (labelById(l) || {}).name || '')].join('\n').toLowerCase();
+    if (!hay.includes(q)) return false;
+  }
+  if (filters.label === '__none') { if (card.labels.length) return false; }
+  else if (filters.label && !card.labels.includes(filters.label)) return false;
+  if (filters.due === 'none') { if (card.due) return false; }
+  else if (filters.due === 'overdue') { if (!card.due || col.done || dayDiff(card.due) >= 0) return false; }
+  else if (filters.due === 'week') { if (!card.due || col.done) return false; const d = dayDiff(card.due); if (d < 0 || d > 7) return false; }
+  return true;
+}
