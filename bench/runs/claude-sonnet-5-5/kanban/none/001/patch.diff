+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Kanban</title>
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<header class="topbar">
+  <div class="brand">▦ Kanban</div>
+  <select id="boardSelect" aria-label="Board"></select>
+  <button id="boardMenuBtn" class="btn ghost" title="Board actions" aria-label="Board actions">⋯</button>
+  <div class="spacer"></div>
+  <input id="search" type="search" placeholder="Search cards  ( / )" aria-label="Search cards">
+  <select id="labelFilter" aria-label="Filter by label"></select>
+  <button id="undoBtn" class="btn ghost" title="Undo (Ctrl/Cmd+Z)">↶</button>
+  <button id="redoBtn" class="btn ghost" title="Redo (Ctrl/Cmd+Shift+Z)">↷</button>
+  <button id="themeBtn" class="btn ghost" title="Toggle theme"></button>
+  <button id="menuBtn" class="btn ghost" title="Menu" aria-label="Menu">☰</button>
+</header>
+<main id="board" class="board" aria-label="Board"></main>
+<div id="toasts" aria-live="polite"></div>
+<input id="importFile" type="file" accept="application/json,.json" hidden>
+<noscript>This app needs JavaScript.</noscript>
+<script src="app.js"></script>
+</body>
+</html>
diff --git a/board/style.css b/board/style.css
new file mode 100644
index 0000000..d6c9849
--- /dev/null
+++ b/board/style.css
@@ -0,0 +1,115 @@
+:root{
+  --bg:#f3f4f7;--panel:#e8eaef;--card:#fff;--text:#1c2030;--muted:#6b7183;--border:#d5d8e0;
+  --accent:#3b6df0;--accent-text:#fff;--danger:#d93c3c;--warn:#c27803;--ok:#238b57;
+  --shadow:0 1px 2px rgba(20,25,45,.12);--shadow-lg:0 12px 40px rgba(20,25,45,.28);
+  color-scheme:light;
+}
+:root[data-theme=dark]{
+  --bg:#14161d;--panel:#1d202a;--card:#272b38;--text:#e6e8ef;--muted:#9097aa;--border:#363b4b;
+  --accent:#6b93ff;--accent-text:#0b1020;--danger:#ff6b6b;--warn:#f0b34a;--ok:#4cc38a;
+  --shadow:0 1px 2px rgba(0,0,0,.4);--shadow-lg:0 12px 40px rgba(0,0,0,.6);
+  color-scheme:dark;
+}
+@media (prefers-color-scheme:dark){
+  :root[data-theme=auto]{
+    --bg:#14161d;--panel:#1d202a;--card:#272b38;--text:#e6e8ef;--muted:#9097aa;--border:#363b4b;
+    --accent:#6b93ff;--accent-text:#0b1020;--danger:#ff6b6b;--warn:#f0b34a;--ok:#4cc38a;
+    --shadow:0 1px 2px rgba(0,0,0,.4);--shadow-lg:0 12px 40px rgba(0,0,0,.6);
+    color-scheme:dark;
+  }
+}
+*{box-sizing:border-box}
+html,body{height:100%;margin:0}
+body{display:flex;flex-direction:column;background:var(--bg);color:var(--text);
+  font:14px/1.4 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
+button,input,select,textarea{font:inherit;color:inherit}
+.topbar{display:flex;align-items:center;gap:8px;padding:8px 12px;border-bottom:1px solid var(--border);background:var(--panel);flex-wrap:wrap}
+.brand{font-weight:700;margin-right:6px}
+.spacer{flex:1}
+select,input[type=search],input[type=text],input[type=date],textarea,.dlg input,.dlg select{
+  background:var(--card);border:1px solid var(--border);border-radius:6px;padding:6px 8px;min-width:0}
+textarea{resize:vertical;width:100%}
+#search{width:200px}
+:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
+.btn{border:1px solid var(--border);background:var(--card);border-radius:6px;padding:6px 12px;cursor:pointer}
+.btn:hover{border-color:var(--accent)}
+.btn:disabled{opacity:.4;cursor:default;border-color:var(--border)}
+.btn.primary{background:var(--accent);color:var(--accent-text);border-color:var(--accent);font-weight:600}
+.btn.danger{color:var(--danger)}
+.btn.ghost{background:transparent;border-color:transparent;padding:6px 9px}
+.btn.ghost:hover:not(:disabled){background:var(--card);border-color:var(--border)}
+
+.board{flex:1;display:flex;gap:12px;padding:12px;overflow:auto;align-items:flex-start}
+.column{flex:0 0 288px;max-height:100%;display:flex;flex-direction:column;background:var(--panel);
+  border:1px solid var(--border);border-radius:10px}
+.column.dragging{opacity:.4}
+.col-head{display:flex;align-items:center;gap:6px;padding:8px 8px 6px 12px;cursor:grab}
+.col-head h2{margin:0;font-size:13px;text-transform:uppercase;letter-spacing:.04em;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.col-head .done-mark{color:var(--ok)}
+.count{font-size:12px;color:var(--muted);background:var(--card);border-radius:10px;padding:1px 8px}
+.count.over{background:var(--danger);color:#fff}
+.col-body{overflow-y:auto;padding:2px 8px 4px;display:flex;flex-direction:column;gap:8px;min-height:24px;flex:1}
+.col-foot{padding:6px 8px 8px}
+.add-btn{width:100%;text-align:left;color:var(--muted);background:transparent;border:0;padding:6px 4px;border-radius:6px;cursor:pointer}
+.add-btn:hover{background:var(--card);color:var(--text)}
+.composer textarea{min-height:56px}
+.composer .row{display:flex;gap:6px;margin-top:6px}
+.add-col{flex:0 0 220px;background:transparent;border:2px dashed var(--border);color:var(--muted);border-radius:10px;padding:12px;cursor:pointer}
+.add-col:hover{color:var(--text);border-color:var(--accent)}
+
+.card{background:var(--card);border-radius:8px;padding:8px 10px;box-shadow:var(--shadow);cursor:pointer;
+  border-left:4px solid transparent;word-break:break-word}
+.card:hover{outline:1px solid var(--accent)}
+.card.dragging{opacity:.35}
+.card.p-low{border-left-color:#30a46c}.card.p-medium{border-left-color:#f5b800}.card.p-high{border-left-color:#e5484d}
+.card.done .ctitle{text-decoration:line-through;color:var(--muted)}
+.ctitle{white-space:pre-wrap}
+.chips{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:5px}
+.chip{font-size:11px;font-weight:600;color:#fff;border-radius:4px;padding:0 6px;line-height:18px;text-shadow:0 0 2px rgba(0,0,0,.35)}
+.meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px;font-size:12px;color:var(--muted)}
+.meta .overdue{color:var(--danger);font-weight:600}.meta .soon{color:var(--warn);font-weight:600}.meta .ok{color:var(--ok)}
+.drop-line{height:3px;border-radius:2px;background:var(--accent);flex:none}
+.col-drop{flex:0 0 4px;align-self:stretch;background:var(--accent);border-radius:2px}
+.empty-hint{color:var(--muted);font-size:12px;text-align:center;padding:8px}
+
+dialog.dlg{border:1px solid var(--border);border-radius:12px;background:var(--bg);color:var(--text);padding:0;
+  width:min(560px,94vw);max-height:92vh;box-shadow:var(--shadow-lg)}
+dialog.dlg::backdrop{background:rgba(10,12,20,.5)}
+.dlg form,.dlg .wrap{display:flex;flex-direction:column;gap:12px;padding:16px;max-height:92vh;overflow:auto}
+.dlg h3{margin:0;font-size:16px}
+.dlg label.f{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--muted)}
+.dlg label.f>input,.dlg label.f>select,.dlg label.f>textarea{font-size:14px;color:var(--text)}
+.dlg .title-in{font-size:17px;font-weight:600}
+.dlg .grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}
+@media(max-width:520px){.dlg .grid{grid-template-columns:1fr}}
+.dlg .actions{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap}
+.dlg .actions .left{margin-right:auto;display:flex;gap:8px}
+.lbl-pick{display:flex;flex-wrap:wrap;gap:6px}
+.lbl-pick button{border:2px solid transparent;opacity:.45;cursor:pointer}
+.lbl-pick button[aria-pressed=true]{opacity:1;border-color:var(--text)}
+.cl-item{display:flex;gap:6px;align-items:center;margin-bottom:4px}
+.cl-item input[type=text]{flex:1}
+.cl-item.done input[type=text]{text-decoration:line-through;color:var(--muted)}
+.progress{height:6px;background:var(--panel);border-radius:3px;overflow:hidden}
+.progress>div{height:100%;background:var(--ok)}
+.small{font-size:12px;color:var(--muted)}
+.row-between{display:flex;justify-content:space-between;align-items:center;gap:8px}
+.swatches{display:flex;gap:3px}
+.swatch{width:18px;height:18px;border-radius:50%;border:2px solid transparent;cursor:pointer;padding:0}
+.swatch[aria-pressed=true]{border-color:var(--text)}
+.lbl-row{display:flex;gap:8px;align-items:center}
+.lbl-row input{flex:1}
+.arch-item{display:flex;gap:8px;align-items:center;padding:6px 0;border-bottom:1px solid var(--border)}
+.arch-item .t{flex:1;overflow:hidden;text-overflow:ellipsis}
+kbd{background:var(--card);border:1px solid var(--border);border-radius:4px;padding:0 5px;font-size:12px}
+table.keys td{padding:3px 12px 3px 0}
+
+.menu{position:fixed;z-index:50;min-width:190px;background:var(--card);border:1px solid var(--border);border-radius:8px;
+  box-shadow:var(--shadow-lg);padding:4px}
+.menu button{display:block;width:100%;text-align:left;background:none;border:0;padding:7px 10px;border-radius:5px;cursor:pointer}
+.menu button:hover,.menu button:focus-visible{background:var(--panel)}
+.menu button.danger{color:var(--danger)}
+.menu hr{border:0;border-top:1px solid var(--border);margin:4px 0}
+#toasts{position:fixed;bottom:16px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;gap:8px;z-index:100;align-items:center}
+.toast{background:var(--text);color:var(--bg);border-radius:8px;padding:8px 14px;box-shadow:var(--shadow-lg);display:flex;gap:12px;align-items:center}
+.toast button{background:none;border:0;color:inherit;font-weight:700;text-decoration:underline;cursor:pointer}
