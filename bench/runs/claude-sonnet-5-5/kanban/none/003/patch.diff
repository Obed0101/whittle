+  mutate(() => b.columns.sort((x, y) => order.indexOf(x.id) - order.indexOf(y.id)));
+});
+
+// ---------- card dialog ----------
+let cur = null; // {colId, id, work}
+function openCard(colId, id) {
+  const b = board();
+  const col = b.columns.find(c => c.id === colId);
+  const existing = id ? col.cards.find(c => c.id === id) : null;
+  const work = existing ? JSON.parse(JSON.stringify(existing)) : normCard({ title: '' });
+  work.title = existing ? work.title : '';
+  cur = { colId, id, work };
+  $('cardDlgTitle').textContent = existing ? 'Edit card' : 'New card';
+  $('cTitle').value = work.title; $('cDesc').value = work.desc; $('cPri').value = work.priority; $('cDue').value = work.due;
+  $('cCol').replaceChildren(...b.columns.map(c => h('option', { value: c.id, text: c.title, selected: c.id === colId })));
+  $('cDelete').hidden = $('cArchive').hidden = !existing;
+  $('cMeta').textContent = existing ? `Created ${new Date(work.created).toLocaleString()} · Updated ${new Date(work.updated).toLocaleString()}` : '';
+  drawChips(); drawChecklist(); $('cNewItem').value = '';
+  $('cardDlg').showModal(); $('cTitle').focus();
+}
+function drawChips() {
+  const b = board();
+  $('cLabels').replaceChildren(...(b.labels.length ? b.labels.map(l => h('button', { type: 'button', class: 'chip' + (cur.work.labels.includes(l.id) ? ' on' : ''), style: `background:${l.color}`, text: l.name,
+    onclick: () => { const a = cur.work.labels; const i = a.indexOf(l.id); i >= 0 ? a.splice(i, 1) : a.push(l.id); drawChips(); } }))
+    : [h('span', { class: 'muted', text: 'No labels yet — create some in Menu → Manage labels.' })]));
