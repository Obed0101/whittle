+$('archiveClear').onclick = () => { if (confirm('Permanently delete all archived cards on this board?')) { mutate(() => { board().archive = []; }); drawArchive(); } };
+$('archiveClose').onclick = () => $('archiveDlg').close();
+$('helpClose').onclick = () => $('helpDlg').close();
+
+// ---------- menu actions ----------
+function download(name, text) {
+  const a = h('a', { href: URL.createObjectURL(new Blob([text], { type: 'application/json' })), download: name });
+  document.body.append(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
+}
+const actions = {
+  newBoard() { const n = prompt('Board name?', 'New board'); if (n && n.trim()) mutate(() => { const b = newBoard(n.trim()); S.boards.push(b); S.active = b.id; }); },
+  renameBoard() { const n = prompt('Rename board', board().name); if (n && n.trim()) mutate(() => { board().name = n.trim(); }); },
+  deleteBoard() {
+    const b = board(); if (!confirm(`Delete board "${b.name}" and everything in it? This can be undone with Undo until you reload.`)) return;
+    mutate(() => { S.boards = S.boards.filter(x => x !== b); if (!S.boards.length) S.boards.push(newBoard()); S.active = S.boards[0].id; }, 'Board deleted');
+  },
+  labels() { drawLabels(); $('labelsDlg').showModal(); },
+  archive() { drawArchive(); $('archiveDlg').showModal(); },
+  export() { download(`kanban-${today()}.json`, JSON.stringify({ app: 'kanban', version: 1, boards: S.boards, active: S.active, theme: S.theme }, null, 2)); },
+  import() { $('importFile').click(); },
+  theme() { S.theme = S.theme === 'dark' ? 'light' : 'dark'; save(); render(); },
+  help() { $('helpDlg').showModal(); },
+};
+$('menu').addEventListener('click', e => {
+  const act = e.target.dataset && e.target.dataset.act; if (!act) return;
+  $('menu').open = false; actions[act]();
+});
+document.addEventListener('click', e => { if (!$('menu').contains(e.target)) $('menu').open = false; });
+$('importFile').addEventListener('change', async e => {
+  const f = e.target.files[0]; e.target.value = ''; if (!f) return;
+  try {
+    const d = normalize(JSON.parse(await f.text()));
+    if (!confirm(`Import ${d.boards.length} board(s)? This replaces all current data (you can Undo).`)) return;
+    mutate(() => { S.boards = d.boards; S.active = d.active; S.theme = d.theme; }, 'Imported');
+  } catch (err) { alert('Import failed: ' + err.message); }
+});
+
+// ---------- header wiring ----------
+$('boardSel').onchange = e => { S.active = e.target.value; save(); render(); };
+$('search').oninput = e => { F.q = e.target.value.trim(); render(); };
+$('labelFilter').onchange = e => { F.label = e.target.value; render(); };
+$('dueFilter').onchange = e => { F.due = e.target.value; render(); };
+$('clearFilters').onclick = () => { F.q = F.label = F.due = ''; $('search').value = ''; $('dueFilter').value = ''; render(); };
+$('undoBtn').onclick = undo; $('redoBtn').onclick = redo;
+
+document.addEventListener('keydown', e => {
+  const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName);
+  const modalOpen = document.querySelector('dialog[open]');
+  if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z' && !typing && !modalOpen) { e.preventDefault(); e.shiftKey ? redo() : undo(); return; }
+  if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'y' && !typing && !modalOpen) { e.preventDefault(); redo(); return; }
+  if (typing || modalOpen || e.ctrlKey || e.metaKey || e.altKey) return;
+  if (e.key === '/') { e.preventDefault(); $('search').focus(); }
+  else if (e.key.toLowerCase() === 'n') { const c = board().columns[0]; if (c) { e.preventDefault(); openCard(c.id, null); } else editColumn(null); }
+});
+$('search').addEventListener('keydown', e => { if (e.key === 'Escape') { e.target.value = ''; F.q = ''; e.target.blur(); render(); } });
+// close dialogs on backdrop click
+document.querySelectorAll('dialog').forEach(d => d.addEventListener('mousedown', e => { if (e.target === d) d.close(); }));
+// keep tabs in sync
+addEventListener('storage', e => {
+  if (e.key !== KEY || document.querySelector('dialog[open]')) return;
+  try { S = normalize(JSON.parse(e.newValue)); undoS = []; redoS = []; render(); } catch {}
+});
+// refresh due-date styling after midnight / when returning to tab
+document.addEventListener('visibilitychange', () => { if (!document.hidden && !document.querySelector('dialog[open]')) render(); });
+
+S = load();
+save();
+render();
+})();
diff --git a/board/index.html b/board/index.html
new file mode 100644
index 0000000..c50aa99
--- /dev/null
+++ b/board/index.html
@@ -0,0 +1,123 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Kanban</title>
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<header class="top">
+  <select id="boardSel" aria-label="Board"></select>
+  <input id="search" type="search" placeholder="Search cards ( / )" aria-label="Search cards">
+  <select id="labelFilter" aria-label="Filter by label"></select>
+  <select id="dueFilter" aria-label="Filter by due date">
+    <option value="">Any due date</option>
+    <option value="overdue">Overdue</option>
+    <option value="today">Due today</option>
+    <option value="week">Due in 7 days</option>
+    <option value="none">No due date</option>
+  </select>
+  <button id="clearFilters" class="ghost" hidden>Clear filters</button>
+  <span class="spacer"></span>
+  <button id="undoBtn" class="ghost" title="Undo (Ctrl/Cmd+Z)">↶ Undo</button>
+  <button id="redoBtn" class="ghost" title="Redo (Ctrl/Cmd+Shift+Z)">↷ Redo</button>
+  <details class="menu" id="menu">
+    <summary class="btn ghost" aria-label="Menu">☰ Menu</summary>
+    <div class="menu-pop">
+      <button data-act="newBoard">New board</button>
+      <button data-act="renameBoard">Rename board</button>
+      <button data-act="deleteBoard">Delete board</button>
+      <button data-act="labels">Manage labels</button>
+      <button data-act="archive">Archive</button>
+      <hr>
+      <button data-act="export">Export JSON</button>
+      <button data-act="import">Import JSON…</button>
+      <button data-act="theme">Toggle dark mode</button>
+      <button data-act="help">Keyboard shortcuts</button>
+    </div>
+  </details>
+  <input id="importFile" type="file" accept="application/json,.json" hidden>
+</header>
+<div id="warn" class="warn" hidden></div>
+<main id="board" aria-label="Board columns"></main>
+<div id="toast" class="toast" hidden></div>
+
+<dialog id="cardDlg">
+  <form method="dialog" id="cardForm">
+    <h2 id="cardDlgTitle">Card</h2>
+    <label>Title <input id="cTitle" required maxlength="200"></label>
+    <label>Description <textarea id="cDesc" rows="4"></textarea></label>
+    <div class="row">
+      <label>Column <select id="cCol"></select></label>
+      <label>Priority <select id="cPri">
+        <option value="none">None</option><option value="low">Low</option>
+        <option value="med">Medium</option><option value="high">High</option></select></label>
+      <label>Due <input id="cDue" type="date"></label>
+    </div>
+    <fieldset><legend>Labels</legend><div id="cLabels" class="chips"></div></fieldset>
+    <fieldset><legend>Checklist</legend>
+      <div id="cList"></div>
+      <div class="row"><input id="cNewItem" placeholder="Add item and press Enter"></div>
+    </fieldset>
+    <p id="cMeta" class="muted"></p>
+    <div class="actions">
+      <button type="button" id="cDelete" class="danger">Delete</button>
+      <button type="button" id="cArchive">Archive</button>
+      <span class="spacer"></span>
+      <button type="button" id="cCancel">Cancel</button>
+      <button type="submit" class="primary" id="cSave">Save</button>
+    </div>
+  </form>
+</dialog>
+
+<dialog id="colDlg">
+  <form method="dialog" id="colForm">
+    <h2>Column</h2>
+    <label>Title <input id="colTitle" required maxlength="60"></label>
+    <label>WIP limit (0 = none) <input id="colWip" type="number" min="0" max="99" value="0"></label>
+    <label class="check"><input id="colDone" type="checkbox"> Cards here count as done (no overdue warnings)</label>
+    <div class="actions">
+      <button type="button" id="colDelete" class="danger">Delete column</button>
+      <span class="spacer"></span>
+      <button type="button" id="colCancel">Cancel</button>
+      <button type="submit" class="primary">Save</button>
+    </div>
+  </form>
+</dialog>
+
+<dialog id="labelsDlg">
+  <h2>Labels</h2>
+  <div id="labelList"></div>
+  <form id="labelForm" class="row">
+    <input id="lName" placeholder="New label name" required maxlength="30">
+    <input id="lColor" type="color" value="#4f8cff" aria-label="Color">
+    <button class="primary">Add</button>
+  </form>
+  <div class="actions"><span class="spacer"></span><button id="labelsClose">Close</button></div>
+</dialog>
+
+<dialog id="archiveDlg">
+  <h2>Archive</h2>
+  <div id="archiveList"></div>
+  <div class="actions"><button id="archiveClear" class="danger">Empty archive</button><span class="spacer"></span><button id="archiveClose">Close</button></div>
+</dialog>
+
+<dialog id="helpDlg">
+  <h2>Keyboard shortcuts</h2>
+  <table class="keys">
+    <tr><td><kbd>N</kbd></td><td>New card in the first column</td></tr>
+    <tr><td><kbd>/</kbd></td><td>Focus search</td></tr>
+    <tr><td><kbd>Ctrl/Cmd</kbd>+<kbd>Z</kbd></td><td>Undo</td></tr>
+    <tr><td><kbd>Ctrl/Cmd</kbd>+<kbd>Shift</kbd>+<kbd>Z</kbd></td><td>Redo</td></tr>
+    <tr><td><kbd>Enter</kbd></td><td>Open focused card</td></tr>
+    <tr><td><kbd>Alt</kbd>+<kbd>←/→</kbd></td><td>Move focused card to adjacent column</td></tr>
+    <tr><td><kbd>Alt</kbd>+<kbd>↑/↓</kbd></td><td>Reorder focused card</td></tr>
+    <tr><td><kbd>Esc</kbd></td><td>Close dialog</td></tr>
+  </table>
+  <p class="muted">Data is saved automatically in this browser (localStorage). Use Export to back it up.</p>
+  <div class="actions"><span class="spacer"></span><button id="helpClose">Close</button></div>
+</dialog>
+<script src="app.js"></script>
+</body>
+</html>
diff --git a/board/style.css b/board/style.css
new file mode 100644
index 0000000..8804932
--- /dev/null
+++ b/board/style.css
@@ -0,0 +1,76 @@
+:root{--bg:#f1f2f6;--panel:#e4e6ee;--card:#fff;--text:#1d2130;--muted:#6b7285;--line:#d3d6e0;--accent:#3b6ef5;--danger:#d93a3a;--warn:#e08a00;--ok:#1f9d55;--shadow:0 1px 2px rgba(0,0,0,.12)}
+:root.dark{--bg:#14161d;--panel:#1d2029;--card:#272b37;--text:#e8eaf2;--muted:#9097ab;--line:#363b4b;--accent:#6b93ff;--danger:#ff6b6b;--warn:#f0a83a;--ok:#4cc27f;--shadow:0 1px 2px rgba(0,0,0,.5)}
+*{box-sizing:border-box}
+html,body{height:100%;margin:0}
+body{display:flex;flex-direction:column;background:var(--bg);color:var(--text);font:14px/1.4 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
+button,input,select,textarea{font:inherit;color:inherit}
+input,select,textarea{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:6px 8px;width:100%}
+.top input,.top select{width:auto}
+button,.btn{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:6px 10px;cursor:pointer}
+button:hover,.btn:hover{border-color:var(--accent)}
+button.primary{background:var(--accent);border-color:var(--accent);color:#fff}
+button.danger{color:var(--danger)}
+button.ghost,.btn.ghost{background:transparent}
+button:disabled{opacity:.4;cursor:default}
+:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
+.top{display:flex;gap:8px;align-items:center;padding:10px 14px;background:var(--card);border-bottom:1px solid var(--line);flex-wrap:wrap}
+.spacer{flex:1}
+.menu{position:relative}
+.menu summary{list-style:none}.menu summary::-webkit-details-marker{display:none}
+.menu-pop{position:absolute;right:0;top:110%;z-index:20;background:var(--card);border:1px solid var(--line);border-radius:8px;padding:6px;display:flex;flex-direction:column;min-width:190px;box-shadow:0 6px 24px rgba(0,0,0,.25)}
+.menu-pop button{border:0;text-align:left;background:none}
+.menu-pop button:hover{background:var(--panel)}
+.menu-pop hr{width:100%;border:0;border-top:1px solid var(--line);margin:4px 0}
+.warn{background:var(--warn);color:#000;padding:6px 14px}
+#board{flex:1;display:flex;gap:12px;padding:14px;overflow-x:auto;align-items:flex-start}
+.col{flex:0 0 288px;max-height:100%;display:flex;flex-direction:column;background:var(--panel);border-radius:10px;border:2px solid transparent}
+.col.dragover{border-color:var(--accent)}
+.col.coldrag{opacity:.5}
+.col-head{display:flex;align-items:center;gap:6px;padding:10px 10px 6px}
+.col-head h3{margin:0;font-size:14px;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;cursor:grab}
+.count{font-size:12px;color:var(--muted);background:var(--card);border-radius:10px;padding:0 8px}
+.count.over{background:var(--danger);color:#fff}
+.icon{padding:2px 7px;border:0;background:none;color:var(--muted)}
+.cards{flex:1;overflow-y:auto;padding:4px 8px;min-height:36px;display:flex;flex-direction:column;gap:8px}
+.card{background:var(--card);border-radius:8px;padding:8px 10px;box-shadow:var(--shadow);cursor:grab;border-left:4px solid transparent;word-break:break-word}
+.card:hover{outline:1px solid var(--accent)}
+.card.dragging{opacity:.4}
+.card.p-low{border-left-color:#4caf7d}.card.p-med{border-left-color:var(--warn)}.card.p-high{border-left-color:var(--danger)}
+.card.done .ct{text-decoration:line-through;color:var(--muted)}
+.drop-ph{height:34px;border:2px dashed var(--accent);border-radius:8px;opacity:.6;flex:none}
+.tags{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:4px}
+.tag{font-size:11px;color:#fff;border-radius:4px;padding:0 6px;text-shadow:0 0 2px rgba(0,0,0,.5)}
+.badges{display:flex;gap:8px;margin-top:6px;font-size:12px;color:var(--muted);flex-wrap:wrap}
+.badge.overdue{color:var(--danger);font-weight:600}.badge.soon{color:var(--warn);font-weight:600}.badge.full{color:var(--ok)}
+.add{margin:6px 8px 8px;border:0;background:none;color:var(--muted);text-align:left}
+.add:hover{background:var(--card)}
+.addcol{flex:0 0 288px;background:transparent;border:2px dashed var(--line);color:var(--muted);padding:12px}
+.empty{color:var(--muted);text-align:center;margin:auto;padding:40px}
+dialog{border:1px solid var(--line);border-radius:12px;background:var(--card);color:var(--text);width:min(560px,94vw);padding:18px;max-height:92vh}
+dialog::backdrop{background:rgba(0,0,0,.45)}
+dialog h2{margin:0 0 10px}
+dialog label{display:block;margin:8px 0;font-size:12px;color:var(--muted)}
+dialog label.check{display:flex;gap:8px;align-items:center;font-size:13px;color:var(--text)}
+dialog label.check input{width:auto}
+fieldset{border:1px solid var(--line);border-radius:8px;margin:10px 0}
+legend{font-size:12px;color:var(--muted)}
+.row{display:flex;gap:10px;align-items:flex-end}.row>*{flex:1}
+.row input[type=color]{flex:0 0 44px;padding:2px;height:34px}
+.actions{display:flex;gap:8px;margin-top:14px;align-items:center}
+.chips{display:flex;flex-wrap:wrap;gap:6px}
+.chip{border:2px solid transparent;border-radius:14px;padding:1px 10px;color:#fff;opacity:.45;cursor:pointer;font-size:12px}
+.chip.on{opacity:1;border-color:var(--text)}
+.ci{display:flex;gap:6px;align-items:center;margin:3px 0}
+.ci input[type=checkbox]{width:auto}
+.ci input[type=text]{flex:1}
+.ci.done input[type=text]{text-decoration:line-through;color:var(--muted)}
+.muted{color:var(--muted);font-size:12px}
+.li{display:flex;gap:8px;align-items:center;margin:6px 0}.li>input[type=text]{flex:1}
+.li input[type=color]{width:40px;padding:1px}
+.ai{padding:6px 0;border-bottom:1px solid var(--line);display:flex;gap:8px;align-items:center}.ai span{flex:1}
+.keys td{padding:3px 10px 3px 0}
+kbd{background:var(--panel);border:1px solid var(--line);border-radius:4px;padding:0 5px;font-size:12px}
+.toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);background:#222;color:#fff;padding:8px 14px;border-radius:8px;display:flex;gap:12px;align-items:center;z-index:50}
+.toast button{background:none;border:0;color:#8fb2ff;font-weight:600}
+[hidden]{display:none!important}
+@media(max-width:600px){.col{flex-basis:84vw}}
