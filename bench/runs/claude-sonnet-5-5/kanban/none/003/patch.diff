+}
+function addItem() {
+  const v = $('cNewItem').value.trim(); if (!v) return;
+  cur.work.checklist.push({ id: uid(), text: v, done: false }); $('cNewItem').value = ''; drawChecklist();
+}
+$('cNewItem').addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); addItem(); } });
+$('cardForm').addEventListener('submit', e => {
