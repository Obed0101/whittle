+  }
+  if (c.checklist.length) badges.push(h('span', { class: 'badge' + (done === c.checklist.length ? ' full' : ''), text: `☑ ${done}/${c.checklist.length}` }));
+  if (c.desc.trim()) badges.push(h('span', { class: 'badge', text: '≡', title: 'Has description' }));
+  const tags = c.labels.map(id => b.labels.find(l => l.id === id)).filter(Boolean);
+  const el = h('div', { class: `card p-${c.priority}${col.done ? ' done' : ''}`, 'data-id': c.id, tabIndex: 0, draggable: true,
+    title: c.priority !== 'none' ? 'Priority: ' + c.priority : '',
+    onclick: () => openCard(col.id, c.id),
+    onkeydown: e => cardKey(e, col, c),
+    ondragstart: e => { drag = { type: 'card', id: c.id }; e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', c.id); setTimeout(() => el.classList.add('dragging')); },
+    ondragend: endDrag },
+    tags.length ? h('div', { class: 'tags' }, tags.map(l => h('span', { class: 'tag', style: `background:${l.color}`, text: l.name }))) : null,
+    h('div', { class: 'ct', text: c.title }),
+    badges.length ? h('div', { class: 'badges' }, badges) : null);
+  return el;
+}
+
+function cardKey(e, col, c) {
+  if (e.target !== e.currentTarget) return;
+  if (e.key === 'Enter') { e.preventDefault(); openCard(col.id, c.id); return; }
+  if (!e.altKey || !e.key.startsWith('Arrow')) return;
+  e.preventDefault();
+  const b = board(); const ci = b.columns.indexOf(col); const i = col.cards.indexOf(c);
+  focusId = c.id;
+  if (e.key === 'ArrowUp' && i > 0) mutate(() => { col.cards.splice(i, 1); col.cards.splice(i - 1, 0, c); });
+  else if (e.key === 'ArrowDown' && i < col.cards.length - 1) mutate(() => { col.cards.splice(i, 1); col.cards.splice(i + 1, 0, c); });
+  else if (e.key === 'ArrowLeft' && ci > 0) mutate(() => { col.cards.splice(i, 1); b.columns[ci - 1].cards.push(c); });
+  else if (e.key === 'ArrowRight' && ci < b.columns.length - 1) mutate(() => { col.cards.splice(i, 1); b.columns[ci + 1].cards.push(c); });
+}
+
+// ---------- drag & drop ----------
+let drag = null;
+const ph = h('div', { class: 'drop-ph' });
+function endDrag() {
+  drag = null; ph.remove();
+  document.querySelectorAll('.dragover,.dragging,.coldrag').forEach(e => e.classList.remove('dragover', 'dragging', 'coldrag'));
+}
+function dropCard(cardId, toColId, beforeId) {
+  const b = board();
+  let from, card;
+  for (const c of b.columns) { const i = c.cards.findIndex(x => x.id === cardId); if (i >= 0) { from = c; card = c.cards[i]; break; } }
+  const to = b.columns.find(c => c.id === toColId);
+  endDrag();
+  if (!card || !to) return;
+  mutate(() => {
+    from.cards.splice(from.cards.indexOf(card), 1);
+    const at = beforeId ? to.cards.findIndex(x => x.id === beforeId) : -1;
+    if (at >= 0) to.cards.splice(at, 0, card); else to.cards.push(card);
+    if (from !== to) card.updated = Date.now();
+  });
+  if (to.wip && to.cards.length > to.wip) toast(`"${to.title}" is over its WIP limit (${to.cards.length}/${to.wip})`);
+}
+$('board').addEventListener('dragover', e => {
+  if (!drag || drag.type !== 'col') return;
+  e.preventDefault();
+  const cols = [...$('board').querySelectorAll('.col:not(.coldrag)')];
