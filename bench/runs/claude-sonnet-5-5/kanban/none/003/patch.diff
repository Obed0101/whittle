+  });
+  el.addEventListener('dragleave', e => { if (!el.contains(e.relatedTarget)) el.classList.remove('dragover'); });
+  el.addEventListener('drop', e => {
+    if (!drag || drag.type !== 'card') return;
+    e.preventDefault();
+    const next = ph.parentNode === list ? ph.nextElementSibling : null;
+    dropCard(drag.id, col.id, next && next.dataset.id);
+  });
+  return el;
+}
+
+function renderCard(b, col, c) {
+  const t = today();
+  const done = c.checklist.filter(i => i.done).length;
+  const badges = [];
+  if (c.due) {
+    const cls = col.done ? '' : c.due < t ? 'overdue' : c.due <= addDays(t, 1) ? 'soon' : '';
