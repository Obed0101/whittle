+  const dragEl = $('board').querySelector('.col.coldrag');
+  if (dragEl) $('board').insertBefore(dragEl, next || $('board').querySelector('.addcol'));
+});
+$('board').addEventListener('drop', e => {
+  if (!drag || drag.type !== 'col') return;
+  e.preventDefault();
+  const order = [...$('board').querySelectorAll('.col')].map(c => c.dataset.id);
+  const id = drag.id; endDrag();
+  const b = board();
