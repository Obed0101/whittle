+  fn(); save(); render();
+  if (msg) toast(msg, true);
+}
+function restore(json) { const d = JSON.parse(json); S.boards = d.boards; S.active = d.active; save(); render(); }
+function undo() { if (!undoS.length) return; redoS.push(snap()); restore(undoS.pop()); toast('Undone'); }
+function redo() { if (!redoS.length) return; undoS.push(snap()); restore(redoS.pop()); toast('Redone'); }
+
+let toastT;
+function toast(msg, withUndo) {
+  const t = $('toast'); t.replaceChildren(h('span', { text: msg }), withUndo ? h('button', { text: 'Undo', onclick: () => { undo(); } }) : null);
+  t.hidden = false; clearTimeout(toastT); toastT = setTimeout(() => t.hidden = true, 5000);
+}
+
+// ---------- filters ----------
+const F = { q: '', label: '', due: '' };
+const filtering = () => F.q || F.label || F.due;
+function matches(card, col) {
+  if (F.q) {
+    const q = F.q.toLowerCase();
+    const hay = (card.title + ' ' + card.desc + ' ' + card.checklist.map(i => i.text).join(' ')).toLowerCase();
+    if (!hay.includes(q)) return false;
+  }
+  if (F.label && !card.labels.includes(F.label)) return false;
+  if (F.due) {
+    const t = today();
+    if (F.due === 'none') return !card.due;
+    if (!card.due) return false;
+    if (F.due === 'overdue') return card.due < t && !col.done;
+    if (F.due === 'today') return card.due === t;
+    if (F.due === 'week') return card.due >= t && card.due <= addDays(t, 7);
+  }
+  return true;
+}
+
+// ---------- render ----------
+let focusId = null;
+function render() {
