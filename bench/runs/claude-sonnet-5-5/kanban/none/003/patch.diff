+'use strict';
+(() => {
+const KEY = 'kanban.v1';
+const $ = id => document.getElementById(id);
+const uid = () => Math.random().toString(36).slice(2, 10) + Date.now().toString(36).slice(-4);
+const PALETTE = ['#e5484d', '#f08a24', '#d4a017', '#2f9e6b', '#3b6ef5', '#8b5cf6', '#d6409f', '#6b7285'];
+
+// ---------- element helper ----------
+function h(tag, props = {}, ...kids) {
+  const el = document.createElement(tag);
+  for (const [k, v] of Object.entries(props)) {
+    if (v == null || v === false) continue;
+    if (k === 'class') el.className = v;
+    else if (k === 'text') el.textContent = v;
+    else if (k.startsWith('on')) el.addEventListener(k.slice(2), v);
+    else if (k === 'style') el.style.cssText = v;
+    else if (k in el && k !== 'list') el[k] = v;
+    else el.setAttribute(k, v === true ? '' : v);
+  }
+  for (const c of kids.flat()) if (c != null && c !== false) el.append(c);
+  return el;
+}
+
+// ---------- dates ----------
+const pad = n => String(n).padStart(2, '0');
+const dstr = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
+const today = () => dstr(new Date());
+const addDays = (s, n) => { const [y, m, d] = s.split('-').map(Number); return dstr(new Date(y, m - 1, d + n)); };
+const fmtDate = s => { const [y, m, d] = s.split('-').map(Number); return new Date(y, m - 1, d).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: y === new Date().getFullYear() ? undefined : 'numeric' }); };
+
+// ---------- state ----------
+const newBoard = (name = 'My board') => ({
+  id: uid(), name,
+  columns: [
+    { id: uid(), title: 'To do', wip: 0, done: false, cards: [] },
+    { id: uid(), title: 'In progress', wip: 0, done: false, cards: [] },
+    { id: uid(), title: 'Done', wip: 0, done: true, cards: [] },
+  ],
+  labels: [
+    { id: uid(), name: 'Work', color: PALETTE[4] },
+    { id: uid(), name: 'Personal', color: PALETTE[3] },
+    { id: uid(), name: 'Urgent', color: PALETTE[0] },
+  ],
+  archive: [],
+});
+
+function normCard(c) {
+  const now = Date.now();
+  return {
+    id: String(c.id || uid()), title: String(c.title || 'Untitled').slice(0, 200), desc: String(c.desc || ''),
+    labels: Array.isArray(c.labels) ? c.labels.map(String) : [],
+    due: /^\d{4}-\d{2}-\d{2}$/.test(c.due) ? c.due : '',
+    priority: ['low', 'med', 'high'].includes(c.priority) ? c.priority : 'none',
+    checklist: Array.isArray(c.checklist) ? c.checklist.map(i => ({ id: String(i.id || uid()), text: String(i.text || ''), done: !!i.done })) : [],
+    created: +c.created || now, updated: +c.updated || now,
+  };
+}
+function normalize(d) {
+  if (!d || !Array.isArray(d.boards) || !d.boards.length) throw new Error('No boards found in data');
+  const boards = d.boards.map(b => ({
+    id: String(b.id || uid()), name: String(b.name || 'Board'),
+    columns: (Array.isArray(b.columns) ? b.columns : []).map(c => ({
+      id: String(c.id || uid()), title: String(c.title || 'Column'), wip: Math.max(0, +c.wip || 0), done: !!c.done,
+      cards: (Array.isArray(c.cards) ? c.cards : []).map(normCard),
+    })),
+    labels: (Array.isArray(b.labels) ? b.labels : []).map(l => ({ id: String(l.id || uid()), name: String(l.name || ''), color: /^#[0-9a-f]{6}$/i.test(l.color) ? l.color : PALETTE[7] })),
+    archive: (Array.isArray(b.archive) ? b.archive : []).map(a => ({ card: normCard(a.card || {}), colId: String(a.colId || ''), from: String(a.from || ''), at: +a.at || Date.now() })),
+  }));
+  const active = boards.some(b => b.id === d.active) ? d.active : boards[0].id;
+  return { boards, active, theme: d.theme === 'dark' ? 'dark' : 'light' };
+}
+
+let S;
+let storageOk = true;
+function load() {
+  try { const raw = localStorage.getItem(KEY); if (raw) return normalize(JSON.parse(raw)); }
+  catch (e) { console.error('Load failed', e); backupCorrupt(); }
+  const b = newBoard();
+  return { boards: [b], active: b.id, theme: matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light' };
+}
+function backupCorrupt() { try { localStorage.setItem(KEY + '.corrupt', localStorage.getItem(KEY)); } catch {} }
+function save() {
+  try { localStorage.setItem(KEY, JSON.stringify(S)); if (!storageOk) { storageOk = true; $('warn').hidden = true; } }
