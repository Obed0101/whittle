+      if (n) commit(() => { const nb = newBoard(n); state.boards.push(nb); state.active = nb.id; });
+    } },
+    { label: 'Archived cards…', fn: showArchive },
+    '-',
+    { label: 'Delete board', danger: true, fn: async () => {
