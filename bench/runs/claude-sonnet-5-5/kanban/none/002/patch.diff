+        const f = findCard(b, d.id); if (!f) return;
+        if (f.col.id === targetCol) f.col.cards[f.i] = d;
+        else { f.col.cards.splice(f.i, 1); findCol(b, targetCol).cards.push(d); }
+      });
+    };
+    dlg.addEventListener('keydown', e => { if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') { e.preventDefault(); save(); } });
+
+    const foot = [];
+    if (!isNew) {
+      foot.push(
+        h('button', { type: 'button', class: 'btn danger', onclick: () => { close(); commit(() => { const f = findCard(b, d.id); if (f) f.col.cards.splice(f.i, 1); }, 'Card deleted'); } }, 'Delete'),
+        h('button', { type: 'button', class: 'btn', onclick: () => { close(); commit(() => { const f = findCard(b, d.id); if (f) archiveCards(b, f.col, [f.card]); }, 'Card archived'); } }, 'Archive'));
+    }
+    setTimeout(() => { fit(); if (isNew) title.focus(); });
+    return h('div', {},
+      h('div', { class: 'modal-body' },
+        h('div', { class: 'field' }, h('span', { class: 'lbl' }, isNew ? 'New card' : 'Title'), title),
+        h('div', { class: 'field-row' },
+          h('div', { class: 'field' }, h('label', {}, 'Column'), colSel),
+          h('div', { class: 'field' }, h('label', {}, 'Priority'), prio),
+          h('div', { class: 'field' }, h('label', {}, 'Due'), h('div', { style: 'display:flex;gap:4px' }, due, clearDue))),
+        h('div', { class: 'field' }, h('span', { class: 'lbl' }, 'Labels'), chips),
+        h('div', { class: 'field' }, h('label', {}, 'Description'), desc),
+        h('div', { class: 'field' }, h('span', { class: 'lbl' }, 'Checklist'), bar, checks, newItem)),
+      h('div', { class: 'modal-foot' }, ...foot, h('div', { class: 'spacer' }),
+        h('button', { type: 'button', class: 'btn', onclick: () => close() }, 'Cancel'),
+        h('button', { type: 'button', class: 'btn primary', onclick: save, title: 'Ctrl/⌘+Enter' }, 'Save')));
+  });
+}
+function newCardDialog(colId) {
+  const b = board();
+  openCardModal(newCard(''), colId || b.columns[0].id, true);
+}
+
+/* ---------- archive, export/import, help ---------- */
+function showArchive() {
+  modal(close => {
+    const b = board(), body = h('div');
+    const draw = () => {
+      body.replaceChildren(...(b.archive.length ? b.archive.map(a => h('div', { class: 'arch-item' },
+        h('div', { class: 't' }, h('div', {}, a.card.title), h('div', { class: 's' }, `from “${a.colName}” · archived ${new Date(a.at).toLocaleDateString()}`)),
+        h('button', { class: 'btn', onclick: () => { commit(() => {
+          const c = findCol(b, a.colId) || b.columns[0]; c.cards.push(a.card); b.archive.splice(b.archive.indexOf(a), 1);
+        }); draw(); } }, 'Restore'),
+        h('button', { class: 'btn danger', onclick: () => { commit(() => b.archive.splice(b.archive.indexOf(a), 1), 'Deleted forever'); draw(); } }, 'Delete')))
+        : [h('p', { class: 'muted' }, 'No archived cards.')]));
+    };
+    draw();
+    return h('div', {}, h('div', { class: 'modal-body' }, h('h2', {}, 'Archived cards — ' + b.name), body),
+      h('div', { class: 'modal-foot' }, h('div', { class: 'spacer' }), h('button', { class: 'btn primary', onclick: () => close() }, 'Close')));
+  });
+}
+function exportData() {
+  const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
+  const a = h('a', { href: URL.createObjectURL(blob), download: `kanban-backup-${todayStr()}.json` });
+  document.body.append(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
+  toast('Backup downloaded');
+}
+$('#importFile').addEventListener('change', async e => {
+  const f = e.target.files[0]; e.target.value = ''; if (!f) return;
+  let data;
+  try { data = sanitize(JSON.parse(await f.text())); } catch (err) { return toast('Import failed: ' + err.message); }
+  if (!(await confirmBox('Replace all data?', `This replaces everything with the backup (${data.boards.length} board(s)). You can undo right after.`, 'Import'))) return;
+  commit(() => { state.boards = data.boards; state.active = data.active; }, 'Backup imported');
+});
+function showHelp() {
+  const rows = [['/', 'Search'], ['n', 'New card'], ['b', 'Next board'], ['Ctrl/⌘ Z', 'Undo'], ['Esc', 'Close dialog / clear search'], ['Ctrl/⌘ Enter', 'Save card in editor'], ['?', 'This help']];
+  modal(close => h('div', {}, h('div', { class: 'modal-body' }, h('h2', {}, 'Keyboard shortcuts'),
+    h('table', { class: 'help' }, rows.map(([k, v]) => h('tr', {}, h('td', {}, h('kbd', {}, k)), h('td', {}, v)))),
+    h('p', { class: 'muted', style: 'margin:0' }, 'Drag cards between columns; drag a column header to reorder columns. Data is stored in this browser only — export backups regularly.')),
+    h('div', { class: 'modal-foot' }, h('div', { class: 'spacer' }), h('button', { class: 'btn primary', onclick: () => close() }, 'Close'))));
+}
+
+/* ---------- drag and drop ---------- */
+let drag = null, ph = null;
+const clearPh = () => { ph?.remove(); ph = null; };
+boardEl.addEventListener('dragstart', e => {
+  const t = e.target.closest?.('[data-drag]'); if (!t) return;
+  if (t.dataset.drag === 'card') { drag = { type: 'card', id: t.dataset.id, el: t }; }
+  else { const col = t.closest('.col'); drag = { type: 'col', id: col.dataset.id, el: col }; }
+  e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', drag.id);
+  setTimeout(() => drag && drag.el.classList.add('dragging'));
+});
+const after = (container, sel, pos, axis) => {
+  for (const el of container.querySelectorAll(sel)) {
+    if (el === drag.el) continue;
+    const r = el.getBoundingClientRect();
+    if (pos < (axis === 'y' ? r.top + r.height / 2 : r.left + r.width / 2)) return el;
+  }
+  return null;
+};
+boardEl.addEventListener('dragover', e => {
+  if (!drag) return;
+  if (drag.type === 'card') {
+    const col = e.target.closest?.('.col'); if (!col) return;
+    e.preventDefault();
+    const list = col.querySelector('.col-cards');
+    if (!ph || ph.className !== 'placeholder') { clearPh(); ph = h('div', { class: 'placeholder' }); }
+    list.querySelector('.empty')?.remove();
+    const next = after(list, '.card', e.clientY, 'y');
+    if (ph.parentNode !== list || ph.nextElementSibling !== (next === drag.el ? null : next)) list.insertBefore(ph, next);
+  } else {
+    e.preventDefault();
+    if (!ph || ph.className !== 'col-placeholder') { clearPh(); ph = h('div', { class: 'col-placeholder' }); }
+    const next = after(boardEl, '.col', e.clientX, 'x');
+    boardEl.insertBefore(ph, next || boardEl.querySelector('.add-col'));
+  }
+});
+boardEl.addEventListener('drop', e => {
+  if (!drag || !ph) return;
+  e.preventDefault();
+  const b = board(), d = drag;
+  const nextEl = (() => { let n = ph.nextElementSibling; while (n && (n === d.el || !n.dataset.id)) n = n.nextElementSibling; return n; })();
+  if (d.type === 'card') {
+    const toCol = findCol(b, ph.closest('.col').dataset.id), beforeId = nextEl?.dataset.id;
+    commit(() => {
+      const f = findCard(b, d.id); if (!f) return;
+      f.col.cards.splice(f.i, 1);
+      let idx = beforeId ? toCol.cards.findIndex(k => k.id === beforeId) : -1;
+      if (idx < 0) idx = toCol.cards.length;
+      toCol.cards.splice(idx, 0, f.card);
+    });
+  } else {
+    const beforeId = nextEl?.dataset.id;
+    commit(() => {
+      const i = b.columns.findIndex(c => c.id === d.id), [c] = b.columns.splice(i, 1);
+      let idx = beforeId ? b.columns.findIndex(x => x.id === beforeId) : -1;
+      if (idx < 0) idx = b.columns.length;
+      b.columns.splice(idx, 0, c);
+    });
+  }
+  drag = null; ph = null;
+});
+document.addEventListener('dragend', () => {
+  if (!drag) return;
+  const had = drag; drag = null; clearPh(); had.el.classList.remove('dragging'); render();
+});
+
+/* ---------- top bar wiring ---------- */
+$('#boardSelect').addEventListener('change', e => { state.active = e.target.value; save(); render(); });
+$('#boardMenuBtn').addEventListener('click', e => boardMenu(e.currentTarget));
+$('#menuBtn').addEventListener('click', e => mainMenu(e.currentTarget));
+$('#undoBtn').addEventListener('click', undo);
+$('#themeBtn').addEventListener('click', () => { state.theme = state.theme === 'dark' ? 'light' : 'dark'; save(); render(); });
+$('#search').addEventListener('input', e => { ui.q = e.target.value; render(); });
+$('#fLabel').addEventListener('change', e => { ui.label = e.target.value; render(); });
+$('#fPriority').addEventListener('change', e => { ui.priority = e.target.value; render(); });
+$('#fDue').addEventListener('change', e => { ui.due = e.target.value; render(); });
+$('#clearFilters').addEventListener('click', () => {
+  Object.assign(ui, { q: '', label: '', priority: '', due: '' });
+  $('#search').value = ''; $('#fPriority').value = ''; $('#fDue').value = ''; render();
+});
+// leaving the composer empty closes it
+boardEl.addEventListener('focusout', e => {
+  if (e.target.matches?.('.composer textarea') && !e.target.value.trim()) setTimeout(() => {
+    if (ui.composing && !document.activeElement?.closest('.composer')) { ui.composing = null; render(); }
+  }, 0);
+});
+
+document.addEventListener('keydown', e => {
+  const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName) || e.target.isContentEditable;
+  if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'z' && !e.shiftKey && !typing && !document.querySelector('dialog[open]')) { e.preventDefault(); undo(); return; }
+  if (e.key === 'Escape') {
+    if (openMenu) return closeMenu();
+    if (e.target.id === 'search') { $('#clearFilters').click(); e.target.blur(); }
+    return;
+  }
+  if (typing || e.metaKey || e.ctrlKey || e.altKey || document.querySelector('dialog[open]')) return;
+  if (e.key === '/') { e.preventDefault(); $('#search').focus(); }
+  else if (e.key === 'n') { e.preventDefault(); newCardDialog(); }
+  else if (e.key === '?') showHelp();
+  else if (e.key === 'b') { const i = state.boards.findIndex(x => x.id === state.active); state.active = state.boards[(i + 1) % state.boards.length].id; save(); render(); }
+});
+
+// keep several tabs in sync, and refresh date badges after midnight
+window.addEventListener('storage', e => {
+  if (e.key !== KEY || !e.newValue) return;
+  try { state = sanitize(JSON.parse(e.newValue)); render(); } catch { /* ignore */ }
+});
+let day = todayStr();
+setInterval(() => { if (todayStr() !== day) { day = todayStr(); render(); } }, 60000);
+
+// "New card" button lives in each column; add a global quick-add via 'n'. Expose a header button too.
+$('#undoBtn').before(h('button', { class: 'btn primary', onclick: () => newCardDialog() }, '+ New card'));
+
+save(); render();
diff --git a/board/index.html b/board/index.html
new file mode 100644
