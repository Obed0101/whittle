+'use strict';
+/* Personal Kanban — data lives in localStorage (key below). No dependencies. */
+const KEY = 'kanban.v1';
+const $ = (s, r = document) => r.querySelector(s);
+const uid = () => Math.random().toString(36).slice(2, 9) + Date.now().toString(36).slice(-4);
+const PRIORITIES = ['high', 'medium', 'low'];
+
+/* ---------- DOM helper (never uses innerHTML, so user text is always safe) ---------- */
+function h(tag, props, ...kids) {
+  const el = document.createElement(tag);
+  for (const [k, v] of Object.entries(props || {})) {
+    if (v == null || v === false) continue;
+    if (k.startsWith('on')) el.addEventListener(k.slice(2), v);
+    else if (k === 'class') el.className = v;
+    else if (k === 'dataset') Object.assign(el.dataset, v);
+    else if (k === 'style') el.style.cssText = v;
+    else if (k in el && k !== 'list') el[k] = v;
+    else el.setAttribute(k, v === true ? '' : v);
+  }
+  for (const k of kids.flat()) if (k != null && k !== false) el.append(k.nodeType ? k : document.createTextNode(k));
+  return el;
+}
+
+/* ---------- state ---------- */
+function newCol(name, done = false) { return { id: uid(), name, wip: 0, done, cards: [] }; }
+function newCard(title) {
+  return { id: uid(), title, desc: '', labels: [], due: '', priority: '', checklist: [], created: Date.now() };
+}
+function newBoard(name) {
+  return { id: uid(), name, columns: [newCol('Backlog'), newCol('To Do'), newCol('In Progress'), newCol('Done', true)], archive: [] };
+}
+function defaultState() {
+  const b = newBoard('My Board');
+  const c = newCard('Welcome! Click a card to edit it');
+  c.desc = 'Drag cards between columns, drag column headers to reorder them.\nPress ? for keyboard shortcuts.\nEverything is saved automatically in this browser — use Menu → Export for backups.';
+  c.labels = ['tip'];
+  b.columns[1].cards.push(c);
+  return { version: 1, theme: matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light', active: b.id, boards: [b] };
+}
+function sanitize(s) {
+  if (!s || !Array.isArray(s.boards) || !s.boards.length) throw new Error('Not a valid board file');
+  for (const b of s.boards) {
+    b.id ||= uid(); b.name = String(b.name || 'Board');
+    b.archive = Array.isArray(b.archive) ? b.archive : [];
+    if (!Array.isArray(b.columns)) throw new Error('Not a valid board file');
+    for (const c of b.columns) {
+      c.id ||= uid(); c.name = String(c.name || 'Column'); c.wip = +c.wip || 0; c.done = !!c.done;
+      c.cards = Array.isArray(c.cards) ? c.cards : [];
+      for (const k of c.cards) fixCard(k);
+    }
+    for (const a of b.archive) if (a.card) fixCard(a.card);
+    b.archive = b.archive.filter(a => a.card);
+  }
+  if (!s.boards.some(b => b.id === s.active)) s.active = s.boards[0].id;
+  s.theme = s.theme === 'dark' ? 'dark' : 'light';
+  return s;
+}
+function fixCard(k) {
+  k.id ||= uid(); k.title = String(k.title || 'Untitled'); k.desc = String(k.desc || '');
+  k.labels = Array.isArray(k.labels) ? k.labels.map(String) : [];
+  k.due = /^\d{4}-\d{2}-\d{2}$/.test(k.due) ? k.due : '';
+  k.priority = PRIORITIES.includes(k.priority) ? k.priority : '';
+  k.checklist = Array.isArray(k.checklist) ? k.checklist.map(i => ({ id: i.id || uid(), text: String(i.text || ''), done: !!i.done })) : [];
+  k.created ||= Date.now();
+}
+function load() {
+  try { const raw = localStorage.getItem(KEY); if (raw) return sanitize(JSON.parse(raw)); } catch (e) { console.warn('Could not load saved data', e); }
+  return defaultState();
+}
+let state = load();
+let saveFailed = false;
+function save() {
+  try { localStorage.setItem(KEY, JSON.stringify(state)); saveFailed = false; }
+  catch (e) { if (!saveFailed) toast('Could not save — browser storage is full or disabled. Export a backup!'); saveFailed = true; }
+}
+const board = () => state.boards.find(b => b.id === state.active) || state.boards[0];
+const findCol = (b, id) => b.columns.find(c => c.id === id);
+function findCard(b, id) {
+  for (const c of b.columns) { const i = c.cards.findIndex(k => k.id === id); if (i >= 0) return { col: c, i, card: c.cards[i] }; }
+  return null;
+}
+
+/* ---------- undo ---------- */
+const history = [];
+function commit(fn, msg) {
+  history.push(JSON.stringify({ boards: state.boards, active: state.active }));
+  if (history.length > 60) history.shift();
+  fn();
+  save(); render();
+  if (msg) toast(msg, 'Undo', undo);
+}
+function undo() {
+  const s = history.pop();
+  if (!s) return toast('Nothing to undo');
+  const p = JSON.parse(s);
+  state.boards = p.boards; state.active = p.active;
+  save(); render(); toast('Undone');
+}
+
+/* ---------- ui state ---------- */
+const ui = { q: '', label: '', priority: '', due: '', composing: null };
+const boardEl = $('#board');
+
+/* ---------- dates ---------- */
+const pad = n => String(n).padStart(2, '0');
+const ymd = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
+const todayStr = () => ymd(new Date());
+function dayDiff(s) { const [y, m, d] = s.split('-').map(Number); const t = new Date(); return Math.round((new Date(y, m - 1, d) - new Date(t.getFullYear(), t.getMonth(), t.getDate())) / 864e5); }
+function dueText(s) {
+  const d = dayDiff(s);
+  if (d === 0) return 'Today'; if (d === 1) return 'Tomorrow'; if (d === -1) return 'Yesterday';
+  const [y, m, dd] = s.split('-').map(Number);
+  return new Date(y, m - 1, dd).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: y === new Date().getFullYear() ? undefined : 'numeric' });
+}
+
+/* ---------- filtering ---------- */
+function matches(card, col) {
+  const q = ui.q.trim().toLowerCase();
+  if (q && !(card.title + ' ' + card.desc + ' ' + card.labels.join(' ')).toLowerCase().includes(q)) return false;
+  if (ui.label && !card.labels.includes(ui.label)) return false;
+  if (ui.priority && card.priority !== ui.priority) return false;
+  if (ui.due === 'none') return !card.due;
+  if (ui.due === 'overdue') return !!card.due && !col.done && dayDiff(card.due) < 0;
+  if (ui.due === 'week') return !!card.due && !col.done && dayDiff(card.due) <= 7;
+  return true;
+}
+const filtering = () => !!(ui.q.trim() || ui.label || ui.priority || ui.due);
+function labelColor(name) {
+  let x = 0; for (const ch of name.toLowerCase()) x = (x * 31 + ch.charCodeAt(0)) % 360;
+  return `hsl(${x} 55% 40%)`;
+}
+const labelEl = (n, ...extra) => h('span', { class: 'label chip', style: `background:${labelColor(n)}` }, n, ...extra);
+function allLabels(b) { return [...new Set([...b.columns.flatMap(c => c.cards), ...b.archive.map(a => a.card)].flatMap(k => k.labels))].sort(); }
+
+/* ---------- rendering ---------- */
+function renderTop() {
+  const b = board();
+  document.documentElement.dataset.theme = state.theme;
+  const sel = $('#boardSelect');
+  sel.replaceChildren(...state.boards.map(x => h('option', { value: x.id, selected: x.id === b.id }, x.name)));
+  const labels = allLabels(b);
+  if (ui.label && !labels.includes(ui.label)) ui.label = '';
+  $('#fLabel').replaceChildren(h('option', { value: '' }, 'Any label'), ...labels.map(l => h('option', { value: l, selected: l === ui.label }, l)));
+  $('#clearFilters').hidden = !filtering();
+  $('#undoBtn').disabled = !history.length;
+  document.title = b.name + ' — Kanban';
+}
+function render() {
+  renderTop();
+  const b = board();
+  const scroll = { x: boardEl.scrollLeft, cols: {} };
+  boardEl.querySelectorAll('.col').forEach(c => { scroll.cols[c.dataset.id] = c.querySelector('.col-cards').scrollTop; });
+  boardEl.replaceChildren(...b.columns.map(colEl), h('div', { class: 'add-col' },
+    h('button', { class: 'btn', onclick: addColumn }, '+ Add column')));
+  boardEl.scrollLeft = scroll.x;
+  boardEl.querySelectorAll('.col').forEach(c => { c.querySelector('.col-cards').scrollTop = scroll.cols[c.dataset.id] || 0; });
+  const ta = $('.composer textarea');
+  if (ta) { ta.focus(); ta.scrollIntoView({ block: 'nearest' }); }
+}
+function colEl(col) {
+  const shown = col.cards.filter(k => matches(k, col));
+  const over = col.wip > 0 && col.cards.length > col.wip;
+  const count = (filtering() ? `${shown.length}/` : '') + col.cards.length + (col.wip ? ` / ${col.wip}` : '');
+  const list = h('div', { class: 'col-cards' }, shown.map(k => cardEl(k, col)));
+  if (!shown.length && !filtering()) list.append(h('div', { class: 'empty' }, 'No cards'));
+  return h('section', { class: 'col', dataset: { id: col.id } },
+    h('div', { class: 'col-head', draggable: true, dataset: { drag: 'col' } },
+      h('button', { class: 'col-title', title: 'Rename column', onclick: () => renameColumn(col.id) }, col.name),
+      col.done ? h('span', { class: 'done-mark', title: 'Cards here count as done' }, '✓') : null,
+      h('span', { class: 'count' + (over ? ' over' : ''), title: col.wip ? 'WIP limit ' + col.wip : '' }, count),
+      h('button', { class: 'btn ghost', 'aria-label': 'Column options', onclick: e => columnMenu(e.currentTarget, col.id) }, '⋯')),
+    list,
+    ui.composing === col.id ? composer(col) : h('button', { class: 'btn ghost add-card', onclick: () => { ui.composing = col.id; render(); } }, '+ Add card'));
+}
+function composer(col) {
+  const ta = h('textarea', { placeholder: 'Card title… (Enter to add, Shift+Enter for new line)', rows: 2 });
+  const add = () => {
+    const t = ta.value.trim(); if (!t) return;
+    commit(() => col.cards.push(newCard(t)));
+  };
+  ta.addEventListener('keydown', e => {
+    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); add(); }
+    else if (e.key === 'Escape') { ui.composing = null; render(); }
+  });
+  return h('div', { class: 'composer' }, ta,
+    h('div', { class: 'row' },
+      h('button', { class: 'btn primary', onmousedown: e => e.preventDefault(), onclick: add }, 'Add card'),
+      h('button', { class: 'btn', onmousedown: e => e.preventDefault(), onclick: () => { ui.composing = null; render(); } }, 'Done')));
+}
+function cardEl(k, col) {
+  const meta = [];
+  if (k.due) {
+    const d = dayDiff(k.due);
+    const cls = col.done ? '' : d < 0 ? ' overdue' : d <= 2 ? ' soon' : '';
+    meta.push(h('span', { class: 'badge' + cls, title: 'Due ' + k.due }, '📅 ' + dueText(k.due)));
+  }
+  if (k.checklist.length) meta.push(h('span', { class: 'badge' }, `☑ ${k.checklist.filter(i => i.done).length}/${k.checklist.length}`));
+  if (k.desc.trim()) meta.push(h('span', { class: 'badge', title: 'Has description' }, '≡'));
+  return h('div', {
+    class: 'card' + (k.priority ? ' p-' + k.priority : '') + (col.done ? ' is-done' : ''),
+    draggable: true, tabIndex: 0, dataset: { id: k.id, drag: 'card' },
+    onclick: () => editCard(k.id),
+    onkeydown: e => { if (e.key === 'Enter' && e.target === e.currentTarget) editCard(k.id); }
+  },
+    k.labels.length ? h('div', { class: 'labels' }, k.labels.map(l => labelEl(l))) : null,
+    h('div', { class: 'card-title' }, k.title),
+    meta.length ? h('div', { class: 'meta' }, meta) : null);
+}
+
+/* ---------- dialogs / menus / toast ---------- */
+function modal(build) {
+  return new Promise(res => {
+    let result;
+    const d = h('dialog', { class: 'modal' });
+    d.addEventListener('close', () => { d.remove(); res(result); });
+    d.addEventListener('mousedown', e => { if (e.target === d) d._backdrop = true; });
+    d.addEventListener('click', e => { if (e.target === d && d._backdrop) d.close(); d._backdrop = false; });
+    d.append(build(v => { result = v; d.close(); }, d));
+    document.body.append(d); d.showModal();
+  });
+}
+function askText(title, value = '', { ok = 'Save', placeholder = '', type = 'text' } = {}) {
+  return modal(close => {
+    const input = h('input', { type, value, placeholder, style: 'width:100%' });
+    const form = h('form', { onsubmit: e => { e.preventDefault(); const v = input.value.trim(); if (v) close(v); } },
+      h('div', { class: 'modal-body' }, h('h2', {}, title), input),
+      h('div', { class: 'modal-foot' }, h('div', { class: 'spacer' }),
+        h('button', { type: 'button', class: 'btn', onclick: () => close() }, 'Cancel'),
+        h('button', { class: 'btn primary' }, ok)));
+    setTimeout(() => { input.focus(); input.select(); });
+    return form;
+  });
+}
+function confirmBox(title, text, ok = 'Delete') {
+  return modal(close => h('div', {},
+    h('div', { class: 'modal-body' }, h('h2', {}, title), h('p', { class: 'muted', style: 'margin:0' }, text)),
+    h('div', { class: 'modal-foot' }, h('div', { class: 'spacer' }),
+      h('button', { class: 'btn', onclick: () => close(false) }, 'Cancel'),
+      h('button', { class: 'btn primary', autofocus: true, onclick: () => close(true) }, ok))));
+}
+let toastTimer;
+function toast(msg, action, fn) {
+  const t = $('#toast');
+  t.replaceChildren(msg, action ? h('button', { onclick: () => { t.hidden = true; fn(); } }, action) : null);
+  t.hidden = false; clearTimeout(toastTimer);
+  toastTimer = setTimeout(() => { t.hidden = true; }, action ? 7000 : 3000);
+}
+let openMenu = null;
+function closeMenu() { if (openMenu) { openMenu.remove(); openMenu = null; } }
+function showMenu(anchor, items) {
+  closeMenu();
+  const m = h('div', { class: 'menu', role: 'menu' }, items.map(it => it === '-' ? h('hr') :
+    h('button', { class: it.danger ? 'danger' : '', role: 'menuitem', onclick: () => { closeMenu(); it.fn(); } }, it.label)));
+  document.body.append(m); openMenu = m;
+  const r = anchor.getBoundingClientRect();
+  m.style.left = Math.max(4, Math.min(r.left, innerWidth - m.offsetWidth - 4)) + 'px';
+  m.style.top = Math.max(4, Math.min(r.bottom + 4, innerHeight - m.offsetHeight - 4)) + 'px';
+  m.querySelector('button')?.focus();
+}
+document.addEventListener('mousedown', e => { if (openMenu && !openMenu.contains(e.target)) closeMenu(); });
+
+/* ---------- column / board actions ---------- */
+async function addColumn() {
+  const name = await askText('New column', '', { ok: 'Add', placeholder: 'Column name' });
+  if (name) commit(() => board().columns.push(newCol(name)));
+}
+async function renameColumn(id) {
+  const col = findCol(board(), id);
+  const name = await askText('Rename column', col.name);
+  if (name && name !== col.name) commit(() => { col.name = name; });
+}
+function columnMenu(anchor, id) {
+  const b = board(), col = findCol(b, id), i = b.columns.indexOf(col);
+  const swap = d => commit(() => { const [c] = b.columns.splice(i, 1); b.columns.splice(i + d, 0, c); });
+  showMenu(anchor, [
+    { label: 'Rename', fn: () => renameColumn(id) },
+    { label: col.wip ? `WIP limit: ${col.wip} (change)` : 'Set WIP limit…', fn: async () => {
+      const v = await askText('WIP limit', col.wip || '', { type: 'number', placeholder: '0 = no limit', ok: 'Set' });
+      if (v != null) commit(() => { col.wip = Math.max(0, parseInt(v, 10) || 0); });
+    } },
+    { label: col.done ? '✓ Counts as done (turn off)' : 'Mark as “done” column', fn: () => commit(() => { col.done = !col.done; }) },
+    '-',
+    i > 0 ? { label: '← Move left', fn: () => swap(-1) } : null,
+    i < b.columns.length - 1 ? { label: 'Move right →', fn: () => swap(1) } : null,
+    '-',
+    col.cards.length ? { label: 'Archive all cards', fn: () => commit(() => archiveCards(b, col, col.cards.slice()), `Archived ${col.cards.length} cards`) } : null,
+    { label: 'Delete column', danger: true, fn: async () => {
+      if (b.columns.length === 1) return toast('A board needs at least one column');
+      if (col.cards.length && !(await confirmBox('Delete column?', `“${col.name}” and its ${col.cards.length} card(s) will be deleted.`))) return;
+      commit(() => b.columns.splice(b.columns.indexOf(col), 1), 'Column deleted');
+    } }
+  ].filter(Boolean));
+}
+function archiveCards(b, col, cards) {
+  for (const k of cards) {
+    col.cards.splice(col.cards.indexOf(k), 1);
+    b.archive.unshift({ card: k, colId: col.id, colName: col.name, at: Date.now() });
+  }
+}
+function boardMenu(anchor) {
+  showMenu(anchor, [
+    { label: 'Rename board', fn: async () => { const n = await askText('Rename board', board().name); if (n) commit(() => { board().name = n; }); } },
+    { label: 'New board…', fn: async () => {
