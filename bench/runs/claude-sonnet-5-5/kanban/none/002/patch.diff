@@ -0,0 +1,41 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Kanban</title>
+<link rel="stylesheet" href="style.css">
+<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%234f6df5'/%3E%3Crect x='6' y='7' width='5' height='18' rx='1.5' fill='%23fff'/%3E%3Crect x='13.5' y='7' width='5' height='12' rx='1.5' fill='%23fff'/%3E%3Crect x='21' y='7' width='5' height='15' rx='1.5' fill='%23fff'/%3E%3C/svg%3E">
+</head>
+<body>
+<header class="topbar">
+  <div class="brand">Kanban</div>
+  <select id="boardSelect" aria-label="Board"></select>
+  <button id="boardMenuBtn" class="btn" title="Board options" aria-label="Board options">⋯</button>
+  <div class="spacer"></div>
+  <input id="search" type="search" placeholder="Search cards  ( / )" aria-label="Search cards">
+  <select id="fLabel" aria-label="Filter by label"></select>
+  <select id="fPriority" aria-label="Filter by priority">
+    <option value="">Any priority</option>
+    <option value="high">High</option>
+    <option value="medium">Medium</option>
+    <option value="low">Low</option>
+  </select>
+  <select id="fDue" aria-label="Filter by due date">
+    <option value="">Any due date</option>
+    <option value="overdue">Overdue</option>
+    <option value="week">Due within 7 days</option>
+    <option value="none">No due date</option>
+  </select>
+  <button id="clearFilters" class="btn" hidden>Clear</button>
+  <button id="undoBtn" class="btn" title="Undo (Ctrl/⌘+Z)">Undo</button>
+  <button id="themeBtn" class="btn" title="Toggle theme">Theme</button>
+  <button id="menuBtn" class="btn" title="Menu">Menu</button>
+</header>
+<main id="board" class="board" aria-label="Board"></main>
+<div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
+<input id="importFile" type="file" accept="application/json,.json" hidden>
+<noscript>This app needs JavaScript enabled.</noscript>
+<script src="app.js"></script>
+</body>
+</html>
diff --git a/board/style.css b/board/style.css
new file mode 100644
index 0000000..d300ba3
--- /dev/null
+++ b/board/style.css
@@ -0,0 +1,108 @@
+:root{
+  --bg:#f1f2f6;--surface:#fff;--col:#e6e8ef;--text:#1f2430;--muted:#6b7285;--border:#d3d7e2;
+  --accent:#4f6df5;--accent-text:#fff;--danger:#d93a4a;--warn:#c27a00;--ok:#1f9d55;
+  --shadow:0 1px 2px rgba(20,25,40,.12);--shadow-lg:0 10px 30px rgba(20,25,40,.25);
+}
+:root[data-theme=dark]{
+  --bg:#14161c;--surface:#242833;--col:#1b1e26;--text:#e7e9f0;--muted:#98a0b3;--border:#343a49;
+  --accent:#6f88ff;--accent-text:#0d1020;--danger:#ff6b78;--warn:#f0b34a;--ok:#4cc582;
+  --shadow:0 1px 2px rgba(0,0,0,.5);--shadow-lg:0 10px 30px rgba(0,0,0,.6);
+  color-scheme:dark;
+}
+*{box-sizing:border-box}
+html,body{height:100%;margin:0}
+body{display:flex;flex-direction:column;background:var(--bg);color:var(--text);
+  font:14px/1.4 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
+button,input,select,textarea{font:inherit;color:inherit}
+.topbar{display:flex;align-items:center;gap:8px;padding:8px 12px;background:var(--surface);
+  border-bottom:1px solid var(--border);flex-wrap:wrap}
+.brand{font-weight:700;font-size:16px;margin-right:4px}
+.spacer{flex:1}
+.topbar input[type=search]{width:200px}
+input,select,textarea{background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:6px 8px}
+input:focus,select:focus,textarea:focus,button:focus-visible,.card:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
+.btn{background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:6px 10px;cursor:pointer}
+.btn:hover{background:var(--col)}
+.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-text)}
+.btn.primary:hover{filter:brightness(1.08)}
+.btn.danger{color:var(--danger)}
+.btn.ghost{border-color:transparent;background:transparent}
+.btn.ghost:hover{background:var(--col)}
+.btn:disabled{opacity:.4;cursor:default}
+[hidden]{display:none!important}
+
+.board{flex:1;display:flex;align-items:flex-start;gap:12px;padding:12px;overflow:auto}
+.col{flex:0 0 290px;max-height:100%;display:flex;flex-direction:column;background:var(--col);
+  border-radius:10px;border:1px solid var(--border)}
+.col.dragging{opacity:.4}
+.col-head{display:flex;align-items:center;gap:6px;padding:8px 8px 6px 12px;cursor:grab}
+.col-title{flex:1;font-weight:600;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
+  background:none;border:0;text-align:left;padding:2px 0;cursor:inherit}
+.count{font-size:12px;color:var(--muted);background:var(--surface);border-radius:10px;padding:1px 8px}
+.count.over{background:var(--danger);color:#fff}
+.done-mark{color:var(--ok);font-size:12px}
+.col-cards{flex:1;overflow-y:auto;padding:2px 8px 8px;display:flex;flex-direction:column;gap:8px;min-height:30px}
+.empty{color:var(--muted);font-size:12px;text-align:center;padding:10px 0}
+.card{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:8px 10px;
+  box-shadow:var(--shadow);cursor:pointer;border-left:4px solid transparent;word-break:break-word}
+.card:hover{border-color:var(--accent)}
+.card.dragging{opacity:.35}
+.card.p-high{border-left-color:var(--danger)}
+.card.p-medium{border-left-color:var(--warn)}
+.card.p-low{border-left-color:var(--ok)}
+.card.is-done .card-title{text-decoration:line-through;color:var(--muted)}
+.card-title{white-space:pre-wrap}
+.labels{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:5px}
+.label{color:#fff;font-size:11px;font-weight:600;border-radius:4px;padding:0 6px;line-height:18px}
+.meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px;font-size:12px;color:var(--muted)}
+.badge.overdue{color:var(--danger);font-weight:600}
+.badge.soon{color:var(--warn);font-weight:600}
+.placeholder{border:2px dashed var(--accent);border-radius:8px;min-height:40px;flex:none;opacity:.6}
+.col-placeholder{flex:0 0 290px;align-self:stretch;border:2px dashed var(--accent);border-radius:10px;opacity:.5}
+.add-card{margin:0 8px 8px;text-align:left;color:var(--muted)}
+.composer{padding:0 8px 8px;display:flex;flex-direction:column;gap:6px}
+.composer textarea{resize:none;width:100%;min-height:56px}
+.composer .row{display:flex;gap:6px}
+.add-col{flex:0 0 290px}
+.add-col .btn{width:100%;text-align:left;border-style:dashed}
+
+dialog.modal{border:1px solid var(--border);border-radius:12px;background:var(--surface);color:var(--text);
+  padding:0;box-shadow:var(--shadow-lg);width:min(560px,94vw);max-height:90vh}
+dialog.modal::backdrop{background:rgba(10,12,20,.5)}
+.modal-body{padding:16px;display:flex;flex-direction:column;gap:12px;overflow:auto;max-height:calc(90vh - 70px)}
+.modal h2{margin:0;font-size:16px}
+.modal-foot{display:flex;gap:8px;padding:12px 16px;border-top:1px solid var(--border);align-items:center}
+.modal-foot .spacer{flex:1}
+.field{display:flex;flex-direction:column;gap:4px}
+.field>label,.field>.lbl{font-size:12px;color:var(--muted);font-weight:600}
+.field-row{display:flex;gap:10px}
+.field-row .field{flex:1;min-width:0}
+.title-input{font-size:16px;font-weight:600;width:100%}
+textarea.desc{min-height:110px;resize:vertical;width:100%}
+.chips{display:flex;flex-wrap:wrap;gap:4px;align-items:center;border:1px solid var(--border);border-radius:6px;padding:4px}
+.chips input{border:0;flex:1;min-width:90px;padding:2px 4px}
+.chips input:focus{outline:none}
+.chip{display:inline-flex;gap:4px;align-items:center}
+.chip button{background:none;border:0;color:#fff;cursor:pointer;padding:0;line-height:1}
+.check{display:flex;align-items:center;gap:8px;padding:2px 0}
+.check input[type=text]{flex:1;border-color:transparent;background:transparent}
+.check input[type=text]:hover{border-color:var(--border)}
+.check.done input[type=text]{text-decoration:line-through;color:var(--muted)}
+.progress{height:6px;background:var(--col);border-radius:3px;overflow:hidden}
+.progress>div{height:100%;background:var(--ok)}
+.menu{position:fixed;z-index:100;background:var(--surface);border:1px solid var(--border);border-radius:8px;
+  box-shadow:var(--shadow-lg);padding:4px;min-width:200px}
+.menu button{display:block;width:100%;text-align:left;background:none;border:0;padding:6px 10px;border-radius:5px;cursor:pointer}
+.menu button:hover,.menu button:focus{background:var(--col);outline:none}
+.menu button.danger{color:var(--danger)}
+.menu hr{border:0;border-top:1px solid var(--border);margin:4px 0}
+.toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);background:#222;color:#fff;
+  padding:10px 14px;border-radius:8px;box-shadow:var(--shadow-lg);display:flex;gap:12px;align-items:center;z-index:200}
+.toast button{background:none;border:0;color:#9db0ff;font-weight:700;cursor:pointer}
+.arch-item{display:flex;gap:8px;align-items:center;padding:8px 0;border-bottom:1px solid var(--border)}
+.arch-item .t{flex:1;min-width:0}
+.arch-item .s{font-size:12px;color:var(--muted)}
+.muted{color:var(--muted)}
+kbd{background:var(--col);border:1px solid var(--border);border-radius:4px;padding:0 5px;font-size:12px}
+.help td{padding:3px 12px 3px 0}
+@media (max-width:640px){.col{flex-basis:84vw}.topbar input[type=search]{width:100%;order:10}}
