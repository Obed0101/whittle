+      commit(() => { state.boards = state.boards.filter(b => b.id !== state.active); state.active = state.boards[0].id; }, 'Board deleted');
+    } }
+  ]);
+}
+function mainMenu(anchor) {
+  showMenu(anchor, [
+    { label: 'Archived cards…', fn: showArchive },
+    { label: 'Export backup (JSON)', fn: exportData },
+    { label: 'Import backup…', fn: () => $('#importFile').click() },
+    '-',
+    { label: 'Keyboard shortcuts', fn: showHelp }
+  ]);
+}
+
+/* ---------- card editor ---------- */
+function editCard(id) {
+  const b = board(), found = findCard(b, id); if (!found) return;
+  openCardModal(found.card, found.col.id, false);
+}
