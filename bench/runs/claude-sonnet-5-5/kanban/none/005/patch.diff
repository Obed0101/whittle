+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Kanban</title>
+<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%234f6bed'/%3E%3Crect x='6' y='7' width='5' height='18' rx='1.5' fill='white'/%3E%3Crect x='13.5' y='7' width='5' height='12' rx='1.5' fill='white'/%3E%3Crect x='21' y='7' width='5' height='8' rx='1.5' fill='white'/%3E%3C/svg%3E">
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<header class="topbar">
+  <div class="brand">Kanban</div>
+  <select id="boardSelect" aria-label="Board"></select>
+  <input id="search" type="search" placeholder="Search cards  ( / )" aria-label="Search cards" autocomplete="off">
+  <select id="labelFilter" aria-label="Filter by label"></select>
+  <select id="dueFilter" aria-label="Filter by due date">
+    <option value="">Any due date</option>
+    <option value="overdue">Overdue</option>
+    <option value="today">Due today</option>
+    <option value="week">Due within 7 days</option>
+    <option value="none">No due date</option>
+  </select>
+  <button id="clearFilters" class="ghost" hidden>Clear filters</button>
+  <span class="spacer"></span>
+  <button id="undoBtn" class="icon" title="Undo (Ctrl/Cmd+Z)" aria-label="Undo">↶</button>
+  <button id="redoBtn" class="icon" title="Redo (Ctrl/Cmd+Shift+Z)" aria-label="Redo">↷</button>
+  <button id="themeBtn" class="icon" title="Toggle theme" aria-label="Toggle theme">◐</button>
+  <button id="helpBtn" class="icon" title="Help (?)" aria-label="Help">?</button>
+  <button id="boardMenuBtn" class="icon" title="Board menu" aria-label="Board menu">☰</button>
+</header>
+<div id="banner" class="banner" hidden></div>
+<main id="board" aria-label="Board"></main>
+
+<dialog id="cardDialog" aria-label="Card"></dialog>
+
+<dialog id="labelsDialog" aria-label="Labels">
+  <div class="dlg">
+    <h3>Labels</h3>
+    <div id="labelsList"></div>
+    <form id="labelAdd" class="label-row">
+      <input type="text" id="labelNew" placeholder="New label name" maxlength="30" required>
+      <button class="primary">Add label</button>
+    </form>
+    <form method="dialog" class="dlg-actions"><button>Close</button></form>
+  </div>
+</dialog>
+
+<dialog id="archiveDialog" aria-label="Archive">
+  <div class="dlg">
+    <h3>Archive</h3>
+    <div id="archiveList"></div>
+    <form method="dialog" class="dlg-actions">
+      <button type="button" id="emptyArchive" class="danger">Delete all</button>
+      <span class="spacer"></span>
+      <button>Close</button>
+    </form>
+  </div>
+</dialog>
+
+<dialog id="helpDialog" aria-label="Help">
+  <div class="dlg">
+    <h3>Tips &amp; shortcuts</h3>
+    <ul class="help">
+      <li><kbd>n</kbd> add a card to the first column</li>
+      <li><kbd>/</kbd> search &nbsp; <kbd>Esc</kbd> clear / close</li>
+      <li><kbd>Ctrl/⌘</kbd>+<kbd>Z</kbd> undo, <kbd>Shift</kbd> to redo</li>
+      <li>Focus a card (Tab) and press <kbd>Enter</kbd> to open it</li>
+      <li><kbd>Alt</kbd>+<kbd>←</kbd><kbd>→</kbd> move a focused card between columns, <kbd>Alt</kbd>+<kbd>↑</kbd><kbd>↓</kbd> reorder</li>
+      <li>Drag cards between columns; drag a column header to reorder columns</li>
+      <li>Double-click a column title to rename it; use <b>⋯</b> for WIP limit, done-column and more</li>
+      <li>Columns marked <b>done</b> stamp cards as completed and never show them as overdue</li>
+      <li>Everything is saved automatically in this browser. Use ☰ → Export regularly for a backup.</li>
+    </ul>
+    <form method="dialog" class="dlg-actions"><button class="primary">Got it</button></form>
+  </div>
+</dialog>
+
+<div id="toast" class="toast" hidden></div>
+<input type="file" id="importFile" accept="application/json,.json" hidden>
+<script src="app.js"></script>
+</body>
+</html>
