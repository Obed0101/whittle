+:root {
+  --bg: #f1f2f6; --surface: #ffffff; --col: #e6e8ef; --text: #1c2030; --muted: #6a7089;
+  --border: #d5d8e3; --accent: #4f6bed; --accent-text: #fff; --danger: #d63b3b;
+  --warn: #c77700; --ok: #1f8f55; --shadow: 0 1px 2px rgba(20,24,40,.12);
+  --p1: #4f9be8; --p2: #f0a030; --p3: #e5484d;
+  color-scheme: light;
+}
+:root[data-theme="dark"] {
+  --bg: #12141c; --surface: #232734; --col: #1a1d28; --text: #e6e8f2; --muted: #9096ae;
+  --border: #343949; --accent: #6f86ff; --accent-text: #0e1220; --danger: #ff6b6b;
+  --warn: #f2b04a; --ok: #4cc589; --shadow: 0 1px 2px rgba(0,0,0,.5);
+  color-scheme: dark;
+}
+* { box-sizing: border-box; }
+html, body { height: 100%; margin: 0; }
+body {
+  display: flex; flex-direction: column; background: var(--bg); color: var(--text);
+  font: 14px/1.4 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+}
+button, input, select, textarea { font: inherit; color: inherit; }
+button { cursor: pointer; }
+[hidden] { display: none !important; }
+
+.topbar {
+  display: flex; align-items: center; gap: 8px; padding: 8px 14px; flex-wrap: wrap;
+  background: var(--surface); border-bottom: 1px solid var(--border);
+}
+.brand { font-weight: 700; font-size: 16px; margin-right: 4px; }
+.spacer { flex: 1; }
+input[type=text], input[type=search], input[type=date], select, textarea {
+  background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 6px 9px;
+}
+input:focus-visible, select:focus-visible, textarea:focus-visible, button:focus-visible, .card:focus-visible {
+  outline: 2px solid var(--accent); outline-offset: 1px;
+}
+#search { width: 220px; }
+button {
+  background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 6px 12px;
+}
+button:hover:not(:disabled) { background: var(--col); }
+button:disabled { opacity: .4; cursor: default; }
+button.primary { background: var(--accent); color: var(--accent-text); border-color: var(--accent); }
+button.primary:hover:not(:disabled) { filter: brightness(1.08); background: var(--accent); }
+button.danger { color: var(--danger); }
+button.icon, button.ghost { border-color: transparent; background: transparent; }
+button.icon { padding: 5px 9px; font-size: 16px; line-height: 1; }
+button.icon:hover:not(:disabled), button.ghost:hover { background: var(--col); }
+
+.banner { background: #fff3cd; color: #5c4400; padding: 6px 14px; font-size: 13px; }
+:root[data-theme="dark"] .banner { background: #4a3b10; color: #ffe9a8; }
+
+#board {
+  flex: 1; display: flex; align-items: flex-start; gap: 12px; padding: 14px;
+  overflow-x: auto; overflow-y: hidden;
+}
+.column {
+  flex: 0 0 292px; max-height: 100%; display: flex; flex-direction: column;
+  background: var(--col); border-radius: 10px; border: 2px solid transparent;
+}
+.column.over { border-color: var(--accent); }
+.column.dragging { opacity: .45; }
+.col-head { display: flex; align-items: center; gap: 6px; padding: 9px 8px 6px 12px; cursor: grab; }
+.col-head h2 { margin: 0; font-size: 14px; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.donemark { color: var(--ok); font-weight: 700; }
+.count { font-size: 12px; color: var(--muted); background: var(--surface); border-radius: 10px; padding: 1px 8px; }
+.count.over { background: var(--danger); color: #fff; }
+.list { flex: 0 1 auto; overflow-y: auto; padding: 2px 8px 4px; min-height: 12px; display: flex; flex-direction: column; gap: 7px; }
+.empty-hint { color: var(--muted); text-align: center; padding: 10px 0; font-size: 13px; }
+.add-card { padding: 6px 8px 9px; }
+.add-card input, .addcol input { width: 100%; background: transparent; border: 1px dashed var(--border); }
+.add-card input:focus, .addcol input:focus { background: var(--surface); border-style: solid; }
+
+.card {
+  background: var(--surface); border-radius: 7px; padding: 8px 10px; box-shadow: var(--shadow);
+  border-left: 4px solid transparent; cursor: pointer; display: flex; flex-direction: column; gap: 5px;
+  overflow-wrap: anywhere;
+}
+.card:hover { box-shadow: 0 2px 6px rgba(20,24,40,.22); }
+.card.p1 { border-left-color: var(--p1); }
+.card.p2 { border-left-color: var(--p2); }
+.card.p3 { border-left-color: var(--p3); }
+.card.dragging { opacity: .35; }
+.card.finished .title { text-decoration: line-through; color: var(--muted); }
+.card .title { font-weight: 500; white-space: pre-wrap; }
+.chips, .badges { display: flex; flex-wrap: wrap; gap: 4px 6px; align-items: center; }
+.chip { font-size: 11px; display: inline-flex; align-items: center; gap: 4px; color: var(--muted); }
+.dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; flex: none; }
+.badge { font-size: 12px; color: var(--muted); padding: 0 6px; border-radius: 4px; background: var(--col); }
+.badge.overdue { background: var(--danger); color: #fff; }
+.badge.soon { color: var(--warn); }
+.badge.complete { color: var(--ok); }
+.drop-ind { height: 38px; border: 2px dashed var(--accent); border-radius: 7px; pointer-events: none; flex: none; }
+.addcol { flex: 0 0 292px; }
+
+dialog { border: 1px solid var(--border); border-radius: 12px; background: var(--surface); color: var(--text); padding: 0; max-width: 94vw; }
+dialog::backdrop { background: rgba(10,12,20,.5); }
+.dlg { padding: 18px 20px; width: 480px; max-width: 100%; }
+.dlg h3 { margin: 0 0 12px; }
+.dlg-actions { display: flex; gap: 8px; margin-top: 14px; align-items: center; }
+.help { padding-left: 18px; line-height: 1.8; margin: 0; }
+kbd { background: var(--col); border: 1px solid var(--border); border-radius: 4px; padding: 0 5px; font-size: 12px; }
+.label-row { display: flex; gap: 8px; align-items: center; margin-bottom: 8px; }
+.label-row input[type=text] { flex: 1; }
+.label-row input[type=color] { width: 36px; height: 30px; padding: 0; border: 1px solid var(--border); border-radius: 6px; background: none; }
+.arch-row { display: flex; gap: 8px; align-items: center; padding: 6px 0; border-bottom: 1px solid var(--border); }
+.arch-row .t { flex: 1; overflow-wrap: anywhere; }
+.arch-row small { color: var(--muted); display: block; }
+.muted { color: var(--muted); }
+
+.card-form { padding: 18px 20px; width: 580px; max-width: 100%; display: flex; flex-direction: column; gap: 12px; max-height: 92vh; overflow-y: auto; }
+.card-form .title-input { font-size: 18px; font-weight: 600; width: 100%; }
+.card-form textarea { width: 100%; min-height: 110px; resize: vertical; }
+.card-form .row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
+.card-form label.f { display: flex; flex-direction: column; gap: 3px; font-size: 12px; color: var(--muted); }
+.card-form label.f select, .card-form label.f input { color: var(--text); font-size: 14px; }
+.card-form h4 { margin: 0 0 4px; font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
+.toggle-labels { display: flex; flex-wrap: wrap; gap: 6px; }
+.toggle-labels button { border-radius: 14px; padding: 2px 10px; display: inline-flex; align-items: center; gap: 5px; font-size: 13px; }
+.toggle-labels button[aria-pressed=true] { background: var(--col); border-color: var(--accent); font-weight: 600; }
+.cl-item { display: flex; gap: 8px; align-items: center; margin-bottom: 4px; }
+.cl-item input[type=text] { flex: 1; }
+.cl-item input.done { text-decoration: line-through; color: var(--muted); }
+.cl-progress { height: 5px; border-radius: 3px; background: var(--col); margin-bottom: 6px; overflow: hidden; }
+.cl-progress > div { height: 100%; background: var(--ok); }
+.card-form .foot { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
+.meta { font-size: 12px; color: var(--muted); }
+
+.menu {
+  position: fixed; z-index: 50; background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
+  box-shadow: 0 6px 20px rgba(0,0,0,.25); padding: 4px; min-width: 190px; display: flex; flex-direction: column;
+}
+.menu hr { border: 0; border-top: 1px solid var(--border); margin: 4px 0; width: 100%; }
+.menu-item { text-align: left; border: 0; background: transparent; padding: 6px 10px; border-radius: 5px; }
+.menu-item.danger { color: var(--danger); }
+
+.toast {
+  position: fixed; left: 50%; bottom: 22px; transform: translateX(-50%); z-index: 60;
+  background: #20243a; color: #fff; padding: 9px 14px; border-radius: 8px; display: flex; gap: 12px; align-items: center;
+  box-shadow: 0 6px 20px rgba(0,0,0,.35);
+}
+.toast button { background: transparent; color: #9db0ff; border: 0; padding: 0; font-weight: 600; }
+
+@media (max-width: 640px) {
+  #search { width: 100%; order: 5; }
+  .column, .addcol { flex-basis: 84vw; }
+  .card-form .row { grid-template-columns: 1fr; }
+}
+@media print { .topbar, .add-card, .toast { display: none; } #board { overflow: visible; flex-wrap: wrap; } }
