@@ -0,0 +1,33 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Kanban</title>
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<header>
+  <select id="boards" aria-label="Board"></select>
+  <button id="new-board" title="New board">+ Board</button>
+  <button id="rename-board" title="Rename board">Rename</button>
+  <button id="delete-board" title="Delete board">Delete</button>
+  <span class="grow"></span>
+  <input id="search" type="search" placeholder="Search ( / )" aria-label="Search cards">
+  <select id="tag-filter" aria-label="Filter by tag"></select>
+  <button id="undo" title="Undo (Ctrl+Z)">Undo</button>
+  <button id="redo" title="Redo (Ctrl+Shift+Z)">Redo</button>
+  <button id="archive" title="Archived cards">Archive</button>
+  <button id="export" title="Download a backup">Export</button>
+  <button id="import" title="Restore from a backup">Import</button>
+  <button id="theme" title="Theme"></button>
+  <input id="file" type="file" accept="application/json,.json" hidden>
+</header>
+<div id="banner" role="alert" hidden></div>
+<main id="board" aria-label="Board columns"></main>
+<dialog id="dlg" aria-labelledby="dlg-title"></dialog>
+<div id="toast" role="status" aria-live="polite" hidden></div>
+<noscript><p style="padding:1rem">This app needs JavaScript.</p></noscript>
+<script src="app.js"></script>
+</body>
+</html>
diff --git a/board/style.css b/board/style.css
new file mode 100644
index 0000000..1c2a8fc
--- /dev/null
+++ b/board/style.css
@@ -0,0 +1,59 @@
+:root{--bg:#f1f2f6;--panel:#e3e5ec;--card:#fff;--text:#1d2030;--muted:#5d6379;--line:#c9cdda;--accent:#3b5bdb;--accent-text:#fff;--danger:#c92a2a;--warn:#e67700;--tag-bg:88%;--tag-fg:20%;color-scheme:light}
+@media (prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#14161d;--panel:#1d2029;--card:#272b37;--text:#e8eaf2;--muted:#a0a6bc;--line:#3a4052;--accent:#7c93ff;--accent-text:#10131c;--danger:#ff8787;--warn:#ffa94d;--tag-bg:26%;--tag-fg:88%;color-scheme:dark}}
+:root[data-theme=dark]{--bg:#14161d;--panel:#1d2029;--card:#272b37;--text:#e8eaf2;--muted:#a0a6bc;--line:#3a4052;--accent:#7c93ff;--accent-text:#10131c;--danger:#ff8787;--warn:#ffa94d;--tag-bg:26%;--tag-fg:88%;color-scheme:dark}
+*{box-sizing:border-box}
+body{margin:0;height:100vh;height:100dvh;display:flex;flex-direction:column;background:var(--bg);color:var(--text);font:15px/1.4 system-ui,-apple-system,Segoe UI,sans-serif}
+header{display:flex;flex-wrap:wrap;gap:.5rem;padding:.6rem .8rem;border-bottom:1px solid var(--line);align-items:center}
+.grow{flex:1}
+button,select,input,textarea{font:inherit;color:inherit}
+button,select,input,textarea{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:.35rem .6rem}
+button{cursor:pointer}
+button:hover:not(:disabled){border-color:var(--accent)}
+button:disabled{opacity:.45;cursor:default}
+button.primary{background:var(--accent);color:var(--accent-text);border-color:var(--accent)}
+button.danger{color:var(--danger)}
+:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
+#banner{background:var(--danger);color:#fff;padding:.5rem .8rem}
+#board{flex:1;display:flex;gap:.8rem;padding:.8rem;overflow-x:auto;align-items:flex-start;scroll-snap-type:x proximity}
+.col{flex:0 0 290px;max-height:100%;display:flex;flex-direction:column;background:var(--panel);border-radius:10px;scroll-snap-align:start}
+.col-head{display:flex;align-items:center;gap:.4rem;padding:.6rem .6rem .3rem .8rem}
+.col-head h2{flex:1;margin:0;font-size:1rem;overflow-wrap:anywhere}
+.count{color:var(--muted);font-size:.85rem}
+.count.over{color:var(--warn);font-weight:700}
+.cards{flex:1;overflow-y:auto;padding:.3rem .5rem;min-height:2.5rem;display:flex;flex-direction:column;gap:.5rem}
+.cards.over{outline:2px dashed var(--accent);outline-offset:-4px;border-radius:8px}
+.empty{color:var(--muted);text-align:center;padding:.8rem .4rem;font-size:.9rem}
+.card{background:var(--card);border:1px solid var(--line);border-left:4px solid var(--line);border-radius:8px;padding:.5rem .6rem;cursor:pointer;overflow-wrap:anywhere}
+.card.p1{border-left-color:#4dabf7}.card.p2{border-left-color:var(--warn)}.card.p3{border-left-color:var(--danger)}
+.card.dragging{opacity:.4}
+.card:hover{border-color:var(--accent)}
+.card .t{font-weight:500}
+.meta{display:flex;flex-wrap:wrap;gap:.3rem .6rem;margin-top:.3rem;font-size:.8rem;color:var(--muted)}
+.meta .late{color:var(--danger);font-weight:700}.meta .today{color:var(--warn);font-weight:700}
+.tag{display:inline-block;font-size:.75rem;padding:0 .45rem;border-radius:99px;margin:0 .25rem .25rem 0;background:hsl(var(--h) 70% var(--tag-bg));color:hsl(var(--h) 60% var(--tag-fg))}
+.drop-line{height:3px;background:var(--accent);border-radius:2px;flex:none}
+.add{padding:.4rem .5rem .5rem}
+.add input{width:100%}
+.add-col{flex:0 0 290px}
+.add-col input{width:100%}
+.board-empty{margin:auto;text-align:center;color:var(--muted)}
+dialog{width:min(560px,94vw);max-height:92vh;overflow:auto;background:var(--bg);color:var(--text);border:1px solid var(--line);border-radius:12px;padding:1rem 1.2rem}
+dialog::backdrop{background:rgba(0,0,0,.5)}
+dialog h2{margin:0 0 .6rem;font-size:1.1rem}
+dialog label{display:block;margin:.6rem 0 0;font-size:.85rem;color:var(--muted)}
+dialog label>input,dialog label>textarea,dialog label>select{display:block;width:100%;margin-top:.2rem;color:var(--text)}
+dialog textarea{min-height:6rem;resize:vertical}
+.row{display:flex;gap:.6rem}.row>*{flex:1}
+.actions{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1rem}
+.check{display:flex;gap:.5rem;align-items:center;margin-top:.3rem}
+.check input[type=text]{flex:1}
+.check input[type=checkbox]{width:1.1rem;height:1.1rem}
+.arch{display:flex;gap:.5rem;align-items:center;padding:.4rem 0;border-bottom:1px solid var(--line)}
+.arch span{flex:1;overflow-wrap:anywhere}
+#toast{position:fixed;left:50%;bottom:1rem;transform:translateX(-50%);background:var(--text);color:var(--bg);padding:.5rem .9rem;border-radius:8px;display:flex;gap:.8rem;align-items:center;z-index:10;max-width:94vw}
+#toast button{background:transparent;color:inherit;border-color:currentColor}
+@media (max-width:600px){
+  header{gap:.35rem}#search{flex:1 1 100%;order:9}
+  .col,.add-col{flex-basis:85vw}
+}
+@media (prefers-reduced-motion:no-preference){.card{transition:border-color .15s,opacity .15s}#board{scroll-behavior:smooth}}
