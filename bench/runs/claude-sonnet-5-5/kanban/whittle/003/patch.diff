+document.addEventListener('keydown', e => {
+  const tag = e.target.tagName, typing = /INPUT|TEXTAREA|SELECT/.test(tag) || e.target.isContentEditable;
+  if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z' && !typing) { e.preventDefault(); e.shiftKey ? redo() : undo(); }
+  else if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'y' && !typing) { e.preventDefault(); redo(); }
+  else if (e.key === 'Escape' && e.target.id === 'search') { e.target.value = ''; filter.q = ''; render(); }
+  else if (typing || e.ctrlKey || e.metaKey || e.altKey || document.querySelector('dialog[open]')) return;
+  else if (e.key === '/') { e.preventDefault(); $('search').focus(); }
+  else if (e.key === '?') $('help').click();
+  else if (e.key === 'n' && board().columns.length) { e.preventDefault(); openCard(null, board().columns[0].id); }
+});
+window.addEventListener('storage', e => { if (e.key === KEY && e.newValue && !drag) { try { state = migrate(JSON.parse(e.newValue)); render(); } catch (_) {} } });
+
+save(); render();
+})();
diff --git a/board/index.html b/board/index.html
new file mode 100644
index 0000000..63e4dc7
--- /dev/null
+++ b/board/index.html
@@ -0,0 +1,98 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Kanban</title>
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<header class="top">
+  <div class="boards">
+    <label class="sr" for="boardSel">Board</label>
+    <select id="boardSel"></select>
+    <button id="boardNew" title="New board" aria-label="New board">＋</button>
+    <button id="boardRename" title="Rename board" aria-label="Rename board">✎</button>
+    <button id="boardDel" title="Delete board" aria-label="Delete board">🗑</button>
+  </div>
+  <div class="filters">
+    <input id="search" type="search" placeholder="Search cards ( / )" aria-label="Search cards">
+    <select id="labelFilter" aria-label="Filter by label"></select>
+  </div>
+  <div class="tools">
+    <button id="undo" title="Undo (Ctrl+Z)">↶ Undo</button>
+    <button id="redo" title="Redo (Ctrl+Shift+Z)">↷ Redo</button>
+    <button id="archiveBtn">Archive</button>
+    <button id="export">Export</button>
+    <button id="import">Import</button>
+    <button id="theme" title="Theme">Theme</button>
+    <button id="help" title="Shortcuts (?)" aria-label="Help">?</button>
+    <input id="file" type="file" accept="application/json,.json" hidden>
+  </div>
+</header>
+
+<main id="board" class="board" aria-label="Board"></main>
+<div id="live" class="sr" aria-live="polite"></div>
+<div id="toast" class="toast" role="status" hidden></div>
+
+<dialog id="cardDlg" aria-labelledby="cardDlgTitle">
+  <form id="cardForm">
+    <h2 id="cardDlgTitle">Card</h2>
+    <label>Title <input id="cTitle" required maxlength="200"></label>
+    <label>Description <textarea id="cDesc" rows="4"></textarea></label>
+    <div class="row">
+      <label>Column <select id="cCol"></select></label>
+      <label>Due date <input id="cDue" type="date"></label>
+      <label>Priority
+        <select id="cPri"><option value="">None</option><option value="low">Low</option><option value="med">Medium</option><option value="high">High</option></select>
+      </label>
+    </div>
+    <label>Labels (comma separated) <input id="cLabels" list="labelList"></label>
+    <datalist id="labelList"></datalist>
+    <fieldset>
+      <legend>Checklist</legend>
+      <ul id="cChecks" class="checks"></ul>
+      <div class="row"><input id="cNewCheck" placeholder="Add an item and press Enter" aria-label="New checklist item"><button type="button" id="cAddCheck">Add</button></div>
+    </fieldset>
+    <p id="cMeta" class="muted"></p>
+    <div class="actions">
+      <button type="button" id="cDelete" class="danger">Delete</button>
+      <button type="button" id="cArchive">Archive</button>
+      <span class="grow"></span>
+      <button type="button" id="cCancel">Cancel</button>
+      <button type="submit" class="primary">Save</button>
+    </div>
+  </form>
+</dialog>
+
+<dialog id="askDlg" aria-labelledby="askTitle">
+  <form method="dialog" id="askForm">
+    <h2 id="askTitle"></h2>
+    <input id="askInput" required maxlength="100" aria-labelledby="askTitle">
+    <div class="actions"><span class="grow"></span><button type="button" id="askCancel">Cancel</button><button class="primary" type="submit">OK</button></div>
+  </form>
+</dialog>
+
+<dialog id="archiveDlg" aria-labelledby="archTitle">
+  <h2 id="archTitle">Archive</h2>
+  <ul id="archList" class="archive"></ul>
+  <div class="actions"><span class="grow"></span><button id="archClose">Close</button></div>
+</dialog>
+
+<dialog id="helpDlg" aria-labelledby="helpTitle">
+  <h2 id="helpTitle">Keyboard &amp; tips</h2>
+  <ul class="help">
+    <li><kbd>n</kbd> new card in the first column</li>
+    <li><kbd>/</kbd> search · <kbd>Esc</kbd> clears search</li>
+    <li><kbd>Ctrl/⌘ Z</kbd> undo · <kbd>Ctrl/⌘ Shift Z</kbd> redo</li>
+    <li>On a focused card: <kbd>Enter</kbd> edit · <kbd>Delete</kbd> delete · <kbd>Alt ←/→</kbd> move to another column · <kbd>Alt ↑/↓</kbd> reorder</li>
+    <li>Drag cards with mouse; on touch, press and hold, then drag.</li>
+    <li>Drag-and-drop is paused while a search or label filter is active.</li>
+    <li>Data is saved in this browser. Use Export for backups.</li>
+  </ul>
+  <div class="actions"><span class="grow"></span><button id="helpClose">Close</button></div>
+</dialog>
+
+<script src="app.js"></script>
+</body>
+</html>
diff --git a/board/style.css b/board/style.css
new file mode 100644
index 0000000..5d3075f
--- /dev/null
+++ b/board/style.css
@@ -0,0 +1,81 @@
+:root{--bg:#f1f2f6;--panel:#e4e6ee;--card:#fff;--text:#1b1d27;--muted:#666b7d;--line:#cfd2de;--accent:#3b6df0;--danger:#d33a3a;--warn:#c47a00;color-scheme:light}
+:root[data-theme=dark]{--bg:#14161d;--panel:#1d2029;--card:#272b37;--text:#e8eaf2;--muted:#9aa0b4;--line:#383d4d;--accent:#6c93ff;--danger:#ff6b6b;--warn:#f0b04a;color-scheme:dark}
+@media(prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#14161d;--panel:#1d2029;--card:#272b37;--text:#e8eaf2;--muted:#9aa0b4;--line:#383d4d;--accent:#6c93ff;--danger:#ff6b6b;--warn:#f0b04a;color-scheme:dark}}
+*{box-sizing:border-box}
+html,body{height:100%;margin:0}
+body{display:flex;flex-direction:column;background:var(--bg);color:var(--text);font:15px/1.4 system-ui,sans-serif}
+button,input,select,textarea{font:inherit;color:inherit}
+button,select,input,textarea{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:6px 10px}
+button{cursor:pointer}
+button:hover:not(:disabled){border-color:var(--accent)}
+button:disabled{opacity:.4;cursor:default}
+button.primary{background:var(--accent);border-color:var(--accent);color:#fff}
+button.danger{color:var(--danger)}
+:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
+.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
+.muted{color:var(--muted);font-size:13px}
+.top{display:flex;flex-wrap:wrap;gap:10px;align-items:center;padding:10px 14px;border-bottom:1px solid var(--line);background:var(--panel)}
+.boards,.filters,.tools{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
+.filters{flex:1;min-width:200px}
+.filters input{flex:1;min-width:120px}
+.board{flex:1;display:flex;gap:12px;padding:14px;overflow-x:auto;align-items:flex-start}
+.col{flex:0 0 290px;max-height:100%;display:flex;flex-direction:column;background:var(--panel);border-radius:10px;border:1px solid var(--line)}
+.col-head{display:flex;align-items:center;gap:4px;padding:8px}
+.col-head input.title{flex:1;min-width:0;font-weight:600;background:transparent;border-color:transparent}
+.col-head input.title:hover,.col-head input.title:focus{border-color:var(--line);background:var(--card)}
+.count{color:var(--muted);font-size:13px;min-width:1.5em;text-align:center}
+.col-head button{padding:2px 7px;background:transparent;border-color:transparent;color:var(--muted)}
+.cards{list-style:none;margin:0;padding:4px 8px;overflow-y:auto;flex:1;min-height:30px;display:flex;flex-direction:column;gap:8px}
+.card{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:8px 10px;cursor:grab;touch-action:manipulation;user-select:none;-webkit-user-select:none;word-break:break-word}
+.card:hover{border-color:var(--accent)}
+.card .t{font-weight:500}
+.card .d{color:var(--muted);font-size:13px;white-space:pre-wrap;max-height:3.9em;overflow:hidden}
+.badges{display:flex;flex-wrap:wrap;gap:4px;margin-top:6px;font-size:12px;align-items:center}
+.badge{padding:1px 6px;border-radius:10px;border:1px solid var(--line);color:var(--muted)}
+.badge.over{color:var(--danger);border-color:var(--danger)}
+.badge.soon{color:var(--warn);border-color:var(--warn)}
+.badge.done{color:#2f9e5b;border-color:#2f9e5b}
+.badge.high{color:var(--danger);border-color:var(--danger)}
+.badge.med{color:var(--warn);border-color:var(--warn)}
+.label{padding:1px 7px;border-radius:10px;color:#fff;font-size:12px}
+.card.ph{opacity:.4;border-style:dashed;min-height:36px}
+.card.ghost{position:fixed;z-index:50;pointer-events:none;box-shadow:0 8px 24px #0006;transform:rotate(2deg);margin:0}
+.empty{color:var(--muted);text-align:center;padding:10px;font-size:13px}
+.add{margin:8px;text-align:left;background:transparent;border-style:dashed;color:var(--muted)}
+.addform{padding:0 8px 8px;display:flex;flex-direction:column;gap:6px}
+.addform .row{display:flex;gap:6px}
+.addform textarea{resize:vertical}
+.newcol{flex:0 0 290px}
+.big-empty{margin:auto;text-align:center;color:var(--muted)}
+.toast{position:fixed;left:50%;bottom:18px;transform:translateX(-50%);background:var(--text);color:var(--bg);padding:8px 14px;border-radius:8px;display:flex;gap:12px;align-items:center;z-index:100;max-width:90vw}
+.toast[hidden]{display:none}
+.toast button{background:transparent;color:inherit;border-color:currentColor}
+dialog{background:var(--panel);color:var(--text);border:1px solid var(--line);border-radius:12px;width:min(560px,94vw);padding:18px}
+dialog::backdrop{background:#0008}
+dialog h2{margin:0 0 10px;font-size:18px}
+dialog label{display:flex;flex-direction:column;gap:3px;margin-bottom:10px;font-size:13px;color:var(--muted)}
+dialog label input,dialog label textarea,dialog label select,#askInput{color:var(--text);font-size:15px}
+#askInput{width:100%}
+dialog .row{display:flex;gap:10px;flex-wrap:wrap}
+dialog .row>label{flex:1;min-width:120px}
+fieldset{border:1px solid var(--line);border-radius:8px;margin:0 0 10px}
+.row input#cNewCheck{flex:1}
+.checks{list-style:none;margin:0 0 8px;padding:0}
+.checks li{display:flex;gap:8px;align-items:center;padding:2px 0}
+.checks li input[type=text]{flex:1}
+.checks .done{text-decoration:line-through;color:var(--muted)}
+.actions{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}
+.grow{flex:1}
+.archive{list-style:none;padding:0;margin:0;max-height:50vh;overflow:auto}
+.archive li{display:flex;gap:8px;align-items:center;padding:6px 0;border-bottom:1px solid var(--line)}
+.archive li span{flex:1;word-break:break-word}
+.help{padding-left:18px}
+.help li{margin-bottom:6px}
+kbd{border:1px solid var(--line);border-bottom-width:2px;border-radius:4px;padding:0 5px;background:var(--card);font-size:12px}
+@media(max-width:640px){
+  .board{scroll-snap-type:x mandatory;padding:10px}
+  .col,.newcol{flex-basis:calc(100vw - 40px);scroll-snap-align:center}
+  .tools button{padding:6px 8px}
+}
+@media(prefers-reduced-motion:no-preference){.card,button{transition:border-color .15s}.board{scroll-behavior:smooth}}
+@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}.card.ghost{transform:none}}
