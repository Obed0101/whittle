+    d.showModal(); i.select();
+  });
+}
+document.querySelectorAll('dialog').forEach(d => d.addEventListener('click', e => { if (e.target === d && d.id !== 'cardDlg') d.close(); }));
+$('helpClose').onclick = () => $('helpDlg').close();
+$('help').onclick = () => $('helpDlg').showModal();
+$('archClose').onclick = () => $('archiveDlg').close();
+
+let draft, editing; // editing: {id|null, colId}
+function openCard(cardId, colId) {
+  const f = cardId && find(cardId);
+  editing = { id: cardId || null, colId: f ? f.col.id : colId };
+  draft = f ? JSON.parse(JSON.stringify(f.card)) : newCard();
+  $('cardDlgTitle').textContent = f ? 'Edit card' : 'New card';
+  $('cTitle').value = draft.title; $('cDesc').value = draft.desc; $('cDue').value = draft.due;
+  $('cPri').value = draft.priority; $('cLabels').value = draft.labels.join(', ');
