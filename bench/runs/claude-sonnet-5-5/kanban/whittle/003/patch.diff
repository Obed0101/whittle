+  for (const k in attrs || {}) {
+    const v = attrs[k];
+    if (k.startsWith('on')) e.addEventListener(k.slice(2), v);
+    else if (k === 'class') e.className = v;
+    else if (v !== false && v != null) e.setAttribute(k, v === true ? '' : v);
+  }
+  for (const c of kids.flat()) if (c != null && c !== false) e.append(c);
+  return e;
+}
+
+/* ---------- state ---------- */
+const newCard = (o = {}) => ({ id: uid(), title: '', desc: '', labels: [], due: '', priority: '', checklist: [], created: Date.now(), updated: Date.now(), ...o });
+const newBoard = name => ({ id: uid(), name, columns: ['To do', 'Doing', 'Done'].map(t => ({ id: uid(), title: t, cards: [] })), archive: [] });
+
+function migrate(s) {
+  if (!s || !Array.isArray(s.boards)) throw new Error('Not a kanban export');
+  // future versions: upgrade s.version step by step here
+  s.version = VERSION;
+  s.theme = ['auto', 'light', 'dark'].includes(s.theme) ? s.theme : 'auto';
+  s.boards = s.boards.map(b => ({
+    id: b.id || uid(), name: String(b.name || 'Board'), archive: (b.archive || []).map(c => newCard(c)),
+    columns: (b.columns || []).map(c => ({ id: c.id || uid(), title: String(c.title || ''), cards: (c.cards || []).map(x => newCard(x)) }))
+  }));
+  if (!s.boards.length) s.boards.push(newBoard('My board'));
+  if (!s.boards.some(b => b.id === s.active)) s.active = s.boards[0].id;
+  return s;
+}
+
+function load() {
+  let raw = null;
+  try { raw = localStorage.getItem(KEY); } catch (e) { /* storage blocked */ }
+  if (raw) {
+    try { return migrate(JSON.parse(raw)); }
+    catch (e) {
+      try { localStorage.setItem(KEY + '.corrupt', raw); } catch (_) {}
+      setTimeout(() => toast('Saved data was unreadable; a copy was kept and a new board started.'), 0);
+    }
+  }
+  const b = newBoard('My board');
+  b.columns[0].cards.push(newCard({ title: 'Welcome! Click a card to edit it', desc: 'Drag cards between columns. Press ? for shortcuts.' }));
+  return { version: VERSION, theme: 'auto', active: b.id, boards: [b] };
+}
+
+let state = load();
+let undoStack = [], redoStack = [];
+let filter = { q: '', label: '' };
+
+function save() {
+  try { localStorage.setItem(KEY, JSON.stringify(state)); }
+  catch (e) { toast('Could not save (storage full or blocked). Use Export to keep your data.'); }
+}
+const board = () => state.boards.find(b => b.id === state.active);
+function commit(fn, msg) {
+  undoStack.push(JSON.stringify(state)); if (undoStack.length > 100) undoStack.shift();
+  redoStack = [];
+  fn(); save(); render();
+  if (msg) toast(msg, 'Undo', undo);
+}
+function restore(json) { state = migrate(JSON.parse(json)); save(); render(); }
+function undo() { if (!undoStack.length) return; redoStack.push(JSON.stringify(state)); restore(undoStack.pop()); say('Undone'); }
+function redo() { if (!redoStack.length) return; undoStack.push(JSON.stringify(state)); restore(redoStack.pop()); say('Redone'); }
+function say(m) { $('live').textContent = ''; setTimeout(() => $('live').textContent = m, 20); }
+
+let toastTimer;
+function toast(msg, label, fn) {
+  const t = $('toast'); t.replaceChildren(h('span', {}, msg));
+  if (label) t.append(h('button', { onclick: () => { t.hidden = true; fn(); } }, label));
+  t.hidden = false; clearTimeout(toastTimer); toastTimer = setTimeout(() => t.hidden = true, 6000);
+}
+
+/* ---------- helpers ---------- */
+function find(cardId) {
+  for (const col of board().columns) { const i = col.cards.findIndex(c => c.id === cardId); if (i >= 0) return { col, i, card: col.cards[i] }; }
+}
+function moveCard(cardId, toCol, index) {
+  const f = find(cardId); if (!f) return;
+  f.col.cards.splice(f.i, 1);
+  const dest = board().columns.find(c => c.id === toCol);
+  dest.cards.splice(Math.max(0, Math.min(index, dest.cards.length)), 0, f.card);
+}
+const labelColor = l => { let n = 0; for (const ch of l) n = (n * 31 + ch.charCodeAt(0)) % 360; return `hsl(${n} 55% 40%)`; };
