+}
+$('archiveBtn').onclick = showArchive;
+
+/* ---------- rendering ---------- */
+function cardEl(c, col) {
+  const over = c.due && c.due < today(), soon = c.due === today();
+  const done = c.checklist.filter(i => i.done).length;
+  return h('li', { class: 'card', tabindex: 0, 'data-id': c.id, 'aria-label': c.title + (c.due ? ', due ' + c.due : ''),
+    onclick: () => { if (!dragMoved) openCard(c.id); },
+    onkeydown: e => cardKey(e, c, col), onpointerdown: e => dragStart(e, c.id) },
+    h('div', { class: 't' }, c.title),
+    c.desc && h('div', { class: 'd' }, c.desc),
+    h('div', { class: 'badges' },
+      c.labels.map(l => h('span', { class: 'label', style: 'background:' + labelColor(l) }, l)),
+      c.priority && h('span', { class: 'badge ' + c.priority }, { low: 'Low', med: 'Medium', high: 'High' }[c.priority]),
+      c.due && h('span', { class: 'badge ' + (over ? 'over' : soon ? 'soon' : '') }, (over ? 'Overdue ' : soon ? 'Today ' : '📅 ') + c.due),
+      c.checklist.length > 0 && h('span', { class: 'badge ' + (done === c.checklist.length ? 'done' : '') }, `☑ ${done}/${c.checklist.length}`)));
+}
+
+function cardKey(e, c, col) {
+  if (e.target !== e.currentTarget) return;
+  const b = board(), ci = b.columns.indexOf(col), i = col.cards.indexOf(c);
+  if (e.key === 'Enter') { e.preventDefault(); openCard(c.id); }
