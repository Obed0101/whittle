+function renderChecks() {
+  $('cChecks').replaceChildren(...draft.checklist.map((it, i) => h('li', {},
+    h('input', { type: 'checkbox', 'aria-label': 'Done', checked: it.done, onchange: e => { it.done = e.target.checked; renderChecks(); } }),
+    h('input', { type: 'text', value: it.text, 'aria-label': 'Item', class: it.done ? 'done' : '', oninput: e => it.text = e.target.value }),
+    h('button', { type: 'button', 'aria-label': 'Remove item', onclick: () => { draft.checklist.splice(i, 1); renderChecks(); } }, '✕'))));
+}
+function addCheck() {
+  const v = $('cNewCheck').value.trim(); if (!v) return;
+  draft.checklist.push({ text: v, done: false }); $('cNewCheck').value = ''; renderChecks(); $('cNewCheck').focus();
+}
+$('cAddCheck').onclick = addCheck;
+$('cNewCheck').onkeydown = e => { if (e.key === 'Enter') { e.preventDefault(); addCheck(); } };
+$('cChecks').onkeydown = e => { if (e.key === 'Enter') e.preventDefault(); };
+$('cCancel').onclick = () => $('cardDlg').close();
+$('cardForm').onsubmit = e => {
+  e.preventDefault();
+  const title = $('cTitle').value.trim(); if (!title) return;
