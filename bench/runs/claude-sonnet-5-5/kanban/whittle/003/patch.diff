+      h('button', { onclick: () => { foot.replaceChildren(addBtn); addBtn.focus(); } }, 'Cancel'),
+      h('button', { onclick: () => { openCard(null, col.id); $('cTitle').value = ta.value.trim(); } }, 'Details…'))));
