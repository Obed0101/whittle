+  else if (e.altKey && e.key.startsWith('Arrow')) {
+    e.preventDefault();
+    let to = col.id, idx = i;
+    if (e.key === 'ArrowUp') idx = i - 1; else if (e.key === 'ArrowDown') idx = i + 1;
+    else { const t = b.columns[ci + (e.key === 'ArrowLeft' ? -1 : 1)]; if (!t) return; to = t.id; idx = Math.min(i, t.cards.length); }
+    if (idx < 0 || idx >= (to === col.id ? col.cards.length : Infinity)) return;
+    commit(() => moveCard(c.id, to, idx)); focusCard(c.id);
+    const nf = find(c.id); say(`Moved to ${nf.col.title}, position ${nf.i + 1}`);
