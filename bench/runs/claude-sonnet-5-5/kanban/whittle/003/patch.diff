+};
+$('cDelete').onclick = () => { const id = editing.id; $('cardDlg').close(); deleteCard(id); };
+$('cArchive').onclick = () => { const id = editing.id; $('cardDlg').close(); archiveCard(id); };
+
+function deleteCard(id) { commit(() => { const f = find(id); f.col.cards.splice(f.i, 1); }, 'Card deleted'); }
