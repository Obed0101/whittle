diff --git a/board/style.css b/board/style.css
new file mode 100644
index 0000000..295f1fc
--- /dev/null
+++ b/board/style.css
@@ -0,0 +1,66 @@
+:root{--bg:#f1f2f6;--panel:#e4e6ee;--card:#fff;--fg:#1c2030;--mute:#667;--line:#cfd3e0;--acc:#3b5bdb;--accfg:#fff;--bad:#d6336c;--ok:#2b8a3e;color-scheme:light}
+[data-theme=dark]{--bg:#14161d;--panel:#1d2029;--card:#272b37;--fg:#e8eaf2;--mute:#9aa0b5;--line:#3a3f50;--acc:#7c93ff;--accfg:#10131c;--bad:#ff6b9a;--ok:#69db7c;color-scheme:dark}
+*{box-sizing:border-box}
+html,body{height:100%;margin:0}
+body{display:flex;flex-direction:column;background:var(--bg);color:var(--fg);font:15px/1.4 system-ui,sans-serif}
+button,select,input,textarea{font:inherit;color:inherit;background:var(--card);border:1px solid var(--line);border-radius:6px;padding:6px 10px}
+button{cursor:pointer}
+button:hover{border-color:var(--acc)}
+button.primary{background:var(--acc);color:var(--accfg);border-color:var(--acc)}
+button.danger{color:var(--bad)}
+button:disabled{opacity:.4;cursor:default}
+:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
+.top{display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:10px 14px;border-bottom:1px solid var(--line);background:var(--panel)}
+.top #search{flex:0 1 220px;min-width:0}
+.spacer{flex:1}
+.cols{flex:1;display:flex;gap:12px;padding:14px;overflow-x:auto;align-items:flex-start;scroll-snap-type:x proximity}
+.col{flex:0 0 290px;max-height:100%;display:flex;flex-direction:column;background:var(--panel);border-radius:10px;scroll-snap-align:start}
+.col.over{outline:2px dashed var(--acc)}
+.col-h{display:flex;align-items:center;gap:6px;padding:10px 10px 6px}
+.col-h h2{flex:1;margin:0;font-size:15px;overflow-wrap:anywhere}
+.count{color:var(--mute);font-size:13px}
+.count.full{color:var(--bad);font-weight:600}
+.col-h button{padding:2px 8px;background:none;border:0}
+.cards{display:flex;flex-direction:column;gap:8px;padding:4px 10px;overflow-y:auto;min-height:12px}
+.card{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:8px 10px;cursor:grab;overflow-wrap:anywhere}
+.card:hover{border-color:var(--acc)}
+.card.dragging{opacity:.4}
+.card .t{white-space:pre-wrap}
+.chips{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:4px}
+.chip{font-size:11px;padding:1px 8px;border-radius:99px;color:#fff;font-weight:600}
+.meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px;font-size:12px;color:var(--mute)}
+.meta .late{color:var(--bad);font-weight:600}
+.meta .today{color:var(--ok);font-weight:600}
+.p-high{color:var(--bad)}
+.dropline{height:3px;background:var(--acc);border-radius:2px;flex:none}
+.empty{color:var(--mute);font-size:13px;text-align:center;padding:10px}
+.add{margin:8px 10px 10px;text-align:left;background:none;border-style:dashed;color:var(--mute)}
+.addform{padding:4px 10px 10px;display:flex;flex-direction:column;gap:6px}
+.addform textarea{resize:vertical;min-height:56px}
+.row{display:flex;gap:6px}
+.newcol{flex:0 0 290px;border-style:dashed;background:none;color:var(--mute);padding:12px}
+.boardempty{margin:auto;text-align:center;color:var(--mute)}
+.menu{position:fixed;z-index:20;background:var(--card);border:1px solid var(--line);border-radius:8px;padding:4px;display:flex;flex-direction:column;min-width:180px;box-shadow:0 6px 24px #0004}
+.menu button{border:0;background:none;text-align:left}
+.menu button:hover,.menu button:focus{background:var(--panel)}
+.toast{position:fixed;left:50%;bottom:18px;transform:translateX(-50%);background:var(--fg);color:var(--bg);padding:8px 14px;border-radius:8px;display:flex;gap:12px;align-items:center;z-index:30;max-width:92vw}
+.toast[hidden]{display:none}
+.toast button{background:none;border:0;color:var(--bg);text-decoration:underline;padding:0}
+dialog{background:var(--bg);color:var(--fg);border:1px solid var(--line);border-radius:12px;width:min(560px,94vw);max-height:92vh;padding:16px}
+dialog::backdrop{background:#0008}
+dialog h3{margin:0 0 10px}
+.f{display:flex;flex-direction:column;gap:4px;margin-bottom:10px}
+.f>label,.f>span{font-size:13px;color:var(--mute)}
+.f textarea{min-height:90px;resize:vertical}
+.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
+.lbls{display:flex;flex-wrap:wrap;gap:6px}
+.lbls label{display:flex;gap:4px;align-items:center;cursor:pointer}
+.chk{display:flex;gap:6px;margin-bottom:4px}
+.chk input[type=text]{flex:1}
+.chk .done{text-decoration:line-through;color:var(--mute)}
+.foot{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;margin-top:12px}
+.list{display:flex;flex-direction:column;gap:6px;margin-bottom:10px}
+.list .item{display:flex;gap:6px;align-items:center}
+.list .item span{flex:1;overflow-wrap:anywhere}
+@media(max-width:600px){.col,.newcol{flex-basis:85vw}.grid{grid-template-columns:1fr}.top #search{flex-basis:100%}}
+@media(prefers-reduced-motion:no-preference){.card{transition:border-color .15s,opacity .15s}}
