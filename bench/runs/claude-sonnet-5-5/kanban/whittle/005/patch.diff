diff --git a/board/style.css b/board/style.css
new file mode 100644
index 0000000..eca7d93
--- /dev/null
+++ b/board/style.css
@@ -0,0 +1,100 @@
+:root {
+  --bg: #f3f4f6; --col: #e6e8ec; --card: #fff; --text: #1c1d21; --muted: #62666f;
+  --line: #d3d6dc; --accent: #2f6fed; --accent-text: #fff; --danger: #d03b3b; --warn: #b7791f;
+  color-scheme: light;
+}
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme=light]) {
+    --bg: #14151a; --col: #1e2027; --card: #2a2c35; --text: #e8e9ed; --muted: #9a9ea8;
+    --line: #3a3d48; --accent: #5b8cff; --accent-text: #0b1020; --danger: #ff6b6b; --warn: #e5b04a;
+    color-scheme: dark;
+  }
+}
+:root[data-theme=dark] {
+  --bg: #14151a; --col: #1e2027; --card: #2a2c35; --text: #e8e9ed; --muted: #9a9ea8;
+  --line: #3a3d48; --accent: #5b8cff; --accent-text: #0b1020; --danger: #ff6b6b; --warn: #e5b04a;
+  color-scheme: dark;
+}
+* { box-sizing: border-box; }
+html, body { height: 100%; margin: 0; }
+body { display: flex; flex-direction: column; background: var(--bg); color: var(--text); font: 14px/1.4 system-ui, -apple-system, "Segoe UI", sans-serif; }
+button, input, select, textarea { font: inherit; color: inherit; }
+button, select, input, textarea { background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 5px 9px; }
+button { cursor: pointer; }
+button:hover:not(:disabled) { border-color: var(--accent); }
+button:disabled { opacity: .45; cursor: default; }
+button.primary { background: var(--accent); color: var(--accent-text); border-color: var(--accent); }
+button.danger { color: var(--danger); }
+:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
+.top { display: flex; flex-wrap: wrap; gap: 8px; padding: 10px 12px; border-bottom: 1px solid var(--line); align-items: center; }
+.top #search { flex: 1 1 160px; min-width: 120px; max-width: 320px; }
+#cols { flex: 1; display: flex; gap: 12px; padding: 12px; overflow-x: auto; align-items: flex-start; }
+.column { flex: 0 0 280px; max-height: 100%; display: flex; flex-direction: column; background: var(--col); border-radius: 10px; padding: 8px; }
+.col-head { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; }
+.col-title { flex: 1; min-width: 0; font-weight: 600; background: transparent; border-color: transparent; }
+.col-title:hover, .col-title:focus { background: var(--card); border-color: var(--line); }
+.count { color: var(--muted); font-size: 12px; }
+.count.over { color: var(--danger); font-weight: 700; }
+.menu { position: relative; }
+.menu summary { list-style: none; cursor: pointer; padding: 2px 8px; border-radius: 6px; }
+.menu summary::-webkit-details-marker { display: none; }
+.menu-pop { position: absolute; right: 0; top: 100%; z-index: 5; background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 8px; display: flex; flex-direction: column; gap: 6px; min-width: 190px; box-shadow: 0 6px 20px #0004; }
+.menu-pop label { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
+.menu-pop input[type=number] { width: 70px; }
+.cards { flex: 1; overflow-y: auto; min-height: 44px; display: flex; flex-direction: column; gap: 8px; padding: 2px; }
+.cards .empty { color: var(--muted); text-align: center; padding: 10px; font-size: 13px; }
+.card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; cursor: pointer; box-shadow: 0 1px 2px #0002; overflow-wrap: anywhere; }
+.card:hover { border-color: var(--accent); }
+.card.dragging { opacity: .4; }
+.card.p3 { border-left: 4px solid var(--danger); }
+.card.p2 { border-left: 4px solid var(--warn); }
+.card.p1 { border-left: 4px solid var(--accent); }
+.card-title { white-space: pre-wrap; }
+.meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; font-size: 12px; color: var(--muted); }
+.badge.overdue { color: var(--danger); font-weight: 600; }
+.badge.today { color: var(--warn); font-weight: 600; }
+.chips { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 5px; }
+.chip { font-size: 11px; padding: 1px 7px; border-radius: 10px; border: 0; border-left: 3px solid var(--c); background: color-mix(in srgb, var(--c) 22%, transparent); color: var(--text); }
+button.chip { padding: 3px 9px; border: 1px solid var(--line); border-left: 3px solid var(--c); background: var(--card); }
+button.chip[aria-pressed=true] { background: color-mix(in srgb, var(--c) 35%, var(--card)); border-color: var(--c); font-weight: 600; }
+.drop-line { height: 3px; background: var(--accent); border-radius: 2px; flex: none; }
+.add-btn { margin-top: 6px; text-align: left; background: transparent; border-color: transparent; color: var(--muted); }
+.add-btn:hover { background: var(--card); }
+.add-form { margin-top: 6px; display: flex; flex-direction: column; gap: 6px; }
+.add-form textarea { resize: vertical; min-height: 54px; }
+.row { display: flex; gap: 6px; align-items: center; }
+.add-col { flex: 0 0 280px; display: flex; gap: 6px; }
+.add-col input { flex: 1; min-width: 0; }
+.board-empty { margin: auto; color: var(--muted); text-align: center; }
+dialog { border: 1px solid var(--line); border-radius: 12px; background: var(--bg); color: var(--text); padding: 16px; width: min(560px, 94vw); max-height: 92vh; }
+dialog::backdrop { background: #0007; }
+dialog form, .stack { display: flex; flex-direction: column; gap: 10px; }
+dialog label.f { display: flex; flex-direction: column; gap: 3px; font-size: 12px; color: var(--muted); }
+dialog label.f > input, dialog label.f > textarea, dialog label.f > select { color: var(--text); font-size: 14px; }
+dialog textarea { min-height: 90px; resize: vertical; }
+.grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
+.foot { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
+.foot .sp { flex: 1; }
+.check { display: flex; gap: 6px; align-items: center; }
+.check input[type=text] { flex: 1; min-width: 0; }
+.check input.done { text-decoration: line-through; color: var(--muted); }
+h2 { margin: 0; font-size: 17px; }
+h3 { margin: 8px 0 0; font-size: 13px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
+.arch { display: flex; gap: 6px; align-items: center; }
+.arch span { flex: 1; overflow-wrap: anywhere; }
+.muted { color: var(--muted); }
+#toast { position: fixed; left: 50%; bottom: 18px; transform: translateX(-50%); z-index: 20; background: var(--text); color: var(--bg); padding: 8px 14px; border-radius: 8px; display: flex; gap: 12px; align-items: center; box-shadow: 0 6px 20px #0005; max-width: 92vw; }
+#toast[hidden] { display: none; }
+#toast button { background: transparent; color: inherit; border-color: currentColor; }
+@media (max-width: 700px) {
+  #cols { scroll-snap-type: x mandatory; padding: 8px; gap: 8px; }
+  .column, .add-col { flex-basis: 86vw; scroll-snap-align: center; }
+  .grid3 { grid-template-columns: 1fr; }
+  .top #search { max-width: none; }
+}
+@media (prefers-reduced-motion: no-preference) {
+  .card, button { transition: border-color .15s, background-color .15s; }
+}
+@media (prefers-reduced-motion: reduce) {
+  * { scroll-behavior: auto !important; animation: none !important; transition: none !important; }
+}
