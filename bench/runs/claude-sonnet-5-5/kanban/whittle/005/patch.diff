+    checklist: (Array.isArray(c.checklist) ? c.checklist : []).map(i => ({ id: str(i.id) || uid(), text: str(i.text), done: !!i.done })),
+    created: Number(c.created) || Date.now(),
+    from: str(c.from), archivedAt: Number(c.archivedAt) || 0,
+  };
+}
+function normalize(d) {
+  if (!d || typeof d !== 'object' || !Array.isArray(d.boards) || !d.boards.length) throw new Error('No boards found in this data.');
+  if (d.version > VERSION) throw new Error('This data was saved by a newer version of the app.');
+  const out = { version: VERSION, theme: ['light', 'dark'].includes(d.theme) ? d.theme : 'auto', current: d.current, boards: [] };
+  for (const b of d.boards) {
+    if (!b || !Array.isArray(b.columns)) throw new Error('A board has no columns list.');
+    out.boards.push({
