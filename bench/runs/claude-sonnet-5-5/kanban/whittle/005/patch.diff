+  return {
+    version: VERSION, theme: 'auto', current: null,
+    boards: [{ id: uid(), name: 'My board', archive: [],
+      labels: [lab('Urgent', COLORS[0]), lab('Work', COLORS[4]), lab('Personal', COLORS[3]), lab('Idea', COLORS[5])],
+      columns: [col('To do'), col('Doing'), col('Done')] }],
