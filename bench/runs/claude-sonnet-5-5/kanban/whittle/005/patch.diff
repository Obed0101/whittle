+    h('button', { onclick: () => commit(() => b.labels.push({ id: uid(), name: 'New label', color: COLORS[b.labels.length % COLORS.length] })) }, 'Add label'),
+    h('h3', {}, `Archive (${b.archive.length})`),
+    b.archive.length ? null : h('p', { class: 'muted' }, 'Archived cards appear here.'),
+    ...b.archive.map(c => h('div', { class: 'arch' }, h('span', {}, c.title),
+      h('button', { onclick: () => commit(() => {
+        const a = b.archive.indexOf(c); b.archive.splice(a, 1);
+        const col = b.columns.find(x => x.id === c.from) || b.columns[0];
+        if (col) col.cards.push(c); else b.archive.splice(a, 0, c);
+      }) }, 'Restore'),
+      h('button', { class: 'danger', onclick: () => commit(() => { b.archive.splice(b.archive.indexOf(c), 1); }, 'Card deleted') }, 'Delete'))),
+    h('h3', {}, 'Appearance & data'),
+    h('label', { class: 'row' }, 'Theme ', h('select', { onchange: e => { data.theme = e.target.value; save(); render(); } },
+      ['auto', 'light', 'dark'].map(t => h('option', { value: t, selected: data.theme === t }, t === 'auto' ? 'Match system' : t[0].toUpperCase() + t.slice(1))))),
+    h('div', { class: 'row' }, h('button', { onclick: exportData }, 'Export all boards (JSON)'),
+      h('button', { onclick: () => importInput.click() }, 'Import…'), importInput),
+    h('p', { class: 'muted' }, 'Data is stored only in this browser. Export regularly for a backup. Shortcuts: / search · n new card · Ctrl/Cmd+Z undo · Enter edit card · Alt+arrows move card · Delete delete card.'),
+    h('div', { class: 'foot' }, h('span', { class: 'sp' }), h('button', { class: 'primary', onclick: () => manageDlg.close() }, 'Close'))));
+}
+
+function exportData() {
+  const a = h('a', { href: URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' })), download: `kanban-${todayStr()}.json` });
+  document.body.append(a); a.click(); a.remove();
+  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
+}
+function importFile(file) {
+  if (!file) return;
+  file.text().then(txt => {
+    const d = normalize(JSON.parse(txt));
+    if (!confirm(`Replace all current boards with the ${d.boards.length} board(s) in this file? You can undo this.`)) return;
+    commit(() => { data.boards = d.boards; data.current = d.current; data.theme = d.theme; });
+    toast('Imported', true);
+  }).catch(e => toast('Import failed: ' + e.message));
+}
+
+/* ---------- wiring ---------- */
+$('#boardSel').addEventListener('change', e => { data.current = e.target.value; save(); render(); });
+$('#search').addEventListener('input', e => { filter.q = e.target.value; render(); });
+$('#labelFilter').addEventListener('change', e => { filter.label = e.target.value; render(); });
+$('#undoBtn').addEventListener('click', undo);
+$('#redoBtn').addEventListener('click', redo);
+$('#manageBtn').addEventListener('click', () => { renderManage(); manageDlg.showModal(); });
+document.addEventListener('click', e => {
+  document.querySelectorAll('details.menu[open]').forEach(d => { if (!d.contains(e.target)) d.open = false; });
+});
+document.addEventListener('keydown', e => {
+  const tag = e.target.tagName, typing = tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';
+  const mod = e.ctrlKey || e.metaKey;
+  if (e.key === 'Escape') document.querySelectorAll('details.menu[open]').forEach(d => { d.open = false; });
+  if (typing || cardDlg.open || manageDlg.open) return;
+  if (mod && e.key.toLowerCase() === 'z') { e.preventDefault(); e.shiftKey ? redo() : undo(); }
+  else if (mod && e.key.toLowerCase() === 'y') { e.preventDefault(); redo(); }
+  else if (!mod && !e.altKey && e.key === '/') { e.preventDefault(); $('#search').focus(); }
+  else if (!mod && !e.altKey && e.key === 'n' && board().columns.length) { e.preventDefault(); addingTo = board().columns[0].id; render(); }
+});
+window.addEventListener('storage', e => {
+  if (e.key === KEY && e.newValue) { try { data = normalize(JSON.parse(e.newValue)); history = []; future = []; render(); } catch (err) { /* ignore */ } }
+});
+document.addEventListener('visibilitychange', () => { if (!document.hidden && !cardDlg.open) render(); });
+
+data = load();
+fixCurrent();
+render();
diff --git a/board/index.html b/board/index.html
