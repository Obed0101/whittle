+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Kanban board</title>
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<header class="top">
+  <select id="boardSel" aria-label="Board"></select>
+  <input id="search" type="search" placeholder="Search cards ( / )" aria-label="Search cards">
+  <select id="labelFilter" aria-label="Filter by label"></select>
+  <button id="undoBtn" title="Undo (Ctrl/Cmd+Z)">Undo</button>
+  <button id="redoBtn" title="Redo (Ctrl/Cmd+Shift+Z)">Redo</button>
+  <button id="manageBtn">Board &amp; settings</button>
+</header>
+<main id="cols" aria-label="Columns"></main>
+<dialog id="cardDlg" aria-label="Card"></dialog>
+<dialog id="manageDlg" aria-label="Board and settings"></dialog>
+<div id="toast" role="status" aria-live="polite" hidden></div>
+<script src="app.js"></script>
+</body>
