+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<meta name="color-scheme" content="light dark">
+<title>Kanban</title>
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<header>
+  <select id="boardSel" aria-label="Board"></select>
+  <button id="newBoard" title="New board">+ Board</button>
+  <button id="renBoard" title="Rename board">Rename</button>
+  <button id="delBoard" title="Delete board">Delete</button>
+  <input id="q" type="search" placeholder="Search ( / )" aria-label="Search cards">
+  <select id="fl" aria-label="Filter by label"></select>
+  <span class="grow"></span>
+  <button id="undoBtn" title="Undo (Ctrl+Z)" aria-label="Undo">↶</button>
+  <button id="redoBtn" title="Redo (Ctrl+Shift+Z)" aria-label="Redo">↷</button>
+  <button id="labelsBtn">Labels</button>
+  <button id="archBtn">Archive</button>
+  <button id="expBtn">Export</button>
+  <button id="impBtn">Import</button>
+  <button id="themeBtn" title="Theme"></button>
+  <input id="file" type="file" accept="application/json,.json" hidden>
+</header>
+<main id="board" aria-label="Board columns"></main>
+<p class="hint">Drag cards, or focus one and press Alt+Arrow keys to move it. Enter opens it. Press n to add a card, / to search.</p>
+<div id="toast" role="status" aria-live="polite" hidden></div>
+
+<dialog id="ask">
+  <form method="dialog">
+    <label><span id="askT"></span><input id="askI" min="0"></label>
+    <div class="foot"><button value="cancel" formnovalidate>Cancel</button><button value="ok" class="primary">OK</button></div>
+  </form>
+</dialog>
+<dialog id="cardDlg"><form id="cardForm"></form></dialog>
+<dialog id="labelsDlg"><form id="labelsForm"></form></dialog>
+<dialog id="archDlg"><div id="archBody"></div></dialog>
+<script src="app.js"></script>
+</body>
+</html>
diff --git a/board/style.css b/board/style.css
new file mode 100644
index 0000000..e3564c8
--- /dev/null
+++ b/board/style.css
@@ -0,0 +1,59 @@
+:root{--bg:#f4f5f7;--col:#e6e8ec;--card:#fff;--text:#1d2026;--mute:#667085;--line:#cfd4dc;--accent:#2563eb;--danger:#d92d20;--warn:#b54708;color-scheme:light}
+:root[data-theme=dark]{--bg:#14161a;--col:#1e2127;--card:#272b33;--text:#e8eaee;--mute:#9aa3b2;--line:#3a4049;--accent:#6ea0ff;--danger:#ff7066;--warn:#f5b04a;color-scheme:dark}
+@media (prefers-color-scheme:dark){:root[data-theme=auto]{--bg:#14161a;--col:#1e2127;--card:#272b33;--text:#e8eaee;--mute:#9aa3b2;--line:#3a4049;--accent:#6ea0ff;--danger:#ff7066;--warn:#f5b04a;color-scheme:dark}}
+*{box-sizing:border-box}
+body{margin:0;background:var(--bg);color:var(--text);font:15px/1.4 system-ui,sans-serif;min-height:100vh;display:flex;flex-direction:column}
+button,input,select,textarea{font:inherit;color:inherit}
+button,select,input,textarea{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:5px 9px}
+button{cursor:pointer}button:hover{border-color:var(--accent)}
+button.primary{background:var(--accent);color:#fff;border-color:var(--accent)}
+button.danger{color:var(--danger)}
+button:disabled{opacity:.4;cursor:default}
+:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
+header{display:flex;flex-wrap:wrap;gap:6px;padding:8px 12px;border-bottom:1px solid var(--line);align-items:center}
+.grow{flex:1}
+#q{min-width:140px}
+main{flex:1;display:flex;gap:12px;padding:12px;overflow-x:auto;align-items:flex-start}
+.col{background:var(--col);border-radius:10px;width:290px;flex:none;max-height:calc(100vh - 130px);display:flex;flex-direction:column;padding:8px}
+.col.over{outline:2px dashed var(--accent)}
+.col-h{display:flex;align-items:center;gap:4px;padding:2px 2px 8px}
+.col-h h2{font-size:15px;margin:0;flex:1;overflow-wrap:anywhere}
+.count{color:var(--mute);font-size:13px}.count.full{color:var(--danger);font-weight:600}
+.ic{padding:1px 6px;border:0;background:none;color:var(--mute)}
+.cards{overflow-y:auto;display:flex;flex-direction:column;gap:8px;min-height:30px;padding:2px}
+.card{background:var(--card);border:1px solid var(--line);border-left-width:4px;border-radius:8px;padding:8px 10px;cursor:pointer;overflow-wrap:anywhere}
+.card:hover{border-color:var(--accent)}
+.card.dragging{opacity:.4}
+.card.p-high{border-left-color:var(--danger)}.card.p-med{border-left-color:#f79009}.card.p-low{border-left-color:#3b82f6}
+.chips{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:4px}
+.chip{font-size:11px;color:#fff;border-radius:10px;padding:0 7px}
+.meta{display:flex;flex-wrap:wrap;gap:8px;font-size:12px;color:var(--mute);margin-top:4px}
+.meta .late{color:var(--danger);font-weight:600}.meta .soon{color:var(--warn)}
+.empty{color:var(--mute);font-size:13px;text-align:center;margin:6px 0}
+.drop-line{height:3px;background:var(--accent);border-radius:2px;flex:none}
+.add{margin-top:8px;display:flex;gap:4px;flex-wrap:wrap}
+.add input{flex:1;min-width:0}
+.add-btn{margin-top:8px;border:0;background:none;color:var(--mute);text-align:left}
+.add-col{flex:none;width:290px;border:2px dashed var(--line);background:none;padding:12px}
+.hint{color:var(--mute);font-size:12px;margin:0;padding:6px 12px}
+#toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);background:#222;color:#fff;padding:8px 14px;border-radius:8px;display:flex;gap:12px;align-items:center;z-index:99;max-width:90vw}
+#toast[hidden]{display:none}
+#toast button{background:none;border:0;color:#8ab4ff;font-weight:600}
+dialog{background:var(--bg);color:var(--text);border:1px solid var(--line);border-radius:12px;padding:16px;width:min(560px,94vw);max-height:92vh}
+dialog::backdrop{background:rgba(0,0,0,.45)}
+dialog label,.fld{display:flex;flex-direction:column;gap:3px;margin-bottom:10px;font-size:13px;color:var(--mute)}
+dialog label input,dialog label textarea,dialog label select,.fld input{color:var(--text);font-size:15px}
+.row{display:flex;gap:8px;flex-wrap:wrap}.row>*{flex:1;min-width:120px}
+.foot{display:flex;gap:6px;justify-content:flex-end;flex-wrap:wrap;margin-top:8px}
+.foot .grow{flex:1}
+.lbls{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px}
+.lbls label{flex-direction:row;align-items:center;gap:4px;margin:0;color:var(--text);border:1px solid var(--line);border-radius:12px;padding:1px 8px}
+.ck{display:flex;gap:6px;align-items:center;margin-bottom:4px}.ck input[type=text]{flex:1;min-width:0}
+.ar{display:flex;gap:6px;align-items:center;padding:6px 0;border-bottom:1px solid var(--line)}.ar span{flex:1;overflow-wrap:anywhere}
+input[type=color]{padding:0;width:34px;height:30px}
+@media (max-width:640px){
+ main{scroll-snap-type:x mandatory;padding:8px;gap:8px}
+ .col,.add-col{width:86vw;scroll-snap-align:center;max-height:none}
+ header button,header select{padding:8px 10px}
+}
+@media (prefers-reduced-motion:no-preference){.card,button{transition:border-color .15s}}
