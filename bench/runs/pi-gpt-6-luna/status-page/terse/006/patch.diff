@@ -0,0 +1,152 @@
+"""Render the service status data as a standalone public HTML page."""
+
+import html
+import json
+import re
+import sys
+from datetime import datetime, timezone
+
+
+_STATES = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+_SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _escape(value):
+    return html.escape(str(value), quote=True)
+
+
+def _service_id(name):
+    chars = []
+    for char in str(name).lower():
+        if char.isalnum():
+            chars.append(char)
+        elif not chars or chars[-1] != "-":
+            chars.append("-")
+    return "service-" + "".join(chars).strip("-")
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    """Return a complete, self-contained HTML status page."""
+    for service in services:
+        state = service["state"]
+        if state not in _STATES:
+            raise ValueError(f"unknown state: {state}")
+
+    operational = sum(service["state"] == "operational" for service in services)
+    total = len(services)
+    if total:
+        title = f"Status · {operational} of {total} operational"
+    else:
+        title = "Status · no services"
+
+    counts = {state: sum(item["state"] == state for item in services) for state in _STATES}
+    attention = counts["degraded"] + counts["outage"]
+    maintenance = counts["maintenance"]
+    if counts["outage"]:
+        modifier = "down"
+    elif counts["degraded"]:
+        modifier = "warn"
+    else:
+        modifier = "ok"
+
+    parts = [
+        "<!doctype html>",
+        '<html lang="en">',
+        "<head>",
+        '<meta charset="utf-8">',
+        '<meta name="viewport" content="width=device-width, initial-scale=1">',
+        f"<title>{_escape(title)}</title>",
+        """<style>
+:root {
+  --bg: #f6f8fa;
+  --text: #1f2937;
+  --ok: #16803c;
+  --warn: #a15c00;
+  --down: #c62828;
+  --maint: #5365a5;
+}
+@media (prefers-color-scheme: dark) {
+  :root { --bg: #161b22; --text: #e6edf3; }
+}
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, main, footer { max-width: 640px; margin: 0 auto; }
+h1 { margin-top: 0; }
+.banner { padding: 1rem; border-radius: .5rem; font-weight: 600; }
+.banner--ok { background: color-mix(in srgb, var(--ok) 14%, var(--bg)); }
+.banner--warn { background: color-mix(in srgb, var(--warn) 14%, var(--bg)); }
+.banner--down { background: color-mix(in srgb, var(--down) 14%, var(--bg)); }
+.services { max-width: 640px; margin: 1.5rem auto; padding: 0; list-style: none; }
+.service { display: flex; align-items: flex-start; gap: 1rem; padding: 1rem; border-bottom: 1px solid #8885; }
+.dot { flex: 0 0 .7rem; width: .7rem; height: .7rem; margin-top: .45rem; border-radius: 50%; background: var(--text); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; transform: scale(.8); } }
+@media (prefers-reduced-motion: reduce) { .dot { animation: none !important; } }
+.service-content { flex: 1; min-width: 0; }
+.service h2 { margin: 0; font-size: 1.1rem; }
+.state, .uptime { display: inline-block; margin-top: .35rem; }
+.note { margin: .5rem 0 0; }
+a { color: inherit; }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; }
+.empty { max-width: 640px; margin: 2rem auto; }
+footer { margin-top: 2rem; font-size: .9rem; opacity: .8; }
+@media (max-width: 480px) { .service { flex-direction: column; gap: .5rem; } }
+</style>""",
+        "</head>",
+        "<body>",
+        "<header><h1>System status</h1></header>",
+    ]
+
+    if not services:
+        parts.append('<main><p class="empty">No services configured.</p></main>')
+    else:
+        if attention:
+            word = "needs" if attention == 1 else "need"
+            message = f"{attention} of {total} services {word} attention"
+        else:
+            message = "All systems operational"
+        if maintenance:
+            message += f" · {maintenance} under maintenance"
+        parts.append(f'<div class="banner banner--{modifier}" role="status">{_escape(message)}</div>')
+        parts.append('<main><ul class="services">')
+        for service in sorted(services, key=lambda item: (_SEVERITY[item["state"]], str(item["name"]).casefold())):
+            name = _escape(service["name"])
+            url = service.get("url")
+            if url is not None:
+                safe_url = _escape(url)
+                rel = ' rel="noopener"' if re.match(r"^https?://", str(url), re.I) else ""
+                heading = f'<a href="{safe_url}"{rel}>{name}</a>'
+            else:
+                heading = name
+            parts.append(f'<li class="service" id="{_escape(_service_id(service["name"]))}" data-state="{_escape(service["state"])}"><span class="dot" aria-hidden="true"></span><div class="service-content"><h2>{heading}</h2><span class="state">{_STATES[service["state"]]}</span>')
+            if service.get("note"):
+                parts.append(f'<p class="note">{_escape(service["note"])}</p>')
+            if service.get("uptime") is not None:
+                parts.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            parts.append("</div></li>")
+        parts.append("</ul></main>")
+
+    timestamp = _escape(generated_at)
+    parts.extend([f'<footer><time datetime="{timestamp}">Updated {timestamp}</time></footer>', "</body>", "</html>"])
+    return "\n".join(parts)
+
+
+def main():
+    from .status import load
+
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: python -m app.page services.json")
+    generated_at = datetime.now(timezone.utc).isoformat()
+    print(render(load(sys.argv[1]), generated_at))
+
+
+if __name__ == "__main__":
+    main()
