diff --git a/app/page.py b/app/page.py
new file mode 100644
index 0000000..1dbae68
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,109 @@
+"""Render a self-contained public service status page."""
+import re
+import sys
+from datetime import datetime, timezone
+from html import escape
+from urllib.parse import urlsplit
+
+from app.status import STATES, load
+
+LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    for service in services:
+        if service["state"] not in STATES:
+            raise ValueError(f"unknown state: {service['state']}")
+
+    total = len(services)
+    operational = sum(service["state"] == "operational" for service in services)
+    title = f"Status · {operational} of {total} operational" if total else "Status · no services"
+    ordered = sorted(services, key=lambda s: (SEVERITY[s["state"]], s["name"].casefold()))
+    attention = sum(s["state"] in ("degraded", "outage") for s in services)
+    maintenance = sum(s["state"] == "maintenance" for s in services)
+    if any(s["state"] == "outage" for s in services):
+        modifier = "down"
+    elif any(s["state"] == "degraded" for s in services):
+        modifier = "warn"
+    else:
+        modifier = "ok"
+    if attention:
+        banner = f"{attention} of {total} services need{'s' if attention == 1 else ''} attention"
+    else:
+        banner = "All systems operational"
+    if maintenance:
+        banner += f" · {maintenance} under maintenance"
+
+    items = []
+    for service in ordered:
+        name = escape(str(service["name"]))
+        state = service["state"]
+        slug = re.sub(r"[^\w]+", "-", str(service["name"]).lower(), flags=re.UNICODE).strip("-")
+        url = service.get("url")
+        heading = name
+        if url:
+            safe_url = escape(str(url), quote=True)
+            rel = ' rel="noopener"' if urlsplit(str(url)).scheme.lower() in ("http", "https") else ""
+            heading = f'<a href="{safe_url}"{rel}>{name}</a>'
+        note = f'<p class="note">{escape(str(service["note"]))}</p>' if service.get("note") else ""
+        uptime = f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>' if service.get("uptime") is not None else ""
+        items.append(
+            f'<li class="service" id="service-{escape(slug, quote=True)}" data-state="{escape(state, quote=True)}">'
+            f'<span class="dot" aria-hidden="true"></span><div><h2>{heading}</h2>'
+            f'<span class="state">{LABELS[state]}</span>{note}{uptime}</div></li>'
+        )
+
+    content = (
+        f'<div class="banner banner--{modifier}" role="status">{escape(banner)}</div>'
+        f'<ul class="services">{"".join(items)}</ul>' if total else
+        '<p class="empty">No services configured.</p>'
+    )
+    return f'''<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>{escape(title)}</title>
+<style>
+:root {{ --bg: #fff; --text: #20242a; --ok: #218739; --warn: #a86b00; --down: #c62828; --maint: #5265a3; }}
+@media (prefers-color-scheme: dark) {{ :root {{ --bg: #17191d; --text: #eee; }} }}
+body {{ margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }}
+header, main, footer {{ max-width: 640px; margin: 0 auto; }}
+.banner {{ padding: 1rem; border-radius: .5rem; margin: 1rem 0; }}
+.banner--ok {{ background: color-mix(in srgb, var(--ok) 15%, transparent); }}
+.banner--warn {{ background: color-mix(in srgb, var(--warn) 15%, transparent); }}
+.banner--down {{ background: color-mix(in srgb, var(--down) 15%, transparent); }}
+.services {{ max-width: 640px; margin: 1rem auto; padding: 0; list-style: none; }}
+.service {{ display: flex; align-items: flex-start; gap: .75rem; padding: 1rem; border-bottom: 1px solid #8885; }}
+.service h2 {{ display: inline; margin: 0 .5rem 0 0; font-size: 1.1rem; }}
+.dot {{ width: .7rem; height: .7rem; flex: none; border-radius: 50%; margin-top: .4rem; background: var(--text); }}
+[data-state="operational"] .dot {{ background: var(--ok); }}
+[data-state="degraded"] .dot {{ background: var(--warn); }}
+[data-state="outage"] .dot {{ background: var(--down); animation: pulse 1.5s infinite; }}
+[data-state="maintenance"] .dot {{ background: var(--maint); }}
+.state, .uptime {{ font-size: .9rem; }}
+.note {{ margin: .5rem 0; }}
+.uptime {{ display: block; }}
+a {{ color: inherit; }}
+a:focus-visible {{ outline: 3px solid var(--warn); outline-offset: 3px; }}
+@keyframes pulse {{ 50% {{ opacity: .35; }} }}
+@media (prefers-reduced-motion: reduce) {{ .dot {{ animation: none; }} }}
+@media (max-width: 480px) {{ .service {{ flex-direction: column; }} }}
+</style>
+</head>
+<body>
+<header><h1>System status</h1></header>
+<main>{content}</main>
+<footer><time datetime="{escape(generated_at, quote=True)}">Updated {escape(generated_at)}</time></footer>
+</body>
+</html>'''
+
+
+if __name__ == "__main__":
+    print(render(load(sys.argv[1]), datetime.now(timezone.utc).isoformat()))
