diff --git a/app/page.py b/app/page.py
new file mode 100644
index 0000000..9e6ce70
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,114 @@
+"""Render a self-contained public status page."""
+import html
+import re
+import sys
+from datetime import datetime, timezone
+
+from app.status import load
+
+_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+_SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _e(value):
+    return html.escape(str(value), quote=True)
+
+
+def _id(name):
+    slug = "".join(c.lower() if c.isalnum() else " " for c in name)
+    return "service-" + "-".join(slug.split())
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    for service in services:
+        if service["state"] not in _LABELS:
+            raise ValueError(f"unknown state: {service['state']}")
+
+    total = len(services)
+    operational = sum(s["state"] == "operational" for s in services)
+    if total == 0:
+        title = "Status · no services"
+    else:
+        title = f"Status · {operational} of {total} operational"
+
+    parts = [f'''<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>{_e(title)}</title>
+<style>
+:root {{ --bg: #f5f7fa; --text: #18212f; --ok: #218739; --warn: #a86700; --down: #c62828; --maint: #536b9b; }}
+@media (prefers-color-scheme: dark) {{ :root {{ --bg: #151922; --text: #edf1f7; }} }}
+body {{ margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }}
+header, main, footer {{ max-width: 640px; margin: 0 auto; }}
+h1 {{ margin-top: 0; }}
+.banner {{ padding: 1rem; border-radius: .5rem; margin-bottom: 1rem; }}
+.banner--ok {{ background: color-mix(in srgb, var(--ok) 14%, var(--bg)); }}
+.banner--warn {{ background: color-mix(in srgb, var(--warn) 16%, var(--bg)); }}
+.banner--down {{ background: color-mix(in srgb, var(--down) 16%, var(--bg)); }}
+.services {{ list-style: none; padding: 0; margin: 0 auto; max-width: 640px; }}
+.service {{ display: flex; align-items: center; gap: .75rem; padding: 1rem; border-bottom: 1px solid #8885; }}
+.dot {{ width: .7rem; height: .7rem; flex: 0 0 .7rem; border-radius: 50%; background: var(--ok); }}
+[data-state="operational"] .dot {{ background: var(--ok); }}
+[data-state="degraded"] .dot {{ background: var(--warn); }}
+[data-state="outage"] .dot {{ background: var(--down); animation: pulse 1.5s infinite; }}
+[data-state="maintenance"] .dot {{ background: var(--maint); }}
+@keyframes pulse {{ 50% {{ opacity: .35; }} }}
+@media (prefers-reduced-motion: reduce) {{ .dot {{ animation: none; }} }}
+.service h2 {{ margin: 0; font-size: 1.1rem; }}
+.service p {{ margin: .35rem 0 0; }}
+.state, .uptime {{ margin-left: auto; white-space: nowrap; }}
+a {{ color: inherit; }}
+a:focus-visible {{ outline: 3px solid var(--warn); outline-offset: 3px; }}
+.empty {{ max-width: 640px; margin: auto; }}
+footer {{ margin-top: 2rem; color: #77808c; font-size: .9rem; }}
+@media (max-width: 480px) {{ .service {{ align-items: flex-start; flex-direction: column; }} .state, .uptime {{ margin-left: 0; }} }}
+</style>
+</head>
+<body>
+<header><h1>System status</h1></header>''']
+
+    if services:
+        attention = sum(s["state"] in ("degraded", "outage") for s in services)
+        maintenance = sum(s["state"] == "maintenance" for s in services)
+        if attention:
+            wording = "service needs" if attention == 1 else "services need"
+            message = f"{attention} of {total} {wording} attention"
+        else:
+            message = "All systems operational"
+        if maintenance:
+            message += f" · {maintenance} under maintenance"
+        modifier = "down" if any(s["state"] == "outage" for s in services) else "warn" if any(s["state"] == "degraded" for s in services) else "ok"
+        parts.append(f'<div class="banner banner--{modifier}" role="status">{_e(message)}</div>')
+        parts.append('<main><ul class="services">')
+        for service in sorted(services, key=lambda s: (_SEVERITY[s["state"]], s["name"].casefold())):
+            state, name = service["state"], service["name"]
+            link = ""
+            if service.get("url"):
+                url = _e(service["url"])
+                rel = ' rel="noopener"' if re.match(r"https?://", str(service["url"]), re.I) else ""
+                link = f'<a href="{url}"{rel}>{_e(name)}</a>'
+            heading = link or _e(name)
+            parts.append(f'<li class="service" id="{_e(_id(name))}" data-state="{_e(state)}"><span class="dot" aria-hidden="true"></span><h2>{heading}</h2><span class="state">{_LABELS[state]}</span>')
+            if service.get("note"):
+                parts.append(f'<p class="note">{_e(service["note"])}</p>')
+            if "uptime" in service and service["uptime"] is not None:
+                parts.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            parts.append('</li>')
+        parts.append('</ul></main>')
+    else:
+        parts.append('<main><p class="empty">No services configured.</p></main>')
+
+    parts.append(f'<footer><time datetime="{_e(generated_at)}">Updated {_e(generated_at)}</time></footer></body></html>')
+    return "\n".join(parts)
+
+
+if __name__ == "__main__":
+    services = load(sys.argv[1])
+    print(render(services, datetime.now(timezone.utc).isoformat()))
