+++ b/app/page.py
@@ -0,0 +1,127 @@
+"""Render a self-contained public service status page."""
+import html
+import json
+import re
+import sys
+from datetime import datetime, timezone
+
+
+STATE_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _escape(value):
+    return html.escape(str(value), quote=True)
+
+
+def _identifier(name):
+    slug = re.sub(r"[^a-z0-9]+", "-", str(name).lower())
+    return slug.strip("-")
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    """Return a complete, standalone HTML status page."""
+    for service in services:
+        state = service["state"]
+        if state not in STATE_LABELS:
+            raise ValueError(f"unknown state: {state}")
+
+    total = len(services)
+    counts = {state: sum(s["state"] == state for s in services) for state in STATE_LABELS}
+    css = '''
+:root {
+  --bg: #f7f8fa; --text: #202833; --ok: #16803c;
+  --warn: #9a6700; --down: #c62828; --maint: #536d9b;
+}
+@media (prefers-color-scheme: dark) {
+  :root { --bg: #171a20; --text: #edf0f4; --ok: #65d483; --warn: #f2c14e; --down: #ff7373; --maint: #9bb8f0; }
+}
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, .banner, main, footer { width: 100%; max-width: 640px; margin-left: auto; margin-right: auto; }
+h1 { margin: 0 0 1rem; }
+.banner { padding: 1rem; border-radius: .5rem; margin-bottom: 1.5rem; }
+.banner--ok { color: var(--ok); background: color-mix(in srgb, var(--ok) 12%, var(--bg)); }
+.banner--warn { color: var(--warn); background: color-mix(in srgb, var(--warn) 12%, var(--bg)); }
+.banner--down { color: var(--down); background: color-mix(in srgb, var(--down) 12%, var(--bg)); }
+.services { list-style: none; padding: 0; margin: 0 auto; max-width: 640px; }
+.service { display: flex; align-items: center; gap: 1rem; padding: 1rem; border-bottom: 1px solid #8884; }
+.dot { flex: 0 0 .75rem; width: .75rem; height: .75rem; border-radius: 50%; background: var(--text); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; transform: scale(.8); } }
+@media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
+.service h2 { margin: 0; font-size: 1.1rem; }
+.service-details { flex: 1; min-width: 0; }
+.state, .uptime { font-size: .9rem; }
+.note { margin: .4rem 0 0; }
+.uptime { margin-left: auto; white-space: nowrap; }
+a { color: inherit; }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; }
+.empty { text-align: center; }
+footer { margin-top: 2rem; color: #68717d; font-size: .9rem; }
+@media (max-width: 480px) { .service { flex-direction: column; align-items: flex-start; } .uptime { margin-left: 0; } }
+'''
+    title = (f"Status · {counts['operational']} of {total} operational" if total
+             else "Status · no services")
+    parts = [
+        '<!doctype html>', '<html lang="en">', '<head>',
+        '<meta charset="utf-8">',
+        '<meta name="viewport" content="width=device-width, initial-scale=1">',
+        f'<title>{_escape(title)}</title>', f'<style>{css}</style>',
+        '</head>', '<body>', '<header><h1>System status</h1></header>',
+    ]
+    if total:
+        attention = counts["degraded"] + counts["outage"]
+        if attention:
+            sentence = f"{attention} of {total} services need{'s' if attention == 1 else ''} attention"
+        else:
+            sentence = "All systems operational"
+        if counts["maintenance"]:
+            sentence += f" · {counts['maintenance']} under maintenance"
+        modifier = "down" if counts["outage"] else "warn" if counts["degraded"] else "ok"
+        parts.append(f'<div class="banner banner--{modifier}" role="status">{_escape(sentence)}</div>')
+        parts.append('<main><ul class="services">')
+        for service in sorted(services, key=lambda s: (SEVERITY[s["state"]], str(s["name"]).casefold())):
+            name = _escape(service["name"])
+            url = service.get("url")
+            if url:
+                rel = ' rel="noopener"' if re.match(r"^https?://", str(url), re.I) else ""
+                heading = f'<a href="{_escape(url)}"{rel}>{name}</a>'
+            else:
+                heading = name
+            identifier = _escape(_identifier(service["name"]))
+            parts.append(f'<li class="service" id="service-{identifier}" data-state="{_escape(service["state"])}">')
+            parts.append('<span class="dot" aria-hidden="true"></span>')
+            parts.append(f'<div class="service-details"><h2>{heading}</h2><span class="state">{STATE_LABELS[service["state"]]}</span>')
+            if service.get("note"):
+                parts.append(f'<p class="note">{_escape(service["note"])}</p>')
+            parts.append('</div>')
+            if service.get("uptime") is not None:
+                parts.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            parts.append('</li>')
+        parts.append('</ul></main>')
+    else:
+        parts.append('<main><p class="empty">No services configured.</p></main>')
+    escaped_time = _escape(generated_at)
+    parts.append(f'<footer><time datetime="{escaped_time}">Updated {escaped_time}</time></footer>')
+    parts.extend(['</body>', '</html>'])
+    return '\n'.join(parts)
+
+
+def main():
+    from .status import load
+    services = load(sys.argv[1])
+    generated_at = datetime.now(timezone.utc).isoformat()
+    print(render(services, generated_at))
+
+
+if __name__ == "__main__":
+    main()
