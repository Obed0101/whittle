new file mode 100644
index 0000000..2135d07
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,122 @@
+"""Render a self-contained public status page."""
+
+import html
+import re
+import sys
+from datetime import datetime, timezone
+
+from app.status import STATES, load
+
+_STATE_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+_SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _escape(value):
+    return html.escape(str(value), quote=True)
+
+
+def _service_id(name):
+    slug = "".join(char.lower() if char.isalnum() else " " for char in str(name))
+    return "service-" + "-".join(slug.split())
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    """Return a complete, self-contained HTML status document."""
+    for service in services:
+        if service["state"] not in STATES:
+            raise ValueError(f"unknown state: {service['state']}")
+
+    ordered = sorted(services, key=lambda service: (
+        _SEVERITY[service["state"]], service["name"].casefold()
+    ))
+    total = len(services)
+    attention = sum(service["state"] in ("degraded", "outage") for service in services)
+    maintenance = sum(service["state"] == "maintenance" for service in services)
+    if not total:
+        title = "Status · no services"
+    else:
+        operational = sum(service["state"] == "operational" for service in services)
+        title = f"Status · {operational} of {total} operational"
+
+    css = """<style>
+:root { --bg: #f5f7fa; --text: #182230; --ok: #16803c; --warn: #a15c00; --down: #c62828; --maint: #52637a; }
+@media (prefers-color-scheme: dark) { :root { --bg: #151a22; --text: #edf2f7; --ok: #61d98a; --warn: #ffc05c; --down: #ff7777; --maint: #aab8ca; } }
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, main, footer { max-width: 640px; margin: 0 auto; }
+header h1 { margin-top: 0; }
+.banner { padding: .9rem 1rem; border-radius: .5rem; font-weight: 650; }
+.banner--ok { color: var(--ok); background: color-mix(in srgb, var(--ok) 12%, var(--bg)); }
+.banner--warn { color: var(--warn); background: color-mix(in srgb, var(--warn) 12%, var(--bg)); }
+.banner--down { color: var(--down); background: color-mix(in srgb, var(--down) 12%, var(--bg)); }
+.services { max-width: 640px; margin: 1.25rem auto; padding: 0; list-style: none; }
+.service { display: flex; align-items: flex-start; gap: .8rem; padding: 1rem; margin-bottom: .75rem; border: 1px solid #8793a033; border-radius: .5rem; }
+.dot { flex: 0 0 .7rem; width: .7rem; height: .7rem; margin-top: .4rem; border-radius: 50%; background: var(--maint); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; } }
+@media (prefers-reduced-motion: reduce) { [data-state="outage"] .dot { animation: none; } }
+.service h2 { margin: 0; font-size: 1.1rem; }
+.service p { margin: .4rem 0 0; }
+.state, .uptime { display: inline-block; margin: .35rem .75rem 0 0; font-size: .9rem; }
+a { color: inherit; }
+a:focus-visible { outline: 3px solid #2878d0; outline-offset: 3px; }
+.empty { max-width: 640px; margin: 1.5rem auto; }
+footer { margin-top: 2rem; color: var(--maint); font-size: .9rem; }
+@media (max-width: 480px) { .service { flex-direction: column; gap: .35rem; } .dot { margin-top: 0; } }
+</style>"""
+
+    parts = ["<!doctype html>", '<html lang="en">', "<head>",
+             '<meta charset="utf-8">',
+             '<meta name="viewport" content="width=device-width, initial-scale=1">',
+             f"<title>{_escape(title)}</title>", css, "</head>", "<body>",
+             "<header><h1>System status</h1></header>"]
+    if total:
+        modifier = "down" if any(s["state"] == "outage" for s in services) else (
+            "warn" if any(s["state"] == "degraded" for s in services) else "ok"
+        )
+        if attention:
+            message = f"{attention} of {total} services {'needs' if attention == 1 else 'need'} attention"
+        else:
+            message = "All systems operational"
+        if maintenance:
+            message += f" · {maintenance} under maintenance"
+        parts.append(f'<div class="banner banner--{modifier}" role="status">{_escape(message)}</div>')
+        parts.append('<main><ul class="services">')
+        for service in ordered:
+            state = service["state"]
+            name = _escape(service["name"])
+            parts.append(f'<li class="service" id="{_escape(_service_id(service["name"]))}" data-state="{_escape(state)}">')
+            parts.append('<span class="dot" aria-hidden="true"></span><div class="service-content">')
+            if service.get("url"):
+                url = _escape(service["url"])
+                rel = ' rel="noopener"' if re.match(r"^https?://", str(service["url"]), re.I) else ""
+                parts.append(f'<h2><a href="{url}"{rel}>{name}</a></h2>')
+            else:
+                parts.append(f"<h2>{name}</h2>")
+            parts.append(f'<span class="state">{_STATE_LABELS[state]}</span>')
+            if service.get("uptime") is not None:
+                parts.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            if service.get("note"):
+                parts.append(f'<p class="note">{_escape(service["note"])}</p>')
+            parts.append("</div></li>")
+        parts.append("</ul></main>")
+    else:
+        parts.append('<p class="empty">No services configured.</p>')
+    stamp = _escape(generated_at)
+    parts.extend([f'<footer><time datetime="{stamp}">Updated {stamp}</time></footer>', "</body>", "</html>"])
+    return "\n".join(parts)
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: python -m app.page services.json")
+    timestamp = datetime.now(timezone.utc).isoformat()
+    print(render(load(sys.argv[1]), timestamp))
