index 0000000..6e871e0
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,126 @@
+"""Render the public, self-contained service status page."""
+import html
+import re
+import sys
+from datetime import datetime, timezone
+
+from app.status import STATES, load
+
+STATE_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+CSS = """<style>
+:root {
+  --bg: #f5f7fa;
+  --text: #17212b;
+  --ok: #16803c;
+  --warn: #a15c00;
+  --down: #b42318;
+  --maint: #5263a6;
+}
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, .banner, .services, footer { max-width: 640px; margin-left: auto; margin-right: auto; }
+h1 { margin: 0 0 1rem; }
+.banner { padding: 1rem; border-radius: .5rem; }
+.banner--ok { background: color-mix(in srgb, var(--ok) 12%, var(--bg)); }
+.banner--warn { background: color-mix(in srgb, var(--warn) 14%, var(--bg)); }
+.banner--down { background: color-mix(in srgb, var(--down) 14%, var(--bg)); }
+.services { list-style: none; padding: 0; }
+.service { display: flex; align-items: center; gap: 1rem; padding: 1rem; border-bottom: 1px solid #ccd2d9; }
+.dot { width: .75rem; height: .75rem; flex: 0 0 .75rem; border-radius: 50%; background: var(--ok); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; } }
+.service h2 { margin: 0; font-size: 1.1rem; }
+.service p { margin: .35rem 0 0; }
+.state, .uptime { display: inline-block; margin: .35rem .75rem 0 0; }
+a { color: inherit; }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; }
+.empty { max-width: 640px; margin: 2rem auto; }
+footer { margin-top: 2rem; color: #606b75; font-size: .9rem; }
+@media (prefers-color-scheme: dark) {
+  :root { --bg: #151a20; --text: #edf1f5; --ok: #55c878; --warn: #ffc15c; --down: #ff7168; --maint: #aab5ff; }
+  .service { border-color: #39424c; }
+  footer { color: #b3bdc7; }
+}
+@media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
+@media (max-width: 480px) { .service { flex-direction: column; align-items: flex-start; } }
+</style>"""
+
+
+def _escape(value):
+    return html.escape(str(value), quote=True)
+
+
+def _slug(name):
+    return re.sub(r"-+", "-", "".join(char if char.isalnum() else "-" for char in name.lower()).strip("-"))
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    """Return a complete static HTML status page."""
+    for service in services:
+        state = service["state"]
+        if state not in STATES:
+            raise ValueError(f"unknown state: {state}")
+
+    total = len(services)
+    if not total:
+        title = "Status · no services"
+        body = '<main><p class="empty">No services configured.</p></main>'
+    else:
+        operational = sum(s["state"] == "operational" for s in services)
+        title = f"Status · {operational} of {total} operational"
+        attention = sum(s["state"] in ("degraded", "outage") for s in services)
+        maintenance = sum(s["state"] == "maintenance" for s in services)
+        if attention:
+            banner_text = f"{attention} of {total} services {'needs' if attention == 1 else 'need'} attention"
+        else:
+            banner_text = "All systems operational"
+        if maintenance:
+            banner_text += f" · {maintenance} under maintenance"
+        modifier = "down" if any(s["state"] == "outage" for s in services) else (
+            "warn" if any(s["state"] == "degraded" for s in services) else "ok"
+        )
+        items = []
+        for service in sorted(services, key=lambda s: (SEVERITY[s["state"]], s["name"].casefold())):
+            state = service["state"]
+            name = _escape(service["name"])
+            url = service.get("url")
+            if url is not None:
+                rel = ' rel="noopener"' if re.match(r"^https?://", str(url), re.I) else ""
+                name = f'<a href="{_escape(url)}"{rel}>{name}</a>'
+            parts = [f'<li class="service" id="service-{_escape(_slug(service["name"]))}" data-state="{_escape(state)}">',
+                     '<span class="dot" aria-hidden="true"></span>', f"<div><h2>{name}</h2>",
+                     f'<span class="state">{STATE_LABELS[state]}</span>']
+            if service.get("note"):
+                parts.append(f'<p class="note">{_escape(service["note"])}</p>')
+            if service.get("uptime") is not None:
+                parts.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            parts.append("</div></li>")
+            items.append("".join(parts))
+        body = (f'<div class="banner banner--{modifier}" role="status">{_escape(banner_text)}</div>'
+                '<main><ul class="services">' + "".join(items) + "</ul></main>")
+
+    return ("<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n"
+            '<meta name="viewport" content="width=device-width, initial-scale=1">\n'
+            f"<title>{_escape(title)}</title>\n{CSS}\n</head>\n<body>\n<header><h1>System status</h1></header>\n"
+            f"{body}\n<footer><time datetime=\"{_escape(generated_at)}\">Updated {_escape(generated_at)}</time></footer>\n"
+            "</body>\n</html>\n")
+
+
+def main():
+    services = load(sys.argv[1])
+    generated_at = datetime.now(timezone.utc).isoformat()
+    print(render(services, generated_at), end="")
+
+
+if __name__ == "__main__":
+    main()
