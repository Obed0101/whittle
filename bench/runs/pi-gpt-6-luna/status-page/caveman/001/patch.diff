diff --git a/app/page.py b/app/page.py
new file mode 100644
index 0000000..ad4ae97
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,115 @@
+"""Render the public service status page."""
+
+import html
+import re
+import sys
+from datetime import datetime, timezone
+
+from app.status import STATES, load
+
+STATE_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    """Return a self-contained HTML status page for services."""
+    for service in services:
+        state = service["state"]
+        if state not in STATES:
+            raise ValueError(f"unknown state: {state}")
+
+    ordered = sorted(services, key=lambda item: (SEVERITY[item["state"]], item["name"].casefold()))
+    total = len(ordered)
+    attention = sum(item["state"] in ("degraded", "outage") for item in ordered)
+    maintenance = sum(item["state"] == "maintenance" for item in ordered)
+
+    if attention:
+        banner_text = f"{attention} of {total} services {'needs' if attention == 1 else 'need'} attention"
+    else:
+        banner_text = "All systems operational"
+    if maintenance:
+        banner_text += f" · {maintenance} under maintenance"
+
+    modifier = "banner--down" if any(s["state"] == "outage" for s in ordered) else (
+        "banner--warn" if any(s["state"] == "degraded" for s in ordered) else "banner--ok"
+    )
+    title = f"Status · {total - attention - maintenance} of {total} operational" if total else "Status · no services"
+
+    css = """<style>
+:root { --bg: #f5f7fa; --text: #18212f; --ok: #18864b; --warn: #a86400; --down: #c62828; --maint: #5367a8; }
+@media (prefers-color-scheme: dark) { :root { --bg: #151a22; --text: #edf1f7; --ok: #55d68b; --warn: #ffc15a; --down: #ff7373; --maint: #aabaff; } }
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, main, footer { width: 100%; max-width: 640px; margin: 0 auto; }
+h1 { margin-top: 0; }
+.banner { padding: 1rem; border-radius: .5rem; margin-bottom: 1rem; }
+.banner--ok { background: color-mix(in srgb, var(--ok) 15%, var(--bg)); }
+.banner--warn { background: color-mix(in srgb, var(--warn) 18%, var(--bg)); }
+.banner--down { background: color-mix(in srgb, var(--down) 18%, var(--bg)); }
+.services { list-style: none; padding: 0; margin: 0 auto; max-width: 640px; }
+.service { display: flex; align-items: center; gap: .75rem; padding: 1rem; margin-bottom: .75rem; border: 1px solid #8885; border-radius: .5rem; }
+.service h2 { font-size: 1.1rem; margin: 0; flex: 1; }
+.dot { width: .75rem; height: .75rem; flex: none; border-radius: 50%; background: var(--text); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+.state, .uptime { white-space: nowrap; }
+.note { flex-basis: 100%; margin: .25rem 0 0; }
+.service { flex-wrap: wrap; }
+a { color: inherit; }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; }
+.empty { text-align: center; }
+footer { margin-top: 2rem; opacity: .75; }
+@keyframes pulse { 50% { opacity: .35; transform: scale(.8); } }
+@media (prefers-reduced-motion: reduce) { [data-state="outage"] .dot { animation: none; } }
+@media (max-width: 480px) { .service { flex-direction: column; align-items: flex-start; } }
+</style>"""
+
+    parts = ["<!doctype html>", '<html lang="en">', "<head>", '<meta charset="utf-8">',
+             '<meta name="viewport" content="width=device-width, initial-scale=1">',
+             f"<title>{html.escape(title)}</title>", css, "</head>", "<body>",
+             "<header><h1>System status</h1></header>"]
+    if ordered:
+        parts.append(f'<div class="banner {modifier}" role="status">{html.escape(banner_text)}</div>')
+        parts.append('<main><ul class="services">')
+        for service in ordered:
+            state = service["state"]
+            name = html.escape(str(service["name"]))
+            slug = re.sub(r"[^a-z0-9]+", "-", str(service["name"]).lower()).strip("-")
+            url = service.get("url")
+            if url:
+                escaped_url = html.escape(str(url), quote=True)
+                rel = ' rel="noopener"' if re.match(r"^https?://", str(url), re.I) else ""
+                heading = f'<a href="{escaped_url}"{rel}>{name}</a>'
+            else:
+                heading = name
+            parts.append(f'<li class="service" id="service-{html.escape(slug, quote=True)}" data-state="{state}">')
+            parts.append('<span class="dot" aria-hidden="true"></span>')
+            parts.append(f"<h2>{heading}</h2><span class=\"state\">{STATE_LABELS[state]}</span>")
+            if service.get("note"):
+                parts.append(f'<p class="note">{html.escape(str(service["note"]))}</p>')
+            if service.get("uptime") is not None:
+                parts.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            parts.append("</li>")
+        parts.extend(["</ul></main>"])
+    else:
+        parts.append('<main><p class="empty">No services configured.</p></main>')
+    escaped_time = html.escape(generated_at, quote=True)
+    parts.extend([f'<footer><time datetime="{escaped_time}">Updated {html.escape(generated_at)}</time></footer>', "</body>", "</html>"])
+    return "\n".join(parts)
+
+
+def main() -> None:
+    services = load(sys.argv[1])
+    generated_at = datetime.now(timezone.utc).isoformat()
+    print(render(services, generated_at))
+
+
+if __name__ == "__main__":
+    main()
