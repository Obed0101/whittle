diff --git a/app/page.py b/app/page.py
new file mode 100644
index 0000000..cd21e87
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,122 @@
+"""Render the service data as a portable public status page."""
+import argparse
+from datetime import datetime, timezone
+import html
+import json
+import re
+import sys
+
+
+STATE_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _escape(value):
+    return html.escape(str(value), quote=True)
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    for service in services:
+        state = service["state"]
+        if state not in STATE_LABELS:
+            raise ValueError(f"unknown state: {state}")
+
+    counts = {state: sum(service["state"] == state for service in services)
+              for state in STATE_LABELS}
+    total = len(services)
+    if total:
+        attention = counts["outage"] + counts["degraded"]
+        if not attention:
+            message = "All systems operational"
+        else:
+            verb = "needs" if attention == 1 else "need"
+            message = f"{attention} of {total} services {verb} attention"
+        if counts["maintenance"]:
+            number = counts["maintenance"]
+            message += f" · {number} under maintenance"
+        modifier = ("down" if counts["outage"] else
+                    "warn" if counts["degraded"] else "ok")
+        banner = f'<div class="banner banner--{modifier}" role="status">{_escape(message)}</div>'
+        ordered = sorted(services, key=lambda service: (
+            SEVERITY[service["state"]], service["name"].casefold()))
+        items = []
+        for service in ordered:
+            state = service["state"]
+            name = _escape(service["name"])
+            identifier = re.sub(r"[^a-z0-9]+", "-", service["name"].lower()).strip("-")
+            if service.get("url"):
+                url = _escape(service["url"])
+                external = re.match(r"^https?://", str(service["url"]), re.IGNORECASE)
+                name = f'<a href="{url}"' + (' rel="noopener"' if external else "") + f">{name}</a>"
+            note = (f'<p class="note">{_escape(service["note"])}</p>'
+                    if service.get("note") else "")
+            uptime = (f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>'
+                      if service.get("uptime") is not None else "")
+            items.append(
+                f'<li class="service" id="service-{_escape(identifier)}" data-state="{_escape(state)}">'
+                f'<span class="dot" aria-hidden="true"></span>'
+                f'<div class="service-details"><h2>{name}</h2>'
+                f'<span class="state">{STATE_LABELS[state]}</span>{note}{uptime}</div></li>')
+        content = f'<main><ul class="services">{"".join(items)}</ul></main>'
+        title = f"Status · {counts['operational']} of {total} operational"
+    else:
+        banner = ""
+        content = '<main><p class="empty">No services configured.</p></main>'
+        title = "Status · no services"
+
+    stamp = _escape(generated_at)
+    css = """<style>
+:root { --bg: #f5f7fa; --text: #17212b; --ok: #16834a; --warn: #a56400; --down: #c62828; --maint: #526a9b; }
+@media (prefers-color-scheme: dark) { :root { --bg: #151a20; --text: #e8edf2; --ok: #55cf83; --warn: #ffc45c; --down: #ff7777; --maint: #a9baff; } }
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, main, footer { margin: 0 auto; max-width: 640px; }
+h1 { margin: 0 0 1rem; font-size: 1.8rem; }
+.banner { padding: .85rem 1rem; border-radius: .5rem; margin-bottom: 1.25rem; }
+.banner--ok { background: color-mix(in srgb, var(--ok) 13%, var(--bg)); color: var(--ok); }
+.banner--warn { background: color-mix(in srgb, var(--warn) 13%, var(--bg)); color: var(--warn); }
+.banner--down { background: color-mix(in srgb, var(--down) 13%, var(--bg)); color: var(--down); }
+.services { list-style: none; padding: 0; margin: 0; display: grid; gap: .75rem; }
+.service { display: flex; align-items: flex-start; gap: .8rem; padding: 1rem; border: 1px solid color-mix(in srgb, var(--text) 15%, transparent); border-radius: .5rem; }
+.dot { width: .7rem; height: .7rem; border-radius: 50%; flex: 0 0 .7rem; margin-top: .45rem; background: var(--ok); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; } }
+.service-details { display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem .8rem; min-width: 0; }
+h2 { font-size: 1.05rem; margin: 0; }
+a { color: inherit; }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; }
+.state, .uptime { font-size: .9rem; }
+.note { flex-basis: 100%; margin: .25rem 0 0; }
+.uptime { color: var(--text); opacity: .75; }
+footer { margin-top: 1.5rem; font-size: .85rem; opacity: .75; }
+@media (max-width: 480px) { .service { flex-direction: column; gap: .35rem; } .dot { margin-top: 0; } }
+@media (prefers-reduced-motion: reduce) { [data-state="outage"] .dot { animation: none; } }
+</style>"""
+    return (f'<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n'
+            f'<meta name="viewport" content="width=device-width, initial-scale=1">\n'
+            f'<title>{_escape(title)}</title>\n{css}\n</head>\n<body>\n'
+            f'<header><h1>System status</h1></header>\n{banner}\n{content}\n'
+            f'<footer><time datetime="{stamp}">Updated {stamp}</time></footer>\n'
+            '</body>\n</html>\n')
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Render a public service status page")
+    parser.add_argument("services_json")
+    args = parser.parse_args()
+    with open(args.services_json, encoding="utf-8") as handle:
+        services = json.load(handle)
+    generated_at = datetime.now(timezone.utc).isoformat()
+    sys.stdout.write(render(services, generated_at))
+
+
+if __name__ == "__main__":
+    main()
