diff --git a/app/page.py b/app/page.py
new file mode 100644
index 0000000..f279673
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,117 @@
+"""Render a self-contained public service status page."""
+import html
+import json
+import re
+import sys
+from datetime import datetime, timezone
+from urllib.parse import urlsplit
+
+from .status import load
+
+_STATES = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+_SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _e(value):
+    return html.escape(str(value), quote=True)
+
+
+def _slug(value):
+    return re.sub(r"-+", "-", re.sub(r"[^a-z0-9]+", "-", value.lower())).strip("-")
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    for service in services:
+        if service.get("state") not in _STATES:
+            raise ValueError(f"unknown state: {service.get('state')}")
+
+    total = len(services)
+    counts = {state: sum(s["state"] == state for s in services) for state in _STATES}
+    if not total:
+        title = "Status · no services"
+    else:
+        title = f"Status · {counts['operational']} of {total} operational"
+
+    css = """<style>
+:root { --bg: #f6f8fa; --text: #1f2937; --ok: #16803c; --warn: #a15c00; --down: #c62828; --maint: #526579; }
+@media (prefers-color-scheme: dark) { :root { --bg: #151a21; --text: #e6edf3; --ok: #55cf7b; --warn: #ffc266; --down: #ff7777; --maint: #a9b8ca; } }
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, main, footer { max-width: 640px; margin: 0 auto; }
+h1 { margin: 0 0 1.25rem; }
+.banner { padding: 1rem; border-radius: .5rem; margin-bottom: 1rem; font-weight: 650; }
+.banner--ok { color: var(--ok); background: color-mix(in srgb, var(--ok) 12%, var(--bg)); }
+.banner--warn { color: var(--warn); background: color-mix(in srgb, var(--warn) 12%, var(--bg)); }
+.banner--down { color: var(--down); background: color-mix(in srgb, var(--down) 12%, var(--bg)); }
+.services { max-width: 640px; margin: 0 auto; padding: 0; list-style: none; }
+.service { display: flex; align-items: center; gap: .85rem; padding: 1rem; margin: .65rem 0; border: 1px solid color-mix(in srgb, var(--text) 16%, transparent); border-radius: .5rem; }
+.dot { flex: 0 0 .7rem; width: .7rem; height: .7rem; border-radius: 50%; background: var(--ok); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.4s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; transform: scale(.8); } }
+@media (prefers-reduced-motion: reduce) { * { animation: none !important; scroll-behavior: auto !important; } }
+.service-content { min-width: 0; flex: 1; }
+.service h2 { margin: 0; font-size: 1.1rem; }
+a { color: inherit; }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; border-radius: 2px; }
+.state { display: block; margin-top: .2rem; color: var(--text); }
+.note { margin: .4rem 0 0; }
+.uptime { white-space: nowrap; font-size: .9rem; }
+.empty { padding: 1rem; }
+footer { margin-top: 1.5rem; font-size: .9rem; opacity: .8; }
+@media (max-width: 480px) { .service { flex-direction: column; align-items: flex-start; } }
+</style>"""
+    parts = ["<!doctype html>", '<html lang="en">', "<head>", '<meta charset="utf-8">', '<meta name="viewport" content="width=device-width, initial-scale=1">', f"<title>{_e(title)}</title>", css, "</head>", "<body>", "<header><h1>System status</h1></header>", "<main>"]
+    if total:
+        attention = counts["degraded"] + counts["outage"]
+        maintenance = counts["maintenance"]
+        if attention:
+            banner_text = f"{attention} of {total} services {'needs' if attention == 1 else 'need'} attention"
+        else:
+            banner_text = "All systems operational"
+        if maintenance:
+            banner_text += f" · {maintenance} under maintenance"
+        modifier = "down" if counts["outage"] else "warn" if counts["degraded"] else "ok"
+        parts.append(f'<div class="banner banner--{modifier}" role="status">{_e(banner_text)}</div>')
+        parts.append('<ul class="services">')
+        ordered = sorted(services, key=lambda s: (_SEVERITY[s["state"]], s["name"].casefold()))
+        for service in ordered:
+            state = service["state"]
+            name = _e(service["name"])
+            url = service.get("url")
+            if url is not None:
+                safe_url = _e(url)
+                parsed = urlsplit(str(url))
+                rel = ' rel="noopener"' if parsed.scheme.lower() in ("http", "https") else ""
+                name = f'<a href="{safe_url}"{rel}>{name}</a>'
+            item = [f'<li class="service" id="service-{_e(_slug(str(service["name"]))) }" data-state="{_e(state)}">', '<span class="dot" aria-hidden="true"></span>', '<div class="service-content">', f"<h2>{name}</h2>", f'<span class="state">{_e(_STATES[state])}</span>']
+            if service.get("note"):
+                item.append(f'<p class="note">{_e(service["note"])}</p>')
+            item.append("</div>")
+            if service.get("uptime") is not None:
+                item.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            item.append("</li>")
+            parts.append("".join(item))
+        parts.append("</ul>")
+    else:
+        parts.append('<p class="empty">No services configured.</p>')
+    parts.extend(["</main>", f'<footer><time datetime="{_e(generated_at)}">Updated {_e(generated_at)}</time></footer>', "</body>", "</html>"])
+    return "\n".join(parts)
+
+
+def main():
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: python -m app.page services.json")
+    generated_at = datetime.now(timezone.utc).isoformat()
+    print(render(load(sys.argv[1]), generated_at))
+
+
+if __name__ == "__main__":
+    main()
