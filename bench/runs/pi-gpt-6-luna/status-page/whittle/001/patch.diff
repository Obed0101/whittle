+"""Render a self-contained public status page."""
+import html
+import json
+import re
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+from app.status import STATES, load
+
+STATE_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _e(value):
+    return html.escape(str(value), quote=True)
+
+
+def _service_id(name):
+    return "service-" + re.sub(r"-+", "-", re.sub(r"[^\w]+", "-", name.lower(), flags=re.UNICODE)).strip("-")
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    for service in services:
+        state = service["state"]
+        if state not in STATES:
+            raise ValueError(f"unknown state: {state}")
+
+    total = len(services)
+    ordered = sorted(services, key=lambda s: (SEVERITY[s["state"]], s["name"].casefold()))
+    attention = sum(s["state"] in ("degraded", "outage") for s in services)
+    maintenance = sum(s["state"] == "maintenance" for s in services)
+    if any(s["state"] == "outage" for s in services):
+        modifier = "down"
+    elif any(s["state"] == "degraded" for s in services):
+        modifier = "warn"
+    else:
+        modifier = "ok"
+
+    if not total:
+        title = "Status · no services"
+    else:
+        operational = sum(s["state"] == "operational" for s in services)
+        title = f"Status · {operational} of {total} operational"
+
+    parts = ["<!doctype html>", '<html lang="en">', "<head>",
+             '<meta charset="utf-8">', '<meta name="viewport" content="width=device-width, initial-scale=1">',
+             f"<title>{_e(title)}</title>", "<style>", _CSS, "</style>", "</head>", "<body>",
+             "<header><h1>System status</h1></header>"]
+
+    if total:
+        if attention:
+            label = "service needs" if attention == 1 else "services need"
+            banner_text = f"{attention} of {total} {label} attention"
+        else:
+            banner_text = "All systems operational"
+        if maintenance:
+            banner_text += f" · {maintenance} under maintenance"
+        parts.append(f'<div class="banner banner--{modifier}" role="status">{_e(banner_text)}</div>')
+        parts.append('<main><ul class="services">')
+        for service in ordered:
+            name = _e(service["name"])
+            state = service["state"]
+            heading = name
+            if service.get("url"):
+                url = _e(service["url"])
+                rel = ' rel="noopener"' if re.match(r"https?://", str(service["url"]), re.I) else ""
+                heading = f'<a href="{url}"{rel}>{name}</a>'
+            parts.append(f'<li class="service" id="{_e(_service_id(str(service["name"]))) }" data-state="{_e(state)}">'
+                         f'<span class="dot" aria-hidden="true"></span><div class="service-info">'
+                         f'<h2>{heading}</h2><span class="state">{STATE_LABELS[state]}</span>')
+            if service.get("note"):
+                parts.append(f'<p class="note">{_e(service["note"])}</p>')
+            if service.get("uptime") is not None:
+                parts.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            parts.append("</div></li>")
+        parts.append("</ul></main>")
+    else:
+        parts.append('<main><p class="empty">No services configured.</p></main>')
+
+    parts.append(f'<footer><time datetime="{_e(generated_at)}">Updated {_e(generated_at)}</time></footer>')
+    parts.append("</body></html>")
+    return "\n".join(parts)
+
+
+_CSS = """\
+:root { --bg: #f5f7fa; --text: #17212b; --ok: #18864b; --warn: #a66300; --down: #c62828; --maint: #536d9b; }
+@media (prefers-color-scheme: dark) { :root { --bg: #151a21; --text: #e8edf3; --ok: #58cf88; --warn: #ffc15c; --down: #ff7373; --maint: #a9bdf0; } }
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, .banner, main, footer { width: 100%; max-width: 640px; margin-left: auto; margin-right: auto; }
+header h1 { margin: 0 0 1.25rem; }
+.banner { border-radius: .5rem; padding: 1rem 1.25rem; margin-bottom: 1.5rem; font-weight: 650; }
+.banner--ok { background: color-mix(in srgb, var(--ok) 14%, var(--bg)); color: var(--ok); }
+.banner--warn { background: color-mix(in srgb, var(--warn) 14%, var(--bg)); color: var(--warn); }
+.banner--down { background: color-mix(in srgb, var(--down) 14%, var(--bg)); color: var(--down); }
+.services { list-style: none; padding: 0; margin: 0; }
+.service { display: flex; align-items: flex-start; gap: 1rem; padding: 1.15rem 0; border-bottom: 1px solid color-mix(in srgb, var(--text) 15%, transparent); }
+.dot { width: .75rem; height: .75rem; flex: 0 0 .75rem; margin-top: .45rem; border-radius: 50%; background: var(--ok); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; transform: scale(.8); } }
+.service-info { display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem .8rem; }
+.service h2 { margin: 0; font-size: 1.1rem; }
+.state, .uptime { font-size: .9rem; opacity: .85; }
+.note { flex-basis: 100%; margin: .25rem 0 0; line-height: 1.5; }
+a { color: inherit; }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; border-radius: 2px; }
+.empty { padding: 1rem 0; }
+footer { margin-top: 2rem; font-size: .875rem; opacity: .75; }
+@media (max-width: 480px) { .service { flex-direction: column; gap: .5rem; } .dot { margin-top: .1rem; } }
+@media (prefers-reduced-motion: reduce) { [data-state="outage"] .dot { animation: none; } }
+"""
+
+
+def main():
+    path = sys.argv[1]
+    services = load(path)
+    generated_at = datetime.now(timezone.utc).isoformat()
+    print(render(services, generated_at))
+
+
+if __name__ == "__main__":
+    main()
