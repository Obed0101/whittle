+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+import json
+import sys
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        self.print_usage(sys.stderr)
+        self.exit(2, f"error: {message}\n")
+
+
+def _date(value):
+    try:
+        parsed = date.fromisoformat(value)
+        if parsed.isoformat() != value:
+            raise ValueError
+        return parsed
+    except (ValueError, TypeError):
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _table(headers, rows, amount_column=None, no_header=False):
+    widths = [len(str(h)) for h in headers]
+    for row in rows:
+        for i, value in enumerate(row):
+            widths[i] = max(widths[i], len(str(value)))
+    lines = []
+    if not no_header:
+        lines.append("  ".join(str(h).ljust(widths[i]) for i, h in enumerate(headers)))
+        lines.append("  ".join("-" * w for w in widths))
+    for row in rows:
+        cells = []
+        for i, value in enumerate(row):
+            text = str(value)
+            cells.append(text.rjust(widths[i]) if i == amount_column else text.ljust(widths[i]))
+        lines.append("  ".join(cells))
+    return lines, widths
+
+
+def main(argv: list[str]) -> int:
+    parser = Parser(prog="python -m app.report", description="Create an expense report.", add_help=False)
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[], metavar="NAME")
+    parser.add_argument("--from", dest="from_date", type=_date, metavar="DATE")
+    parser.add_argument("--to", dest="to_date", type=_date, metavar="DATE")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="", metavar="SYMBOL")
+    parser.add_argument("--top", type=int, metavar="N")
+    parser.add_argument("--no-header", action="store_true")
+    parser.add_argument("-h", "--help", action="help")
+    parser.epilog = "Example: python -m app.report expenses.csv --by month"
+    args = parser.parse_args(argv)
+    if args.from_date and args.to_date and args.from_date > args.to_date:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+        if minimum is not None and not minimum.is_finite():
+            raise InvalidOperation
+    except (InvalidOperation, ValueError):
+        print(f"error: invalid amount: {args.minimum}", file=sys.stderr)
+        return 2
+    try:
+        raw = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except OSError as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 2
+
+    valid, skipped = [], 0
+    for row in raw:
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, ValueError, KeyError):
+            skipped += 1
+            continue
+        try:
+            row_date = _date(row["date"])
+        except (argparse.ArgumentTypeError, KeyError):
+            print(f"error: invalid date: {row.get('date', '')}", file=sys.stderr)
+            return 2
+        valid.append({**row, "_amount": amount, "_date": row_date})
+
+    categories = {name.casefold() for name in args.category}
+    selected = [r for r in valid
+                if (not categories or r["category"].casefold() in categories)
+                and (args.from_date is None or r["_date"] >= args.from_date)
+                and (args.to_date is None or r["_date"] <= args.to_date)
+                and (minimum is None or r["_amount"] >= minimum)]
+    selected.sort(key=lambda r: r["_date"])
+    if args.top is not None:
+        selected = sorted(selected, key=lambda r: r["_amount"], reverse=True)[:max(0, args.top)]
+
+    if not selected:
+        print("No expenses.")
+    elif args.format == "json":
+        if args.by:
+            groups = _groups(selected, args.by)
+            output = [{"group": name, "count": len(rows), "total": float(sum((r["_amount"] for r in rows), Decimal(0)))} for name, rows in groups]
+        else:
+            output = [{"date": r["date"], "category": r["category"], "amount": float(r["_amount"]), "note": r["note"]} for r in selected]
+        print(json.dumps(output, indent=2, ensure_ascii=False))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        for r in selected:
+            writer.writerow([r["date"], r["category"], f"{r['_amount']:.2f}", r["note"]])
+    elif args.by:
+        groups = _groups(selected, args.by)
+        first = "Category" if args.by == "category" else "Month"
+        rows = [[name, str(len(entries)), _money(sum((r["_amount"] for r in entries), Decimal(0)))] for name, entries in groups]
+        total = sum((r["_amount"] for r in selected), Decimal(0))
+        table, widths = _table([first, "Count", "Total"], rows, amount_column=2, no_header=args.no_header)
+        table.append("  ".join(["Total".ljust(widths[0]), "".rjust(widths[1]), _money(total).rjust(widths[2])]))
+        print("\n".join(table))
+    else:
+        rows = []
+        for r in selected:
+            amount = r["_amount"]
+            formatted = f"({args.currency}{_money(-amount)})" if amount < 0 else args.currency + _money(amount)
+            note = r["note"] if len(r["note"]) <= 24 else r["note"][:23] + "…"
+            rows.append([r["date"], r["category"], formatted, note])
+        total = sum((r["_amount"] for r in selected), Decimal(0))
+        table, widths = _table(["Date", "Category", "Amount", "Note"], rows, amount_column=2, no_header=args.no_header)
+        formatted_total = f"({args.currency}{_money(-total)})" if total < 0 else args.currency + _money(total)
+        table.append("  ".join(["Total".ljust(widths[0]), "".ljust(widths[1]), formatted_total.rjust(widths[2]), "".ljust(widths[3])]).rstrip())
+        print("\n".join(table))
+    if skipped:
+        noun = "row" if skipped == 1 else "rows"
+        print(f"warning: skipped {skipped} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _groups(rows, by):
+    grouped = {}
+    for row in rows:
+        key = row["category"].title() if by == "category" else row["_date"].strftime("%Y-%m")
+        grouped.setdefault(key, []).append(row)
+    if by == "category":
+        return sorted(grouped.items(), key=lambda pair: (-sum((r["_amount"] for r in pair[1]), Decimal(0)), pair[0].casefold()))
+    return sorted(grouped.items())
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
