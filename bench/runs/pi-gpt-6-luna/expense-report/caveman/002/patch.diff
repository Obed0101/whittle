+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+import json
+import sys
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+from app.expenses import load
+
+
+def _date(value):
+    try:
+        parsed = date.fromisoformat(value)
+        if parsed.isoformat() != value:
+            raise ValueError
+        return parsed
+    except (TypeError, ValueError):
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+
+
+def _parser():
+    parser = argparse.ArgumentParser(
+        prog="python -m app.report",
+        epilog="Example: python -m app.report expenses.csv --by month --format json",
+    )
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="date_from", type=_date)
+    parser.add_argument("--to", dest="date_to", type=_date)
+    parser.add_argument("--min", dest="minimum", type=Decimal)
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _amount(value):
+    try:
+        result = Decimal(value)
+        if not result.is_finite():
+            raise InvalidOperation
+        return result
+    except (InvalidOperation, TypeError, ValueError):
+        return None
+
+
+def _money(value, currency="", commas=True):
+    number = f"{abs(value):,.2f}" if commas else f"{abs(value):.2f}"
+    rendered = currency + number
+    return f"({rendered})" if value < 0 else rendered
+
+
+def _table(rows, args):
+    if args.by:
+        groups = {}
+        for row in rows:
+            key = row["category"].title() if args.by == "category" else row["date"][:7]
+            if key not in groups:
+                groups[key] = [0, Decimal(0)]
+            groups[key][0] += 1
+            groups[key][1] += row["_amount"]
+        items = [(key, count, total) for key, (count, total) in groups.items()]
+        if args.by == "category":
+            items.sort(key=lambda item: (-item[2], item[0].casefold()))
+            headers = ["Category", "Count", "Total"]
+        else:
+            items.sort(key=lambda item: item[0])
+            headers = ["Month", "Count", "Total"]
+        data = [[key, str(count), _money(total, args.currency)] for key, count, total in items]
+        total = sum((row["_amount"] for row in rows), Decimal(0))
+    else:
+        headers = ["Date", "Category", "Amount", "Note"]
+        data = [[r["date"], r["category"], _money(r["_amount"], args.currency),
+                 r.get("note", "") if len(r.get("note", "")) <= 24 else r["note"][:23] + "…"] for r in rows]
+        total = sum((row["_amount"] for row in rows), Decimal(0))
+    data.append(["Total", "", _money(total, args.currency)] if args.by else ["Total", "", _money(total, args.currency), ""])
+    widths = [max(len(str(row[i])) for row in [headers] + data) for i in range(len(headers))]
+    amount_col = 2
+    lines = []
+    if not args.no_header:
+        lines.extend(["  ".join(headers[i].ljust(widths[i]) for i in range(len(headers))),
+                      "  ".join("-" * widths[i] for i in range(len(headers)))])
+    for row in data:
+        cells = []
+        for i, value in enumerate(row):
+            text = str(value)
+            cells.append(text.rjust(widths[i]) if i == amount_col else text.ljust(widths[i]))
+        lines.append("  ".join(cells).rstrip())
+    return "\n".join(lines)
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as exc:
+        return int(exc.code)
+    if args.date_from and args.date_to and args.date_from > args.date_to:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    if args.minimum is not None and not args.minimum.is_finite():
+        print("error: invalid amount", file=sys.stderr)
+        return 2
+    try:
+        raw_rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    rows, skipped = [], 0
+    for raw in raw_rows:
+        amount = _amount(raw.get("amount"))
+        if amount is None:
+            skipped += 1
+            continue
+        try:
+            parsed = _date(raw.get("date"))
+        except argparse.ArgumentTypeError as exc:
+            print(f"error: {exc}", file=sys.stderr)
+            return 2
+        row = dict(raw, _amount=amount, _date=parsed)
+        rows.append(row)
+    categories = {name.casefold() for name in args.category}
+    rows = [r for r in rows if (not categories or r.get("category", "").casefold() in categories)
+            and (args.date_from is None or r["_date"] >= args.date_from)
+            and (args.date_to is None or r["_date"] <= args.date_to)
+            and (args.minimum is None or r["_amount"] >= args.minimum)]
+    rows.sort(key=lambda r: r["_date"])
+    if args.top is not None:
+        rows = sorted(rows, key=lambda r: r["_amount"], reverse=True)[:max(0, args.top)]
+    if not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        if args.by:
+            grouped = {}
+            for r in rows:
+                key = r["category"] if args.by == "category" else r["date"][:7]
+                count, total = grouped.get(key, (0, Decimal(0)))
+                grouped[key] = (count + 1, total + r["_amount"])
+            pairs = [(key, count, total) for key, (count, total) in grouped.items()]
+            pairs.sort(key=(lambda x: (-x[2], x[0].casefold())) if args.by == "category" else lambda x: x[0])
+            output = [{"group": k, "count": n, "total": float(t)} for k, n, t in pairs]
+        else:
+            output = [{"date": r["date"], "category": r["category"], "amount": float(r["_amount"]), "note": r.get("note", "")} for r in rows]
+        print(json.dumps(output, indent=2, ensure_ascii=False))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        for r in rows:
+            writer.writerow([r["date"], r["category"], f'{r["_amount"]:.2f}', r.get("note", "")])
+    else:
+        print(_table(rows, args))
+    if skipped:
+        noun = "row" if skipped == 1 else "rows"
+        print(f"warning: skipped {skipped} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
