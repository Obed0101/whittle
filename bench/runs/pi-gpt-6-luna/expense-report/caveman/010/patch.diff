+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+
+
+def _amount(value):
+    try:
+        result = Decimal(value)
+        if not result.is_finite():
+            raise InvalidOperation
+        return result
+    except (InvalidOperation, TypeError, ValueError):
+        return None
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report")
+    parser.add_argument("path", nargs="?")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="date_from", type=_date)
+    parser.add_argument("--to", dest="date_to", type=_date)
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by category"
+    return parser
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _table(headers, rows, amount_columns, no_header):
+    rendered = [[str(cell) for cell in row] for row in rows]
+    widths = [len(header) for header in headers]
+    for row in rendered:
+        widths = [max(w, len(cell)) for w, cell in zip(widths, row)]
+    lines = []
+    if not no_header:
+        lines.extend(("  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)),
+                      "  ".join("-" * widths[i] for i in range(len(headers)))))
+    for row in rendered:
+        lines.append("  ".join(cell.rjust(widths[i]) if i in amount_columns else cell.ljust(widths[i])
+                                for i, cell in enumerate(row)))
+    return "\n".join(line.rstrip() for line in lines) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    if not args.path:
+        parser.error("PATH is required")
+    if args.date_from and args.date_to and args.date_from > args.date_to:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    minimum = None
+    if args.minimum is not None:
+        minimum = _amount(args.minimum)
+        if minimum is None:
+            print(f"error: invalid amount: {args.minimum}", file=sys.stderr)
+            return 2
+    try:
+        raw_rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    rows = []
+    invalid = 0
+    categories = {name.casefold() for name in args.category}
+    for index, raw in enumerate(raw_rows):
+        amount = _amount(raw.get("amount"))
+        if amount is None:
+            invalid += 1
+            continue
+        try:
+            day = date.fromisoformat(raw.get("date", ""))
+        except (TypeError, ValueError):
+            print(f"error: invalid date: {raw.get('date', '')}", file=sys.stderr)
+            return 2
+        category = raw.get("category", "")
+        if categories and category.casefold() not in categories:
+            continue
+        if args.date_from and day < args.date_from or args.date_to and day > args.date_to:
+            continue
+        if minimum is not None and amount < minimum:
+            continue
+        rows.append({"date": day.isoformat(), "_day": day, "category": category,
+                     "amount": amount, "note": raw.get("note", ""), "_index": index})
+
+    if args.top is not None:
+        if args.top < 0:
+            print("error: --top must be non-negative", file=sys.stderr)
+            return 2
+        rows = sorted(rows, key=lambda row: (-row["amount"], row["_index"]))[:args.top]
+    else:
+        rows.sort(key=lambda row: row["_day"])
+
+    if args.by:
+        groups = {}
+        for row in rows:
+            key = row["category"] if args.by == "category" else row["date"][:7]
+            if key not in groups:
+                groups[key] = [0, Decimal(0)]
+            groups[key][0] += 1
+            groups[key][1] += row["amount"]
+        items = list(groups.items())
+        if args.by == "category":
+            items.sort(key=lambda item: (-item[1][1], item[0].casefold()))
+            label = "Category"
+            keys = [key.title() for key, _ in items]
+        else:
+            items.sort(key=lambda item: item[0])
+            label = "Month"
+            keys = [key for key, _ in items]
+        if not items:
+            print("No expenses.")
+        elif args.format == "json":
+            print(json.dumps([{"group": key, "count": val[0], "total": float(val[1])} for key, (_, val) in zip(keys, items)], indent=2))
+        else:
+            display = [[key, str(val[0]), args.currency + _money(val[1])] for key, (_, val) in zip(keys, items)]
+            display.append(["Total", str(sum(v[0] for _, v in items)), args.currency + _money(sum((v[1] for _, v in items), Decimal(0)))])
+            print(_table([label, "Count", "Total"], display, {1, 2}, args.no_header), end="")
+    elif not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        print(json.dumps([{"date": r["date"], "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in rows], indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        for r in rows:
+            writer.writerow([r["date"], r["category"], f"{r['amount']:.2f}", r["note"]])
+    else:
+        display = []
+        for r in rows:
+            amount = f"({args.currency}{_money(abs(r['amount']))})" if r["amount"] < 0 else args.currency + _money(r["amount"])
+            note = r["note"] if len(r["note"]) <= 24 else r["note"][:23] + "…"
+            display.append([r["date"], r["category"], amount, note])
+        total = sum((r["amount"] for r in rows), Decimal(0))
+        amount = f"({args.currency}{_money(abs(total))})" if total < 0 else args.currency + _money(total)
+        display.append(["Total", "", amount, ""])
+        print(_table(["Date", "Category", "Amount", "Note"], display, {2}, args.no_header), end="")
+
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
