+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        self.print_usage(sys.stderr)
+        self.exit(2, f"{self.prog}: error: {message}\n")
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise ValueError(f"error: invalid date: {value}")
+
+
+def _money(value, currency=""):
+    amount = Decimal(value)
+    if amount < 0:
+        return f"{currency}({abs(amount):,.2f})"
+    return f"{currency}{amount:,.2f}"
+
+
+def _table(headers, rows, amount_columns=()):
+    widths = [len(str(h)) for h in headers]
+    for row in rows:
+        for i, value in enumerate(row):
+            widths[i] = max(widths[i], len(str(value)))
+    lines = []
+    lines.append("  ".join(str(v).rjust(widths[i]) if i in amount_columns else str(v).ljust(widths[i]) for i, v in enumerate(headers)))
+    lines.append("  ".join("-" * w for w in widths))
+    for row in rows:
+        lines.append("  ".join(str(v).rjust(widths[i]) if i in amount_columns else str(v).ljust(widths[i]) for i, v in enumerate(row)))
+    return lines
+
+
+def main(argv: list[str]) -> int:
+    parser = Parser(prog="python -m app.report", description="Report expenses from a CSV file.")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="from_date")
+    parser.add_argument("--to", dest="to_date")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    args = parser.parse_args(argv)
+    if args.format not in ("table", "json", "csv"):
+        print(f"error: unknown format: {args.format}", file=sys.stderr)
+        return 2
+    try:
+        start = _date(args.from_date) if args.from_date else None
+        end = _date(args.to_date) if args.to_date else None
+        if start and end and start > end:
+            raise ValueError("error: --from is after --to")
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+    except (ValueError, InvalidOperation) as exc:
+        print(str(exc) if str(exc).startswith("error:") else f"error: invalid amount: {args.minimum}", file=sys.stderr)
+        return 2
+    try:
+        raw_rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    expenses = []
+    invalid = 0
+    for index, row in enumerate(raw_rows):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, TypeError, KeyError):
+            invalid += 1
+            continue
+        try:
+            day = _date(row["date"])
+        except (ValueError, TypeError, KeyError) as exc:
+            print(str(exc) if str(exc).startswith("error:") else f"error: invalid date: {row.get('date', '')}", file=sys.stderr)
+            return 2
+        expense = {"date": row["date"], "category": row["category"], "amount": amount, "note": row.get("note", ""), "_day": day, "_index": index}
+        expenses.append(expense)
+
+    categories = {x.casefold() for x in args.category}
+    expenses = [e for e in expenses if (not categories or e["category"].casefold() in categories)
+                and (not start or e["_day"] >= start) and (not end or e["_day"] <= end)
+                and (minimum is None or e["amount"] >= minimum)]
+    if args.top is not None:
+        expenses = sorted(expenses, key=lambda e: -e["amount"])[:max(args.top, 0)]
+    else:
+        expenses.sort(key=lambda e: (e["_day"], e["_index"]))
+
+    if args.by:
+        groups = {}
+        for e in expenses:
+            key = e["category"].title() if args.by == "category" else e["_day"].strftime("%Y-%m")
+            if key not in groups:
+                groups[key] = [0, Decimal(0)]
+            groups[key][0] += 1
+            groups[key][1] += e["amount"]
+        items = list(groups.items())
+        if args.by == "category":
+            items.sort(key=lambda x: (-x[1][1], x[0].casefold()))
+        else:
+            items.sort(key=lambda x: x[0])
+        total = sum((v[1] for _, v in items), Decimal(0))
+    else:
+        total = sum((e["amount"] for e in expenses), Decimal(0))
+
+    if not expenses:
+        print("No expenses.")
+    elif args.format == "json":
+        if args.by:
+            output = [{"group": key, "count": value[0], "total": float(value[1])} for key, value in items]
+        else:
+            output = [{"date": e["date"], "category": e["category"], "amount": float(e["amount"]), "note": e["note"]} for e in expenses]
+        print(json.dumps(output, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        if args.by:
+            writer.writerow(["group", "count", "total"])
+            for key, value in items:
+                writer.writerow([key, value[0], f"{value[1]:.2f}"])
+        else:
+            writer.writerow(["date", "category", "amount", "note"])
+            for e in expenses:
+                writer.writerow([e["date"], e["category"], f"{e['amount']:.2f}", e["note"]])
+    else:
+        if args.by:
+            label = "Category" if args.by == "category" else "Month"
+            rows = [[key, count, _money(subtotal, args.currency)] for key, (count, subtotal) in items]
+            lines = _table([label, "Count", "Total"], rows, (2,)) if not args.no_header else ["  ".join((r[0], str(r[1]), r[2])) for r in rows]
+        else:
+            rows = [[e["date"], e["category"], _money(e["amount"], args.currency), e["note"] if len(e["note"]) <= 24 else e["note"][:23] + "…"] for e in expenses]
+            lines = _table(["Date", "Category", "Amount", "Note"], rows, (2,)) if not args.no_header else ["  ".join(str(v) for v in r) for r in rows]
+        lines.append(f"Total{' ' * max(1, 2)}{_money(total, args.currency)}")
+        print("\n".join(lines))
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
