+"""Command-line expense reports."""
+import argparse
+import csv
+import json
+import sys
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+from app.expenses import load
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+
+
+def _parser():
+    parser = argparse.ArgumentParser(
+        description="Create a report from an expense CSV.",
+        epilog="Example: python -m app.report expenses.csv --format json",
+    )
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", dest="categories")
+    parser.add_argument("--from", dest="start", type=_date)
+    parser.add_argument("--to", dest="end", type=_date)
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _table(rows, args):
+    if args.by:
+        groups = {}
+        for row in rows:
+            key = row["category"] if args.by == "category" else row["date"][:7]
+            groups.setdefault(key, []).append(row["amount"])
+        items = [(key, len(values), sum(values, Decimal(0))) for key, values in groups.items()]
+        if args.by == "category":
+            items.sort(key=lambda item: (-item[2], item[0].casefold()))
+            heading = "Category"
+            items = [(key.title(), count, total) for key, count, total in items]
+        else:
+            items.sort(key=lambda item: item[0])
+            heading = "Month"
+        headers = [heading, "Count", "Total"]
+        body = [[key, str(count), args.currency + _money(total)] for key, count, total in items]
+    else:
+        headers = ["Date", "Category", "Amount", "Note"]
+        body = []
+        for row in rows:
+            amount = f"({args.currency}{_money(-row['amount'])})" if row["amount"] < 0 else args.currency + _money(row["amount"])
+            note = row["note"]
+            if len(note) > 24:
+                note = note[:23] + "…"
+            body.append([row["date"], row["category"], amount, note])
+    widths = [max(len(headers[i]), *(len(line[i]) for line in body)) if body else len(headers[i]) for i in range(len(headers))]
+    lines = []
+    if not args.no_header:
+        lines.extend(["  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)),
+                      "  ".join("-" * w for w in widths)])
+    for line in body:
+        lines.append("  ".join(line[i].rjust(widths[i]) if (i == (2 if args.by else 2)) else line[i].ljust(widths[i]) for i in range(len(line))))
+    total = sum((row["amount"] for row in rows), Decimal(0))
+    lines.append("Total" + " " * max(1, sum(widths) + 2 * (len(widths) - 1) - len("Total") - len(args.currency + _money(total))) + args.currency + _money(total))
+    return "\n".join(lines) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as exc:
+        return int(exc.code)
+    if args.start and args.end and args.start > args.end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+    except InvalidOperation:
+        print(f"error: invalid amount: {args.minimum}", file=sys.stderr)
+        return 2
+    try:
+        raw_rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    rows = []
+    invalid = 0
+    for position, raw in enumerate(raw_rows):
+        try:
+            amount = Decimal(raw["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, TypeError, KeyError):
+            invalid += 1
+            continue
+        rows.append({"date": raw["date"], "category": raw["category"], "amount": amount,
+                     "note": raw.get("note", ""), "position": position})
+    rows.sort(key=lambda row: (row["date"], row["position"]))
+    if args.categories:
+        categories = {name.casefold() for name in args.categories}
+        rows = [row for row in rows if row["category"].casefold() in categories]
+    if args.start:
+        rows = [row for row in rows if _date(row["date"]) >= args.start]
+    if args.end:
+        rows = [row for row in rows if _date(row["date"]) <= args.end]
+    if minimum is not None:
+        rows = [row for row in rows if row["amount"] >= minimum]
+    if args.top is not None:
+        rows = sorted(rows, key=lambda row: -row["amount"])[:max(0, args.top)]
+    if not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        if args.by:
+            groups = {}
+            for row in rows:
+                key = row["category"] if args.by == "category" else row["date"][:7]
+                groups.setdefault(key, []).append(row["amount"])
+            grouped = [{"group": key, "count": len(vals), "total": float(sum(vals, Decimal(0)))} for key, vals in groups.items()]
+            if args.by == "category":
+                grouped.sort(key=lambda item: (-item["total"], item["group"].casefold()))
+            else:
+                grouped.sort(key=lambda item: item["group"])
+            print(json.dumps(grouped, indent=2))
+        else:
+            data = [{"date": r["date"], "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in rows]
+            print(json.dumps(data, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        if args.by:
+            writer.writerow(["group", "count", "total"])
+            grouped = {}
+            for row in rows:
+                key = row["category"] if args.by == "category" else row["date"][:7]
+                grouped.setdefault(key, []).append(row["amount"])
+            for key, values in grouped.items():
+                writer.writerow([key, len(values), f"{sum(values, Decimal(0)):.2f}"])
+        else:
+            writer.writerow(["date", "category", "amount", "note"])
+            for row in rows:
+                writer.writerow([row["date"], row["category"], f"{row['amount']:.2f}", row["note"]])
+    else:
+        print(_table(rows, args), end="")
+    if invalid:
+        suffix = "" if invalid == 1 else "s"
+        print(f"warning: skipped {invalid} row{suffix} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
