+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        print(f"error: {message}", file=sys.stderr)
+        raise SystemExit(2)
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+
+
+def _parser():
+    parser = Parser(prog="python -m app.report", description="Create an expense report.", add_help=True)
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[], metavar="NAME")
+    parser.add_argument("--from", dest="start", metavar="DATE")
+    parser.add_argument("--to", dest="end", metavar="DATE")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int, metavar="N")
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by month"
+    return parser
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _table(rows, grouped, currency, no_header):
+    if grouped:
+        first = "Category" if grouped == "category" else "Month"
+        items = []
+        for key, values in grouped.items():
+            items.append((key.title() if first == "Category" else key, len(values), sum((r["value"] for r in values), Decimal(0))))
+        if first == "Category":
+            items.sort(key=lambda x: (-x[2], x[0].casefold()))
+        else:
+            items.sort(key=lambda x: x[0])
+        headers = [first, "Count", "Total"]
+        body = [[key, str(count), currency + _money(total)] for key, count, total in items]
+        total = sum((r["value"] for r in rows), Decimal(0))
+        final = ["Total", str(len(rows)), currency + _money(total)]
+    else:
+        headers = ["Date", "Category", "Amount", "Note"]
+        body = [[r["date"], r["category"], currency + (f"({_money(abs(r['value']))})" if r["value"] < 0 else _money(r["value"])), r["note"][:23] + "…" if len(r["note"]) > 24 else r["note"]] for r in rows]
+        final = ["Total", "", currency + _money(sum((r["value"] for r in rows), Decimal(0))), ""]
+    widths = [max(len(headers[i]), *(len(row[i]) for row in body), len(final[i])) for i in range(len(headers))]
+    lines = []
+    if not no_header:
+        lines.append("  ".join(h.ljust(widths[i]) if i != 2 or grouped else h.rjust(widths[i]) for i, h in enumerate(headers)))
+        lines.append("  ".join("-" * width for width in widths))
+    for row in body:
+        lines.append("  ".join((row[i].rjust(widths[i]) if (i == 2 and not grouped) or (grouped and i == 2) else row[i].ljust(widths[i])) for i in range(len(headers))))
+    lines.append("  ".join(final[i].ljust(widths[i]) if i != len(final)-1 else final[i].rjust(widths[i]) for i in range(len(final))))
+    return "\n".join(lines) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as exc:
+        return int(exc.code)
+    try:
+        args.start = date.fromisoformat(args.start) if args.start else None
+    except ValueError:
+        print(f"error: invalid date: {args.start}", file=sys.stderr)
+        return 2
+    try:
+        args.end = date.fromisoformat(args.end) if args.end else None
+    except ValueError:
+        print(f"error: invalid date: {args.end}", file=sys.stderr)
+        return 2
+    if args.start and args.end and args.start > args.end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        source = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    rows, invalid = [], 0
+    for index, row in enumerate(source):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, ValueError, TypeError):
+            invalid += 1
+            continue
+        try:
+            parsed = date.fromisoformat(row["date"])
+        except (TypeError, ValueError):
+            print(f"error: invalid date: {row.get('date', '')}", file=sys.stderr)
+            return 2
+        rows.append({**row, "value": amount, "parsed": parsed, "order": index})
+    rows.sort(key=lambda row: row["parsed"])
+    categories = {name.casefold() for name in args.category}
+    if categories:
+        rows = [r for r in rows if r["category"].casefold() in categories]
+    if args.start:
+        rows = [r for r in rows if r["parsed"] >= args.start]
+    if args.end:
+        rows = [r for r in rows if r["parsed"] <= args.end]
+    if args.minimum is not None:
+        try:
+            minimum = Decimal(args.minimum)
+            if not minimum.is_finite():
+                raise InvalidOperation
+        except InvalidOperation:
+            print(f"error: invalid amount: {args.minimum}", file=sys.stderr)
+            return 2
+        rows = [r for r in rows if r["value"] >= minimum]
+    if args.top is not None:
+        rows = sorted(rows, key=lambda r: r["value"], reverse=True)[:max(0, args.top)]
+    if not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        if args.by:
+            groups = {}
+            for r in rows:
+                key = r["category"] if args.by == "category" else r["date"][:7]
+                groups.setdefault(key, []).append(r)
+            entries = [{"group": key, "count": len(vals), "total": float(sum((r["value"] for r in vals), Decimal(0)))} for key, vals in groups.items()]
+            if args.by == "category":
+                entries.sort(key=lambda x: (-x["total"], x["group"].casefold()))
+            else:
+                entries.sort(key=lambda x: x["group"])
+        else:
+            entries = [{"date": r["date"], "category": r["category"], "amount": float(r["value"]), "note": r["note"]} for r in rows]
+        print(json.dumps(entries, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        for r in rows:
+            writer.writerow([r["date"], r["category"], f"{r['value']:.2f}", r["note"]])
+    else:
+        grouped = None
+        if args.by:
+            grouped = {}
+            for r in rows:
+                key = r["category"] if args.by == "category" else r["date"][:7]
+                grouped.setdefault(key, []).append(r)
+        print(_table(rows, grouped, args.currency, args.no_header), end="")
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
