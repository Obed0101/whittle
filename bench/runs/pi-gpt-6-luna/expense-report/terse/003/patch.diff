+"""Render expense CSV files as human- or machine-readable reports."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        self.print_usage(sys.stderr)
+        self.exit(2, f"error: {message}\n")
+
+
+def _date_value(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+
+
+def _money(value, currency=""):
+    amount = Decimal(value)
+    if amount < 0:
+        return f"{currency}({abs(amount):,.2f})"
+    return f"{currency}{amount:,.2f}"
+
+
+def _table(headers, rows, amount_columns=()):
+    widths = [len(str(h)) for h in headers]
+    for row in rows:
+        for i, value in enumerate(row):
+            widths[i] = max(widths[i], len(str(value)))
+    lines = []
+    lines.append("  ".join(str(v).rjust(widths[i]) if i in amount_columns else str(v).ljust(widths[i]) for i, v in enumerate(headers)))
+    lines.append("  ".join("-" * width for width in widths))
+    lines.extend("  ".join(str(v).rjust(widths[i]) if i in amount_columns else str(v).ljust(widths[i]) for i, v in enumerate(row)) for row in rows)
+    return lines
+
+
+def main(argv: list[str]) -> int:
+    parser = Parser(prog="python -m app.report", description="Report expenses from a CSV file.")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="from_date", type=_date_value)
+    parser.add_argument("--to", dest="to_date", type=_date_value)
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by category"
+    args = parser.parse_args(argv)
+
+    if args.from_date and args.to_date and args.from_date > args.to_date:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+    except InvalidOperation:
+        print(f"error: invalid amount: {args.minimum}", file=sys.stderr)
+        return 2
+    try:
+        source = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    rows = []
+    skipped = 0
+    for index, raw in enumerate(source):
+        try:
+            amount = Decimal(raw["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, KeyError, TypeError):
+            skipped += 1
+            continue
+        try:
+            row_date = date.fromisoformat(raw["date"])
+        except (ValueError, TypeError, KeyError):
+            row_date = None
+        row = {"date": raw.get("date", ""), "category": raw.get("category", ""), "amount": amount, "note": raw.get("note", "")}
+        row["_date"] = row_date
+        row["_index"] = index
+        rows.append(row)
+    rows.sort(key=lambda r: (r["_date"] is None, r["_date"] or date.max, r["_index"]))
+
+    categories = {name.casefold() for name in args.category}
+    if categories:
+        rows = [r for r in rows if r["category"].casefold() in categories]
+    if args.from_date:
+        rows = [r for r in rows if r["_date"] is not None and r["_date"] >= args.from_date]
+    if args.to_date:
+        rows = [r for r in rows if r["_date"] is not None and r["_date"] <= args.to_date]
+    if minimum is not None:
+        rows = [r for r in rows if r["amount"] >= minimum]
+    if args.top is not None:
+        rows = sorted(rows, key=lambda r: r["amount"], reverse=True)[:max(0, args.top)]
+
+    if not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        if args.by:
+            groups = _groups(rows, args.by)
+            output = [{"group": key, "count": len(items), "total": float(sum((r["amount"] for r in items), Decimal(0)))} for key, items in groups]
+        else:
+            output = [{"date": r["date"], "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in rows]
+        print(json.dumps(output, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        if args.by:
+            writer.writerow(["group", "count", "total"])
+            for key, items in _groups(rows, args.by):
+                writer.writerow([key, len(items), f"{sum((r['amount'] for r in items), Decimal(0)):.2f}"])
+        else:
+            writer.writerow(["date", "category", "amount", "note"])
+            for r in rows:
+                writer.writerow([r["date"], r["category"], f"{r['amount']:.2f}", r["note"]])
+    elif args.by:
+        groups = _groups(rows, args.by)
+        label = "Category" if args.by == "category" else "Month"
+        lines = [] if args.no_header else ["  ".join((label, "Count", "Total")), "-" * len(label) + "  -----  -----"]
+        lines.extend(f"{key.title() if args.by == 'category' else key}  {len(items)}  {_money(sum((r['amount'] for r in items), Decimal(0)), args.currency)}" for key, items in groups)
+        lines.append(f"Total  {len(rows)}  {_money(sum((r['amount'] for r in rows), Decimal(0)), args.currency)}")
+        print("\n".join(lines))
+    else:
+        display = [[r["date"], r["category"], _money(r["amount"], args.currency), r["note"] if len(r["note"]) <= 24 else r["note"][:23] + "…"] for r in rows]
+        lines = [] if args.no_header else _table(["Date", "Category", "Amount", "Note"], [], (2,))
+        # Use a shared layout so the amount column remains right-aligned.
+        if not args.no_header:
+            lines = _table(["Date", "Category", "Amount", "Note"], display, (2,))[:2]
+        lines.extend(_table(["Date", "Category", "Amount", "Note"], display, (2,))[2:])
+        lines.append(f"Total  {_money(sum((r['amount'] for r in rows), Decimal(0)), args.currency)}")
+        print("\n".join(lines))
+
+    if skipped:
+        noun = "row" if skipped == 1 else "rows"
+        print(f"warning: skipped {skipped} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _groups(rows, by):
+    grouped = {}
+    for row in rows:
+        key = row["category"] if by == "category" else row["date"][:7]
+        grouped.setdefault(key, []).append(row)
+    if by == "category":
+        return sorted(grouped.items(), key=lambda pair: (-sum((r["amount"] for r in pair[1]), Decimal(0)), pair[0].casefold()))
+    return sorted(grouped.items())
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
