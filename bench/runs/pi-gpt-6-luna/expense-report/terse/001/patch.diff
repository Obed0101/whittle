--- /dev/null
+++ b/app/report.py
@@ -0,0 +1,155 @@
+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _date(value):
+    try:
+        parsed = date.fromisoformat(value)
+        if parsed.isoformat() != value:
+            raise ValueError
+        return parsed
+    except (TypeError, ValueError):
+        raise ValueError(value)
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Create a report from an expense CSV.", epilog="Example: python -m app.report expenses.csv --from 2026-01-01 --format json")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", dest="categories")
+    parser.add_argument("--from", dest="start")
+    parser.add_argument("--to", dest="end")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", dest="format", default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _money(amount, currency=""):
+    if amount < 0:
+        return f"({currency}{abs(amount):,.2f})"
+    return f"{currency}{amount:,.2f}"
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as exc:
+        return int(exc.code)
+    if args.format not in ("table", "json", "csv"):
+        print(f"error: unknown format: {args.format}", file=sys.stderr)
+        return 2
+    try:
+        start = _date(args.start) if args.start else None
+        end = _date(args.end) if args.end else None
+    except ValueError as exc:
+        print(f"error: invalid date: {exc.args[0]}", file=sys.stderr)
+        return 2
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    valid = []
+    skipped = 0
+    for index, row in enumerate(rows):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, TypeError, KeyError):
+            skipped += 1
+            continue
+        try:
+            day = _date(row["date"])
+        except (ValueError, KeyError):
+            print(f"error: invalid date: {row.get('date', '')}", file=sys.stderr)
+            return 2
+        valid.append((day, index, row, amount))
+
+    categories = {name.casefold() for name in (args.categories or [])}
+    filtered = [item for item in valid
+                if (not categories or item[2].get("category", "").casefold() in categories)
+                and (start is None or item[0] >= start)
+                and (end is None or item[0] <= end)
+                and (args.minimum is None or item[3] >= _decimal_min(args.minimum))]
+    filtered.sort(key=lambda item: (item[0], item[1]))
+    if args.top is not None:
+        filtered = sorted(filtered, key=lambda item: item[3], reverse=True)[:max(args.top, 0)]
+
+    if args.by:
+        groups = {}
+        for day, _, row, amount in filtered:
+            key = row.get("category", "") if args.by == "category" else day.strftime("%Y-%m")
+            count, total = groups.get(key, (0, Decimal(0)))
+            groups[key] = (count + 1, total + amount)
+        if args.by == "category":
+            output = sorted(groups.items(), key=lambda pair: (-pair[1][1], pair[0].casefold()))
+        else:
+            output = sorted(groups.items())
+        if not output:
+            print("No expenses.")
+        elif args.format == "json":
+            print(json.dumps([{"group": key, "count": count, "total": float(total)} for key, (count, total) in output], indent=2))
+        elif args.format == "csv":
+            writer = csv.writer(sys.stdout, lineterminator="\n")
+            writer.writerow(["group", "count", "total"])
+            for key, (count, total) in output:
+                writer.writerow([key, count, f"{total:.2f}"])
+        else:
+            first = "Category" if args.by == "category" else "Month"
+            display = [(key.title() if args.by == "category" else key, count, total) for key, (count, total) in output]
+            _print_table([first, "Count", "Total"], [[k, str(n), _money(t, args.currency)] for k, n, t in display], sum(x[1] for x in groups.values()), args.no_header, total_label=True, currency=args.currency)
+    else:
+        if not filtered:
+            print("No expenses.")
+        elif args.format == "json":
+            print(json.dumps([{"date": row["date"], "category": row["category"], "amount": float(amount), "note": row.get("note", "")} for _, _, row, amount in filtered], indent=2))
+        elif args.format == "csv":
+            writer = csv.writer(sys.stdout, lineterminator="\n")
+            writer.writerow(["date", "category", "amount", "note"])
+            for _, _, row, amount in filtered:
+                writer.writerow([row["date"], row["category"], f"{amount:.2f}", row.get("note", "")])
+        else:
+            data = [[row["date"], row["category"], _money(amount, args.currency), (row.get("note", "")[:23] + "…") if len(row.get("note", "")) > 24 else row.get("note", "")] for _, _, row, amount in filtered]
+            _print_table(["Date", "Category", "Amount", "Note"], data, sum((item[3] for item in filtered), Decimal(0)), args.no_header, currency=args.currency)
+    if skipped:
+        noun = "row" if skipped == 1 else "rows"
+        print(f"warning: skipped {skipped} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _decimal_min(value):
+    try:
+        return Decimal(value)
+    except InvalidOperation:
+        return Decimal("Infinity")
+
+
+def _print_table(headers, rows, total, no_header, total_label=False, currency=""):
+    total_row = ["Total", "", _money(total, currency)] if total_label else ["Total", "", _money(total, currency), ""]
+    widths = [max(len(headers[i]), *(len(row[i]) for row in rows), len(total_row[i])) for i in range(len(headers))]
+    if not no_header:
+        print("  ".join(headers[i].ljust(widths[i]) for i in range(len(headers))))
+        print("  ".join("-" * widths[i] for i in range(len(headers))))
+    for row in rows:
+        print("  ".join(row[i].rjust(widths[i]) if headers[i] in ("Amount", "Total", "Count") else row[i].ljust(widths[i]) for i in range(len(headers))))
+    print("  ".join(total_row[i].rjust(widths[i]) if i == (2 if total_label else 2) else total_row[i].ljust(widths[i]) for i in range(len(headers))))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
