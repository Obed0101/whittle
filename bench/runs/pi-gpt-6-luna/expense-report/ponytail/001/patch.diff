+"""Print expense reports from CSV files."""
+import argparse
+import csv
+import json
+import sys
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+from .expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="from_date")
+    parser.add_argument("--to", dest="to_date")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by category"
+    return parser
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise ValueError(value)
+
+
+def _money(value):
+    try:
+        result = Decimal(value)
+        if not result.is_finite():
+            raise InvalidOperation
+        return result
+    except (InvalidOperation, TypeError, ValueError):
+        return None
+
+
+def _table(headers, rows, right=()):
+    widths = [max(len(str(h)), *(len(str(row[i])) for row in rows)) for i, h in enumerate(headers)]
+    lines = []
+    lines.append("  ".join(str(h).rjust(widths[i]) if i in right else str(h).ljust(widths[i]) for i, h in enumerate(headers)).rstrip())
+    lines.append("  ".join("-" * width for width in widths).rstrip())
+    for row in rows:
+        lines.append("  ".join(str(value).rjust(widths[i]) if i in right else str(value).ljust(widths[i]) for i, value in enumerate(row)).rstrip())
+    return "\n".join(lines)
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    if args.format not in ("table", "json", "csv"):
+        print(f"error: unknown format: {args.format}", file=sys.stderr)
+        return 2
+    try:
+        start = _date(args.from_date) if args.from_date else None
+        end = _date(args.to_date) if args.to_date else None
+    except ValueError as exc:
+        print(f"error: invalid date: {exc.args[0]}", file=sys.stderr)
+        return 2
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        records = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    entries, invalid = [], 0
+    for index, row in enumerate(records):
+        amount = _money(row.get("amount"))
+        if amount is None:
+            invalid += 1
+            continue
+        try:
+            day = _date(row.get("date"))
+        except ValueError:
+            print(f"error: invalid date: {row.get('date')}", file=sys.stderr)
+            return 2
+        entries.append({**row, "_date": day, "_amount": amount, "_index": index})
+    entries.sort(key=lambda item: (item["_date"], item["_index"]))
+    categories = {name.casefold() for name in args.category}
+    if args.minimum is not None:
+        minimum = _money(args.minimum)
+        if minimum is None:
+            parser.error("--min must be a number")
+    else:
+        minimum = None
+    entries = [e for e in entries if (not categories or e.get("category", "").casefold() in categories)
+               and (start is None or e["_date"] >= start) and (end is None or e["_date"] <= end)
+               and (minimum is None or e["_amount"] >= minimum)]
+    if args.top is not None:
+        entries = sorted(entries, key=lambda e: e["_amount"], reverse=True)[:max(0, args.top)]
+    total = sum((e["_amount"] for e in entries), Decimal(0))
+
+    if args.format == "json":
+        if args.by:
+            groups = _groups(entries, args.by)
+            payload = [{"group": key, "count": len(values), "total": float(sum((e["_amount"] for e in values), Decimal(0)))} for key, values in groups]
+        else:
+            payload = [{"date": e["date"], "category": e["category"], "amount": float(e["_amount"]), "note": e.get("note", "")} for e in entries]
+        print(json.dumps(payload, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(("date", "category", "amount", "note"))
+        for e in entries:
+            writer.writerow((e["date"], e["category"], f'{e["_amount"]:.2f}', e.get("note", "")))
+    elif not entries:
+        print("No expenses.")
+    elif args.by:
+        groups = _groups(entries, args.by)
+        if args.by == "category":
+            groups.sort(key=lambda pair: (-sum((e["_amount"] for e in pair[1]), Decimal(0)), pair[0].casefold()))
+            heading = "Category"
+            labels = [key.title() for key, _ in groups]
+        else:
+            groups.sort(key=lambda pair: pair[0])
+            heading, labels = "Month", [key for key, _ in groups]
+        rows = [[label, str(len(values)), _format_amount(sum((e["_amount"] for e in values), Decimal(0)), args.currency)] for label, (_, values) in zip(labels, groups)]
+        if args.no_header:
+            print("\n".join("  ".join(row) for row in rows))
+        else:
+            print(_table((heading, "Count", "Total"), rows, (1, 2)))
+        print(f"Total  {_format_amount(total, args.currency)}")
+    else:
+        rows = []
+        for e in entries:
+            note = e.get("note", "")
+            if len(note) > 24:
+                note = note[:23] + "…"
+            rows.append((e["date"], e.get("category", ""), _format_amount(e["_amount"], args.currency), note))
+        if args.no_header:
+            text = "\n".join("  ".join(str(v) for v in row) for row in rows)
+        else:
+            text = _table(("Date", "Category", "Amount", "Note"), rows, (2,))
+        print(text)
+        print(f"Total  {_format_amount(total, args.currency)}")
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _format_amount(amount, currency=""):
+    if amount < 0:
+        return f"{currency}({abs(amount):,.2f})"
+    return f"{currency}{amount:,.2f}"
+
+
+def _groups(entries, by):
+    key = (lambda e: e.get("category", "")) if by == "category" else (lambda e: e["date"][:7])
+    result = {}
+    for entry in entries:
+        result.setdefault(key(entry), []).append(entry)
+    return list(result.items())
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
