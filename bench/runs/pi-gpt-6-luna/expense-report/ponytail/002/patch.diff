+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        self.print_usage(sys.stderr)
+        self.exit(2, f"error: {message}\n")
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+
+
+def main(argv: list[str]) -> int:
+    parser = Parser(prog="python -m app.report")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="start", type=_date)
+    parser.add_argument("--to", dest="end", type=_date)
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by category"
+    try:
+        args = parser.parse_args(argv)
+        if args.start and args.end and args.start > args.end:
+            print("error: --from is after --to", file=sys.stderr)
+            return 2
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+        if args.top is not None and args.top < 0:
+            raise ValueError("--top must be non-negative")
+        rows = load(args.path)
+    except FileNotFoundError:
+        path = argv[0] if argv else ""
+        print(f"error: file not found: {path}", file=sys.stderr)
+        return 2
+    except argparse.ArgumentError:
+        return 2
+    except SystemExit as exc:
+        return int(exc.code)
+    except (InvalidOperation, ValueError) as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 2
+
+    valid = []
+    invalid = 0
+    for index, row in enumerate(rows):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, TypeError, KeyError):
+            invalid += 1
+            continue
+        try:
+            day = date.fromisoformat(row["date"])
+        except (ValueError, TypeError, KeyError):
+            print(f"error: invalid date: {row.get('date', '')}", file=sys.stderr)
+            return 2
+        valid.append((day, index, row, amount))
+
+    categories = {name.casefold() for name in args.category}
+    selected = [item for item in valid if
+                (not categories or item[2]["category"].casefold() in categories)
+                and (not args.start or item[0] >= args.start)
+                and (not args.end or item[0] <= args.end)
+                and (minimum is None or item[3] >= minimum)]
+    if args.top is not None:
+        selected = sorted(selected, key=lambda item: item[3], reverse=True)[:args.top]
+
+    if args.by:
+        groups = {}
+        for day, _, row, amount in selected:
+            key = row["category"].title() if args.by == "category" else day.strftime("%Y-%m")
+            count, total = groups.get(key, (0, Decimal(0)))
+            groups[key] = count + 1, total + amount
+        if args.by == "category":
+            output = sorted(groups.items(), key=lambda pair: (-pair[1][1], pair[0].casefold()))
+        else:
+            output = sorted(groups.items())
+    else:
+        selected.sort(key=lambda item: (item[0], item[1]))
+        output = selected
+
+    if not output:
+        print("No expenses.")
+    elif args.format == "json":
+        if args.by:
+            data = [{"group": key, "count": count, "total": float(total)} for key, (count, total) in output]
+        else:
+            data = [{"date": row["date"], "category": row["category"], "amount": float(amount), "note": row["note"]}
+                    for _, _, row, amount in output]
+        print(json.dumps(data, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        if args.by:
+            writer.writerow(["group", "count", "total"])
+            for key, (count, total) in output:
+                writer.writerow([key, count, f"{total:.2f}"])
+        else:
+            writer.writerow(["date", "category", "amount", "note"])
+            for _, _, row, amount in output:
+                writer.writerow([row["date"], row["category"], f"{amount:.2f}", row["note"]])
+    else:
+        if args.by:
+            headers = ["Category" if args.by == "category" else "Month", "Count", "Total"]
+            body = [[key, str(count), f"{args.currency}{total:,.2f}"] for key, (count, total) in output]
+            total = sum((values[1] for _, values in output), Decimal(0))
+        else:
+            headers = ["Date", "Category", "Amount", "Note"]
+            body = []
+            total = sum((amount for _, _, _, amount in output), Decimal(0))
+            for day, _, row, amount in output:
+                formatted = f"{abs(amount):,.2f}"
+                formatted = f"({formatted})" if amount < 0 else formatted
+                note = row["note"]
+                if len(note) > 24:
+                    note = note[:23] + "…"
+                body.append([day.isoformat(), row["category"], f"{args.currency}{formatted}", note])
+        widths = [max(len(headers[i]), *(len(row[i]) for row in body)) for i in range(len(headers))]
+        if not args.no_header:
+            print("  ".join(headers[i].ljust(widths[i]) for i in range(len(headers))))
+            print("  ".join("-" * width for width in widths))
+        for row in body:
+            if args.by:
+                print("  ".join(row[i].rjust(widths[i]) if i else row[i].ljust(widths[i]) for i in range(len(row))))
+            else:
+                print("  ".join(row[i].rjust(widths[i]) if i == 2 else row[i].ljust(widths[i]) for i in range(len(row))))
+        print(f"Total{' ' * max(1, widths[0] - 5)}  " + "  ".join(["" for _ in headers[1:-1]]) + f"{args.currency}{total:,.2f}")
+
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
