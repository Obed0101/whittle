+"""Render expense CSV files as table, JSON, or CSV reports."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        self.print_usage(sys.stderr)
+        print(f"error: {message}", file=sys.stderr)
+        raise SystemExit(2)
+
+
+def _parser():
+    parser = Parser(prog="python -m app.report", description="Report expenses from a CSV file.")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[], metavar="NAME", help="keep this category (repeatable)")
+    parser.add_argument("--from", dest="start", metavar="DATE", help="include expenses on or after YYYY-MM-DD")
+    parser.add_argument("--to", dest="end", metavar="DATE", help="include expenses on or before YYYY-MM-DD")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT", help="minimum expense amount")
+    parser.add_argument("--by", choices=("category", "month"), help="group by category or month")
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table", help="output format")
+    parser.add_argument("--currency", default="", metavar="SYMBOL", help="table currency symbol")
+    parser.add_argument("--top", type=int, metavar="N", help="show the N largest expenses")
+    parser.add_argument("--no-header", action="store_true", help="omit table header")
+    parser.epilog = "Example: python -m app.report expenses.csv --by month"
+    return parser
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (ValueError, TypeError):
+        raise ValueError(f"invalid date: {value}")
+
+
+def _money(value):
+    try:
+        result = Decimal(value)
+        if not result.is_finite():
+            raise InvalidOperation
+        return result
+    except (InvalidOperation, TypeError, ValueError):
+        return None
+
+
+def _format_amount(amount, currency=""):
+    value = f"{abs(amount):,.2f}"
+    return f"({currency}{value})" if amount < 0 else f"{currency}{value}"
+
+
+def _table(headers, rows, total, currency="", no_header=False):
+    widths = [max(len(str(header)), *(len(str(row[i])) for row in rows)) for i, header in enumerate(headers)]
+    amount_col = 2 if headers == ["Date", "Category", "Amount", "Note"] else None
+    output = []
+    if not no_header:
+        output.extend(["  ".join(str(h).ljust(widths[i]) for i, h in enumerate(headers)),
+                       "  ".join("-" * width for width in widths)])
+    for row in rows:
+        output.append("  ".join((str(value).rjust(widths[i]) if i == amount_col else str(value).ljust(widths[i])) for i, value in enumerate(row)))
+    total_text = _format_amount(total, currency)
+    output.append(f"Total{' ' * max(1, sum(widths) + 2 * (len(widths) - 1) - len('Total') - len(total_text))}{total_text}")
+    return "\n".join(output) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    try:
+        start = _date(args.start) if args.start else None
+        end = _date(args.end) if args.end else None
+        if start and end and start > end:
+            raise ValueError("--from is after --to")
+        minimum = _money(args.minimum) if args.minimum is not None else None
+        if args.minimum is not None and minimum is None:
+            raise ValueError(f"invalid minimum amount: {args.minimum}")
+        rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except ValueError as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 2
+
+    expenses = []
+    invalid = 0
+    for index, row in enumerate(rows):
+        amount = _money(row.get("amount"))
+        if amount is None:
+            invalid += 1
+            continue
+        expenses.append({**row, "_amount": amount, "_index": index})
+    selected = expenses
+    if args.category:
+        categories = {category.casefold() for category in args.category}
+        selected = [r for r in selected if r.get("category", "").casefold() in categories]
+    if start:
+        selected = [r for r in selected if r.get("date", "") >= start.isoformat()]
+    if end:
+        selected = [r for r in selected if r.get("date", "") <= end.isoformat()]
+    if minimum is not None:
+        selected = [r for r in selected if r["_amount"] >= minimum]
+    if args.top is not None:
+        selected = sorted(selected, key=lambda r: r["_amount"], reverse=True)[:max(0, args.top)]
+    if not selected:
+        print("No expenses.")
+    elif args.by:
+        groups = {}
+        for row in selected:
+            key = row.get("category", "") if args.by == "category" else row.get("date", "")[:7]
+            if args.by == "category":
+                key = key.title()
+            groups.setdefault(key, []).append(row)
+        grouped = [(key, len(items), sum((r["_amount"] for r in items), Decimal(0))) for key, items in groups.items()]
+        if args.by == "category":
+            grouped.sort(key=lambda item: (-item[2], item[0].casefold()))
+        else:
+            grouped.sort(key=lambda item: item[0])
+        total = sum((r["_amount"] for r in selected), Decimal(0))
+        if args.format == "json":
+            print(json.dumps([{"group": k, "count": n, "total": float(t)} for k, n, t in grouped], indent=2))
+        elif args.format == "csv":
+            writer = csv.writer(sys.stdout, lineterminator="\n")
+            writer.writerow(["group", "count", "total"])
+            writer.writerows((k, n, f"{t:.2f}") for k, n, t in grouped)
+        else:
+            headers = ["Category" if args.by == "category" else "Month", "Count", "Total"]
+            table_rows = [(k, str(n), _format_amount(t, args.currency)) for k, n, t in grouped]
+            print(_table(headers, table_rows, total, args.currency, args.no_header), end="")
+    else:
+        if args.format == "json":
+            print(json.dumps([{k: r.get(k, "") if k != "amount" else float(r["_amount"]) for k in ("date", "category", "amount", "note")} for r in sorted(selected, key=lambda r: (r.get("date", ""), r["_index"]))], indent=2))
+        elif args.format == "csv":
+            writer = csv.writer(sys.stdout, lineterminator="\n")
+            writer.writerow(["date", "category", "amount", "note"])
+            for r in sorted(selected, key=lambda r: (r.get("date", ""), r["_index"])):
+                writer.writerow([r.get("date", ""), r.get("category", ""), f"{r['_amount']:.2f}", r.get("note", "")])
+        else:
+            selected = sorted(selected, key=lambda r: (r.get("date", ""), r["_index"]))
+            table_rows = [(r.get("date", ""), r.get("category", ""), _format_amount(r["_amount"], args.currency), (r.get("note", "")[:23] + "…") if len(r.get("note", "")) > 24 else r.get("note", "")) for r in selected]
+            print(_table(["Date", "Category", "Amount", "Note"], table_rows, sum((r["_amount"] for r in selected), Decimal(0)), args.currency, args.no_header), end="")
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
