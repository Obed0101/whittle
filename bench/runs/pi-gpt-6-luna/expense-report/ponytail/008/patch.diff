+"""Print expense reports from CSV files."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        self.print_usage(sys.stderr)
+        self.exit(2, f"error: {message}\n")
+
+
+def main(argv: list[str]) -> int:
+    parser = Parser(prog="python -m app.report", epilog="Example: python -m app.report expenses.csv --by month")
+    parser.add_argument("path", nargs="?")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="date_from")
+    parser.add_argument("--to", dest="date_to")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    args = parser.parse_args(argv)
+    if not args.path:
+        parser.error("the following arguments are required: PATH")
+
+    for value in (args.date_from, args.date_to):
+        if value and not _valid_date(value):
+            print(f"error: invalid date: {value}", file=sys.stderr)
+            return 2
+    start = date.fromisoformat(args.date_from) if args.date_from else None
+    end = date.fromisoformat(args.date_to) if args.date_to else None
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+    except InvalidOperation:
+        parser.error("invalid --min amount")
+
+    try:
+        rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    valid, skipped = [], 0
+    for index, row in enumerate(rows):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, KeyError, TypeError):
+            skipped += 1
+            continue
+        row = dict(row, _amount=amount, _index=index)
+        valid.append(row)
+
+    categories = {name.casefold() for name in args.category}
+    selected = []
+    for row in valid:
+        try:
+            row_date = date.fromisoformat(row["date"])
+        except (ValueError, KeyError):
+            continue
+        if categories and row["category"].casefold() not in categories:
+            continue
+        if start and row_date < start or end and row_date > end:
+            continue
+        if minimum is not None and row["_amount"] < minimum:
+            continue
+        row["_date"] = row_date
+        selected.append(row)
+
+    if args.top is not None:
+        selected = sorted(selected, key=lambda r: (-r["_amount"], r["_index"]))[:max(0, args.top)]
+    elif not args.by:
+        selected.sort(key=lambda r: (r["_date"], r["_index"]))
+
+    if args.by:
+        groups = {}
+        for row in selected:
+            key = row["category"].title() if args.by == "category" else row["_date"].strftime("%Y-%m")
+            groups.setdefault(key, []).append(row)
+        grouped = [(key, len(items), sum((r["_amount"] for r in items), Decimal(0))) for key, items in groups.items()]
+        if args.by == "category":
+            grouped.sort(key=lambda g: (-g[2], g[0].casefold()))
+        else:
+            grouped.sort(key=lambda g: g[0])
+
+    if not selected:
+        print("No expenses.")
+    elif args.format == "json":
+        if args.by:
+            output = [{"group": key, "count": count, "total": float(total)} for key, count, total in grouped]
+        else:
+            output = [{"date": r["date"], "category": r["category"], "amount": float(r["_amount"]), "note": r["note"]} for r in selected]
+        print(json.dumps(output, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(("date", "category", "amount", "note"))
+        for r in selected:
+            writer.writerow((r["date"], r["category"], f'{r["_amount"]:.2f}', r["note"]))
+    else:
+        total = sum((r["_amount"] for r in selected), Decimal(0))
+        if args.by:
+            headers = ("Category" if args.by == "category" else "Month", "Count", "Total")
+            lines = [(key, str(count), _money(value, args.currency)) for key, count, value in grouped]
+            widths = [max(len(headers[i]), *(len(line[i]) for line in lines)) for i in range(3)]
+            if not args.no_header:
+                print("  ".join(headers[i].ljust(widths[i]) for i in range(3)))
+                print("  ".join("-" * widths[i] for i in range(3)))
+            for line in lines:
+                print("  ".join(line[i].ljust(widths[i]) for i in range(2)) + "  " + line[2].rjust(widths[2]))
+            print(f"Total  {len(selected)}  {_money(total, args.currency)}")
+        else:
+            headers = ("Date", "Category", "Amount", "Note")
+            lines = [(r["date"], r["category"], _money(r["_amount"], args.currency), r["note"] if len(r["note"]) <= 24 else r["note"][:23] + "…") for r in selected]
+            widths = [max(len(headers[i]), *(len(line[i]) for line in lines)) for i in range(4)]
+            if not args.no_header:
+                print("  ".join(headers[i].ljust(widths[i]) for i in range(4)))
+                print("  ".join("-" * widths[i] for i in range(4)))
+            for line in lines:
+                print("  ".join(line[i].rjust(widths[i]) if i == 2 else line[i].ljust(widths[i]) for i in range(4)))
+            print(f"Total  {'':<{widths[1]}}  {_money(total, args.currency).rjust(widths[2])}")
+
+    if skipped:
+        print(f"warning: skipped {skipped} row{'s' if skipped != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _valid_date(value):
+    try:
+        parsed = date.fromisoformat(value)
+        return parsed.isoformat() == value
+    except ValueError:
+        return False
+
+
+def _money(amount, currency):
+    rendered = f"{abs(amount):,.2f}"
+    return f"{currency}({rendered})" if amount < 0 else f"{currency}{rendered}"
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
