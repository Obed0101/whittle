+"""Render expense CSV files as tables or machine-readable reports."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _date(value):
+    try:
+        parsed = date.fromisoformat(value)
+        if parsed.isoformat() != value:
+            raise ValueError
+        return parsed
+    except (TypeError, ValueError):
+        raise argparse.ArgumentTypeError(f"error: invalid date: {value}")
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="date_from", type=_date)
+    parser.add_argument("--to", dest="date_to", type=_date)
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by category"
+    return parser
+
+
+def _money(value, currency=""):
+    value = Decimal(value)
+    if value < 0:
+        return f"({currency}{abs(value):,.2f})"
+    return f"{currency}{value:,.2f}"
+
+
+def _table(headers, rows, total, no_header, amount_column):
+    strings = [[str(item) for item in row] for row in rows]
+    widths = [len(h) for h in headers]
+    for row in strings:
+        widths = [max(w, len(item)) for w, item in zip(widths, row)]
+    lines = []
+    if not no_header:
+        lines.append("  ".join(h.rjust(widths[i]) if i == amount_column else h.ljust(widths[i]) for i, h in enumerate(headers)).rstrip())
+        lines.append("  ".join("-" * w for w in widths).rstrip())
+    for row in strings:
+        lines.append("  ".join(item.rjust(widths[i]) if i == amount_column else item.ljust(widths[i]) for i, item in enumerate(row)).rstrip())
+    end = _money(total)
+    lines.append("Total" + " " * max(1, sum(widths) + 2 * (len(widths) - 1) - len("Total") - len(end)) + end)
+    return "\n".join(lines) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as exc:
+        return int(exc.code)
+    if args.date_from and args.date_to and args.date_from > args.date_to:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        raw_rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    rows, invalid = [], 0
+    for index, row in enumerate(raw_rows):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (KeyError, InvalidOperation, TypeError, ValueError):
+            invalid += 1
+            continue
+        try:
+            day = date.fromisoformat(row["date"])
+        except (KeyError, TypeError, ValueError):
+            continue
+        rows.append({"date": day, "category": row.get("category", ""), "amount": amount, "note": row.get("note", ""), "index": index})
+    categories = {name.casefold() for name in args.category}
+    rows = [r for r in rows if (not categories or r["category"].casefold() in categories)
+            and (args.date_from is None or r["date"] >= args.date_from)
+            and (args.date_to is None or r["date"] <= args.date_to)
+            and (args.minimum is None or r["amount"] >= Decimal(args.minimum))]
+    if args.top is not None:
+        rows = sorted(rows, key=lambda r: (-r["amount"], r["index"]))[:max(0, args.top)]
+    else:
+        rows.sort(key=lambda r: (r["date"], r["index"]))
+    if not rows:
+        print("No expenses.")
+    elif args.by:
+        groups = {}
+        for r in rows:
+            key = r["category"].title() if args.by == "category" else r["date"].strftime("%Y-%m")
+            if key not in groups:
+                groups[key] = [0, Decimal(0)]
+            groups[key][0] += 1
+            groups[key][1] += r["amount"]
+        items = list(groups.items())
+        if args.by == "category":
+            items.sort(key=lambda x: (-x[1][1], x[0].casefold()))
+        else:
+            items.sort(key=lambda x: x[0])
+        total = sum((r["amount"] for r in rows), Decimal(0))
+        if args.format == "json":
+            print(json.dumps([{"group": k, "count": v[0], "total": float(v[1])} for k, v in items], indent=2))
+        elif args.format == "csv":
+            writer = csv.writer(sys.stdout, lineterminator="\n")
+            writer.writerow(["group", "count", "total"])
+            writer.writerows((k, n, f"{v:.2f}") for k, (n, v) in items)
+        else:
+            col = "Category" if args.by == "category" else "Month"
+            print(_table([col, "Count", "Total"], [(k.title() if args.by == "category" else k, n, _money(v, args.currency)) for k, (n, v) in items], total, args.no_header, 2), end="")
+    elif args.format == "json":
+        print(json.dumps([{"date": r["date"].isoformat(), "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in rows], indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        writer.writerows((r["date"].isoformat(), r["category"], f"{r['amount']:.2f}", r["note"]) for r in rows)
+    else:
+        total = sum((r["amount"] for r in rows), Decimal(0))
+        data = [(r["date"].isoformat(), r["category"], _money(r["amount"], args.currency), r["note"][:23] + "…" if len(r["note"]) > 24 else r["note"]) for r in rows]
+        print(_table(["Date", "Category", "Amount", "Note"], data, total, args.no_header, 2), end="")
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
