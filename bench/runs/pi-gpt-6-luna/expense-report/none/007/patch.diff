--- /dev/null
+++ b/app/report.py
@@ -0,0 +1,144 @@
+"""Render expense CSV files as reports."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Report expenses from a CSV file.", epilog="Example: python -m app.report expenses.csv --by month")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="date_from")
+    parser.add_argument("--to", dest="date_to")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _date_arg(value):
+    try:
+        return date.fromisoformat(value)
+    except (ValueError, TypeError):
+        raise ValueError(f"error: invalid date: {value}")
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as exc:
+        return int(exc.code)
+    try:
+        start = _date_arg(args.date_from) if args.date_from else None
+        end = _date_arg(args.date_to) if args.date_to else None
+        if start and end and start > end:
+            raise ValueError("error: --from is after --to")
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+        rows = load(args.path)
+    except ValueError as exc:
+        print(str(exc) if str(exc).startswith("error:") else f"error: invalid amount: {exc}", file=sys.stderr)
+        return 2
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    valid = []
+    skipped = 0
+    for index, row in enumerate(rows):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, ValueError, KeyError, TypeError):
+            skipped += 1
+            continue
+        try:
+            day = _date_arg(row.get("date"))
+        except ValueError as exc:
+            print(str(exc), file=sys.stderr)
+            return 2
+        valid.append({**row, "_amount": amount, "_date": day, "_index": index})
+
+    cats = {x.casefold() for x in args.category}
+    selected = [r for r in valid if (not cats or r.get("category", "").casefold() in cats)
+                and (start is None or r["_date"] >= start) and (end is None or r["_date"] <= end)
+                and (minimum is None or r["_amount"] >= minimum)]
+    if args.by:
+        groups = {}
+        for r in selected:
+            key = r.get("category", "") if args.by == "category" else r["_date"].strftime("%Y-%m")
+            groups.setdefault(key, []).append(r)
+        items = [{"group": k, "count": len(v), "total": sum((r["_amount"] for r in v), Decimal(0))} for k, v in groups.items()]
+        if args.by == "category":
+            items.sort(key=lambda x: (-x["total"], x["group"].casefold()))
+        else:
+            items.sort(key=lambda x: x["group"])
+        total = sum((r["_amount"] for r in selected), Decimal(0))
+    else:
+        selected.sort(key=lambda r: (r["_date"], r["_index"]))
+        if args.top is not None:
+            selected = sorted(selected, key=lambda r: -r["_amount"])[:max(0, args.top)]
+        total = sum((r["_amount"] for r in selected), Decimal(0))
+        items = selected
+
+    if not items:
+        print("No expenses.")
+    elif args.format == "json":
+        if args.by:
+            output = [{"group": i["group"], "count": i["count"], "total": float(i["total"])} for i in items]
+        else:
+            output = [{"date": r["date"], "category": r["category"], "amount": float(r["_amount"]), "note": r.get("note", "")} for r in items]
+        print(json.dumps(output, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        for r in items:
+            writer.writerow([r["date"], r["category"], f"{r['_amount']:.2f}", r.get("note", "")])
+    else:
+        if args.by:
+            first = "Category" if args.by == "category" else "Month"
+            headers = [first, "Count", "Total"]
+            data = [[i["group"].title() if args.by == "category" else i["group"], str(i["count"]), _money(i["total"])] for i in items]
+            widths = [max(len(headers[n]), *(len(row[n]) for row in data)) for n in range(3)]
+            lines = []
+            if not args.no_header:
+                lines += ["  ".join(headers[n].ljust(widths[n]) for n in range(3)), "  ".join("-" * w for w in widths)]
+            lines += ["  ".join(row[n].ljust(widths[n]) for n in range(3)) for row in data]
+            lines.append("Total".ljust(widths[0]) + "  " + "".ljust(widths[1]) + "  " + _money(total))
+            print("\n".join(lines))
+        else:
+            headers = ["Date", "Category", "Amount", "Note"]
+            data = [[r["date"], r["category"], _money(r["_amount"]), (r.get("note", "")[:23] + "…") if len(r.get("note", "")) > 24 else r.get("note", "")] for r in items]
+            widths = [max(len(headers[i]), *(len(row[i]) for row in data)) for i in range(4)]
+            widths[2] += len(args.currency)
+            lines = []
+            if not args.no_header:
+                lines += ["  ".join(headers[i].ljust(widths[i]) if i != 2 else headers[i].rjust(widths[i]) for i in range(4)), "  ".join("-" * w for w in widths)]
+            for row in data:
+                amount = row[2]
+                rendered = f"({amount[1:]})" if amount.startswith("-") else amount
+                rendered = args.currency + rendered
+                lines.append("  ".join([row[0].ljust(widths[0]), row[1].ljust(widths[1]), rendered.rjust(widths[2]), row[3].ljust(widths[3])]))
+            rendered_total = args.currency + _money(total)
+            lines.append("Total".ljust(widths[0]) + "  " + "".ljust(widths[1]) + "  " + rendered_total.rjust(widths[2]) + "  ")
+            print("\n".join(lines))
+    if skipped:
+        print(f"warning: skipped {skipped} row{'s' if skipped != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
