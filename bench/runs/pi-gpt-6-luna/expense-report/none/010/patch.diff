+"""Render expense CSV files in table, JSON, or CSV form."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        self.print_usage(sys.stderr)
+        raise ValueError(message)
+
+
+def _date(value):
+    try:
+        parsed = date.fromisoformat(value)
+        if parsed.isoformat() != value:
+            raise ValueError
+        return parsed
+    except (TypeError, ValueError):
+        raise ValueError(f"error: invalid date: {value}")
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _table(rows, grouped, currency, no_header):
+    if grouped:
+        headers = ["Category" if grouped == "category" else "Month", "Count", "Total"]
+        rendered = [[r["group"], str(r["count"]), currency + _money(r["total"])] for r in rows]
+    else:
+        headers = ["Date", "Category", "Amount", "Note"]
+        rendered = [[r["date"], r["category"], currency + (f"({_money(-r['amount'])})" if r["amount"] < 0 else _money(r["amount"])), r["note"][:23] + "…" if len(r["note"]) > 24 else r["note"]] for r in rows]
+    total = sum((r["total"] for r in rows), Decimal(0)) if grouped else sum((r["amount"] for r in rows), Decimal(0))
+    if not rows:
+        return "No expenses.\n"
+    widths = [max(len(h), *(len(row[i]) for row in rendered)) for i, h in enumerate(headers)]
+    if not grouped:
+        widths[2] = max(widths[2], len(currency + _money(total)))
+    lines = []
+    if not no_header:
+        lines.extend(["  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)).rstrip(), "  ".join("-" * w for w in widths)])
+    for row in rendered:
+        cells = []
+        for i, value in enumerate(row):
+            cells.append(value.rjust(widths[i]) if (grouped and i == 2) or (not grouped and i == 2) else value.ljust(widths[i]))
+        lines.append("  ".join(cells).rstrip())
+    if grouped:
+        lines.append(f"Total  {currency}{_money(total)}")
+    else:
+        lines.append(f"Total{' ' * max(2, widths[0] + widths[1] + 4 - 5)}{currency}{_money(total)}")
+    return "\n".join(lines) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    parser = Parser(prog="python -m app.report", add_help=False)
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append")
+    parser.add_argument("--from", dest="date_from")
+    parser.add_argument("--to", dest="date_to")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    parser.add_argument("--help", action="help")
+    parser.epilog = "Example: python -m app.report expenses.csv --by category"
+    try:
+        args = parser.parse_args(argv)
+        start = _date(args.date_from) if args.date_from else None
+        end = _date(args.date_to) if args.date_to else None
+        if start and end and start > end:
+            raise ValueError("error: --from is after --to")
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+    except (ValueError, InvalidOperation) as exc:
+        print(str(exc) if str(exc).startswith("error:") else f"error: {exc}", file=sys.stderr)
+        return 2
+    try:
+        raw = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    rows, skipped = [], 0
+    for item in raw:
+        try:
+            amount = Decimal(item["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, TypeError, KeyError):
+            skipped += 1
+            continue
+        item_date = _date(item["date"])
+        rows.append({"date": item_date.isoformat(), "_date": item_date, "category": item.get("category", ""), "amount": amount, "note": item.get("note", "")})
+    categories = {c.casefold() for c in args.category} if args.category else None
+    rows = [r for r in rows if (categories is None or r["category"].casefold() in categories) and (start is None or r["_date"] >= start) and (end is None or r["_date"] <= end) and (minimum is None or r["amount"] >= minimum)]
+    rows.sort(key=lambda r: r["_date"])
+    if args.top is not None:
+        rows = sorted(rows, key=lambda r: r["amount"], reverse=True)[:max(0, args.top)]
+    if args.by:
+        groups = {}
+        for r in rows:
+            key = r["category"].title() if args.by == "category" else r["date"][:7]
+            if key not in groups:
+                groups[key] = [0, Decimal(0)]
+            groups[key][0] += 1
+            groups[key][1] += r["amount"]
+        grouped = [{"group": k, "count": v[0], "total": v[1]} for k, v in groups.items()]
+        if args.by == "category":
+            grouped.sort(key=lambda g: (-g["total"], g["group"].casefold()))
+        else:
+            grouped.sort(key=lambda g: g["group"])
+    else:
+        grouped = None
+    if not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        if grouped is not None:
+            output = [{"group": g["group"], "count": g["count"], "total": float(g["total"])} for g in grouped]
+        else:
+            output = [{"date": r["date"], "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in rows]
+        print(json.dumps(output, indent=2))
+    elif args.format == "csv":
+        if grouped is not None:
+            writer = csv.writer(sys.stdout, lineterminator="\n")
+            writer.writerow(["group", "count", "total"])
+            for g in grouped:
+                writer.writerow([g["group"], g["count"], f"{g['total']:.2f}"])
+        else:
+            writer = csv.writer(sys.stdout, lineterminator="\n")
+            writer.writerow(["date", "category", "amount", "note"])
+            for r in rows:
+                writer.writerow([r["date"], r["category"], f"{r['amount']:.2f}", r["note"]])
+    else:
+        print(_table(grouped if grouped is not None else rows, args.by, args.currency, args.no_header), end="")
+    if skipped:
+        print(f"warning: skipped {skipped} row{'s' if skipped != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
