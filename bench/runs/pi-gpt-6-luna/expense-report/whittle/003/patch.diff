+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+import json
+import sys
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        raise ValueError(message)
+
+
+def _parser():
+    parser = Parser(prog="python -m app.report", usage="%(prog)s PATH [options]", epilog="Example: python -m app.report expenses.csv --by category")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="date_from")
+    parser.add_argument("--to", dest="date_to")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _table(headers, rows, total, currency="", no_header=False, amount_column=2):
+    rows = [[str(value) for value in row] for row in rows]
+    rendered = []
+    for row in rows:
+        row = list(row)
+        for i, value in enumerate(row):
+            if i == amount_column:
+                number = Decimal(value)
+                value = f"({currency}{_money(abs(number))})" if number < 0 else currency + _money(number)
+                row[i] = value
+        rendered.append(row)
+    total_values = [""] * len(headers)
+    total_values[0] = "Total"
+    total_values[-1] = currency + _money(total)
+    all_rows = rendered + [total_values]
+    widths = [max(len(headers[i]), *(len(r[i]) for r in all_rows)) for i in range(len(headers))]
+    lines = []
+    if not no_header:
+        lines.append("  ".join(headers[i].ljust(widths[i]) for i in range(len(headers))).rstrip())
+        lines.append("  ".join("-" * widths[i] for i in range(len(headers))).rstrip())
+    for row in rendered:
+        lines.append("  ".join(row[i].rjust(widths[i]) if i == amount_column else row[i].ljust(widths[i]) for i in range(len(headers))).rstrip())
+    lines.append("  ".join(total_values[i].rjust(widths[i]) if i == len(headers)-1 else total_values[i].ljust(widths[i]) for i in range(len(headers))).rstrip())
+    return "\n".join(lines) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as exc:
+        return int(exc.code)
+    except ValueError as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 2
+    try:
+        start = date.fromisoformat(args.date_from) if args.date_from else None
+        end = date.fromisoformat(args.date_to) if args.date_to else None
+    except ValueError as exc:
+        value = args.date_from if args.date_from and (not args.date_to or _is_bad_date(args.date_from)) else args.date_to
+        print(f"error: invalid date: {value}", file=sys.stderr)
+        return 2
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+        if minimum is not None and not minimum.is_finite():
+            raise InvalidOperation
+    except (InvalidOperation, ValueError):
+        print(f"error: invalid amount: {args.minimum}", file=sys.stderr)
+        return 2
+    if args.top is not None and args.top < 0:
+        print("error: --top must be non-negative", file=sys.stderr)
+        return 2
+    try:
+        source_rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    rows = []
+    invalid = 0
+    for index, raw in enumerate(source_rows):
+        try:
+            when = date.fromisoformat(raw.get("date", ""))
+        except (ValueError, TypeError):
+            print(f"error: invalid date: {raw.get('date', '')}", file=sys.stderr)
+            return 2
+        try:
+            amount = Decimal(raw.get("amount", ""))
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, ValueError):
+            invalid += 1
+            continue
+        row = {"date": when.isoformat(), "category": raw.get("category", ""), "amount": amount, "note": raw.get("note", ""), "index": index}
+        if args.category and row["category"].casefold() not in {c.casefold() for c in args.category}:
+            continue
+        if start and when < start or end and when > end or minimum is not None and amount < minimum:
+            continue
+        rows.append(row)
+    if args.top is not None and not args.by:
+        rows = sorted(rows, key=lambda r: (-r["amount"], r["index"]))[:args.top]
+    if args.by:
+        groups = {}
+        for row in rows:
+            key = row["category"] if args.by == "category" else row["date"][:7]
+            count, subtotal = groups.get(key, (0, Decimal(0)))
+            groups[key] = count + 1, subtotal + row["amount"]
+        if not groups:
+            print("No expenses.")
+        else:
+            if args.by == "category":
+                keys = sorted(groups, key=lambda k: (-groups[k][1], k.casefold(), k))
+                display = lambda key: key.title()
+                headers = ["Category", "Count", "Total"]
+            else:
+                keys = sorted(groups)
+                display = lambda key: key
+                headers = ["Month", "Count", "Total"]
+            output = _table(headers, [[display(k), groups[k][0], str(groups[k][1])] for k in keys], sum((g[1] for g in groups.values()), Decimal(0)), args.currency, args.no_header, 2)
+            print(output, end="")
+    elif not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        objects = [{"date": r["date"], "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in sorted(rows, key=lambda r: (r["date"], r["index"]))]
+        print(json.dumps(objects, indent=2, ensure_ascii=False))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        for r in sorted(rows, key=lambda r: (r["date"], r["index"])):
+            writer.writerow([r["date"], r["category"], f"{r['amount']:.2f}", r["note"]])
+    else:
+        ordered = sorted(rows, key=lambda r: (r["date"], r["index"]))
+        output_rows = [[r["date"], r["category"], str(r["amount"]), (r["note"][:23] + "…") if len(r["note"]) > 24 else r["note"]] for r in ordered]
+        # Table amount is the third column; total is placed in the amount column.
+        print(_expense_table(output_rows, sum((r["amount"] for r in rows), Decimal(0)), args.currency, args.no_header), end="")
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _is_bad_date(value):
+    try:
+        date.fromisoformat(value)
+        return False
+    except ValueError:
+        return True
+
+
+def _expense_table(rows, total, currency, no_header):
+    headers = ["Date", "Category", "Amount", "Note"]
+    rendered = []
+    for d, category, amount, note in rows:
+        number = Decimal(amount)
+        formatted = f"({currency}{_money(abs(number))})" if number < 0 else currency + _money(number)
+        rendered.append([d, category, formatted, note])
+    totals = ["Total", "", currency + _money(total), ""]
+    widths = [max(len(headers[i]), *(len(r[i]) for r in rendered + [totals])) for i in range(4)]
+    lines = []
+    if not no_header:
+        lines += ["  ".join(headers[i].ljust(widths[i]) for i in range(4)).rstrip(), "  ".join("-" * widths[i] for i in range(4)).rstrip()]
+    lines += ["  ".join(r[i].rjust(widths[i]) if i == 2 else r[i].ljust(widths[i]) for i in range(4)).rstrip() for r in rendered]
+    lines.append("  ".join(totals[i].rjust(widths[i]) if i == 2 else totals[i].ljust(widths[i]) for i in range(4)).rstrip())
+    return "\n".join(lines) + "\n"
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
