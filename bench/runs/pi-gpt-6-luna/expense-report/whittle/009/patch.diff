+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        self.print_usage(sys.stderr)
+        self.exit(2, f"error: {message}\n")
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise ValueError(f"error: invalid date: {value}")
+
+
+def _parser():
+    parser = Parser(prog="python -m app.report", description="Report expenses from a CSV file.",
+                    epilog="Example: python -m app.report expenses.csv --by category")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", dest="categories", metavar="NAME")
+    parser.add_argument("--from", dest="start", metavar="DATE")
+    parser.add_argument("--to", dest="end", metavar="DATE")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="", metavar="SYMBOL")
+    parser.add_argument("--top", type=int, metavar="N")
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _table(rows, args):
+    if args.by:
+        groups = {}
+        for row in rows:
+            key = row["category"].title() if args.by == "category" else row["date"].strftime("%Y-%m")
+            groups.setdefault(key, []).append(row["amount"])
+        grouped = [(key, len(values), sum(values, Decimal(0))) for key, values in groups.items()]
+        if args.by == "category":
+            grouped.sort(key=lambda item: (-item[2], item[0].casefold()))
+            first = "Category"
+        else:
+            grouped.sort(key=lambda item: item[0])
+            first = "Month"
+        headers = [first, "Count", "Total"]
+        body = [[key, str(count), args.currency + _money(total)] for key, count, total in grouped]
+        total = sum((row["amount"] for row in rows), Decimal(0))
+    else:
+        headers = ["Date", "Category", "Amount", "Note"]
+        body = []
+        for row in rows:
+            amount = row["amount"]
+            shown = f"({args.currency}{_money(-amount)})" if amount < 0 else args.currency + _money(amount)
+            note = row["note"]
+            if len(note) > 24:
+                note = note[:23] + "…"
+            body.append([row["date"].isoformat(), row["category"], shown, note])
+        total = sum((row["amount"] for row in rows), Decimal(0))
+    body.append(["Total", "", args.currency + _money(total)] if args.by else ["Total", "", args.currency + _money(total), ""])
+    widths = [max(len(headers[i]), *(len(line[i]) for line in body)) for i in range(len(headers))]
+    amount_col = 2 if not args.by else 2
+    lines = []
+    if not args.no_header:
+        lines.append("  ".join(h.ljust(widths[i]) if i != amount_col else h.rjust(widths[i]) for i, h in enumerate(headers)))
+        lines.append("  ".join("-" * width for width in widths))
+    for line in body:
+        lines.append("  ".join(value.rjust(widths[i]) if i == amount_col else value.ljust(widths[i]) for i, value in enumerate(line)).rstrip())
+    return "\n".join(lines) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    try:
+        start = _date(args.start) if args.start else None
+        end = _date(args.end) if args.end else None
+        if start and end and start > end:
+            raise ValueError("error: --from is after --to")
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+        if minimum is not None and not minimum.is_finite():
+            raise InvalidOperation
+        raw_rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except ValueError as exc:
+        print(str(exc) if str(exc).startswith("error:") else f"error: invalid amount: {args.minimum}", file=sys.stderr)
+        return 2
+    except (InvalidOperation, TypeError):
+        print(f"error: invalid amount: {args.minimum}", file=sys.stderr)
+        return 2
+    rows = []
+    invalid = 0
+    try:
+        for index, raw in enumerate(raw_rows):
+            try:
+                amount = Decimal(raw["amount"])
+                if not amount.is_finite():
+                    raise InvalidOperation
+            except (InvalidOperation, TypeError, KeyError):
+                invalid += 1
+                continue
+            try:
+                row_date = _date(raw["date"])
+            except (ValueError, TypeError, KeyError) as exc:
+                print(str(exc), file=sys.stderr)
+                return 2
+            rows.append({"date": row_date, "category": raw.get("category", ""), "amount": amount,
+                         "note": raw.get("note", ""), "index": index})
+    except (InvalidOperation, TypeError):
+        print(f"error: invalid amount: {args.minimum}", file=sys.stderr)
+        return 2
+    rows.sort(key=lambda row: (row["date"], row["index"]))
+    if args.categories:
+        categories = {name.casefold() for name in args.categories}
+        rows = [row for row in rows if row["category"].casefold() in categories]
+    rows = [row for row in rows if (start is None or row["date"] >= start)
+            and (end is None or row["date"] <= end) and (minimum is None or row["amount"] >= minimum)]
+    if args.top is not None:
+        if args.top < 0:
+            print("error: --top must be non-negative", file=sys.stderr)
+            return 2
+        rows = sorted(rows, key=lambda row: (-row["amount"], row["date"], row["index"]))[:args.top]
+    if not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        if args.by:
+            groups = {}
+            for row in rows:
+                key = row["category"] if args.by == "category" else row["date"].strftime("%Y-%m")
+                groups.setdefault(key, []).append(row["amount"])
+            items = [{"group": key, "count": len(values), "total": float(sum(values, Decimal(0)))}
+                     for key, values in groups.items()]
+            if args.by == "category":
+                items.sort(key=lambda item: (-item["total"], item["group"].casefold()))
+            else:
+                items.sort(key=lambda item: item["group"])
+        else:
+            items = [{"date": row["date"].isoformat(), "category": row["category"],
+                      "amount": float(row["amount"]), "note": row["note"]} for row in rows]
+        print(json.dumps(items, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        for row in rows:
+            writer.writerow([row["date"].isoformat(), row["category"], f"{row['amount']:.2f}", row["note"]])
+    else:
+        sys.stdout.write(_table(rows, args))
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
