+"""Render expense CSV files as tables, JSON, or CSV reports."""
+import argparse
+import csv
+import json
+import sys
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        self.print_usage(sys.stderr)
+        self.exit(2, f"error: {message}\n")
+
+
+def _parser():
+    parser = Parser(prog="python -m app.report", description="Create a report from an expense CSV.",
+                    epilog="Example: python -m app.report expenses.csv --by month")
+    parser.add_argument("path", help="expense CSV path")
+    parser.add_argument("--category", action="append", metavar="NAME", help="keep this category (repeatable)")
+    parser.add_argument("--from", dest="start", metavar="DATE", help="include dates from DATE")
+    parser.add_argument("--to", dest="end", metavar="DATE", help="include dates through DATE")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT", help="minimum expense amount")
+    parser.add_argument("--by", choices=("category", "month"), help="group expenses")
+    parser.add_argument("--format", default="table", help="output format: table, json, or csv")
+    parser.add_argument("--currency", default="", metavar="SYMBOL", help="table currency symbol")
+    parser.add_argument("--top", type=int, metavar="N", help="show the N largest expenses")
+    parser.add_argument("--no-header", action="store_true", help="omit table header")
+    return parser
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _table(rows, grouped, args):
+    if grouped:
+        first = "Category" if args.by == "category" else "Month"
+        headers = [first, "Count", "Total"]
+        data = [[r["group"].title() if args.by == "category" else r["group"], str(r["count"]), args.currency + _money(r["total"])] for r in grouped]
+        total = sum((r["total"] for r in grouped), Decimal(0))
+        totalrow = ["Total", "", args.currency + _money(total)]
+        aligns = ["left", "right", "right"]
+    else:
+        headers = ["Date", "Category", "Amount", "Note"]
+        data = [[r["date"], r["category"], args.currency + (f"({_money(-r['amount'])})" if r["amount"] < 0 else _money(r["amount"])), r["note"] if len(r["note"]) <= 24 else r["note"][:23] + "…"] for r in rows]
+        totalrow = ["Total", "", args.currency + _money(sum((r["amount"] for r in rows), Decimal(0))), ""]
+        aligns = ["left", "left", "right", "left"]
+    allrows = data + [totalrow]
+    widths = [max(len(str(line[i])) for line in ([headers] if not args.no_header else []) + allrows) for i in range(len(headers))]
+    def fmt(line):
+        return "  ".join((str(v).rjust(widths[i]) if aligns[i] == "right" else str(v).ljust(widths[i])) for i, v in enumerate(line)).rstrip()
+    lines = []
+    if not args.no_header:
+        lines.extend((fmt(headers), "  ".join("-" * width for width in widths).rstrip()))
+    lines.extend(fmt(line) for line in allrows)
+    return "\n".join(lines) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    args = _parser().parse_args(argv)
+    if args.format not in ("table", "json", "csv"):
+        print(f"error: unknown format: {args.format}", file=sys.stderr)
+        return 2
+    parsed = {}
+    for key, value in (("--from", args.start), ("--to", args.end)):
+        if value is not None:
+            try:
+                parsed[key] = date.fromisoformat(value)
+            except ValueError:
+                print(f"error: invalid date: {value}", file=sys.stderr)
+                return 2
+    if args.start and args.end and parsed["--from"] > parsed["--to"]:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        source = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    rows, invalid = [], 0
+    for index, row in enumerate(source):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, TypeError, KeyError):
+            invalid += 1
+            continue
+        try:
+            day = date.fromisoformat(row["date"])
+        except (ValueError, TypeError, KeyError):
+            continue
+        rows.append({"date": row["date"], "_date": day, "category": row.get("category", ""), "amount": amount, "note": row.get("note", ""), "_index": index})
+    if args.category:
+        wanted = {c.casefold() for c in args.category}
+        rows = [r for r in rows if r["category"].casefold() in wanted]
+    if args.start:
+        rows = [r for r in rows if r["_date"] >= parsed["--from"]]
+    if args.end:
+        rows = [r for r in rows if r["_date"] <= parsed["--to"]]
+    if args.minimum is not None:
+        try:
+            minimum = Decimal(args.minimum)
+        except InvalidOperation:
+            print(f"error: invalid minimum amount: {args.minimum}", file=sys.stderr)
+            return 2
+        rows = [r for r in rows if r["amount"] >= minimum]
+    if args.top is not None:
+        rows = sorted(rows, key=lambda r: -r["amount"])[:max(0, args.top)]
+    else:
+        rows.sort(key=lambda r: r["_date"])
+    grouped = None
+    if args.by:
+        buckets = {}
+        for r in rows:
+            group = r["category"] if args.by == "category" else r["date"][:7]
+            buckets.setdefault(group, []).append(r["amount"])
+        grouped = [{"group": k, "count": len(v), "total": sum(v, Decimal(0))} for k, v in buckets.items()]
+        if args.by == "category":
+            grouped.sort(key=lambda r: (-r["total"], r["group"].casefold()))
+        else:
+            grouped.sort(key=lambda r: r["group"])
+    if args.format == "json":
+        if grouped is None:
+            output = [{"date": r["date"], "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in rows]
+        else:
+            output = [{"group": r["group"], "count": r["count"], "total": float(r["total"])} for r in grouped]
+        print(json.dumps(output, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(("date", "category", "amount", "note"))
+        for r in rows:
+            writer.writerow((r["date"], r["category"], f"{r['amount']:.2f}", r["note"]))
+    elif not rows:
+        print("No expenses.")
+    else:
+        print(_table(rows, grouped, args), end="")
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
