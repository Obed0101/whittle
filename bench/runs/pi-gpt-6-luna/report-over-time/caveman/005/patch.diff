+"""Create reports from expense CSV files."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _date(value):
+    try:
+        result = date.fromisoformat(value)
+        if result.isoformat() != value:
+            raise ValueError
+        return result
+    except (TypeError, ValueError):
+        raise ValueError(f"error: invalid date: {value}")
+
+
+def _table(headers, rows, total, no_header, currency=""):
+    rows = [[str(value) for value in row] for row in rows]
+    for row in rows:
+        if headers[0] == "Date":
+            amount = Decimal(row[2])
+            row[2] = f"({currency}{abs(amount):,.2f})" if amount < 0 else f"{currency}{amount:,.2f}"
+            row[3] = row[3][:23] + "…" if len(row[3]) > 24 else row[3]
+        else:
+            row[2] = f"{currency}{Decimal(row[2]):,.2f}"
+    rows.append(["Total", "", f"{currency}{total:,.2f}"])
+    widths = [max((len(row[i]) for row in [headers, *rows] if i < len(row)), default=0)
+              for i in range(len(headers))]
+
+    def fmt(row):
+        return "  ".join(value.rjust(widths[i]) if i == 2 else value.ljust(widths[i])
+                         for i, value in enumerate(row)).rstrip()
+
+    lines = [] if no_header else [fmt(headers), "  ".join("-" * width for width in widths).rstrip()]
+    return "\n".join([*lines, *(fmt(row) for row in rows)]) + "\n"
+
+
+def _markdown(rows, total):
+    lines = ["| Date | Category | Amount | Note |", "| --- | --- | ---: | --- |"]
+    for row in rows:
+        date, category, amount, note = row
+        lines.append(f"| {date} | {category} | {Decimal(str(amount)):,.2f} | {note.replace('|', r'\\|')} |")
+    lines.append(f"| Total | | {total:,.2f} | |")
+    return "\n".join(lines) + "\n"
+
+
+def _arguments(argv):
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Report expenses from a CSV file.")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", help="keep this category (repeatable)")
+    parser.add_argument("--exclude", action="append", help="exclude this category (repeatable)")
+    parser.add_argument("--from", dest="from_date", help="include expenses on or after DATE")
+    parser.add_argument("--to", dest="to_date", help="include expenses on or before DATE")
+    parser.add_argument("--min", dest="minimum", help="minimum amount")
+    parser.add_argument("--by", choices=("category", "month"), help="group by category or month")
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table", help="output format")
+    parser.add_argument("--currency", default="", help="table currency symbol")
+    parser.add_argument("--top", type=int, help="show N largest expenses")
+    parser.add_argument("--no-header", action="store_true", help="omit table header")
+    return parser.parse_args(argv)
+
+
+def _expenses(rows, args, start, end, minimum):
+    result, invalid = [], 0
+    categories = {c.casefold() for c in args.category or []}
+    excluded = {c.casefold() for c in args.exclude or []}
+    for index, row in enumerate(rows):
+        try:
+            amount = Decimal(row.get("amount", ""))
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, ValueError):
+            invalid += 1
+            continue
+        day = _date(row.get("date", ""))
+        category = row.get("category", "")
+        if start and day < start or end and day > end:
+            continue
+        if categories and category.casefold() not in categories or category.casefold() in excluded:
+            continue
+        if minimum is not None and amount < minimum:
+            continue
+        result.append({"date": day.isoformat(), "category": category, "amount": amount,
+                       "note": row.get("note", ""), "_index": index})
+    return result, invalid
+
+
+def _output(headers, rows, total, args):
+    if not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        print(json.dumps(rows, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(headers)
+        writer.writerows(rows)
+    elif args.format == "markdown":
+        print(_markdown(rows, total), end="")
+    else:
+        display = ["Date", "Category", "Amount", "Note"] if len(headers) == 4 else [headers[0].title(), "Count", "Total"]
+        print(_table(display, rows, total, args.no_header, args.currency), end="")
+
+
+def main(argv: list[str]) -> int:
+    args = _arguments(argv)
+    try:
+        start = _date(args.from_date) if args.from_date else None
+        end = _date(args.to_date) if args.to_date else None
+        if start and end and start > end:
+            raise ValueError("error: --from is after --to")
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+        expenses, invalid = _expenses(load(args.path), args, start, end, minimum)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except (ValueError, InvalidOperation) as exc:
+        print(str(exc), file=sys.stderr)
+        return 2
+
+    if args.by:
+        groups = {}
+        for expense in expenses:
+            key = expense["category"] if args.by == "category" else expense["date"][:7]
+            groups.setdefault(key, []).append(expense)
+        groups = [(key, len(items), sum((e["amount"] for e in items), Decimal(0)))
+                  for key, items in groups.items()]
+        groups.sort(key=(lambda r: r[0]) if args.by == "month" else
+                    (lambda r: (-r[2], r[0].casefold(), r[0])))
+        label = "Month" if args.by == "month" else "Category"
+        values = [(key.title() if args.by == "category" else key, count, total)
+                  for key, count, total in groups]
+        total = sum((e["amount"] for e in expenses), Decimal(0))
+        json_rows = [{"group": row[0], "count": row[1], "total": float(row[2])} for row in values]
+        csv_rows = [(a, b, f"{c:.2f}") for a, b, c in values]
+        table_rows = [(a, b, str(c)) for a, b, c in values]
+    else:
+        expenses.sort(key=lambda e: (e["date"], e["_index"]))
+        if args.top is not None:
+            expenses = sorted(expenses, key=lambda e: (-e["amount"], e["_index"]))[:max(args.top, 0)]
+        total = sum((e["amount"] for e in expenses), Decimal(0))
+        label, headers = None, ["date", "category", "amount", "note"]
+        json_rows = [{key: (float(e[key]) if key == "amount" else e[key])
+                      for key in ("date", "category", "amount", "note")} for e in expenses]
+        csv_rows = [(e["date"], e["category"], f"{e['amount']:.2f}", e["note"]) for e in expenses]
+        table_rows = [(e["date"], e["category"], str(e["amount"]), e["note"]) for e in expenses]
+    if args.by:
+        headers = [label.lower(), "count", "total"]
+    _output(headers, json_rows if args.format == "json" else
+            csv_rows if args.format == "csv" else table_rows, total, args)
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
