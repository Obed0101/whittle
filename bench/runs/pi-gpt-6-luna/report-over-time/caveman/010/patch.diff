+"""Render expense CSV files as reports."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Create an expense report.")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", dest="categories")
+    parser.add_argument("--exclude", action="append", dest="excluded_categories")
+    parser.add_argument("--from", dest="date_from")
+    parser.add_argument("--to", dest="date_to")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by category"
+    return parser
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise ValueError(f"error: invalid date: {value}") from None
+
+
+def _money(value):
+    amount = Decimal(value)
+    if not amount.is_finite():
+        raise InvalidOperation
+    return amount
+
+
+def _format_amount(amount, currency):
+    return f"({currency}{abs(amount):,.2f})" if amount < 0 else f"{currency}{amount:,.2f}"
+
+
+def _table(rows, grouped, currency, no_header):
+    headers = (["Category" if grouped == "category" else "Month", "Count", "Total"]
+               if grouped else ["Date", "Category", "Amount", "Note"])
+    body = ([[group, str(count), _format_amount(total, currency)] for group, count, total in rows]
+            if grouped else [[r["date"], r["category"], _format_amount(r["amount"], currency),
+                             r["note"][:23] + "…" if len(r["note"]) > 24 else r["note"]] for r in rows])
+    total = sum((r[2] for r in rows), Decimal(0)) if grouped else sum((r["amount"] for r in rows), Decimal(0))
+    widths = [max([len(header)] + [len(row[i]) for row in body]) for i, header in enumerate(headers)]
+    lines = []
+    if not no_header:
+        lines += ["  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)),
+                  "  ".join("-" * width for width in widths)]
+    lines.extend("  ".join(str(value).rjust(widths[i]) if i == 2 else str(value).ljust(widths[i])
+                           for i, value in enumerate(row)) for row in body)
+    total_cells = (["Total", "", _format_amount(total, currency)] if grouped else
+                   ["Total", "", "", _format_amount(total, currency)])
+    lines.append("  ".join(value.rjust(widths[i]) if i == (2 if grouped else 3) else value.ljust(widths[i])
+                           for i, value in enumerate(total_cells)))
+    return "\n".join(lines) + "\n"
+
+
+def _markdown(rows, currency):
+    lines = ["| Date | Category | Amount | Note |", "| --- | --- | ---: | --- |"]
+    for row in rows:
+        lines.append(f"| {row['date']} | {row['category']} | {_format_amount(row['amount'], currency)} | {row['note']} |")
+    total = sum((row["amount"] for row in rows), Decimal(0))
+    lines.append(f"| Total | | {_format_amount(total, currency)} | |")
+    return "\n".join(lines) + "\n"
+
+
+def _filtered(source, args, start, end, minimum):
+    categories = {value.casefold() for value in args.categories or []}
+    excluded = {value.casefold() for value in args.excluded_categories or []}
+    records, invalid = [], 0
+    for index, row in enumerate(source):
+        try:
+            amount = _money(row["amount"])
+        except (InvalidOperation, ValueError, TypeError, KeyError):
+            invalid += 1
+            continue
+        try:
+            row_date = _date(row["date"])
+        except ValueError:
+            continue
+        category = row["category"].casefold()
+        if ((categories and category not in categories) or category in excluded
+                or (start and row_date < start) or (end and row_date > end)
+                or (minimum is not None and amount < minimum)):
+            continue
+        records.append({**row, "amount": amount, "_date": row_date, "_index": index})
+    return records, invalid
+
+
+def _groups(rows, by):
+    groups = {}
+    for row in rows:
+        key = row["category"].title() if by == "category" else row["date"][:7]
+        count, total = groups.get(key, (0, Decimal(0)))
+        groups[key] = count + 1, total + row["amount"]
+    result = [(key, count, total) for key, (count, total) in groups.items()]
+    return sorted(result, key=(lambda row: (-row[2], row[0].casefold())) if by == "category" else lambda row: row[0])
+
+
+def _render(rows, args):
+    if not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        if args.by:
+            data = [{"group": group, "count": count, "total": float(total)} for group, count, total in rows]
+        else:
+            data = [{key: float(row["amount"]) if key == "amount" else row[key]
+                     for key in ("date", "category", "amount", "note")} for row in rows]
+        print(json.dumps(data, indent=2))
+    elif args.format == "csv" and not args.by:
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        writer.writerows([[row["date"], row["category"], f"{row['amount']:.2f}", row["note"]] for row in rows])
+    elif args.format == "markdown" and not args.by:
+        print(_markdown(rows, args.currency), end="")
+    else:
+        print(_table(rows, args.by, args.currency, args.no_header), end="")
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+        if args.top is not None and args.top < 0:
+            raise ValueError("--top must be non-negative")
+        start = _date(args.date_from) if args.date_from else None
+        end = _date(args.date_to) if args.date_to else None
+        if start and end and start > end:
+            raise ValueError("--from is after --to")
+        minimum = _money(args.minimum) if args.minimum is not None else None
+        source = load(args.path)
+    except SystemExit as exc:
+        return int(exc.code)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except ValueError as exc:
+        message = str(exc)
+        if message.startswith("error:"):
+            print(message, file=sys.stderr)
+        elif args.minimum is not None and message != "--top must be non-negative" and message != "--from is after --to":
+            print(f"error: invalid amount: {args.minimum}", file=sys.stderr)
+        else:
+            print(f"error: {message}", file=sys.stderr)
+        return 2
+
+    rows, invalid = _filtered(source, args, start, end, minimum)
+    if args.by:
+        rows = _groups(rows, args.by)
+    else:
+        rows.sort(key=lambda row: (row["_date"], row["_index"]))
+        if args.top is not None:
+            rows = sorted(rows, key=lambda row: (-row["amount"], row["_index"]))[:args.top]
+    _render(rows, args)
+    if invalid:
+        print(f"warning: skipped {invalid} {'row' if invalid == 1 else 'rows'} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
