+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+import json
+import sys
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", usage="%(prog)s PATH [options]")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--exclude", action="append", default=[], metavar="NAME",
+                        help="exclude a category (repeatable; case-insensitive)")
+    parser.add_argument("--from", dest="date_from")
+    parser.add_argument("--to", dest="date_to")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by category"
+    return parser
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise ValueError(value)
+
+
+def _money(value, currency=""):
+    value = Decimal(value)
+    rendered = f"{abs(value):,.2f}"
+    return currency + (f"({rendered})" if value < 0 else rendered)
+
+
+def _table(rows, grouping, currency, no_header):
+    if grouping:
+        headers = ["Category" if grouping == "category" else "Month", "Count", "Total"]
+        data = [[name.title() if grouping == "category" else name, str(count), _money(total, currency)]
+                for name, count, total in rows]
+        total = sum((row[2] for row in rows), Decimal(0))
+    else:
+        headers = ["Date", "Category", "Amount", "Note"]
+        data = [[r["date"], r["category"], _money(r["amount"], currency),
+                 r["note"] if len(r["note"]) <= 24 else r["note"][:23] + "…"] for r in rows]
+        total = sum((r["amount"] for r in rows), Decimal(0))
+    widths = [max([len(headers[i])] + [len(row[i]) for row in data]) for i in range(len(headers))]
+    if not no_header:
+        print("  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)))
+        print("  ".join("-" * width for width in widths))
+    for row in data:
+        print("  ".join(value.rjust(widths[i]) if i == 2 else value.ljust(widths[i])
+                        for i, value in enumerate(row)))
+    amount = _money(total, currency)
+    print("Total" + " " * max(1, sum(widths) + 2 * (len(widths) - 1) - len("Total") - len(amount)) + amount)
+
+
+def _markdown(rows):
+    print("| Date | Category | Amount | Note |")
+    print("| --- | --- | ---: | --- |")
+    for row in rows:
+        print(f"| {row['date']} | {row['category']} | {_money(row['amount'])} | {row['note']} |")
+    total = sum((row["amount"] for row in rows), Decimal(0))
+    print(f"| Total | | {_money(total)} | |")
+
+
+def _output(rows, args):
+    if args.by:
+        groups = {}
+        for row in rows:
+            key = row["category"] if args.by == "category" else row["date"][:7]
+            count, total = groups.get(key, (0, Decimal(0)))
+            groups[key] = count + 1, total + row["amount"]
+        records = [(key, count, total) for key, (count, total) in groups.items()]
+        records.sort(key=(lambda x: (-x[2], x[0].casefold())) if args.by == "category" else lambda x: x[0])
+        if args.format == "json":
+            print(json.dumps([{"group": n, "count": c, "total": float(t)} for n, c, t in records], indent=2))
+        elif args.format == "csv":
+            writer = csv.writer(sys.stdout, lineterminator="\n")
+            writer.writerow(["group", "count", "total"])
+            writer.writerows((n, c, f"{t:.2f}") for n, c, t in records)
+        else:
+            _table(records, args.by, args.currency, args.no_header)
+    elif args.format == "markdown":
+        _markdown(rows)
+    elif args.format == "json":
+        print(json.dumps([{k: (float(r[k]) if k == "amount" else r[k])
+                           for k in ("date", "category", "amount", "note")} for r in rows], indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        writer.writerows((r["date"], r["category"], f"{r['amount']:.2f}", r["note"]) for r in rows)
+    else:
+        _table(rows, None, args.currency, args.no_header)
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    try:
+        start, end = (_date(args.date_from) if args.date_from else None,
+                      _date(args.date_to) if args.date_to else None)
+        if start and end and start > end:
+            print("error: --from is after --to", file=sys.stderr)
+            return 2
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+        if args.top is not None and args.top < 0:
+            parser.error("--top must be non-negative")
+        raw = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except ValueError as exc:
+        print(f"error: invalid date: {exc.args[0] if exc.args else ''}", file=sys.stderr)
+        return 2
+    except (InvalidOperation, TypeError):
+        print("error: invalid amount", file=sys.stderr)
+        return 2
+
+    categories = {name.casefold() for name in args.category}
+    excluded = {name.casefold() for name in args.exclude}
+    rows, invalid = [], 0
+    try:
+        for index, item in enumerate(raw):
+            try:
+                amount = Decimal(item["amount"])
+                if not amount.is_finite():
+                    raise InvalidOperation
+            except (InvalidOperation, TypeError, KeyError):
+                invalid += 1
+                continue
+            try:
+                parsed = _date(item["date"])
+            except (ValueError, KeyError):
+                print(f"error: invalid date: {item.get('date', '')}", file=sys.stderr)
+                return 2
+            category = item.get("category", "")
+            if ((start and parsed < start) or (end and parsed > end)
+                    or (categories and category.casefold() not in categories)
+                    or category.casefold() in excluded or (minimum is not None and amount < minimum)):
+                continue
+            rows.append({"date": item["date"], "category": category, "amount": amount,
+                         "note": item.get("note", ""), "_date": parsed, "_index": index})
+    except OSError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    rows.sort(key=lambda row: (row["_date"], row["_index"]))
+    if args.top is not None:
+        rows = sorted(rows, key=lambda row: (-row["amount"], row["_index"]))[:args.top]
+    if rows:
+        _output(rows, args)
+    else:
+        print("No expenses.")
+    if invalid:
+        print(f"warning: skipped {invalid} row{'s' if invalid != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
