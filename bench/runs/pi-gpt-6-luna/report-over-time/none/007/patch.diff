+"""Render expense CSV files as reports."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", epilog="Example: python -m app.report expenses.csv --by category")
+    parser.add_argument("path", nargs="?")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--exclude", action="append", default=[], metavar="NAME", help="exclude a category (repeatable)")
+    parser.add_argument("--from", dest="date_from")
+    parser.add_argument("--to", dest="date_to")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _error(message):
+    print(f"error: {message}", file=sys.stderr)
+    return 2
+
+
+def _read_rows(rows):
+    valid, skipped = [], 0
+    for index, row in enumerate(rows):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, KeyError, TypeError):
+            skipped += 1
+            continue
+        try:
+            row_date = date.fromisoformat(row["date"])
+        except (ValueError, KeyError, TypeError):
+            return None, skipped, row.get("date", "")
+        valid.append({**row, "_amount": amount, "_date": row_date, "_index": index})
+    return valid, skipped, None
+
+
+def _groups(rows, by):
+    groups = {}
+    for row in rows:
+        name = row["category"].title() if by == "category" else row["_date"].strftime("%Y-%m")
+        total, count = groups.get(name, (Decimal(0), 0))
+        groups[name] = total + row["_amount"], count + 1
+    result = [(name, count, total) for name, (total, count) in groups.items()]
+    result.sort(key=(lambda item: (-item[2], item[0].casefold())) if by == "category" else lambda item: item[0])
+    return result
+
+
+def _money(value, currency="", refund=False):
+    if refund and value < 0:
+        return f"({currency}{abs(value):,.2f})"
+    return f"{currency}{value:,.2f}"
+
+
+def _table(headers, rows, total, no_header, amount_col):
+    headers = headers[0]
+    widths = [max(len(headers[i]), *(len(row[i]) for row in rows)) for i in range(len(headers))]
+    if not no_header:
+        print("  ".join(headers[i].ljust(widths[i]) for i in range(len(widths))))
+        print("  ".join("-" * width for width in widths))
+    for row in rows:
+        print("  ".join(row[i].rjust(widths[i]) if i == amount_col else row[i].ljust(widths[i]) for i in range(len(widths))))
+    print("Total" + "  " * (len(widths) - 1) + "  ".join([""] * (len(widths) - 1) + [total]))
+
+
+def _render(rows, args):
+    if not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        output = ([{"group": name, "count": count, "total": float(total)} for name, count, total in _groups(rows, args.by)]
+                  if args.by else [{"date": r["date"], "category": r["category"], "amount": float(r["_amount"]), "note": r["note"]} for r in rows])
+        print(json.dumps(output, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(("date", "category", "amount", "note"))
+        for row in rows:
+            writer.writerow((row["date"], row["category"], f'{row["_amount"]:.2f}', row["note"]))
+    elif args.format == "markdown":
+        print("| Date | Category | Amount | Note |")
+        print("| --- | --- | ---: | --- |")
+        for row in rows:
+            print(f'| {row["date"]} | {row["category"]} | {_money(row["_amount"])} | {row["note"]} |')
+        total = sum((r["_amount"] for r in rows), Decimal(0))
+        print(f"| Total | | {_money(total)} | |")
+    elif args.by:
+        groups = _groups(rows, args.by)
+        label = "Category" if args.by == "category" else "Month"
+        _table([(label, "Count", "Total")], [(n, str(c), _money(t, args.currency)) for n, c, t in groups],
+               _money(sum((r["_amount"] for r in rows), Decimal(0)), args.currency), args.no_header, 2)
+    else:
+        output = [(r["date"], r["category"], _money(r["_amount"], args.currency, True), r["note"][:23] + "…" if len(r["note"]) > 24 else r["note"]) for r in rows]
+        _table([("Date", "Category", "Amount", "Note")], output,
+               _money(sum((r["_amount"] for r in rows), Decimal(0)), args.currency, True), args.no_header, 2)
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    if not args.path:
+        parser.print_help(sys.stderr)
+        return 2
+    if args.format not in ("table", "json", "csv", "markdown"):
+        return _error(f"unknown format: {args.format}")
+    try:
+        start = date.fromisoformat(args.date_from) if args.date_from else None
+        end = date.fromisoformat(args.date_to) if args.date_to else None
+    except ValueError:
+        value = args.date_from if args.date_from and _invalid_date(args.date_from) else args.date_to
+        return _error(f"invalid date: {value}")
+    if start and end and start > end:
+        return _error("--from is after --to")
+    try:
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+    except InvalidOperation:
+        return _error(f"invalid amount: {args.minimum}")
+    try:
+        rows = load(args.path)
+    except FileNotFoundError:
+        return _error(f"file not found: {args.path}")
+    rows, skipped, bad_date = _read_rows(rows)
+    if bad_date is not None:
+        return _error(f"invalid date: {bad_date}")
+    categories, excluded = {x.casefold() for x in args.category}, {x.casefold() for x in args.exclude}
+    rows = [r for r in rows if (not categories or r["category"].casefold() in categories)
+            and r["category"].casefold() not in excluded and (start is None or r["_date"] >= start)
+            and (end is None or r["_date"] <= end) and (minimum is None or r["_amount"] >= minimum)]
+    if args.top is not None:
+        rows = sorted(rows, key=lambda r: r["_amount"], reverse=True)[:max(0, args.top)]
+    elif not args.by:
+        rows.sort(key=lambda r: r["_date"])
+    _render(rows, args)
+    if skipped:
+        print(f"warning: skipped {skipped} {'row' if skipped == 1 else 'rows'} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _invalid_date(value):
+    try:
+        date.fromisoformat(value)
+        return False
+    except ValueError:
+        return True
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
