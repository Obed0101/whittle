+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Report expenses from a CSV file.")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[], metavar="NAME")
+    parser.add_argument("--exclude", action="append", default=[], metavar="NAME")
+    parser.add_argument("--from", dest="date_from", type=_date, metavar="DATE")
+    parser.add_argument("--to", dest="date_to", type=_date, metavar="DATE")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int, metavar="N")
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by month"
+    return parser
+
+
+def _amount(value):
+    try:
+        amount = Decimal(value)
+        if amount.is_finite():
+            return amount
+    except (InvalidOperation, ValueError, TypeError):
+        pass
+    raise ValueError(value)
+
+
+def _rows(raw):
+    rows, invalid = [], 0
+    for row in raw:
+        try:
+            amount = _amount(row.get("amount", ""))
+        except ValueError:
+            invalid += 1
+            continue
+        try:
+            parsed_date = date.fromisoformat(row.get("date", ""))
+        except (ValueError, TypeError):
+            raise ValueError(f"invalid date: {row.get('date', '')}")
+        rows.append({**row, "amount": amount, "_date": parsed_date})
+    return rows, invalid
+
+
+def _groups(rows, by):
+    groups = {}
+    for row in rows:
+        key = row["category"] if by == "category" else row["_date"].strftime("%Y-%m")
+        count, total = groups.get(key, (0, Decimal(0)))
+        groups[key] = count + 1, total + row["amount"]
+    result = [(str(key).title() if by == "category" else key, count, total)
+              for key, (count, total) in groups.items()]
+    return sorted(result, key=(lambda item: (-item[2], item[0].casefold())) if by == "category" else lambda item: item[0])
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _table(rows, grouped, currency, no_header):
+    if grouped:
+        headers = ["Category" if grouped == "category" else "Month", "Count", "Total"]
+        data = [[name, str(count), currency + _money(total)] for name, count, total in rows]
+        total = sum((item[2] for item in rows), Decimal(0))
+    else:
+        headers = ["Date", "Category", "Amount", "Note"]
+        data = []
+        for row in rows:
+            amount = row["amount"]
+            shown = f"({currency}{_money(-amount)})" if amount < 0 else currency + _money(amount)
+            note = row.get("note", "") or ""
+            data.append([row["date"], row["category"], shown, note[:23] + "…" if len(note) > 24 else note])
+        total = sum((row["amount"] for row in rows), Decimal(0))
+    data.append(["Total", "", currency + _money(total)] + ([] if grouped else [""]))
+    widths = [max(len(header), *(len(row[i]) for row in data)) for i, header in enumerate(headers)]
+    lines = []
+    if not no_header:
+        lines.extend(["  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)),
+                      "  ".join("-" * width for width in widths)])
+    for row in data:
+        lines.append("  ".join(cell.rjust(widths[i]) if i == 2 or (grouped and i == 1)
+                                else cell.ljust(widths[i]) for i, cell in enumerate(row)).rstrip())
+    return "\n".join(lines) + "\n"
+
+
+def _markdown(rows):
+    lines = ["| Date | Category | Amount | Note |", "| --- | --- | ---: | --- |"]
+    total = sum((row["amount"] for row in rows), Decimal(0))
+    for row in rows:
+        note = (row.get("note", "") or "").replace("|", "\\|").replace("\n", " ")
+        category = (row.get("category", "") or "").replace("|", "\\|")
+        lines.append(f"| {row['date']} | {category} | {_money(row['amount'])} | {note} |")
+    lines.append(f"| Total | | {_money(total)} | |")
+    return "\n".join(lines) + "\n"
+
+
+def _filter(rows, args):
+    if args.minimum is not None:
+        try:
+            minimum = _amount(args.minimum)
+        except ValueError:
+            raise ValueError(f"invalid amount: {args.minimum}")
+        rows = [row for row in rows if row["amount"] >= minimum]
+    categories = {value.casefold() for value in args.category}
+    excluded = {value.casefold() for value in args.exclude}
+    rows = [row for row in rows
+            if (not categories or row.get("category", "").casefold() in categories)
+            and row.get("category", "").casefold() not in excluded
+            and (not args.date_from or row["_date"] >= args.date_from)
+            and (not args.date_to or row["_date"] <= args.date_to)]
+    return sorted(rows, key=lambda row: row["amount"], reverse=True)[:max(0, args.top)] if args.top is not None else sorted(rows, key=lambda row: row["_date"])
+
+
+def _output(rows, grouped, args):
+    if args.format == "json":
+        result = ([{"group": name, "count": count, "total": float(total)} for name, count, total in grouped]
+                  if args.by else [{"date": r["date"], "category": r["category"], "amount": float(r["amount"]), "note": r.get("note", "")} for r in rows])
+        print(json.dumps(result, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        for row in rows:
+            writer.writerow([row["date"], row["category"], f"{row['amount']:.2f}", row.get("note", "")])
+    elif args.format == "markdown":
+        print(_markdown(rows), end="")
+    else:
+        print(_table(grouped if args.by else rows, args.by, args.currency, args.no_header), end="")
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as exc:
+        return int(exc.code)
+    if args.date_from and args.date_to and args.date_from > args.date_to:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        rows, invalid = _rows(load(args.path))
+        rows = _filter(rows, args)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except OSError as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 2
+    except ValueError as exc:
+        message = str(exc)
+        print(f"error: {message if message.startswith('invalid ') else f'invalid amount: {message}'}", file=sys.stderr)
+        return 2
+    if not rows:
+        print("No expenses.")
+    else:
+        _output(rows, _groups(rows, args.by) if args.by else [], args)
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
