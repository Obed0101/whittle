+"""Render expense CSV files in useful report formats."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+
+
+def _parser():
+    parser = argparse.ArgumentParser(description="Report expenses from a CSV file.", usage="%(prog)s PATH [options]")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[], metavar="NAME", help="keep this category (repeatable)")
+    parser.add_argument("--exclude", action="append", default=[], metavar="NAME", help="exclude this category (repeatable)")
+    parser.add_argument("--from", dest="date_from", type=_date, metavar="DATE", help="include expenses on or after DATE")
+    parser.add_argument("--to", dest="date_to", type=_date, metavar="DATE", help="include expenses on or before DATE")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT", help="minimum amount")
+    parser.add_argument("--by", choices=("category", "month"), help="group by category or month")
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table", help="output format")
+    parser.add_argument("--currency", default="", metavar="SYMBOL", help="prefix table amounts with SYMBOL")
+    parser.add_argument("--top", type=int, metavar="N", help="show the N largest expenses")
+    parser.add_argument("--no-header", action="store_true", help="omit table header")
+    parser.epilog = "Example: python -m app.report expenses.csv --by month"
+    return parser
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _groups(rows, by):
+    totals = {}
+    for row in rows:
+        key = row["category"] if by == "category" else row["date"][:7]
+        count, total = totals.get(key, (0, Decimal(0)))
+        totals[key] = count + 1, total + row["amount"]
+    groups = [(key, count, total) for key, (count, total) in totals.items()]
+    groups.sort(key=(lambda item: (-item[2], item[0].casefold())) if by == "category" else lambda item: item[0])
+    return groups
+
+
+def _table(rows, groups, by, currency, no_header):
+    if groups is not None:
+        headers = ["Category" if by == "category" else "Month", "Count", "Total"]
+        data = [[name.title() if by == "category" else name, str(count), currency + _money(total)] for name, count, total in groups]
+        total = sum((amount for _, _, amount in groups), Decimal(0))
+    else:
+        headers = ["Date", "Category", "Amount", "Note"]
+        data = []
+        for row in rows:
+            amount = row["amount"]
+            shown = f"({_money(-amount)})" if amount < 0 else _money(amount)
+            note = (row.get("note", "") or "")
+            data.append([row["date"], row.get("category", ""), currency + shown, note[:23] + "…" if len(note) > 24 else note])
+        total = sum((row["amount"] for row in rows), Decimal(0))
+
+    widths = [max(len(headers[i]), *(len(row[i]) for row in data)) for i in range(len(headers))]
+    lines = []
+    if not no_header:
+        lines += ["  ".join(headers[i].ljust(widths[i]) for i in range(len(headers))).rstrip(),
+                  "  ".join("-" * width for width in widths)]
+    if groups is None:
+        lines.extend("  ".join([row[0].ljust(widths[0]), row[1].ljust(widths[1]), row[2].rjust(widths[2]), row[3]]) for row in data)
+    else:
+        lines.extend("  ".join(row[i].ljust(widths[i]) for i in range(len(headers))).rstrip() for row in data)
+    lines.append(f"Total  {currency}{_money(total)}")
+    return "\n".join(lines)
+
+
+def _selected(raw, args, minimum):
+    valid, skipped = [], 0
+    for index, row in enumerate(raw):
+        try:
+            amount = Decimal(row.get("amount", ""))
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, ValueError):
+            skipped += 1
+            continue
+        row = dict(row, amount=amount)
+        try:
+            row_date = date.fromisoformat(row["date"])
+        except (ValueError, TypeError, KeyError):
+            raise ValueError(f"invalid date: {row.get('date', '')}")
+        category = row.get("category", "")
+        if args.category and category.casefold() not in {value.casefold() for value in args.category}:
+            continue
+        if category.casefold() in {value.casefold() for value in args.exclude}:
+            continue
+        if args.date_from and row_date < args.date_from or args.date_to and row_date > args.date_to:
+            continue
+        if minimum is not None and amount < minimum:
+            continue
+        row["_date"], row["_index"] = row_date, index
+        valid.append(row)
+    valid.sort(key=lambda row: (row["_date"], row["_index"]))
+    if args.top is not None:
+        valid = sorted(valid, key=lambda row: (-row["amount"], row["_index"]))[:max(0, args.top)]
+        valid.sort(key=lambda row: (row["_date"], row["_index"]))
+    return valid, skipped
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    if args.date_from and args.date_to and args.date_from > args.date_to:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+        if minimum is not None and not minimum.is_finite():
+            raise InvalidOperation
+    except (InvalidOperation, ValueError):
+        print(f"error: invalid amount: {args.minimum}", file=sys.stderr)
+        return 2
+    try:
+        raw = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    try:
+        rows, skipped = _selected(raw, args, minimum)
+    except ValueError as error:
+        print(f"error: {error}", file=sys.stderr)
+        return 2
+
+    if not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        if args.by:
+            output = [{"group": key, "count": count, "total": float(total)} for key, count, total in _groups(rows, args.by)]
+        else:
+            output = [{"date": row["date"], "category": row["category"], "amount": float(row["amount"]), "note": row.get("note", "")} for row in rows]
+        print(json.dumps(output, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        for row in rows:
+            writer.writerow([row["date"], row["category"], f"{row['amount']:.2f}", row.get("note", "")])
+    elif args.format == "markdown":
+        print("| Date | Category | Amount | Note |")
+        print("| --- | --- | ---: | --- |")
+        for row in rows:
+            print(f"| {row['date']} | {row.get('category', '')} | {_money(row['amount'])} | {row.get('note', '') or ''} |")
+        total = sum((row["amount"] for row in rows), Decimal(0))
+        print(f"| Total | | {_money(total)} | |")
+    else:
+        groups = _groups(rows, args.by) if args.by else None
+        print(_table(rows, groups, args.by, args.currency, args.no_header))
+    if skipped:
+        print(f"warning: skipped {skipped} {'row' if skipped == 1 else 'rows'} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
