+"""Command-line reports for expense CSV files."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _date(value):
+    try:
+        date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+    return value
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--exclude", action="append", default=[], metavar="NAME",
+                        help="exclude a category (case-insensitive; may be repeated)")
+    parser.add_argument("--from", dest="start", type=_date)
+    parser.add_argument("--to", dest="end", type=_date)
+    parser.add_argument("--min", dest="minimum", type=Decimal)
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _table(rows, grouped, currency, no_header):
+    if grouped:
+        headers = ["Category" if grouped == "category" else "Month", "Count", "Total"]
+        data = [[name.title() if grouped == "category" else name, str(count), _money(total)]
+                for name, count, total in rows]
+        total = sum((row[2] for row in rows), Decimal(0))
+    else:
+        headers = ["Date", "Category", "Amount", "Note"]
+        data = []
+        for row in rows:
+            amount = row["amount"]
+            amount = f"({currency}{_money(-amount)})" if amount < 0 else currency + _money(amount)
+            note = row["note"] or ""
+            data.append([row["date"], row["category"], amount,
+                         note[:23] + "…" if len(note) > 24 else note])
+        total = sum((row["amount"] for row in rows), Decimal(0))
+    widths = [max(len(header), *(len(row[i]) for row in data)) for i, header in enumerate(headers)]
+    if not no_header:
+        print("  ".join(headers[i].ljust(widths[i]) for i in range(len(headers) - 1)) +
+              "  " + headers[-1].rjust(widths[-1]) if not grouped else
+              "  ".join(headers[i].ljust(widths[i]) for i in range(2)) + "  " + headers[2].rjust(widths[2]))
+        print("  ".join("-" * width for width in widths))
+    for row in data:
+        print("  ".join(value.rjust(widths[i]) if not grouped and i == 2 else value.ljust(widths[i])
+                        for i, value in enumerate(row)))
+    suffix = currency + _money(total) if not grouped else _money(total)
+    print("Total" + " " * max(1, sum(widths) + (4 if grouped else 6) - 5 - len(suffix)) + suffix)
+
+
+def _markdown(rows):
+    print("| Date | Category | Amount | Note |")
+    print("| --- | --- | ---: | --- |")
+    for row in rows:
+        print(f"| {row['date']} | {row['category']} | {_money(row['amount'])} | {row['note'] or ''} |")
+    total = sum((row["amount"] for row in rows), Decimal(0))
+    print(f"| Total | | {_money(total)} | |")
+
+
+def _output(rows, args):
+    if args.by:
+        totals = {}
+        for row in rows:
+            key = row["category"] if args.by == "category" else row["date"][:7]
+            count, total = totals.get(key, (0, Decimal(0)))
+            totals[key] = count + 1, total + row["amount"]
+        rows = [(key, count, total) for key, (count, total) in totals.items()]
+        rows.sort(key=(lambda r: (-r[2], r[0].casefold())) if args.by == "category" else lambda r: r[0])
+        fields = [{"group": name, "count": count, "total": float(total)} for name, count, total in rows]
+        csv_rows = ((name, count, f"{total:.2f}") for name, count, total in rows)
+        headers = ["group", "count", "total"]
+    else:
+        fields = [{key: float(row[key]) if key == "amount" else row[key]
+                   for key in ("date", "category", "amount", "note")} for row in rows]
+        csv_rows = ((row["date"], row["category"], f"{row['amount']:.2f}", row["note"]) for row in rows)
+        headers = ["date", "category", "amount", "note"]
+    if not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        print(json.dumps(fields, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(headers)
+        writer.writerows(csv_rows)
+    elif args.format == "markdown":
+        if args.by:
+            _table(rows, args.by, args.currency, args.no_header)
+        else:
+            _markdown(rows)
+    else:
+        _table(rows, args.by, args.currency, args.no_header)
+
+
+def main(argv: list[str]) -> int:
+    args = _parser().parse_args(argv)
+    if args.start and args.end and args.start > args.end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        source = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    rows, invalid = [], 0
+    for index, item in enumerate(source):
+        try:
+            amount = Decimal(item["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, KeyError, TypeError):
+            invalid += 1
+            continue
+        row = {**item, "amount": amount, "_order": index}
+        category = row["category"].casefold()
+        if ((not args.category or category in {x.casefold() for x in args.category})
+                and category not in {x.casefold() for x in args.exclude}
+                and (not args.start or row["date"] >= args.start)
+                and (not args.end or row["date"] <= args.end)
+                and (args.minimum is None or amount >= args.minimum)):
+            rows.append(row)
+    rows.sort(key=lambda row: (row["date"], row["_order"]))
+    if args.top is not None:
+        rows = sorted(rows, key=lambda row: row["amount"], reverse=True)[:max(0, args.top)]
+    _output(rows, args)
+    if invalid:
+        print(f"warning: skipped {invalid} row{'s' if invalid != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
