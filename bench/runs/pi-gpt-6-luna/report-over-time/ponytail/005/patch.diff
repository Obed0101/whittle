+"""Print expense reports from CSV files."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def main(argv: list[str]) -> int:
+    parser = argparse.ArgumentParser(description="Report expenses from a CSV file.", epilog="Example: python -m app.report expenses.csv --by month")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--exclude", action="append", default=[])
+    parser.add_argument("--from", dest="start")
+    parser.add_argument("--to", dest="end")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    args = parser.parse_args(argv)
+
+    try:
+        start, end = (date.fromisoformat(x) if x else None for x in (args.start, args.end))
+    except ValueError:
+        print(f"error: invalid date: {args.start if args.start and _bad_date(args.start) else args.end}", file=sys.stderr)
+        return 2
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    try:
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+    except InvalidOperation:
+        parser.error("invalid --min amount")
+    if args.top is not None and args.top < 0:
+        parser.error("--top must be non-negative")
+
+    categories = {c.casefold() for c in args.category}
+    excluded = {c.casefold() for c in args.exclude}
+    selected, invalid = [], 0
+    for index, row in enumerate(rows):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, ValueError, KeyError):
+            invalid += 1
+            continue
+        try:
+            day = date.fromisoformat(row["date"])
+        except (ValueError, KeyError):
+            continue
+        category = row["category"].casefold()
+        if categories and category not in categories: continue
+        if category in excluded: continue
+        if start and day < start or end and day > end or minimum is not None and amount < minimum: continue
+        selected.append((row, amount, index, day))
+    selected.sort(key=lambda item: (item[3], item[2]))
+    if args.top is not None:
+        selected = sorted(selected, key=lambda item: item[1], reverse=True)[:args.top]
+
+    total = sum((item[1] for item in selected), Decimal(0))
+    if not selected:
+        print("No expenses.")
+    elif args.by:
+        groups = {}
+        for row, amount, _, day in selected:
+            key = row["category"].title() if args.by == "category" else day.strftime("%Y-%m")
+            count, subtotal = groups.get(key, (0, Decimal(0)))
+            groups[key] = count + 1, subtotal + amount
+        groups = sorted(groups.items(), key=(lambda x: (-x[1][1], x[0].casefold())) if args.by == "category" else lambda x: x[0])
+        headers = ["Category" if args.by == "category" else "Month", "Count", "Total"]
+        data = [{"group": k, "count": v[0], "total": float(v[1])} for k, v in groups]
+        if args.format == "json": print(json.dumps(data, indent=2))
+        else: print(_table(headers, [[k, *v] for k, v in groups], total, args.currency, args.no_header), end="")
+    elif args.format == "json":
+        print(json.dumps([{"date": r["date"], "category": r["category"], "amount": float(a), "note": r["note"]} for r, a, _, _ in selected], indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        writer.writerows((r["date"], r["category"], f"{a:.2f}", r["note"]) for r, a, _, _ in selected)
+    elif args.format == "markdown":
+        print("| Date | Category | Amount | Note |\n| --- | --- | ---: | --- |")
+        for row, amount, _, _ in selected:
+            print(f"| {row['date']} | {row['category']} | {_money(amount)} | {row['note'].replace('|', r'\\|')} |")
+        print(f"| Total | | {_money(total)} | |")
+    else:
+        data = [[r["date"], r["category"], a, r["note"][:23] + "…" if len(r["note"]) > 24 else r["note"]] for r, a, _, _ in selected]
+        print(_table(["Date", "Category", "Amount", "Note"], data, total, args.currency, args.no_header), end="")
+    if invalid:
+        print(f"warning: skipped {invalid} row{'s' if invalid != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _bad_date(value):
+    try:
+        date.fromisoformat(value)
+        return False
+    except ValueError:
+        return True
+
+
+def _table(headers, rows, total, currency, no_header):
+    amount_col = 2
+    rows = [list(map(str, row)) for row in rows]
+    if headers[0] in ("Category", "Month"):
+        rows = [[r[0], r[1], currency + _money(Decimal(r[2]))] for r in rows]
+    else:
+        rows = [[r[0], r[1], currency + _money(Decimal(r[2])), r[3]] for r in rows]
+    widths = [max(len(headers[i]), *(len(r[i]) for r in rows), len("Total") if i == 0 else 0,
+                  len(currency + _money(total)) if i == amount_col else 0) for i in range(len(headers))]
+    lines = []
+    if not no_header:
+        lines += ["  ".join(h.rjust(widths[i]) if i == amount_col else h.ljust(widths[i]) for i, h in enumerate(headers)),
+                  "  ".join("-" * width for width in widths)]
+    lines += ["  ".join(v.rjust(widths[i]) if i == amount_col else v.ljust(widths[i]) for i, v in enumerate(row)) for row in rows]
+    lines.append("  ".join(("Total" if i == 0 else currency + _money(total) if i == amount_col else "").ljust(widths[i]) for i in range(len(headers))))
+    return "\n".join(lines) + "\n"
+
+
+def _money(amount):
+    return f"({abs(amount):,.2f})" if amount < 0 else f"{amount:,.2f}"
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
