+import argparse
+import csv
+import json
+import sys
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+from app.expenses import load
+
+
+def _table(headers, rows, total, no_header, numeric=()):
+    rows = [[str(value) for value in row] for row in rows]
+    widths = [max([len(headers[i])] + [len(row[i]) for row in rows]) for i in range(len(headers))]
+    lines = []
+    if not no_header:
+        lines += ["  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)),
+                  "  ".join("-" * width for width in widths)]
+    lines += ["  ".join(row[i].rjust(widths[i]) if i in numeric else row[i].ljust(widths[i])
+                       for i in range(len(headers))) for row in rows]
+    lines.append(f"Total{' ' * max(1, sum(widths) + 2 * (len(widths) - 1) - 5)}{total}")
+    return "\n".join(lines) + "\n"
+
+
+def _groups(expenses, by):
+    groups = {}
+    for e in expenses:
+        key = e["category"] if by == "category" else e["date"].strftime("%Y-%m")
+        groups.setdefault(key, []).append(e)
+    key = (lambda pair: (-_total(pair[1]), pair[0].casefold())) if by == "category" else lambda pair: pair[0]
+    return sorted(groups.items(), key=key)
+
+
+def _total(expenses):
+    return sum((e["amount"] for e in expenses), Decimal(0))
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Report expenses from a CSV file.")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--exclude", action="append", default=[], metavar="NAME", help="exclude a category (repeatable)")
+    parser.add_argument("--from", dest="date_from")
+    parser.add_argument("--to", dest="date_to")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (ValueError, TypeError):
+        raise ValueError(f"error: invalid date: {value}")
+
+
+def main(argv: list[str]) -> int:
+    try:
+        args = _parser().parse_args(argv)
+    except SystemExit as exc:
+        return int(exc.code)
+
+    try:
+        start = _date(args.date_from) if args.date_from else None
+        end = _date(args.date_to) if args.date_to else None
+        if start and end and start > end:
+            raise ValueError("error: --from is after --to")
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+        if args.top is not None and args.top < 0:
+            raise ValueError("error: --top must be non-negative")
+        raw_rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except (ValueError, InvalidOperation) as exc:
+        print(str(exc) if str(exc).startswith("error:") else f"error: invalid amount: {args.minimum}", file=sys.stderr)
+        return 2
+
+    expenses, invalid = [], 0
+    try:
+        for index, row in enumerate(raw_rows):
+            try:
+                amount = Decimal(row["amount"])
+                if not amount.is_finite():
+                    raise InvalidOperation
+            except (InvalidOperation, TypeError, KeyError):
+                invalid += 1
+                continue
+            expenses.append({"date": _date(row["date"]), "category": row["category"], "amount": amount,
+                             "note": row.get("note", ""), "index": index})
+    except ValueError as exc:
+        print(str(exc), file=sys.stderr)
+        return 2
+
+    categories = {x.casefold() for x in args.category}
+    excluded = {x.casefold() for x in args.exclude}
+    expenses = [e for e in expenses if
+                (not categories or e["category"].casefold() in categories)
+                and e["category"].casefold() not in excluded
+                and (not start or e["date"] >= start) and (not end or e["date"] <= end)
+                and (minimum is None or e["amount"] >= minimum)]
+    expenses.sort(key=lambda e: (e["date"], e["index"]))
+    if args.top is not None:
+        expenses = sorted(expenses, key=lambda e: -e["amount"])[:args.top]
+
+    if not expenses:
+        print("No expenses.")
+    elif args.format == "json":
+        data = _groups(expenses, args.by) if args.by else expenses
+        if args.by:
+            data = [{"group": key, "count": len(items), "total": float(_total(items))} for key, items in data]
+        else:
+            data = [{"date": e["date"].isoformat(), "category": e["category"], "amount": float(e["amount"]), "note": e["note"]} for e in data]
+        print(json.dumps(data, indent=2))
+    elif args.format == "markdown":
+        print("| Date | Category | Amount | Note |")
+        print("| --- | --- | ---: | --- |")
+        for e in expenses:
+            print(f"| {e['date'].isoformat()} | {e['category']} | {_money(e['amount'])} | {e['note']} |")
+        print(f"| Total | | {_money(_total(expenses))} | |")
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        if args.by:
+            writer.writerow(("group", "count", "total"))
+            writer.writerows((key, len(items), f"{_total(items):.2f}") for key, items in _groups(expenses, args.by))
+        else:
+            writer.writerow(("date", "category", "amount", "note"))
+            writer.writerows((e["date"].isoformat(), e["category"], f"{e['amount']:.2f}", e["note"]) for e in expenses)
+    elif args.by:
+        groups = _groups(expenses, args.by)
+        label = "Category" if args.by == "category" else "Month"
+        rows = [[key.title() if args.by == "category" else key, len(items), _money(_total(items))]
+                for key, items in groups]
+        print(_table([label, "Count", "Total"], rows, args.currency + _money(_total(expenses)), args.no_header, (1, 2)), end="")
+    else:
+        rows = [[e["date"].isoformat(), e["category"],
+                 args.currency + (f"({_money(abs(e['amount']))})" if e["amount"] < 0 else _money(e["amount"])),
+                 e["note"] if len(e["note"]) <= 24 else e["note"][:23] + "…"] for e in expenses]
+        print(_table(["Date", "Category", "Amount", "Note"], rows,
+                     args.currency + _money(_total(expenses)), args.no_header, (2,)), end="")
+
+    if invalid:
+        print(f"warning: skipped {invalid} row{'s' if invalid != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
