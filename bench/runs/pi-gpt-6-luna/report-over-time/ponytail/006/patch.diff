+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--exclude", action="append", default=[], metavar="NAME",
+                        help="exclude a category (repeatable)")
+    parser.add_argument("--from", dest="start", type=_date)
+    parser.add_argument("--to", dest="end", type=_date)
+    parser.add_argument("--min", dest="minimum", type=Decimal)
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _table(headers, rows, total, currency="", amount_col=None, no_header=False):
+    widths = [max(len(header), *(len(str(row[i])) for row in rows)) for i, header in enumerate(headers)]
+    if amount_col is not None:
+        widths[amount_col] = max(widths[amount_col], len(currency + _money(total)))
+    lines = []
+    if not no_header:
+        lines += ["  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)).rstrip(),
+                  "  ".join("-" * width for width in widths)]
+    lines += ["  ".join((str(cell).rjust(widths[i]) if i == amount_col else str(cell).ljust(widths[i])
+                         for i, cell in enumerate(row))).rstrip() for row in rows]
+    lines.append(f"Total{' ' * max(1, sum(widths) - 5)}{currency}{_money(total)}")
+    return "\n".join(lines) + "\n"
+
+
+def _amount(row):
+    try:
+        amount = Decimal(row["amount"])
+        return amount if amount.is_finite() else None
+    except (KeyError, TypeError, InvalidOperation, ValueError):
+        return None
+
+
+def main(argv: list[str]) -> int:
+    args = _parser().parse_args(argv)
+    if args.start and args.end and args.start > args.end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        source = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    valid, skipped = [], 0
+    for index, row in enumerate(source):
+        amount = _amount(row)
+        if amount is None:
+            skipped += 1
+        else:
+            valid.append((index, row, amount))
+    valid.sort(key=lambda item: (item[1].get("date", ""), item[0]))
+
+    categories = {value.casefold() for value in args.category}
+    excluded = {value.casefold() for value in args.exclude}
+    selected = []
+    for item in valid:
+        _, row, amount = item
+        try:
+            day = date.fromisoformat(row["date"])
+        except (KeyError, TypeError, ValueError):
+            day = None
+        category = row.get("category", "").casefold()
+        if ((categories and category not in categories) or category in excluded
+                or (args.start and (day is None or day < args.start))
+                or (args.end and (day is None or day > args.end))
+                or (args.minimum is not None and amount < args.minimum)):
+            continue
+        selected.append(item)
+    if args.top is not None:
+        selected = sorted(selected, key=lambda item: item[2], reverse=True)[:max(args.top, 0)]
+
+    total = sum((amount for _, _, amount in selected), Decimal(0))
+    if not selected:
+        print("No expenses.")
+    elif args.by:
+        groups = {}
+        for _, row, amount in selected:
+            key = row.get("category", "") if args.by == "category" else row.get("date", "")[:7]
+            count, subtotal = groups.get(key, (0, Decimal(0)))
+            groups[key] = count + 1, subtotal + amount
+        groups = sorted(groups.items(), key=lambda pair:
+                        (-pair[1][1], pair[0].casefold()) if args.by == "category" else pair[0])
+        if args.format == "json":
+            print(json.dumps([{"group": key, "count": count, "total": float(amount)}
+                              for key, (count, amount) in groups], indent=2))
+        else:
+            rows = [[key.title() if args.by == "category" else key, str(count), _money(amount)]
+                    for key, (count, amount) in groups]
+            first = "Category" if args.by == "category" else "Month"
+            print(_table([first, "Count", "Total"], rows, total, args.currency, 2, args.no_header), end="")
+    elif args.format == "json":
+        print(json.dumps([{"date": row.get("date", ""), "category": row.get("category", ""),
+                           "amount": float(amount), "note": row.get("note", "")}
+                          for _, row, amount in selected], indent=2))
+    elif args.format == "markdown":
+        print("| Date | Category | Amount | Note |")
+        print("| --- | --- | ---: | --- |")
+        for _, row, amount in selected:
+            print(f"| {row.get('date', '')} | {row.get('category', '')} | {_money(amount)} | {row.get('note', '')} |")
+        print(f"| Total | | {_money(total)} | |")
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        writer.writerows([row.get("date", ""), row.get("category", ""), f"{amount:.2f}", row.get("note", "")]
+                         for _, row, amount in selected)
+    else:
+        rows = [[row.get("date", ""), row.get("category", ""),
+                 f"({args.currency}{_money(-amount)})" if amount < 0 else args.currency + _money(amount),
+                 row.get("note", "")[:23] + "…" if len(row.get("note", "")) > 24 else row.get("note", "")]
+                for _, row, amount in selected]
+        print(_table(["Date", "Category", "Amount", "Note"], rows, total,
+                     args.currency, 2, args.no_header), end="")
+    if skipped:
+        print(f"warning: skipped {skipped} row{'s' if skipped != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
