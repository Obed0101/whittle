+"""Print expense reports."""
+import argparse
+import csv
+import json
+import sys
+from datetime import date
+from decimal import Decimal, InvalidOperation
+from io import StringIO
+
+from .expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Report expenses from a CSV file.", epilog="Example: python -m app.report expenses.csv --by month --format json")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--exclude", action="append", default=[], metavar="NAME", help="exclude a category (repeatable)")
+    parser.add_argument("--from", dest="start")
+    parser.add_argument("--to", dest="end")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _date(value):
+    try:
+        result = date.fromisoformat(value)
+        if result.isoformat() == value:
+            return result
+    except (ValueError, TypeError):
+        pass
+    raise ValueError(f"invalid date: {value}")
+
+
+def _money(value):
+    try:
+        result = Decimal(value)
+        return result if result.is_finite() else None
+    except (InvalidOperation, TypeError):
+        return None
+
+
+def _table(headers, rows, total, currency="", no_header=False):
+    widths = [max(len(header), *(len(str(row[i])) for row in rows)) for i, header in enumerate(headers)]
+    amount = next((i for i, header in enumerate(headers) if header in ("Amount", "Total")), -1)
+    lines = []
+    if not no_header:
+        lines.extend(("  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)),
+                      "  ".join("-" * width for width in widths)))
+    lines.extend("  ".join(str(value).rjust(widths[i]) if i == amount else str(value).ljust(widths[i])
+                            for i, value in enumerate(row)) for row in rows)
+    value = f"{currency}{abs(total):,.2f}"
+    lines.append(f"Total {value if total >= 0 else f'({value})'}")
+    return "\n".join(lines) + "\n"
+
+
+def _render(chosen, args):
+    total = sum((amount for _, _, _, amount in chosen), Decimal(0))
+    if args.by:
+        groups = {}
+        for day, _, row, amount in chosen:
+            key = row["category"] if args.by == "category" else day.strftime("%Y-%m")
+            groups.setdefault(key, []).append(amount)
+        entries = list(groups.items())
+        entries.sort(key=(lambda item: (-sum(item[1]), item[0].casefold())) if args.by == "category" else lambda item: item[0])
+        if args.format == "json":
+            return json.dumps([{"group": key, "count": len(values), "total": float(sum(values))}
+                               for key, values in entries], indent=2) + "\n"
+        label = "Category" if args.by == "category" else "Month"
+        rows = [[key.title() if args.by == "category" else key, len(values),
+                 f"{args.currency}{sum(values):,.2f}"] for key, values in entries]
+        return _table([label, "Count", "Total"], rows, total, args.currency, args.no_header)
+
+    if args.format == "json":
+        return json.dumps([{"date": row["date"], "category": row["category"], "amount": float(amount), "note": row["note"]}
+                           for _, _, row, amount in chosen], indent=2) + "\n"
+    if args.format == "csv":
+        stream = StringIO(newline="")
+        writer = csv.writer(stream, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        writer.writerows([row["date"], row["category"], f"{amount:.2f}", row["note"]]
+                         for _, _, row, amount in chosen)
+        return stream.getvalue()
+    if args.format == "markdown":
+        lines = ["| Date | Category | Amount | Note |", "| --- | --- | ---: | --- |"]
+        lines.extend(f"| {row['date']} | {row['category']} | {amount:,.2f} | {row['note'].replace('|', r'\\|')} |"
+                     for _, _, row, amount in chosen)
+        lines.append(f"| Total | | {total:,.2f} | |")
+        return "\n".join(lines) + "\n"
+    rows = [[row["date"], row["category"],
+             f"{args.currency}{amount:,.2f}" if amount >= 0 else f"({args.currency}{abs(amount):,.2f})",
+             row["note"] if len(row["note"]) <= 24 else row["note"][:23] + "…"]
+            for _, _, row, amount in chosen]
+    return _table(["Date", "Category", "Amount", "Note"], rows, total, args.currency, args.no_header)
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+        start, end = (_date(value) if value else None for value in (args.start, args.end))
+        if start and end and start > end:
+            raise ValueError("--from is after --to")
+        minimum = _money(args.minimum) if args.minimum is not None else None
+        if args.minimum is not None and minimum is None:
+            raise ValueError(f"invalid amount: {args.minimum}")
+        records = load(args.path)
+    except SystemExit as exc:
+        return int(exc.code)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except ValueError as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 2
+
+    chosen, invalid = [], 0
+    categories = {value.casefold() for value in args.category}
+    excluded = {value.casefold() for value in args.exclude}
+    for index, row in enumerate(records):
+        amount = _money(row.get("amount"))
+        if amount is None:
+            invalid += 1
+            continue
+        try:
+            day = _date(row.get("date"))
+        except ValueError as exc:
+            print(f"error: {exc}", file=sys.stderr)
+            return 2
+        category = row["category"].casefold()
+        if ((not categories or category in categories) and category not in excluded
+                and (start is None or day >= start) and (end is None or day <= end)
+                and (minimum is None or amount >= minimum)):
+            chosen.append((day, index, row, amount))
+    if args.top is not None:
+        chosen.sort(key=lambda item: (-item[3], item[1]))
+        chosen = chosen[:max(0, args.top)]
+    else:
+        chosen.sort(key=lambda item: (item[0], item[1]))
+
+    sys.stdout.write(_render(chosen, args) if chosen else "No expenses.\n")
+    if invalid:
+        print(f"warning: skipped {invalid} row{'s' if invalid != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
