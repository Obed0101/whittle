@@ -0,0 +1,140 @@
+"""Render expense CSV reports."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from .expenses import load
+
+
+def main(argv: list[str]) -> int:
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Report expenses from a CSV file.", epilog="Example: python -m app.report expenses.csv --by month")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--exclude", action="append", default=[], metavar="NAME", help="exclude a category (repeatable)")
+    parser.add_argument("--from", dest="start")
+    parser.add_argument("--to", dest="end")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    args = parser.parse_args(argv)
+
+    def parse_date(value):
+        try:
+            return date.fromisoformat(value)
+        except (ValueError, TypeError):
+            print(f"error: invalid date: {value}", file=sys.stderr)
+            raise SystemExit(2)
+
+    start = parse_date(args.start) if args.start else None
+    end = parse_date(args.end) if args.end else None
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    valid, skipped = [], 0
+    for row in rows:
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+            day = parse_date(row["date"])
+        except (InvalidOperation, ValueError, KeyError):
+            skipped += 1
+            continue
+        except SystemExit:
+            return 2
+        valid.append((row, amount, day))
+
+    categories = {name.casefold() for name in args.category}
+    excluded = {name.casefold() for name in args.exclude}
+    filtered = [(row, amount, day) for row, amount, day in valid
+                if (not categories or row["category"].casefold() in categories)
+                and row["category"].casefold() not in excluded
+                and (start is None or day >= start) and (end is None or day <= end)
+                and (args.minimum is None or amount >= Decimal(args.minimum))]
+    filtered.sort(key=lambda item: item[2])
+    if args.top is not None:
+        filtered = sorted(filtered, key=lambda item: item[1], reverse=True)[:max(0, args.top)]
+
+    total = sum((amount for _, amount, _ in filtered), Decimal(0))
+    if args.format == "json":
+        result = _groups(filtered, args.by) if args.by else [
+            {"date": row["date"], "category": row["category"], "amount": float(amount), "note": row["note"]}
+            for row, amount, _ in filtered]
+        if args.by:
+            result = [{**item, "total": float(item["total"])} for item in result]
+        print(json.dumps(result, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        writer.writerows([row["date"], row["category"], f"{amount:.2f}", row["note"]]
+                         for row, amount, _ in filtered)
+    elif args.format == "markdown":
+        print("| Date | Category | Amount | Note |")
+        print("| --- | --- | ---: | --- |")
+        for row, amount, _ in filtered:
+            print(f"| {row['date']} | {row['category']} | {amount:,.2f} | {row['note']} |")
+        print(f"| Total | | {total:,.2f} | |")
+    elif not filtered:
+        print("No expenses.")
+    elif args.by:
+        groups = _groups(filtered, args.by)
+        first = "Category" if args.by == "category" else "Month"
+        lines = [[first, "Count", "Total"]] + [
+            [item["group"].title() if args.by == "category" else item["group"],
+             str(item["count"]), args.currency + f"{item['total']:,.2f}"]
+            for item in groups]
+        lines.append(["Total", "", args.currency + f"{total:,.2f}"])
+        _table(lines, args.no_header, 2)
+    else:
+        lines = [["Date", "Category", "Amount", "Note"]]
+        for row, amount, _ in filtered:
+            shown = f"({abs(amount):,.2f})" if amount < 0 else f"{amount:,.2f}"
+            note = row["note"] if len(row["note"]) <= 24 else row["note"][:23] + "…"
+            lines.append([row["date"], row["category"], args.currency + shown, note])
+        shown = f"({abs(total):,.2f})" if total < 0 else f"{total:,.2f}"
+        lines.append(["Total", "", args.currency + shown, ""])
+        _table(lines, args.no_header, 2)
+
+    if skipped:
+        noun = "row" if skipped == 1 else "rows"
+        print(f"warning: skipped {skipped} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _groups(rows, by):
+    groups = {}
+    for row, amount, day in rows:
+        key = row["category"] if by == "category" else day.strftime("%Y-%m")
+        groups.setdefault(key, []).append(amount)
+    result = [{"group": key, "count": len(amounts), "total": sum(amounts, Decimal(0))}
+              for key, amounts in groups.items()]
+    result.sort(key=(lambda item: (-item["total"], item["group"].casefold()))
+                if by == "category" else lambda item: item["group"])
+    return result
+
+
+def _table(lines, no_header, amount_col):
+    widths = [max(len(str(row[i])) for row in lines) for i in range(len(lines[0]))]
+    if not no_header:
+        print("  ".join(str(v).ljust(widths[i]) for i, v in enumerate(lines[0])))
+        print("  ".join("-" * width for width in widths))
+    for row in lines[1:-1]:
+        print("  ".join(str(v).rjust(widths[i]) if i == amount_col else str(v).ljust(widths[i])
+                         for i, v in enumerate(row)))
+    print("  ".join(str(v).ljust(widths[i]) for i, v in enumerate(lines[-1])))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
