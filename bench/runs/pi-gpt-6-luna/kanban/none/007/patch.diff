+    <div class="page-heading"><div><div class="eyebrow"><span class="live-dot"></span> YOUR PERSONAL SPACE</div><h1>My board<span class="heading-spark">✳</span></h1><p class="subtitle" id="dateLine">A little progress goes a long way.</p></div><button class="primary-button" id="newTask"><span>＋</span> New task <kbd>N</kbd></button></div>
+    <div class="board-toolbar"><div class="view-tabs"><button class="view-tab active" data-view="board">▦ <span>Board</span></button><button class="view-tab" data-view="list">☷ <span>List</span></button></div><div class="toolbar-right"><span class="task-summary" id="taskSummary"></span><button class="filter-button" id="filterButton">☷ <span>Filter</span><span id="filterDot"></span></button><button class="sort-button" id="sortButton">↕ <span>Priority</span></button><button class="icon-button more-button" id="moreButton" title="More options">···</button></div></div>
+    <div class="filter-panel" id="filterPanel" hidden><label>Priority<select id="priorityFilter"><option value="all">All priorities</option><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select></label><label>Label<select id="labelFilter"><option value="all">All labels</option></select></label><button class="clear-filter" id="clearFilters">Clear filters</button></div>
