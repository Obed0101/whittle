+function wireCards(){document.querySelectorAll('.task-card').forEach(el=>{el.addEventListener('dragstart',e=>{e.dataTransfer.setData('text/plain',el.dataset.id);el.classList.add('dragging')});el.addEventListener('dragend',()=>el.classList.remove('dragging'));el.addEventListener('dblclick',()=>openTask(el.dataset.id))});document.querySelectorAll('[data-drop]').forEach(el=>{el.addEventListener('dragover',e=>{e.preventDefault();el.classList.add('drop-target')});el.addEventListener('dragleave',()=>el.classList.remove('drop-target'));el.addEventListener('drop',e=>{e.preventDefault();el.classList.remove('drop-target');let t=state.tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=el.dataset.drop;save();notify('Task moved')}})});document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>openTask(null,b.dataset.add));document.querySelectorAll('[data-menu]').forEach(b=>b.onclick=e=>{e.stopPropagation();openTask(b.dataset.menu)})}
