+$('#exportButton').onclick=()=>{let blob=new Blob([JSON.stringify({tasks:state.tasks,version:1},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='daymark-board.json';a.click();URL.revokeObjectURL(a.href);$('#quickMenu').hidden=true;notify('Board exported')};$('#importButton').onclick=()=>$('#importFile').click();$('#importFile').onchange=async e=>{try{let data=JSON.parse(await e.target.files[0].text());if(!Array.isArray(data.tasks))throw Error();state.tasks=data.tasks;save();notify('Board imported')}catch{notify('Could not read that board file')}e.target.value='';$('#quickMenu').hidden=true};$('#resetButton').onclick=()=>{if(confirm('Replace your board with the starter tasks? This cannot be undone.')){state.tasks=sample.map(x=>({...x}));save();notify('Starter board restored')}$('#quickMenu').hidden=true};document.addEventListener('click',e=>{if(!e.target.closest('#quickMenu,#moreButton,#settingsButton'))$('#quickMenu').hidden=true});document.addEventListener('keydown',e=>{if(e.key==='Escape'){document.querySelectorAll('.modal-backdrop').forEach(x=>x.hidden=true);$('#quickMenu').hidden=true}if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();$('#searchInput').focus()}if(e.key.toLowerCase()==='n'&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName)&&!e.metaKey&&!e.ctrlKey){e.preventDefault();openTask()}});
