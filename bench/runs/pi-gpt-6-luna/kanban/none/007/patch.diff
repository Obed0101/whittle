+function dayOffset(n){const d=new Date();d.setDate(d.getDate()+n);return d.toISOString().slice(0,10)}
+let state;try{state=JSON.parse(localStorage.getItem(KEY))}catch{}if(!state||!Array.isArray(state.tasks))state={tasks:sample.map(x=>({...x})),view:'board',dark:false};
+state.tasks=state.tasks.filter(t=>t&&typeof t.title==='string');let editId=null,priorityFilter='all',labelFilter='all',query='',sortPriority=true,toastTimer;
