+$('#boardView').hidden=state.view==='list';$('#listView').hidden=state.view!=='list';document.querySelectorAll('.view-tab').forEach(b=>b.classList.toggle('active',b.dataset.view===state.view));if(state.view==='list')renderList(items);document.body.classList.toggle('dark',!!state.dark);wireCards()}
