+function render(){ $('#boardName').textContent=data.name;$('#crumbName').textContent=data.name;$('#headingName').textContent=data.name;let root=$('#columns');root.innerHTML='';columns.forEach(([key,label,dot])=>{let tasks=data.tasks.filter(t=>t.status===key&&visible(t));if(sortDue)tasks.sort((a,b)=>(a.due||'9999').localeCompare(b.due||'9999'));let col=document.createElement('section');col.className='column';col.innerHTML=`<div class="column-head"><div class="column-name"><i class="status-dot ${dot}"></i>${label}<span class="column-count">${tasks.length}</span></div><button class="add-card" data-add="${key}" title="Add a task">＋</button></div><div class="task-list" data-status="${key}">${tasks.length?tasks.map(card).join(''):`<div class="empty-column" data-add="${key}">Drop a task here or click to add one</div>`}</div>`;root.appendChild(col)});save()}
