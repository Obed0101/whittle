+$('#searchInput').oninput=e=>{search=e.target.value;render()};$('#prioritySelect').onchange=e=>{priority=e.target.value;render()};$$('.view-btn').forEach(b=>b.onclick=()=>{$$('.view-btn').forEach(x=>x.classList.remove('active'));b.classList.add('active');activeView=b.dataset.filter;render()});$('#sortBtn').onclick=()=>{sortDue=!sortDue;$('#sortBtn').style.color=sortDue?'#53735e':'';render()};$('#renameBoard').onclick=()=>{let n=prompt('Name your board',data.name);if(n&&n.trim()){data.name=n.trim().slice(0,40);render()}};
