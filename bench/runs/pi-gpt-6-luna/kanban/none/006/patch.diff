+$('#newTask').onclick=()=>open(null);$('#search').oninput=e=>{query=e.target.value.toLowerCase();render()};document.querySelectorAll('.filter').forEach(b=>b.onclick=()=>{document.querySelector('.filter.active').classList.remove('active');b.classList.add('active');filter=b.dataset.filter;render()});$('#todayBtn').onclick=()=>{filter='all';query='';$('#search').value='';document.querySelector('.filter.active').classList.remove('active');document.querySelector('[data-filter="all"]').classList.add('active');render();toast('Showing your whole board')};document.addEventListener('keydown',e=>{if(e.key==='Escape')close();if(e.key.toLowerCase()==='n'&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName)&&!e.metaKey&&!e.ctrlKey){e.preventDefault();open(null)}});$('#exportBtn').onclick=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(tasks,null,2)],{type:'application/json'}));a.download='monday-board.json';a.click();URL.revokeObjectURL(a.href);toast('Board exported')};$('#importBtn').onclick=()=>$('#importFile').click();$('#importFile').onchange=async e=>{try{let data=JSON.parse(await e.target.files[0].text());if(!Array.isArray(data)||!data.every(t=>t.title&&t.status))throw Error();if(confirm(`Replace your board with ${data.length} imported tasks?`)){tasks=data;save();toast('Board imported')}}catch{toast('Could not import that file')}e.target.value=''};$('#dateLine').textContent=new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'})+' · A little progress, every day.';render();
