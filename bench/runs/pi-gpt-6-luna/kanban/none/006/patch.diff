.id===e.dataTransfer.getData('text/plain'));if(t){t.status=key;save()}});columns.append(col)}const remaining=tasks.filter(t=>t.status!=='done').length;$('#boardMeta').textContent=`${remaining} active · ${tasks.length} total`;}
+function open(t,status='todo'){form.reset();$('#taskId').value=t?.id||'';$('#modalTitle').textContent=t?'Edit task':'New task';$('#title').value=t?.title||'';$('#description').value=t?.description||'';$('#status').value=t?.status||status;$('#category').value=t?.category||'work';$('#due').value=t?.due||'';$('#checklist').value=t?.checks||'';$('#deleteTask').style.visibility=t?'visible':'hidden';backdrop.classList.add('open');setTimeout(()=>$('#title').focus(),40)}function close(){backdrop.classList.remove('open')}form.onsubmit=e=>{e.preventDefault();let id=$('#taskId').value,t=tasks.find(x=>x.id===id);const data={title:$('#title').value.trim(),description:$('#description').value.trim(),status:$('#status').value,category:$('#category').value,due:$('#due').value,checks:$('#checklist').value.trim()};if(t)Object.assign(t,data);else tasks.unshift({...data,id:crypto.randomUUID?.()||String(Date.now()),created:Date.now()});save();close();toast(t?'Task updated':'Task added')};$('#deleteTask').onclick=()=>{let id=$('#taskId').value;tasks=tasks.filter(t=>t.id!==id);save();close();toast('Task deleted')};$('#cancel').onclick=close;backdrop.onclick=e=>{if(e.target===backdrop)close()};function toast(s){const el=$('#toast');el.textContent=s;el.classList.add('show');clearTimeout(toast.timer);toast.timer=setTimeout(()=>el.classList.remove('show'),2200)}function menu(btn,t){document.querySelector('.menu')?.remove();let r=btn.getBoundingClientRect(),m=document.createElement('div');m.className='menu';m.style.top=Math.min(r.bottom+4,innerHeight-130)+'px';m.style.left=Math.min(r.right-150,innerWidth-160)+'px';m.innerHTML='<button data-act="edit">Edit task</button><button data-act="move">Move to…</button><button data-act="remove" class="remove">Delete task</button>';document.body.append(m);m.onclick=e=>{let a=e.target.dataset.act;if(a==='edit')open(t);if(a==='remove'){tasks=tasks.filter(x=>x.id!==t.id);save();toast('Task deleted')}if(a==='move'){t.status=statuses[(statuses.findIndex(s=>s[0