+$('#taskForm').addEventListener('submit',e=>{if(e.submitter?.value==='cancel')return;e.preventDefault();let id=$('#taskId').value,old=state.tasks.find(t=>t.id===id),data={title:$('#taskName').value.trim(),notes:$('#taskNotes').value.trim(),column:$('#taskColumn').value,due:$('#taskDue').value,priority:$('#taskPriority').value,label:$('#taskLabel').value.trim(),done:old?.done||false,created:old?.created||Date.now()};if(!data.title)return;if(old)Object.assign(old,data);else state.tasks.push({id:uid(),...data});$('#taskDialog').close();persist();notify(old?'Task updated':'Task added')});
+$('#deleteTask').onclick=()=>{let id=$('#taskId').value;state.tasks=state.tasks.filter(t=>t.id!==id);$('#taskDialog').close();persist();notify('Task deleted')};$('#quickAdd').onclick=()=>openTask(null,state.columns[0]?.id);$('#board').addEventListener('click',e=>{let edit=e.target.closest('[data-edit]');if(edit)openTask(state.tasks.find(t=>t.id===edit.dataset.edit));let add=e.target.closest('[data-add]');if(add)openTask(null,add.dataset.add);let menu=e.target.closest('[data-menu]');if(menu){let c=state.columns.find(x=>x.id===menu.dataset.menu);if(confirm(`Delete “${c.name}”? Tasks in this list will move to the first list.`)){let dest=state.columns.find(x=>x.id!==c.id);state.tasks.forEach(t=>{if(t.column===c.id)t.column=dest.id});state.columns=state.columns.filter(x=>x.id!==c.id);persist();notify('List deleted')}}});document.addEventListener('change',e=>{if(e.target.matches('[data-check]')){let t=state.tasks.find(x=>x.id===e.target.dataset.check);if(t){t.done=e.target.checked;if(t.done&&state.columns.find(c=>c.id===t.column)?.name.toLowerCase().includes('done')){}else if(t.done){let done=state.columns.find(c=>/done|complete/i.test(c.name));if(done)t.column=done.id}persist();notify(t.done?'Nice work — task completed':'Task reopened')}}});
