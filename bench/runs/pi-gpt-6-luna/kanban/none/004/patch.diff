+function render(){const today=new Date().toISOString().slice(0,10);$('#todayCount').textContent=state.tasks.filter(t=>!t.done&&t.due===today).length;$('#dateLabel').textContent=new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'}).toUpperCase();const titles={board:['My board','A little progress, every day.'],today:['Today','A clear view of what’s on your plate.'],upcoming:['Coming up','The next few things worth keeping in sight.'],done:['Completed','Look at everything you’ve moved forward.']};$('#pageTitle').innerHTML=esc(titles[view][0])+'<span class="title-spark">✳</span>';$('#pageSubtitle').textContent=titles[view][1];$('#crumb').textContent=({board:'MY BOARD',today:'TODAY',upcoming:'UPCOMING',done:'COMPLETED'})[view];$$('.nav-item[data-view]').forEach(b=>b.classList.toggle('active',b.dataset.view===view));$('#sideLists').innerHTML=state.columns.map(c=>`<div class="side-list"><i class="dot"></i>${esc(c.name)}<small>${state.tasks.filter(t=>t.column===c.id&&!t.done).length}</small></div>`).join('');let labels=[...new Set(state.tasks.map(t=>t.label).filter(Boolean))];$('#labelFilter').innerHTML='<option value="all">All labels</option>'+labels.map(l=>`<option value="${esc(l)}">${esc(l)}</option>`).join('');$('#labelFilter').value=labelFilter;$('#priorityFilter').value=priorityFilter;$('#filterDot').style.display=priorityFilter!=='all'||labelFilter!=='all'?'block':'none';$('#board').hidden=layout!=='board';$('#listView').hidden=layout!=='list';$$('.tab').forEach(b=>b.classList.toggle('active',b.dataset.layout===layout));let tasks=getTasks();$('#taskSummary').textContent=`${state.tasks.filter(t=>!t.done).length} active · ${state.tasks.filter(t=>t.done).length} completed`;$('#clearDone').style.display=state.tasks.some(t=>t.done)?'':'none';if(view==='board'){let cols=state.columns;if(!cols.length)$('#board').innerHTML='<div class="empty-state"><b>No lists yet</b>Add a list to get started.</div>';else $('#board').innerHTML=cols.map(c=>{let 