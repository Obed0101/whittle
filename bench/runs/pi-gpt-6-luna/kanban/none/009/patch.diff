+<title>Daymark — Personal kanban</title>
+<style>
+:root{--ink:#202b26;--muted:#7a8580;--line:#e7eae6;--paper:#f6f7f5;--white:#fff;--green:#28745b;--green2:#e8f2ed;--orange:#cf7952;--shadow:0 12px 35px #24352c12;font:14px/1.45 Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink)}button,input,textarea,select{font:inherit}button{cursor:pointer;color:inherit}.app{max-width:1440px;margin:auto;padding:0 42px 50px}.topbar{height:76px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{display:flex;gap:11px;align-items:center;font-weight:750;letter-spacing:-.4px;font-size:17px}.mark{width:30px;height:30px;border-radius:9px;background:var(--green);color:#fff;display:grid;place-items:center;font-size:15px}.topright{display:flex;align-items:center;gap:18px;color:var(--muted);font-size:13px}.avatar{width:31px;height:31px;display:grid;place-items:center;border-radius:50%;background:#e4e9e3;color:#435c4e;font-weight:700}.intro{padding:35px 0 25px;display:flex;align-items:flex-end;justify-content:space-between}.eyebrow{text-transform:uppercase;letter-spacing:1.5px;font-size:10px;color:var(--green);font-weight:750}.intro h1{font-size:31px;letter-spacing:-1.2px;margin:4px 0 4px}.intro p{margin:0;color:var(--muted)}.primary{background:var(--green);color:#fff;border:0;border-radius:8px;padding:11px 16px;font-weight:650;box-shadow:0 3px 8px #28745b20}.primary:hover{background:#1e604a}.primary span{font-size:17px;margin-right:6px;vertical-align:-1px}.toolbar{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:18px}.tabs{display:flex;gap:5px}.tab{border:0;background:transparent;padding:8px 12px;border-radius:7px;color:var(--muted);font-weight:600}.tab.active{color:var(--ink);background:#e9ece8}.tools{display:flex;align-items:center;gap:9px}.search{position:relative}.search input{width:205px;border:1px solid var(--line);background:#fff;border-radius:8px;padding:9px 12px 9px 34px;outline:none}.search:before{content:'⌕';position:absolute;left:12px;top:4px;font-size:21px;color:#8a958f}.search input:focus,.field input:focus,.field textarea:focus,.field select:focus{border-color:#8ab39f;box-shadow:0 0 0 3px #28745b12}.toolbtn{border:1px solid var(--line);background:#fff;border-radius:8px;padding:9px 12px;color:#59645e}.toolbtn:hover{background:#f1f4f1}.board{display:grid;grid-template-columns:repeat(4,minmax(235px,1fr));gap:16px;align-items:start;overflow-x:auto;padding-bottom:18px}.column{border:1px solid #e9ece8;background:#f0f2ef;border-radius:11px;min-height:370px;padding:13px 11px 11px;transition:.15s}.column.over{background:#e7f1eb;border-color:#9cbeaa}.colhead{display:flex;align-items:center;justify-content:space-between;padding:0 4px 12px}.colname{display:flex;align-items:center;gap:8px;font-weight:700;font-size:13px}.dot{width:8px;height:8px;border-radius:50%;background:#8a9690}.column[data-status="doing"] .dot{background:#d99b55}.column[data-status="done"] .dot{background:#4b9b78}.count{font-size:11px;color:var(--muted);background:#e5e9e5;border-radius:20px;padding:2px 7px}.add-small{border:0;background:transparent;color:#89938d;font-size:19px;padding:0 3px;line-height:1}.cards{display:flex;flex-direction:column;gap:9px;min-height:300px}.card{background:white;border:1px solid #e7eae7;border-radius:9px;padding:12px 12px 10px;box-shadow:0 2px 5px #17231c08;cursor:grab;transition:transform .15s,box-shadow .15s}.card:hover{transform:translateY(-1px);box-shadow:var(--shadow)}.card.dragging{opacity:.42}.cardtop{display:flex;justify-content:space-between;gap:8px}.card h3{font-size:13px;line-height:1.4;margin:0 0 7px;font-weight:680}.menu{border:0;background:none;color:#9aa39e;padding:0 2px;font-size:17px;line-height:14px}.desc{font-size:12px;line-height:1.5;color:var(--muted);margin:0 0 11px;white-space:pre-wrap}.tags{display:flex;flex-wrap:wrap;gap:5px;margin:2px 0 10px}.tag{font-size:10px;font-weight:650;border-radius:4px;padding:3px 7px;background:#f1e9dc;color:#936f36}.tag.blue{background:#e8eff7;color:#567796}.tag.pink{background:#f5e9e7;color:#a2695d}.tag.green{background:#e6f0e9;color:#58816a}.cardfoot{display:flex;align-items:center;justify-content:space-between;color:#929b95;font-size:10px;padding-top:8px;border-top:1px solid #f0f2ef}.due{display:flex;align-items:center;gap:4px}.due.late{color:#c35f4d;font-weight:700}.priority{font-size:10px;color:#ad7652}.empty{color:#a0aaa3;text-align:center;font-size:12px;padding:35px 8px;border:1px dashed #d9dfda;border-radius:8px}.notice{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#25342d;color:white;padding:10px 15px;border-radius:8px;box-shadow:var(--shadow);display:none;z-index:10}.notice.show{display:flex;gap:12px;align-items:center}.notice button{border:0;background:none;color:#a7d4bb;font-weight:700}.modalback{position:fixed;inset:0;background:#17231c55;display:none;align-items:center;justify-content:center;padding:20px;z-index:5}.modalback.open{display:flex}.modal{background:white;width:min(520px,100%);border-radius:13px;padding:23px;box-shadow:0 24px 80px #17231c35}.modalhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:19px}.modalhead h2{margin:0;font-size:19px;letter-spacing:-.4px}.close{border:0;background:none;color:#88938c;font-size:22px}.field{margin-bottom:14px}.field label{display:block;font-size:11px;font-weight:700;color:#66726b;margin-bottom:6px}.field input,.field textarea,.field select{width:100%;border:1px solid #dfe5df;border-radius:7px;padding:10px 11px;outline:none;background:white;color:var(--ink)}.field textarea{resize:vertical;min-height:80px}.formrow{display:grid;grid-template-columns:1fr 1fr;gap:12px}.modalactions{display:flex;justify-content:space-between;align-items:center;margin-top:20px}.delete{border:0;background:none;color:#bd5c50;padding:9px 4px}.formright{display:flex;gap:9px}.cancel{border:1px solid var(--line);background:white;border-radius:7px;padding:9px 13px}.footer{font-size:11px;color:#9aa39d;padding:8px 2px}.hidden{display:none!important}
+@media(max-width:900px){.app{padding:0 22px 35px}.board{grid-template-columns:repeat(4,260px)}.topright .date{display:none}}@media(max-width:560px){.app{padding:0 15px 30px}.topbar{height:62px}.intro{padding:25px 0 20px;align-items:flex-start}.intro h1{font-size:26px}.intro p{font-size:12px}.primary{padding:10px 11px;font-size:12px}.toolbar{align-items:flex-start;flex-direction:column}.tools{width:100%}.search{flex:1}.search input{width:100%}.board{grid-template-columns:repeat(4,82vw);gap:11px}.formrow{grid-template-columns:1fr 1fr}}
+</style>
+</head>
+<body><div class="app">
+<header class="topbar"><div class="brand"><div class="mark">↗</div> daymark</div><div class="topright"><span class="date" id="today"></span><span class="avatar">Y</span></div></header>
+<section class="intro"><div><div class="eyebrow">Your space · Personal</div><h1>Good things, in motion.</h1><p>A little progress every day adds up.</p></div><button class="primary" id="newTask"><span>＋</span>New task</button></section>
+<div class="toolbar"><nav class="tabs" aria-label="Task filters"><button class="tab active" data-filter="all">All tasks</button><button class="tab" data-filter="active">Active</button><button class="tab" data-filter="overdue">Overdue</button></nav><div class="tools"><div class="search"><input id="search" type="search" placeholder="Search tasks…" aria-label="Search tasks"></div><button class="toolbtn" id="clearDone">Clear completed</button></div></div>
+<main class="board" id="board" aria-label="Kanban board"></main><div class="footer">Your board is saved automatically on this device.</div></div>
+<div class="notice" id="notice"><span id="noticeText"></span><button id="undo">Undo</button></div>
+<div class="modalback" id="modalback"><section class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle"><div class="modalhead"><h2 id="modalTitle">New task</h2><button class="close" id="closeModal" aria-label="Close">×</button></div><form id="taskForm"><div class="field"><label for="title">Task</label><input id="title" required maxlength="100" placeholder="What needs doing?"></div><div class="field"><label for="description">Notes</label><textarea id="description" maxlength="500" placeholder="Add a little context…"></textarea></div><div class="formrow"><div class="field"><label for="status">Column</label><select id="status"><option value="todo">To do</option><option value="doing">In progress</option><option value="done">Done</option></select></div><div class="field"><label for="priority">Priority</label><select id="priority"><option value="normal">Normal</option><option value="high">High</option><option value="low">Low</option></select></div></div><div class="formrow"><div class="field"><label for="due">Due date</label><input type="date" id="due"></div><div class="field"><label for="tag">Label <span style="font-weight:400">(optional)</span></label><input id="tag" maxlength="24" placeholder="e.g. Personal"></div></div><div class="modalactions"><button type="button" class="delete hidden" id="deleteTask">Delete task</button><div class="formright"><button type="button" class="cancel" id="cancel">Cancel</button><button class="primary" type="submit">Save task</button></div></div></form></section></div>
+<script>
+(()=>{'use strict';const KEY='daymark-board-v1',columns=[['todo','To do'],['doing','In progress'],['done','Done']];let tasks=[],editing=null,filter='all',query='',dragId=null,undoState=null,noticeTimer;
+const $=s=>document.querySelector(s), board=$('#board'), esc=s=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+function seed(){let d=new Date(),fmt=n=>new Date(d.getFullYear(),d.getMonth(),d.getDate()+n).toISOString().slice(0,10);return [{id:id(),title:'Plan the week ahead',description:'Make space for the important things, not just the urgent ones.',status:'todo',priority:'high',due:fmt(1),tag:'Planning',created:Date.now()-4000000},{id:id(),title:'Get outside for a walk',description:'A reset between focus blocks.',status:'todo',priority:'normal',due:'',tag:'Wellbeing',created:Date.now()-3000000},{id:id(),title:'Read 20 pages',description:'Pick up where I left off.',status:'doing',priority:'low',due:'',tag:'Personal',created:Date.now()-2000000},{id:id(),title:'Set up my board',description:'A calm place to keep track of what matters.',status:'done',priority:'normal',due:'',tag:'',created:Date.now()-1000000}]}
+function id(){return Math.random().toString(36).slice(2,10)}function load(){try{let x=JSON.parse(localStorage.getItem(KEY));tasks=Array.isArray(x)?x:seed()}catch{tasks=seed()}if(!localStorage.getItem(KEY))save()}function save(){localStorage.setItem(KEY,JSON.stringify(tasks))}function dateText(x){if(!x)return '';let dt=new Date(x+'T00:00:00'),now=new Date();now.setHours(0,0,0,0);let delta=Math.round((dt-now)/86400000);if(delta===0)return 'Today';if(delta===1)return 'Tomorrow';return dt.toLocaleDateString(undefined,{month:'short',day:'numeric'})}function isLate(t){return t.due&&t.status!=='done'&&new Date(t.due+'T00:00:00')<new Date(new Date().setHours(0,0,0,0))}
+function visible(t){let q=query.toLowerCase();return (!q||`${t.title} ${t.description} ${t.tag}`.toLowerCase().includes(q))&&(filter==='all'||filter==='active'&&t.status!=='done'||filter==='overdue'&&isLate(t))}
+function render(){board.innerHTML=columns.map(([key,name])=>{let list=tasks.filter(t=>t.status===key&&visible(t));return `<section class="column" data-status="${key}"><div class="colhead"><div class="colname"><i class="dot"></i>${name}<span class="count">${list.length}</span></div><button class="add-small" data-add="${key}" aria-label="Add task to ${name}">＋</button></div><div class="cards" data-list="${key}">${list.length?list.map(card).join(''):'<div class="empty">Nothing here for now</div>'}</div></section>`}).join('');board.querySelectorAll('.card').forEach(c=>{c.addEventListener('dragstart',e=>{dragId=c.dataset.id;c.classList.add('dragging');e.dataTransfer.effectAllowed='move'});c.addEventListener('dragend',()=>{c.classList.remove('dragging');document.querySelectorAll('.column').forEach(x=>x.classList.remove('over'))});c.addEventListener('click',e=>{if(!e.target.closest('.menu'))openEdit(c.dataset.id)})});board.querySelectorAll('.column').forEach(c=>{c.addEventListener('dragover',e=>{e.preventDefault();c.classList.add('over')});c.addEventListener('dragleave',e=>{if(!c.contains(e.relatedTarget))c.classList.remove('over')});c.addEventListener('drop',e=>{e.preventDefault();let t=tasks.find(x=>x.id===dragId);if(t){t.status=c.dataset.status;save();render()}c.classList.remove('over')})});board.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>openNew(b.dataset.add))}
+function card(t){let tag=t.tag?`<div class="tags"><span class="tag ${t.tag.toLowerCase().includes('work')?'blue':t.tag.toLowerCase().includes('well')?'green':t.tag.toLowerCase().includes('personal')?'pink':''}">${esc(t.tag)}</span></div>`:'';return `<article class="card" draggable="true" data-id="${esc(t.id)}" tabindex="0" aria-label="${esc(t.title)}"><div class="cardtop"><h3>${esc(t.title)}</h3><button class="menu" aria-label="Edit task">···</button></div>${t.description?`<p class="desc">${esc(t.description)}</p>`:''}${tag}<div class="cardfoot"><span class="due ${isLate(t)?'late':''}">${t.due?'◷ '+dateText(t.due):t.priority==='high'?'<span class="priority">↑ High priority</span>':''}</span>${t.priority==='high'&&t.due?'<span class="priority">↑ High</span>':''}</div></article>`}
+function openNew(status='todo'){editing=null;$('#taskForm').reset();$('#status').value=status;$('#modalTitle').textContent='New task';$('#deleteTask').classList.add('hidden');showModal()}function openEdit(id){let t=tasks.find(x=>x.id===id);if(!t)return;editing=id;$('#title').value=t.title;$('#description').value=t.description||'';$('#status').value=t.status;$('#priority').value=t.priority||'normal';$('#due').value=t.due||'';$('#tag').value=t.tag||'';$('#modalTitle').textContent='Edit task';$('#deleteTask').classList.remove('hidden');showModal()}function showModal(){$('#modalback').classList.add('open');setTimeout(()=>$('#title').focus(),20)}function hideModal(){$('#modalback').classList.remove('open')}
+$('#taskForm').onsubmit=e=>{e.preventDefault();let data={title:$('#title').value.trim(),description:$('#description').value.trim(),status:$('#status').value,priority:$('#priority').value,due:$('#due').value,tag:$('#tag').value.trim()};if(!data.title)return;if(editing){Object.assign(tasks.find(t=>t.id===editing),data)}else tasks.unshift({...data,id:id(),created:Date.now()});save();render();hideModal()};$('#deleteTask').onclick=()=>{if(!editing)return;tasks=tasks.filter(t=>t.id!==editing);save();render();hideModal()};$('#newTask').onclick=()=>openNew();$('#closeModal').onclick=$('#cancel').onclick=hideModal;$('#modalback').onclick=e=>{if(e.target===$('#modalback'))hideModal()};document.onkeydown=e=>{if(e.key==='Escape')hideModal()};$('#search').oninput=e=>{query=e.target.value;render()};document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===b));render()});
+function toast(text,undo){$('#noticeText').textContent=text;undoState=undo;$('#undo').classList.toggle('hidden',!undo);$('#notice').classList.add('show');clearTimeout(noticeTimer);noticeTimer=setTimeout(()=>$('#notice').classList.remove('show'),4000)}$('#clearDone').onclick=()=>{let done=tasks.filter(t=>t.status==='done');if(!done.length){toast('No completed tasks to clear');return}tasks=tasks.filter(t=>t.status!=='done');save();render();toast(`${done.length} completed task${done.length===1?'':'s'} cleared`,()=>{tasks.push(...done);save();render()})};$('#undo').onclick=()=>{if(undoState){undoState();undoState=null;$('#notice').classList.remove('show')}};
+$('#today').textContent=new Date().toLocaleDateString(undefined,{weekday:'short',month:'long',day:'numeric'});load();render();
+})();
+</script></body></html>
