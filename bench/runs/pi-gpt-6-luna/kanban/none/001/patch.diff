+(() => {
+'use strict';
+const KEY='daymark-board-v1';
+const statuses=[['todo','To do'],['doing','In progress'],['done','Done']];
+const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
+const today=()=>new Date().toISOString().slice(0,10);
+const uid=()=>`${Date.now().toString(36)}-${Math.random().toString(36).slice(2,8)}`;
+const initial=[
+ {id:uid(),title:'Plan the week ahead',description:'Pick three things that would make this week feel like a win.',status:'todo',priority:'high',due:today(),tags:['planning'],created:Date.now()-5000},
+ {id:uid(),title:'Take a proper lunch break',description:'Step away from the desk. A short walk counts.',status:'todo',priority:'low',due:'',tags:['personal'],created:Date.now()-4000},
+ {id:uid(),title:'Send project update',description:'Share the latest progress and next steps.',status:'doing',priority:'medium',due:'',tags:['work'],created:Date.now()-3000},
+ {id:uid(),title:'Clear the kitchen counter',description:'',status:'done',priority:'none',due:'',tags:['home'],created:Date.now()-2000}
+];
+let tasks,filter='all',view='board',editing=null,query='',sort='manual',toastTimer;
+try{const saved=JSON.parse(localStorage.getItem(KEY));tasks=Array.isArray(saved)?saved:initial}catch{tasks=initial}
+const persist=()=>{localStorage.setItem(KEY,JSON.stringify(tasks));$('#openCount').textContent=tasks.filter(t=>t.status!=='done').length};
+const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+function toast(msg){const el=$('#toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2300)}
+function dateLabel(d){if(!d)return '';const dt=new Date(d+'T00:00:00'),t=today();return dt.toLocaleDateString(undefined,{month:'short',day:'numeric'})}
+function visible(t){if(view==='today'&&t.due!==today()&&t.status==='done')return false;if(view==='today'&&t.due!==today())return false;if(view==='upcoming'&&(!t.due||t.due<=today()||t.status==='done'))return false;if(view==='completed'&&t.status!=='done')return false;if(view!=='completed'&&view!=='board'&&t.status==='done')return false;if(filter==='high'&&t.priority!=='high')return false;if(filter==='overdue'&&(!t.due||t.due>=today()||t.status==='done'))return false;return !query||`${t.title} ${t.description} ${(t.tags||[]).join(' ')}`.toLowerCase().includes(query)}
+function render(){persist();const labels={board:['My board','A clear mind starts with a clear plan.'],today:['Today','One thing at a time. You’ve got this.'],upcoming:['Upcoming','A little look at what’s ahead.'],completed:['Completed','Look at everything you’ve made happen.']};$('#crumb').textContent=labels[view][0];$('#heading').innerHTML=`${labels[view][0]}<span class="heading-dot">.</span>`;$('#subtitle').textContent=labels[view][1];$('#dateLine').textContent=new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'}).toUpperCase();$('#board').innerHTML=statuses.map(([status,name])=>{let arr=tasks.filter(t=>t.status===status&&visible(t));if(sort!=='manual')arr.sort((a,b)=>sort==='due'?(a.due||'9999').localeCompare(b.due||'9999'):sort==='priority'?({high:0,medium:1,low:2,none:3}[a.priority]??3)-({high:0,medium:1,low:2,none:3}[b.priority]??3):sort==='created'?b.created-a.created:0);return `<section class="column" data-status="${status}"><header class="column-head"><i class="column-indicator"></i><h2>${name}</h2><span class="column-count">${arr.length}</span><button class="column-add" data-add="${status}" title="Add to ${name}" aria-label="Add task to ${name}">＋</button></header><div class="task-list" data-drop="${status}">${arr.length?arr.map(card).join(''):`<div class="empty-column">${query?'No matching tasks':'Nothing here just yet'}</div>`}</div></section>`}).join('');$$('.filter-pill').forEach(b=>b.classList.toggle('selected',b.dataset.filter===filter));}
+function card(t){let dueClass=t.due&&t.due<today()&&t.status!=='done'?'overdue':t.due===today()?'today':'';return `<article class="task-card ${t.status==='done'?'is-done':''}" draggable="true" data-id="${esc(t.id)}"><div class="task-topline"><input type="checkbox" class="task-check" aria-label="Mark ${esc(t.title)} ${t.status==='done'?'incomplete':'complete'}" ${t.status==='done'?'checked':''}><span class="task-title" tabindex="0">${esc(t.title)}</span><button class="card-menu" aria-label="Edit task">···</button></div>${t.description?`<p class="task-description">${esc(t.description)}</p>`:''}<div class="card-bottom"><span class="priority ${esc(t.priority)}">${t.priority==='none'?'':esc(t.priority[0].toUpperCase()+t.priority.slice(1))}</span>${t.due?`<span class="due ${dueClass}">◷ ${dateLabel(t.due)}</span>`:''}${(t.tags||[]).slice(0,3).map(x=>`<span class="tag">${esc(x)}</span>`).join('')}</div></article>`}
+function openModal(task=null,status='todo'){editing=task?.id||null;$('#modalTitle').textContent=task?'Edit task':'Add a task';$('#taskTitle').value=task?.title||'';$('#taskDescription').value=task?.description||'';$('#taskStatus').value=task?.status||status;$('#taskPriority').value=task?.priority||'none';$('#taskDue').value=task?.due||'';$('#taskTags').value=(task?.tags||[]).join(', ');$('#deleteTask').hidden=!task;$('#modalBackdrop').hidden=false;setTimeout(()=>$('#taskTitle').focus(),40)}function closeModal(){$('#modalBackdrop').hidden=true;editing=null}
+$('#taskForm').addEventListener('submit',e=>{e.preventDefault();let old=tasks.find(t=>t.id===editing);const item={id:editing||uid(),title:$('#taskTitle').value.trim(),description:$('#taskDescription').value.trim(),status:$('#taskStatus').value,priority:$('#taskPriority').value,due:$('#taskDue').value,tags:$('#taskTags').value.split(',').map(x=>x.trim()).filter(Boolean).slice(0,8),created:old?.created||Date.now()};if(old)tasks=tasks.map(t=>t.id===editing?item:t);else tasks.push(item);closeModal();render();toast(old?'Task updated':'Task added')});
+$('#board').addEventListener('click',e=>{const add=e.target.closest('[data-add]');if(add)return openModal(null,add.dataset.add);const article=e.target.closest('.task-card');if(!article)return;const task=tasks.find(t=>t.id===article.dataset.id);if(e.target.matches('.task-check')){task.status=e.target.checked?'done':'todo';render();return}if(e.target.closest('.card-menu')||e.target.matches('.task-title'))openModal(task)});
+$('#board').addEventListener('keydown',e=>{if(e.key==='Enter'&&e.target.matches('.task-title'))openModal(tasks.find(t=>t.id===e.target.closest('.task-card').dataset.id))});
+$('#board').addEventListener('dragstart',e=>{const c=e.target.closest('.task-card');if(!c)return;e.dataTransfer.setData('text/plain',c.dataset.id);e.dataTransfer.effectAllowed='move';c.classList.add('dragging')});$('#board').addEventListener('dragend',e=>e.target.closest('.task-card')?.classList.remove('dragging'));$('#board').addEventListener('dragover',e=>{const l=e.target.closest('.task-list');if(l){e.preventDefault();l.classList.add('drag-over')}});$('#board').addEventListener('dragleave',e=>{if(e.target.matches('.task-list'))e.target.classList.remove('drag-over')});$('#board').addEventListener('drop',e=>{const l=e.target.closest('.task-list');if(!l)return;e.preventDefault();l.classList.remove('drag-over');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=l.dataset.drop;render()}});
+$$('.nav-item').forEach(b=>b.addEventListener('click',()=>{view=b.dataset.view;$$('.nav-item').forEach(x=>x.classList.toggle('active',x===b));render()}));$$('.filter-pill').forEach(b=>b.addEventListener('click',()=>{filter=b.dataset.filter;render()}));$('#search').addEventListener('input',e=>{query=e.target.value.trim().toLowerCase();render()});$('#sort').addEventListener('change',e=>{sort=e.target.value;render()});$('#addTask').addEventListener('click',()=>openModal());$('#closeModal').addEventListener('click',closeModal);$('#cancelModal').addEventListener('click',closeModal);$('#modalBackdrop').addEventListener('click',e=>{if(e.target===$('#modalBackdrop'))closeModal()});document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal();if(e.key==='/'&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();$('#search').focus()}});$('#deleteTask').addEventListener('click',()=>{if(!editing)return;tasks=tasks.filter(t=>t.id!==editing);closeModal();render();toast('Task deleted')});$('#clearCompleted').addEventListener('click',()=>{const n=tasks.filter(t=>t.status==='done').length;if(n&&confirm(`Delete ${n} completed ${n===1?'task':'tasks'}?`)){tasks=tasks.filter(t=>t.status!=='done');render();toast('Completed tasks cleared')}});
+$('#exportBtn').addEventListener('click',()=>{const blob=new Blob([JSON.stringify({format:'daymark',version:1,tasks},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`daymark-${today()}.json`;a.click();URL.revokeObjectURL(a.href);toast('Board exported')});$('#importFile').addEventListener('change',async e=>{const f=e.target.files[0];if(!f)return;try{const data=JSON.parse(await f.text()),list=Array.isArray(data)?data:data.tasks;if(!Array.isArray(list)||list.some(t=>!t.title||!['todo','doing','done'].includes(t.status)))throw Error();if(confirm(`Replace your board with ${list.length} imported tasks?`)){tasks=list.map(t=>({id:String(t.id||uid()),title:String(t.title).slice(0,140),description:String(t.description||'').slice(0,1000),status:t.status,priority:['high','medium','low','none'].includes(t.priority)?t.priority:'none',due:/^\d{4}-\d\d-\d\d$/.test(t.due)?t.due:'',tags:Array.isArray(t.tags)?t.tags.map(String).slice(0,8):[],created:Number(t.created)||Date.now()}));render();toast('Board imported')}}catch{toast('That file doesn’t look like a Daymark board')}e.target.value=''});
+$('#settingsBtn').addEventListener('click',()=>toast('Your board is saved privately on this device'));if(!localStorage.getItem(KEY)){tasks=initial;persist()}render();
+})();
