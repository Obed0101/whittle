diff --git a/board/app.js b/board/app.js
new file mode 100644
index 0000000..9310ef0
--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,35 @@
+(() => {
+  const KEY='daymark-board-v1';
+  const columns=[{id:'todo',name:'To do',cls:'todo'},{id:'doing',name:'In progress',cls:'doing'},{id:'done',name:'Done',cls:'done'}];
+  const starter=[
+    {id:'a1',title:'Plan the week ahead',notes:'Pick three things that would make this week feel like a win.',priority:'high',due:dayOffset(0),column:'todo'},
+    {id:'a2',title:'Book a dentist appointment',notes:'Find a slot that works before the end of the month.',priority:'medium',due:dayOffset(3),column:'todo'},
+    {id:'a3',title:'Review monthly budget',notes:'Check subscriptions and update the spending tracker.',priority:'low',due:'',column:'todo'},
+    {id:'b1',title:'Finish reading project brief',notes:'Capture open questions for the kickoff.',priority:'medium',due:dayOffset(1),column:'doing'},
+    {id:'c1',title:'Sort out the hallway cupboard',notes:'Donate anything we have not used this year.',priority:'low',due:'',column:'done'}
+  ];
+  function dayOffset(n){const d=new Date();d.setDate(d.getDate()+n);return dateISO(d)}
+  function dateISO(d){return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
+  let tasks;try{const stored=JSON.parse(localStorage.getItem(KEY));tasks=Array.isArray(stored)?stored:starter}catch{tasks=starter}
+  let query='',priority='all',view='all',sortDue=false,editing=null,toastTimer;
+  const $=s=>document.querySelector(s), board=$('#board'), dialog=$('#taskDialog'), form=$('#taskForm');
+  function save(){localStorage.setItem(KEY,JSON.stringify(tasks));render()}
+  function escape(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+  function labelDate(value){if(!value)return '';const d=new Date(value+'T00:00:00');return d.toLocaleDateString(undefined,{month:'short',day:'numeric'})}
+  function visible(t){if(query&&!`${t.title} ${t.notes}`.toLowerCase().includes(query))return false;if(priority!=='all'&&t.priority!==priority)return false;if(view==='today'&&t.due!==dateISO(new Date()))return false;if(view==='overdue'&&(!t.due||t.due>=dateISO(new Date())||t.column==='done'))return false;return true}
+  function render(){
+    const today=dateISO(new Date());$('#totalCount').textContent=tasks.filter(t=>t.column!=='done').length;$('#todayCount').textContent=tasks.filter(t=>t.due===today&&t.column!=='done').length;$('#overdueCount').textContent=tasks.filter(t=>t.due&&t.due<today&&t.column!=='done').length;
+    board.innerHTML=columns.map(col=>{let items=tasks.filter(t=>t.column===col.id&&visible(t));if(sortDue)items.sort((a,b)=>(a.due||'9999').localeCompare(b.due||'9999'));return `<section class="column ${col.cls}" data-column="${col.id}"><header class="column-head"><span class="column-dot"></span><span class="column-title">${col.name}</span><span class="column-count">${items.length}</span><button class="column-add" data-add="${col.id}" aria-label="Add to ${col.name}" title="Add task">＋</button></header><div class="task-list">${items.length?items.map(card).join(''):`<div class="empty-state"><span>✳</span>${query?'No matching tasks':'Nothing here just yet'}</div>`}</div><button class="quick-add" data-add="${col.id}">＋ &nbsp; Add a task</button></section>`}).join('');
+    board.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>openTask(null,b.dataset.add));board.querySelectorAll('.task-card').forEach(el=>{el.onclick=()=>openTask(el.dataset.id);el.ondragstart=e=>{e.dataTransfer.setData('text/plain',el.dataset.id);e.dataTransfer.effectAllowed='move';setTimeout(()=>el.classList.add('dragging'),0)};el.ondragend=()=>el.classList.remove('dragging')});board.querySelectorAll('.column').forEach(el=>{el.ondragover=e=>{e.preventDefault();el.classList.add('drag-over')};el.ondragleave=e=>{if(!el.contains(e.relatedTarget))el.classList.remove('drag-over')};el.ondrop=e=>{e.preventDefault();el.classList.remove('drag-over');const task=tasks.find(t=>t.id===e.dataTransfer.getData('text/plain'));if(task&&task.column!==el.dataset.column){task.column=el.dataset.column;save();notify('Task moved')}}});
+  }
+  function card(t){const today=dateISO(new Date()),late=t.due&&t.due<today&&t.column!=='done',soon=t.due===today&&t.column!=='done';return `<article class="task-card" draggable="true" data-id="${escape(t.id)}" tabindex="0" role="button" aria-label="Edit ${escape(t.title)}"><div class="card-top"><span class="priority priority-${escape(t.priority)}">${escape(t.priority)}</span><button class="card-menu" tabindex="-1" aria-hidden="true">···</button></div><h3 class="card-title">${escape(t.title)}</h3>${t.notes?`<p class="card-notes">${escape(t.notes)}</p>`:''}<div class="card-bottom"><span class="due ${late?'late':soon?'soon':''}">${t.due?`${late?'Overdue · ':''}${labelDate(t.due)}`:''}</span></div></article>`}
+  function openTask(id,column='todo'){editing=id;const task=tasks.find(t=>t.id===id);$('#dialogTitle').textContent=task?'Edit task':'New task';$('#taskTitle').value=task?.title||'';$('#taskNotes').value=task?.notes||'';$('#taskPriority').value=task?.priority||'medium';$('#taskDue').value=task?.due||'';$('#taskColumn').value=task?.column||column;$('#deleteTask').style.display=task?'block':'none';dialog.showModal();setTimeout(()=>$('#taskTitle').focus(),40)}
+  // Replace edited record in place without changing its order.
+  form.onsubmit=e=>{e.preventDefault();const item={id:editing||`t${Date.now()}${Math.random().toString(36).slice(2,6)}`,title:$('#taskTitle').value.trim(),notes:$('#taskNotes').value.trim(),priority:$('#taskPriority').value,due:$('#taskDue').value,column:$('#taskColumn').value};if(!item.title)return;if(editing){tasks[tasks.findIndex(t=>t.id===editing)]=item;notify('Task updated')}else{tasks.unshift(item);notify('Task added to your board')}dialog.close();save()};
+  $('#deleteTask').onclick=()=>{if(!editing)return;tasks=tasks.filter(t=>t.id!==editing);dialog.close();save();notify('Task deleted')};$('#closeDialog').onclick=$('#cancelDialog').onclick=()=>dialog.close();dialog.onclick=e=>{if(e.target===dialog)dialog.close()};$('#search').oninput=e=>{query=e.target.value.trim().toLowerCase();render()};$('#priorityFilter').onchange=e=>{priority=e.target.value;render()};$('#sortButton').onclick=()=>{sortDue=!sortDue;$('#sortButton').style.color=sortDue?'#587858':'';render()};
+  function setView(v){view=v;document.querySelectorAll('.nav-item').forEach(x=>x.classList.remove('active'));({all:'#boardNav',today:'#todayNav',overdue:'#overdueNav'}[v]&&$(({all:'#boardNav',today:'#todayNav',overdue:'#overdueNav'}[v])).classList.add('active'));render()}
+  $('#boardNav').onclick=()=>setView('all');$('#todayNav').onclick=()=>setView('today');$('#overdueNav').onclick=()=>setView('overdue');$('#addTaskTop').onclick=()=>openTask(null,'todo');$('#clearDone').onclick=()=>{const count=tasks.filter(t=>t.column==='done').length;if(!count){notify('No completed tasks to clear');return}if(confirm(`Remove ${count} completed ${count===1?'task':'tasks'} from your board?`)){tasks=tasks.filter(t=>t.column!=='done');save();notify('Completed tasks cleared')}};
+  function notify(message){const el=$('#toast');el.textContent=message;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2100)}
+  document.addEventListener('keydown',e=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();$('#search').focus()}if(e.key==='Escape'&&dialog.open)dialog.close();if(!dialog.open&&e.key==='n'&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();openTask()}});
+  $('#dateLabel').textContent=new Date().toLocaleDateString(undefined,{weekday:'short',month:'short',day:'numeric'});render();
+})();
diff --git a/board/index.html b/board/index.html
new file mode 100644
index 0000000..fa393e9
--- /dev/null
+++ b/board/index.html
@@ -0,0 +1,34 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width,initial-scale=1">
+  <meta name="theme-color" content="#f6f5f1">
+  <title>Daymark — Personal board</title>
+  <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+  <div class="app-shell">
+    <aside class="sidebar">
+      <a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d</span><span>daymark</span></a>
+      <div class="workspace-label">YOUR WORKSPACE</div>
+      <button class="nav-item active" id="boardNav"><span class="nav-icon">▦</span> My board <span class="nav-count" id="totalCount">0</span></button>
+      <button class="nav-item" id="todayNav"><span class="nav-icon">◷</span> Due today <span class="nav-count" id="todayCount">0</span></button>
+      <button class="nav-item" id="overdueNav"><span class="nav-icon">!</span> Overdue <span class="nav-count" id="overdueCount">0</span></button>
+      <div class="sidebar-bottom"><div class="tip-icon">✳</div><strong>A little progress<br>goes a long way.</strong><p>Keep your focus on what matters today.</p><button id="clearDone">Clear completed <span>→</span></button><div class="storage-note"><span class="online-dot"></span> Saved on this device</div></div>
+    </aside>
+    <main class="main">
+      <header class="topbar"><div class="breadcrumb">Personal space <span>/</span> <b>My board</b></div><div class="top-actions"><span class="date-label" id="dateLabel"></span><button class="avatar" title="Your personal board">J</button></div></header>
+      <section class="content">
+        <div class="welcome-row"><div><div class="eyebrow">YOUR SPACE, YOUR PACE</div><h1>My board<span class="title-spark">✳</span></h1><p class="subtitle">Make room for the work that matters.</p></div><button class="primary-button" id="addTaskTop"><span>＋</span> Add a task</button></div>
+        <div class="toolbar"><div class="search-wrap"><span class="search-icon">⌕</span><input id="search" type="search" placeholder="Search tasks…" aria-label="Search tasks"><kbd>⌘ K</kbd></div><div class="toolbar-right"><label class="filter-label" for="priorityFilter">Priority</label><select id="priorityFilter"><option value="all">All priorities</option><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select><button class="icon-button" id="sortButton" title="Sort by due date" aria-label="Sort by due date">↕</button></div></div>
+        <div class="board" id="board" aria-label="Kanban board"></div>
+        <footer class="board-footer"><span><span class="key-hint">↵</span> Quick add in any column</span><span>Changes save automatically</span></footer>
+      </section>
+    </main>
+  </div>
+  <dialog id="taskDialog"><form id="taskForm"><div class="modal-head"><div><div class="eyebrow">MAKE IT HAPPEN</div><h2 id="dialogTitle">New task</h2></div><button class="close-button" type="button" id="closeDialog" aria-label="Close">×</button></div><label class="field-label" for="taskTitle">Task name <span>*</span></label><input class="text-field" id="taskTitle" maxlength="120" placeholder="What needs doing?" required><label class="field-label" for="taskNotes">Notes <small>optional</small></label><textarea class="text-field notes-field" id="taskNotes" maxlength="500" placeholder="Add a little context…"></textarea><div class="form-row"><div><label class="field-label" for="taskPriority">Priority</label><select class="text-field" id="taskPriority"><option value="low">Low</option><option value="medium" selected>Medium</option><option value="high">High</option></select></div><div><label class="field-label" for="taskDue">Due date <small>optional</small></label><input class="text-field" id="taskDue" type="date"></div></div><label class="field-label" for="taskColumn">Column</label><select class="text-field" id="taskColumn"><option value="todo">To do</option><option value="doing">In progress</option><option value="done">Done</option></select><div class="modal-actions"><button type="button" class="delete-button" id="deleteTask">Delete task</button><button type="button" class="cancel-button" id="cancelDialog">Cancel</button><button class="primary-button" type="submit">Save task <span>→</span></button></div></form></dialog>
+  <div class="toast" id="toast" role="status" aria-live="polite"></div>
+  <script src="app.js"></script>
+</body>
+</html>
