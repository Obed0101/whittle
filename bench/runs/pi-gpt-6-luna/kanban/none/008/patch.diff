@@ -0,0 +1,22 @@
+(()=>{'use strict';
+const KEY='daymark-board-v1', defaultLabels=[{name:'Personal',color:'#83a88c'},{name:'Work',color:'#7797bf'},{name:'Wellbeing',color:'#d69572'}];
+const seed=[{id:'seed1',title:'Plan the week ahead',description:'Take 15 minutes to decide what would make this week feel successful.',status:'todo',priority:'medium',due:'',label:'Personal',created:Date.now()-1000},{id:'seed2',title:'Book annual check-up',description:'Call the clinic and find a time that works.',status:'todo',priority:'low',due:'',label:'Wellbeing',created:Date.now()-2000},{id:'seed3',title:'Finish reading notes',description:'Pull together the key ideas from the last chapter.',status:'doing',priority:'high',due:'',label:'Personal',created:Date.now()-3000}];
+let state;try{state=JSON.parse(localStorage.getItem(KEY))}catch{}if(!state||!Array.isArray(state.tasks))state={tasks:seed,labels:defaultLabels};state.labels=Array.isArray(state.labels)&&state.labels.length?state.labels:defaultLabels;state.tasks=state.tasks.map(t=>({...t,status:['todo','doing','done'].includes(t.status)?t.status:'todo'}));
+const $=s=>document.querySelector(s), board=$('#board'), modal=$('#modalBackdrop');let view='board',labelFilter='',query='',toastTimer;
