+function save(){localStorage.setItem(KEY,JSON.stringify(state));$('#totalCount').textContent=state.tasks.filter(t=>t.status!=='done').length}
+function dateLabel(d){if(!d)return'';let a=new Date(d+'T00:00:00'),today=new Date();today.setHours(0,0,0,0);let diff=Math.round((a-today)/86400000);return diff===0?'Today':diff===1?'Tomorrow':a.toLocaleDateString(undefined,{month:'short',day:'numeric'})}
+function render(){save();const labels=$('#labelFilters');labels.innerHTML=state.labels.map(l=>`<button class="label-filter ${labelFilter===l.name?'selected':''}" data-label="${esc(l.name)}"><i class="label-dot" style="background:${esc(l.color)}"></i>${esc(l.name)} <span class="nav-count">${state.tasks.filter(t=>t.label===l.name&&t.status!=='done').length}</span></button>`).join('');let tasks=state.tasks.filter(t=>(!labelFilter||t.label===labelFilter)&&(`${t.title} ${t.description} ${t.label}`.toLowerCase().includes(query.toLowerCase())));if(view==='today')tasks=tasks.filter(t=>t.due===new Date().toISOString().slice(0,10)&&t.status!=='done');if(view==='done')tasks=tasks.filter(t=>t.status==='done');let title=view==='today'?'Due today':view==='done'?'Completed':'My board';$('#pageTitle').innerHTML=`${title}<span class="title-dot">.</span>`;$('#crumb').textContent=title;$('#pageSubtitle').textContent=view==='today'?'The things that need your attention today.':view==='done'?'Look at everything you have already moved forward.':'A little progress adds up. Pick what matters and get moving.';$('#dateLine').textContent=new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'}).toUpperCase();let statuses=view==='board'?['todo','doing','done']:view==='done'?['done']:['todo','doing'];let names={todo:'To do',doing:'In progress',done:'Done'};board.innerHTML=statuses.map(st=>{let arr=tasks.filter(t=>t.status===st),sort=$('#sortSelect').value;if(sort==='due')arr.sort((a,b)=>(a.due||'9999').localeCompare(b.due||'9999'));if(sort==='priority'){let p={high:0,medium:1,low:2,none:3};arr.sort((a,b)=>(p[a.priority]??3)-(p[b.priority]??3))}if(sort==='created')arr.sort((a,b)=>(b.created||0)-(a.created||0));return `<section class="column" data-status="${st}"><div class="column-head"><div class="column-title"><i class="status-dot"></i>${names[st]} <span class="column-count">${arr.length}</span></div>${view==='board'?`<button class="column-add" data-add="${st}" title="Add to ${names[st]}">＋</button>`:''}</div><div class="task-list" data-drop="${st}">${arr.length?arr.map(card).join(''):`<div class="empty-column">${view==='today'?'Nothing due today. Enjoy the breathing room.':view==='done'?'Completed tasks will show up here.':'Nothing here yet — add a task to get started.'}</div>`}</div></section>`}).join('');}
+function card(t){let label=state.labels.find(l=>l.name===t.label),date=t.due?new Date(t.due+'T00:00:00'):null,now=new Date();now.setHours(0,0,0,0);let dueClass=date&&date<now&&t.status!=='done'?'overdue':date&&date.getTime()===now.getTime()?'soon':'';return `<article class="task-card" draggable="true" data-id="${esc(t.id)}"><div class="task-top"><div class="task-name"><input class="task-check" type="checkbox" ${t.status==='done'?'checked':''} aria-label="Mark ${esc(t.title)} complete"><span class="open-task">${esc(t.title)}</span></div><button class="task-menu" title="Edit task">···</button></div>${t.description?`<p class="task-desc">${esc(t.description)}</p>`:''}<div class="task-meta">${label?`<span class="label-chip" style="background:${esc(label.color)}20;color:${esc(label.color)}">${esc(label.name)}</span>`:''}${t.priority&&t.priority!=='none'?`<span class="priority ${esc(t.priority)}"><span class="priority-mark">${t.priority==='high'?'▲':t.priority==='medium'?'◆':'▼'}</span>${esc(t.priority[0].toUpperCase()+t.priority.slice(1))}</span>`:''}${t.due?`<span class="due ${dueClass}">◷ ${dateLabel(t.due)}</span>`:''}</div></article>`}
+function showToast(s){let el=$('#toast');el.textContent=s;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2300)}
+function openTask(t=null,status='todo'){ $('#taskForm').reset();$('#taskId').value=t?.id||'';$('#modalTitle').textContent=t?'Edit task':'Add a task';$('#taskTitle').value=t?.title||'';$('#taskDescription').value=t?.description||'';$('#taskStatus').value=t?.status||status;$('#taskPriority').value=t?.priority||'none';$('#taskDue').value=t?.due||'';$('#taskLabel').innerHTML='<option value="">No label</option>'+state.labels.map(l=>`<option value="${esc(l.name)}">${esc(l.name)}</option>`).join('');$('#taskLabel').value=t?.label||'';$('#deleteTask').style.visibility=t?'visible':'hidden';modal.hidden=false;setTimeout(()=>$('#taskTitle').focus(),40)}
+function close(){modal.hidden=true}document.addEventListener('click',e=>{let add=e.target.closest('#addTop,[data-add]');if(add){openTask(null,add.dataset.add||'todo');return}let cardEl=e.target.closest('.task-card');if(cardEl){let t=state.tasks.find(x=>x.id===cardEl.dataset.id);if(e.target.matches('.task-check')){t.status=e.target.checked?'done':'todo';save();render();return}if(e.target.closest('.task-menu')||e.target.closest('.open-task'))openTask(t);return}if(e.target.matches('.close-modal'))close();let lf=e.target.closest('[data-label]');if(lf){labelFilter=labelFilter===lf.dataset.label?'':lf.dataset.label;render()}if(e.target.closest('#boardNav'))setView('board');if(e.target.closest('#todayNav'))setView('today');if(e.target.closest('#doneNav'))setView('done');if(e.target.closest('#clearFilters')){labelFilter='';$('#search').value='';query='';$('#sortSelect').value='manual';render()}if(e.target.closest('#labelManage'))manageLabels();if(e.target.closest('#exportBtn'))exportData();if(e.target.closest('#importBtn'))$('#importFile').click();if(e.target.closest('#helpBtn'))showToast('Tip: press N to add a task, / to search, Esc to close.');if(e.target.closest('#settingsBtn'))showToast('Your tasks are saved privately in this browser.');});
+function setView(v){view=v;document.querySelectorAll('.nav-item').forEach(x=>x.classList.remove('active'));$({'board':'#boardNav','today':'#todayNav','done':'#doneNav'}[v]).classList.add('active');render()}
+$('#taskForm').addEventListener('submit',e=>{e.preventDefault();let id=$('#taskId').value,t=state.tasks.find(x=>x.id===id),obj={title:$('#taskTitle').value.trim(),description:$('#taskDescription').value.trim(),status:$('#taskStatus').value,priority:$('#taskPriority').value,due:$('#taskDue').value,label:$('#taskLabel').value};if(!obj.title)return;if(t)Object.assign(t,obj);else state.tasks.unshift({...obj,id:crypto.randomUUID?crypto.randomUUID():String(Date.now()),created:Date.now()});close();render();showToast(t?'Task updated':'Task added')});$('#deleteTask').onclick=()=>{let id=$('#taskId').value;state.tasks=state.tasks.filter(t=>t.id!==id);close();render();showToast('Task deleted')};$('#search').oninput=e=>{query=e.target.value;render()};$('#sortSelect').onchange=render;$('#modalBackdrop').addEventListener('click',e=>{if(e.target===modal)close()});
+board.addEventListener('dragstart',e=>{let c=e.target.closest('.task-card');if(c){e.dataTransfer.setData('text/plain',c.dataset.id);e.dataTransfer.effectAllowed='move';setTimeout(()=>c.classList.add('dragging'),0)}});board.addEventListener('dragend',e=>e.target.closest('.task-card')?.classList.remove('dragging'));board.addEventListener('dragover',e=>{let list=e.target.closest('.task-list');if(list){e.preventDefault();list.classList.add('drag-over')}});board.addEventListener('dragleave',e=>{if(e.target.matches('.task-list'))e.target.classList.remove('drag-over')});board.addEventListener('drop',e=>{let list=e.target.closest('.task-list');if(!list)return;e.preventDefault();list.classList.remove('drag-over');let t=state.tasks.find(t=>t.id===e.dataTransfer.getData('text/plain'));if(t){t.status=list.dataset.drop;render()}});
+function manageLabels(){let old=state.labels.map(x=>x.name).join(', '),val=prompt('Manage labels (comma-separated names):',old);if(val===null)return;let names=[...new Set(val.split(',').map(x=>x.trim()).filter(Boolean))].slice(0,10),palette=['#83a88c','#7797bf','#d69572','#a17db1','#d2a14b','#62a6a1'];let prev=state.labels;state.labels=names.map((name,i)=>prev.find(l=>l.name===name)||{name,color:palette[i%palette.length]});state.tasks.forEach(t=>{if(t.label&&!names.includes(t.label))t.label=''});render()}
+function exportData(){let blob=new Blob([JSON.stringify({version:1,...state},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='daymark-board.json';a.click();URL.revokeObjectURL(a.href);showToast('Board exported')}
+$('#importFile').onchange=async e=>{let f=e.target.files[0];if(!f)return;try{let d=JSON.parse(await f.text());if(!Array.isArray(d.tasks)||!Array.isArray(d.labels))throw Error();if(!confirm('Replace your current board with this import?'))return;state={tasks:d.tasks,labels:d.labels};save();render();showToast('Board imported')}catch{showToast('Could not read that board file')}e.target.value=''};
