+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f6f7f5">
+<title>Daymark — Personal board</title>
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<div class="app-shell">
+<aside class="sidebar">
+  <a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d</span><span>daymark</span></a>
+  <div class="workspace-label">YOUR WORKSPACE</div>
+  <button class="nav-item active" id="boardNav"><span class="nav-icon">▦</span> My board <span class="nav-count" id="totalCount">0</span></button>
+  <button class="nav-item" id="todayNav"><span class="nav-icon">◷</span> Due today</button>
+  <button class="nav-item" id="doneNav"><span class="nav-icon">✓</span> Completed</button>
+  <div class="side-divider"></div>
+  <div class="workspace-label">LABELS <button id="labelManage" class="tiny-plus" title="Manage labels">＋</button></div>
+  <div id="labelFilters" class="label-filters"></div>
+  <div class="sidebar-bottom"><div class="avatar">M</div><div><strong>My space</strong><small>Personal workspace</small></div><button id="settingsBtn" class="icon-btn" title="Settings">···</button></div>
+</aside>
+<main class="main">
+  <header class="topbar"><div class="breadcrumbs">My workspace <span>/</span> <strong id="crumb">My board</strong></div><div class="top-actions"><span class="save-state"><i></i> Saved locally</span><button class="icon-btn" id="helpBtn" title="Keyboard shortcuts">⌘</button><button class="add-button" id="addTop"><span>＋</span> Add task <kbd>N</kbd></button></div></header>
+  <section class="page-head"><div><div class="eyebrow" id="dateLine">YOUR DAY, AT A GLANCE</div><h1 id="pageTitle">My board<span class="title-dot">.</span></h1><p id="pageSubtitle">A little progress adds up. Pick what matters and get moving.</p></div><div class="head-actions"><button class="secondary-btn" id="exportBtn">↗ <span>Export</span></button><button class="secondary-btn" id="importBtn">↙ <span>Import</span></button><input id="importFile" type="file" accept="application/json" hidden></div></section>
+  <section class="toolbar"><div class="search-wrap"><span>⌕</span><input id="search" type="search" placeholder="Find a task..." aria-label="Search tasks"><kbd>/</kbd></div><div class="toolbar-right"><div class="filter-select"><span>↕</span><select id="sortSelect" aria-label="Sort tasks"><option value="manual">Board order</option><option value="due">Due date</option><option value="priority">Priority</option><option value="created">Recently added</option></select></div><button class="secondary-btn compact" id="clearFilters" title="Clear filters">↺</button></div></section>
+  <section class="board" id="board" aria-label="Kanban board"></section>
+  <footer class="board-footer"><span>Drag tasks to move them between columns</span><span><kbd>N</kbd> new task <span class="foot-sep">·</span> <kbd>/</kbd> search</span></footer>
+</main>
+</div>
+<div class="modal-backdrop" id="modalBackdrop" hidden><section class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle"><div class="modal-header"><div><div class="eyebrow">TASK DETAILS</div><h2 id="modalTitle">Add a task</h2></div><button class="icon-btn close-modal" aria-label="Close">×</button></div><form id="taskForm"><input type="hidden" id="taskId"><label class="field-label" for="taskTitle">Task name <span>*</span></label><input id="taskTitle" class="text-input title-input" required maxlength="120" placeholder="What needs to get done?">
+<label class="field-label" for="taskDescription">Notes <small>Optional</small></label><textarea id="taskDescription" class="text-input" rows="3" maxlength="1000" placeholder="Add a little context..."></textarea>
+<div class="field-grid"><div><label class="field-label" for="taskStatus">Status</label><select id="taskStatus" class="text-input"><option value="todo">To do</option><option value="doing">In progress</option><option value="done">Done</option></select></div><div><label class="field-label" for="taskPriority">Priority</label><select id="taskPriority" class="text-input"><option value="none">No priority</option><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option></select></div></div>
+<div class="field-grid"><div><label class="field-label" for="taskDue">Due date</label><input id="taskDue" type="date" class="text-input"></div><div><label class="field-label" for="taskLabel">Label</label><select id="taskLabel" class="text-input"></select></div></div>
+<div class="modal-footer"><button type="button" id="deleteTask" class="danger-link">Delete task</button><div><button type="button" class="secondary-btn close-modal">Cancel</button><button class="add-button" type="submit">Save task</button></div></div></form></section></div>
+<div class="toast" id="toast" role="status"></div>
+<script src="app.js"></script>
+</body></html>
