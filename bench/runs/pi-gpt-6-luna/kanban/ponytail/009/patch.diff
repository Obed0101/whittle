--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,23 @@
+(() => {
+const KEY='daymark-board-v1', columns=[['todo','To do'],['doing','In progress'],['done','Done']];
+const initial=[{title:'Plan the week ahead',status:'todo',priority:'medium',tag:'Personal',due:dateOffset(1),description:'Pick the three things that would make this week feel like a win.'},{title:'Book a table for Friday',status:'todo',priority:'low',tag:'Life admin',due:'',description:''},{title:'Send project update',status:'doing',priority:'high',tag:'Work',due:dateOffset(0),description:'Share the latest milestones and flag the open question.'},{title:'Sort out the hallway',status:'doing',priority:'low',tag:'Home',due:'',description:''},{title:'Set up this board',status:'done',priority:'low',tag:'Personal',due:'',description:'You’re all set. Add a task and make it yours.'}].map(t=>({...t,id:crypto.randomUUID(),created:Date.now()}));
+function dateOffset(n){const d=new Date();d.setDate(d.getDate()+n);return d.toISOString().slice(0,10)}
+let tasks;try{const saved=JSON.parse(localStorage.getItem(KEY));tasks=Array.isArray(saved)?saved:initial}catch{tasks=initial}
+const $=s=>document.querySelector(s), board=$('#board'), modal=$('#modal'), form=$('#taskForm');let filter='all', query='', toastTimer;
+function persist(){localStorage.setItem(KEY,JSON.stringify(tasks));$('.saved').innerHTML='<i></i> Saved on this device'}
+function escape(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+function dateLabel(value){if(!value)return '';const d=new Date(value+'T00:00:00'),today=new Date();today.setHours(0,0,0,0);const diff=Math.round((d-today)/86400000);return diff<0?`${Math.abs(diff)}d overdue`:diff===0?'Today':diff===1?'Tomorrow':d.toLocaleDateString(undefined,{month:'short',day:'numeric'})}
+function visible(t){if(query&&!`${t.title} ${t.description} ${t.tag}`.toLowerCase().includes(query))return false;const today=dateOffset(0);return filter==='today'?t.due===today&&t.status!=='done':filter==='overdue'?!!t.due&&t.due<today&&t.status!=='done':true}
+function render(){const today=dateOffset(0),active=tasks.filter(t=>t.status!=='done');$('#allCount').textContent=active.length;$('#todayCount').textContent=active.filter(t=>t.due===today).length;$('#overdueCount').textContent=active.filter(t=>t.due&&t.due<today).length;board.innerHTML=columns.map(([status,label])=>{const list=tasks.filter(t=>t.status===status&&visible(t));return `<section class="column" data-status="${status}"><div class="column-head"><div class="column-title"><i class="col-dot"></i>${label}<span class="count">${list.length}</span></div><button class="add-small" data-add="${status}" aria-label="Add task to ${label}">＋</button></div><div class="cards" data-drop="${status}">${list.length?list.map(cardHTML).join(''):`<div class="empty">${filter==='all'&&!query?'A little space to think.':'No tasks here.'}<button data-add="${status}">＋ Add a task</button></div>`}</div></section>`}).join('')}
+function cardHTML(t){const overdue=t.due&&t.due<dateOffset(0)&&t.status!=='done',soon=t.due===dateOffset(0)||t.due===dateOffset(1);return `<article class="card ${t.status==='done'?'done-card':''}" draggable="true" data-id="${escape(t.id)}"><div class="card-top">${t.tag?`<span class="tag">${escape(t.tag)}</span>`:'<span></span>'}<span class="priority ${escape(t.priority)}">${escape(t.priority)} priority</span></div><h3>${escape(t.title)}</h3>${t.description?`<p class="card-description">${escape(t.description)}</p>`:''}<div class="card-bottom"><span class="due ${overdue?'late':soon?'soon':''}">${t.due?`◷ ${dateLabel(t.due)}`:'Added '+new Date(t.created||Date.now()).toLocaleDateString(undefined,{month:'short',day:'numeric'})}</span><button class="edit-card" data-edit="${escape(t.id)}" aria-label="Edit ${escape(t.title)}">···</button></div></article>`}
+function openTask(task=null,status='todo'){form.reset();$('#taskId').value=task?.id||'';$('#title').value=task?.title||'';$('#description').value=task?.description||'';$('#status').value=task?.status||status;$('#priority').value=task?.priority||'medium';$('#due').value=task?.due||'';$('#tag').value=task?.tag||'';$('#deleteTask').style.visibility=task?'visible':'hidden';$('#modalTitle').textContent=task?'Edit your task':'A small step forward.';modal.hidden=false;$('#title').focus()}
+function close(){modal.hidden=true}
+function notify(msg){const el=$('#toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200)}
+board.addEventListener('click',e=>{const add=e.target.closest('[data-add]'),edit=e.target.closest('[data-edit]');if(add)openTask(null,add.dataset.add);else if(edit)openTask(tasks.find(t=>t.id===edit.dataset.edit));else{const card=e.target.closest('.card');if(card)openTask(tasks.find(t=>t.id===card.dataset.id))}});
+board.addEventListener('dragstart',e=>{const card=e.target.closest('.card');if(card){e.dataTransfer.setData('text/plain',card.dataset.id);e.dataTransfer.effectAllowed='move';card.classList.add('dragging')}});board.addEventListener('dragend',e=>e.target.closest('.card')?.classList.remove('dragging'));board.addEventListener('dragover',e=>{const drop=e.target.closest('[data-drop]');if(drop){e.preventDefault();drop.classList.add('drag-over')}});board.addEventListener('dragleave',e=>{if(!e.currentTarget.contains(e.relatedTarget))return;e.target.closest('[data-drop]')?.classList.remove('drag-over')});board.addEventListener('drop',e=>{const drop=e.target.closest('[data-drop]');if(!drop)return;e.preventDefault();drop.classList.remove('drag-over');const task=tasks.find(t=>t.id===e.dataTransfer.getData('text/plain'));if(task){task.status=drop.dataset.drop;persist();render()}});
+form.addEventListener('submit',e=>{e.preventDefault();const id=$('#taskId').value,data={title:$('#title').value.trim(),description:$('#description').value.trim(),status:$('#status').value,priority:$('#priority').value,due:$('#due').value,tag:$('#tag').value.trim()};if(!data.title)return;if(id)Object.assign(tasks.find(t=>t.id===id),data);else tasks.unshift({...data,id:crypto.randomUUID(),created:Date.now()});persist();render();close();notify(id?'Task updated':'Task added')});$('#deleteTask').onclick=()=>{const id=$('#taskId').value;if(id&&confirm('Delete this task?')){tasks=tasks.filter(t=>t.id!==id);persist();render();close();notify('Task deleted')}};$('#newTask').onclick=()=>openTask();$('#closeModal').onclick=$('#cancel').onclick=close;modal.addEventListener('click',e=>{if(e.target===modal)close()});
+$('.tabs').addEventListener('click',e=>{const tab=e.target.closest('[data-filter]');if(!tab)return;filter=tab.dataset.filter;$('.tab.active')?.classList.remove('active');tab.classList.add('active');render()});$('#search').addEventListener('input',e=>{query=e.target.value.trim().toLowerCase();render()});$('#clearDone').onclick=()=>{const count=tasks.filter(t=>t.status==='done').length;if(count&&confirm(`Permanently clear ${count} completed ${count===1?'task':'tasks'}?`)){tasks=tasks.filter(t=>t.status!=='done');persist();render();notify('Completed tasks cleared')}};
+$('#exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify({version:1,tasks},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`daymark-backup-${dateOffset(0)}.json`;a.click();URL.revokeObjectURL(a.href);notify('Backup downloaded')};$('#importFile').onchange=async e=>{try{const value=JSON.parse(await e.target.files[0].text()),data=Array.isArray(value)?value:value.tasks;if(!Array.isArray(data)||data.some(t=>!t||typeof t.title!=='string'||!['todo','doing','done'].includes(t.status)))throw Error();if(confirm(`Replace your board with ${data.length} imported tasks?`)){tasks=data.map(t=>({...t,id:String(t.id||crypto.randomUUID()),title:t.title.slice(0,120),description:String(t.description||'').slice(0,1000),priority:['low','medium','high'].includes(t.priority)?t.priority:'medium',tag:String(t.tag||'').slice(0,24),due:/^\d{4}-\d{2}-\d{2}$/.test(t.due||'')?t.due:'',created:t.created||Date.now()}));persist();render();notify('Board restored')}}catch{notify('That backup file is not valid')}e.target.value=''};
+$('#menuBtn').onclick=()=>$('#helpDialog').showModal();$('#helpBtn').onclick=()=>$('#helpDialog').showModal();$('#closeHelp').onclick=()=>$('#helpDialog').close();$('#helpDialog').addEventListener('click',e=>{if(e.target===$('#helpDialog'))$('#helpDialog').close()});document.addEventListener('keydown',e=>{if(e.key==='Escape'){close();return}if(e.target.matches('input,textarea,select,[contenteditable]')||modal.hidden===false||$('#helpDialog').open)return;if(e.key.toLowerCase()==='n'){e.preventDefault();openTask()}if(e.key==='/'){e.preventDefault();$('#search').focus()}});
+render();
+})();
diff --git a/board/index.html b/board/index.html
new file mode 100644
index 0000000..aeae44b
--- /dev/null
+++ b/board/index.html
@@ -0,0 +1,21 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f6f7fb">
+<title>Daymark — personal kanban</title><link rel="stylesheet" href="style.css">
+</head>
+<body>
+<div class="app">
+<header class="topbar"><a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d</span><span>daymark</span></a><div class="top-actions"><span class="saved"><i></i> Saved on this device</span><button class="icon-btn" id="helpBtn" title="Keyboard shortcuts" aria-label="Keyboard shortcuts">?</button><button class="avatar" aria-label="Your workspace">J</button></div></header>
+<main>
+<section class="intro"><div><div class="eyebrow"><span class="spark">✳</span> YOUR SPACE, YOUR PACE</div><h1>Make room for <em>what matters.</em></h1><p>A clear view of what’s next, what’s moving, and what’s done.</p></div><button id="newTask" class="primary"><span>＋</span> New task <kbd>N</kbd></button></section>
+<section class="toolbar"><div class="tabs" role="tablist"><button class="tab active" data-filter="all">All tasks <span id="allCount">0</span></button><button class="tab" data-filter="today">Due today <span id="todayCount">0</span></button><button class="tab" data-filter="overdue">Overdue <span id="overdueCount">0</span></button></div><div class="tools"><label class="search"><span>⌕</span><input id="search" type="search" placeholder="Search tasks…" aria-label="Search tasks"><kbd>/</kbd></label><button class="outline" id="exportBtn" title="Download a backup">↧ <span>Export</span></button><label class="outline import-btn" title="Restore from backup">↥ <span>Import</span><input id="importFile" type="file" accept="application/json"></label><button class="outline" id="menuBtn" title="More options">···</button></div></section>
+<div class="board" id="board"></div>
+<footer><span><span class="key-hint">↵</span> Add a task <span class="dot">·</span> Drag cards to move them</span><button id="clearDone" class="text-btn">Clear completed</button></footer>
+</main>
+</div>
+<div class="modal-backdrop" id="modal" hidden><section class="dialog" role="dialog" aria-modal="true" aria-labelledby="modalTitle"><header class="dialog-head"><div><div class="eyebrow">TASK DETAILS</div><h2 id="modalTitle">A small step forward.</h2></div><button class="icon-btn close" id="closeModal" aria-label="Close">×</button></header><form id="taskForm"><input type="hidden" id="taskId"><label class="field-label" for="title">Task name</label><input class="text-input title-input" id="title" maxlength="120" placeholder="What needs doing?" required><label class="field-label" for="description">Notes <span>OPTIONAL</span></label><textarea class="text-input" id="description" rows="3" maxlength="1000" placeholder="Add a little context…"></textarea><div class="form-row"><div><label class="field-label" for="status">Column</label><select class="text-input" id="status"><option value="todo">To do</option><option value="doing">In progress</option><option value="done">Done</option></select></div><div><label class="field-label" for="priority">Priority</label><select class="text-input" id="priority"><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option></select></div></div><div class="form-row"><div><label class="field-label" for="due">Due date <span>OPTIONAL</span></label><input class="text-input" id="due" type="date"></div><div><label class="field-label" for="tag">Label <span>OPTIONAL</span></label><input class="text-input" id="tag" maxlength="24" placeholder="e.g. Personal"></div></div><div class="dialog-actions"><button type="button" class="danger text-btn" id="deleteTask">Delete task</button><span class="spacer"></span><button type="button" class="outline" id="cancel">Cancel</button><button class="primary" type="submit">Save task</button></div></form></section></div>
+<div class="toast" id="toast" role="status" aria-live="polite"></div>
+<dialog id="helpDialog" class="help-dialog"><button class="icon-btn close" id="closeHelp" aria-label="Close">×</button><div class="eyebrow">A FEW SHORTCUTS</div><h2>Keep your flow.</h2><p><kbd>N</kbd> Create a task</p><p><kbd>/</kbd> Search your board</p><p><kbd>Esc</kbd> Close a dialog</p><p class="help-note">Your board is saved privately in this browser. Export a backup anytime.</p></dialog>
+<script src="app.js"></script>
+</body></html>
