+const KEY='daymark-board-v1';
+const defaults=[
+ {id:'a1',title:'Plan the week ahead',description:'Take a few minutes to set priorities and make space for the important things.',status:'backlog',tag:'Personal',due:'',updated:Date.now()-120000},
+ {id:'a2',title:'Read 20 pages',description:'Continue with the book on the nightstand.',status:'backlog',tag:'Health',due:'',updated:Date.now()-360000},
+ {id:'a3',title:'Send project proposal',description:'Polish the final draft and share it with the team.',status:'doing',tag:'Work',due:'',updated:Date.now()-60000},
+ {id:'a4',title:'Book dentist appointment',description:'',status:'doing',tag:'Personal',due:'',updated:Date.now()-500000},
+ {id:'a5',title:'Set up morning routine',description:'',status:'done',tag:'Health',due:'',updated:Date.now()-86000000}
+];
+const statuses=[['backlog','To do'],['doing','In progress'],['done','Done']];
+let state;try{state=JSON.parse(localStorage.getItem(KEY))||{tasks:defaults,board:'My board'}}catch{state={tasks:defaults,board:'My board'}}
+if(!Array.isArray(state.tasks))state.tasks=defaults;let editing=null,query='',dueOnly=false,sortRecent=true,toastTimer;
+const $=s=>document.querySelector(s), escape=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+function save(){localStorage.setItem(KEY,JSON.stringify(state));render()}
+function dateLabel(value){if(!value)return'';const d=new Date(value+'T00:00:00'),now=new Date();now.setHours(0,0,0,0);let days=Math.round((d-now)/86400000);return days<0?`Overdue · ${d.toLocaleDateString(undefined,{month:'short',day:'numeric'})}`:days===0?'Due today':days===1?'Tomorrow':d.toLocaleDateString(undefined,{month:'short',day:'numeric'})}
+function render(){const filtered=state.tasks.filter(t=>(!query||`${t.title} ${t.description} ${t.tag}`.toLowerCase().includes(query))&&(!dueOnly||t.due&&t.due<=new Date(Date.now()+7*864e5).toISOString().slice(0,10)&&t.status!=='done'));$('#columns').innerHTML=statuses.map(([id,label])=>{let ts=filtered.filter(t=>t.status===id);if(sortRecent)ts.sort((a,b)=>b.updated-a.updated);return `<section class="column ${id}" data-status="${id}"><div class="column-head"><i class="status-dot"></i><span class="column-title">${label}</span><span class="column-count">${ts.length}</span><button class="column-add" data-add="${id}" title="Add task">＋</button></div><div class="task-list" data-drop="${id}">${ts.length?ts.map(t=>`<article class="task" draggable="true" data-id="${escape(t.id)}"><div class="task-top"><div class="task-name">${escape(t.title)}</div><button class="task-menu" data-edit="${escape(t.id)}" aria-label="Edit task">···</button></div>${t.description?`<p class="task-desc">${escape(t.description)}</p>`:''}<div class="task-meta">${t.tag?`<span class="tag ${escape(t.tag)}">${escape(t.tag)}</span>`:''}${t.due?`<span class="due ${t.due<new Date().toISOString().slice(0,10)?'overdue':t.due<=new Date(Date.now()+864e5).toISOString().slice(0,10)?'soon':''}">${escape(dateLabel(t.due))}</span>`:''}</div></article>`).join(''):`<div class="empty">Nothing here yet</div>`}<div class="drop-hint">Drop a task here</div></div></section>`}).join('');$('#taskTotal').textContent=`${state.tasks.length} ${state.tasks.length===1?'task':'tasks'}`;$('#dueCount').textContent=state.tasks.filter(t=>t.due&&t.due<=new Date(Date.now()+7*864e5).toISOString().slice(0,10)&&t.status!=='done').length;$('#allFilter').innerHTML=`☷ <span>${dueOnly?'Due in 7 days':'All tasks'}</span> <span class="chevron">⌄</span>`;$('#sortBtn').innerHTML=`↕ <span>${sortRecent?'Recently updated':'Oldest first'}</span> <span class="chevron">⌄</span>`;document.querySelectorAll('.task').forEach(el=>{el.addEventListener('dragstart',e=>{e.dataTransfer.setData('text/plain',el.dataset.id);el.classList.add('dragging')});el.addEventListener('dragend',()=>el.classList.remove('dragging'));el.addEventListener('dblclick',()=>openTask(el.dataset.id))});document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>openTask(b.dataset.edit));document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>openTask(null,b.dataset.add));document.querySelectorAll('[data-drop]').forEach(zone=>{zone.ondragover=e=>{e.preventDefault();zone.classList.add('drag-over')};zone.ondragleave=()=>zone.classList.remove('drag-over');zone.ondrop=e=>{e.preventDefault();zone.classList.remove('drag-over');const t=state.tasks.find(t=>t.id===e.dataTransfer.getData('text/plain'));if(t){t.status=zone.dataset.drop;t.updated=Date.now();save()}}})}
+function openTask(id=null,status='backlog'){editing=id;const t=state.tasks.find(x=>x.id===id);$('#modalTitle').textContent=t?'Edit task':'New task';$('#taskName').value=t?.title||'';$('#taskDescription').value=t?.description||'';$('#taskStatus').value=t?.status||status;$('#taskDate').value=t?.due||'';$('#taskTag').value=t?.tag||'';$('#deleteTask').style.visibility=t?'visible':'hidden';$('#modal').hidden=false;setTimeout(()=>$('#taskName').focus(),20)}function close(){ $('#modal').hidden=true }
+function notify(msg){const el=$('#toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200)}
+$('#taskForm').onsubmit=e=>{e.preventDefault();const data={title:$('#taskName').value.trim(),description:$('#taskDescription').value.trim(),status:$('#taskStatus').value,due:$('#taskDate').value,tag:$('#taskTag').value,updated:Date.now()};if(!data.title)return;if(editing)Object.assign(state.tasks.find(t=>t.id===editing),data);else state.tasks.push({id:crypto.randomUUID?.()||String(Date.now()),...data});save();close();notify(editing?'Task updated':'Task added');editing=null};document.querySelectorAll('.close-modal').forEach(b=>b.onclick=close);$('#modal').onclick=e=>{if(e.target===$('#modal'))close()};$('#deleteTask').onclick=()=>{if(editing&&confirm('Delete this task?')){state.tasks=state.tasks.filter(t=>t.id!==editing);save();close();notify('Task deleted');editing=null}};$('#addTask').onclick=()=>openTask();$('#search').oninput=e=>{query=e.target.value.toLowerCase();render()};$('#allFilter').onclick=()=>{dueOnly=!dueOnly;render()};$('#focusFilter').onclick=()=>{dueOnly=!dueOnly;render()};$('#sortBtn').onclick=()=>{sortRecent=!sortRecent;render()};$('#renameBtn').onclick=()=>{const name=prompt('Board name',state.board||'My board');if(name?.trim()){state.board=name.trim();$('#headingName').textContent=name;save()}};$('#settingsBtn').onclick=()=>{if(confirm('Clear all board tasks? This cannot be undone.')){state.tasks=[];save();notify('Board cleared')}};
+document.addEventListener('keydown',e=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();$('#search').focus()}if(e.key==='Escape')close();if(e.key.toLowerCase()==='n'&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName))openTask()});
+$('#exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='daymark-board.json';a.click();URL.revokeObjectURL(a.href)};$('#importBtn').onclick=()=>$('#importFile').click();$('#importFile').onchange=async e=>{try{const data=JSON.parse(await e.target.files[0].text());if(!Array.isArray(data.tasks)||!data.tasks.every(t=>t.title&&statuses.some(s=>s[0]===t.status)))throw Error();if(confirm(`Replace this board with ${data.tasks.length} imported tasks?`)){state={tasks:data.tasks,board:data.board||'My board'};save();notify('Board imported')}}catch{notify('Could not import that board file')}e.target.value=''};
+$('#footerDate').textContent=new Date().toLocaleDateString(undefined,{weekday:'short',month:'short',day:'numeric'});render();
