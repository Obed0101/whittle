+    <div class="side-bottom"><span class="avatar">Y</span><span><b>Your workspace</b><small>Personal board</small></span><button class="icon-btn" id="settingsBtn" title="Board options">···</button></div>
+  </aside>
+  <main class="main">
+    <header class="topbar"><div class="breadcrumbs">Workspace <span>/</span> <b>My board</b></div><div class="top-actions"><label class="search"><span>⌕</span><input id="search" placeholder="Search tasks..." aria-label="Search tasks"><kbd>⌘ K</kbd></label><button id="exportBtn" class="quiet-btn" title="Export board">↥ <span>Export</span></button><button id="importBtn" class="quiet-btn" title="Import board">↧ <span>Import</span></button><input id="importFile" type="file" accept="application/json" hidden></div></header>
+    <section class="board-area"><div class="heading-row"><div><div class="eyebrow"><span class="live-dot"></span> YOUR WORKSPACE</div><h1><span id="headingName">My board</span> <button id="renameBtn" class="title-edit" title="Rename board">✎</button></h1><p class="subtitle">A clear mind starts with a clear view.</p></div><button class="primary" id="addTask"><span>＋</span> Add task</button></div>
+      <div class="board-toolbar"><div class="view-tabs"><button class="tab active">Board</button><span class="tab-divider"></span><span class="task-total" id="taskTotal">0 tasks</span></div><div class="toolbar-right"><button class="filter-button" id="allFilter">☷ <span>All tasks</span> <span class="chevron">⌄</span></button><button class="filter-button" id="sortBtn">↕ <span>Recently updated</span> <span class="chevron">⌄</span></button></div></div>
+      <div class="columns" id="columns"></div>
+      <footer><span><i></i> Changes save automatically</span><span id="footerDate"></span></footer>
+    </section>
+  </main>
+</div>
+<div class="modal-backdrop" id="modal" hidden><form class="task-modal" id="taskForm"><div class="modal-head"><div><span class="eyebrow">TASK DETAILS</span><h2 id="modalTitle">New task</h2></div><button type="button" class="icon-btn close-modal" aria-label="Close">×</button></div><label class="field-label" for="taskName">Task name</label><input id="taskName" class="text-input" maxlength="120" placeholder="What needs to get done?" required><label class="field-label" for="taskDescription">Description <span>OPTIONAL</span></label><textarea id="taskDescription" class="text-input" rows="3" maxlength="600" placeholder="Add a few details..."></textarea><div class="field-row"><div><label class="field-label" for="taskStatus">Status</label><select id="taskStatus" class="text-input"><option value="backlog">To do</option><option value="doing">In progress</option><option value="done">Done</option></select></div><div><label class="field-label" for="taskDate">Due date</label><input id="taskDate" type="date" class="text-input"></div></div><label class="field-label" for="taskTag">Label <span>OPTIONAL</span></label><select id="taskTag" class="text-input"><option value="">No label</option><option value="Personal">Personal</option><option value="Work">Work</option><option value="Ideas">Ideas</option><option value="Health">Health</option></select><div class="modal-actions"><button type="button" id="deleteTask" class="delete-btn">Delete task</button><span class="action-spacer"></span><button type="button" class="secondary close-modal">Cancel</button><button class="primary" type="submit">Save task</button></div></form></div>
+<div class="toast" id="toast" role="status"></div>
+<script src="app.js"></script>
+</body></html>
