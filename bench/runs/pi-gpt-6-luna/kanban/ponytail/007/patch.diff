+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f6f7f5"><title>Daymark — Personal board</title>
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<div class="shell">
