+  </aside>
+  <main class="main">
+    <header class="topbar"><div class="crumb">Workspace <span>/</span> <strong>Personal</strong></div><div class="top-actions"><button id="exportBtn" class="icon-button" title="Export board" aria-label="Export board">⇩</button><button id="importBtn" class="icon-button" title="Import board" aria-label="Import board">⇧</button><input id="importFile" type="file" accept="application/json" hidden><div class="avatar" title="Your profile">M</div></div></header>
+    <section class="board-header"><div><div class="eyebrow"><span class="live-dot"></span> YOUR SPACE, YOUR PACE</div><h1>Personal board <span class="sparkle">✳</span></h1><p class="subtitle">Make room for what matters.</p></div><button id="addTaskTop" class="primary"><span>＋</span> Add a task</button></section>
+    <section class="toolbar"><div class="toolbar-left"><div class="date-label" id="todayLabel"></div><span class="toolbar-divider"></span><span id="taskSummary">0 tasks</span></div><div class="toolbar-right"><label class="search"><span>⌕</span><input id="searchInput" type="search" placeholder="Search tasks…" aria-label="Search tasks"><kbd>/</kbd></label><button id="filterBtn" class="filter-btn">☷ <span>Filter</span><span id="filterDot" class="filter-dot"></span></button></div></section>
+    <section class="board" id="board" aria-label="Kanban board"></section>
+    <footer class="footer"><span>Changes save automatically</span><span class="save-indicator"><i></i> All changes saved</span><span class="keyboard-hint"><kbd>N</kbd> new task <span>·</span> <kbd>/</kbd> search</span></footer>
+  </main>
+</div>
+<dialog id="taskDialog"><form method="dialog" id="taskForm"><div class="modal-head"><div><div class="eyebrow">MAKE IT HAPPEN</div><h2 id="dialogTitle">New task</h2></div><button class="plain-icon close-dialog" aria-label="Close">×</button></div><label class="field-label" for="taskTitle">Task name</label><input id="taskTitle" class="text-input" maxlength="120" placeholder="What needs to get done?" required><label class="field-label" for="taskNote">Notes <span>OPTIONAL</span></label><textarea id="taskNote" class="text-input" rows="3" maxlength="500" placeholder="Add a little context…"></textarea><div class="field-row"><div><label class="field-label" for="taskStatus">Status</label><select id="taskStatus" class="text-input"><option value="todo">To do</option><option value="doing">In progress</option><option value="done">Done</option></select></div><div><label class="field-label" for="taskPriority">Priority</label><select id="taskPriority" class="text-input"><option value="normal">No priority</option><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select></div></div><div class="field-row"><div><label class="field-label" for="taskDue">Due date</label><input id="taskDue" class="text-input" type="date"></div><div><label class="field-label" for="taskTag">Label</label><input id="taskTag" class="text-input" maxlength="24" placeholder="e.g. Work"></div></div><div class="modal-actions"><button type="button" id="deleteTask" class="delete-button">Delete task</button><span class="action-spacer"></span><button type="button" class="secondary close-dialog">Cancel</button><button type="submit" class="primary">Save task <span>↵</span></button></div></form></dialog>
+<div id="toast" class="toast" role="status" aria-live="polite"></div>
+<script src="app.js"></script>
+</body></html>
