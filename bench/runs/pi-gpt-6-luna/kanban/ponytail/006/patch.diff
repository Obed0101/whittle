+const KEY='daymark-board-v1';
+const defaults=[
+{id:'1',title:'Plan the week ahead',note:'Take a quiet moment to set intentions and pick the few things that matter most.',status:'todo',priority:'medium',tag:'Ritual',due:dateOffset(0),created:Date.now()-3},
+{id:'2',title:'Book a dentist appointment',note:'Find a time that works before the end of the month.',status:'todo',priority:'low',tag:'Life admin',due:dateOffset(4),created:Date.now()-2},
+{id:'3',title:'Read 20 pages',note:'Keep going with the book on the nightstand.',status:'todo',priority:'normal',tag:'Personal',due:'',created:Date.now()-1},
+{id:'4',title:'Send project update',note:'Share the latest progress and next steps with the team.',status:'doing',priority:'high',tag:'Work',due:dateOffset(0),created:Date.now()-4},
+{id:'5',title:'Go for a morning walk',note:'No podcast today. Just get outside.',status:'done',priority:'normal',tag:'Wellbeing',due:'',created:Date.now()-5}
+];
+function dateOffset(days){const d=new Date();d.setDate(d.getDate()+days);return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
+let tasks;try{const saved=JSON.parse(localStorage.getItem(KEY));tasks=Array.isArray(saved)?saved:defaults}catch{tasks=defaults}
+const columns=[['todo','To do','○'],['doing','In progress','◷'],['done','Done','✓']];let editing=null,query='',focusOnly=false,filter='all',toastTimer;
+const $=s=>document.querySelector(s), board=$('#board');
+function save(){localStorage.setItem(KEY,JSON.stringify(tasks));$('.save-indicator').innerHTML='<i></i> All changes saved'}
+function render(){const today=dateOffset(0);$('#todayLabel').textContent=new Intl.DateTimeFormat('en',{weekday:'long',month:'long',day:'numeric'}).format(new Date());let shown=tasks.filter(t=>{const text=`${t.title} ${t.note} ${t.tag}`.toLowerCase();return(!query||text.includes(query.toLowerCase()))&&(!focusOnly||(t.due===today&&t.status!=='done'))&&(filter==='all'||t.priority===filter)});$('#totalCount').textContent=tasks.filter(t=>t.status!=='done').length;$('#taskSummary').textContent=`${shown.length} ${shown.length===1?'task':'tasks'}${focusOnly?' due today':''}`;$('#filterDot').classList.toggle('on',filter!=='all');board.innerHTML='';for(const [status,label,icon] of columns){const list=shown.filter(t=>t.status===status);const col=document.createElement('section');col.className='column';col.dataset.status=status;col.innerHTML=`<div class="column-head"><span class="column-icon">${icon}</span><span class="column-title">${label}</span><span class="column-count">${list.length}</span><button class="column-add" title="Add to ${label}" aria-label="Add to ${label}">＋</button></div><div class="cards">${list.length?'':'<div class="empty-column">Nothing here yet. Enjoy the space.</div>'}</div>`;col.querySelector('.column-add').onclick=()=>openTask(null,status);const cards=col.querySelector('.cards');for(const task of list)cards.append(makeCard(task));col.ondragover=e=>{e.preventDefault();col.classList.add('drag-over')};col.ondragleave=()=>col.classList.remove('drag-over');col.ondrop=e=>{e.preventDefault();col.classList.remove('drag-over');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=status;save();render()}};board.append(col)} }
+function makeCard(t){const card=document.createElement('article');card.className='task-card';card.draggable=true;card.dataset.id=t.id;const due=t.due?new Date(`${t.due}T12:00:00`):null, dueText=due?due.toLocaleDateString('en',{month:'short',day:'numeric'}):'';let dueClass=t.status==='done'?'complete':t.due<dateOffset(0)?'overdue':t.due===dateOffset(0)?'soon':'';card.innerHTML=`<div class="card-top"><div class="card-title"></div><button class="card-menu" aria-label="Edit task">···</button></div>${t.note?'<p class="card-note"></p>':''}<div class="card-tags">${t.priority&&t.priority!=='normal'?`<span class="priority ${t.priority}">${t.priority[0].toUpperCase()+t.priority.slice(1)} priority</span>`:''}${t.tag?'<span class="tag"></span>':''}</div>${dueText?`<div class="card-bottom"><span class="due ${dueClass}">${t.status==='done'?'✓':'◷'} ${dueText}${dueClass==='overdue'?' · overdue':''}</span><span>${t.status==='done'?'Completed':''}</span></div>`:''}`;card.querySelector('.card-title').textContent=t.title;if(t.note)card.querySelector('.card-note').textContent=t.note;if(t.tag)card.querySelector('.tag').textContent=t.tag;card.querySelector('.card-menu').onclick=()=>openTask(t.id);card.ondblclick=()=>openTask(t.id);card.ondragstart=e=>{e.dataTransfer.setData('text/plain',t.id);setTimeout(()=>card.classList.add('dragging'),0)};card.ondragend=()=>card.classList.remove('dragging');return card}
+function openTask(id,status='todo'){editing=id;const t=tasks.find(x=>x.id===id);$('#dialogTitle').textContent=t?'Edit task':'New task';$('#taskTitle').value=t?.title||'';$('#taskNote').value=t?.note||'';$('#taskStatus').value=t?.status||status;$('#taskPriority').value=t?.priority||'normal';$('#taskDue').value=t?.due||'';$('#taskTag').value=t?.tag||'';$('#deleteTask').style.display=t?'block':'none';$('#taskDialog').showModal();setTimeout(()=>$('#taskTitle').focus(),50)}
+function notify(msg){const el=$('#toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2300)}
+$('#taskForm').onsubmit=e=>{e.preventDefault();const title=$('#taskTitle').value.trim();if(!title)return;const data={title,note:$('#taskNote').value.trim(),status:$('#taskStatus').value,priority:$('#taskPriority').value,due:$('#taskDue').value,tag:$('#taskTag').value.trim()};if(editing)Object.assign(tasks.find(t=>t.id===editing),data);else tasks.unshift({id:crypto.randomUUID?.()||String(Date.now()),...data,created:Date.now()});save();$('#taskDialog').close();render();notify(editing?'Task updated':'Task added')};$('#deleteTask').onclick=()=>{if(editing&&confirm('Delete this task?')){tasks=tasks.filter(t=>t.id!==editing);save();$('#taskDialog').close();render();notify('Task deleted')}};document.querySelectorAll('.close-dialog').forEach(b=>b.onclick=()=>$('#taskDialog').close());$('#addTaskTop').onclick=()=>openTask();$('#searchInput').oninput=e=>{query=e.target.value;render()};$('#filterBtn').onclick=()=>{const choices=['all','high','medium','low'],names=['All priorities','High priority','Medium priority','Low priority'];filter=choices[(choices.indexOf(filter)+1)%choices.length];$('#filterBtn').querySelector('span').textContent=names[choices.indexOf(filter)];render()};$('#focusNav').onclick=()=>{focusOnly=!focusOnly;$('#focusNav').classList.toggle('active',focusOnly);$('#boardNav').classList.toggle('active',!focusOnly);render()};$('#boardNav').onclick=()=>{focusOnly=false;$('#focusNav').classList.remove('active');$('#boardNav').classList.add('active');render()};$('#resetBtn').onclick=()=>{if(confirm('Replace your board with the starter tasks? This cannot be undone.')){tasks=defaults.map(t=>({...t}));save();render();notify('Starter board restored')}};$('#exportBtn').onclick=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(tasks,null,2)],{type:'application/json'}));a.download=`daymark-board-${dateOffset(0)}.json`;a.click();URL.revokeObjectURL(a.href)};$('#importBtn').onclick=()=>$('#importFile').click();$('#importFile').onchange=async e=>{try{const data=JSON.parse(await e.target.files[0].text());if(!Array.isArray(data)||data.some(t=>!t.title||!['todo','doing','done'].includes(t.status)))throw Error();tasks=data;save();render();notify('Board imported')}catch{notify('Could not import that board')}e.target.value=''};$('#newBoardBtn').onclick=()=>notify('Your personal board is ready');document.addEventListener('keydown',e=>{if(e.key==='Escape')return;if(e.target.matches('input,textarea,select'))return;if(e.key==='n'||e.key==='N'){e.preventDefault();openTask()}if(e.key==='/'){e.preventDefault();$('#searchInput').focus()}});render();
