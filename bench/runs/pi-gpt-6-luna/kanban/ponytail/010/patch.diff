+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f5f5f2"><title>Daymark — Personal Kanban</title>
+<style>
+:root{--bg:#f5f5f2;--panel:#fff;--ink:#252820;--muted:#85877e;--line:#e9e9e3;--accent:#52684d;--accent-soft:#edf1e9;--shadow:0 3px 14px #26291a0b;--red:#b96552;--amber:#c49348;--blue:#6685a1}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,textarea,select{font:inherit}button{cursor:pointer;color:inherit}.shell{max-width:1440px;margin:auto;padding:30px 42px 48px}.top{display:flex;justify-content:space-between;align-items:center;padding-bottom:27px;border-bottom:1px solid var(--line)}.brand{display:flex;gap:12px;align-items:center}.logo{width:34px;height:34px;background:var(--accent);border-radius:10px;color:white;display:grid;place-items:center;font-size:20px}.brand-name{font-weight:700;font-size:16px;letter-spacing:-.3px}.brand-sub{font-size:11px;color:var(--muted)}.top-actions{display:flex;gap:9px;align-items:center}.icon-btn,.btn{border:1px solid var(--line);background:var(--panel);border-radius:8px;padding:8px 12px}.icon-btn{width:36px;height:36px;padding:0;color:var(--muted)}.btn.primary{background:var(--accent);color:white;border-color:var(--accent);font-weight:600}.btn:hover,.icon-btn:hover{filter:brightness(.97)}.intro{display:flex;justify-content:space-between;align-items:flex-end;padding:28px 0 22px}.eyebrow{text-transform:uppercase;letter-spacing:1.6px;font-size:10px;color:var(--muted);font-weight:700}.intro h1{font-size:27px;letter-spacing:-.9px;margin:5px 0 3px}.intro p{margin:0;color:var(--muted);font-size:13px}.date{font-size:12px;color:var(--muted);text-align:right}.toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:17px;gap:12px}.filters{display:flex;align-items:center;gap:8px}.search{position:relative}.search input{width:220px;padding:9px 12px 9px 34px;border:1px solid var(--line);border-radius:8px;background:var(--panel);outline:none}.search:before{content:'⌕';position:absolute;left:12px;top:4px;color:var(--muted);font-size:21px}.select{padding:9px 28px 9px 11px;border:1px solid var(--line);border-radius:8px;background:var(--panel);color:#666}.board{display:grid;grid-template-columns:repeat(4,minmax(220px,1fr));gap:15px;align-items:start}.column{background:#eeefeb;border-radius:11px;padding:12px;min-height:320px;transition:background .15s}.column.drag-over{background:#e2e9df}.col-head{display:flex;justify-content:space-between;align-items:center;padding:2px 2px 12px}.col-title{display:flex;gap:8px;align-items:center;font-weight:650;font-size:13px}.dot{width:8px;height:8px;border-radius:50%;background:#9b9c94}.column[data-status="doing"] .dot{background:var(--amber)}.column[data-status="done"] .dot{background:var(--accent)}.column[data-status="backlog"] .dot{background:var(--blue)}.count{font-weight:500;color:var(--muted);font-size:11px;background:#e4e5e0;border-radius:20px;padding:2px 7px}.add-col{border:0;background:transparent;color:var(--muted);font-size:19px;line-height:1}.cards{display:flex;flex-direction:column;gap:9px;min-height:245px}.card{background:var(--panel);border:1px solid #e8e8e3;border-radius:9px;padding:12px 12px 10px;box-shadow:var(--shadow);cursor:grab}.card:active{cursor:grabbing}.card.dragging{opacity:.4}.card-top{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}.card h3{font-size:13px;line-height:1.4;margin:0;font-weight:650;letter-spacing:-.1px;overflow-wrap:anywhere}.more{border:0;background:transparent;color:#a2a39b;font-size:18px;padding:0 2px;line-height:15px}.card-desc{font-size:12px;color:#77796f;margin:8px 0 2px;white-space:pre-wrap;overflow-wrap:anywhere}.tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:10px}.tag{background:#f1f1ed;color:#77796f;padding:3px 7px;border-radius:4px;font-size:10px}.priority{font-weight:650}.priority.high{color:var(--red);background:#f8eeeb}.priority.medium{color:#a67b36;background:#f8f3e8}.priority.low{color:#66807a;background:#edf3f0}.card-foot{display:flex;justify-content:space-between;align-items:center;color:#989990;font-size:10px;margin-top:11px}.due.overdue{color:var(--red);font-weight:600}.empty{border:1px dashed #d4d6ce;border-radius:8px;padding:20px 10px;text-align:center;color:#999b92;font-size:12px;margin-top:3px}.empty button{border:0;background:none;color:var(--accent);font-weight:600;padding:3px}.column-add{width:100%;text-align:left;border:1px dashed #d1d3ca;color:#85877e;background:transparent;border-radius:7px;padding:8px 10px;font-size:12px;margin-top:9px}.column-add:hover{border-color:var(--accent);color:var(--accent)}.footer{display:flex;justify-content:space-between;color:#999b92;font-size:11px;padding-top:22px}.footer button{border:0;background:none;color:#77796f;font-size:11px;text-decoration:underline;padding:0}.modal-back{position:fixed;inset:0;background:#20231e66;display:grid;place-items:center;padding:18px;z-index:5}.modal{width:min(460px,100%);background:white;border-radius:13px;padding:22px;box-shadow:0 20px 70px #0003}.modal h2{font-size:18px;margin:0 0 18px}.field{margin-bottom:13px}.field label{display:block;font-size:11px;font-weight:650;color:#66695f;margin-bottom:5px}.field input,.field textarea,.field select{width:100%;border:1px solid var(--line);border-radius:7px;padding:9px 10px;outline:none;background:white}.field input:focus,.field textarea:focus,.field select:focus{border-color:#82927c;box-shadow:0 0 0 3px #52684d15}.field textarea{resize:vertical;min-height:78px}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.modal-actions{display:flex;justify-content:space-between;align-items:center;padding-top:5px}.actions-right{display:flex;gap:8px}.btn.danger{border-color:#f0d8d3;color:#a95949;background:#fff}.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#262a24;color:white;padding:10px 15px;border-radius:8px;font-size:12px;box-shadow:var(--shadow);z-index:8}.hidden{display:none!important}input[type=file]{display:none}@media(max-width:1000px){.board{grid-template-columns:repeat(2,minmax(220px,1fr))}.shell{padding:24px}}@media(max-width:560px){.shell{padding:17px 14px 35px}.top{padding-bottom:17px}.brand-sub{display:none}.intro{padding:23px 0 18px}.intro h1{font-size:24px}.date{max-width:120px}.toolbar{align-items:stretch;flex-direction:column}.filters{width:100%}.search{flex:1}.search input{width:100%}.select{max-width:130px}.board{grid-template-columns:minmax(0,1fr);gap:11px}.column{min-height:170px}.cards{min-height:92px}.empty{padding:14px}.footer{gap:12px}.top-actions .btn{padding:8px 10px}}
+</style></head>
+<body><main class="shell"><header class="top"><div class="brand"><div class="logo">✓</div><div><div class="brand-name">Daymark</div><div class="brand-sub">Your work, in good order</div></div></div><div class="top-actions"><button class="icon-btn" id="exportBtn" title="Export board" aria-label="Export board">↥</button><button class="icon-btn" id="importBtn" title="Import board" aria-label="Import board">↧</button><input type="file" id="fileInput" accept="application/json"><button class="btn primary" id="newTask">＋ &nbsp;New task</button></div></header><section class="intro"><div><div class="eyebrow">Your workspace</div><h1>Personal board</h1><p>A little progress, every day.</p></div><div class="date" id="today"></div></section><section class="toolbar"><div class="filters"><label class="search"><input id="search" type="search" placeholder="Find a task…" aria-label="Search tasks"></label><select id="priorityFilter" class="select" aria-label="Filter by priority"><option value="all">All priorities</option><option value="high">High priority</option><option value="medium">Medium priority</option><option value="low">Low priority</option></select></div><div class="eyebrow" id="summary"></div></section><section class="board" id="board" aria-label="Kanban board"></section><footer class="footer"><span>Your board saves automatically on this device.</span><button id="clearDone">Clear completed</button></footer></main><div id="modalRoot"></div><div id="toast" class="toast hidden" role="status"></div>
+<script>
+(()=>{'use strict';const KEY='daymark-board-v1',statuses=[['backlog','Up next'],['todo','To do'],['doing','In progress'],['done','Done']];let tasks=load(),query='',priority='all',dragId=null,toastTimer;const $=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function load(){try{const x=JSON.parse(localStorage.getItem(KEY));if(Array.isArray(x))return x.filter(t=>t&&t.id&&t.title&&statuses.some(s=>s[0]===t.status))}catch{}return [{id:crypto.randomUUID(),title:'Plan the week',description:'Choose a few things that matter most.',status:'todo',priority:'medium',due:'',tags:['Planning'],created:Date.now()},{id:crypto.randomUUID(),title:'Make room to focus',description:'Protect one block of uninterrupted time.',status:'backlog',priority:'low',due:'',tags:['Personal'],created:Date.now()},{id:crypto.randomUUID(),title:'A small win',description:'Move something forward today.',status:'doing',priority:'high',due:'',tags:[],created:Date.now()}]}function save(){localStorage.setItem(KEY,JSON.stringify(tasks))}function niceDate(d){if(!d)return'';return new Date(d+'T00:00:00').toLocaleDateString(undefined,{month:'short',day:'numeric'})}function render(){const board=$('#board');board.innerHTML=statuses.map(([status,label])=>{const list=tasks.filter(t=>t.status===status&&(`${t.title} ${t.description||''} ${(t.tags||[]).join(' ')}`.toLowerCase().includes(query))&&(priority==='all'||t.priority===priority));return `<section class="column" data-status="${status}"><header class="col-head"><div class="col-title"><i class="dot"></i>${label}<span class="count">${tasks.filter(t=>t.status===status).length}</span></div><button class="add-col" data-add="${status}" aria-label="Add task to ${label}" title="Add task">＋</button></header><div class="cards">${list.length?list.map(card).join(''):`<div class="empty">${query||priority!=='all'?'No matching tasks.':'Nothing here yet.'}${!query&&priority==='all'?`<br><button data-add="${status}">Add a task</button>`:''}</div>`}</div><button class="column-add" data-add="${status}">＋ &nbsp;Add a task</button></section>`}).join('');const n=tasks.length,done=tasks.filter(t=>t.status==='done').length;$('#summary').textContent=`${n} ${n===1?'task':'tasks'} · ${done} completed`;bindBoard()}function card(t){const due=t.due?`<span class="due ${t.status!=='done'&&t.due<new Date().toISOString().slice(0,10)?'overdue':''}">◷ ${niceDate(t.due)}</span>`:'';return `<article class="card" draggable="true" data-id="${esc(t.id)}"><div class="card-top"><h3>${esc(t.title)}</h3><button class="more" data-edit="${esc(t.id)}" aria-label="Edit ${esc(t.title)}">···</button></div>${t.description?`<p class="card-desc">${esc(t.description)}</p>`:''}<div class="tags">${t.priority&&t.priority!=='none'?`<span class="tag priority ${esc(t.priority)}">${esc(t.priority[0].toUpperCase()+t.priority.slice(1))}</span>`:''}${(t.tags||[]).map(x=>`<span class="tag">${esc(x)}</span>`).join('')}</div><div class="card-foot"><span>${t.created?`Added ${new Date(t.created).toLocaleDateString(undefined,{month:'short',day:'numeric'})}`:''}</span>${due}</div></article>`}function bindBoard(){document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>openForm(null,b.dataset.add));document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>openForm(tasks.find(t=>t.id===b.dataset.edit)));document.querySelectorAll('.card').forEach(c=>{c.ondragstart=()=>{dragId=c.dataset.id;c.classList.add('dragging')};c.ondragend=()=>{dragId=null;c.classList.remove('dragging')};});document.querySelectorAll('.column').forEach(col=>{col.ondragover=e=>{e.preventDefault();col.classList.add('drag-over')};col.ondragleave=()=>col.classList.remove('drag-over');col.ondrop=e=>{e.preventDefault();col.classList.remove('drag-over');const t=tasks.find(x=>x.id===dragId);if(t&&t.status!==col.dataset.status){t.status=col.dataset.status;save();render()}}})}function openForm(task=null,status='todo'){const t=task||{title:'',description:'',status,priority:'medium',due:'',tags:[]};$('#modalRoot').innerHTML=`<div class="modal-back"><form class="modal" id="taskForm"><h2>${task?'Edit task':'New task'}</h2><div class="field"><label for="title">Task</label><input id="title" maxlength="120" required value="${esc(t.title)}" placeholder="What needs doing?"></div><div class="field"><label for="description">Notes</label><textarea id="description" maxlength="1000" placeholder="Add a little context…">${esc(t.description||'')}</textarea></div><div class="form-row"><div class="field"><label for="status">Column</label><select id="status">${statuses.map(([v,l])=>`<option value="${v}" ${v===t.status?'selected':''}>${l}</option>`).join('')}</select></div><div class="field"><label for="priority">Priority</label><select id="priority"><option value="low" ${t.priority==='low'?'selected':''}>Low</option><option value="medium" ${t.priority==='medium'?'selected':''}>Medium</option><option value="high" ${t.priority==='high'?'selected':''}>High</option><option value="none" ${!t.priority||t.priority==='none'?'selected':''}>None</option></select></div></div><div class="form-row"><div class="field"><label for="due">Due date</label><input id="due" type="date" value="${esc(t.due||'')}"></div><div class="field"><label for="tags">Labels <span style="font-weight:400">· comma separated</span></label><input id="tags" maxlength="120" value="${esc((t.tags||[]).join(', '))}" placeholder="Work, Personal"></div></div><div class="modal-actions">${task?'<button type="button" class="btn danger" id="deleteTask">Delete</button>':'<span></span>'}<div class="actions-right"><button type="button" class="btn" id="cancel">Cancel</button><button class="btn primary">Save task</button></div></div></form></div>`;const form=$('#taskForm');form.onsubmit=e=>{e.preventDefault();const data={title:$('#title').value.trim(),description:$('#description').value.trim(),status:$('#status').value,priority:$('#priority').value,due:$('#due').value,tags:$('#tags').value.split(',').map(x=>x.trim()).filter(Boolean)};if(task)Object.assign(task,data);else tasks.unshift({id:crypto.randomUUID(),created:Date.now(),...data});save();close();render()};$('#cancel').onclick=close;if(task)$('#deleteTask').onclick=()=>{if(confirm('Delete this task?')){tasks=tasks.filter(x=>x.id!==task.id);save();close();render()}};$('.modal-back').onclick=e=>{if(e.target.classList.contains('modal-back'))close()};form.onkeydown=e=>{if(e.key==='Escape')close()};$('#title').focus()}function close(){$('#modalRoot').innerHTML=''}function notify(msg){const el=$('#toast');el.textContent=msg;el.classList.remove('hidden');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.add('hidden'),2300)}$('#today').textContent=new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'});$('#newTask').onclick=()=>openForm();$('#search').oninput=e=>{query=e.target.value.toLowerCase().trim();render()};$('#priorityFilter').onchange=e=>{priority=e.target.value;render()};$('#clearDone').onclick=()=>{const n=tasks.filter(t=>t.status==='done').length;if(n&&confirm(`Remove ${n} completed ${n===1?'task':'tasks'}?`)){tasks=tasks.filter(t=>t.status!=='done');save();render();notify('Completed tasks cleared.')}};$('#exportBtn').onclick=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(tasks,null,2)],{type:'application/json'}));a.download=`daymark-${new Date().toISOString().slice(0,10)}.json`;a.click();URL.revokeObjectURL(a.href);notify('Board exported.')};$('#importBtn').onclick=()=>$('#fileInput').click();$('#fileInput').onchange=async e=>{try{const data=JSON.parse(await e.target.files[0].text());if(!Array.isArray(data)||data.some(t=>!t||typeof t.title!=='string'||!statuses.some(s=>s[0]===t.status)))throw Error();if(confirm('Replace this board with the imported tasks?')){tasks=data;save();render();notify('Board imported.')}}catch{alert('That file is not a valid Daymark board export.')}e.target.value=''};document.addEventListener('keydown',e=>{if(e.key==='Escape')close();if((e.metaKey||e.ctrlKey)&&e.key==='Enter')openForm()});render()})();
+</script></body></html>
