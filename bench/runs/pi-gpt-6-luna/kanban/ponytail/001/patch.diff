+(() => {
+  const columns = [{id:'backlog',name:'To do'},{id:'progress',name:'In progress'},{id:'review',name:'Up next'},{id:'done',name:'Done'}];
+  const seed = [
+    {id:'a1',title:'Plan the week ahead',notes:'Pick the three things that would make this week feel good.',status:'backlog',priority:'medium',due:'',created:1},
+    {id:'a2',title:'Book dentist appointment',notes:'Find a slot for next month.',status:'backlog',priority:'low',due:'',created:2},
+    {id:'a3',title:'Finish reading — The Creative Act',notes:'A few chapters left. Make a little time to read.',status:'backlog',priority:'none',due:'',created:3},
+    {id:'a4',title:'Draft project proposal',notes:'Get a first pass down; it doesn’t need to be perfect.',status:'progress',priority:'high',due:'',created:4},
+    {id:'a5',title:'Go for a run',notes:'Even a short one counts.',status:'progress',priority:'medium',due:'',created:5},
+    {id:'a6',title:'Sort out summer trip ideas',notes:'Save a few places that look interesting.',status:'review',priority:'low',due:'',created:6},
+    {id:'a7',title:'Clear the kitchen counter',notes:'',status:'done',priority:'none',due:'',created:7}
+  ];
+  const key='dayboard-tasks-v1'; let tasks;
+  try { tasks=JSON.parse(localStorage.getItem(key)) ?? seed; if(!Array.isArray(tasks)) tasks=seed; } catch { tasks=seed; }
+  const board=document.querySelector('#board'), dialog=document.querySelector('#taskDialog'), form=document.querySelector('#taskForm');
+  const escapeHtml=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+  let filter='all', query='', dragged=null, toastTimer;
+  const save=()=>{try{localStorage.setItem(key,JSON.stringify(tasks))}catch{notify('Could not save — browser storage is full.')}};
+  const dateLabel=date=>{const d=new Date(date+'T12:00:00'), today=new Date();today.setHours(0,0,0,0);const day=new Date(d);day.setHours(0,0,0,0);const diff=Math.round((day-today)/86400000);return diff===0?'Today':diff===1?'Tomorrow':diff<0?`${Math.abs(diff)}d overdue`:d.toLocaleDateString(undefined,{month:'short',day:'numeric'})};
+  const render=()=>{
+    const term=query.toLowerCase(); const shown=tasks.filter(t=>{const match=!term||`${t.title} ${t.notes}`.toLowerCase().includes(term);const f=filter==='all'||(filter==='high'&&t.priority==='high')||(filter==='due'&&t.due&&t.status!=='done'&&new Date(t.due+'T23:59:59')<=Date.now()+7*86400000);return match&&f;});
+    document.querySelector('#allCount').textContent=tasks.filter(t=>t.status!=='done').length;
+    board.innerHTML=columns.map(col=>{const items=shown.filter(t=>t.status===col.id).sort((a,b)=>(a.created||0)-(b.created||0));return `<section class="column" data-column="${col.id}"><div class="column-head"><div class="col-title"><i class="dot"></i>${col.name}<span class="count">${items.length}</span></div><button class="add-small" data-add="${col.id}" aria-label="Add task to ${col.name}" title="Add task">＋</button></div><div class="cards" data-drop="${col.id}">${items.length?items.map(cardHtml).join(''):`<div class="empty">${term||filter!=='all'?'No matching tasks':'Nothing here yet'}</div>`}</div></section>`}).join('');
+  };
+  function cardHtml(t){const due=t.due?dateLabel(t.due):'';const cls=t.status==='done'?'completed':'';const dueCls=t.status==='done'?'done':t.due&&new Date(t.due+'T23:59:59')<Date.now()?'overdue':t.due&&new Date(t.due+'T00:00:00')-Date.now()<86400000?'soon':'';return `<article class="card ${cls}" draggable="true" data-id="${escapeHtml(t.id)}"><div class="card-top"><span class="tag ${t.priority}">${t.priority==='none'?'NO PRIORITY':t.priority.toUpperCase()}</span><button class="card-menu" data-edit="${escapeHtml(t.id)}" aria-label="Edit ${escapeHtml(t.title)}">···</button></div><h3>${escapeHtml(t.title)}</h3>${t.notes?`<p>${escapeHtml(t.notes)}</p>`:''}<div class="card-foot"><span class="due ${dueCls}">${due?`◷ ${due}`:''}</span><button class="check" data-complete="${escapeHtml(t.id)}" aria-label="${t.status==='done'?'Reopen':'Mark complete'}">${t.status==='done'?'✓':''}</button></div></article>`}
+  function openTask(task=null,status='backlog'){form.reset();document.querySelector('#taskId').value=task?.id||'';document.querySelector('#dialogTitle').textContent=task?'Edit task':'Add a task';document.querySelector('#taskName').value=task?.title||'';document.querySelector('#taskNotes').value=task?.notes||'';document.querySelector('#taskStatus').innerHTML=columns.map(c=>`<option value="${c.id}">${c.name}</option>`).join('');document.querySelector('#taskStatus').value=task?.status||status;document.querySelector('#taskPriority').value=task?.priority||'none';document.querySelector('#taskDue').value=task?.due||'';document.querySelector('#deleteTask').classList.toggle('hidden',!task);dialog.showModal();document.querySelector('#taskName').focus()}
+  function notify(message){const el=document.querySelector('#toast');el.textContent=message;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200)}
+  document.querySelector('#today').textContent=new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'}).toUpperCase();
+  document.querySelector('#taskStatus').innerHTML=columns.map(c=>`<option value="${c.id}">${c.name}</option>`).join('');
+  render();
+  document.querySelector('#addTask').onclick=()=>openTask();
+  document.querySelector('#closeDialog').onclick=document.querySelector('#cancelDialog').onclick=()=>dialog.close();
+  form.onsubmit=e=>{e.preventDefault();const id=document.querySelector('#taskId').value, old=tasks.find(t=>t.id===id);const task={id:id||crypto.randomUUID(),title:document.querySelector('#taskName').value.trim(),notes:document.querySelector('#taskNotes').value.trim(),status:document.querySelector('#taskStatus').value,priority:document.querySelector('#taskPriority').value,due:document.querySelector('#taskDue').value,created:old?.created||Date.now()};if(!task.title)return;if(old)tasks[tasks.indexOf(old)]=task;else tasks.push(task);save();render();dialog.close();notify(old?'Task updated':'Task added')};
+  board.addEventListener('click',e=>{const add=e.target.closest('[data-add]'),edit=e.target.closest('[data-edit]'),check=e.target.closest('[data-complete]');if(add)openTask(null,add.dataset.add);if(edit)openTask(tasks.find(t=>t.id===edit.dataset.edit));if(check){const t=tasks.find(t=>t.id===check.dataset.complete);t.status=t.status==='done'?'backlog':'done';save();render()}});
+  document.querySelector('#deleteTask').onclick=()=>{const id=document.querySelector('#taskId').value;tasks=tasks.filter(t=>t.id!==id);save();render();dialog.close();notify('Task deleted')};
+  board.addEventListener('dragstart',e=>{const card=e.target.closest('.card');if(card){dragged=card.dataset.id;card.classList.add('dragging');e.dataTransfer.setData('text/plain',dragged);e.dataTransfer.effectAllowed='move'}});
+  board.addEventListener('dragend',e=>{e.target.closest('.card')?.classList.remove('dragging');board.querySelectorAll('.drag-over').forEach(x=>x.classList.remove('drag-over'))});
+  board.addEventListener('dragover',e=>{const drop=e.target.closest('[data-drop]');if(drop){e.preventDefault();drop.classList.add('drag-over')}});
+  board.addEventListener('dragleave',e=>{if(!e.target.closest('[data-drop]')?.contains(e.relatedTarget))e.target.closest('[data-drop]')?.classList.remove('drag-over')});
+  board.addEventListener('drop',e=>{const drop=e.target.closest('[data-drop]');if(!drop)return;e.preventDefault();const t=tasks.find(t=>t.id===(dragged||e.dataTransfer.getData('text/plain')));if(t){t.status=drop.dataset.drop;save();render()}dragged=null});
+  document.querySelector('#search').oninput=e=>{query=e.target.value.trim();render()};
+  document.querySelector('.filters').onclick=e=>{const b=e.target.closest('[data-filter]');if(!b)return;filter=b.dataset.filter;document.querySelectorAll('.filter').forEach(x=>x.classList.toggle('active',x===b));render()};
+  document.querySelector('#clearDone').onclick=()=>{const n=tasks.filter(t=>t.status==='done').length;if(n&&confirm(`Clear ${n} completed task${n===1?'':'s'}?`)){tasks=tasks.filter(t=>t.status!=='done');save();render();notify('Completed tasks cleared')}};
+  document.querySelector('#resetBoard').onclick=()=>{if(confirm('Reset the board to its original sample tasks? This replaces your tasks.')){tasks=structuredClone(seed);save();filter='all';query='';document.querySelector('#search').value='';document.querySelectorAll('.filter').forEach(x=>x.classList.toggle('active',x.dataset.filter==='all'));render();notify('Board reset')}};
+  document.querySelector('#themeButton').onclick=()=>{document.body.classList.toggle('dark');localStorage.setItem('dayboard-dark',document.body.classList.contains('dark')?'1':'0')};if(localStorage.getItem('dayboard-dark')==='1')document.body.classList.add('dark');
+  document.addEventListener('keydown',e=>{if(e.key==='/'&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)&&!dialog.open){e.preventDefault();document.querySelector('#search').focus()}if(e.key==='Escape'&&dialog.open)dialog.close()});
+})();
diff --git a/board/index.html b/board/index.html
new file mode 100644
index 0000000..a54653d
--- /dev/null
+++ b/board/index.html
@@ -0,0 +1,47 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="theme-color" content="#f5f6f8"><title>Dayboard — your work, in view</title>
+  <link rel="stylesheet" href="style.css">
+</head>
+<body>
+  <header class="topbar">
+    <a class="brand" href="#" aria-label="Dayboard home"><span class="brand-mark">d</span><span>dayboard</span></a>
+    <div class="top-actions">
+      <label class="search"><span aria-hidden="true">⌕</span><input id="search" type="search" placeholder="Search tasks…" aria-label="Search tasks"><kbd>/</kbd></label>
+      <button class="icon-button" id="themeButton" title="Toggle dark mode" aria-label="Toggle dark mode">◐</button>
+      <button class="avatar" title="Personal workspace">J</button>
+    </div>
+  </header>
+  <main>
+    <section class="welcome">
+      <div><div class="eyebrow" id="today"></div><h1>Your board<span class="period">.</span></h1><p class="subtitle">A little progress, every day.</p></div>
+      <button class="primary" id="addTask"><span>＋</span> Add task</button>
+    </section>
+    <section class="toolbar" aria-label="Board controls">
+      <div class="filters" role="group" aria-label="Filter by priority">
+        <button class="filter active" data-filter="all">All tasks <span id="allCount">0</span></button>
+        <button class="filter" data-filter="high">High priority</button>
+        <button class="filter" data-filter="due">Due soon</button>
+      </div>
+      <div class="toolbar-right"><span class="saved"><i></i> Saved on this device</span><button class="text-button" id="clearDone">Clear completed</button></div>
+    </section>
+    <section class="board" id="board" aria-label="Kanban board"></section>
+    <footer><span>Make space for what matters.</span><button id="resetBoard" class="text-button">Reset sample board</button></footer>
+  </main>
+  <dialog id="taskDialog">
+    <form id="taskForm">
+      <div class="dialog-head"><div><div class="eyebrow">TASK DETAILS</div><h2 id="dialogTitle">Add a task</h2></div><button type="button" class="close" id="closeDialog" aria-label="Close">×</button></div>
+      <input type="hidden" id="taskId">
+      <label class="field">Task name<input id="taskName" required maxlength="120" placeholder="What needs doing?"></label>
+      <label class="field">Notes <span class="optional">OPTIONAL</span><textarea id="taskNotes" rows="3" maxlength="500" placeholder="Add a little context…"></textarea></label>
+      <div class="form-row"><label class="field">Status<select id="taskStatus"></select></label><label class="field">Priority<select id="taskPriority"><option value="none">No priority</option><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option></select></label></div>
+      <label class="field">Due date <span class="optional">OPTIONAL</span><input id="taskDue" type="date"></label>
+      <div class="dialog-actions"><button type="button" class="danger hidden" id="deleteTask">Delete task</button><span></span><button type="button" class="secondary" id="cancelDialog">Cancel</button><button class="primary" type="submit">Save task</button></div>
+    </form>
+  </dialog>
+  <div id="toast" role="status" aria-live="polite"></div>
+  <script src="app.js"></script>
+</body>
+</html>
