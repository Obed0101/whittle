+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#f6f7f4">
+<title>Daymark — Personal board</title><link rel="stylesheet" href="style.css">
+</head>
+<body>
+<div class="app">
+  <aside class="sidebar">
+    <a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d</span><span>daymark</span></a>
+    <div class="workspace-label">YOUR WORKSPACE</div>
+    <button class="nav-item active" id="boardNav"><span class="nav-icon">▦</span> My board <span class="nav-count" id="totalCount">0</span></button>
+    <div class="side-bottom"><div class="tip"><span class="tip-icon">✳</span><strong>A little progress<br>goes a long way.</strong><p>Keep your focus on what matters today.</p></div><button class="text-btn" id="clearDone">Clear completed tasks</button><div class="side-foot"><span class="avatar">M</span><span><b>My workspace</b><small>Personal board</small></span><span class="dots">···</span></div></div>
+  </aside>
+  <main class="main">
+    <header class="topbar"><div class="breadcrumb">Workspace <span>/</span> <b>My board</b></div><div class="top-actions"><span class="saved-status" id="savedStatus">✓ Saved locally</span><button class="icon-btn" id="themeToggle" title="Toggle color theme" aria-label="Toggle color theme">◐</button><button class="help-btn" id="helpBtn">? <span>Shortcuts</span></button></div></header>
+    <section class="heading"><div><div class="eyebrow" id="todayLabel">YOUR DAY, AT A GLANCE</div><h1>My board<span class="title-dot">.</span></h1><p class="subtitle">A calm place to turn plans into progress.</p></div><button class="primary" id="addTask"><span>＋</span> Add a task <kbd>N</kbd></button></section>
+    <section class="toolbar"><div class="filters" role="tablist" aria-label="Filter tasks"><button class="filter active" data-filter="all">All <span id="allCount">0</span></button><button class="filter" data-filter="today">Today <span id="todayCount">0</span></button><button class="filter" data-filter="upcoming">Upcoming <span id="upcomingCount">0</span></button></div><div class="tools"><label class="search"><span>⌕</span><input id="search" type="search" placeholder="Search tasks..." aria-label="Search tasks"><kbd>/</kbd></label><button class="sort-btn" id="sortBtn" title="Toggle sort order">↕ <span>Priority</span></button></div></section>
+    <section class="board" id="board" aria-label="Kanban board"></section>
+    <footer><span><span class="keyboard-key">N</span> new task <span class="sep">·</span> drag cards to move them</span><span id="taskSummary"></span></footer>
+  </main>
+</div>
+<dialog id="taskDialog"><form id="taskForm"><div class="dialog-head"><div><div class="eyebrow">MAKE IT HAPPEN</div><h2 id="dialogTitle">New task</h2></div><button class="icon-btn close" type="button" aria-label="Close">×</button></div><input type="hidden" id="taskId"><label class="field-label" for="taskName">Task name <em>*</em></label><input class="field" id="taskName" maxlength="120" placeholder="What needs to get done?" required><label class="field-label" for="taskDescription">Notes <span>optional</span></label><textarea class="field" id="taskDescription" rows="3" maxlength="500" placeholder="Add a little more detail..."></textarea><div class="field-row"><div><label class="field-label" for="taskStatus">Column</label><select class="field" id="taskStatus"><option value="todo">To do</option><option value="doing">In progress</option><option value="done">Done</option></select></div><div><label class="field-label" for="taskPriority">Priority</label><select class="field" id="taskPriority"><option value="none">No priority</option><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option></select></div></div><div class="field-row"><div><label class="field-label" for="taskDate">Due date</label><input class="field" id="taskDate" type="date"></div><div><label class="field-label" for="taskTag">Label</label><input class="field" id="taskTag" maxlength="24" placeholder="e.g. Work"></div></div><div class="dialog-actions"><button class="delete-btn" type="button" id="deleteTask">Delete task</button><span class="dialog-spacer"></span><button class="secondary" type="button" id="cancelTask">Cancel</button><button class="primary" type="submit">Save task</button></div></form></dialog>
+<dialog id="helpDialog"><div class="help-content"><button class="icon-btn close-help" aria-label="Close">×</button><div class="eyebrow">QUICK GUIDE</div><h2>Make it yours.</h2><p>Add tasks, set due dates and priorities, then drag them across your board as you go.</p><div class="shortcut"><span>Create a task</span><kbd>N</kbd></div><div class="shortcut"><span>Search tasks</span><kbd>/</kbd></div><div class="shortcut"><span>Close dialog</span><kbd>Esc</kbd></div><p class="privacy-note">Your board is saved in this browser only. Nothing leaves your device.</p></div></dialog>
+<div class="toast" id="toast" role="status"></div><script src="app.js"></script>
+</body></html>
