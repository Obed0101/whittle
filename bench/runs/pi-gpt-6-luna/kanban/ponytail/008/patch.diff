+++ b/board/app.js
@@ -0,0 +1,35 @@
+(() => {
+  const KEY='daymark-board-v1', cols=[['todo','To do'],['doing','In progress'],['done','Done']];
+  const starter=[
+    {id:'a1',title:'Plan the week ahead',description:'Take a few minutes to get clear on what matters most.',status:'todo',priority:'high',date:today(),tag:'Personal'},
+    {id:'a2',title:'Reply to Maya about dinner',description:'Check which evening works best.',status:'todo',priority:'medium',date:today(),tag:'Life admin'},
+    {id:'a3',title:'Book dentist appointment',description:'Find a slot sometime this month.',status:'todo',priority:'low',date:'',tag:'Personal'},
+    {id:'a4',title:'Finish reading chapter 4',description:'Only a few pages left — nearly there.',status:'doing',priority:'low',date:'',tag:'Learning'},
+    {id:'a5',title:'Go for a morning walk',description:'A little fresh air before the day gets busy.',status:'done',priority:'none',date:today(),tag:'Wellbeing'}
+  ];
+  function today(){return new Date().toLocaleDateString('en-CA')}
+  const $=s=>document.querySelector(s), board=$('#board'), dialog=$('#taskDialog'), form=$('#taskForm');
+  let tasks;try{tasks=JSON.parse(localStorage.getItem(KEY))}catch{} if(!Array.isArray(tasks))tasks=starter;
+  let filter='all', query='', prioritySort=false, dragged=null, toastTimer;
+  const escape=s=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+  function persist(){localStorage.setItem(KEY,JSON.stringify(tasks));$('#savedStatus').textContent='✓ Saved locally';render()}
+  function dueLabel(date){if(!date)return '';const d=new Date(date+'T00:00:00'), diff=Math.round((d-new Date(new Date().toDateString()))/86400000);return diff===0?'Today':diff===1?'Tomorrow':diff<0?`${Math.abs(diff)}d overdue`:d.toLocaleDateString(undefined,{month:'short',day:'numeric'})}
+  function visible(t){if(query&&!`${t.title} ${t.description} ${t.tag}`.toLowerCase().includes(query))return false;if(filter==='today')return t.date===today()&&t.status!=='done';if(filter==='upcoming')return t.date>today()&&t.status!=='done';return true}
+  function render(){const active=tasks.filter(t=>t.status!=='done');$('#totalCount').textContent=active.length;$('#allCount').textContent=tasks.length;$('#todayCount').textContent=active.filter(t=>t.date===today()).length;$('#upcomingCount').textContent=active.filter(t=>t.date>today()).length;$('#taskSummary').textContent=`${active.length} task${active.length===1?'':'s'} in progress`;
+    board.innerHTML=cols.map(([key,label])=>{let list=tasks.filter(t=>t.status===key&&visible(t));if(prioritySort){const rank={high:0,medium:1,low:2,none:3};list.sort((a,b)=>rank[a.priority]-rank[b.priority])}return `<section class="column ${key}" data-column="${key}"><div class="column-head"><span class="column-dot"></span><span class="column-title">${label}</span><span class="column-count">${tasks.filter(t=>t.status===key).length}</span><button class="column-add" data-new="${key}" aria-label="Add to ${label}">+</button></div><div class="dropzone" data-drop="${key}">${list.length?list.map(card).join(''):`<div class="empty"><b>${query||filter!=='all'?'Nothing here just yet':'A clear space to begin'}</b>${query||filter!=='all'?'Try another filter or search.':`<button data-new="${key}">+ Add a task</button>`}</div>`}</div></section>`}).join('');
+    board.querySelectorAll('[data-new]').forEach(b=>b.onclick=()=>openTask(null,b.dataset.new));board.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>openTask(b.dataset.edit));board.querySelectorAll('[data-delete]').forEach(b=>b.onclick=()=>remove(b.dataset.delete));
+    board.querySelectorAll('.card').forEach(c=>{c.addEventListener('dragstart',e=>{dragged=c.dataset.id;c.classList.add('dragging');e.dataTransfer.setData('text/plain',dragged)});c.addEventListener('dragend',()=>c.classList.remove('dragging'));c.addEventListener('dblclick',()=>openTask(c.dataset.id))});
+    board.querySelectorAll('.dropzone').forEach(z=>{z.addEventListener('dragover',e=>{e.preventDefault();z.classList.add('drag-over')});z.addEventListener('dragleave',()=>z.classList.remove('drag-over'));z.addEventListener('drop',e=>{e.preventDefault();z.classList.remove('drag-over');const t=tasks.find(x=>x.id===(dragged||e.dataTransfer.getData('text/plain')));if(t){t.status=z.dataset.drop;persist();announce('Task moved')}})});
+  }
+  function card(t){const due=dueLabel(t.date), cls=t.date&&t.date<today()&&t.status!=='done'?'overdue':t.date===today()?'soon':'';return `<article class="card" draggable="true" data-id="${escape(t.id)}"><div class="card-top"><span class="priority ${escape(t.priority)}">${t.priority==='none'?'No priority':escape(t.priority)}</span><button class="more" data-edit="${escape(t.id)}" aria-label="Edit ${escape(t.title)}">···</button></div><div class="card-title">${escape(t.title)}</div>${t.description?`<p class="card-description">${escape(t.description)}</p>`:''}<div class="card-footer">${t.tag?`<span class="tag">${escape(t.tag)}</span>`:''}${due?`<span class="due ${cls}">${cls==='overdue'?'◷ ':''}${due}</span>`:''}<span class="card-actions"><button class="mini-action" data-edit="${escape(t.id)}" aria-label="Edit task">Edit</button></span></div></article>`}
+  function openTask(id,status='todo'){form.reset();const t=tasks.find(x=>x.id===id);$('#taskId').value=t?.id||'';$('#dialogTitle').textContent=t?'Edit task':'New task';$('#taskName').value=t?.title||'';$('#taskDescription').value=t?.description||'';$('#taskStatus').value=t?.status||status;$('#taskPriority').value=t?.priority||'none';$('#taskDate').value=t?.date||'';$('#taskTag').value=t?.tag||'';$('#deleteTask').hidden=!t;dialog.showModal();setTimeout(()=>$('#taskName').focus(),50)}
+  function remove(id){if(!confirm('Delete this task?'))return;tasks=tasks.filter(t=>t.id!==id);persist();dialog.close();announce('Task deleted')}
+  function announce(text){const el=$('#toast');el.textContent=text;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200)}
+  form.addEventListener('submit',e=>{e.preventDefault();const id=$('#taskId').value,data={id:id||crypto.randomUUID(),title:$('#taskName').value.trim(),description:$('#taskDescription').value.trim(),status:$('#taskStatus').value,priority:$('#taskPriority').value,date:$('#taskDate').value,tag:$('#taskTag').value.trim()};if(!data.title)return;if(id)tasks[tasks.findIndex(t=>t.id===id)]=data;else tasks.unshift(data);persist();dialog.close();announce(id?'Task updated':'Task added')});
+  $('#deleteTask').onclick=()=>remove($('#taskId').value);$('#cancelTask').onclick=()=>dialog.close();$('.close').onclick=()=>dialog.close();$('.close-help').onclick=()=>$('#helpDialog').close();$('#addTask').onclick=()=>openTask();$('#helpBtn').onclick=()=>$('#helpDialog').showModal();
+  document.querySelectorAll('.filter').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelectorAll('.filter').forEach(x=>x.classList.toggle('active',x===b));render()});$('#search').oninput=e=>{query=e.target.value.trim().toLowerCase();render()};$('#sortBtn').onclick=()=>{prioritySort=!prioritySort;$('#sortBtn').querySelector('span').textContent=prioritySort?'Date':'Priority';render()};
+  $('#clearDone').onclick=()=>{const n=tasks.filter(t=>t.status==='done').length;if(!n){announce('No completed tasks to clear');return}if(confirm(`Clear ${n} completed task${n===1?'':'s'}?`)){tasks=tasks.filter(t=>t.status!=='done');persist();announce('Completed tasks cleared')}};
+  $('#themeToggle').onclick=()=>{document.body.classList.toggle('dark');localStorage.setItem('daymark-dark',document.body.classList.contains('dark'))};if(localStorage.getItem('daymark-dark')==='true')document.body.classList.add('dark');
+  document.querySelectorAll('dialog').forEach(d=>d.addEventListener('click',e=>{if(e.target===d)d.close()}));document.addEventListener('keydown',e=>{if(e.key==='Escape')return;if(e.target.matches('input,textarea,select'))return;if(e.key.toLowerCase()==='n'){e.preventDefault();openTask()}if(e.key==='/'){e.preventDefault();$('#search').focus()}});
+  $('#todayLabel').textContent=new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'}).toUpperCase();render();
+})();
