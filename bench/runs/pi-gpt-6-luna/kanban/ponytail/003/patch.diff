+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f6f5f1">
+<title>Daymark — Personal Kanban</title><link rel="stylesheet" href="style.css">
+</head>
+<body>
+<header class="topbar"><a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">D</span><span>daymark</span></a><div class="top-actions"><span class="today" id="today"></span><button class="icon-button" id="exportBtn" title="Export board" aria-label="Export board">⇩</button><button class="icon-button" id="importBtn" title="Import board" aria-label="Import board">⇧</button><input type="file" id="importFile" accept="application/json" hidden><button class="avatar" title="Your personal board">Y</button></div></header>
+<main class="app"><section class="intro"><div><p class="eyebrow">YOUR SPACE, YOUR PACE</p><h1>A little progress<br>goes a long way<span>.</span></h1><p class="subtitle">Keep the important things moving.</p></div><div class="progress-card"><div class="progress-head"><span>Weekly momentum</span><strong id="momentum">0%</strong></div><div class="progress-track"><span id="progressBar"></span></div><small id="progressCopy">Complete a task to start your streak.</small></div></section>
+<section class="toolbar"><div class="board-label"><span class="status-dot"></span><strong>My board</strong><span class="task-count" id="taskCount">0 tasks</span></div><div class="tools"><label class="search"><span>⌕</span><input id="search" type="search" placeholder="Find a task…" aria-label="Find a task"></label><select id="filter" aria-label="Filter tasks"><option value="all">All tasks</option><option value="today">Due today</option><option value="overdue">Overdue</option><option value="high">High priority</option></select><button class="primary-button" id="addTask">＋ <span>New task</span></button></div></section>
+<section class="board" id="board" aria-label="Kanban board"></section>
+<footer><span>Small steps count. Keep going.</span><button id="clearDone" class="text-button">Clear completed</button></footer></main>
+<dialog id="taskDialog"><form method="dialog" id="taskForm"><div class="dialog-head"><div><p class="eyebrow">TASK DETAILS</p><h2 id="dialogTitle">A new task</h2></div><button class="close-button" value="cancel" aria-label="Close">×</button></div><input type="hidden" id="taskId"><label class="field">Task name<input id="titleInput" maxlength="120" required placeholder="What needs doing?"></label><label class="field">A few details <span class="optional">(optional)</span><textarea id="notesInput" rows="3" maxlength="1000" placeholder="Add a note or next step…"></textarea></label><div class="field-row"><label class="field">Column<select id="statusInput"><option value="todo">To do</option><option value="doing">In progress</option><option value="done">Done</option></select></label><label class="field">Priority<select id="priorityInput"><option value="low">Low</option><option value="normal">Normal</option><option value="high">High</option></select></label></div><div class="field-row"><label class="field">Due date<input id="dueInput" type="date"></label><label class="field">Label<input id="labelInput" maxlength="24" placeholder="e.g. Personal"></label></div><div class="dialog-actions"><button type="button" id="deleteTask" class="delete-button">Delete task</button><button class="primary-button" value="save">Save task</button></div></form></dialog>
+<div id="toast" role="status" aria-live="polite"></div><script src="app.js"></script>
+</body></html>
