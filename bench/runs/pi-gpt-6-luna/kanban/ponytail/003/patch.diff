ckground:white;border:1px solid #e8e7e1;border-radius:8px;padding:13px 13px 11px;box-shadow:0 2px 4px #2b30200a;cursor:grab;transition:box-shadow .15s,transform .15s}.task:hover{box-shadow:var(--shadow);transform:translateY(-1px)}.task.dragging{opacity:.4}.task-top{display:flex;justify-content:space-between;align-items:flex-start}.task-title{font-weight:600;font-size:13px;line-height:1.45;overflow-wrap:anywhere}.more{border:0;background:transparent;color:#9a9e95;cursor:pointer;font-size:16px;line-height:14px;padding:0 1px}.task-notes{color:#858a80;font-size:11px;line-height:1.5;margin:7px 0 0;white-space:pre-wrap;overflow-wrap:anywhere}.task-tags{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-top:12px}.tag{font-size:9px;color:#64765e;background:#eef3ea;border-radius:4px;padding:4px 6px}.priority{font-size:9px;color:#898b80}.priority.high{color:#bc7054}.priority:before{content:'↑';margin-right:3px}.priority.low:before{content:'↓';margin-right:3px}.due{font-size:10px;color:#84887e;margin-left:auto}.due.late{color:#bb654e;font-weight:600}.due.soon{color:#b17a42}.empty{border:1px dashed #d7d6ce;border-radius:7px;color:#9a9c94;text-align:center;padding:28px 8px;font-size:11px}.column.over{background:#e9eee5;border-color:#bacbb5}footer{display:flex;justify-content:space-between;color:#96998f;font-size:11px;margin-top:25px}.text-button{border:0;background:none;color:#82877d;font:11px 'DM Sans';cursor:pointer}.text-button:hover{text-decoration:underline;color:#4f7050}dialog{border:0;border-radius:12px;width:min(480px,calc(100% - 28px));padding:0;box-shadow:0 25px 80px #181d1880;color:var(--ink)}dialog::backdrop{background:#20251f66;backdrop-filter:blur(2px)}#taskForm{padding:27px}.dialog-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:23px}.dialog-head h2{font:700 21px Manrope;margin:0;letter-spacing:-.5px}.dialog-head .eyebrow{margin-bottom:7px}.close-button{border:0;background:transparent;font-size:24px;color:#8a8e84;cursor:pointer;line-height:1}.field{display:flex;flex-direction:column;gap:7px;font-size:11px;font-weight:600;margin-bottom:15px;color:#555d52}.field input,.field textarea,.field select{font:13px 'DM Sans';color:var(--ink);border:1px solid #e4e3dc;border-radius:6px;padding:10px;outline-color:#9eb49a;width:100%;resize:vertical}.field input,.field select{height:39px}.field-row{display:grid;grid-template-columns:1fr 1fr;gap:13px}.optional{font-weight:400;color:#999}.dialog-actions{display:flex;justify-content:space-between;align-items:center;margin-top:9px}.delete-button{border:0;background:none;color:#b05c4c;font:12px 'DM Sans';cursor:pointer;padding:8px}.delete-button:hover{text-decoration:underline}#toast{position:fixed;bottom:24px;left:50%;transform:translate(-50%,12px);background:#26332a;color:white;padding:10px 16px;border-radius:7px;font-size:12px;opacity:0;pointer-events:none;transition:.2s}#toast.show{opacity:1;transform:translate(-50%,0)}
