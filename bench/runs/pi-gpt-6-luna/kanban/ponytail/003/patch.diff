diff --git a/board/app.js b/board/app.js
new file mode 100644
index 0000000..9028b1f
--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,16 @@
+(() => {
+const KEY='daymark-board-v1', statuses=['todo','doing','done'], names={todo:'To do',doing:'In progress',done:'Done'};
+const seed=[{id:'a1',title:'Plan the week ahead',notes:'Pick three things that would make this week feel good.',status:'todo',priority:'normal',label:'Planning',due:'',created:Date.now()},{id:'a2',title:'Get outside for a walk',notes:'A short reset between work blocks.',status:'todo',priority:'low',label:'Wellbeing',due:'',created:Date.now()},{id:'a3',title:'Sort out that appointment',notes:'Call and find a time that works.',status:'doing',priority:'high',label:'Personal',due:'',created:Date.now()}];
+let tasks;try{tasks=JSON.parse(localStorage.getItem(KEY))||seed;if(!Array.isArray(tasks))tasks=seed}catch{tasks=seed}
+const $=id=>document.getElementById(id), board=$('board'), dialog=$('taskDialog'), form=$('taskForm');let toastTimer;
+function save(){localStorage.setItem(KEY,JSON.stringify(tasks));render()}
+function dateText(value){if(!value)return '';const d=new Date(value+'T00:00:00');return d.toLocaleDateString(undefined,{month:'short',day:'numeric'})}
+function matches(t){const q=$('search').value.trim().toLowerCase(),f=$('filter').value,today=new Date().toISOString().slice(0,10);return (!q||[t.title,t.notes,t.label].join(' ').toLowerCase().includes(q))&&(f==='all'||(f==='today'&&t.due===today)||(f==='overdue'&&t.due&&t.due<today&&t.status!=='done')||(f==='high'&&t.priority==='high'))}
+function render(){board.innerHTML='';statuses.forEach(status=>{const items=tasks.filter(t=>t.status===status&&matches(t));const col=document.createElement('section');col.className='column';col.dataset.status=status;col.innerHTML=`<div class="column-head"><div class="column-name"><i class="column-icon"></i>${names[status]} <span class="count">${items.length}</span></div><button class="add-inline" aria-label="Add to ${names[status]}">＋</button></div><div class="cards"></div>`;col.querySelector('.add-inline').onclick=()=>openTask(null,status);const cards=col.querySelector('.cards');if(!items.length){const e=document.createElement('div');e.className='empty';e.textContent=$('search').value||$('filter').value!=='all'?'No matching tasks':'Nothing here yet';cards.append(e)}items.forEach(t=>cards.append(makeCard(t)));col.ondragover=e=>{e.preventDefault();col.classList.add('over')};col.ondragleave=e=>{if(!col.contains(e.relatedTarget))col.classList.remove('over')};col.ondrop=e=>{e.preventDefault();col.classList.remove('over');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=status;save()}};board.append(col)});$('taskCount').textContent=`${tasks.length} task${tasks.length===1?'':'s'}`;const done=tasks.filter(t=>t.status==='done').length,pct=tasks.length?Math.round(done/tasks.length*100):0;$('momentum').textContent=pct+'%';$('progressBar').style.width=pct+'%';$('progressCopy').textContent=done?`${done} of ${tasks.length} tasks complete. Nice work.`:'Complete a task to start your streak.'}
+function makeCard(t){const el=document.createElement('article');el.className='task';el.draggable=true;el.tabIndex=0;el.setAttribute('aria-label',t.title);el.innerHTML=`<div class="task-top"><span class="task-title"></span><button class="more" aria-label="Edit task">···</button></div>${t.notes?'<p class="task-notes"></p>':''}<div class="task-tags"></div>`;el.querySelector('.task-title').textContent=t.title;if(t.notes)el.querySelector('.task-notes').textContent=t.notes;const tags=el.querySelector('.task-tags');if(t.label){const label=document.createElement('span');label.className='tag';label.textContent=t.label;tags.append(label)}if(t.priority!=='normal'){const p=document.createElement('span');p.className=`priority ${t.priority}`;p.textContent=t.priority==='high'?'High':'Low';tags.append(p)}if(t.due){const d=document.createElement('span'),today=new Date().toISOString().slice(0,10);d.className='due'+(t.due<today&&t.status!=='done'?' late':t.due===today?' soon':'');d.textContent=dateText(t.due);tags.append(d)}el.querySelector('.more').onclick=e=>{e.stopPropagation();openTask(t.id)};el.onclick=()=>openTask(t.id);el.onkeydown=e=>{if(e.key==='Enter')openTask(t.id)};el.ondragstart=e=>{e.dataTransfer.setData('text/plain',t.id);setTimeout(()=>el.classList.add('dragging'),0)};el.ondragend=()=>el.classList.remove('dragging');return el}
+function openTask(id,status='todo'){const t=tasks.find(x=>x.id===id);$('taskId').value=t?.id||'';$('titleInput').value=t?.title||'';$('notesInput').value=t?.notes||'';$('statusInput').value=t?.status||status;$('priorityInput').value=t?.priority||'normal';$('dueInput').value=t?.due||'';$('labelInput').value=t?.label||'';$('dialogTitle').textContent=t?'Edit task':'A new task';$('deleteTask').hidden=!t;dialog.showModal();$('titleInput').focus()}
+form.onsubmit=e=>{if(e.submitter?.value!=='save')return;e.preventDefault();const id=$('taskId').value,data={title:$('titleInput').value.trim(),notes:$('notesInput').value.trim(),status:$('statusInput').value,priority:$('priorityInput').value,due:$('dueInput').value,label:$('labelInput').value.trim()};if(!data.title){$('titleInput').focus();return}if(id)Object.assign(tasks.find(t=>t.id===id),data);else tasks.unshift({id:crypto.randomUUID(),...data,created:Date.now()});dialog.close();save();notify(id?'Task updated':'Task added')};
+$('addTask').onclick=()=>openTask();$('deleteTask').onclick=()=>{const id=$('taskId').value;tasks=tasks.filter(t=>t.id!==id);dialog.close();save();notify('Task deleted')};$('search').oninput=render;$('filter').onchange=render;$('clearDone').onclick=()=>{const n=tasks.filter(t=>t.status==='done').length;if(!n)return notify('No completed tasks to clear');if(confirm(`Clear ${n} completed task${n===1?'':'s'}?`)){tasks=tasks.filter(t=>t.status!=='done');save();notify('Completed tasks cleared')}};
+$('exportBtn').onclick=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(tasks,null,2)],{type:'application/json'}));a.download='daymark-board.json';a.click();URL.revokeObjectURL(a.href)};$('importBtn').onclick=()=>$('importFile').click();$('importFile').onchange=async e=>{try{const data=JSON.parse(await e.target.files[0].text());if(!Array.isArray(data)||data.some(t=>!t.title||!statuses.includes(t.status)))throw Error();if(confirm('Replace your current board with this backup?')){tasks=data;save();notify('Board imported')}}catch{notify('That file is not a valid board backup')}e.target.value=''};
+function notify(text){const el=$('toast');el.textContent=text;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200)}$('today').textContent=new Date().toLocaleDateString(undefined,{weekday:'short',month:'short',day:'numeric'});render();
+})();
