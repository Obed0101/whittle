'↗':'↓'}</span>${t.due?`<span class="due ${t.due<new Date().toISOString().slice(0,10)&&t.column!=='done'?'overdue':''}">◷ ${new Date(t.due+'T00:00:00').toLocaleDateString(undefined,{month:'short',day:'numeric'})}</span>`:''}</div>`;el.querySelector('.more').onclick=()=>openTask(t.id);el.onclick=e=>{if(e.target.closest('.more'))return;openTask(t.id)};el.ondragstart=()=>{dragId=t.id;el.classList.add('dragging')};el.ondragend=()=>{dragId=null;el.classList.remove('dragging')};return el}
+function openTask(id,column='todo'){const t=state.tasks.find(x=>x.id===id);const root=document.querySelector('#modalRoot');root.innerHTML=`<div class="modal-backdrop"><form class="modal"><div class="modal-head"><h2>${t?'Edit task':'New task'}</h2><button type="button" class="close" aria-label="Close">×</button></div><div class="field"><label for="title">Task</label><input id="title" required maxlength="140" value="${esc(t?.title||'')}" placeholder="What needs doing?"></div><div class="field"><label for="description">Notes</label><textarea id="description" maxlength="2000" placeholder="Add details, links, or a next step…">${esc(t?.description||'')}</textarea></div><div class="form-row"><div class="field"><label for="column">Column</label><select id="column">${state.columns.map(c=>`<option value="${esc(c.id)}" ${(t?.column||column)===c.id?'selected':''}>${esc(c.name)}</option>`).join('')}</select></div><div class="field"><label for="priority">Priority</label><select id="priority">${['Low','Medium','High'].map(p=>`<option ${t?.priority===p?'selected':''}>${p}</option>`).join('')}</select></div></div><div class="form-row"><div class="field"><label for="due">Due date</label><input id="due" type="date" value="${esc(t?.due||'')}"></div><div class="field"><label for="tags">Labels</label><input id="tags" maxlength="160" value="${esc((t?.tags||[]).join(', '))}" placeholder="Work, Personal"></div></div><div class="modal-actions">${t?'<button type="button" class="delete-btn">Delete task</button>':''}<button type="button" class="button close-action">Cancel</button><button class="button primary" type="submit">Save task</button></div></form></div>`;const modal=root.querySelector('.modal');root.querySelector('.close').onclick=()=>root.innerHTML='';root.querySelector('.close-action').onclick=()=>root.innerHTML='';root.querySelector('.modal-backdrop').onclick=e=>{if(e.target.classList.contains('modal-backdrop'))root.innerHTML=''};modal.onsubmit=e=>{e.preventDefault();const data={title:modal.title.value.trim(),description:modal.description.value.trim(),column:modal.column.value,priority:modal.priority.value,due:modal.due.value,tags:modal.tags.value.split(',').map(x=>x.trim()).filter(Boolean)};if(t)Object.assign(t,data);else state.tasks.unshift({id:uid(),...data,created:Date.now()});save();root.innerHTML='';render()};const del=root.querySelector('.delete-btn');if(del)del.onclick=()=>{if(confirm('Delete this task?')){state.tasks=state.tasks.filter(x=>x.id!==id);save();root.innerHTML='';render()}};modal.title.focus()}
+document.querySelector('#newTask').onclick=()=>openTask();search.oninput=render;priorityFilter.onchange=render;sortSelect.onchange=render;document.querySelector('#clearDone').onclick=()=>{const done=state.tasks.filter(t=>t.column==='done').length;if(done&&confirm(`Delete ${done} completed task${done===1?'':'s'}?`)){state.tasks=state.tasks.filter(t=>t.column!=='done');save();render()}};document.querySelector('#today').textContent=new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'});document.querySelector('#exportBtn').onclick=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(state,null,2)],{type:'application/json'}));a.download='monday-board.json';a.click();URL.revokeObjectURL(a.href)};document.querySelector('#importBtn').onclick=()=>document.querySelector('#fileInput').click();document.querySelector('#fileInput').onchange=async e=>{try{const data=JSON.parse(await e.target.files[0].text());if(!Array.isArray(data.columns)||!Array.isArray(data.tasks))throw 0;state=data;save();render();alert('Board restored.')}catch{alert('That file is not a valid board backup.')}e.target.value=''};document.querySelector('#resetBtn').onclick=()=>{if(confirm('Replace your current board with the sample board?')){localStorage.removeItem(KEY);location.reload()}};document.onkeydown=e=>{if((e.metaKey||e.ctrlKey)&&e.key==='Enter'){e.preventDefault();openTask()}if(e.key==='Escape')document.querySelector('#modalRoot').innerHTML=''};render();
+})();
