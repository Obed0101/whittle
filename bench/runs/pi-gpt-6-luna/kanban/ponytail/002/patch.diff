;padding:0 16px}.wrap{padding:27px 16px 35px}.greeting{align-items:flex-start}.greeting h1{font-size:26px}.date{display:none}.toolbar{flex-wrap:wrap}.search{max-width:none;flex-basis:100%}.toolbar-spacer{display:none}.board{grid-template-columns:1fr;gap:20px}.cards{min-height:40px}.head-actions .export-label{display:none}.mobile-add{display:inline-block}.footer-note{margin-top:18px}}
