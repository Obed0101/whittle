+(()=>{'use strict';const KEY='monday-kanban-v1', defaults=[{id:'todo',name:'To do'},{id:'doing',name:'In progress'},{id:'waiting',name:'Up next'},{id:'done',name:'Done'}];const samples=[['Plan the week ahead','Choose the three things that would make this week feel good.','todo','Medium','2026-04-02',['Planning']],['Finish reading The Creative Act','A few pages before bed counts.','todo','Low','',['Personal']],['Book a weekend away','Find somewhere quiet with a good walking trail.','todo','Low','2026-04-10',['Life admin']],['Send the proposal','Polish the final numbers and send to Maya.','doing','High','2026-04-01',['Work','Focus']],['Morning movement','Keep the 20-minute walk streak going.','doing','Medium','',['Health']],['Sort out the hallway','Donate the things we don’t use anymore.','waiting','Low','','[Home]'],['Set up automatic savings','Review the monthly transfer and update the amount.','waiting','Medium','2026-04-12',['Money']],['Get through Monday','One thing at a time. You did it.','done','Low','',['Personal']]];let state;try{state=JSON.parse(localStorage.getItem(KEY))}catch{}if(!state||!Array.isArray(state.tasks)||!Array.isArray(state.columns))state={columns:defaults,tasks:samples.map((x,i)=>({id:uid(),title:x[0],description:x[1],column:x[2],priority:x[3],due:x[4],tags:x[5],created:Date.now()-i*1000}))};function uid(){return Math.random().toString(36).slice(2,10)}function save(){localStorage.setItem(KEY,JSON.stringify(state))}const board=document.querySelector('#board'),search=document.querySelector('#search'),priorityFilter=document.querySelector('#priorityFilter'),sortSelect=document.querySelector('#sortSelect');let dragId=null;function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function render(){board.innerHTML='';const q=search.value.toLowerCase();state.columns.forEach(col=>{const tasks=state.tasks.filter(t=>t.column===col.id&&(!q||`${t.title} ${t.description} ${(t.tags||[]).jo