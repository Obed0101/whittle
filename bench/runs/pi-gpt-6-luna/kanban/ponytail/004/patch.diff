+<style>
+:root{--bg:#f5f5f2;--panel:#fff;--ink:#20231f;--muted:#858981;--line:#e8e9e4;--green:#52765a;--pale:#eaf0e8;--shadow:0 8px 28px #20231f0c}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,textarea,select{font:inherit}button{cursor:pointer;color:inherit}.app{max-width:1500px;margin:auto;padding:28px 38px 40px}.top{display:flex;align-items:center;justify-content:space-between;margin-bottom:38px}.brand{display:flex;gap:12px;align-items:center}.logo{width:36px;height:36px;border-radius:11px;background:#344c39;color:white;display:grid;place-items:center;font-weight:700;font-size:18px}.brand h1{font-size:16px;margin:0;letter-spacing:-.3px}.brand small{display:block;color:var(--muted);font-size:11px;margin-top:1px}.top-actions{display:flex;gap:9px;align-items:center}.icon-btn,.quiet{border:1px solid var(--line);background:white;border-radius:9px;padding:9px 12px}.icon-btn{width:38px;height:38px;padding:0;font-size:16px}.quiet:hover,.icon-btn:hover{background:#f8f9f6}.primary{border:0;border-radius:9px;background:#344c39;color:white;padding:10px 15px;font-weight:600}.primary:hover{background:#26392a}.heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:22px}.heading h2{font-size:29px;letter-spacing:-1.1px;margin:0 0 5px}.heading p{color:var(--muted);margin:0}.date-label{text-align:right;color:var(--muted);font-size:12px}.toolbar{display:flex;align-items:center;gap:10px;margin-bottom:18px}.search{position:relative;flex:1;max-width:350px}.search input{width:100%;padding:10px 12px 10px 36px;border:1px solid var(--line);border-radius:9px;background:white;outline:none}.search:before{content:'⌕';position:absolute;left:13px;top:5px;font-size:22px;color:#92968f}.search input:focus,.field input:focus,.field textarea:focus,.field select:focus{border-color:#9aaf9d;box-shadow:0 0 0 3px #52765a18}.filter{padding:9px 11px;border:1px solid var(--line);border-radius:9px;background:white;color:#5f655d}.summary{margin-left:auto;color:var(--muted);font-size:12px}.board{display:grid;grid-template-columns:repeat(4,minmax(230px,1fr));gap:16px;align-items:start}.column{background:#eeefeb;border-radius:13px;padding:12px;min-height:220px}.col-head{display:flex;align-items:center;justify-content:space-between;padding:3px 3px 12px}.col-title{display:flex;gap:8px;align-items:center;font-weight:650;font-size:13px}.dot{width:8px;height:8px;border-radius:50%;background:#a9ada5}.column[data-status="doing"] .dot{background:#d2a45c}.column[data-status="done"] .dot{background:#6f9b75}.count{font-size:11px;color:var(--muted);background:#e3e5df;border-radius:12px;padding:2px 7px}.add-small{border:0;background:transparent;color:#848980;font-size:20px;line-height:1}.cards{display:grid;gap:9px;min-height:90px}.card{background:white;border:1px solid #e9eae5;border-radius:10px;padding:12px 12px 10px;box-shadow:0 2px 7px #20231f08;cursor:grab;transition:transform .12s,box-shadow .12s}.card:hover{box-shadow:var(--shadow);transform:translateY(-1px)}.card.dragging{opacity:.4}.cards.over{outline:2px dashed #9bad9d;outline-offset:-3px;border-radius:9px}.card-top{display:flex;justify-content:space-between;gap:7px}.card h3{font-size:13px;line-height:1.4;margin:0;font-weight:650;overflow-wrap:anywhere}.more{border:0;background:transparent;color:#93978f;font-size:18px;line-height:14px;padding:0 2px;flex:none}.desc{font-size:12px;color:#7f847c;margin:7px 0 0;white-space:pre-wrap;overflow-wrap:anywhere}.tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:10px}.tag{font-size:10px;border-radius:5px;padding:3px 7px;background:#f0f2ed;color:#64725f}.tag.priority-high{background:#f8e9e5;color:#a55343}.tag.priority-medium{background:#fbf1dc;color:#9b7839}.card-foot{display:flex;justify-content:space-between;align-items:center;margin-top:11px;color:#92968f;font-size:10px}.due{display:flex;gap:4px;align-items:center}.due.late{color:#c55f4e}.due.soon{color:#aa813a}.empty{color:#a0a49d;font-size:12px;text-align:center;padding:26px 5px}.column-add{border:0;background:transparent;text-align:left;width:100%;padding:8px 5px;color:#888d84;font-size:12px}.column-add:hover{color:#344c39}.menu{position:fixed;z-index:5;background:white;border:1px solid var(--line);box-shadow:var(--shadow);border-radius:9px;padding:5px;min-width:135px}.menu button{display:block;width:100%;padding:8px;text-align:left;border:0;background:white;border-radius:5px;font-size:12px}.menu button:hover{background:#f1f3ef}.modal-back{position:fixed;inset:0;background:#18201875;display:grid;place-items:center;padding:18px;z-index:10}.modal{width:min(490px,100%);background:white;border-radius:15px;padding:22px;box-shadow:0 20px 70px #0003}.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.modal-head h2{margin:0;font-size:19px;letter-spacing:-.4px}.close{border:0;background:transparent;color:#777;font-size:22px}.field{display:grid;gap:6px;margin-bottom:13px}.field label{font-size:11px;font-weight:650;color:#656a62}.field input,.field textarea,.field select{border:1px solid var(--line);border-radius:8px;padding:10px;outline:none;width:100%;background:white}.field textarea{resize:vertical;min-height:80px}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.modal-actions{display:flex;justify-content:space-between;align-items:center;margin-top:20px}.modal-actions .right{display:flex;gap:8px}.danger{border:0;background:transparent;color:#b25649;padding:9px}.hint{font-size:11px;color:var(--muted);margin-top:10px}.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:#28372b;color:white;padding:10px 16px;border-radius:9px;box-shadow:var(--shadow);z-index:20;font-size:12px}.hidden{display:none!important}.footer{margin-top:18px;text-align:center;color:#a0a49d;font-size:11px}@media(max-width:1000px){.board{grid-template-columns:repeat(2,minmax(230px,1fr))}.app{padding:24px}}@media(max-width:600px){.app{padding:18px 14px 30px}.top{margin-bottom:28px}.heading{align-items:start}.heading h2{font-size:25px}.date-label{max-width:100px}.toolbar{flex-wrap:wrap}.search{max-width:none;flex-basis:100%}.summary{margin-left:0}.board{grid-template-columns:1fr;gap:11px}.column{min-height:100px}.form-row{grid-template-columns:1fr 1fr}}
+</style>
+</head>
+<body><main class="app">
+<header class="top"><div class="brand"><div class="logo">d</div><div><h1>daymark</h1><small>your personal workspace</small></div></div><div class="top-actions"><button class="icon-btn" id="exportBtn" title="Export board" aria-label="Export board">↧</button><button class="icon-btn" id="importBtn" title="Import board" aria-label="Import board">↥</button><input type="file" id="importFile" accept="application/json" hidden><button class="primary" id="newBtn">＋ New task</button></div></header>
+<section class="heading"><div><h2>My board</h2><p>A little progress, every day.</p></div><div class="date-label" id="today"></div></section>
+<div class="toolbar"><label class="search"><input id="search" type="search" placeholder="Search tasks…" aria-label="Search tasks"></label><select class="filter" id="priorityFilter" aria-label="Filter by priority"><option value="all">All priorities</option><option value="high">High priority</option><option value="medium">Medium priority</option><option value="low">Low priority</option></select><select class="filter" id="sort" aria-label="Sort tasks"><option value="manual">Board order</option><option value="due">Due date</option><option value="priority">Priority</option><option value="newest">Recently added</option></select><span class="summary" id="summary"></span></div>
+<section class="board" id="board" aria-label="Kanban board"></section><div class="footer">Your board is saved automatically on this device.</div></main>
+<div id="modalRoot"></div><div id="menuRoot"></div><div id="toast" class="toast hidden" role="status"></div>
+<script>
+(()=>{'use strict';const KEY='daymark-board-v1', statuses=[['todo','To do'],['doing','In progress'],['done','Done']];let tasks=[],query='',priorityFilter='all',sort='manual',toastTimer;
+const $=s=>document.querySelector(s), esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+function save(){localStorage.setItem(KEY,JSON.stringify(tasks));render()}
+function load(){try{const x=JSON.parse(localStorage.getItem(KEY)||'[]');if(Array.isArray(x))tasks=x.filter(t=>t&&typeof t.id==='string'&&statuses.some(s=>s[0]===t.status)&&typeof t.title==='string')}catch{tasks=[]}}
+function visible(){return tasks.filter(t=>(!query||`${t.title} ${t.description||''} ${t.label||''}`.toLowerCase().includes(query.toLowerCase()))&&(priorityFilter==='all'||t.priority===priorityFilter))}
+function render(){let shown=visible();$('#summary').textContent=`${shown.length} task${shown.length===1?'':'s'} · ${tasks.filter(t=>t.status==='done').length} completed`;$('#board').innerHTML=statuses.map(([key,label])=>{let list=shown.filter(t=>t.status===key);if(sort==='due')list.sort((a,b)=>(a.due||'9999').localeCompare(b.due||'9999'));if(sort==='priority')list.sort((a,b)=>['high','medium','low'].indexOf(a.priority)-['high','medium','low'].indexOf(b.priority));if(sort==='newest')list.sort((a,b)=>b.created-a.created);return `<section class="column" data-status="${key}"><div class="col-head"><div class="col-title"><span class="dot"></span>${label}<span class="count">${list.length}</span></div><button class="add-small" data-add="${key}" aria-label="Add task to ${label}">＋</button></div><div class="cards" data-drop="${key}">${list.length?list.map(cardHTML).join(''):'<div class="empty">Nothing here yet</div>'}</div><button class="column-add" data-add="${key}">＋ Add a task</button></section>`}).join('');}
+function cardHTML(t){let late=t.due&&t.due<new Date().toISOString().slice(0,10)&&t.status!=='done',soon=t.due===new Date().toISOString().slice(0,10);return `<article class="card" draggable="true" data-id="${esc(t.id)}"><div class="card-top"><h3>${esc(t.title)}</h3><button class="more" data-menu="${esc(t.id)}" aria-label="Task options">···</button></div>${t.description?`<p class="desc">${esc(t.description)}</p>`:''}<div class="tags">${t.label?`<span class="tag">${esc(t.label)}</span>`:''}${t.priority!=='low'?`<span class="tag priority-${esc(t.priority)}">${esc(t.priority)} priority</span>`:''}</div><div class="card-foot"><span class="due ${late?'late':soon?'soon':''}">${t.due?`${late?'⚠ ':''}◷ ${new Date(t.due+'T12:00:00').toLocaleDateString(undefined,{month:'short',day:'numeric'})}`:''}</span><span>${t.status==='done'?'✓':''}</span></div></article>`}
+function openForm(task,status='todo'){let t=task||{title:'',description:'',status,priority:'low',label:'',due:'',created:Date.now()};$('#modalRoot').innerHTML=`<div class="modal-back" id="backdrop"><form class="modal" id="taskForm"><div class="modal-head"><h2>${task?'Edit task':'New task'}</h2><button type="button" class="close" data-close aria-label="Close">×</button></div><div class="field"><label for="title">Task</label><input id="title" name="title" maxlength="120" required value="${esc(t.title)}" placeholder="What needs doing?"></div><div class="field"><label for="description">Notes</label><textarea id="description" name="description" maxlength="1500" placeholder="Add a little context…">${esc(t.description)}</textarea></div><div class="form-row"><div class="field"><label for="status">Column</label><select id="status" name="status">${statuses.map(([v,n])=>`<option value="${v}" ${t.status===v?'selected':''}>${n}</option>`).join('')}</select></div><div class="field"><label for="priority">Priority</label><select id="priority" name="priority">${['low','medium','high'].map(v=>`<option value="${v}" ${t.priority===v?'selected':''}>${v[0].toUpperCase()+v.slice(1)}</option>`).join('')}</select></div></div><div class="form-row"><div class="field"><label for="label">Label</label><input id="label" name="label" maxlength="24" value="${esc(t.label)}" placeholder="e.g. Personal"></div><div class="field"><label for="due">Due date</label><input id="due" name="due" type="date" value="${esc(t.due)}"></div></div><div class="modal-actions">${task?'<button type="button" class="danger" id="deleteTask">Delete task</button>':'<span></span>'}<div class="right"><button type="button" class="quiet" data-close>Cancel</button><button class="primary">${task?'Save changes':'Add task'}</button></div></div><p class="hint">Tip: drag cards between columns to update their status.</p></form></div>`;$('#title').focus();$('#taskForm').onsubmit=e=>{e.preventDefault();let f=new FormData(e.currentTarget),data=Object.fromEntries(f);if(task)Object.assign(task,data);else tasks.push({id:crypto.randomUUID(),...data,created:Date.now()});$('#modalRoot').innerHTML='';save();notify(task?'Task updated':'Task added')};$('#deleteTask')?.addEventListener('click',()=>{tasks=tasks.filter(x=>x.id!==task.id);$('#modalRoot').innerHTML='';save();notify('Task deleted')});}
+function notify(message){let el=$('#toast');el.textContent=message;el.classList.remove('hidden');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.add('hidden'),2200)}
+function menu(id,button){$('#menuRoot').innerHTML='';let r=button.getBoundingClientRect(),m=document.createElement('div');m.className='menu';m.style.top=`${Math.min(r.bottom+4,innerHeight-120)}px`;m.style.left=`${Math.min(r.left,innerWidth-150)}px`;m.innerHTML='<button data-action="edit">Edit task</button><button data-action="move">Move to…</button><button data-action="delete">Delete</button>';$('#menuRoot').append(m);m.onclick=e=>{let a=e.target.dataset.action,t=tasks.find(x=>x.id===id);if(!a)return;if(a==='edit')openForm(t);if(a==='delete'){tasks=tasks.filter(x=>x.id!==id);save();notify('Task deleted')}if(a==='move'){let i=statuses.findIndex(s=>s[0]===t.status);t.status=statuses[(i+1)%statuses.length][0];save();notify('Task moved')}m.remove()};setTimeout(()=>document.addEventListener('click',function close(e){if(!m.contains(e.target)){m.remove();document.removeEventListener('click',close)}},{once:true}),0)}
+$('#today').textContent=new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'});$('#newBtn').onclick=()=>openForm();$('#search').oninput=e=>{query=e.target.value;render()};$('#priorityFilter').onchange=e=>{priorityFilter=e.target.value;render()};$('#sort').onchange=e=>{sort=e.target.value;render()};$('#board').addEventListener('click',e=>{let add=e.target.closest('[data-add]'),card=e.target.closest('.card'),opt=e.target.closest('[data-menu]');if(add)openForm(null,add.dataset.add);else if(opt)menu(opt.dataset.menu,opt);else if(card)openForm(tasks.find(t=>t.id===card.dataset.id))});$('#board').addEventListener('dragstart',e=>{let card=e.target.closest('.card');if(card){e.dataTransfer.setData('text/plain',card.dataset.id);e.dataTransfer.effectAllowed='move';card.classList.add('dragging')}});$('#board').addEventListener('dragend',e=>e.target.closest('.card')?.classList.remove('dragging'));$('#board').addEventListener('dragover',e=>{let drop=e.target.closest('[data-drop]');if(drop){e.preventDefault();drop.classList.add('over')}});$('#board').addEventListener('dragleave',e=>{let drop=e.target.closest('[data-drop]');if(drop&&!drop.contains(e.relatedTarget))drop.classList.remove('over')});$('#board').addEventListener('drop',e=>{let drop=e.target.closest('[data-drop]');if(!drop)return;e.preventDefault();drop.classList.remove('over');let t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t&&t.status!==drop.dataset.drop){t.status=drop.dataset.drop;save()}});$('#modalRoot').onclick=e=>{if(e.target.id==='backdrop'||e.target.closest('[data-close]'))$('#modalRoot').innerHTML=''};document.addEventListener('keydown',e=>{if(e.key==='Escape'){$('#modalRoot').innerHTML='';$('#menuRoot').innerHTML=''}if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();$('#search').focus()}});
+$('#exportBtn').onclick=()=>{let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify({version:1,tasks},null,2)],{type:'application/json'}));a.download=`daymark-${new Date().toISOString().slice(0,10)}.json`;a.click();URL.revokeObjectURL(a.href)};$('#importBtn').onclick=()=>$('#importFile').click();$('#importFile').onchange=async e=>{try{let data=JSON.parse(await e.target.files[0].text()),incoming=Array.isArray(data)?data:data.tasks;if(!Array.isArray(incoming)||!incoming.every(t=>t&&typeof t.title==='string'&&statuses.some(s=>s[0]===t.status)))throw Error();if(confirm(`Replace your board with ${incoming.length} imported tasks?`)){tasks=incoming;save();notify('Board imported')}}catch{alert('Could not import this board. Choose a valid Daymark JSON export.')}e.target.value=''};
+load();render();
+})();
+</script></body></html>
