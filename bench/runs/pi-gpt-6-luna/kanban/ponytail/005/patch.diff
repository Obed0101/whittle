+@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
+:root{--ink:#242b28;--muted:#858b86;--line:#e9eae5;--paper:#f7f7f4;--white:#fff;--green:#477b62;--green-dark:#345f4b;--shadow:0 5px 20px #27392c0a}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:14px 'DM Sans',sans-serif}.topbar{height:68px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 max(5vw,28px)}.brand{text-decoration:none;color:var(--ink);font:800 19px Manrope,sans-serif;letter-spacing:-.7px}.brand-mark{color:var(--green);margin-right:8px;font-size:20px}.top-actions{display:flex;align-items:center;gap:12px}.search{height:36px;width:225px;border:1px solid var(--line);background:#fafaf8;border-radius:8px;display:flex;align-items:center;gap:8px;padding:0 9px;color:#929993}.search>span{font-size:20px}.search input{border:0;outline:0;background:transparent;width:100%;font:13px inherit}.search kbd{border:1px solid #e5e6e0;border-radius:4px;padding:1px 5px;font-size:10px}.icon-btn,.avatar{width:34px;height:34px;border:1px solid var(--line);background:#fff;border-radius:8px;color:#5c635e;font-size:17px;cursor:pointer}.avatar{border:0;background:#e9efe9;color:var(--green);font-size:13px;font-weight:700;border-radius:50%}main{max-width:1380px;margin:auto;padding:53px 5vw 22px}.intro{display:flex;align-items:flex-end;justify-content:space-between}.eyebrow{font-size:10px;letter-spacing:1.2px;font-weight:700;color:#818981;margin:0 0 11px}.intro h1{font:700 clamp(28px,3.2vw,39px) Manrope,sans-serif;letter-spacing:-1.5px;margin:0}.intro h1 em{font-style:normal;color:var(--green)}.subhead{color:var(--muted);margin:8px 0 0}.primary{background:var(--green);border:0;border-radius:7px;color:#fff;padding:11px 16px;font:600 13px 'DM Sans',sans-serif;cursor:pointer;box-shadow:0 2px 4px #345f4b22}.primary:hover{background:var(--green-dark)}.toolbar{display:flex;align-items:center;justify-content:space-between;margin:40px 0 16px}.filters{display:flex;gap:5px}.filter{border:0;background:transparent;color:#777f78;padding:8px 12px;border-radius:6px;font:500 12px 'DM Sans',sans-serif;cursor:pointer}.filter.active{background:#e9eee9;color:var(--green-dark);font-weight:700}.board-stats{font-size:11px;color:var(--muted);display:flex;gap:9px;align-items:center}.dot{color:#c1c5bf}.text-btn{border:0;background:none;color:#7d847e;font:inherit;cursor:pointer;padding:5px}.text-btn:hover{color:var(--green)}.board{display:grid;grid-template-columns:repeat(4,minmax(205px,1fr));gap:15px;align-items:start}.column{min-height:300px;background:#f0f1ed;border-radius:9px;padding:13px 11px 11px}.column.dragover{background:#e8eee8;outline:1px dashed #8aa795}.column-head{display:flex;align-items:center;justify-content:space-between;padding:1px 3px 12px}.column-name{font:700 12px Manrope,sans-serif;display:flex;gap:8px;align-items:center}.count{color:#929992;font:500 11px 'DM Sans',sans-serif}.add-column{border:0;background:none;color:#929992;font-size:20px;cursor:pointer;line-height:18px}.cards{display:grid;gap:9px;min-height:30px}.card{background:#fff;border:1px solid #e9eae6;border-radius:7px;padding:12px 12px 10px;box-shadow:var(--shadow);cursor:grab;transition:transform .15s,box-shadow .15s}.card:hover{transform:translateY(-1px);box-shadow:0 7px 18px #27392c12}.card.dragging{opacity:.4}.card-title{font-size:13px;font-weight:600;line-height:1.45;white-space:pre-wrap;overflow-wrap:anywhere}.card-note{font-size:11px;line-height:1.5;color:#828983;margin-top:6px;white-space:pre-wrap;overflow-wrap:anywhere}.card-foot{display:flex;align-items:center;justify-content:space-between;margin-top:12px;min-height:19px}.label{font-size:9px;font-weight:700;letter-spacing:.3px;border-radius:4px;padding:4px 7px;background:#edf1eb;color:#54715c}.label.work{background:#eaf0f6;color:#56718a}.label.personal{background:#f4edf3;color:#88647d}.label.errand{background:#f7f0e4;color:#9a7543}.due{font-size:10px;color:#79817a}.due.overdue{color:#c65b4d;font-weight:700}.due.soon{color:#af7a31}.card-controls{opacity:0;display:flex;gap:3px}.card:hover .card-controls,.card:focus-within .card-controls{opacity:1}.mini{border:0;background:transparent;color:#858c86;cursor:pointer;padding:3px;font-size:12px}.empty{padding:24px 8px;color:#a0a69f;text-align:center;font-size:11px;border:1px dashed #d9ddd6;border-radius:6px}.column-add{width:100%;margin-top:9px;padding:8px;border:0;background:transparent;text-align:left;color:#929992;font:12px 'DM Sans',sans-serif;cursor:pointer}.column-add:hover{color:var(--green)}footer{display:flex;justify-content:space-between;color:#a0a59f;font-size:10px;padding:22px 3px}.saved-dot{color:#72a47f;font-size:8px;margin-left:4px}dialog{border:0;border-radius:12px;padding:0;width:min(480px,calc(100% - 32px));box-shadow:0 24px 80px #17231d33;color:var(--ink)}dialog::backdrop{background:#17231d70;backdrop-filter:blur(2px)}#taskForm{padding:26px}.dialog-head{display:flex;justify-content:space-between;margin-bottom:24px}.dialog-head .eyebrow{margin-bottom:5px}.dialog-head h2{font:700 21px Manrope,sans-serif;margin:0;letter-spacing:-.5px}.close{border:0;background:transparent;font-size:25px;color:#8b928c;cursor:pointer;align-self:flex-start}.field{display:grid;gap:7px;margin-bottom:16px;font-size:12px;font-weight:600}.field input,.field textarea,.field select{width:100%;border:1px solid #e2e5df;border-radius:6px;padding:10px 11px;background:#fff;color:var(--ink);font:13px 'DM Sans',sans-serif;outline:none}.field input:focus,.field textarea:focus,.field select:focus{border-color:#81a38a;box-shadow:0 0 0 3px #477b6217}.field textarea{resize:vertical}.optional{font-weight:400;color:#a0a59f}.field-row{display:grid;grid-template-columns:1fr 1fr;gap:13px}.dialog-actions{display:flex;align-items:center;margin-top:24px;gap:9px}.action-spacer{flex:1}.secondary,.delete-btn{border:1px solid var(--line);background:white;padding:10px 13px;border-radius:6px;color:#616963;font:500 12px 'DM Sans',sans-serif;cursor:pointer}.delete-btn{border:0;color:#c15b50;margin-right:auto;padding-left:0;display:none}#toast{position:fixed;bottom:20px;left:50%;transform:translate(-50%,15px);opacity:0;pointer-events:none;background:#26342b;color:#fff;padding:10px 16px;border-radius:7px;font-size:12px;transition:.2s}#toast.show{opacity:1;transform:translate(-50%,0)}
+@media(max-width:900px){.board{grid-template-columns:repeat(2,minmax(220px,1fr))}.topbar{padding:0 24px}main{padding:42px 24px 18px}}@media(max-width:560px){.topbar{height:58px;padding:0 16px}.search{width:36px;border:0;background:none;padding:0;justify-content:center}.search input,.search kbd{display:none}.search>span{font-size:22px}.top-actions{gap:7px}main{padding:34px 16px 14px}.intro{align-items:flex-start}.intro h1{max-width:300px}.intro .primary{padding:10px 12px;white-space:nowrap}.intro .primary span{display:none}.toolbar{margin-top:31px;align-items:flex-start}.board{grid-template-columns:1fr;gap:11px}.column{min-height:130px}.column-head{padding-bottom:9px}.column-add{padding-bottom:3px}.board-stats{gap:4px}.filters{gap:0}.filter{padding:8px 7px;font-size:11px}footer{padding-top:18px}}
