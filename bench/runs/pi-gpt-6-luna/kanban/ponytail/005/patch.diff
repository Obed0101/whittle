diff --git a/board/app.js b/board/app.js
new file mode 100644
index 0000000..1fb3cee
--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,18 @@
+const KEY='dayboard-v1';
+const initial={columns:[{id:'inbox',name:'Up next'},{id:'doing',name:'In progress'},{id:'waiting',name:'On hold'},{id:'done',name:'Done'}],tasks:[{id:crypto.randomUUID(),title:'Plan the week ahead',notes:'Pick three things that would make this week feel good.',column:'inbox',due:'',label:'Focus',created:Date.now()},{id:crypto.randomUUID(),title:'Take a proper lunch break',notes:'Step away from the desk and get some fresh air.',column:'doing',due:'',label:'Personal',created:Date.now()}]};
+let data;try{data=JSON.parse(localStorage.getItem(KEY))}catch{}if(!data||!Array.isArray(data.columns)||!Array.isArray(data.tasks))data=initial;
+const $=s=>document.querySelector(s), board=$('#board'), dialog=$('#taskDialog'), form=$('#taskForm');let filter='all',query='',toastTimer;
+const save=()=>{localStorage.setItem(KEY,JSON.stringify(data));render()};
+const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+const dateLabel=value=>{if(!value)return '';const [y,m,d]=value.split('-').map(Number),dt=new Date(y,m-1,d),today=new Date();today.setHours(0,0,0,0);const diff=(dt-today)/86400000;return (diff===0?'Today · ':diff===1?'Tomorrow · ':'')+dt.toLocaleDateString(undefined,{month:'short',day:'numeric'})};
+function showToast(text){const el=$('#toast');el.textContent=text;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200)}
+function visible(t){if(query&&!`${t.title} ${t.notes} ${t.label}`.toLowerCase().includes(query))return false;if(filter==='today')return t.due===new Date().toLocaleDateString('en-CA');if(filter==='overdue')return t.due&&t.due<new Date().toLocaleDateString('en-CA')&&t.column!=='done';return true}
+function render(){const shown=data.tasks.filter(visible);$('#taskCount').textContent=`${shown.length} ${shown.length===1?'task':'tasks'}`;board.innerHTML=data.columns.map(c=>{const tasks=shown.filter(t=>t.column===c.id);return `<section class="column" data-column="${esc(c.id)}"><div class="column-head"><div class="column-name">${esc(c.name)} <span class="count">${tasks.length}</span></div><button class="add-column" data-add="${esc(c.id)}" aria-label="Add task to ${esc(c.name)}">＋</button></div><div class="cards">${tasks.length?tasks.map(t=>cardHTML(t)).join(''):`<div class="empty">Nothing here yet</div>`}</div><button class="column-add" data-add="${esc(c.id)}">＋ Add a task</button></section>`}).join('');board.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>openTask(null,b.dataset.add));board.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>openTask(b.dataset.edit));board.querySelectorAll('.card').forEach(el=>{el.ondragstart=e=>{e.dataTransfer.setData('text/plain',el.dataset.id);e.dataTransfer.effectAllowed='move';setTimeout(()=>el.classList.add('dragging'),0)};el.ondragend=()=>el.classList.remove('dragging')});board.querySelectorAll('.column').forEach(col=>{col.ondragover=e=>{e.preventDefault();col.classList.add('dragover')};col.ondragleave=e=>{if(!col.contains(e.relatedTarget))col.classList.remove('dragover')};col.ondrop=e=>{e.preventDefault();col.classList.remove('dragover');const t=data.tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.column=col.dataset.column;save()}}})}
+function cardHTML(t){const today=new Date();today.setHours(0,0,0,0);const due=t.due?new Date(...t.due.split('-').map((v,i)=>i===1?+v-1:+v)):null;const overdue=due&&due<today&&t.column!=='done';const soon=due&&!overdue&&due-today<3*86400000;return `<article class="card" draggable="true" tabindex="0" data-id="${esc(t.id)}" data-edit="${esc(t.id)}" aria-label="${esc(t.title)}. Open task"><div class="card-title">${esc(t.title)}</div>${t.notes?`<div class="card-note">${esc(t.notes)}</div>`:''}<div class="card-foot">${t.label?`<span class="label ${t.label.toLowerCase()}">${esc(t.label)}</span>`:'<span></span>'}${t.due?`<span class="due ${overdue?'overdue':soon?'soon':''}">${overdue?'Overdue · ':''}${dateLabel(t.due)}</span>`:''}</div><div class="card-controls"><button class="mini" data-edit="${esc(t.id)}" aria-label="Edit ${esc(t.title)}">Edit</button></div></article>`}
+function openTask(id,column){const t=data.tasks.find(x=>x.id===id);$('#taskId').value=t?.id||'';$('#taskName').value=t?.title||'';$('#taskNotes').value=t?.notes||'';$('#taskDue').value=t?.due||'';$('#taskLabel').value=t?.label||'';$('#taskColumn').innerHTML=data.columns.map(c=>`<option value="${esc(c.id)}">${esc(c.name)}</option>`).join('');$('#taskColumn').value=t?.column||column||data.columns[0].id;$('#dialogTitle').textContent=t?'Edit task':'Add a task';$('#dialogEyebrow').textContent=t?'TASK DETAILS':'NEW TASK';$('#deleteTask').style.display=t?'block':'none';dialog.showModal();setTimeout(()=>$('#taskName').focus(),0)}
+form.onsubmit=e=>{e.preventDefault();const id=$('#taskId').value,t={id:id||crypto.randomUUID(),title:$('#taskName').value.trim(),notes:$('#taskNotes').value.trim(),column:$('#taskColumn').value,due:$('#taskDue').value,label:$('#taskLabel').value,created:Date.now()};if(!t.title)return;if(id)Object.assign(data.tasks.find(x=>x.id===id),t);else data.tasks.push(t);dialog.close();save();showToast(id?'Task updated':'Task added')};
+$('#addTask').onclick=()=>openTask();$('#closeDialog').onclick=$('#cancelDialog').onclick=()=>dialog.close();dialog.onclick=e=>{if(e.target===dialog)dialog.close()};$('#deleteTask').onclick=()=>{const id=$('#taskId').value;if(confirm('Delete this task?')){data.tasks=data.tasks.filter(t=>t.id!==id);dialog.close();save();showToast('Task deleted')}};
+$('#search').oninput=e=>{query=e.target.value.trim().toLowerCase();render()};document.addEventListener('keydown',e=>{if(e.key==='/'&&!/input|textarea/i.test(document.activeElement.tagName)){e.preventDefault();$('#search').focus()}if(e.key==='Escape'&&document.activeElement===$('#search')){$('#search').value='';query='';render()}});
+document.querySelectorAll('.filter').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelector('.filter.active').classList.remove('active');b.classList.add('active');render()});$('#clearDone').onclick=()=>{const n=data.tasks.filter(t=>t.column==='done').length;if(n&&confirm(`Delete ${n} completed ${n===1?'task':'tasks'}?`)){data.tasks=data.tasks.filter(t=>t.column!=='done');save();showToast('Completed tasks cleared')}};
+$('#exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`dayboard-${new Date().toISOString().slice(0,10)}.json`;a.click();URL.revokeObjectURL(a.href)};$('#importBtn').onclick=()=>$('#importFile').click();$('#importFile').onchange=async e=>{try{const next=JSON.parse(await e.target.files[0].text());if(!Array.isArray(next.columns)||!Array.isArray(next.tasks)||!next.columns.length||next.columns.some(c=>!c.id||!c.name)||next.tasks.some(t=>!t.id||!t.title||!next.columns.some(c=>c.id===t.column)))throw Error();if(confirm('Replace this board with the imported board?')){data=next;save();showToast('Board imported')}}catch{showToast('That file is not a valid Dayboard export')}e.target.value=''};
+$('#today').textContent=new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'}).toUpperCase();render();
diff --git a/board/index.html b/board/index.html
new file mode 100644
index 0000000..3862970
--- /dev/null
+++ b/board/index.html
@@ -0,0 +1,18 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f7f7f4">
+<title>Dayboard — Personal Kanban</title>
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<header class="topbar"><a class="brand" href="#" aria-label="Dayboard home"><span class="brand-mark">▦</span> dayboard</a><div class="top-actions"><label class="search"><span>⌕</span><input id="search" type="search" placeholder="Find a task…" aria-label="Search tasks"><kbd>/</kbd></label><button class="icon-btn" id="exportBtn" title="Export board" aria-label="Export board">↥</button><button class="icon-btn" id="importBtn" title="Import board" aria-label="Import board">↧</button><input id="importFile" type="file" accept="application/json" hidden><button class="avatar" title="Your personal board">Y</button></div></header>
+<main><section class="intro"><div><p class="eyebrow">YOUR SPACE · <span id="today"></span></p><h1>Make room for <em>what matters.</em></h1><p class="subhead">A little progress, every day.</p></div><button class="primary" id="addTask">＋ <span>Add task</span></button></section>
+<div class="toolbar"><div class="filters" role="group" aria-label="Filter tasks"><button class="filter active" data-filter="all">Everything</button><button class="filter" data-filter="today">Due today</button><button class="filter" data-filter="overdue">Overdue</button></div><div class="board-stats"><span id="taskCount">0 tasks</span><span class="dot">·</span><button id="clearDone" class="text-btn">Clear completed</button></div></div>
+<section class="board" id="board" aria-label="Kanban board"></section>
+<footer><span>Small steps count.</span><span>Saved on this device <span class="saved-dot">●</span></span></footer>
+</main>
+<dialog id="taskDialog"><form id="taskForm"><div class="dialog-head"><div><p class="eyebrow" id="dialogEyebrow">NEW TASK</p><h2 id="dialogTitle">Add a task</h2></div><button type="button" class="close" id="closeDialog" aria-label="Close">×</button></div><input type="hidden" id="taskId"><label class="field">Task name<input id="taskName" maxlength="120" placeholder="What needs doing?" required autofocus></label><label class="field">Notes <span class="optional">optional</span><textarea id="taskNotes" rows="3" maxlength="1000" placeholder="A little more context…"></textarea></label><div class="field-row"><label class="field">Column<select id="taskColumn"></select></label><label class="field">Due date<input id="taskDue" type="date"></label></div><label class="field">Label <span class="optional">optional</span><select id="taskLabel"><option value="">No label</option><option value="Focus">Focus</option><option value="Work">Work</option><option value="Personal">Personal</option><option value="Errand">Errand</option></select></label><div class="dialog-actions"><button type="button" id="deleteTask" class="delete-btn">Delete task</button><span class="action-spacer"></span><button type="button" class="secondary" id="cancelDialog">Cancel</button><button type="submit" class="primary">Save task</button></div></form></dialog>
+<div id="toast" role="status" aria-live="polite"></div>
+<script src="app.js"></script>
+</body></html>
