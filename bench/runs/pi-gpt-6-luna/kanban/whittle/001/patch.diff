+function openTask(taskId='',column='todo'){let t=data.tasks.find(x=>x.id===taskId);$('#taskId').value=t?.id||'';$('#taskTitle').value=t?.title||'';$('#taskNotes').value=t?.notes||'';$('#taskColumn').innerHTML=cols.map(([k,l])=>`<option value="${k}">${l}</option>`).join('');$('#taskColumn').value=t?.column||column;$('#taskDue').value=t?.due||'';$('#taskPriority').value=t?.priority||'normal';$('#modalTitle').textContent=t?'Edit task':'New task';$('#deleteTask').classList.toggle('hidden',!t);$('#modalBackdrop').classList.remove('hidden');setTimeout(()=>$('#taskTitle').focus(),50)}function close(){ $('#modalBackdrop').classList.add('hidden')}function notify(text,undo=false){$('#toastText').textContent=text;$('#undoBtn').classList.toggle('hidden',!undo);$('#toast').classList.remove('hidden');clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('#toast').classList.add('hidden'),4500)}form.addEventListener('submit',e=>{e.preventDefault();let taskId=$('#taskId').value,t=data.tasks.find(x=>x.id===taskId),next={id:taskId||id(),title:$('#taskTitle').value.trim(),notes:$('#taskNotes').value.trim(),column:$('#taskColumn').value,due:$('#taskDue').value,priority:$('#taskPriority').value,created:t?.created||Date.now()};if(t)Object.assign(t,next);else data.tasks.unshift(next);save();render();close()});$('#addTaskTop').onclick=()=>openTask();board.addEventListener('click',e=>{let b=e.target.closest('[data-add]');if(b)openTask('',b.dataset.add)});$('#closeModal').onclick=$('#cancelModal').onclick=close;$('#modalBackdrop').addEventListener('click',e=>{if(e.target.id==='modalBackdrop')close()});document.addEventListener('keydown',e=>{if(e.key==='Escape'){close();$('#menu').classList.add('hidden')}if((e.metaKey||e.ctrlKey)&&e.key==='Enter'&&!$('#modalBackdrop').classList.contains('hidden'))form.requestSubmit()});$('#deleteTask').onclick=()=>{let i=data.tasks.findIndex(t=>t.id===$('#taskId').value);if(i<0)return;undoSnapshot={task:data.tasks.splice(i,1)[0],index:i};save();render();close();notify('Task deleted.',true)};$('#undoBtn').onclick=()=>{if(!undoSnapshot)return;if(undoSnapshot.tasks)data.tasks.push(...undoSnapshot.tasks);else data.tasks.splice(undoSnapshot.index,0,undoSnapshot.task);undoSnapshot=null;save();render();$('#toast').classList.add('hidden')};$('#search').oninput=e=>{query=e.target.value.toLowerCase().trim();render()};document.querySelectorAll('.filter').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelectorAll('.filter').forEach(x=>x.classList.toggle('active',x===b));render()});$('#clearDone').onclick=()=>{let completed=data.tasks.filter(t=>t.column==='done');if(!completed.length)return notify('No completed tasks to clear.');undoSnapshot={tasks:completed};data.tasks=data.tasks.filter(t=>t.column!=='done');save();render();notify(`${completed.length} completed task${completed.length===1?'':'s'} cleared.`,true)};$('#renameBtn').onclick=()=>{let n=prompt('Board name',data.name);if(n?.trim()){data.name=n.trim().slice(0,50);save();render()}};$('#themeBtn').onclick=()=>{document.body.classList.toggle('dark');localStorage.setItem('daymark-dark',document.body.classList.contains('dark')?'1':'0')};if(localStorage.getItem('daymark-dark')==='1')document.body.classList.add('dark');$('#menuBtn').onclick=e=>{e.stopPropagation();$('#menu').classList.toggle('hidden')};document.addEventListener('click',e=>{if(!e.target.closest('#menu')&&!e.target.closest('#menuBtn'))$('#menu').classList.add('hidden')});$('#exportBtn').onclick=()=>{let blob=new Blob([JSON.stringify({version:1,...data},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='daymark-backup-'+new Date().toISOString().slice(0,10)+'.json';a.click();URL.revokeObjectURL(a.href);$('#menu').classList.add('hidden')};$('#importBtn').onclick=()=>$('#importFile').click();$('#importFile').onchange=async e=>{try{let x=JSON.parse(await e.target.files[0].text());if(!Array.isArray(x.tasks)||!x.tasks.every(t=>t.title&&cols.some(c=>c[0]===t.column)))throw Error();data={name:String(x.name||'My board').slice(0,50),tasks:x.tasks};save();render();notify('Backup imported successfully.')}catch{notify('Could not import that file. Choose a valid Daymark backup.')}e.target.value=''};$('#resetBtn').onclick=()=>{if(confirm('Restore the starter board? This replaces all current tasks. Export a backup first if you want to keep them.')){data=starter();save();render()}$('#menu').classList.add('hidden')};render()})();
