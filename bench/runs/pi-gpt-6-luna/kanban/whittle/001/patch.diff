+(()=>{'use strict';const KEY='daymark-board-v1',cols=[['todo','To do'],['doing','In progress'],['done','Done']];const starter=()=>({name:'My board',tasks:[{id:id(),title:'Make this board yours',notes:'Add a task, set a due date, or drag cards between columns.',column:'todo',priority:'normal',due:'',created:Date.now()},{id:id(),title:'Pick one thing to focus on',notes:'A small next step is a good place to start.',column:'doing',priority:'high',due:'',created:Date.now()-1}]});const id=()=>Math.random().toString(36).slice(2,10)+Date.now().toString(36);let data;try{data=JSON.parse(localStorage.getItem(KEY))}catch{}if(!data||!Array.isArray(data.tasks))data=starter();let filter='all',query='',undoSnapshot=null,toastTimer;const $=s=>document.querySelector(s),esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const board=$('#board'),form=$('#taskForm');function save(){let status=$('#saveStatus');status.textContent='Saving…';status.classList.add('saving');localStorage.setItem(KEY,JSON.stringify(data));setTimeout(()=>{status.textContent='All changes saved';status.classList.remove('saving')},250)}function render(){ $('#dateLine').textContent=new Intl.DateTimeFormat(undefined,{weekday:'long',month:'long',day:'numeric'}).format(new Date());$('h1').childNodes[0].textContent=data.name+' ';board.innerHTML='';let today=new Date().toISOString().slice(0,10),shown=0;cols.forEach(([key,label])=>{let tasks=data.tasks.filter(t=>t.column===key);let col=document.createElement('section');col.className='column';col.dataset.col=key;col.innerHTML=`<div class="column-head"><div class="col-name"><span class="col-dot"></span>${label}<span class="col-count">${tasks.length}</span></div><button class="add-inline" data-add="${key}" aria-label="Add to ${label}" title="Add task">＋</button></div><div class="cards"></div>`;let cards=col.querySelector('.cards');tasks.forEach(t=>{let overdue=t.due&&t.due<today&&key!=='done',istoday=t.due===today;let matches=(!query||(t.title+' '+t.notes).toLowerCase().includes(query))&&(filter==='all'||filter==='today'&&istoday||filter==='overdue'&&overdue);if(!matches)return;shown++;let card=document.createElement('article');card.className='card';card.draggable=true;card.dataset.id=t.id;card.tabIndex=0;let due=t.due?new Date(t.due+'T12:00:00').toLocaleDateString(undefined,{month:'short',day:'numeric'}):'';card.innerHTML=`<div class="card-title">${esc(t.title)}</div>${t.notes?`<div class="card-notes">${esc(t.notes)}</div>`:''}<div class="card-meta">${t.priority!=='normal'?`<span class="priority ${t.priority}">${t.priority==='high'?'↑ High':'↓ Low'}</span>`:''}${due?`<span class="due ${overdue?'late':istoday?'today':''}">${overdue?'Overdue · ':''}${due}</span>`:''}<button class="edit-card" title="Edit task" aria-label="Edit ${esc(t.title)}">✎</button></div>`;card.addEventListener('click',e=>{if(!e.target.closest('.edit-card')&&!card.classList.contains('dragging'))openTask(t.id)});card.addEventListener('keydown',e=>{if(e.key==='Enter')openTask(t.id)});card.addEventListener('dragstart',e=>{e.dataTransfer.setData('text/plain',t.id);card.classList.add('dragging')});card.addEventListener('dragend',()=>card.classList.remove('dragging'));cards.append(card)});if(!cards.children.length)cards.innerHTML=`<div class="empty-col">${query||filter!=='all'?'No matching tasks':'Nothing here yet — add a task to get started.'}</div>`;col.addEventListener('dragover',e=>{e.preventDefault();col.classList.add('drag-over')});col.addEventListener('dragleave',e=>{if(!col.contains(e.relatedTarget))col.classList.remove('drag-over')});col.addEventListener('drop',e=>{e.preventDefault();col.classList.remove('drag-over');let task=data.tasks.find(t=>t.id===e.dataTransfer.getData('text/plain'));if(task&&task.column!==key){task.column=key;save();render()}});board.append(col)});$('#countAll').textContent=data.tasks.filter(t=>t.column!=='done').length;$('#boardCount').textContent=`${data.tasks.length} task${data.tasks