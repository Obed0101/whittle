+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f5f6f4">
+<title>Daymark — Personal Kanban</title><link rel="stylesheet" href="style.css">
+</head>
+<body>
+<div class="app">
+<header class="topbar"><a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d.</span><span>daymark</span></a><div class="top-actions"><span id="saveStatus" class="save-status">Saved locally</span><button class="icon-btn" id="themeBtn" title="Toggle dark mode" aria-label="Toggle dark mode">◐</button><button class="avatar" title="Personal board">Y</button></div></header>
+<main>
+<section class="welcome"><div><div class="eyebrow"><span class="live-dot"></span> YOUR PERSONAL SPACE</div><h1>Make room for <em>what matters.</em></h1><p>A calmer way to move your work forward.</p></div><div class="date-card"><span id="todayLabel"></span><strong id="todayDate"></strong></div></section>
+<section class="toolbar"><div class="board-title"><span class="title-icon">▦</span><h2>My board</h2><span id="taskCount" class="count-pill">0 tasks</span></div><div class="tools"><label class="search"><span>⌕</span><input id="searchInput" type="search" placeholder="Search tasks…" aria-label="Search tasks"><kbd>/</kbd></label><select id="priorityFilter" aria-label="Filter by priority"><option value="all">All priorities</option><option value="high">High priority</option><option value="medium">Medium priority</option><option value="low">Low priority</option></select><button class="button secondary" id="exportBtn" title="Download a backup">↥ <span>Export</span></button><button class="button secondary import-button" id="importBtn">↧ <span>Import</span></button><input id="importFile" type="file" accept="application/json,.json" hidden><button class="button primary" id="addTaskBtn">＋ <span>New task</span></button></div></section>
+<section class="board" id="board" aria-label="Kanban board"></section>
+<footer><span>Small steps add up.</span><span>Your board is saved on this device <span class="footer-dot">·</span> <button id="clearCompleted" class="text-button">Clear completed</button></span></footer>
+</main>
+<div id="toast" class="toast" role="status" aria-live="polite"></div>
+</div>
+<dialog id="taskDialog"><form id="taskForm"><div class="dialog-head"><div><span class="eyebrow">TASK DETAILS</span><h2 id="dialogTitle">New task</h2></div><button type="button" class="close-btn" id="closeDialog" aria-label="Close">×</button></div><input type="hidden" id="taskId"><label class="field">Task name<input id="taskName" required maxlength="120" placeholder="What needs to get done?"></label><label class="field">Notes <span class="optional">(optional)</span><textarea id="taskNotes" maxlength="1000" rows="3" placeholder="Add a little context…"></textarea></label><div class="field-row"><label class="field">Status<select id="taskStatus"><option value="todo">To do</option><option value="doing">In progress</option><option value="done">Done</option></select></label><label class="field">Priority<select id="taskPriority"><option value="none">No priority</option><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option></select></label></div><label class="field">Due date <span class="optional">(optional)</span><input id="taskDue" type="date"></label><div class="dialog-actions"><button type="button" id="deleteTask" class="text-button danger">Delete task</button><span class="spacer"></span><button type="button" id="cancelDialog" class="button secondary">Cancel</button><button class="button primary" type="submit">Save task</button></div></form></dialog>
+<script src="app.js"></script>
+</body></html>
