+(()=>{'use strict';
+const KEY='daymark-board-v1', statuses=['todo','doing','done'], labels={todo:'To do',doing:'In progress',done:'Done'};
+const $=s=>document.querySelector(s), board=$('#board'), dialog=$('#taskDialog'), form=$('#taskForm');let tasks=[], undoTask=null, toastTimer;
+function load(){try{const data=JSON.parse(localStorage.getItem(KEY)||'[]');tasks=Array.isArray(data)?data.filter(t=>t&&typeof t.id==='string'&&typeof t.title==='string'&&statuses.includes(t.status)):[]}catch{tasks=[]}}
+function persist(){try{localStorage.setItem(KEY,JSON.stringify(tasks));$('#saveStatus').textContent='Saved locally'}catch{$('#saveStatus').textContent='Storage full';notify('Could not save — your browser storage may be full. Export a backup.')}}
+function safe(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+function render(){const query=$('#searchInput').value.trim().toLowerCase(), priority=$('#priorityFilter').value;board.innerHTML='';let shown=0;
+for(const status of statuses){const list=tasks.filter(t=>t.status===status&&(!query||`${t.title} ${t.notes||''}`.toLowerCase().includes(query))&&(priority==='all'||t.priority===priority));shown+=list.length;const col=document.createElement('section');col.className='column';col.dataset.status=status;col.innerHTML=`<div class="column-head"><div class="column-name"><i class="dot"></i>${labels[status]} <span class="column-count">${tasks.filter(t=>t.status===status).length}</span></div><button class="column-add" title="Add task to ${labels[status]}" aria-label="Add task to ${labels[status]}">＋</button></div><div class="cards">${list.length?list.map(cardHTML).join(''):`<div class="empty"><b>＋</b>${query||priority!=='all'?'No matching tasks':'Nothing here yet'}</div>`}</div>`;
+col.querySelector('.column-add').onclick=()=>openTask(null,status);col.addEventListener('dragover',e=>{e.preventDefault();col.classList.add('drag-over')});col.addEventListener('dragleave',e=>{if(!col.contains(e.relatedTarget))col.classList.remove('drag-over')});col.addEventListener('drop',e=>{e.preventDefault();col.classList.remove('drag-over');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=status;persist();render()}});board.append(col)}
+$('#taskCount').textContent=`${tasks.length} ${tasks.length===1?'task':'tasks'}`;$('#clearCompleted').style.visibility=tasks.some(t=>t.status==='done')?'visible':'hidden';board.querySelectorAll('.task-card').forEach(el=>{el.onclick=()=>openTask(el.dataset.id);el.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();openTask(el.dataset.id)}});el.addEventListener('dragstart',e=>{el.classList.add('dragging');e.dataTransfer.setData('text/plain',el.dataset.id);e.dataTransfer.effectAllowed='move'});el.addEventListener('dragend',()=>el.classList.remove('dragging'))})}
+function cardHTML(t){const due=t.due?new Date(t.due+'T00:00:00'):null, today=new Date();today.setHours(0,0,0,0);let dueClass='',dueText='';if(due){dueText=due.toLocaleDateString(undefined,{month:'short',day:'numeric'});dueClass=due<today&&t.status!=='done'?'overdue':(due-today<86400000*3&&t.status!=='done'?'soon':'')}
+return `<article class="task-card" draggable="true" tabindex="0" role="button" aria-label="Edit ${safe(t.title)}" data-id="${safe(t.id)}"><div class="card-top"><span class="card-title">${safe(t.title)}</span><button class="edit-hint" tabindex="-1" aria-hidden="true">···</button></div>${t.notes?`<div class="card-notes">${safe(t.notes)}</div>`:''}<div class="card-meta"><span>${t.priority&&t.priority!=='none'?`<span class="priority ${safe(t.priority)}">${safe(t.priority[0].toUpperCase()+t.priority.slice(1))}</span>`:''}</span>${due?`<span class="due ${dueClass}">${dueClass==='overdue'?'Overdue · ':''}${dueText}</span>`:''}</div></article>`}
+function openTask(id,status='todo'){const t=tasks.find(x=>x.id===id);$('#taskId').value=t?.id||'';$('#taskName').value=t?.title||'';$('#taskNotes').value=t?.notes||'';$('#taskStatus').value=t?.status||status;$('#taskPriority').value=t?.priority||'none';$('#taskDue').value=t?.due||'';$('#dialogTitle').textContent=t?'Edit task':'New task';$('#deleteTask').style.visibility=t?'visible':'hidden';dialog.showModal();setTimeout(()=>$('#taskName').focus(),50)}
+function notify(message,undo=false){const el=$('#toast');el.innerHTML=`${safe(message)}${undo?' <button id="undoBtn">Undo</button>':''}`;el.classList.add('show');clearTimeout(toastTimer);if(undo)$('#undoBtn').onclick=()=>{if(undoTask){tasks.push(undoTask);undoTask=null;persist();render();el.classList.remove('show')}};toastTimer=setTimeout(()=>el.classList.remove('show'),3800)}
+form.addEventListener('submit',e=>{e.preventDefault();const id=$('#taskId').value, item={id:id||crypto.randomUUID(),title:$('#taskName').value.trim(),notes:$('#taskNotes').value.trim(),status:$('#taskStatus').value,priority:$('#taskPriority').value,due:$('#taskDue').value,updatedAt:new Date().toISOString()};if(!item.title)return;const ix=tasks.findIndex(t=>t.id===id);if(ix<0)tasks.unshift(item);else tasks[ix]=item;persist();render();dialog.close()});
+$('#addTaskBtn').onclick=()=>openTask();$('#closeDialog').onclick=$('#cancelDialog').onclick=()=>dialog.close();$('#deleteTask').onclick=()=>{const id=$('#taskId').value;undoTask=tasks.find(t=>t.id===id);tasks=tasks.filter(t=>t.id!==id);persist();render();dialog.close();notify('Task deleted.',true)};$('#searchInput').oninput=render;$('#priorityFilter').onchange=render;
+document.addEventListener('keydown',e=>{if(e.key==='/'&&!dialog.open&&!e.ctrlKey&&!e.metaKey&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();$('#searchInput').focus()}if(e.key==='Escape'&&dialog.open)dialog.close()});
+$('#exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify({version:1,exportedAt:new Date().toISOString(),tasks},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`daymark-backup-${new Date().toISOString().slice(0,10)}.json`;a.click();URL.revokeObjectURL(a.href);notify('Board backup downloaded.')};$('#importBtn').onclick=()=>$('#importFile').click();$('#importFile').onchange=async e=>{const file=e.target.files[0];if(!file)return;try{const parsed=JSON.parse(await file.text()),data=Array.isArray(parsed)?parsed:parsed.tasks;if(!Array.isArray(data)||data.length>5000||data.some(t=>!t||typeof t.title!=='string'||!statuses.includes(t.status)))throw Error();if(!confirm(`Import ${data.length} tasks? This replaces your current board.`))return;tasks=data.map(t=>({id:crypto.randomUUID(),title:t.title.slice(0,120),notes:String(t.notes||'').slice(0,1000),status:t.status,priority:['high','medium','low'].includes(t.priority)?t.priority:'none',due:/^\d{4}-\d\d-\d\d$/.test(t.due||'')?t.due:''}));persist();render();notify('Board imported.')}catch{notify('That file is not a valid Daymark backup.')}finally{e.target.value=''}};
+$('#clearCompleted').onclick=()=>{const completed=tasks.filter(t=>t.status==='done');if(!completed.length)return;if(!confirm(`Permanently clear ${completed.length} completed ${completed.length===1?'task':'tasks'}?`))return;tasks=tasks.filter(t=>t.status!=='done');persist();render();notify('Completed tasks cleared.')};
+function setTheme(dark){document.documentElement.classList.toggle('dark',dark);localStorage.setItem('daymark-theme',dark?'dark':'light');$('#themeBtn').textContent=dark?'☼':'◐';$('#themeBtn').setAttribute('aria-label',dark?'Switch to light mode':'Switch to dark mode')};$('#themeBtn').onclick=()=>setTheme(!document.documentElement.classList.contains('dark'));try{setTheme(localStorage.getItem('daymark-theme')==='dark')}catch{}
+const now=new Date();$('#todayLabel').textContent=now.toLocaleDateString(undefined,{weekday:'long'}).toUpperCase();$('#todayDate').textContent=now.toLocaleDateString(undefined,{month:'long',day:'numeric',year:'numeric'});load();render();
+})();
