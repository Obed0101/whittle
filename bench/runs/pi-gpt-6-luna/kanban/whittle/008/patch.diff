+(()=>{'use strict';
+const KEY='monday-board-v1', statuses=[['todo','To do'],['doing','In progress'],['done','Done']];
+const seed=[{id:'a1',title:'Plan the week ahead',description:'Pick three things that would make this week feel like a win.',priority:'high',due:'',status:'todo'},{id:'a2',title:'Read 20 pages',description:'Make a little space to unplug before bed.',priority:'low',due:'',status:'todo'},{id:'a3',title:'Book a dentist appointment',description:'',priority:'medium',due:'',status:'todo'},{id:'b1',title:'Get outside for a walk',description:'A proper lunch break, away from the screen.',priority:'low',due:'',status:'doing'},{id:'b2',title:'Sort out the inbox',description:'',priority:'medium',due:'',status:'doing'},{id:'c1',title:'Make a good breakfast',description:'',priority:'low',due:'',status:'done'}];
+const $=id=>document.getElementById(id), board=$('board'), dialog=$('taskDialog'), form=$('taskForm');let tasks=load(), previous=null, toastTimer;
+function load(){try{const x=JSON.parse(localStorage.getItem(KEY));if(Array.isArray(x)&&x.every(t=>t&&typeof t.id==='string'&&typeof t.title==='string'&&statuses.some(s=>s[0]===t.status)))return x}catch{}return structuredClone(seed)}
+function persist(){try{localStorage.setItem(KEY,JSON.stringify(tasks));$('saveState').innerHTML='<i></i> All changes saved'}catch{$('saveState').innerHTML='<i style="background:#c66"></i> Could not save changes'}}
+function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+function render(){const query=$('searchInput').value.trim().toLowerCase(),priority=$('priorityFilter').value;let shown=0;board.innerHTML=statuses.map(([status,label])=>{const list=tasks.filter(t=>t.status===status&&(!query||(t.title+' '+t.description).toLowerCase().includes(query))&&(priority==='all'||t.priority===priority));shown+=list.length;return `<section class="column" data-status="${status}" aria-label="${label}"><header class="column-head"><div class="column-name">${label}<span class="count">${list.length}</span></div><button class="column-add" data-add="${status}" aria-label="Add task to ${label}" title="Add task">＋</button></header><div class="task-list" data-drop="${status}">${list.length?list.map(card).join(''):`<div class="empty"><span>＋</span>${query||priority!=='all'?'No matching tasks':'Nothing here yet'}</div>`}</div></section>`}).join('');$('taskTotal').textContent=`${shown} ${shown===1?'task':'tasks'}`;board.querySelectorAll('.task-card').forEach(el=>{el.addEventListener('dragstart',e=>{e.dataTransfer.setData('text/plain',el.dataset.id);el.classList.add('dragging')});el.addEventListener('dragend',()=>el.classList.remove('dragging'));el.addEventListener('dblclick',()=>edit(el.dataset.id));el.addEventListener('keydown',e=>{if(e.key==='Enter'){edit(el.dataset.id)}})});board.querySelectorAll('.column-add').forEach(b=>b.onclick=()=>openTask('',b.dataset.add));board.querySelectorAll('.card-menu').forEach(b=>b.onclick=e=>{e.stopPropagation();edit(b.closest('.task-card').dataset.id)});board.querySelectorAll('.task-list').forEach(list=>{list.addEventListener('dragover',e=>{e.preventDefault();list.closest('.column').classList.add('drag-over')});list.addEventListener('dragleave',e=>{if(!list.contains(e.relatedTarget))list.closest('.column').classList.remove('drag-over')});list.addEventListener('drop',e=>{e.preventDefault();list.closest('.column').classList.remove('drag-over');move(e.dataTransfer.getData('text/plain'),list.dataset.drop)})})}
+function card(t){let due='';if(t.due){const d=new Date(t.due+'T00:00:00'),today=new Date();today.setHours(0,0,0,0);const diff=(d-today)/86400000;due=`<span class="due ${diff<0?'overdue':diff===0?'today':''}"><span class="due-icon">▦</span>${diff===0?'Today':diff===-1?'Yesterday':d.toLocaleDateString(undefined,{month:'short',day:'numeric'})}</span>`}return `<article class="task-card" draggable="true" tabindex="0" data-id="${esc(t.id)}" aria-label="${esc(t.title)}. ${t.priority} priority"><div class="card-top"><div class="task-title">${esc(t.title)}</div><button class="card-menu" aria-label="Edit ${esc(t.title)}" title="Edit task">···</button></div>${t.description?`<p class="task-description">${esc(t.description)}</p>`:''}<div class="card-footer"><span class="priority ${esc(t.priority)}">${esc(t.priority[0].toUpperCase()+t.priority.slice(1))}</span>${due}</div></article>`}
+function openTask(id='',status='todo'){form.reset();$('taskId').value='';$('taskPriority').value='medium';$('dialogTitle').textContent='Add a task';$('saveTaskBtn').textContent='Add task';$('deleteTaskBtn').hidden=true;if(id){const t=tasks.find(x=>x.id===id);if(!t)return;$('taskId').value=id;$('taskTitle').value=t.title;$('taskDescription').value=t.description||'';$('taskPriority').value=t.priority;$('taskDue').value=t.due||'';$('dialogTitle').textContent='Edit task';$('saveTaskBtn').textContent='Save changes';$('deleteTaskBtn').hidden=false}else $('taskId').dataset.status=status;dialog.showModal();setTimeout(()=>$('taskTitle').focus(),30)}function edit(id){openTask(id)}
+form.addEventListener('submit',e=>{e.preventDefault();const id=$('taskId').value,title=$('taskTitle').value.trim();if(!title)return;const old=id&&tasks.find(t=>t.id===id);const item={id:id||crypto.randomUUID(),title,description:$('taskDescription').value.trim(),priority:$('taskPriority').value,due:$('taskDue').value,status:old?.status||$('taskId').dataset.status||'todo'};if(id)tasks=tasks.map(t=>t.id===id?item:t);else tasks.unshift(item);persist();render();dialog.close();notify(id?'Task updated':'Task added')});function removeTask(id){const t=tasks.find(x=>x.id===id);if(!t)return;previous={tasks:structuredClone(tasks),message:`“${t.title}” deleted`};tasks=tasks.filter(x=>x.id!==id);persist();render();dialog.close();notify(previous.message,true)}$('deleteTaskBtn').onclick=()=>{const id=$('taskId').value;if(id&&confirm('Delete this task? You can undo this right after.'))removeTask(id)};$('cancelBtn').onclick=()=>dialog.close();document.querySelector('.close-dialog').onclick=()=>dialog.close();dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});function move(id,status){const t=tasks.find(x=>x.id===id);if(!t||t.status===status)return;t.status=status;persist();render();notify(`Moved to ${statuses.find(s=>s[0]===status)[1]}`)}
+function notify(text,undo=false){const el=$('toast');clearTimeout(toastTimer);el.innerHTML=esc(text)+(undo?' <button id="undoBtn">Undo</button>':'');el.classList.add('show');if(undo)$('undoBtn').onclick=()=>{tasks=previous.tasks;persist();render();el.classList.remove('show');previous=null};toastTimer=setTimeout(()=>el.classList.remove('show'),3500)}
+$('addTaskBtn').onclick=()=>openTask();$('searchInput').oninput=render;$('priorityFilter').onchange=render;$('themeToggle').onclick=()=>{document.body.classList.toggle('dark');localStorage.setItem('monday-theme',document.body.classList.contains('dark')?'dark':'light')};if(localStorage.getItem('monday-theme')==='dark')document.body.classList.add('dark');$('boardMenu').onclick=e=>{e.stopPropagation();$('menuPopover').hidden=!$('menuPopover').hidden};document.addEventListener('click',e=>{if(!e.target.closest('#menuPopover')&&!e.target.closest('#boardMenu'))$('menuPopover').hidden=true});$('clearDone').onclick=()=>{const completed=tasks.filter(t=>t.status==='done');if(!completed.length)return notify('No completed tasks to clear');if(confirm(`Clear ${completed.length} completed ${completed.length===1?'task':'tasks'}?`)){previous={tasks:structuredClone(tasks)};tasks=tasks.filter(t=>t.status!=='done');persist();render();notify('Completed tasks cleared',true)}};$('resetBoard').onclick=()=>{if(confirm('Restore the sample board? This replaces your current tasks.')){tasks=structuredClone(seed);persist();render();notify('Sample board restored')} };$('exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify({version:1,exportedAt:new Date().toISOString(),tasks},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='my-board.json';a.click();URL.revokeObjectURL(a.href);notify('Board exported')};$('importFile').onchange=async e=>{const file=e.target.files[0];if(!file)return;try{const data=JSON.parse(await file.text()),incoming=Array.isArray(data)?data:data.tasks;if(!Array.isArray(incoming)||!incoming.every(t=>t&&typeof t.title==='string'&&statuses.some(s=>s[0]===t.status)))throw Error('Invalid board file');if(confirm(`Import ${incoming.length} tasks? This replaces your current board.`)){tasks=incoming.map(t=>({id:typeof t.id==='string'?t.id:crypto.randomUUID(),title:t.title.slice(0,120),description:typeof t.description==='string'?t.description.slice(0,500):'',priority:['low','medium','high'].includes(t.priority)?t.priority:'medium',due:/^\d{4}-\d{2}-\d{2}$/.test(t.due||'')?t.due:'',status:t.status}));persist();render();notify('Board imported')}}catch{notify('Could not import: invalid board file')}e.target.value=''};document.addEventListener('keydown',e=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();$('searchInput').focus()}if(e.key==='Escape')$('menuPopover').hidden=true});render();persist();
