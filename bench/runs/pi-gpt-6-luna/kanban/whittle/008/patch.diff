+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f5f5f2">
+<title>Monday — your personal board</title><link rel="stylesheet" href="style.css">
+</head>
+<body>
+<div class="app-shell">
+<header class="topbar"><a class="brand" href="#" aria-label="Monday board home"><span class="brand-mark">m</span><span>monday<span class="brand-dot">.</span></span></a><div class="top-actions"><span class="save-state" id="saveState"><i></i> All changes saved</span><button class="icon-btn" id="themeToggle" title="Toggle dark mode" aria-label="Toggle dark mode">◐</button><button class="avatar" title="Your personal workspace">Y</button></div></header>
+<main>
+<section class="board-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span> YOUR WORKSPACE</div><div class="title-row"><h1>My board</h1><button class="icon-btn more-btn" id="boardMenu" aria-label="Board options" title="Board options">···</button></div><p class="subtitle">A little progress, every day.</p></div><div class="heading-actions"><button class="button secondary" id="exportBtn"><span>↥</span> Export</button><label class="button secondary import-label" for="importFile"><span>↧</span> Import<input id="importFile" type="file" accept="application/json,.json" hidden></label><button class="button primary" id="addTaskBtn"><span class="plus">＋</span> Add task</button></div></section>
+<section class="toolbar" aria-label="Board tools"><label class="search"><span>⌕</span><input id="searchInput" type="search" placeholder="Search tasks..." aria-label="Search tasks"><kbd>⌘ K</kbd></label><div class="toolbar-right"><label class="filter-wrap"><span class="filter-icon">☷</span><select id="priorityFilter" aria-label="Filter by priority"><option value="all">All priorities</option><option value="high">High priority</option><option value="medium">Medium priority</option><option value="low">Low priority</option></select></label><span class="task-total" id="taskTotal"></span></div></section>
+<section class="board" id="board" aria-label="Kanban board"></section>
+<footer class="footer"><span>Made for your focus <span class="heart">♥</span></span><span><kbd>⌘</kbd> <kbd>K</kbd> to search <span class="footer-sep">·</span> Drag cards to move them</span></footer>
+</main></div>
+<div class="toast" id="toast" role="status" aria-live="polite"></div>
+<dialog id="taskDialog"><form id="taskForm"><div class="dialog-top"><div><div class="eyebrow">TASK DETAILS</div><h2 id="dialogTitle">Add a task</h2></div><button type="button" class="icon-btn close-dialog" aria-label="Close">×</button></div><input type="hidden" id="taskId"><label class="field-label" for="taskTitle">Task name <span>*</span></label><input class="text-field" id="taskTitle" maxlength="120" required placeholder="What needs doing?"><label class="field-label" for="taskDescription">Notes <small>optional</small></label><textarea class="text-field" id="taskDescription" rows="3" maxlength="500" placeholder="Add a little context..."></textarea><div class="field-grid"><div><label class="field-label" for="taskPriority">Priority</label><select class="text-field" id="taskPriority"><option value="low">Low</option><option value="medium" selected>Medium</option><option value="high">High</option></select></div><div><label class="field-label" for="taskDue">Due date</label><input class="text-field" id="taskDue" type="date"></div></div><div class="dialog-actions"><button type="button" class="button danger-text" id="deleteTaskBtn" hidden>Delete task</button><span class="dialog-spacer"></span><button type="button" class="button secondary" id="cancelBtn">Cancel</button><button class="button primary" type="submit" id="saveTaskBtn">Add task</button></div></form></dialog>
+<div class="menu-popover" id="menuPopover" hidden><button id="clearDone">Clear completed tasks</button><button id="resetBoard">Restore sample board</button></div>
+<script src="app.js"></script>
+</body></html>
