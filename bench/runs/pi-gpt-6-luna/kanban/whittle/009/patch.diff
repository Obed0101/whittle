+<script>
+(()=>{'use strict';const KEY='daymark-board-v1',statuses=[['todo','To do'],['doing','In progress'],['done','Done']];let data=load(),previous=null,timer,dragId=null;const $=s=>document.querySelector(s),board=$('#board'),backdrop=$('#backdrop');function load(){try{const d=JSON.parse(localStorage.getItem(KEY));if(d&&Array.isArray(d.tasks))return d}catch{}return{tasks:[],theme:'light'}}function save(){try{localStorage.setItem(KEY,JSON.stringify(data))}catch{toast('Could not save: browser storage is full.',false)}}function uid(){return crypto.randomUUID?crypto.randomUUID():Date.now().toString(36)+Math.random().toString(36).slice(2)}function toast(text,undo=true){clearTimeout(timer);$('#noticeText').textContent=text;$('#undo').style.display=undo?'':'none';$('#notice').classList.add('show');timer=setTimeout(()=>$('#notice').classList.remove('show'),4500)}function snapshot(){previous=JSON.stringify(data)}function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function dateLabel(date){if(!date)return'';const d=new Date(date+'T00:00:00');return d.toLocaleDateString(undefined,{month:'short',day:'numeric'})}function render(){const q=$('#search').value.toLowerCase(),pf=$('#priorityFilter').value,sort=$('#sort').value;board.innerHTML='';for(const [status,label] of statuses){let tasks=data.tasks.filter(t=>t.status===status&&(!q||`${t.title} ${t.description} ${(t.tags||[]).join(' ')}`.toLowerCase().includes(q))&&(!pf||t.priority===pf));if(sort==='due')tasks.sort((a,b)=>(a.due||'9999').localeCompare(b.due||'9999'));if(sort==='priority')tasks.sort((a,b)=>['High','Medium','Low','none'].indexOf(a.priority)-['High','Medium','Low','none'].indexOf(b.priority));if(sort==='created')tasks.sort((a,b)=>b.created-a.created);const col=document.createElement('section');col.className='column';col.dataset.status=status;col.innerHTML=`<div class="col-head"><span class="dot"></span><h2>${label}</h2><span class="count">${tasks.lengt