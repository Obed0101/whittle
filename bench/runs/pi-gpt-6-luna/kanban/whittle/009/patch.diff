ks.find(x=>x.id===id);if(t&&t.status!==status){snapshot();t.status=status;save();render();toast('Task moved.')}});board.append(col)}const active=data.tasks.filter(t=>t.status!=='done').length;$('#summary').textContent=`${active} task${active===1?'':'s'} in progress · ${data.tasks.length-active} completed`}
+function open(id,status='todo'){const t=data.tasks.find(x=>x.id===id);$('#taskId').value=t?.id||'';$('#modalTitle').textContent=t?'Edit task':'New task';$('#title').value=t?.title||'';$('#description').value=t?.description||'';$('#status').value=t?.status||status;$('#priority').value=t?.priority||'none';$('#due').value=t?.due||'';$('#tags').value=(t?.tags||[]).join(', ');$('#deleteTask').hidden=!t;backdrop.classList.add('open');$('#title').focus()}function close(){backdrop.classList.remove('open')}$('#taskForm').onsubmit=e=>{e.preventDefault();const id=$('#taskId').value;const t={id:id||uid(),title:$('#title').value.trim(),description:$('#description').value.trim(),status:$('#status').value,priority:$('#priority').value,due:$('#due').value,tags:[...new Set($('#tags').value.split(',').map(x=>x.trim()).filter(Boolean))],created:id?(data.tasks.find(x=>x.id===id)?.created||Date.now()):Date.now()};if(!t.title)return;snapshot();if(id)data.tasks[data.tasks.findIndex(x=>x.id===id)]=t;else data.tasks.push(t);save();close();render();toast(id?'Task updated.':'Task added.')};$('#deleteTask').onclick=()=>{const id=$('#taskId').value;snapshot();data.tasks=data.tasks.filter(t=>t.id!==id);save();close();render();toast('Task deleted.')};$('#newTask').onclick=()=>open();$('#cancel').onclick=close;backdrop.onclick=e=>{if(e.target===backdrop)close()};document.onkeydown=e=>{if(e.key==='Escape')close();if((e.metaKey||e.ctrlKey)&&e.key==='Enter'&&backdrop.classList.contains('open'))$('#taskForm').requestSubmit()};$('#search').oninput=render;$('#priorityFilter').onchange=render;$('#sort').onchange=render;$('#undo').onclick=()=>{if(previous){data=JSON.parse(previous);save();render();previous=null}$('#notice').classList.remove('show')};$('#clearDone').onclick=()=>{const n=data.tasks.filter(t=>t.status==='done').length;if(!n)return toast('No completed tasks to clear.',false);if(confirm(`Delete ${n} completed task${n===1?'':'s'}?`)){snapshot();data.tasks=data.tasks.filter(t=>t.status!=='done');save();render();toast(`${n} completed task${n===1?'':'s'} cleared.`)}};$('#theme').onclick=()=>{data.theme=data.theme==='dark'?'light':'dark';document.body.classList.toggle('dark',data.theme==='dark');save()};$('#export').onclick=()=>{const blob=new Blob([JSON.stringify({version:1,exportedAt:new Date().toISOString(),tasks:data.tasks},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='daymark-board-'+new Date().toISOString().slice(0,10)+'.json';a.click();URL.revokeObjectURL(a.href)};$('#importBtn').onclick=()=>$('#importFile').click();$('#importFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{const parsed=JSON.parse(await f.text()),tasks=Array.isArray(parsed)?parsed:parsed.tasks;if(!Array.isArray(tasks)||tasks.some(t=>!t.title||!['todo','doing','done'].includes(t.status)))throw Error();if(confirm(`Replace your board with ${tasks.length} imported task${tasks.length===1?'':'s'}?`)){snapshot();data.tasks=tasks.map(t=>({...t,id:String(t.id||uid()),description:String(t.description||''),priority:['Low','Medium','High'].includes(t.priority)?t.priority:'none',tags:Array.isArray(t.tags)?t.tags.map(String):[],created:Number(t.created)||Date.now()}));save();render();toast('Board imported.')}}catch{toast('That file is not a valid Daymark board.',false)}e.target.value=''};document.body.classList.toggle('dark',data.theme==='dark');render()})();
