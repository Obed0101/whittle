e()==='DELETE'){if(data.columns.length===1){alert('The board needs at least one column.');return}const target=data.columns[Math.max(0,idx-1)];if(!confirm(`Delete “${col.name}”? Its tasks will move to “${target.name}”.`))return;data.tasks.forEach(t=>{if(t.status===col.id)t.status=target.id});data.columns.splice(idx,1)}else if(choice.trim())col.name=choice.trim().slice(0,32);persist();render()}
