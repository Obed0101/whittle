+$('#newTask').onclick=()=>openTask();$('#search').oninput=e=>{query=e.target.value;render()};document.querySelectorAll('.filter').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelector('.filter.active').classList.remove('active');b.classList.add('active');render()});$('#sort').onchange=render;$('#archiveToggle').onclick=()=>{archived=!archived;$('#archiveToggle span').textContent=archived?'Board':'Archived';render()};$('#clearCompleted').onclick=()=>{let done=state.columns[state.columns.length-1];let finished=state.tasks.filter(t=>t.column===done.id);if(!finished.length){notice('No completed tasks to clear');return}state.archive.push(...finished);state.tasks=state.tasks.filter(t=>t.column!==done.id);save();render();notice(`${finished.length} task${finished.length===1?'':'s'} archived`) };
