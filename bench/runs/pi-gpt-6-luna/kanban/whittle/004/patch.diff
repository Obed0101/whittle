+function render(){const tasks=archived?state.archive:(state.tasks||[]);$('#archiveCount').textContent=(state.archive||[]).length;$('#allCount').textContent=state.tasks.length;$('#archiveToggle').classList.toggle('active',archived);board.innerHTML='';board.classList.toggle('archive-view',archived);let shown=tasks.filter(t=>(filter==='all'||t.priority===filter)&&(!query||`${t.title} ${t.notes} ${t.label}`.toLowerCase().includes(query.toLowerCase())));
+state.columns.forEach(col=>{let entries=shown.filter(t=>t.column===col.id);if($('#sort').value!=='manual')entries.sort((a,b)=>{let s=$('#sort').value;if(s==='due')return(a.due||'9999').localeCompare(b.due||'9999');if(s==='priority')return({high:0,medium:1,low:2,none:3}[a.priority]||0)-({high:0,medium:1,low:2,none:3}[b.priority]||0);return b.created-a.created});let section=document.createElement('section');section.className='column';section.dataset.column=col.id;section.innerHTML=`<div class="column-head"><div class="col-title"><i class="col-dot"></i>${esc(col.name)} <span class="col-count">${entries.length}</span></div>${archived?'':'<button class="add-inline" aria-label="Add task to '+esc(col.name)+'">＋</button>'}</div><div class="cards">${entries.map(cardHTML).join('')}${entries.length===0?`<div class="empty-hint">${query?'No matching tasks':'Nothing here yet'}</div>`:''}<div class="drop-note">Drop it here</div></div>`;board.append(section)});bindCards();}
+function cardHTML(t){let date=t.due?new Date(t.due+'T00:00:00'):null, today=new Date();today.setHours(0,0,0,0);let overdue=date&&date<today,soon=date&&!overdue&&(date-today)<3*864e5;return `<article class="card" draggable="${!archived}" data-id="${esc(t.id)}" tabindex="0"><div class="card-top"><h3>${esc(t.title)}</h3><button class="menu-btn" aria-label="Edit ${esc(t.title)}">···</button></div>${t.notes?`<p class="card-notes">${esc(t.notes)}</p>`:''}${t.label?`<span class="card-label">${esc(t.label)}</span>`:''}<div class="card-foot">${t.priority&&t.priority!=='none'?`<span class="priority"><i class="dot ${esc(t.priority)}"></i>${t.priority[0].toUpperCase()+t.priority.slice(1)}</span>`:''}${date?`<span class="due ${overdue?'overdue':soon?'soon':''}">${overdue?'Overdue · ':''}${date.toLocaleDateString(undefined,{month:'short',day:'numeric'})}</span>`:''}</div></article>`}
+function bindCards(){document.querySelectorAll('.add-inline').forEach(b=>b.onclick=()=>openTask(null,b.closest('.column').dataset.column));document.querySelectorAll('.card').forEach(c=>{c.onclick=e=>{if(!e.target.closest('.menu-btn'))openTask(c.dataset.id)};c.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();openTask(c.dataset.id)}};c.querySelector('.menu-btn').onclick=e=>{e.stopPropagation();openTask(c.dataset.id)};c.ondragstart=e=>{e.dataTransfer.setData('text/plain',c.dataset.id);c.classList.add('dragging')};c.ondragend=()=>c.classList.remove('dragging')});document.querySelectorAll('.column').forEach(col=>{col.ondragover=e=>{e.preventDefault();col.classList.add('drag-over')};col.ondragleave=e=>{if(!col.contains(e.relatedTarget))col.classList.remove('drag-over')};col.ondrop=e=>{e.preventDefault();col.classList.remove('drag-over');let t=state.tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.column=col.dataset.column;save();render()}}})}
