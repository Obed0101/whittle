+form.onsubmit=e=>{e.preventDefault();let task={id:$('#taskId').value||id(),title:$('#taskName').value.trim(),notes:$('#taskNotes').value.trim(),column:$('#taskColumn').value,priority:$('#taskPriority').value,due:$('#taskDue').value,label:$('#taskLabel').value.trim(),created:Date.now()};if(!task.title)return;let list=state.tasks;let idx=list.findIndex(x=>x.id===task.id);if(idx>=0)list[idx]=task;else{let ai=state.archive.findIndex(x=>x.id===task.id);if(ai>=0)state.archive.splice(ai,1);state.tasks.push(task)}save();dlg.close();render();notice('Task saved')};
+$('#deleteTask').onclick=()=>{let id=$('#taskId').value,from=archived?state.archive:state.tasks,idx=from.findIndex(t=>t.id===id);if(idx<0)return;undoState={task:from.splice(idx,1)[0],archived};save();dlg.close();render();notice('Task deleted · click to undo',()=>{(undoState.archived?state.archive:state.tasks).push(undoState.task);undoState=null;save();render()})};
