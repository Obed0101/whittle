+<div class="board" id="board" aria-label="Kanban board"></div>
+<footer><span><span class="save-dot"></span> Saved on this device</span><span><button id="clearCompleted" class="text-button">Clear completed</button><span class="sep">·</span> Your board stays private</span></footer></main>
+<dialog id="taskDialog"><form id="taskForm"><div class="dialog-head"><div><span class="eyebrow" id="dialogEyebrow">TASK</span><h2 id="dialogTitle">New task</h2></div><button type="button" class="close-btn" data-close aria-label="Close">×</button></div><input type="hidden" id="taskId"><label class="field">Task name<input id="taskName" required maxlength="120" placeholder="What needs to get done?"></label><label class="field">Notes <textarea id="taskNotes" maxlength="1000" rows="3" placeholder="Add details, links, or a checklist…"></textarea></label><div class="field-row"><label class="field">Column<select id="taskColumn"></select></label><label class="field">Priority<select id="taskPriority"><option value="none">No priority</option><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select></label></div><div class="field-row"><label class="field">Due date<input id="taskDue" type="date"></label><label class="field">Label <input id="taskLabel" maxlength="24" placeholder="e.g. Personal"></label></div><div class="dialog-actions"><button type="button" id="deleteTask" class="text-button danger hidden">Delete task</button><span></span><button type="button" class="button secondary" data-close>Cancel</button><button class="button primary" type="submit">Save task</button></div></form></dialog>
