+</style></head><body><main class="app"><header class="top"><div class="brand"><span class="mark" aria-hidden="true">d</span> daymark</div><div class="top-right"><button class="icon-btn" id="theme" aria-label="Toggle dark mode" title="Toggle dark mode">☾</button><button class="btn" id="export">Export</button><button class="btn" id="import">Import</button><input id="file" type="file" accept="application/json,.json" hidden></div></header><section class="intro"><div><div class="eyebrow" id="today"></div><h1>My board</h1><p class="sub">A little focus goes a long way.</p></div><div class="controls"><label class="search"><span class="sr" hidden>Search tasks</span><input id="search" type="search" placeholder="Search tasks…" aria-label="Search tasks"></label><button class="btn primary" id="new">＋ New task</button></div></section><section class="board" aria-label="Kanban board" id="board"></section><footer class="foot"><span id="summary"></span><span>Drag cards to move · <kbd>N</kbd> new task</span></footer></main><div id="overlay"></div><div id="toast-area" aria-live="polite"></div>
+<script>
+(()=>{'use strict';const KEY='daymark-board-v1',statuses=[['todo','To do'],['progress','In progress'],['done','Done']];let tasks=[],filter='',modalTask=null,toastTimer;
+const $=s=>document.querySelector(s), esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function load(){try{const x=JSON.parse(localStorage.getItem(KEY));if(Array.isArray(x))tasks=x.filter(t=>t&&t.id&&t.title&&statuses.some(s=>s[0]===t.status))}catch{tasks=[]}}function save(){try{localStorage.setItem(KEY,JSON.stringify(tasks))}catch{notify('Could not save — browser storage may be full.')}}function id(){return crypto.randomUUID?crypto.randomUUID():Date.now().toString(36)+Math.random().toString(36).slice(2)}function render(){const q=filter.trim().toLowerCase();$('#board').innerHTML=statuses.map(([key,label])=>{const list=tasks.filter(t=>t.status===key&&(!q||`${t.title} ${t.description} ${t.priority}`.toLowerCase().includes(q)));return `<section class="column" data-status="${key}" aria-label="${label}"><header class="col-head"><div class="col-title"><span class="dot"></span>${label}<span class="count">${tasks.filter(t=>t.status===key).length}</span></div><button class="add-small" data-add="${key}" aria-label="Add task to ${label}" title="Add task">＋</button></header><div class="cards" data-drop="${key}">${list.length?list.map(card).join(''):`<div class="empty">${q?'No matching tasks':'Nothing here yet'}</div>`}</div></section>`}).join('');$('#summary').textContent=`${tasks.length} task${tasks.length===1?'':'s'} · ${tasks.filter(t=>t.status!=='done').length} open`;$('#today').textContent=new Intl.DateTimeFormat(undefined,{weekday:'long',month:'long',day:'numeric'}).format(new Date());bindCards()}
+function card(t){const late=t.due&&t.due<new Date().toISOString().slice(0,10)&&t.status!=='done';return `<article class="card" draggable="true" data-id="${esc(t.id)}" tabindex="0" aria-label="${esc(t.title)}"><div class="card-top"><h3>${esc(t.title)}</h3><button class="more" data-menu="${esc(t.id)}" aria-label="Task options">···</button></div>${t.description?`<p class="desc">${esc(t.description)}</p>`:''}<div class="meta">${t.priority!=='none'?`<span class="tag ${esc(t.priority)}">${esc(t.priority[0].toUpperCase()+t.priority.slice(1))} priority</span>`:''}${t.due?`<span class="due ${late?'late':''}">${late?'Overdue · ':''}${new Intl.DateTimeFormat(undefined,{month:'short',day:'numeric'}).format(new Date(t.due+'T12:00:00'))}</span>`:''}</div></article>`}
+function bindCards(){document.querySelectorAll('.card').forEach(el=>{el.addEventListener('click',e=>{if(!e.target.closest('[data-menu]'))openForm(el.dataset.id)});el.addEventListener('keydown',e=>{if(e.key==='Enter')openForm(el.dataset.id)});el.addEventListener('dragstart',e=>{e.dataTransfer.setData('text/plain',el.dataset.id);el.classList.add('dragging')});el.addEventListener('dragend',()=>el.classList.remove('dragging'))});document.querySelectorAll('.column').forEach(c=>{c.addEventListener('dragover',e=>{e.preventDefault();c.classList.add('drag-over')});c.addEventListener('dragleave',e=>{if(!c.contains(e.relatedTarget))c.classList.remove('drag-over')});c.addEventListener('drop',e=>{e.preventDefault();c.classList.remove('drag-over');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=c.dataset.status;save();render()}})});document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>openForm(null,b.dataset.add));document.querySelectorAll('[data-menu]').forEach(b=>b.onclick=e=>{e.stopPropagation();showMenu(b,b.dataset.menu)})}
+function openForm(taskId=null,status='todo'){modalTask=tasks.find(t=>t.id===taskId)||null;const t=modalTask||{title:'',description:'',status,priority:'none',due:''};$('#overlay').innerHTML=`<div class="modal-back" id="back"><form class="modal" id="form" role="dialog" aria-modal="true" aria-labelledby="form-title"><h2 id="form-title">${modalTask?'Edit task':'New task'}</h2><div class="field"><label for="title">Task</label><input id="title" name="title" maxlength="120" required value="${esc(t.title)}" placeholder="What needs doing?"></div><div class="field"><label for="description">Notes <span style="font-weight:400;color:var(--muted)">· optional</span></label><textarea id="description" name="description" maxlength="2000" placeholder="Add a few details…">${esc(t.description||'')}</textarea></div><div class="form-row"><div class="field"><label for="status">Column</label><select id="status" name="status">${statuses.map(([k,n])=>`<option value="${k}" ${t.status===k?'selected':''}>${n}</option>`).join('')}</select></div><div class="field"><label for="priority">Priority</label><select id="priority" name="priority"><option value="none">No priority</option><option value="low" ${t.priority==='low'?'selected':''}>Low</option><option value="medium" ${t.priority==='medium'?'selected':''}>Medium</option><option value="high" ${t.priority==='high'?'selected':''}>High</option></select></div></div><div class="field"><label for="due">Due date <span style="font-weight:400;color:var(--muted)">· optional</span></label><input id="due" name="due" type="date" value="${esc(t.due||'')}"></div><div class="modal-actions">${modalTask?`<button type="button" class="text-btn" id="delete">Delete task</button>`:'<span></span>'}<div class="right-actions"><button type="button" class="btn" id="cancel">Cancel</button><button class="btn primary" type="submit">${modalTask?'Save changes':'Create task'}</button></div></div></form></div>`;$('#title').focus();$('#form').onsubmit=e=>{e.preventDefault();const data=Object.fromEntries(new FormData(e.currentTarget));if(modalTask)Object.assign(modalTask,data);else tasks.unshift({id:id(),...data,created:Date.now()});save();closeForm();render()};$('#cancel').onclick=closeForm;if($('#delete'))$('#delete').onclick=()=>removeTask(modalTask.id);$('#back').onclick=e=>{if(e.target.id==='back')closeForm()};document.onkeydown=e=>{if(e.key==='Escape')closeForm()}}
+function closeForm(){$('#overlay').innerHTML='';document.onkeydown=null}function notify(text,undo){clearTimeout(toastTimer);$('#toast-area').innerHTML=`<div class="toast">${esc(text)}${undo?'<button id="undo">Undo</button>':''}</div>`;if(undo)$('#undo').onclick=()=>{tasks=undo;save();render();$('#toast-area').innerHTML=''};toastTimer=setTimeout(()=>$('#toast-area').innerHTML='',5000)}function removeTask(taskId){const old=tasks.slice();tasks=tasks.filter(t=>t.id!==taskId);save();closeForm();render();notify('Task deleted',old)}function showMenu(button,taskId){document.querySelector('.menu')?.remove();const r=button.getBoundingClientRect(),m=document.createElement('div');m.className='menu';m.innerHTML='<button data-edit>Edit task</button><button data-delete class="danger">Delete task</button>';m.style.top=Math.min(r.bottom+4,innerHeight-100)+'px';m.style.left=Math.min(r.right-150,innerWidth-160)+'px';document.body.append(m);m.querySelector('[data-edit]').onclick=()=>{m.remove();openForm(taskId)};m.querySelector('[data-delete]').onclick=()=>{m.remove();removeTask(taskId)};setTimeout(()=>document.addEventListener('click',()=>m.remove(),{once:true}),0)}
+$('#new').onclick=()=>openForm();$('#search').oninput=e=>{filter=e.target.value;render()};$('#theme').onclick=()=>{document.body.classList.toggle('dark');localStorage.setItem('daymark-dark',document.body.classList.contains('dark')?'1':'0')};if(localStorage.getItem('daymark-dark')==='1')document.body.classList.add('dark');$('#export').onclick=()=>{const blob=new Blob([JSON.stringify({format:'daymark-board',version:1,exportedAt:new Date().toISOString(),tasks},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`daymark-${new Date().toISOString().slice(0,10)}.json`;a.click();URL.revokeObjectURL(a.href)};$('#import').onclick=()=>$('#file').click();$('#file').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{const data=JSON.parse(await f.text()),incoming=Array.isArray(data)?data:data.tasks;if(!Array.isArray(incoming)||incoming.some(t=>!t||typeof t.title!=='string'||!statuses.some(s=>s[0]===t.status)))throw Error('invalid');if(!confirm(`Import ${incoming.length} tasks? This replaces the tasks currently on this board.`))return;const old=tasks;tasks=incoming.map(t=>({id:String(t.id||id()),title:t.title.slice(0,120),description:String(t.description||'').slice(0,2000),status:t.status,priority:['low','medium','high'].includes(t.priority)?t.priority:'none',due:/^\d{4}-\d\d-\d\d$/.test(t.due||'')?t.due:''}));save();render();notify('Board imported',old)}catch{alert('That file is not a valid Daymark board export. Your board was not changed.')}finally{e.target.value=''}};document.addEventListener('keydown',e=>{if(e.key.toLowerCase()==='n'&&!e.metaKey&&!e.ctrlKey&&!e.altKey&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName)&&!$('#overlay').children.length){e.preventDefault();openForm()}});load();render();})();
