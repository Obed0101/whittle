+(()=>{'use strict';const KEY='daymark-board-v1', defaults=['To do','In progress','Done','Later'];let state,undoState=null,undoTimer,dragId=null,menu=null;const $=s=>document.querySelector(s);const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function fresh(){return{columns:defaults.map((name,i)=>({id:'c'+i,name})),tasks:[]}}function load(){try{let x=JSON.parse(localStorage.getItem(KEY));if(x&&Array.isArray(x.columns)&&Array.isArray(x.tasks))return x}catch{}return fresh()}state=load();$('#today').textContent=new Intl.DateTimeFormat(undefined,{weekday:'long',month:'long',day:'numeric'}).format(new Date());function save(){localStorage.setItem(KEY,JSON.stringify(state));render()}function toast(msg,undo){let el=$('#toast');el.innerHTML=esc(msg)+(undo?' <button style="border:0;background:none;color:#d7e4ce;text-decoration:underline" id="undo">Undo</button>':'');el.classList.add('show');clearTimeout(undoTimer);undoTimer=setTimeout(()=>el.classList.remove('show'),3500);if(undo)$('#undo').onclick=()=>{state=undoState;undoState=null;save();el.classList.remove('show')}}function render(){let q=$('#search').value.toLowerCase(),cat=$('#filter').value,sort=$('#sort').value,board=$('#board');board.innerHTML='';state.columns.forEach(col=>{let list=state.tasks.filter(t=>t.column===col.id&&(!cat||t.category===cat)&&(!q||(t.title+' '+t.desc).toLowerCase().includes(q)));if(sort==='due')list.sort((a,b)=>(a.due||'9999').localeCompare(b.due||'9999'));if(sort==='priority')list.sort((a,b)=>({high:0,normal:1,low:2}[a.priority]||1)-({high:0,normal:1,low:2}[b.priority]||1));let section=document.createElement('section');section.className='column';section.dataset.column=col.id;section.innerHTML=`<div class="colhead"><span class="dot"></span><span class="coltitle">${esc(col.name)}</span><span class="count">${list.length}</span>${col.limit?`<span class="limit">limit ${col.limit}</span>`:''}<button class="more" data-colmenu="${esc(col.id)