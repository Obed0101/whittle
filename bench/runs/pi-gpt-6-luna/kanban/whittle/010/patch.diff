+function open(col){$('#form').reset();$('#taskid').value='';$('#modalTitle').textContent='New task';$('#delete').hidden=true;$('#column').innerHTML=state.columns.map(c=>`<option value="${esc(c.id)}">${esc(c.name)}</option>`).join('');$('#column').value=col||state.columns[0]?.id;$('#overlay').classList.add('open');$('#title').focus()}function edit(id){let t=state.tasks.find(x=>x.id===id);if(!t)return;$('#column').innerHTML=state.columns.map(c=>`<option value="${esc(c.id)}">${esc(c.name)}</option>`).join('');$('#taskid').value=id;$('#title').value=t.title;$('#desc').value=t.desc||'';$('#category').value=t.category;$('#priority').value=t.priority;$('#due').value=t.due||'';$('#column').value=t.column;$('#modalTitle').textContent='Edit task';$('#delete').hidden=false;$('#overlay').classList.add('open');$('#title').focus()}function close(){$('#overlay').classList.remove('open')}$('#new').onclick=()=>open();$('#cancel').onclick=close;$('#overlay').addEventListener('click',e=>{if(e.target===$('#overlay'))close()});document.addEventListener('keydown',e=>{if(e.key==='Escape'){close();if(menu){menu.remove();menu=null}}if((e.metaKey||e.ctrlKey)&&e.key==='Enter'&&$('#overlay').classList.contains('open'))$('#form').requestSubmit()});$('#form').onsubmit=e=>{e.preventDefault();let id=$('#taskid').value,t={id:id||crypto.randomUUID(),title:$('#title').value.trim(),desc:$('#desc').value.trim(),category:$('#category').value,priority:$('#priority').value,due:$('#due').value,column:$('#column').value,done:$('#column').value===state.columns.find(c=>c.id===$('#column').value)?.id&&$('#column').selectedOptions[0]?.textContent.toLowerCase()==='done'};if(!t.title)return;if(id){let old=state.tasks.findIndex(x=>x.id===id);t.done=state.tasks[old].done;state.tasks[old]=t}else state.tasks.unshift(t);save();close();toast(id?'Task updated':'Task added')};$('#delete').onclick=()=>{let id=$('#taskid').value;undoState=JSON.parse(JSON.stringify(state));state.tasks=state.tasks.filter(t=>t.id!==id);close();save();toast('Task deleted',true)};$('#search').oninput=render;$('#filter').onchange=render;$('#sort').onchange=render;$('#board').addEventListener('click',e=>{let a=e.target.closest('[data-add]');if(a)open(a.dataset.add);let b=e.target.closest('[data-menu]');if(b){let id=b.dataset.menu;edit(id)}let c=e.target.closest('[data-colmenu]');if(c)columnMenu(c.dataset.colmenu,c)});
+function columnMenu(id,anchor){if(menu){menu.remove();menu=null}let col=state.columns.find(c=>c.id===id);menu=document.createElement('div');menu.className='menu';menu.innerHTML='<button data-action="rename">Rename column</button><button data-action="limit">Set WIP limit</button>'+(state.columns.length>1?'<button data-action="remove">Delete column</button>':'');let r=anchor.getBoundingClientRect();menu.style.top=(r.bottom+4)+'px';menu.style.left=Math.min(r.left,innerWidth-150)+'px';document.body.append(menu);menu.onclick=e=>{let action=e.target.dataset.action;if(!action)return;if(action==='rename'){let name=prompt('Column name',col.name);if(name?.trim()){col.name=name.trim();save()}}if(action==='limit'){let n=prompt('Work-in-progress limit (0 for none)',col.limit||0);if(n!==null&&Number.isInteger(+n)&&+n>=0){col.limit=+n||null;save()}}if(action==='remove'){if(confirm(`Delete “${col.name}” and move its tasks to the first column?`)){let target=state.columns.find(x=>x.id!==id);state.tasks.forEach(t=>{if(t.column===id)t.column=target.id});state.columns=state.columns.filter(x=>x.id!==id);save()}}menu.remove();menu=null};setTimeout(()=>document.addEventListener('click',function outside(e){if(menu&&!menu.contains(e.target)){menu.remove();menu=null}document.removeEventListener('click',outside)}, {once:true}),0)}
+$('#export').onclick=()=>{let blob=new Blob([JSON.stringify({format:'daymark',version:1,...state},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='daymark-board-'+new Date().toISOString().slice(0,10)+'.json';a.click();URL.revokeObjectURL(a.href)};$('#import').onclick=()=>$('#file').click();$('#file').onchange=async e=>{try{let d=JSON.parse(await e.target.files[0].text());if(!Array.isArray(d.columns)||!Array.isArray(d.tasks)||!d.columns.every(c=>c.id&&c.name)||!d.tasks.every(t=>t.id&&t.title&&d.columns.some(c=>c.id===t.column)))throw Error();if(!confirm('Replace this board with the imported data? Export your current board first if you want a backup.'))return;undoState=JSON.parse(JSON.stringify(state));state={columns:d.columns,tasks:d.tasks};save();toast('Board imported',true)}catch{alert('That file is not a valid Daymark board.')}finally{e.target.value=''}};$('#theme').onclick=()=>{let dark=document.documentElement.dataset.theme!=='dark';document.documentElement.dataset.theme=dark?'dark':'';if(dark){document.documentElement.style.setProperty('--bg','#20221f');document.documentElement.style.setProperty('--panel','#292c27');document.documentElement.style.setProperty('--ink','#eeefe9');document.documentElement.style.setProperty('--line','#3b3e38');document.documentElement.style.setProperty('--accent-light','#354133')}else{['--bg','--panel','--ink','--line','--accent-light'].forEach(x=>document.documentElement.style.removeProperty(x))}localStorage.setItem('daymark-dark',dark?'1':'0')};if(localStorage.getItem('daymark-dark')==='1')$('#theme').click();render()})();
