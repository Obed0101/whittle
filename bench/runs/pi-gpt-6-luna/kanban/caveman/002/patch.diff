+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="theme-color" content="#f5f4f0"><title>Daymark — Personal board</title>
+  <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+  <div class="app-shell">
+    <aside class="sidebar">
+      <a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d</span><span>daymark</span></a>
+      <div class="workspace-label">PERSONAL WORKSPACE</div>
+      <nav aria-label="Views">
+        <button class="nav-item active" data-view="board"><span class="nav-icon">▦</span> My board</button>
+        <button class="nav-item" data-view="today"><span class="nav-icon">◷</span> Due today <span id="today-count" class="nav-count"></span></button>
+        <button class="nav-item" data-view="completed"><span class="nav-icon">✓</span> Completed</button>
+      </nav>
+      <div class="sidebar-bottom"><div class="quote-mark">“</div><p>Make space for the work that matters.</p><span>YOUR DAILY REMINDER</span><button id="export-btn" class="text-action">↓ &nbsp;Export your board</button><label class="text-action import-label">↑ &nbsp;Import a board<input id="import-input" type="file" accept="application/json"></label></div>
+      <div class="profile"><div class="avatar">J</div><div><strong>Just you</strong><small>Personal space</small></div><span class="profile-dots">···</span></div>
+    </aside>
+    <main class="main">
+      <header class="topbar"><div class="crumb">Workspace <span>/</span> <strong id="crumb-view">My board</strong></div><div class="top-actions"><span class="saved-indicator"><i></i> Saved locally</span><button class="icon-button" id="help-btn" aria-label="Keyboard shortcuts" title="Keyboard shortcuts">?</button><button class="avatar small-avatar">J</button></div></header>
+      <section class="content">
+        <div class="heading-row"><div><div class="eyebrow" id="date-label">YOUR SPACE · TODAY</div><h1 id="page-title">A little progress, every day.</h1><p class="subtitle" id="page-subtitle">Keep your focus close and your next step clear.</p></div><button id="add-task" class="primary-button"><span>＋</span> Add a task <kbd>N</kbd></button></div>
+        <div class="toolbar"><div class="board-tabs"><button class="tab active" data-tab="board">Board <span id="all-count" class="tab-count">0</span></button><button class="tab" data-tab="activity">Activity</button></div><div class="tools"><label class="search"><span>⌕</span><input id="search" type="search" placeholder="Find a task…" aria-label="Find a task"><kbd>/</kbd></label><button id="filter-btn" class="filter-button">☷ <span>Filter</span><span id="filter-dot" class="filter-dot"></span></button><button id="sort-btn" class="sort-button">↕ <span>Recently added</span></button></div></div>
+        <div id="filter-panel" class="filter-panel hidden"><span>Show:</span><button class="filter-chip active" data-filter="all">Everything</button><button class="filter-chip" data-filter="overdue">Overdue</button><button class="filter-chip" data-filter="priority">High priority</button><button class="filter-chip" data-filter="tag">With a label</button></div>
+        <section id="board-view" class="board" aria-label="Kanban board"></section>
+        <section id="activity-view" class="activity-view hidden"><div class="activity-head"><h2>Recent activity</h2><p>Your latest changes, all in one place.</p></div><div id="activity-list"></div></section>
+        <footer class="board-footer"><span><span class="keyboard-icon">⌘</span> Keep moving at your own pace</span><span id="footer-summary">0 tasks in progress</span></footer>
+      </section>
+    </main>
+  </div>
+  <div id="modal-backdrop" class="modal-backdrop hidden"><section class="task-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title"><div class="modal-top"><span class="modal-kicker">TASK DETAILS</span><button id="close-modal" class="icon-button" aria-label="Close">×</button></div><h2 id="modal-title">Add a task</h2><form id="task-form"><input type="hidden" id="task-id"><label class="field-label" for="task-title">What needs doing?</label><input id="task-title" class="title-input" maxlength="120" placeholder="Give it a clear name" required><label class="field-label" for="task-description">A few details <span>optional</span></label><textarea id="task-description" rows="3" maxlength="1000" placeholder="Add context, a link, or your first step…"></textarea><div class="field-grid"><label><span class="field-label">Column</span><select id="task-status"><option value="todo">To do</option><option value="doing">In progress</option><option value="done">Done</option></select></label><label><span class="field-label">Priority</span><select id="task-priority"><option value="normal">Normal</option><option value="high">High</option><option value="low">Low</option></select></label></div><div class="field-grid"><label><span class="field-label">Due date <span>optional</span></span><input id="task-due" type="date"></label><label><span class="field-label">Label <span>optional</span></span><input id="task-tag" maxlength="24" placeholder="e.g. Personal"></label></div><div class="modal-actions"><button type="button" id="delete-task" class="delete-button hidden">Delete task</button><span class="action-spacer"></span><button type="button" id="cancel-modal" class="secondary-button">Cancel</button><button type="submit" class="primary-button">Save task</button></div></form></section></div>
+  <div id="toast" class="toast" role="status"></div>
+  <script src="app.js"></script>
+</body>
+</html>
