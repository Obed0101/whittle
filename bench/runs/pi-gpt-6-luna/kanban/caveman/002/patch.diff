diff --git a/board/app.js b/board/app.js
new file mode 100644
index 0000000..abdd601
--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,66 @@
+(() => {
+  const KEY='daymark-board-v1';
+  const initial=[
+    {id:'a1',title:'Plan the week ahead',description:'Choose three priorities and leave room for the unexpected.',status:'todo',priority:'high',tag:'Personal',due:day(1),created:Date.now()-600000,updated:Date.now()-600000},
+    {id:'a2',title:'Book a table for Friday',description:'Somewhere new, somewhere with good pasta.',status:'todo',priority:'normal',tag:'Personal',due:'',created:Date.now()-500000,updated:Date.now()-500000},
+    {id:'a3',title:'Read 20 pages',description:'Pick up where I left off in The Creative Act.',status:'todo',priority:'low',tag:'Growth',due:'',created:Date.now()-400000,updated:Date.now()-400000},
+    {id:'a4',title:'Send project update',description:'Share the latest mockups and confirm next steps with the team.',status:'doing',priority:'high',tag:'Work',due:day(0),created:Date.now()-300000,updated:Date.now()-300000},
+    {id:'a5',title:'Go for a lunchtime walk',description:'A little fresh air before the afternoon.',status:'doing',priority:'normal',tag:'Health',due:'',created:Date.now()-200000,updated:Date.now()-200000},
+    {id:'a6',title:'Tidy up the desk',description:'Clear the surface, reset the space.',status:'done',priority:'low',tag:'Personal',due:'',created:Date.now()-100000,updated:Date.now()-100000}
+  ];
+  function day(offset){const d=new Date();d.setDate(d.getDate()+offset);return localDate(d)}
+  function localDate(d){return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
+  let state;try{state=JSON.parse(localStorage.getItem(KEY))}catch{}if(!state||!Array.isArray(state.tasks)){state={tasks:initial,activity:[]};save()}
+  const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
+  let view='board',tab='board',filter='all',sort='recent',toastTimer;
+  const statuses=[['todo','To do'],['doing','In progress'],['done','Done']];
+  function save(){localStorage.setItem(KEY,JSON.stringify(state))}
+  function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+  function log(text){state.activity.unshift({text,time:Date.now()});state.activity=state.activity.slice(0,50)}
+  function niceDate(value){if(!value)return '';const d=new Date(value+'T00:00:00');return d.toLocaleDateString(undefined,{month:'short',day:'numeric'})}
+  function render(){
+    $('#date-label').textContent='YOUR SPACE · '+new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'}).toUpperCase();
+    $('#crumb-view').textContent=view==='today'?'Due today':view==='completed'?'Completed':'My board';
+    $('#page-title').textContent=view==='today'?'Make today count.':view==='completed'?'Look how far you’ve come.':'A little progress, every day.';
+    $('#page-subtitle').textContent=view==='today'?'A clear view of what needs your attention today.':view==='completed'?'Everything you’ve already brought across the finish line.':'Keep your focus close and your next step clear.';
+    $$('.nav-item').forEach(b=>b.classList.toggle('active',b.dataset.view===view));
+    const today=day(0);$('#today-count').textContent=state.tasks.filter(t=>t.status!=='done'&&t.due===today).length||'';
+    $('#all-count').textContent=state.tasks.filter(t=>t.status!=='done').length;
+    const needle=$('#search').value.trim().toLowerCase();
+    const selected=state.tasks.filter(t=>{
+      if(view==='completed'&&t.status!=='done')return false;if(view==='today'&&(t.status==='done'||t.due!==today))return false;
+      if(needle&&!`${t.title} ${t.description} ${t.tag}`.toLowerCase().includes(needle))return false;
+      if(filter==='overdue'&&(!t.due||t.due>=today||t.status==='done'))return false;
+      if(filter==='priority'&&t.priority!=='high')return false;if(filter==='tag'&&!t.tag)return false;return true;
+    });
+    $('#filter-dot').classList.toggle('on',filter!=='all');
+    $('#board-view').classList.toggle('hidden',tab!=='board');$('#activity-view').classList.toggle('hidden',tab!=='activity');
+    $$('.tab').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));
+    if(view==='completed'){
+      $('#board-view').innerHTML=`<div class="column completed-column" data-status="done"><div class="column-head"><div class="column-title"><span class="column-dot"></span>Completed <span class="column-count">${selected.length}</span></div></div><div class="cards">${selected.length?selected.map(card).join(''):'<div class="empty-column">Nothing completed yet. You’ve got this.</div>'}</div></div>`;
+    }else{
+      const cols=view==='today'?statuses.slice(0,2):statuses;
+      $('#board-view').innerHTML=cols.map(([status,label])=>{const cards=selected.filter(t=>t.status===status);const ordered=sort==='due'?[...cards].sort((a,b)=>(a.due||'9999').localeCompare(b.due||'9999')):sort==='priority'?[...cards].sort((a,b)=>({high:0,normal:1,low:2}[a.priority]-{high:0,normal:1,low:2}[b.priority])):cards.sort((a,b)=>b.created-a.created);return `<section class="column" data-status="${status}"><div class="column-head"><div class="column-title"><span class="column-dot"></span>${label}<span class="column-count">${cards.length}</span></div><button class="column-add" data-add="${status}" aria-label="Add to ${label}">＋</button></div><div class="cards" data-drop="${status}">${ordered.length?ordered.map(card).join(''):'<div class="empty-column">Nothing here just yet.</div>'}</div><button class="add-card" data-add="${status}">＋ &nbsp; Add a task</button></section>`}).join('');
+    }
+    $('#footer-summary').textContent=`${state.tasks.filter(t=>t.status==='doing').length} task${state.tasks.filter(t=>t.status==='doing').length===1?'':'s'} in progress`;
+    renderActivity();bindCards();
+  }
+  function card(t){const overdue=t.due&&t.due<day(0)&&t.status!=='done',today=t.due===day(0)&&t.status!=='done';return `<article class="task-card" draggable="true" data-id="${esc(t.id)}"><div class="card-top">${t.tag?`<span class="tag" data-tag="${esc(t.tag.toLowerCase())}">${esc(t.tag)}</span>`:'<span></span>'}<button class="card-menu" data-edit="${esc(t.id)}" aria-label="Edit ${esc(t.title)}">···</button></div><h3>${esc(t.title)}</h3>${t.description?`<p class="card-description">${esc(t.description)}</p>`:''}<div class="card-meta"><span class="due ${overdue?'overdue':today?'soon':t.status==='done'?'done-due':''}">${t.due?`<span class="due-icon">◷</span>${overdue?'Overdue · ':''}${niceDate(t.due)}`:t.priority==='high'?'<span class="priority">↑ High priority</span>':''}</span><span class="card-actions">${t.status!=='done'?`<button class="mini-action" data-move="${t.id}" title="Move to next column">${t.status==='todo'?'Start →':'Finish ✓'}</button>`:'<span>✓ Done</span>'}</span></div></article>`}
+  function bindCards(){ $$('[data-edit]').forEach(b=>b.onclick=e=>{e.stopPropagation();openModal(b.dataset.edit)});$$('.task-card').forEach(c=>{c.onclick=e=>{if(!e.target.closest('button'))openModal(c.dataset.id)};c.ondragstart=e=>{e.dataTransfer.setData('text/plain',c.dataset.id);c.classList.add('dragging')};c.ondragend=()=>c.classList.remove('dragging')});$$('[data-drop]').forEach(el=>{el.ondragover=e=>{e.preventDefault();el.classList.add('drag-over')};el.ondragleave=()=>el.classList.remove('drag-over');el.ondrop=e=>{e.preventDefault();el.classList.remove('drag-over');move(e.dataTransfer.getData('text/plain'),el.dataset.drop)}});$$('[data-add]').forEach(b=>b.onclick=()=>openModal(null,b.dataset.add));$$('[data-move]').forEach(b=>b.onclick=()=>{const t=state.tasks.find(t=>t.id===b.dataset.move);move(t.id,t.status==='todo'?'doing':'done')}) }
+  function move(id,status){const t=state.tasks.find(t=>t.id===id);if(!t||t.status===status)return;t.status=status;t.updated=Date.now();log(`${status==='done'?'Completed':'Moved'} <strong>${esc(t.title)}</strong> ${status==='doing'?'to In progress':status==='todo'?'to To do':''}`);save();render();notify(status==='done'?'Task completed. Nice work.':'Task moved.')}
+  function renderActivity(){const list=$('#activity-list');if(!state.activity.length){list.innerHTML='<div class="no-activity">Your activity will show up here as you go.</div>';return}list.innerHTML=state.activity.map(a=>`<div class="activity-row"><span class="activity-avatar">✓</span><div class="activity-copy">${a.text}</div><span class="activity-time">${timeAgo(a.time)}</span></div>`).join('')}
+  function timeAgo(time){const n=Math.max(0,Math.floor((Date.now()-time)/60000));return n<1?'just now':n<60?`${n}m ago`:n<1440?`${Math.floor(n/60)}h ago`:new Date(time).toLocaleDateString(undefined,{month:'short',day:'numeric'})}
+  function openModal(id,status='todo'){const t=state.tasks.find(x=>x.id===id);$('#task-form').reset();$('#task-id').value=t?.id||'';$('#modal-title').textContent=t?'Edit task':'Add a task';$('#task-title').value=t?.title||'';$('#task-description').value=t?.description||'';$('#task-status').value=t?.status||status;$('#task-priority').value=t?.priority||'normal';$('#task-due').value=t?.due||'';$('#task-tag').value=t?.tag||'';$('#delete-task').classList.toggle('hidden',!t);$('#modal-backdrop').classList.remove('hidden');setTimeout(()=>$('#task-title').focus(),30)}
+  function closeModal(){$('#modal-backdrop').classList.add('hidden')}
+  function notify(msg){const el=$('#toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2300)}
+  $('#task-form').onsubmit=e=>{e.preventDefault();const id=$('#task-id').value,title=$('#task-title').value.trim();if(!title)return;const data={title,description:$('#task-description').value.trim(),status:$('#task-status').value,priority:$('#task-priority').value,due:$('#task-due').value,tag:$('#task-tag').value.trim()};if(id){const t=state.tasks.find(x=>x.id===id);Object.assign(t,data,{updated:Date.now()});log(`Updated <strong>${esc(title)}</strong>`)}else{state.tasks.push({id:crypto.randomUUID?crypto.randomUUID():String(Date.now()),...data,created:Date.now(),updated:Date.now()});log(`Added <strong>${esc(title)}</strong>`)}save();closeModal();render();notify(id?'Task updated.':'Task added.')};
+  $('#delete-task').onclick=()=>{const id=$('#task-id').value,t=state.tasks.find(x=>x.id===id);if(!t)return;if(!confirm(`Delete “${t.title}”? This cannot be undone.`))return;state.tasks=state.tasks.filter(x=>x.id!==id);log(`Deleted <strong>${esc(t.title)}</strong>`);save();closeModal();render();notify('Task deleted.')};
+  $('#close-modal').onclick=$('#cancel-modal').onclick=closeModal;$('#modal-backdrop').onclick=e=>{if(e.target.id==='modal-backdrop')closeModal()};
+  $$('.nav-item').forEach(b=>b.onclick=()=>{view=b.dataset.view;tab='board';render()});$$('.tab').forEach(b=>b.onclick=()=>{tab=b.dataset.tab;render()});
+  $('#add-task').onclick=()=>openModal();$('#search').oninput=render;$('#filter-btn').onclick=()=>$('#filter-panel').classList.toggle('hidden');$$('.filter-chip').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;$$('.filter-chip').forEach(x=>x.classList.toggle('active',x===b));render()});
+  $('#sort-btn').onclick=()=>{sort=sort==='recent'?'due':sort==='due'?'priority':'recent';$('#sort-btn').querySelector('span').textContent=sort==='recent'?'Recently added':sort==='due'?'Due date':'Priority';render()};
+  $('#export-btn').onclick=()=>{const blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`daymark-board-${day(0)}.json`;a.click();URL.revokeObjectURL(a.href);notify('Board exported.')};
+  $('#import-input').onchange=async e=>{try{const data=JSON.parse(await e.target.files[0].text());if(!Array.isArray(data.tasks))throw Error();if(!confirm('Replace your current board with this backup?'))return;state={tasks:data.tasks,activity:Array.isArray(data.activity)?data.activity:[]};save();render();notify('Board imported.')}catch{notify('That file is not a valid Daymark backup.')}e.target.value=''};
+  $('#help-btn').onclick=()=>alert('Keyboard shortcuts\n\nN — Add a task\n/ — Search tasks\nEsc — Close dialog');document.onkeydown=e=>{if(e.key==='Escape')closeModal();if(e.key.toLowerCase()==='n'&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName)&&$('#modal-backdrop').classList.contains('hidden'))openModal();if(e.key==='/'&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();$('#search').focus()}};
+  render();
+})();
