+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
+<meta name="theme-color" content="#f6f7f4"><title>Dayboard — Personal Kanban</title>
+<link rel="stylesheet" href="styles.css">
+</head>
+<body>
+<div class="app-shell">
+<aside class="sidebar">
+  <a class="brand" href="#" aria-label="Dayboard home"><span class="brand-mark">d</span><span>dayboard<span class="brand-dot">.</span></span></a>
+  <div class="workspace"><div class="avatar">M</div><div><strong>My workspace</strong><small>Personal board</small></div><span class="chevron">⌄</span></div>
+  <div class="nav-label">WORKSPACE</div>
+  <button class="nav-item active"><span class="nav-icon">▦</span> My board <span class="nav-count" id="nav-count">0</span></button>
+  <button class="nav-item" id="focus-filter"><span class="nav-icon">◷</span> Due soon</button>
+  <button class="nav-item" id="done-filter"><span class="nav-icon">✓</span> Completed</button>
+  <div class="sidebar-bottom"><div class="tip-card"><div class="tip-icon">✳</div><strong>Make space for focus.</strong><p>A little progress each day adds up to a lot.</p></div><button class="profile"><span class="profile-avatar">M</span><span><strong>Morgan Lee</strong><small>Personal plan</small></span><span class="more">···</span></button></div>
+</aside>
+<main class="main">
+<header class="topbar"><div class="breadcrumbs">Workspace <span>/</span> <strong>My board</strong></div><div class="top-actions"><label class="search"><span>⌕</span><input id="search" placeholder="Search tasks..." aria-label="Search tasks"><kbd>⌘ K</kbd></label><button class="icon-button" id="help-btn" aria-label="Keyboard shortcuts">?</button><button class="avatar top-avatar" aria-label="Profile">M</button></div></header>
+<section class="content"><div class="board-heading"><div><div class="eyebrow"><span class="live-dot"></span> YOUR SPACE, YOUR PACE</div><h1>My board <button class="title-menu" aria-label="Board menu">⌄</button></h1><p class="subtitle">A clear mind starts with a clear view.</p></div><div class="heading-actions"><button class="button secondary" id="sort-btn">↕ <span>Sort</span></button><button class="button secondary" id="filter-btn">☷ <span>Filter</span><span class="filter-indicator" id="filter-indicator"></span></button><button class="button primary" id="add-task"><span>＋</span> New task</button></div></div>
+<div class="board-meta"><div class="view-tabs"><button class="view-tab selected">Board <span class="tab-line"></span></button><button class="view-tab" id="list-view-btn">List</button></div><div class="meta-right"><span class="updated-label" id="board-summary">0 tasks in motion</span><button class="more-button" id="board-menu" aria-label="Board options">···</button></div></div>
+<div class="board" id="board"></div><section class="list-view hidden" id="list-view"></section>
+<div class="board-footer"><span><i class="live-dot"></i> <span id="footer-count">0 tasks</span> across your board</span><span>Changes saved automatically</span></div>
+</section>
+</main>
+</div>
+<div class="modal-backdrop hidden" id="modal-backdrop"><section class="task-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title"><div class="modal-head"><div><div class="eyebrow">TASK DETAILS</div><h2 id="modal-title">Create a task</h2></div><button class="close-button" id="close-modal" aria-label="Close">×</button></div><form id="task-form"><input type="hidden" id="task-id"><label class="field-label" for="task-title">Task name</label><input class="text-field title-input" id="task-title" placeholder="What needs to get done?" required maxlength="120"><label class="field-label" for="task-description">Description <span>OPTIONAL</span></label><textarea class="text-field" id="task-description" rows="3" placeholder="Add a few details..."></textarea><div class="field-row"><div><label class="field-label" for="task-column">Status</label><select class="text-field" id="task-column"><option value="todo">To do</option><option value="doing">In progress</option><option value="done">Done</option></select></div><div><label class="field-label" for="task-priority">Priority</label><select class="text-field" id="task-priority"><option value="low">Low</option><option value="medium" selected>Medium</option><option value="high">High</option></select></div></div><div class="field-row"><div><label class="field-label" for="task-date">Due date <span>OPTIONAL</span></label><input class="text-field" type="date" id="task-date"></div><div><label class="field-label" for="task-label">Label <span>OPTIONAL</span></label><select class="text-field" id="task-label"><option value="">No label</option><option>Work</option><option>Personal</option><option>Ideas</option><option>Errand</option></select></div></div><div class="modal-actions"><button type="button" class="delete-button hidden" id="delete-task">Delete task</button><span class="modal-spacer"></span><button type="button" class="button secondary" id="cancel-modal">Cancel</button><button class="button primary" type="submit" id="save-task">Create task</button></div></form></section></div>
+<div class="toast" id="toast" role="status"></div><div class="popover hidden" id="popover"></div>
+<script src="app.js"></script>
+</body></html>
