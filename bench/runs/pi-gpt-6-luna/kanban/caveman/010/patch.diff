--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,37 @@
+(() => {
+const KEY='dayboard.tasks.v1';
+const defaults=[
+{id:'seed1',title:'Plan the week ahead',description:'Choose the few things that would make this week feel successful.',column:'todo',priority:'medium',label:'Personal',due:'',created:1},
+{id:'seed2',title:'Review and tidy up my notes',description:'Clear out the loose ends from last week.',column:'todo',priority:'low',label:'Work',due:'',created:2},
+{id:'seed3',title:'Book a dentist appointment',description:'Find a morning slot that works.',column:'todo',priority:'low',label:'Errand',due:'',created:3},
+{id:'seed4',title:'Draft the project outline',description:'Get the main ideas down before polishing.',column:'doing',priority:'high',label:'Work',due:'',created:4},
+{id:'seed5',title:'Go for a lunchtime walk',description:'A little fresh air goes a long way.',column:'doing',priority:'medium',label:'Personal',due:'',created:5},
+{id:'seed6',title:'Set up my reading list',description:'Add a few books for the month ahead.',column:'done',priority:'low',label:'Ideas',due:'',created:6}
+];
+let tasks;try{const saved=JSON.parse(localStorage.getItem(KEY));tasks=Array.isArray(saved)?saved:defaults}catch{tasks=defaults}
+let activeFilter='all',query='',listMode=false,sortMode='created',toastTimer;
+const $=id=>document.getElementById(id), board=$('board'), modal=$('modal-backdrop'), form=$('task-form'), popover=$('popover');
+const columns=[['todo','To do','todo-dot'],['doing','In progress','doing-dot'],['done','Done','done-dot']];
+function persist(){localStorage.setItem(KEY,JSON.stringify(tasks));render()}
+function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+function dateText(v){if(!v)return'';const d=new Date(v+'T12:00:00');return d.toLocaleDateString(undefined,{month:'short',day:'numeric'})}
+function dueClass(v){if(!v)return'';const today=new Date();today.setHours(0,0,0,0);const d=new Date(v+'T00:00:00');if(d<today)return'overdue';const soon=new Date(today);soon.setDate(soon.getDate()+2);return d<=soon?'soon':''}
+function filtered(){return tasks.filter(t=>{const text=(t.title+' '+(t.description||'')+' '+(t.label||'')).toLowerCase();if(query&&!text.includes(query.toLowerCase()))return false;if(activeFilter==='due'){const now=new Date();now.setHours(0,0,0,0);return t.column!=='done'&&t.due&&new Date(t.due+'T00:00:00')<=new Date(now.getTime()+7*86400000)}if(activeFilter==='done')return t.column==='done';return true})}
+function card(t){const due=t.due?`<span class="due ${dueClass(t.due)}">◷ ${dateText(t.due)}</span>`:'';return `<article class="task-card" draggable="true" data-id="${esc(t.id)}"><div class="card-top"><span class="tag ${esc(t.label||'')}">${esc(t.label||'No label')}</span><button class="card-menu" data-menu="${esc(t.id)}" aria-label="Task options">···</button></div><h3 class="card-title">${esc(t.title)}</h3>${t.description?`<p class="card-description">${esc(t.description)}</p>`:''}<div class="card-bottom"><div class="card-actions"><button class="check-button" data-check="${esc(t.id)}" aria-label="${t.column==='done'?'Reopen':'Mark complete'}">${t.column==='done'?'✓':''}</button><span class="priority ${esc(t.priority)}"><i></i>${esc((t.priority||'medium')[0].toUpperCase()+(t.priority||'medium').slice(1))}</span></div>${due}</div></article>`}
+function render(){const items=filtered();$('nav-count').textContent=tasks.filter(t=>t.column!=='done').length;$('board-summary').textContent=`${tasks.length} ${tasks.length===1?'task':'tasks'} in motion`;$('footer-count').textContent=`${tasks.length} ${tasks.length===1?'task':'tasks'}`;
+board.innerHTML=columns.map(([id,name,dot])=>{let list=items.filter(t=>t.column===id);if(sortMode==='due')list.sort((a,b)=>(a.due||'9999').localeCompare(b.due||'9999'));if(sortMode==='priority')list.sort((a,b)=>({high:0,medium:1,low:2}[a.priority]-({high:0,medium:1,low:2}[b.priority])));return `<section class="column" data-column="${id}"><div class="column-head"><i class="status-dot ${dot}"></i><h2>${name}</h2><span class="column-count">${list.length}</span><button class="column-add" data-add="${id}" aria-label="Add ${name} task">＋</button></div><div class="task-list" data-drop="${id}">${list.length?list.map(card).join(''):`<div class="column-empty" data-add="${id}">${query?'No matching tasks':'Drop a task here or add one'}</div>`}</div></section>`}).join('');
+$('list-view').innerHTML=`<div class="list-row list-header"><span>Task</span><span>Status</span><span>Priority</span><span>Due date</span><span></span></div>${items.map(t=>`<div class="list-row"><span class="list-name">${esc(t.title)}</span><span>${columns.find(c=>c[0]===t.column)?.[1]}</span><span class="priority ${esc(t.priority)}"><i></i>${esc(t.priority)}</span><span>${dateText(t.due)||'—'}</span><button class="card-menu" data-edit="${esc(t.id)}">···</button></div>`).join('')||'<div class="column-empty">Nothing to show</div>'}`;
+board.classList.toggle('hidden',listMode);$('list-view').classList.toggle('hidden',!listMode);document.querySelectorAll('.view-tab').forEach((b,i)=>b.classList.toggle('selected',i===(listMode?1:0)));document.querySelectorAll('.view-tab').forEach((b,i)=>{let line=b.querySelector('.tab-line');if(line)line.remove();if(i===(listMode?1:0)){const span=document.createElement('span');span.className='tab-line';b.append(span)}})
+}
+function openModal(id='',column='todo'){form.reset();const t=tasks.find(x=>x.id===id);$('task-id').value=t?.id||'';$('task-title').value=t?.title||'';$('task-description').value=t?.description||'';$('task-column').value=t?.column||column;$('task-priority').value=t?.priority||'medium';$('task-date').value=t?.due||'';$('task-label').value=t?.label||'';$('modal-title').textContent=t?'Edit task':'Create a task';$('save-task').textContent=t?'Save changes':'Create task';$('delete-task').classList.toggle('hidden',!t);modal.classList.remove('hidden');setTimeout(()=>$('task-title').focus(),50)}
+function closeModal() {modal.classList.add('hidden')}
+function toast(msg){const el=$('toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200)}
+function showMenu(button,html){const r=button.getBoundingClientRect();popover.innerHTML=html;popover.style.left=Math.min(r.left,innerWidth-170)+'px';popover.style.top=Math.min(r.bottom+4,innerHeight-140)+'px';popover.classList.remove('hidden')}
+form.addEventListener('submit',e=>{e.preventDefault();const id=$('task-id').value;const data={title:$('task-title').value.trim(),description:$('task-description').value.trim(),column:$('task-column').value,priority:$('task-priority').value,due:$('task-date').value,label:$('task-label').value};if(!data.title)return;if(id){Object.assign(tasks.find(t=>t.id===id),data);toast('Task updated')}else{tasks.unshift({...data,id:crypto.randomUUID?.()||String(Date.now()),created:Date.now()});toast('Task added')}closeModal();persist()});
+$('add-task').onclick=()=>openModal();$('close-modal').onclick=closeModal;$('cancel-modal').onclick=closeModal;modal.addEventListener('click',e=>{if(e.target===modal)closeModal()});$('delete-task').onclick=()=>{const id=$('task-id').value;tasks=tasks.filter(t=>t.id!==id);closeModal();persist();toast('Task deleted')};
+$('search').addEventListener('input',e=>{query=e.target.value;render()});$('focus-filter').onclick=()=>setFilter(activeFilter==='due'?'all':'due');$('done-filter').onclick=()=>setFilter(activeFilter==='done'?'all':'done');function setFilter(v){activeFilter=v;$('focus-filter').classList.toggle('active',v==='due');$('done-filter').classList.toggle('active',v==='done');$('filter-indicator').classList.toggle('on',v!=='all');render()}
+$('filter-btn').onclick=e=>showMenu(e.currentTarget,`<button data-filter="all">All tasks</button><button data-filter="due">Due in 7 days</button><button data-filter="done">Completed</button>`);$('sort-btn').onclick=e=>showMenu(e.currentTarget,`<button data-sort="created">Recently added</button><button data-sort="due">Due date</button><button data-sort="priority">Priority</button>`);$('board-menu').onclick=e=>showMenu(e.currentTarget,`<button data-export>Export board as JSON</button><button data-reset>Restore sample tasks</button>`);$('help-btn').onclick=()=>toast('Tip: press ⌘/Ctrl + K to search, Esc to close');$('list-view-btn').onclick=()=>{listMode=true;render()};document.querySelector('.view-tab').onclick=()=>{listMode=false;render()};
+document.addEventListener('click',e=>{const add=e.target.closest('[data-add]');if(add){openModal('',add.dataset.add);return}const menu=e.target.closest('[data-menu]');if(menu){const id=menu.dataset.menu;showMenu(menu,`<button data-edit="${id}">Edit task</button><button data-move="${id}" data-to="todo">Move to To do</button><button data-move="${id}" data-to="doing">Move to In progress</button><button data-move="${id}" data-to="done">Move to Done</button><button class="danger" data-delete="${id}">Delete task</button>`);return}const check=e.target.closest('[data-check]');if(check){const t=tasks.find(x=>x.id===check.dataset.check);t.column=t.column==='done'?'todo':'done';persist();toast(t.column==='done'?'Task completed':'Task reopened');return}const edit=e.target.closest('[data-edit]');if(edit){popover.classList.add('hidden');openModal(edit.dataset.edit);return}const del=e.target.closest('[data-delete]');if(del){tasks=tasks.filter(t=>t.id!==del.dataset.delete);popover.classList.add('hidden');persist();toast('Task deleted');return}const move=e.target.closest('[data-move]');if(move){const t=tasks.find(x=>x.id===move.dataset.move);t.column=move.dataset.to;popover.classList.add('hidden');persist();return}const filter=e.target.closest('[data-filter]');if(filter){setFilter(filter.dataset.filter);popover.classList.add('hidden');return}const sort=e.target.closest('[data-sort]');if(sort){sortMode=sort.dataset.sort;popover.classList.add('hidden');render();return}if(e.target.closest('[data-export]')){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(tasks,null,2)],{type:'application/json'}));a.download='dayboard-backup.json';a.click();URL.revokeObjectURL(a.href);popover.classList.add('hidden');toast('Board exported');return}if(e.target.closest('[data-reset]')){if(confirm('Restore sample tasks? This replaces your current board.')){tasks=defaults.map(t=>({...t}));persist();toast('Sample board restored')}popover.classList.add('hidden');return}if(!e.target.closest('#popover'))popover.classList.add('hidden')});
+let dragging=null;board.addEventListener('dragstart',e=>{const c=e.target.closest('.task-card');if(!c)return;dragging=c.dataset.id;c.classList.add('dragging');e.dataTransfer.effectAllowed='move'});board.addEventListener('dragend',e=>{e.target.closest('.task-card')?.classList.remove('dragging');document.querySelectorAll('.task-list').forEach(x=>x.classList.remove('drag-over'))});board.addEventListener('dragover',e=>{const list=e.target.closest('[data-drop]');if(list){e.preventDefault();list.classList.add('drag-over')}});board.addEventListener('dragleave',e=>{if(!e.target.closest('[data-drop]'))return;const list=e.target.closest('[data-drop]');if(!list.contains(e.relatedTarget))list.classList.remove('drag-over')});board.addEventListener('drop',e=>{const list=e.target.closest('[data-drop]');if(!list||!dragging)return;e.preventDefault();const t=tasks.find(x=>x.id===dragging);if(t){t.column=list.dataset.drop;persist()}dragging=null});
+document.addEventListener('keydown',e=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();$('search').focus()}if(e.key==='Escape'){closeModal();popover.classList.add('hidden')}});render();
+})();
