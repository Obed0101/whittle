diff --git a/board/app.js b/board/app.js
new file mode 100644
index 0000000..c99e5ce
--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,46 @@
+(() => {
+  'use strict';
+  const KEY = 'daymark-board-v1';
+  const columns = [{id:'todo',title:'Up next'},{id:'doing',title:'In progress'},{id:'done',title:'Done'}];
+  const $ = id => document.getElementById(id);
+  const board = $('board');
+  let tasks = load(), priorityFilter = 'all', todayOnly = false, toastTimer;
+  function load(){try{const value=JSON.parse(localStorage.getItem(KEY));return Array.isArray(value)?value.filter(t=>t&&t.id&&t.title&&columns.some(c=>c.id===t.status)):[]}catch{return[]}}
+  function save(){localStorage.setItem(KEY,JSON.stringify(tasks));}
+  function uid(){return (crypto.randomUUID?crypto.randomUUID():Date.now().toString(36)+Math.random().toString(36).slice(2))}
+  function dateOnly(value){return value?new Date(value+'T00:00:00'):null}
+  function todayString(){const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
+  function esc(value=''){return String(value).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+  function prettyDate(value){const d=dateOnly(value);if(!d)return '';return d.toLocaleDateString(undefined,{month:'short',day:'numeric'})}
+  function visible(task){const q=$('searchInput').value.trim().toLowerCase();return (!q||[task.title,task.description,task.tag].some(v=>(v||'').toLowerCase().includes(q)))&&(priorityFilter==='all'||task.priority===priorityFilter)&&(!todayOnly||task.due===todayString())&&(!$('hideDone').checked||task.status!=='done')}
+  function render(){
+    const sorted=[...tasks];const sort=$('sortSelect').value;
+    if(sort==='due')sorted.sort((a,b)=>(a.due||'9999').localeCompare(b.due||'9999'));
+    if(sort==='priority'){const rank={high:0,medium:1,low:2};sorted.sort((a,b)=>(rank[a.priority]??2)-(rank[b.priority]??2))}
+    if(sort==='created')sorted.sort((a,b)=>(b.created||0)-(a.created||0));
+    board.innerHTML=columns.map(col=>{const items=sorted.filter(t=>t.status===col.id&&visible(t));const total=tasks.filter(t=>t.status===col.id).length;return `<section class="column" data-status="${col.id}"><header class="column-header"><i class="column-dot"></i><h2>${col.title}</h2><span class="column-count">${total}</span><button class="column-add" data-add="${col.id}" aria-label="Add task to ${col.title}" title="Add task">＋</button></header><div class="card-list" data-drop="${col.id}">${items.length?items.map(card).join(''):`<div class="empty-state"><span class="empty-icon">${col.id==='done'?'✳':'○'}</span><strong>${col.id==='todo'?'A clear space.':'Nothing here yet.'}</strong><span>${col.id==='todo'?'Add a task when it comes to mind.':'Move a task here when it feels right.'}</span></div>`}</div><button class="column-add-card" data-add="${col.id}">＋ Add a task</button></section>`}).join('');
+    const active=tasks.filter(t=>t.status==='doing').length,done=tasks.filter(t=>t.status==='done').length,completedRecent=tasks.filter(t=>t.status==='done'&&t.completedAt&&Date.now()-t.completedAt<7*86400000).length;
+    $('progressStat').textContent=active;$('doneStat').textContent=done;$('navCount').textContent=tasks.length;$('allCount').textContent=tasks.length;$('todayCount').textContent=tasks.filter(t=>t.due===todayString()).length;$('footerCount').textContent=`${tasks.length} task${tasks.length===1?'':'s'} on your board`;
+    const pct=Math.min(100,completedRecent*20);$('momentum').textContent=pct+'%';$('momentumBar').style.width=pct+'%';$('filterDot').parentElement.classList.toggle('has-filter',priorityFilter!=='all'||$('hideDone').checked);$('todayTab').classList.toggle('selected',todayOnly);$('allTab').classList.toggle('selected',!todayOnly);
+  }
+  function card(t){const due=t.due?`<span class="due-date ${t.status!=='done'&&t.due<todayString()?'overdue':t.due===todayString()?'today':''}">${t.due<todayString()&&t.status!=='done'?'Overdue · ':''}${esc(prettyDate(t.due))}</span>`:'';return `<article class="task-card ${t.status==='done'?'completed':''}" draggable="true" data-id="${esc(t.id)}"><div class="card-top"><span class="priority ${esc(t.priority||'low')}">${esc(t.priority||'low')} priority</span><button class="card-menu" data-edit="${esc(t.id)}" aria-label="Edit ${esc(t.title)}" title="Edit task">···</button></div><div class="task-title">${esc(t.title)}</div>${t.description?`<p class="task-description">${esc(t.description)}</p>`:''}<div class="card-footer">${t.tag?`<span class="task-tag">${esc(t.tag)}</span>`:''}${due}</div></article>`}
+  function openTask(id='',status='todo'){const t=tasks.find(x=>x.id===id);$('taskForm').reset();$('taskId').value=t?.id||'';$('taskTitle').value=t?.title||'';$('taskDescription').value=t?.description||'';$('taskStatus').value=t?.status||status;$('taskPriority').value=t?.priority||'medium';$('taskDue').value=t?.due||'';$('taskTag').value=t?.tag||'';$('dialogTitle').textContent=t?'Edit task':'New task';$('deleteTask').hidden=!t;$('taskDialog').showModal();setTimeout(()=>$('taskTitle').focus(),50)}
+  function notify(text){const el=$('toast');el.textContent=text;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200)}
+  $('taskForm').addEventListener('submit',e=>{if(e.submitter?.id!=='saveTask')return;e.preventDefault();const id=$('taskId').value,old=tasks.find(t=>t.id===id);const task={id:id||uid(),title:$('taskTitle').value.trim(),description:$('taskDescription').value.trim(),status:$('taskStatus').value,priority:$('taskPriority').value,due:$('taskDue').value,tag:$('taskTag').value.trim(),created:old?.created||Date.now(),completedAt:$('taskStatus').value==='done'?(old?.completedAt||Date.now()):null};if(!task.title)return;if(old)tasks=tasks.map(t=>t.id===id?task:t);else tasks.unshift(task);save();render();$('taskDialog').close();notify(old?'Task updated':'Task added');});
+  $('deleteTask').onclick=()=>{const id=$('taskId').value;tasks=tasks.filter(t=>t.id!==id);save();render();$('taskDialog').close();notify('Task deleted')};$('closeDialog').onclick=$('cancelDialog').onclick=()=>$('taskDialog').close();
+  $('addTaskTop').onclick=()=>openTask();$('filterBtn').onclick=()=>$('filterPanel').hidden=!$('filterPanel').hidden;
+  board.addEventListener('click',e=>{const add=e.target.closest('[data-add]'),edit=e.target.closest('[data-edit]');if(add)openTask('',add.dataset.add);if(edit)openTask(edit.dataset.edit)});
+  board.addEventListener('dragstart',e=>{const c=e.target.closest('.task-card');if(!c)return;e.dataTransfer.setData('text/plain',c.dataset.id);e.dataTransfer.effectAllowed='move';setTimeout(()=>c.classList.add('dragging'),0)});
+  board.addEventListener('dragend',e=>{e.target.closest('.task-card')?.classList.remove('dragging');document.querySelectorAll('.column').forEach(c=>c.classList.remove('drag-over'))});
+  board.addEventListener('dragover',e=>{const target=e.target.closest('.column');if(target){e.preventDefault();document.querySelectorAll('.column').forEach(c=>c.classList.toggle('drag-over',c===target))}});
+  board.addEventListener('drop',e=>{const col=e.target.closest('.column'),id=e.dataTransfer.getData('text/plain');if(!col||!id)return;e.preventDefault();const t=tasks.find(x=>x.id===id);if(t){t.status=col.dataset.status;t.completedAt=t.status==='done'?(t.completedAt||Date.now()):null;save();render()}});
+  $('searchInput').oninput=render;$('sortSelect').onchange=render;$('hideDone').onchange=render;
+  $('filterPanel').addEventListener('click',e=>{if(e.target.matches('[data-priority]')){priorityFilter=e.target.dataset.priority;$('filterPanel').querySelectorAll('.filter-chip').forEach(b=>b.classList.toggle('active',b===e.target));render()}if(e.target.id==='clearFilters'){priorityFilter='all';$('hideDone').checked=false;$('filterPanel').querySelector('[data-priority="all"]').classList.add('active');$('filterPanel').querySelectorAll('[data-priority]:not([data-priority="all"])').forEach(b=>b.classList.remove('active'));render()}});
+  $('todayTab').onclick=()=>{todayOnly=true;render()};$('allTab').onclick=()=>{todayOnly=false;render()};$('focusNav').onclick=()=>{todayOnly=true;render();board.scrollIntoView({behavior:'smooth',block:'start'})};
+  $('exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify({version:1,exported:new Date().toISOString(),tasks},null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`daymark-${todayString()}.json`;a.click();URL.revokeObjectURL(a.href);notify('Board backup downloaded')};
+  $('importBtn').onclick=()=>$('importFile').click();$('importFile').onchange=async e=>{const file=e.target.files[0];if(!file)return;try{const data=JSON.parse(await file.text()),incoming=Array.isArray(data)?data:data.tasks;if(!Array.isArray(incoming)||!incoming.every(t=>t&&typeof t.title==='string'&&columns.some(c=>c.id===t.status)))throw Error();if(!confirm(`Import ${incoming.length} tasks? This replaces your current board.`))return;tasks=incoming.map(t=>({...t,id:String(t.id||uid()),priority:['high','medium','low'].includes(t.priority)?t.priority:'medium'}));save();render();notify('Board imported')}catch{notify('That backup file could not be read')}finally{e.target.value=''}};
+  $('helpBtn').onclick=()=>$('helpDialog').showModal();$('closeHelp').onclick=$('doneHelp').onclick=()=>$('helpDialog').close();
+  document.addEventListener('keydown',e=>{if(e.key==='Escape')return;if(['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName)||$('taskDialog').open||$('helpDialog').open)return;if(e.key.toLowerCase()==='n'){e.preventDefault();openTask()}if(e.key==='/'){e.preventDefault();$('searchInput').focus()}});
+  const hour=new Date().getHours();$('greeting').textContent=hour<12?'A fresh start.':hour<17?'Make some room to focus.':'A good day, well spent.';$('todayText').textContent=new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'})+' · Make today count, at your own pace.';
+  render();
+})();
diff --git a/board/index.html b/board/index.html
new file mode 100644
index 0000000..45342f1
--- /dev/null
+++ b/board/index.html
@@ -0,0 +1,41 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="theme-color" content="#f6f5f1">
+  <title>Daymark — Personal kanban</title>
+  <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+  <div class="app-shell">
+    <aside class="sidebar">
+      <a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d.</span><span>daymark</span></a>
+      <div class="workspace"><div class="avatar">Y</div><div><strong>Your workspace</strong><small>Personal space</small></div><span class="dots">•••</span></div>
+      <div class="nav-label">WORKSPACE</div>
+      <button class="nav-item active"><span class="nav-icon">▦</span> My board <span class="nav-count" id="navCount">0</span></button>
+      <button class="nav-item" id="focusNav"><span class="nav-icon">◷</span> Focus today</button>
+      <div class="side-bottom">
+        <div class="quote-card"><span class="quote-spark">✳</span><p>Make room for<br><strong>what matters.</strong></p><small>One thing at a time.</small></div>
+        <button class="nav-item" id="exportBtn"><span class="nav-icon">↥</span> Export board</button>
+        <button class="nav-item" id="importBtn"><span class="nav-icon">↧</span> Import backup</button>
+        <input type="file" id="importFile" accept="application/json,.json" hidden>
+        <div class="profile"><div class="avatar profile-avatar">Y</div><div><strong>Your board</strong><small>Saved on this device</small></div><span class="online-dot"></span></div>
+      </div>
+    </aside>
+    <main class="main">
+      <header class="topbar"><div class="breadcrumbs">Workspace <span>/</span> <strong>My board</strong></div><div class="top-actions"><span class="saved-status"><i></i> All changes saved</span><button class="icon-button" id="helpBtn" aria-label="Keyboard shortcuts" title="Keyboard shortcuts">?</button></div></header>
+      <section class="board-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span> YOUR PERSONAL SPACE</div><h1>My board<span class="title-period">.</span></h1><p class="subtitle">A little clarity goes a long way.</p></div><button class="primary-button" id="addTaskTop"><span>＋</span> Add a task <kbd>N</kbd></button></section>
+      <section class="overview" aria-label="Board overview"><div class="overview-intro"><span class="sun-icon">☼</span><div><strong id="greeting">A fresh start.</strong><span id="todayText">Make today count, at your own pace.</span></div></div><div class="stat"><span class="stat-label">IN PROGRESS</span><strong id="progressStat">0</strong></div><div class="stat"><span class="stat-label">COMPLETED</span><strong id="doneStat">0</strong></div><div class="completion-wrap"><div class="completion-copy"><span>WEEKLY MOMENTUM</span><strong id="momentum">0%</strong></div><div class="progress-track"><div id="momentumBar"></div></div></div></section>
+      <div class="toolbar"><div class="view-tabs"><button class="view-tab selected" id="allTab">All tasks <span id="allCount">0</span></button><button class="view-tab" id="todayTab">Due today <span id="todayCount">0</span></button></div><div class="tools"><label class="search-box"><span>⌕</span><input id="searchInput" type="search" placeholder="Search tasks..." aria-label="Search tasks"><kbd>/</kbd></label><select id="sortSelect" aria-label="Sort tasks"><option value="manual">Board order</option><option value="due">Due date</option><option value="priority">Priority</option><option value="created">Recently added</option></select><button class="filter-button" id="filterBtn">☷ <span>Filters</span><b id="filterDot"></b></button></div></div>
+      <div class="filter-panel" id="filterPanel" hidden><span>PRIORITY</span><button data-priority="all" class="filter-chip active">All</button><button data-priority="high" class="filter-chip">High</button><button data-priority="medium" class="filter-chip">Medium</button><button data-priority="low" class="filter-chip">Low</button><span class="filter-divider"></span><label><input type="checkbox" id="hideDone"> Hide completed</label><button id="clearFilters">Clear filters</button></div>
+      <section class="board" id="board" aria-label="Kanban board"></section>
+      <footer class="board-footer"><span><span class="keyboard-icon">⌘</span> Drag cards to move them between lists</span><span id="footerCount">0 tasks on your board</span></footer>
+    </main>
+  </div>
+  <dialog id="taskDialog"><form method="dialog" id="taskForm"><div class="dialog-top"><div><div class="eyebrow"><span class="eyebrow-line"></span> TASK DETAILS</div><h2 id="dialogTitle">New task</h2></div><button type="button" class="close-button" id="closeDialog" aria-label="Close">×</button></div><input type="hidden" id="taskId"><label class="field-label" for="taskTitle">Task name</label><input class="text-field title-field" id="taskTitle" maxlength="120" placeholder="What needs to get done?" required><label class="field-label" for="taskDescription">Notes <span>OPTIONAL</span></label><textarea class="text-field" id="taskDescription" rows="3" maxlength="600" placeholder="Add a little context..."></textarea><div class="field-row"><div><label class="field-label" for="taskStatus">List</label><select class="text-field" id="taskStatus"><option value="todo">Up next</option><option value="doing">In progress</option><option value="done">Done</option></select></div><div><label class="field-label" for="taskPriority">Priority</label><select class="text-field" id="taskPriority"><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option></select></div></div><div class="field-row"><div><label class="field-label" for="taskDue">Due date <span>OPTIONAL</span></label><input class="text-field" id="taskDue" type="date"></div><div><label class="field-label" for="taskTag">Label <span>OPTIONAL</span></label><input class="text-field" id="taskTag" maxlength="24" placeholder="e.g. Personal"></div></div><div class="dialog-actions"><button type="button" class="delete-button" id="deleteTask" hidden>Delete task</button><span></span><button type="button" class="secondary-button" id="cancelDialog">Cancel</button><button class="primary-button" id="saveTask">Save task</button></div></form></dialog>
+  <dialog id="helpDialog"><div class="help-content"><button class="close-button help-close" id="closeHelp">×</button><div class="eyebrow"><span class="eyebrow-line"></span> QUICK TIP</div><h2>Keep your day in flow.</h2><p>Capture what’s on your mind, then move one thing forward. Your board saves automatically in this browser.</p><div class="shortcut-row"><span>Add a task</span><kbd>N</kbd></div><div class="shortcut-row"><span>Search your board</span><kbd>/</kbd></div><div class="shortcut-row"><span>Close window</span><kbd>Esc</kbd></div><button class="primary-button help-done" id="doneHelp">Got it</button></div></dialog>
+  <div class="toast" id="toast" role="status" aria-live="polite"></div>
+  <script src="app.js"></script>
+</body>
+</html>
