+@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
+:root{--paper:#f7f6f2;--white:#fff;--ink:#242622;--muted:#92948e;--line:#e9e8e2;--green:#526b53;--green-dark:#3e5740;--soft-green:#edf2e9;--orange:#ce8658;--shadow:0 2px 8px #25251c0a,0 14px 35px #25251c08}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:'DM Sans',sans-serif;font-size:13px;-webkit-font-smoothing:antialiased}.app-shell{min-height:100vh}.sidebar{width:234px;position:fixed;inset:0 auto 0 0;background:#f1f0eb;border-right:1px solid #e9e8e2;padding:25px 16px;display:flex;flex-direction:column;z-index:2}.brand{display:flex;align-items:center;gap:10px;margin:0 0 39px 6px;text-decoration:none;color:#272923;font:800 18px Manrope,sans-serif;letter-spacing:-.7px}.brand-mark{width:29px;height:29px;border-radius:9px;background:var(--green);color:white;display:grid;place-items:center;font:800 17px Manrope;letter-spacing:-1px}.workspace{height:55px;border:1px solid #e5e4dd;border-radius:10px;background:#f7f6f2;padding:8px;display:flex;align-items:center;gap:9px;margin-bottom:34px}.avatar{height:29px;width:29px;flex:none;border-radius:8px;background:#e9dac6;color:#866647;display:grid;place-items:center;font-weight:700}.workspace strong,.profile strong{font-size:11px;display:block;font-weight:600}.workspace small,.profile small{font-size:10px;color:#969790;display:block;margin-top:3px}.dots{margin-left:auto;color:#a8a9a1;letter-spacing:1px}.nav-label{font-size:9px;letter-spacing:1.2px;color:#a2a39c;font-weight:700;margin:0 0 10px 10px}.nav-item{border:0;background:transparent;width:100%;height:38px;border-radius:7px;text-align:left;padding:0 10px;color:#73766f;display:flex;align-items:center;gap:11px;font:500 12px 'DM Sans',sans-serif;cursor:pointer}.nav-item:hover{background:#e9e8e1}.nav-item.active{background:#e7e9df;color:#3f5940;font-weight:600}.nav-icon{font-size:16px;width:16px;text-align:center}.nav-count{margin-left:auto;font-size:10px;color:#8e9089}.side-bottom{margin-top:auto}.quote-card{padding:15px 15px 13px;background:#e8eadf;border-radius:10px;margin-bottom:17px;position:relative}.quote-spark{color:#75866a;font-size:18px}.quote-card p{font:500 15px/1.5 Manrope,sans-serif;margin:10px 0 7px;letter-spacing:-.3px}.quote-card p strong{color:#526b53}.quote-card small{color:#92968b;font-size:10px}.profile{border-top:1px solid #e4e3dc;margin-top:12px;padding:18px 5px 0;display:flex;align-items:center;gap:9px}.profile-avatar{border-radius:50%;width:31px;height:31px}.online-dot{width:7px;height:7px;background:#83a276;border-radius:50%;margin-left:auto}.main{margin-left:234px;max-width:1710px;padding:0 48px 28px}.topbar{height:62px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.breadcrumbs{font-size:11px;color:#9a9b95}.breadcrumbs span{margin:0 9px;color:#c8c8c1}.breadcrumbs strong{color:#555850;font-weight:500}.top-actions{display:flex;align-items:center;gap:18px}.saved-status{font-size:10px;color:#999b94}.saved-status i{display:inline-block;width:6px;height:6px;background:#86a17b;border-radius:50%;margin-right:5px}.icon-button,.close-button{border:1px solid var(--line);background:transparent;color:#777a72;width:26px;height:26px;border-radius:50%;cursor:pointer}.board-heading{display:flex;justify-content:space-between;align-items:flex-end;padding:35px 0 25px}.eyebrow{font-size:9px;font-weight:700;color:#95988f;letter-spacing:1.35px;display:flex;align-items:center;gap:7px}.eyebrow-line{width:15px;height:1px;background:#91a087;display:inline-block}.board-heading h1{font:700 33px Manrope,sans-serif;letter-spacing:-1.5px;margin:10px 0 4px}.title-period{color:#7a9270}.subtitle{color:#96978f;margin:0;font-size:12px}.primary-button{height:36px;padding:0 13px;border:0;border-radius:7px;background:var(--green);color:#fff;font:600 11px 'DM Sans',sans-serif;cursor:pointer;box-shadow:0 2px 4px #536c531f;transition:background .15s,transform .15s}.primary-button:hover{background:var(--green-dark);transform:translateY(-1px)}.primary-button>span