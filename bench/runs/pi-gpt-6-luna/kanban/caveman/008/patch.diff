+  function matchesFilters(t){const p=$('#priorityFilter').value,d=$('#dueFilter').value;if(p&&t.priority!==p)return false;if(!d)return true;const today=new Date().toISOString().slice(0,10),end=new Date();end.setDate(end.getDate()+7);const endDate=end.toISOString().slice(0,10);return d==='none'?!t.due:d==='overdue'?!!t.due&&t.due<today:d==='today'?t.due===today:!!t.due&&t.due>=today&&t.due<=endDate}
+  function bindCards(){document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=e=>{e.stopPropagation();openModal(b.dataset.edit)});document.querySelectorAll('.task-card').forEach(c=>{c.onclick=()=>openModal(c.dataset.id);c.ondragstart=()=>{draggedId=c.dataset.id;c.classList.add('dragging')};c.ondragend=()=>c.classList.remove('dragging')});document.querySelectorAll('.column,.task-list').forEach(el=>{el.ondragover=e=>{e.preventDefault();el.closest('.column').classList.add('drag-over')};el.ondragleave=()=>el.closest('.column').classList.remove('drag-over');el.ondrop=e=>{e.preventDefault();el.closest('.column').classList.remove('drag-over');const target=el.dataset.status||el.closest('.column').dataset.status,t=state.tasks.find(x=>x.id===draggedId);if(t&&target){t.status=target;save();render()}}});document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>openModal(null,b.dataset.add));document.querySelectorAll('[data-label]').forEach(b=>b.onclick=()=>{labelFilter=labelFilter===b.dataset.label?'':b.dataset.label;render()})}
+  function openModal(id,status='todo'){const form=$('#taskForm'),t=state.tasks.find(x=>x.id===id);form.reset();$('#taskId').value=t?.id||'';$('#taskTitle').value=t?.title||'';$('#taskDescription').value=t?.description||'';$('#taskStatus').value=t?.status||status;$('#taskPriority').value=t?.priority||'none';$('#taskLabel').value=t?.label||'';$('#taskDue').value=t?.due||'';$('#modalTitle').textContent=t?'Edit task':'What needs doing?';$('#modalEyebrow').textContent=t?'TASK DETAILS':'NEW TASK';$('#saveTask').textContent=t?'Save changes':'Create task';$('#deleteTask').hidden=!t;$('#modalBackdrop').hidden=false;setTimeout(()=>$('#taskTitle').focus(),20)}
+  function closeModal(){$('#modalBackdrop').hidden=true}
+  function notify(msg){const el=$('#toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200)}
+  $('#taskForm').onsubmit=e=>{e.preventDefault();const id=$('#taskId').value,t={id:id||String(Date.now()),title:$('#taskTitle').value.trim(),description:$('#taskDescription').value.trim(),status:$('#taskStatus').value,priority:$('#taskPriority').value,label:$('#taskLabel').value,due:$('#taskDue').value,created:Date.now()};if(!t.title)return;if(id)state.tasks=state.tasks.map(x=>x.id===id?t:x);else state.tasks.push(t);save();render();closeModal();notify(id?'Task updated':'Task created')};
+  $('#deleteTask').onclick=()=>{const id=$('#taskId').value;if(confirm('Delete this task? This cannot be undone.')){state.tasks=state.tasks.filter(t=>t.id!==id);save();render();closeModal();notify('Task deleted')}};
+  document.querySelectorAll('.close-modal').forEach(b=>b.onclick=closeModal);$('#modalBackdrop').onclick=e=>{if(e.target===$('#modalBackdrop'))closeModal()};$('#search').oninput=e=>{query=e.target.value.toLowerCase().trim();render()};$('#filterBtn').onclick=()=>$('#filterPopover').hidden=!$('#filterPopover').hidden;$('#moreBtn').onclick=()=>$('#morePopover').hidden=!$('#morePopover').hidden;$('#priorityFilter').onchange=$('#dueFilter').onchange=()=>{const n=Number(!!$('#priorityFilter').value)+Number(!!$('#dueFilter').value);$('#filterCount').textContent=n||'';render()};$('#clearFilters').onclick=()=>{$('#priorityFilter').value=$('#dueFilter').value='';$('#filterCount').textContent='';render()};$('#newTask').onclick=()=>openModal();$('#focusBtn').onclick=()=>{document.body.classList.toggle('focus-mode');notify(document.body.classList.contains('focus-mode')?'Focus mode on':'Focus mode off')};$('#helpBtn').onclick=()=>$('#helpDialog').showModal();$('.help-close').onclick=()=>$('#helpDialog').close();$('#manageLabels').onclick=()=>{const input=prompt('Enter a label name to add, or an existing name to remove:');if(!input)return;const name=input.trim();if(state.labels.includes(name)){if(confirm(`Remove “${name}” label? Tasks will keep this label.`))state.labels=state.labels.filter(x=>x!==name)}else state.labels.push(name);save();render()};
