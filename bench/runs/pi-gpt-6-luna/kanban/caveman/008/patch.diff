+  const palette={Work:['#668b73','#edf4ed'],Personal:['#8d79b1','#f1edf7'],Ideas:['#d39a48','#faf2e4'],Health:['#d87869','#fbefec']};
+  let state=load(), query='', labelFilter='', draggedId=null, toastTimer;
+  const $=s=>document.querySelector(s), esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
