+    $('#columns').innerHTML=statuses.map(([key,title,col])=>{const tasks=filtered.filter(t=>t.status===key).sort((a,b)=>(a.due||'9999').localeCompare(b.due||'9999')||b.created-a.created);return`<section class="column" data-status="${key}"><header class="column-head"><i class="column-dot" style="--col:${col}"></i><h2>${title}</h2><span class="column-count">${tasks.length}</span><button class="column-add" data-add="${key}" aria-label="Add task to ${title}">＋</button></header><div class="task-list" data-status="${key}">${tasks.length?tasks.map(card).join(''):`<div class="empty-state">${query||labelFilter?'No matching tasks':'Nothing here yet — add a task'}</div>`}</div></section>`}).join('');
+    const active=state.tasks.filter(t=>t.status!=='done').length, done=state.tasks.filter(t=>t.status==='done').length, percent=state.tasks.length?Math.round(done/state.tasks.length*100):0;$('#openCount').textContent=active;$('#doneCount').textContent=done;$('#progressText').textContent=percent+'%';$('#progressBar').style.width=percent+'%';
+    $('#labelList').innerHTML=state.labels.map(l=>{const [c]=color(l);return`<button class="label-filter ${labelFilter===l?'active':''}" data-label="${esc(l)}"><i class="label-dot" style="--tag:${c}"></i>${esc(l)}<span class="label-count">${state.tasks.filter(t=>t.label===l).length}</span></button>`}).join('');
+    $('#taskLabel').innerHTML='<option value="">No label</option>'+state.labels.map(l=>`<option value="${esc(l)}">${esc(l)}</option>`).join('');bindCards();
+  }
