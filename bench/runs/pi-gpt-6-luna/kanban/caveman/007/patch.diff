+<body><div class="shell"><header class="topbar"><div class="brand">daymark<i>.</i></div><nav class="nav"><span>My board</span><span>One thing at a time.</span></nav><div class="top-actions"><button class="secondary" id="exportBtn" title="Download a backup">↧ <span>Export</span></button><button class="secondary" id="importBtn" title="Restore from a backup">↥ <span>Import</span></button><input class="file-input" id="importFile" type="file" accept="application/json,.json"><button class="icon-btn" id="helpBtn" aria-label="Keyboard shortcuts" title="Keyboard shortcuts">?</button></div></header>
+<main class="page"><div class="heading"><div><div class="eyebrow">Your personal workspace</div><h1>My board</h1><div class="date-line" id="dateLine"></div></div><div class="heading-right"><input class="search" id="search" type="search" placeholder="Search your tasks…" aria-label="Search tasks"><button class="primary" id="addBtn">＋ &nbsp;Add a task</button></div></div><section class="board" id="board" aria-label="Kanban board"></section><div class="below"><span>Drag cards to move them between columns. Your board saves automatically.</span><button id="clearSearch" hidden>Clear search</button></div></main><footer class="footer"><span>Daymark · Your work, at your pace.</span><span>Saved privately on this device</span></footer></div>
+<div class="modal-backdrop" id="backdrop"><form class="modal" id="taskForm"><h2 id="modalTitle">Add a task</h2><input type="hidden" id="taskId"><div class="field"><label for="title">Task</label><input id="title" maxlength="120" required placeholder="What needs doing?"></div><div class="field"><label for="description">Notes <span style="font-weight:400;color:#999">· optional</span></label><textarea id="description" maxlength="1000" placeholder="Add a little context…"></textarea></div><div class="form-row"><div class="field"><label for="category">Area</label><select id="category"><option>Work</option><option>Personal</option><option>Health</option><option>Other</option></select></div><div class="field"><label for="priority">Priority</label><select id="priority"><option value="medium">Medium</option><option value="high">High</option><option value="low">Low</option></select></div></div><div class="form-row"><div class="field"><label for="status">Column</label><select id="status"><option value="inbox">Inbox</option><option value="today">Today</option><option value="doing">In progress</option><option value="done">Done</option></select></div><div class="field"><label for="due">Due date <span style="font-weight:400;color:#999">· optional</span></label><input id="due" type="date"></div></div><div class="modal-actions"><button class="danger" id="deleteBtn" type="button" hidden>Delete task</button><div class="right-actions"><button class="secondary" id="cancelBtn" type="button">Cancel</button><button class="primary" type="submit">Save task</button></div></div></form></div><div class="toast" id="toast" role="status"></div>
+<script>
+(()=>{'use strict';const KEY='daymark-board-v1',columns=[['inbox','Inbox'],['today','Today'],['doing','In progress'],['done','Done']];const seed=[{id:'seed-1',title:'Plan the week ahead',description:'Pick three things that would make this week feel good.',category:'Personal',priority:'medium',status:'today',due:'',created:1},{id:'seed-2',title:'Send project update',description:'Share the latest milestones with the team.',category:'Work',priority:'high',status:'inbox',due:'',created:2},{id:'seed-3',title:'Book a dentist appointment',description:'',category:'Health',priority:'low',status:'inbox',due:'',created:3},{id:'seed-4',title:'Review notes from Monday',description:'Pull out decisions and follow-ups.',category:'Work',priority:'medium',status:'doing',due:'',created:4},{id:'seed-5',title:'Take a proper lunch break',description:'Step away from the screen.',category:'Health',priority:'low',status:'done',due:'',created:5}];let tasks=load(),query='',menu=null,toastTimer;const $=id=>document.getElementById(id);function load(){try{const d=JSON.parse(localStorage.getItem(KEY));if(Array.isArray(d))return d.filter(valid)}catch{}return seed.map(x=>({...x}))}function valid(x){return x&&typeof x.id==='string'&&typeof x.title==='string'&&columns.some(c=>c[0]===x.status)}function save(){localStorage.setItem(KEY,JSON.stringify(tasks))}function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function render(){const board=$('board');board.innerHTML=columns.map(([key,label])=>{const list=tasks.filter(t=>t.status===key&&(!query||(t.title+' '+t.description+' '+t.category).toLowerCase().includes(query)));return `<section class="column" data-status="${key}"><div class="column-head"><span class="dot"></span><span class="column-title">${label}</span><span class="count">${tasks.filter(t=>t.status===key).length}</span><button aria-label="Add task to ${label}" data-add="${key}">＋</button></div><div class="cards">${list.map(card).join('')}</div><div class="empty">${query?'No matching tasks':'Nothing here yet'}</div></section>`}).join('');board.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>openForm(null,b.dataset.add));board.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>openForm(tasks.find(t=>t.id===b.dataset.edit)));board.querySelectorAll('[data-menu]').forEach(b=>b.onclick=e=>showMenu(e,b.dataset.menu));board.querySelectorAll('.card').forEach(el=>{el.ondragstart=e=>{e.dataTransfer.setData('text/plain',el.dataset.id);e.dataTransfer.effectAllowed='move';setTimeout(()=>el.classList.add('dragging'),0)};el.ondragend=()=>el.classList.remove('dragging')});board.querySelectorAll('.column').forEach(col=>{col.ondragover=e=>{e.preventDefault();col.classList.add('dragover')};col.ondragleave=e=>{if(!col.contains(e.relatedTarget))col.classList.remove('dragover')};col.ondrop=e=>{e.preventDefault();col.classList.remove('dragover');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t&&t.status!==col.dataset.status){t.status=col.dataset.status;save();render()}}})}function card(t){const due=t.due?new Date(t.due+'T00:00:00'):null,now=new Date();now.setHours(0,0,0,0);const dueText=due?due.toLocaleDateString(undefined,{month:'short',day:'numeric'}):'';let dueClass=due&&due<now&&t.status!=='done'?'overdue':due&&((due-now)/864e5)<=2&&t.status!=='done'?'soon':'';return `<article class="card" draggable="true" data-id="${esc(t.id)}"><div class="card-top"><span class="tag ${esc(t.category)}">${esc(t.category)}</span><button class="more" aria-label="Task options" data-menu="${esc(t.id)}">···</button></div><h3>${esc(t.title)}</h3>${t.description?`<p>${esc(t.description)}</p>`:''}<div class="card-foot">${due?`<span class="due ${dueClass}">◷ ${dueText}</span>`:''}<span class="priority ${esc(t.priority)}">${t.priority==='high'?'● High':t.priority==='low'?'○ Low':'◉ Medium'}</span></div></article>`}function openForm(t,status='inbox'){ $('taskForm').reset();$('taskId').value=t?.id||'';$('modalTitle').textContent=t?'Edit task':'Add a task';$('title').value=t?.title||'';$('description').value=t?.description||'';$('category').value=t?.category||'Work';$('priority').value=t?.priority||'medium';$('status').value=t?.status||status;$('due').value=t?.due||'';$('deleteBtn').hidden=!t;$('backdrop').classList.add('open');setTimeout(()=>$('title').focus(),30)}function closeForm(){$('backdrop').classList.remove('open')}function notify(s){const el=$('toast');el.textContent=s;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200)}function showMenu(e,id){e.stopPropagation();if(menu)menu.remove();const r=e.currentTarget.getBoundingClientRect();menu=document.createElement('div');menu.className='menu';menu.style.top=Math.min(innerHeight-100,r.bottom+4)+'px';menu.style.left=Math.min(innerWidth-160,r.left-110)+'px';menu.innerHTML='<button data-action="edit">Edit task</button><button data-action="today">Move to Today</button><button data-action="done">Mark complete</button><button class="delete" data-action="delete">Delete</button>';document.body.append(menu);menu.onclick=ev=>{const action=ev.target.dataset.action;if(!action)return;const t=tasks.find(x=>x.id===id);if(!t)return;if(action==='edit')openForm(t);if(action==='today'||action==='done'){t.status=action==='today'?'today':'done';save();render()}if(action==='delete'&&confirm(`Delete “${t.title}”?`)){tasks=tasks.filter(x=>x.id!==id);save();render();notify('Task deleted')}menu.remove();menu=null}}$('taskForm').onsubmit=e=>{e.preventDefault();const id=$('taskId').value;const data={title:$('title').value.trim(),description:$('description').value.trim(),category:$('category').value,priority:$('priority').value,status:$('status').value,due:$('due').value};if(!data.title)return;if(id){Object.assign(tasks.find(t=>t.id===id),data)}else tasks.push({id:crypto.randomUUID?crypto.randomUUID():String(Date.now()),...data,created:Date.now()});save();render();closeForm();notify(id?'Task updated':'Task added')};$('deleteBtn').onclick=()=>{const id=$('taskId').value,t=tasks.find(x=>x.id===id);if(t&&confirm(`Delete “${t.title}”?`)){tasks=tasks.filter(x=>x.id!==id);save();render();closeForm();notify('Task deleted')}};$('addBtn').onclick=()=>openForm();$('cancelBtn').onclick=closeForm;$('backdrop').onclick=e=>{if(e.target===$('backdrop'))closeForm()};$('search').oninput=e=>{query=e.target.value.trim().toLowerCase();$('clearSearch').hidden=!query;render()};$('clearSearch').onclick=()=>{$('search').value='';query='';$('clearSearch').hidden=true;render()};$('exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify({app:'Daymark',version:1,exported:new Date().toISOString(),tasks},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`daymark-backup-${new Date().toISOString().slice(0,10)}.json`;a.click();URL.revokeObjectURL(a.href);notify('Backup downloaded')};$('importBtn').onclick=()=>$('importFile').click();$('importFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{const d=JSON.parse(await f.text()),incoming=Array.isArray(d)?d:d.tasks;if(!Array.isArray(incoming)||!incoming.every(valid))throw Error();if(!confirm(`Replace your board with ${incoming.length} imported tasks? This cannot be undone.`))return;tasks=incoming;save();render();notify('Board restored')}catch{alert('This file is not a valid Daymark backup. Your board was not changed.')}finally{e.target.value=''}};$('helpBtn').onclick=()=>alert('Keyboard shortcuts\n\nN — Add a task\n/ — Search tasks\nEsc — Close dialog or menu\n\nDrag cards between columns. Use the ··· menu for more actions.');document.addEventListener('click',e=>{if(menu&&!menu.contains(e.target)){menu.remove();menu=null}});document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeForm();if(menu){menu.remove();menu=null}}if(e.key==='n'&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName)&&!e.metaKey&&!e.ctrlKey){e.preventDefault();openForm()}if(e.key==='/'&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName)){e.preventDefault();$('search').focus()}});$('dateLine').textContent=new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'});render()})();
+</script></body></html>
