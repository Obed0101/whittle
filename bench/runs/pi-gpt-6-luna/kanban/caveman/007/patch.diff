+:root{--paper:#f6f5f1;--ink:#20231f;--muted:#85877f;--line:#e8e7e1;--green:#526c4e;--green-soft:#e9eee5;--amber:#ad7542;--red:#b65548;--white:#fff;--shadow:0 5px 20px #28251c0a}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:14px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,textarea,select{font:inherit}button{color:inherit;cursor:pointer}.shell{max-width:1440px;margin:auto;padding:0 42px}.topbar{height:76px;display:flex;align-items:center;border-bottom:1px solid var(--line);gap:34px}.brand{font-family:Georgia,serif;font-size:23px;letter-spacing:-.8px}.brand i{color:var(--green);font-style:normal}.nav{display:flex;align-items:center;gap:22px;color:var(--muted);font-size:13px}.nav span:first-child{color:var(--ink);font-weight:600}.top-actions{margin-left:auto;display:flex;gap:9px}.icon-btn,.secondary{border:1px solid var(--line);background:transparent;border-radius:8px;padding:8px 11px}.icon-btn{width:36px;height:36px;padding:0;font-size:17px}.primary{background:var(--green);color:white;border:0;border-radius:8px;padding:10px 15px;font-weight:600}.primary:hover{background:#40583d}.icon-btn:hover,.secondary:hover{background:#eeede8}.page{padding:38px 0 48px}.heading{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:27px}.eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:1.6px;color:var(--muted);font-weight:700}.heading h1{font-family:Georgia,serif;font-size:34px;letter-spacing:-.8px;font-weight:400;margin:5px 0 3px}.date-line{color:var(--muted);font-size:13px}.heading-right{display:flex;align-items:center;gap:10px}.search{width:210px;border:1px solid var(--line);border-radius:8px;padding:9px 12px;background:#fff}.board{display:grid;grid-template-columns:repeat(4,minmax(220px,1fr));gap:15px;align-items:start}.column{background:#eeede8;border-radius:11px;padding:12px;min-height:290px}.column-head{display:flex;align-items:center;padding:4px 3px 12px;gap:8px}.dot{width:8px;height:8px;border-radius:50%;background:#87917c}.column[data-status="today"] .dot{background:#bd8451}.column[data-status="done"] .dot{background:#73866e}.column-title{font-size:13px;font-weight:650}.count{font-size:11px;color:var(--muted);background:#e4e3dc;border-radius:10px;padding:1px 7px}.column-head button{margin-left:auto;border:0;background:none;color:#85877f;font-size:19px;padding:0 4px}.cards{display:flex;flex-direction:column;gap:9px;min-height:220px}.card{background:var(--white);border:1px solid #eeede8;border-radius:9px;padding:12px 12px 10px;box-shadow:var(--shadow);cursor:grab;transition:transform .12s,box-shadow .12s}.card:hover{box-shadow:0 7px 20px #28251c12;transform:translateY(-1px)}.card.dragging{opacity:.4}.card-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:7px}.tag{font-size:10px;font-weight:650;letter-spacing:.2px;border-radius:4px;padding:3px 6px;background:#f0eee9;color:#72736d}.tag.Work{background:#edf0e9;color:#58704f}.tag.Personal{background:#f2ebe5;color:#98734f}.tag.Health{background:#f5e9e6;color:#a86457}.more{border:0;background:none;color:#a3a49e;font-size:18px;line-height:15px;padding:2px 4px}.card h3{font-size:14px;line-height:1.4;margin:0 0 5px;font-weight:600}.card p{color:var(--muted);font-size:12px;margin:0 0 11px;line-height:1.5;white-space:pre-wrap}.card-foot{display:flex;align-items:center;gap:7px;color:#898a84;font-size:11px}.due.overdue{color:var(--red);font-weight:600}.due.soon{color:var(--amber)}.priority{margin-left:auto;font-size:10px}.priority.high{color:var(--red)}.priority.medium{color:var(--amber)}.priority.low{color:#92948e}.empty{border:1px dashed #d7d6ce;border-radius:8px;padding:14px;color:#999a94;text-align:center;font-size:12px;display:none}.cards:empty+.empty{display:block}.column.dragover{outline:2px dashed #87917c;outline-offset:-4px}.below{display:flex;justify-content:space-between;align-items:center;margin-top:17px;color:var(--muted);font-size:12px}.below button{border:0;background:none;color:var(--green);font-weight:600;padding:5px}.kbd{border:1px solid var(--line);border-radius:4px;padding:1px 5px;font-size:10px}.modal-backdrop{position:fixed;inset:0;background:#191b18a3;display:none;align-items:center;justify-content:center;padding:20px;z-index:5}.modal-backdrop.open{display:flex}.modal{width:min(460px,100%);background:#fff;border-radius:13px;padding:24px;box-shadow:0 20px 70px #0003}.modal h2{font-family:Georgia,serif;font-weight:400;font-size:24px;margin:0 0 19px}.field{margin-bottom:14px}.field label{display:block;font-size:12px;font-weight:600;margin-bottom:6px}.field input,.field textarea,.field select{width:100%;border:1px solid #e4e3dd;border-radius:7px;padding:9px 10px;outline:none;background:white}.field input:focus,.field textarea:focus,.field select:focus,.search:focus{border-color:#81927b;box-shadow:0 0 0 3px #526c4e19}.field textarea{resize:vertical;min-height:74px}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.modal-actions{display:flex;justify-content:space-between;align-items:center;margin-top:20px}.right-actions{display:flex;gap:8px}.danger{color:var(--red);background:none;border:0;padding:8px 0}.toast{position:fixed;bottom:24px;left:50%;transform:translate(-50%,20px);opacity:0;background:#252822;color:#fff;padding:10px 15px;border-radius:8px;transition:.2s;pointer-events:none;z-index:10}.toast.show{opacity:1;transform:translate(-50%,0)}.menu{position:fixed;z-index:7;background:#fff;border:1px solid var(--line);border-radius:8px;box-shadow:var(--shadow);padding:5px;min-width:145px}.menu button{display:block;width:100%;text-align:left;border:0;background:white;padding:8px;border-radius:5px;font-size:12px}.menu button:hover{background:#f2f1ec}.menu .delete{color:var(--red)}.footer{border-top:1px solid var(--line);padding:17px 0 24px;color:var(--muted);font-size:11px;display:flex;justify-content:space-between}.file-input{display:none}@media(max-width:950px){.shell{padding:0 24px}.board{grid-template-columns:repeat(2,minmax(220px,1fr))}}@media(max-width:560px){.shell{padding:0 16px}.topbar{height:62px}.nav{display:none}.page{padding-top:27px}.heading{align-items:flex-start;gap:15px;flex-direction:column}.heading h1{font-size:30px}.heading-right{width:100%}.search{flex:1;min-width:0}.board{grid-template-columns:1fr;gap:10px}.column{min-height:0}.cards{min-height:36px}.empty{padding:10px}.below{align-items:flex-start;gap:12px;flex-direction:column}.footer{gap:10px}.top-actions .secondary{padding:7px}.form-row{grid-template-columns:1fr 1fr}}
