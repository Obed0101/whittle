margin:0 0 5px;font-weight:650;letter-spacing:-.12px}.card p{margin:0;color:#858981;font-size:11px;line-height:1.5}.cardbottom{display:flex;align-items:center;justify-content:space-between;margin-top:12px;min-height:18px}.meta{display:flex;align-items:center;gap:10px;color:#92968f;font-size:10px}.meta span{white-space:nowrap}.due.overdue{color:var(--red);font-weight:600}.due.soon{color:var(--amber);font-weight:600}.check{color:#899087}.empty{border:1px dashed #d8dbd3;border-radius:8px;text-align:center;padding:20px 9px;color:#999;font-size:11px}.addcol{width:100%;border:1px dashed #d4d7cf;background:transparent;border-radius:7px;color:#858981;font-size:11px;padding:8px;margin-top:9px}.addcol:hover{background:#e9ebe5}.footer{border-top:1px solid var(--line);padding:13px 0;color:#999;font-size:11px;display:flex;justify-content:space-between}.footer button{border:0;background:none;color:#748276;font-size:11px}.toast{position:fixed;bottom:22px;left:50%;transform:translate(-50%,20px);background:#263b2d;color:white;padding:10px 15px;border-radius:8px;font-size:12px;opacity:0;pointer-events:none;transition:.2s;box-shadow:0 5px 20px #0002}.toast.show{opacity:1;transform:translate(-50%,0)}.modalback{position:fixed;inset:0;background:#17201966;display:none;align-items:center;justify-content:center;padding:20px;z-index:10}.modalback.open{display:flex}.modal{width:min(460px,100%);background:#fff;border-radius:13px;padding:23px;box-shadow:0 18px 60px #0003}.modalhead{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}.modalhead h2{font-size:18px;letter-spacing:-.4px;margin:0}.close{border:0;background:#f2f3f0;border-radius:6px;width:28px;height:28px;font-size:18px;color:#666}.field{margin:13px 0}.field label{display:block;font-size:11px;font-weight:650;color:#555b54;margin-bottom:6px}.field input,.field textarea,.field select{display:block;width:100%;border:1px solid #e2e4de;border-radius:7px;padding:9px 10px;outline:none;font-size:12px;background:w