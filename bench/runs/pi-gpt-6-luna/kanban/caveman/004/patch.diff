+<script>
+(()=>{'use strict';const KEY='daymark-board-v1';const defaults=[{id:'a1',title:'Plan the week ahead',description:'Choose the three things that would make this week feel successful.',category:'Personal',status:'todo',priority:'high',due:'',updated:Date.now()-90000},{id:'a2',title:'Send project update',description:'Share the latest milestones and flag anything that needs a decision.',category:'Work',status:'todo',priority:'normal',due:'',updated:Date.now()-160000},{id:'a3',title:'Book annual check-up',description:'Find a time that works and add it to the calendar.',category:'Health',status:'todo',priority:'normal',due:'',updated:Date.now()-230000},{id:'a4',title:'Read 20 pages',description:'Keep the little habit going, one chapter at a time.',category:'Learning',status:'todo',priority:'low',due:'',updated:Date.now()-300000},{id:'a5',title:'Draft onboarding notes',description:'Capture the setup steps while they are still fresh.',category:'Work',status:'doing',priority:'high',due:'',updated:Date.now()-40000},{id:'a6',title:'Get outside at lunch',description:'A short walk counts. Leave the phone in your pocket.',category:'Health',status:'doing',priority:'normal',due:'',updated:Date.now()-210000},{id:'a7',title:'Compare savings accounts',description:'Check rates, fees, and withdrawal rules.',category:'Personal',status:'waiting',priority:'normal',due:'',updated:Date.now()-60000},{id:'a8',title:'Set up a reading list',description:'',category:'Learning',status:'done',priority:'low',due:'',updated:Date.now()-100000}];const cols=[{id:'todo',name:'To do'},{id:'doing',name:'In progress'},{id:'waiting',name:'Up next'},{id:'done',name:'Done'}];let tasks;try{tasks=JSON.parse(localStorage.getItem(KEY))||defaults}catch{tasks=defaults}let filter='all',query='',sort='manual';const $=s=>document.querySelector(s), board=$('#board'),back=$('#modalback'),form=$('#taskForm');$('#today').textContent=new Intl.DateTimeFormat('en',{weekday:'short',month:'short',day:'numeric'}).format(new Date());function save(){localStorage.setItem(KEY,JSON.stringify(tasks))}function safe(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function dateLabel(s){if(!s)return'';const d=new Date(s+'T00:00:00'),now=new Date();now.setHours(0,0,0,0);const delta=Math.round((d-now)/86400000);return {text:delta<0?`${Math.abs(delta)}d overdue`:delta===0?'Today':delta===1?'Tomorrow':d.toLocaleDateString('en',{month:'short',day:'numeric'}),cls:delta<0?'overdue':delta<3?'soon':''}}function render(){board.innerHTML='';let visible=tasks.filter(t=>(filter==='all'||t.category===filter)&&(`${t.title} ${t.description} ${t.category}`.toLowerCase().includes(query)));if(sort==='due')visible.sort((a,b)=>(a.due||'9999').localeCompare(b.due||'9999'));if(sort==='priority'){const p={high:0,normal:1,low:2};visible.sort((a,b)=>p[a.priority]-p[b.priority])}else if(sort==='manual')visible.sort((a,b)=>b.updated-a.updated);$('#total').textContent=`${visible.length} ${visible.length===1?'task':'tasks'}`;let completed=tasks.filter(t=>t.status==='done').length;$('#summary').textContent=tasks.length?`${completed} of ${tasks.length} tasks complete · Keep your focus on what matters.`:'A little progress, every day.';cols.forEach(col=>{let list=visible.filter(t=>t.status===col.id);let el=document.createElement('section');el.className='column';el.dataset.status=col.id;el.innerHTML=`<div class="colhead" data-status="${col.id}"><span class="dot"></span><span class="colname">${col.name}</span><span class="colcount">${list.length}</span><div class="menu"><button class="iconbtn menuToggle" aria-label="Column actions">···</button><div class="menu-list"><button data-add="${col.id}">＋ Add task</button></div></div></div><div class="cards">${list.length?list.map(cardHTML).join(''):'<div class="empty">Nothing here yet</div>'}</div><button class="addcol" data-add="${col.id}">＋ Add a task</button>`;el.addEventListener('dragover',e=>{e.preventDefault();el.classList.add('dragover')});el.addEventListener('dragleave',e=>{if(!el.contains(e.relatedTarget))el.classList.remove('dragover')});el.addEventListener('drop',e=>{e.preventDefault();el.classList.remove('dragover');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=col.id;t.updated=Date.now();save();render()}});board.append(el)});board.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>open(null,b.dataset.add));board.querySelectorAll('.menuToggle').forEach(b=>b.onclick=e=>{e.stopPropagation();b.parentElement.classList.toggle('open')});board.querySelectorAll('.card').forEach(c=>{c.addEventListener('dragstart',e=>{e.dataTransfer.setData('text/plain',c.dataset.id);setTimeout(()=>c.classList.add('dragging'),0)});c.addEventListener('dragend',()=>c.classList.remove('dragging'));c.onclick=()=>open(c.dataset.id)});document.onclick=()=>document.querySelectorAll('.menu.open').forEach(m=>m.classList.remove('open'))}function cardHTML(t){let due=dateLabel(t.due),pri=t.priority==='high'?'<span class="check" title="High priority">◆ High</span>':t.priority==='low'?'<span>Low</span>':'';return`<article class="card" draggable="true" data-id="${safe(t.id)}"><div class="cardtop"><span class="tag ${t.category.toLowerCase()}">${safe(t.category)}</span><span class="check">${t.priority==='high'?'◆':''}</span></div><h3>${safe(t.title)}</h3>${t.description?`<p>${safe(t.description)}</p>`:''}<div class="cardbottom"><div class="meta">${t.due?`<span class="due ${due.cls}">◷ ${safe(due.text)}</span>`:''}${pri}</div><span class="meta">${t.status==='done'?'✓':''}</span></div></article>`}function open(id,status='todo'){form.reset();$('#taskId').value=id||'';$('#status').innerHTML=cols.map(c=>`<option value="${c.id}">${c.name}</option>`).join('');const t=tasks.find(x=>x.id===id);$('#modalTitle').textContent=t?'Edit task':'New task';$('#deleteTask').hidden=!t;if(t){$('#title').value=t.title;$('#description').value=t.description||'';$('#category').value=t.category;$('#status').value=t.status;$('#priority').value=t.priority||'normal';$('#due').value=t.due||''}else $('#status').value=status;back.classList.add('open');setTimeout(()=>$('#title').focus(),50)}function close(){back.classList.remove('open')}$('#newTask').onclick=()=>open();$('#closeModal').onclick=close;back.onclick=e=>{if(e.target===back)close()};document.addEventListener('keydown',e=>{if(e.key==='Escape')close();if((e.metaKey||e.ctrlKey)&&e.key==='Enter'&&back.classList.contains('open'))form.requestSubmit()});form.onsubmit=e=>{e.preventDefault();let id=$('#taskId').value,t=tasks.find(x=>x.id===id);let data={id:id||crypto.randomUUID(),title:$('#title').value.trim(),description:$('#description').value.trim(),category:$('#category').value,status:$('#status').value,priority:$('#priority').value,due:$('#due').value,updated:Date.now()};if(t)Object.assign(t,data);else tasks.unshift(data);save();render();close();toast(t?'Task updated':'Task added')};$('#deleteTask').onclick=()=>{let id=$('#taskId').value;tasks=tasks.filter(t=>t.id!==id);save();render();close();toast('Task deleted')};$('#search').oninput=e=>{query=e.target.value.toLowerCase();render()};$('#categoryFilter').onchange=e=>{filter=e.target.value;render()};$('#sort').onchange=e=>{sort=e.target.value;render()};function toast(s){let el=$('#toast');el.textContent=s;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),1900)}$('#exportBtn').onclick=()=>{let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(tasks,null,2)],{type:'application/json'}));a.download='daymark-backup.json';a.click();URL.revokeObjectURL(a.href);toast('Backup downloaded')};$('#importBtn').onclick=()=>$('#importFile').click();$('#importFile').onchange=async e=>{try{let data=JSON.parse(await e.target.files[0].text());if(!Array.isArray(data)||data.some(t=>!t.title||!t.id))throw Error();tasks=data;save();render();toast('Backup imported')}catch{toast('Could not read that backup')}e.target.value=''};render()})();
