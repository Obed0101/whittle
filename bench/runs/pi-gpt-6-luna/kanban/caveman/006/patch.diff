+<script>
+(()=>{const KEY='daymark-board-v1',cols=[['todo','Up next'],['progress','In progress'],['review','On hold'],['done','Done']];const seed=[{id:'a1',title:'Plan the week ahead',description:'Pick three priorities and block focus time.',status:'todo',category:'personal',due:'',priority:'high',created:1},{id:'a2',title:'Send proposal to Morgan',description:'Include revised timeline and project scope.',status:'todo',category:'work',due:'',priority:'normal',created:2},{id:'a3',title:'Book annual check-up',description:'',status:'todo',category:'health',due:'',priority:'normal',created:3},{id:'a4',title:'Update portfolio case study',description:'Add launch results and final screenshots.',status:'progress',category:'work',due:'',priority:'high',created:4},{id:'a5',title:'Read 20 pages',description:'',status:'progress',category:'personal',due:'',priority:'low',created:5},{id:'a6',title:'Compare internet plans',description:'Current contract renews next month.',status:'review',category:'personal',due:'',priority:'normal',created:6},{id:'a7',title:'Morning walk',description:'',status:'done',category:'health',due:'',priority:'normal',created:7}];let tasks;try{tasks=JSON.parse(localStorage.getItem(KEY))||seed}catch{tasks=seed}let query='';const $=id=>document.getElementById(id),today=new Date();$('today').textContent=today.toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'});function save(){localStorage.setItem(KEY,JSON.stringify(tasks));render()}function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function dateLabel(s){if(!s)return '';let d=new Date(s+'T00:00:00'),n=new Date();n.setHours(0,0,0,0);let diff=Math.round((d-n)/86400000);return diff<0?'Overdue · '+d.toLocaleDateString(undefined,{month:'short',day:'numeric'}):diff===0?'Today':diff===1?'Tomorrow':d.toLocaleDateString(undefined,{month:'short',day:'numeric'})}function render(){let active=tasks.filter(t=>t.status!=='done').length,late=tasks.filter(t=>t.status!=='done'&&t.due&&t.due<new Date().toLocaleDateString('en-CA')).length;$('summary').innerHTML=`<span><strong>${active}</strong> active</span><span class="dot">·</span><span><strong>${tasks.filter(t=>t.status==='done').length}</strong> completed</span>${late?`<span class="dot">·</span><span style="color:#b76d52"><strong>${late}</strong> overdue</span>`:''}`;$('board').innerHTML=cols.map(([key,label])=>{let list=tasks.filter(t=>t.status===key&&(!query||`${t.title} ${t.description} ${t.category}`.toLowerCase().includes(query)));return `<section class="column" data-col="${key}"><div class="colhead"><div class="col-title"><i class="c-dot"></i>${label}<span class="count">${tasks.filter(t=>t.status===key).length}</span></div><button class="add-small" data-add="${key}" aria-label="Add to ${label}">＋</button></div><div class="cards">${list.map(card).join('')}</div>${key==='done'&&!list.length?'<div class="empty">Finished tasks will land here.</div>':''}</section>`}).join('');document.querySelectorAll('.card').forEach(c=>{c.addEventListener('click',e=>{if(!e.target.closest('.more'))openEdit(c.dataset.id)});c.addEventListener('dragstart',e=>{e.dataTransfer.setData('text/plain',c.dataset.id);setTimeout(()=>c.classList.add('dragging'),0)});c.addEventListener('dragend',()=>c.classList.remove('dragging'))});document.querySelectorAll('.column').forEach(c=>{c.addEventListener('dragover',e=>{e.preventDefault();c.classList.add('over')});c.addEventListener('dragleave',()=>c.classList.remove('over'));c.addEventListener('drop',e=>{e.preventDefault();c.classList.remove('over');let t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=c.dataset.col;save()}})});document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>openNew(b.dataset.add))}function card(t){let cat=t.category||'none',due=dateLabel(t.due),late=due.startsWith('Overdue');return `<article class="card" draggable="true" data-id="${esc(t.id)}"><div class="card-top"><h3>${esc(t.title)}</h3><button class="more" title="Edit task">···</button></div>${t.description?`<p class="description">${esc(t.description)}</p>`:''}<span class="tag ${cat}">${cat==='none'?'No category':esc(cat[0].toUpperCase()+cat.slice(1))}</span><div class="card-foot"><span class="due ${late?'late':''}">${due?`◷ ${esc(due)}`:''}</span><span class="priority">${t.priority==='high'?'⬆ High':t.priority==='low'?'↓ Low':''}</span></div></article>`}function openNew(status='todo'){ $('taskForm').reset();$('taskId').value='';$('status').value=status;$('modalTitle').textContent='New task';$('deleteTask').classList.add('hidden');showModal()}function openEdit(id){let t=tasks.find(x=>x.id===id);if(!t)return;$('taskId').value=id;$('title').value=t.title;$('description').value=t.description||'';$('status').value=t.status;$('category').value=t.category||'none';$('due').value=t.due||'';$('priority').value=t.priority||'normal';$('modalTitle').textContent='Edit task';$('deleteTask').classList.remove('hidden');showModal()}function showModal(){$('backdrop').classList.add('open');setTimeout(()=>$('title').focus(),30)}function hideModal(){$('backdrop').classList.remove('open')}function toast(s){let el=$('toast');el.textContent=s;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),2200)}$('addTask').onclick=()=>openNew();$('closeModal').onclick=hideModal;$('backdrop').onclick=e=>{if(e.target===$('backdrop'))hideModal()};document.onkeydown=e=>{if(e.key==='Escape')hideModal();if((e.metaKey||e.ctrlKey)&&e.key==='Enter'&&$('backdrop').classList.contains('open'))$('taskForm').requestSubmit()};$('taskForm').onsubmit=e=>{e.preventDefault();let id=$('taskId').value,old=tasks.find(t=>t.id===id),item={id:id||crypto.randomUUID(),title:$('title').value.trim(),description:$('description').value.trim(),status:$('status').value,category:$('category').value,due:$('due').value,priority:$('priority').value,created:old?.created||Date.now()};if(old)tasks[tasks.indexOf(old)]=item;else tasks.unshift(item);hideModal();save();toast(old?'Task updated':'Task added')};$('deleteTask').onclick=()=>{let id=$('taskId').value;if(confirm('Delete this task?')){tasks=tasks.filter(t=>t.id!==id);hideModal();save();toast('Task deleted')}};$('search').oninput=e=>{query=e.target.value.toLowerCase();render()};$('clearDone').onclick=()=>{let n=tasks.filter(t=>t.status==='done').length;if(!n)return toast('No completed tasks to clear');if(confirm(`Clear ${n} completed task${n===1?'':'s'}?`)){tasks=tasks.filter(t=>t.status!=='done');save();toast('Completed tasks cleared')}};$('exportBtn').onclick=()=>{let blob=new Blob([JSON.stringify({version:1,tasks},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='daymark-backup.json';a.click();URL.revokeObjectURL(a.href);toast('Backup downloaded')};$('importBtn').onclick=()=>$('importFile').click();$('importFile').onchange=async e=>{try{let data=JSON.parse(await e.target.files[0].text()),incoming=Array.isArray(data)?data:data.tasks;if(!Array.isArray(incoming)||incoming.some(t=>!t.title||!cols.some(c=>c[0]===t.status)))throw Error();if(confirm(`Replace board with ${incoming.length} imported tasks?`)){tasks=incoming;save();toast('Backup imported')}}catch{toast('Could not read that backup')}e.target.value=''};$('reset').onclick=()=>{if(confirm('Replace your board with the sample tasks? This cannot be undone.')){tasks=seed.map(t=>({...t}));save();toast('Sample board restored')}};render()})();
+</script></body></html>
