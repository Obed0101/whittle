ue.late{color:#ba674e}.priority{color:#d2924f;font-size:11px;letter-spacing:1px}.empty{border:1px dashed #d5d5cc;border-radius:8px;color:#a1a399;text-align:center;padding:20px 8px;font-size:11px;display:none}.column[data-col="done"] .empty{display:block}.footer{color:#999b93;font-size:11px;padding:0 0 24px;display:flex;justify-content:space-between}.footer button{border:0;background:none;color:var(--green);padding:0}.modal-backdrop{position:fixed;inset:0;background:#20231fa1;display:none;align-items:center;justify-content:center;padding:20px;z-index:5}.modal-backdrop.open{display:flex}.modal{width:min(460px,100%);background:#fff;border-radius:13px;padding:23px;box-shadow:0 20px 80px #0003}.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.modal h2{font-size:18px;margin:0;letter-spacing:-.4px}.close{border:0;background:transparent;font-size:21px;color:#888}.field{display:block;margin:13px 0}.field span{display:block;font-weight:650;font-size:11px;margin-bottom:6px}.field input,.field textarea,.field select{width:100%;border:1px solid var(--line);border-radius:7px;padding:10px 11px;background:#fff;outline:none}.field input:focus,.field textarea:focus,.field select:focus{border-color:#8aa18a;box-shadow:0 0 0 3px #557b5b18}.field textarea{resize:vertical;min-height:76px}.formrow{display:grid;grid-template-columns:1fr 1fr;gap:12px}.modal-foot{display:flex;justify-content:space-between;margin-top:19px}.danger{border:0;background:none;color:#b75f4d;font-size:12px}.toast{position:fixed;bottom:22px;left:50%;transform:translate(-50%,15px);opacity:0;background:#252923;color:#fff;border-radius:8px;padding:10px 16px;font-size:12px;transition:.2s;pointer-events:none;z-index:8}.toast.show{opacity:1;transform:translate(-50%,0)}.search-wrap{position:relative}.search-wrap input{width:190px;padding:9px 12px 9px 32px;border:1px solid var(--line);background:#fff;border-radius:8px;font-size:12px}.search-wrap:before{content:'⌕';position:absolute;