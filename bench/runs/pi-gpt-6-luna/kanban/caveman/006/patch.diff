+<body><div class="shell"><header class="topbar"><div class="brand"><span class="mark">↗</span> daymark</div><div class="nav"><label class="search-wrap"><input id="search" placeholder="Search tasks…" aria-label="Search tasks"></label><button class="iconbtn" id="exportBtn" title="Export backup">↥</button><button class="iconbtn" id="importBtn" title="Import backup">↧</button><input type="file" id="importFile" accept="application/json" hidden><span class="avatar">ME</span></div></header>
+<main><section class="hero"><div><div class="eyebrow">Your personal workspace</div><h1>My board</h1><div class="date" id="today"></div></div><div class="hero-actions"><button class="btn" id="clearDone">Clear completed</button><button class="btn primary" id="addTask">＋ Add task</button></div></section><div class="summary" id="summary"></div><section class="board" id="board"></section></main><footer class="footer"><span>Changes save automatically on this device.</span><span>Make room for what matters. <button id="reset">Reset sample board</button></span></footer></div>
