diff --git a/board/app.js b/board/app.js
new file mode 100644
index 0000000..7fa3b61
--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,48 @@
+(() => {
+  'use strict';
+  const KEY = 'daymark-board-v1';
+  const columns = [{id:'backlog',name:'Up next'},{id:'todo',name:'To do'},{id:'doing',name:'In progress'},{id:'done',name:'Done'}];
+  const starter = [
+    {id:'s1',title:'Plan the week ahead',description:'Pick the three things that would make this week feel like a win.',status:'todo',priority:'high',due:'',tag:'Planning',created:Date.now()-3600000},
+    {id:'s2',title:'Book a table for Friday',description:'Somewhere new, somewhere good.',status:'backlog',priority:'low',due:'',tag:'Personal',created:Date.now()-7200000},
+    {id:'s3',title:'Read 20 pages',description:'Keep the phone in another room.',status:'doing',priority:'medium',due:'',tag:'Habit',created:Date.now()-2000000},
+    {id:'s4',title:'Clear out the inbox',description:'',status:'done',priority:'medium',due:'',tag:'Work',created:Date.now()-86400000,completed:Date.now()-3600000}
+  ];
+  let tasks = load(), view = 'board', priorityFilter = 'all', activeNav = 'board', draggedId = null, toastTimer;
+  const $ = id => document.getElementById(id);
+  const esc = value => String(value || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+  function load(){try{const saved=JSON.parse(localStorage.getItem(KEY));return Array.isArray(saved)?saved:starter.map(x=>({...x}));}catch{return starter.map(x=>({...x}));}}
+  function persist(){localStorage.setItem(KEY,JSON.stringify(tasks));}
+  function dateText(date){if(!date)return '';const d=new Date(date+'T00:00:00'),today=new Date();today.setHours(0,0,0,0);const diff=Math.round((d-today)/86400000);if(diff===0)return 'Today';if(diff===1)return 'Tomorrow';return d.toLocaleDateString(undefined,{month:'short',day:'numeric'});}
+  function isVisible(task){const q=$('searchInput').value.trim().toLowerCase();if(q&&!`${task.title} ${task.description} ${task.tag}`.toLowerCase().includes(q))return false;if(priorityFilter!=='all'&&task.priority!==priorityFilter)return false;if(activeNav==='focus'&&(!task.due||task.status==='done'||new Date(task.due+'T23:59:59')<new Date(Date.now()-86400000)||new Date(task.due+'T00:00:00')>new Date(Date.now()+7*86400000)))return false;if(activeNav==='completed'&&task.status!=='done')return false;if(activeNav==='board'&&task.status==='done')return true;return true;}
+  function sorted(list){const mode=$('sortSelect').value;return [...list].sort((a,b)=>mode==='due'?(a.due||'9999').localeCompare(b.due||'9999'):mode==='priority'?({high:0,medium:1,low:2}[a.priority]-({high:0,medium:1,low:2}[b.priority])):mode==='newest'?b.created-a.created:(a.order||0)-(b.order||0));}
+  function render(){
+    const visible=tasks.filter(isVisible), board=$('board');
+    $('totalCount').textContent=tasks.filter(t=>t.status!=='done').length;$('openStat').textContent=tasks.filter(t=>t.status!=='done').length;
+    const week=Date.now()-7*86400000;$('doneStat').textContent=tasks.filter(t=>t.status==='done'&&t.completed>=week).length;
+    const today=new Date();$('todayLabel').textContent=today.toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'}).toUpperCase();
+    $('streakStat').textContent=(tasks.some(t=>t.status==='done'&&new Date(t.completed).toDateString()===today.toDateString())?'1 day':'0 days');
+    $('pageTitle').firstChild.textContent=activeNav==='focus'?'Due soon':activeNav==='completed'?'Completed':'My board';$('pageSubtitle').textContent=activeNav==='focus'?'Tasks due in the next seven days.':activeNav==='completed'?'Look at everything you have moved forward.':'A little progress each day adds up.';
+    $('filterDot').style.display=priorityFilter==='all'?'none':'block';
+    board.hidden=view!=='board';$('listView').hidden=view!=='list';
+    if(view==='board')board.innerHTML=columns.map(col=>{let cards=sorted(visible.filter(t=>t.status===col.id));return `<section class="column col-${col.id}" data-column="${col.id}"><div class="column-head"><span class="column-dot"></span><span class="column-name">${col.name}</span><span class="column-count">${cards.length}</span><button class="column-add" data-add="${col.id}" aria-label="Add task to ${col.name}" title="Add task">＋</button></div><div class="cards" data-drop="${col.id}">${cards.length?cards.map(cardHTML).join(''):'<div class="empty-column">Drop a task here</div>'}</div></section>`}).join('');
+    if(view==='list')$('listView').innerHTML=visible.length?`<div class="list-row list-head"><span>Task</span><span>Column</span><span>Priority</span><span>Due date</span><span></span></div>${sorted(visible).map(t=>`<div class="list-row"><span class="list-title">${esc(t.title)}</span><span>${columns.find(c=>c.id===t.status)?.name}</span><span class="priority priority-${t.priority}">${t.priority}</span><span>${dateText(t.due)||'—'}</span><button class="card-menu" data-edit="${esc(t.id)}" aria-label="Edit task">···</button></div>`).join('')}`:'<div class="list-empty">No tasks match. Add one or clear your filters.</div>';
+    document.querySelectorAll('.filter-chip').forEach(b=>b.classList.toggle('active',b.dataset.priority===priorityFilter));
+  }
+  function cardHTML(t){const due=dateText(t.due), overdue=t.due&&new Date(t.due+'T23:59:59')<new Date()&&t.status!=='done',soon=t.due&&!overdue&&new Date(t.due+'T00:00:00')<=new Date(Date.now()+86400000*2);return `<article class="task-card" draggable="true" data-card="${esc(t.id)}"><div class="card-top"><span class="priority priority-${t.priority}">${t.priority}</span><button class="card-menu" data-edit="${esc(t.id)}" aria-label="Edit ${esc(t.title)}">···</button></div><h3>${esc(t.title)}</h3>${t.description?`<p>${esc(t.description)}</p>`:''}<div class="card-bottom">${t.tag?`<span class="card-tag">${esc(t.tag)}</span>`:'<span></span>'}${due?`<span class="card-date ${overdue?'overdue':soon?'soon':''}">${overdue?'Overdue · ':''}${due}</span>`:''}</div></article>`;}
+  function openModal(id='',status='todo'){const task=tasks.find(t=>t.id===id);$('taskForm').reset();$('taskId').value=task?.id||'';$('taskTitle').value=task?.title||'';$('taskDescription').value=task?.description||'';$('taskStatus').value=task?.status||status;$('taskPriority').value=task?.priority||'medium';$('taskDue').value=task?.due||'';$('taskTag').value=task?.tag||'';$('modalTitle').textContent=task?'Edit task':'Add a task';$('saveTask').textContent=task?'Save changes':'Save task';$('deleteTask').hidden=!task;$('modalBackdrop').hidden=false;setTimeout(()=>$('taskTitle').focus(),20);}
+  function closeModal(){$('modalBackdrop').hidden=true;}
+  function notify(text){const t=$('toast');t.textContent=text;t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),2100);}
+  $('taskForm').addEventListener('submit',e=>{e.preventDefault();const id=$('taskId').value,prior=tasks.find(t=>t.id===id),status=$('taskStatus').value;const obj={id:id||crypto.randomUUID(),title:$('taskTitle').value.trim(),description:$('taskDescription').value.trim(),status,priority:$('taskPriority').value,due:$('taskDue').value,tag:$('taskTag').value.trim(),created:prior?.created||Date.now(),order:prior?.order||Date.now()};if(!obj.title)return;if(status==='done'&&prior?.status!=='done')obj.completed=Date.now();else if(status==='done')obj.completed=prior?.completed||Date.now();if(prior)tasks=tasks.map(t=>t.id===id?obj:t);else tasks.push(obj);persist();closeModal();render();notify(prior?'Task updated':'Task added');});
+  $('deleteTask').addEventListener('click',()=>{const id=$('taskId').value;tasks=tasks.filter(t=>t.id!==id);persist();closeModal();render();notify('Task deleted');});
+  document.querySelectorAll('.close-modal').forEach(b=>b.addEventListener('click',closeModal));$('modalBackdrop').addEventListener('click',e=>{if(e.target===$('modalBackdrop'))closeModal();});
+  $('board').addEventListener('click',e=>{const add=e.target.closest('[data-add]'),edit=e.target.closest('[data-edit]');if(add)openModal('',add.dataset.add);if(edit)openModal(edit.dataset.edit);});$('listView').addEventListener('click',e=>{const b=e.target.closest('[data-edit]');if(b)openModal(b.dataset.edit);});
+  $('board').addEventListener('dragstart',e=>{const card=e.target.closest('[data-card]');if(!card)return;draggedId=card.dataset.card;card.classList.add('dragging');e.dataTransfer.setData('text/plain',draggedId);e.dataTransfer.effectAllowed='move';});$('board').addEventListener('dragend',e=>{e.target.closest('[data-card]')?.classList.remove('dragging');document.querySelectorAll('.cards').forEach(c=>c.classList.remove('drag-over'));});$('board').addEventListener('dragover',e=>{const target=e.target.closest('[data-drop]');if(!target)return;e.preventDefault();target.classList.add('drag-over');e.dataTransfer.dropEffect='move';});$('board').addEventListener('dragleave',e=>{const target=e.target.closest('[data-drop]');if(target&&!target.contains(e.relatedTarget))target.classList.remove('drag-over');});$('board').addEventListener('drop',e=>{const target=e.target.closest('[data-drop]');if(!target)return;e.preventDefault();const id=e.dataTransfer.getData('text/plain')||draggedId;const task=tasks.find(t=>t.id===id);if(task&&task.status!==target.dataset.drop){task.status=target.dataset.drop;if(task.status==='done')task.completed=Date.now();persist();render();notify('Task moved');}});
+  $('searchInput').addEventListener('input',render);$('sortSelect').addEventListener('change',render);$('filterButton').addEventListener('click',()=>$('filterRow').hidden=!$('filterRow').hidden);$('filterRow').addEventListener('click',e=>{const b=e.target.closest('[data-priority]');if(b){priorityFilter=b.dataset.priority;render();}});$('clearFilters').addEventListener('click',()=>{priorityFilter='all';$('searchInput').value='';render();});
+  document.querySelectorAll('.view-tab').forEach(b=>b.addEventListener('click',()=>{view=b.dataset.view;document.querySelectorAll('.view-tab').forEach(x=>x.classList.toggle('selected',x===b));render();}));
+  function nav(which){activeNav=which;document.querySelectorAll('.nav-item').forEach(b=>b.classList.remove('active'));(which==='board'?$('boardNav'):which==='focus'?$ ('focusNav'):$('completedNav')).classList.add('active');render();}
+  $('boardNav').addEventListener('click',()=>nav('board'));$('focusNav').addEventListener('click',()=>nav('focus'));$('completedNav').addEventListener('click',()=>nav('completed'));$('addTaskTop').addEventListener('click',()=>openModal());$('themeToggle').addEventListener('click',()=>{document.body.classList.toggle('dark');localStorage.setItem('daymark-dark',document.body.classList.contains('dark')?'1':'0');});if(localStorage.getItem('daymark-dark')==='1')document.body.classList.add('dark');
+  $('helpButton').addEventListener('click',()=>alert('Keyboard shortcuts\n\nN — Add a task\n⌘/Ctrl + K — Search\nEsc — Close dialog\n\nDrag any card to move it between columns.'));
+  document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal();if(e.key.toLowerCase()==='n'&&!e.metaKey&&!e.ctrlKey&&!e.altKey&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName)){e.preventDefault();openModal();}if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();$('searchInput').focus();}});
+  render();
+})();
diff --git a/board/index.html b/board/index.html
new file mode 100644
index 0000000..7213adc
--- /dev/null
+++ b/board/index.html
@@ -0,0 +1,37 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="theme-color" content="#f5f6f8">
+  <title>Daymark — Personal board</title>
+  <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+  <div class="app-shell">
+    <aside class="rail" aria-label="Main navigation">
+      <a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d</span><span>daymark</span></a>
+      <div class="rail-label">WORKSPACE</div>
+      <button class="nav-item active" id="boardNav"><span class="nav-icon">▦</span> My board <span class="nav-count" id="totalCount">0</span></button>
+      <button class="nav-item" id="focusNav"><span class="nav-icon">◷</span> Due soon</button>
+      <button class="nav-item" id="completedNav"><span class="nav-icon">✓</span> Completed</button>
+      <div class="rail-bottom"><div class="tip-card"><span class="tip-icon">✳</span><strong>Make room for focus</strong><p>A clear board makes a clear mind. Keep your work moving, one card at a time.</p></div><div class="profile"><div class="avatar">Y</div><div><strong>Your workspace</strong><small>Personal board</small></div><span class="profile-dots">•••</span></div></div>
+    </aside>
+    <main class="main">
+      <header class="topbar"><div class="breadcrumb">Workspace <span>/</span> <b>My board</b></div><div class="top-actions"><button class="icon-button" id="themeToggle" aria-label="Toggle color theme" title="Toggle theme">◐</button><button class="icon-button" id="helpButton" aria-label="Keyboard shortcuts" title="Keyboard shortcuts">?</button><div class="top-avatar">Y</div></div></header>
+      <section class="content">
+        <div class="page-heading"><div><div class="eyebrow">YOUR PERSONAL WORKSPACE</div><h1 id="pageTitle">My board <span class="title-spark">✳</span></h1><p class="subtitle" id="pageSubtitle">A little progress each day adds up.</p></div><button class="primary-button" id="addTaskTop"><span>＋</span> Add a task <kbd>N</kbd></button></div>
+        <div class="overview"><div class="overview-copy"><div class="date-label" id="todayLabel"></div><strong id="welcomeLine">Make today count.</strong></div><div class="overview-stats"><div class="stat"><span class="stat-icon purple">▤</span><div><strong id="openStat">0</strong><small>open tasks</small></div></div><div class="stat"><span class="stat-icon green">↗</span><div><strong id="doneStat">0</strong><small>done this week</small></div></div><div class="streak"><span>✦</span><div><strong id="streakStat">0 day</strong><small>focus streak</small></div></div></div></div>
+        <div class="board-toolbar"><div class="view-tabs"><button class="view-tab selected" data-view="board">Board <span class="tab-dot"></span></button><button class="view-tab" data-view="list">List</button></div><div class="toolbar-actions"><label class="search"><span>⌕</span><input id="searchInput" type="search" placeholder="Search tasks..." aria-label="Search tasks"><kbd>⌘ K</kbd></label><select id="sortSelect" aria-label="Sort tasks"><option value="manual">Manual order</option><option value="due">Due date</option><option value="priority">Priority</option><option value="newest">Recently added</option></select><button class="filter-button" id="filterButton">☷ <span>Filter</span><i id="filterDot"></i></button></div></div>
+        <div class="filter-row" id="filterRow" hidden><span>Priority:</span><button class="filter-chip active" data-priority="all">All</button><button class="filter-chip" data-priority="high">High</button><button class="filter-chip" data-priority="medium">Medium</button><button class="filter-chip" data-priority="low">Low</button><button class="clear-filter" id="clearFilters">Clear filters</button></div>
+        <section class="board" id="board" aria-label="Kanban board"></section>
+        <section class="list-view" id="listView" hidden></section>
+        <footer class="board-footer"><span><span class="live-dot"></span> Everything is saved automatically</span><span><kbd>N</kbd> new task <span class="footer-divider">·</span> Drag cards to move them</span></footer>
+      </section>
+    </main>
+  </div>
+  <div class="modal-backdrop" id="modalBackdrop" hidden><section class="task-modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle"><div class="modal-header"><div><div class="eyebrow">TASK DETAILS</div><h2 id="modalTitle">Add a task</h2></div><button class="icon-button close-modal" aria-label="Close">×</button></div><form id="taskForm"><input type="hidden" id="taskId"><label class="field-label" for="taskTitle">Task name</label><input class="text-field title-field" id="taskTitle" maxlength="120" placeholder="What needs to get done?" required><label class="field-label" for="taskDescription">Notes <span>OPTIONAL</span></label><textarea class="text-field" id="taskDescription" rows="3" maxlength="600" placeholder="Add a little context..."></textarea><div class="field-grid"><div><label class="field-label" for="taskStatus">Column</label><select class="text-field" id="taskStatus"><option value="todo">To do</option><option value="doing">In progress</option><option value="backlog">Up next</option><option value="done">Done</option></select></div><div><label class="field-label" for="taskPriority">Priority</label><select class="text-field" id="taskPriority"><option value="medium">Medium</option><option value="high">High</option><option value="low">Low</option></select></div></div><div class="field-grid"><div><label class="field-label" for="taskDue">Due date <span>OPTIONAL</span></label><input class="text-field" id="taskDue" type="date"></div><div><label class="field-label" for="taskTag">Label <span>OPTIONAL</span></label><input class="text-field" id="taskTag" maxlength="24" placeholder="e.g. Personal"></div></div><div class="modal-footer"><button type="button" class="delete-button" id="deleteTask" hidden>Delete task</button><span class="modal-spacer"></span><button type="button" class="secondary-button close-modal">Cancel</button><button class="primary-button" type="submit" id="saveTask">Save task</button></div></form></section></div>
+  <div class="toast" id="toast" role="status" aria-live="polite"></div>
+  <script src="app.js"></script>
+</body>
+</html>
