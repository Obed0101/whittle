diff --git a/board/app.js b/board/app.js
new file mode 100644
index 0000000..ec9f9c8
--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,39 @@
+(() => {
+  const KEY='daymark-board-v1';
+  const seed={columns:[{id:'todo',name:'To do'},{id:'doing',name:'In progress'},{id:'done',name:'Done'}],tasks:[
+    {id:'a1',title:'Plan the week ahead',notes:'Pick the three things that would make this week feel good.',status:'todo',priority:'high',due:dateOffset(0),tag:'Personal',created:1},
+    {id:'a2',title:'Book a dentist appointment',notes:'Find a morning slot that works.',status:'todo',priority:'medium',due:dateOffset(3),tag:'Health',created:2},
+    {id:'a3',title:'Read 20 pages',notes:'Continue where I left off in The Creative Act.',status:'todo',priority:'low',due:'',tag:'Personal',created:3},
+    {id:'a4',title:'Update portfolio case study',notes:'Add the latest screens and write up the process.',status:'doing',priority:'high',due:dateOffset(1),tag:'Work',created:4},
+    {id:'a5',title:'Try a new dinner recipe',notes:'Something easy with the vegetables in the fridge.',status:'doing',priority:'none',due:'',tag:'Personal',created:5},
+    {id:'a6',title:'Set up automatic savings',notes:'',status:'done',priority:'medium',due:'',tag:'Personal',created:6}
+  ]};
+  let state=load(),editingId=null,filter='all',search='',sort='manual',toastTimer;
+  const $=s=>document.querySelector(s), board=$('#board');
+  function dateOffset(n){const d=new Date();d.setDate(d.getDate()+n);return d.toISOString().slice(0,10)}
+  function load(){try{const x=JSON.parse(localStorage.getItem(KEY));if(x&&Array.isArray(x.columns)&&Array.isArray(x.tasks)&&x.columns.length)return x}catch(e){}return structuredClone(seed)}
+  function save(){localStorage.setItem(KEY,JSON.stringify(state));$('#totalCount').textContent=state.tasks.length}
+  function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+  function formatDate(s){if(!s)return '';const d=new Date(s+'T12:00:00'),now=new Date();now.setHours(0,0,0,0);const diff=Math.round((d-now)/86400000);if(diff<0)return 'Overdue · '+d.toLocaleDateString('en-US',{month:'short',day:'numeric'});if(diff===0)return 'Today';if(diff===1)return 'Tomorrow';return d.toLocaleDateString('en-US',{month:'short',day:'numeric'})}
+  function isOverdue(s){return !!s&&s<dateOffset(0)}
+  function render(){
+    const filtered=state.tasks.filter(t=>{const text=(t.title+' '+t.notes+' '+t.tag).toLowerCase();return(!search||text.includes(search.toLowerCase()))&&(filter!=='priority'||t.priority==='high')});
+    let tasks=filtered;if(sort==='due')tasks=[...filtered].sort((a,b)=>(a.due||'9999').localeCompare(b.due||'9999'));if(sort==='priority')tasks=[...filtered].sort((a,b)=>({high:0,medium:1,low:2,none:3}[a.priority]??3)-({high:0,medium:1,low:2,none:3}[b.priority]??3));
+    board.innerHTML=state.columns.map((col,i)=>{const cards=tasks.filter(t=>t.status===col.id);return `<section class="column" data-index="${i}" data-column="${esc(col.id)}"><div class="column-header"><span class="column-color"></span><span class="column-name">${esc(col.name)}</span><span class="column-total">${cards.length}</span><button class="column-add" data-add="${esc(col.id)}" aria-label="Add task to ${esc(col.name)}">+</button><button class="column-menu" data-column-menu="${esc(col.id)}" aria-label="Column options">···</button></div><div class="card-list" data-drop="${esc(col.id)}">${cards.length?cards.map(cardHtml).join(''):`<div class="empty-column">Nothing here yet</div>`}</div><button class="add-card" data-add="${esc(col.id)}">＋ Add a task</button></section>`}).join('');
+    $('#sideColumns').innerHTML=state.columns.map(c=>`<div class="side-column"><i class="side-column-dot"></i>${esc(c.name)}<span>${state.tasks.filter(t=>t.status===c.id).length}</span></div>`).join('');$('#totalCount').textContent=state.tasks.length;$('#taskSummary').textContent=`${filtered.length} ${filtered.length===1?'task':'tasks'}`;wireCards();
+  }
+  function cardHtml(t){const label=t.tag?`<div class="card-label ${esc(t.tag.toLowerCase())}">${esc(t.tag)}</div>`:'';const pr=t.priority&&t.priority!=='none'?`<span class="priority ${esc(t.priority)}"><i></i>${t.priority[0].toUpperCase()+t.priority.slice(1)}</span>`:'';const due=t.due?`<span class="due-date ${isOverdue(t.due)?'overdue':t.due===dateOffset(0)?'today':''}">${formatDate(t.due)}</span>`:'';return `<article class="task-card" draggable="true" data-task="${esc(t.id)}" tabindex="0" role="button" aria-label="Edit task: ${esc(t.title)}">${label}<div class="card-title">${esc(t.title)}</div>${t.notes?`<div class="card-notes">${esc(t.notes)}</div>`:''}<div class="card-bottom">${pr}${due}</div></article>`}
+  function wireCards(){document.querySelectorAll('.task-card').forEach(el=>{el.addEventListener('click',()=>openTask(el.dataset.task));el.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();openTask(el.dataset.task)}});el.addEventListener('dragstart',e=>{el.classList.add('dragging');e.dataTransfer.setData('text/plain',el.dataset.task)});el.addEventListener('dragend',()=>el.classList.remove('dragging'))});document.querySelectorAll('.card-list').forEach(el=>{el.addEventListener('dragover',e=>{e.preventDefault();el.classList.add('drag-over')});el.addEventListener('dragleave',()=>el.classList.remove('drag-over'));el.addEventListener('drop',e=>{e.preventDefault();el.classList.remove('drag-over');const task=state.tasks.find(t=>t.id===e.dataTransfer.getData('text/plain'));if(task){task.status=el.dataset.drop;save();render()}})});document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>openTask(null,b.dataset.add));document.querySelectorAll('[data-column-menu]').forEach(b=>b.onclick=()=>columnMenu(b.dataset.columnMenu))}
+  const taskDialog=$('#taskDialog'), columnDialog=$('#columnDialog'),helpDialog=$('#helpDialog');
+  function openTask(id=null,status=state.columns[0].id){editingId=id;const t=state.tasks.find(x=>x.id===id);$('#dialogTitle').textContent=t?'Edit task':'Create a task';$('#saveTaskBtn').textContent=t?'Save changes':'Create task';$('#deleteTaskBtn').classList.toggle('hidden',!t);$('#taskTitle').value=t?.title||'';$('#taskNotes').value=t?.notes||'';$('#taskStatus').innerHTML=state.columns.map(c=>`<option value="${esc(c.id)}">${esc(c.name)}</option>`).join('');$('#taskStatus').value=t?.status||status;$('#taskPriority').value=t?.priority||'none';$('#taskDue').value=t?.due||'';$('#taskTag').value=t?.tag||'';taskDialog.showModal();setTimeout(()=>$('#taskTitle').focus(),50)}
+  $('#newTaskBtn').onclick=()=>openTask();$('#taskForm').onsubmit=e=>{e.preventDefault();const data={title:$('#taskTitle').value.trim(),notes:$('#taskNotes').value.trim(),status:$('#taskStatus').value,priority:$('#taskPriority').value,due:$('#taskDue').value,tag:$('#taskTag').value};if(!data.title)return;if(editingId){Object.assign(state.tasks.find(t=>t.id===editingId),data);notify('Task updated')}else{state.tasks.unshift({id:crypto.randomUUID?crypto.randomUUID():String(Date.now()),...data,created:Date.now()});notify('Task added')}save();render();taskDialog.close()};$('#deleteTaskBtn').onclick=()=>{if(!editingId)return;state.tasks=state.tasks.filter(t=>t.id!==editingId);save();render();taskDialog.close();notify('Task deleted')};
+  document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>b.closest('dialog').close());[taskDialog,columnDialog,helpDialog].forEach(d=>d.addEventListener('click',e=>{if(e.target===d)d.close()}));
+  $('#addColumnBtn').onclick=()=>{ $('#columnName').value='';columnDialog.showModal();$('#columnName').focus()};$('#columnForm').onsubmit=e=>{e.preventDefault();const name=$('#columnName').value.trim();if(!name)return;if(state.columns.some(c=>c.name.toLowerCase()===name.toLowerCase())){notify('A column with that name already exists');return}const id='col-'+(crypto.randomUUID?crypto.randomUUID():Date.now());state.columns.push({id,name});save();render();columnDialog.close();notify('Column added')};
+  function columnMenu(id){const col=state.columns.find(c=>c.id===id);if(!col)return;const choice=prompt(`Column: ${col.name}\nType a new name, or enter DELETE to remove it:`);if(choice===null)return;if(choice.trim().toLowerCase()==='delete'){if(state.columns.length===1){notify('Keep at least one column');return}const target=state.columns.find(c=>c.id!==id);state.tasks.forEach(t=>{if(t.status===id)t.status=target.id});state.columns=state.columns.filter(c=>c.id!==id);save();render();notify(`Column removed; tasks moved to ${target.name}`)}else if(choice.trim()){col.name=choice.trim().slice(0,30);save();render();notify('Column renamed')}}
+  document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===b));render()});$('#searchInput').oninput=e=>{search=e.target.value;render()};$('#clearSearch').onclick=()=>{$('#searchInput').value='';search='';render()};$('#sortBtn').onclick=()=>{sort=sort==='manual'?'due':sort==='due'?'priority':'manual';$('#sortBtn').innerHTML=`↕ <span>Sort: ${sort[0].toUpperCase()+sort.slice(1)}</span><span class="chevron">⌄</span>`;render()};
+  $('#todayNav').onclick=()=>{search='';$('#searchInput').value='';filter='all';document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x.dataset.filter==='all'));state.tasks.forEach(t=>{if(t.due===dateOffset(0))t._visibleToday=true});render();document.querySelectorAll('.task-card').forEach(c=>{const t=state.tasks.find(x=>x.id===c.dataset.task);if(t?.due!==dateOffset(0))c.style.display='none'});notify('Showing tasks due today')};$('#upcomingNav').onclick=()=>{filter='all';search='';$('#searchInput').value='';render();document.querySelectorAll('.task-card').forEach(c=>{const t=state.tasks.find(x=>x.id===c.dataset.task);if(!t?.due||t.due<=dateOffset(0))c.style.display='none'});notify('Showing upcoming tasks')};$('#boardNav').onclick=()=>{render();notify('Showing all tasks')};
+  $('#helpBtn').onclick=()=>helpDialog.showModal();document.addEventListener('keydown',e=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();$('#searchInput').focus()}if(e.key.toLowerCase()==='n'&&!/input|textarea|select/i.test(document.activeElement.tagName)&&!taskDialog.open&&!columnDialog.open&&!helpDialog.open){e.preventDefault();openTask()}});
+  $('#exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify({exported:new Date().toISOString(),...state},null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='daymark-backup-'+dateOffset(0)+'.json';a.click();URL.revokeObjectURL(a.href);notify('Board backup downloaded')};
+  function notify(msg){const el=$('#toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200)}
+  save();render();
+})();
diff --git a/board/index.html b/board/index.html
new file mode 100644
index 0000000..643dda0
--- /dev/null
+++ b/board/index.html
@@ -0,0 +1,39 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="theme-color" content="#f6f7f4">
+  <title>Daymark — Personal Kanban</title>
+  <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+  <div class="app-shell">
+    <aside class="sidebar" aria-label="Main navigation">
+      <a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d.</span><span>daymark</span></a>
+      <div class="workspace-label">YOUR WORKSPACE</div>
+      <button class="nav-item active" id="boardNav"><span class="nav-icon">▦</span>My board<span class="nav-count" id="totalCount">0</span></button>
+      <button class="nav-item" id="todayNav"><span class="nav-icon">◷</span>Due today</button>
+      <button class="nav-item" id="upcomingNav"><span class="nav-icon">⌁</span>Upcoming</button>
+      <div class="sidebar-rule"></div>
+      <div class="workspace-label">YOUR BOARD <button class="tiny-plus" id="addColumnBtn" aria-label="Add a column">+</button></div>
+      <div class="side-columns" id="sideColumns"></div>
+      <div class="sidebar-bottom"><div class="avatar">A</div><div class="profile"><strong>Alex Morgan</strong><span>Personal workspace</span></div><button class="more-button" id="exportBtn" title="Export backup">···</button></div>
+    </aside>
+    <main class="main-area">
+      <header class="topbar"><div class="breadcrumbs"><span>My workspace</span><span class="crumb-slash">/</span><strong>My board</strong></div><div class="top-actions"><label class="search-box"><span>⌕</span><input id="searchInput" type="search" placeholder="Search tasks..." aria-label="Search tasks"><kbd>⌘ K</kbd></label><button class="icon-button" id="helpBtn" aria-label="Keyboard shortcuts" title="Keyboard shortcuts">?</button><button class="avatar top-avatar" aria-label="Alex Morgan">A</button></div></header>
+      <section class="board-content">
+        <div class="page-heading"><div><div class="eyebrow"><span class="live-dot"></span> YOUR PERSONAL SPACE</div><h1>My board <button class="title-menu" aria-label="Board options">⌄</button></h1><p class="subtitle">A little progress, every day.</p></div><div class="heading-actions"><button class="button button-quiet" id="viewBtn"><span>▤</span> Board view <span class="chevron">⌄</span></button><button class="button button-dark" id="newTaskBtn"><span class="plus">+</span> New task <kbd>N</kbd></button></div></div>
+        <div class="board-toolbar"><div class="board-tabs"><button class="tab active" data-filter="all">All tasks</button><button class="tab" data-filter="priority">Priority <span class="priority-tab-dot"></span></button></div><div class="toolbar-right"><span id="taskSummary">0 tasks</span><span class="toolbar-divider"></span><button class="filter-button" id="sortBtn">↕ <span>Sort: Manual</span><span class="chevron">⌄</span></button><button class="icon-button filter-icon" id="clearSearch" title="Clear search" aria-label="Clear search">×</button></div></div>
+        <div class="board" id="board" aria-label="Kanban board"></div>
+        <footer class="board-footer"><span><span class="save-dot"></span> Changes saved automatically</span><span>Make space for what matters.</span></footer>
+      </section>
+    </main>
+  </div>
+  <dialog id="taskDialog" class="modal"><form id="taskForm"><div class="modal-top"><div><div class="modal-kicker">TASK DETAILS</div><h2 id="dialogTitle">Create a task</h2></div><button type="button" class="close-button" data-close aria-label="Close">×</button></div><label class="field-label" for="taskTitle">Task name</label><input class="text-input title-input" id="taskTitle" maxlength="120" placeholder="What needs doing?" required><label class="field-label" for="taskNotes">Notes <span>OPTIONAL</span></label><textarea class="text-input notes-input" id="taskNotes" maxlength="1000" rows="3" placeholder="Add a little context..."></textarea><div class="field-row"><div class="field-group"><label class="field-label" for="taskStatus">Status</label><select class="text-input" id="taskStatus"></select></div><div class="field-group"><label class="field-label" for="taskPriority">Priority</label><select class="text-input" id="taskPriority"><option value="none">No priority</option><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option></select></div></div><div class="field-row"><div class="field-group"><label class="field-label" for="taskDue">Due date</label><input class="text-input" id="taskDue" type="date"></div><div class="field-group"><label class="field-label" for="taskTag">Label</label><select class="text-input" id="taskTag"><option value="">No label</option><option value="Personal">Personal</option><option value="Work">Work</option><option value="Learning">Learning</option><option value="Health">Health</option></select></div></div><div class="modal-footer"><button type="button" class="button button-delete hidden" id="deleteTaskBtn">Delete task</button><span class="modal-spacer"></span><button type="button" class="button button-quiet" data-close>Cancel</button><button class="button button-dark" type="submit" id="saveTaskBtn">Create task</button></div></form></dialog>
+  <dialog id="columnDialog" class="modal small-modal"><form id="columnForm"><div class="modal-top"><div><div class="modal-kicker">YOUR WORKFLOW</div><h2>Add a column</h2></div><button type="button" class="close-button" data-close aria-label="Close">×</button></div><label class="field-label" for="columnName">Column name</label><input class="text-input title-input" id="columnName" maxlength="30" placeholder="e.g. Waiting on" required><div class="modal-footer"><span class="modal-spacer"></span><button type="button" class="button button-quiet" data-close>Cancel</button><button class="button button-dark" type="submit">Add column</button></div></form></dialog>
+  <dialog id="helpDialog" class="modal small-modal"><div class="modal-top"><div><div class="modal-kicker">A FEW SHORTCUTS</div><h2>Move at your pace.</h2></div><button type="button" class="close-button" data-close aria-label="Close">×</button></div><div class="shortcut-list"><div><span>Create a task</span><kbd>N</kbd></div><div><span>Search your board</span><kbd>⌘ K</kbd></div><div><span>Drag cards to move them</span><span class="shortcut-hint">OR EDIT STATUS</span></div></div><p class="help-note">Your board stays on this device. Use the menu in the sidebar to export a backup.</p></dialog>
+  <div class="toast" id="toast" role="status" aria-live="polite"></div>
+  <script src="app.js"></script>
+</body>
+</html>
