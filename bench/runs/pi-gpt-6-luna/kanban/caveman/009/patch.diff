+(()=>{'use strict';const KEY='dayboard.tasks.v1',THEME='dayboard.theme';const columns=[['todo','Up next'],['progress','In progress'],['done','Done'],['later','On the horizon']];const today=()=>new Date().toISOString().slice(0,10);const uid=()=>Math.random().toString(36).slice(2,10);const defaults=[{id:uid(),title:'Plan the week, gently',description:'Pick three things that would make this week feel good.',status:'todo',category:'Personal',priority:'high',due:today(),checklist:['Choose top three','Block focus time'],created:Date.now()-5000},{id:uid(),title:'Send the project proposal',description:'Share the updated scope and timeline with the team.',status:'todo',category:'Work',priority:'normal',due:'',checklist:[],created:Date.now()-4000},{id:uid(),title:'Book a dentist appointment',description:'Find a slot that works next week.',status:'todo',category:'Health',priority:'normal',due:'',checklist:[],created:Date.now()-3000},{id:uid(),title:'Read 20 pages',description:'Keep the phone in another room.',status:'progress',category:'Learning',priority:'low',due:'',checklist:[],created:Date.now()-2000},{id:uid(),title:'Take a proper lunch break',description:'Step away from the desk and get outside.',status:'done',category:'Health',priority:'normal',due:'',checklist:[],created:Date.now()-1000},{id:uid(),title:'Refresh portfolio homepage',description:'Collect a few references before starting.',status:'later',category:'Work',priority:'low',due:'',checklist:[],created:Date.now()}];let tasks;try{const v=JSON.parse(localStorage.getItem(KEY));tasks=Array.isArray(v)?v:defaults}catch{tasks=defaults}let filter='all',query='',editing=null;const $=s=>document.querySelector(s),board=$('#board'),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function persist(){localStorage.setItem(KEY,JSON.stringify(tasks))}function dateLabel(d){if(!d)return'';const dt=new Date(d+'T00:00:00');return dt.toLocaleDateString(undefined,{month:'sh