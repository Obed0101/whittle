${items.length?`<span class="checklist">☑ ${complete}/${items.length}</span>`:''}</div><span>${t.status==='done'?'✓':''}</span></div></article>`}function bindBoard(){board.querySelectorAll('[data-add]').forEach(b=>b.onclick=e=>{e.stopPropagation();openForm(null,b.dataset.add)});board.querySelectorAll('.card').forEach(c=>{c.onclick=()=>openForm(c.dataset.id);c.ondragstart=e=>{e.dataTransfer.setData('text/plain',c.dataset.id);e.dataTransfer.effectAllowed='move';c.classList.add('dragging')};c.ondragend=()=>c.classList.remove('dragging')});board.querySelectorAll('.column').forEach(col=>{col.ondragover=e=>{e.preventDefault();col.classList.add('drag-over')};col.ondragleave=e=>{if(!col.contains(e.relatedTarget))col.classList.remove('drag-over')};col.ondrop=e=>{e.preventDefault();col.classList.remove('drag-over');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=col.dataset.status;persist();render()}};col.querySelector('.column-head').onclick=e=>{if(innerWidth<=600&&!e.target.closest('button'))col.classList.toggle('expanded')}})}function openForm(id,status='todo'){editing=id;const t=tasks.find(x=>x.id===id);$('#taskForm').reset();$('#modalTitle').textContent=t?'Edit task':'New task';$('#deleteTask').hidden=!t;if(t){$('#title').value=t.title;$('#description').value=t.description||'';$('#status').value=t.status;$('#category').value=t.category;$('#due').value=t.due||'';$('#priority').value=t.priority||'normal';$('#checklist').value=(t.checklist||[]).map(x=>typeof x==='string'?x:x.text).join('\n')}else $('#status').value=status;$('#backdrop').hidden=false;setTimeout(()=>$('#title').focus(),30)}function close(){ $('#backdrop').hidden=true;editing=null}$('#newTask').onclick=()=>openForm();$('#closeModal').onclick=$('#cancelModal').onclick=close;$('#backdrop').onclick=e=>{if(e.target===$('#backdrop'))close()};document.onkeydown=e=>{if(e.key==='Escape'&&!$('#backdrop').hidden)close();if((e.metaKey||e.ctrlKey)&&e.key==='Enter'&&!$('#backdrop').hidden)