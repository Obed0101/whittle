m;color:var(--green);background:var(--soft);padding:4px 8px;border-radius:20px;font-weight:750}.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;align-items:stretch;padding-bottom:80px}.plan{position:relative;background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:29px 27px 25px;box-shadow:var(--shadow);display:flex;flex-direction:column;min-height:430px;transition:transform .2s,box-shadow .2s}.plan:hover{transform:translateY(-4px);box-shadow:0 23px 56px #253a2a1c}.plan.featured{border:2px solid var(--green);padding:28px 26px 24px;transform:translateY(-10px)}.plan.featured:hover{transform:translateY(-14px)}.badge{position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:var(--green);color:white;padding:5px 13px;border-radius:20px;font-size:.72rem;font-weight:750;white-space:nowrap;letter-spacing:.03em}.plan h2{font-size:1.13rem;margin:2px 0 5px}.desc{font-size:.87rem;color:var(--muted);min-height:43px;margin:0}.price{display:flex;align-items:baseline;gap:3px;margin:20px 0 2px}.amount{font-size:2.8rem;line-height:1;font-weight:760;letter-spacing:-.07em}.period{color:var(--muted);font-size:.85rem}.billed{height:23px;color:var(--muted);font-size:.76rem}.cta{display:block;text-align:center;text-decoration:none;border:1px solid var(--line);border-radius:9px;padding:11px 14px;margin:15px 0 21px;font-weight:700;font-size:.9rem;transition:background .18s,color .18s}.cta:hover{background:var(--soft)}.featured .cta{background:var(--green);color:white;border-color:var(--green)}.featured .cta:hover{background:var(--green-dark)}.rule{height:1px;background:var(--line);margin-bottom:17px}.list-label{font-weight:700;font-size:.78rem;margin:0 0 10px}.features{padding:0;margin:0;list-style:none;display:grid;gap:10px;font-size:.85rem;color:var(--muted)}.features li{display:flex;gap:9px}.check{color:var(--green);font-weight:900}.section{padding:9px 0 84px}.section-heading{text-align:center;margin-bottom:30px}.section-heading h2{font-size:2rem;letter-spacing:-.05em;margin:0 0 7px}.section-heading p{color:var(--muted);margin:0}.table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:14px;background:var(--surface);box-shadow:var(--shadow)}table{width:100%;border-collapse:collapse;min-width:640px;text-align:left}th,td{padding:15px 20px;border-bottom:1px solid var(--line);font-size:.88rem}thead th{background:var(--soft);font-size:.8rem;color:var(--green);font-weight:750}thead th:first-child{width:42%;border-radius:13px 0 0}tbody th{font-weight:600}td{text-align:center;color:var(--muted)}tbody tr:last-child th,tbody tr:last-child td{border-bottom:0}.yes{color:var(--green);font-weight:800}.no{color:#a3a9a1}.faq{max-width:760px;margin:0 auto}.faq details{border-bottom:1px solid var(--line)}.faq details:first-child{border-top:1px solid var(--line)}.faq summary{list-style:none;padding:19px 38px 19px 2px;cursor:pointer;font-weight:700;position:relative}.faq summary::-webkit-details-marker{display:none}.faq summary:after{content:'+';position:absolute;right:6px;top:15px;font-size:1.35rem;color:var(--green);font-weight:400;transition:transform .2s}.faq details[open] summary:after{transform:rotate(45deg)}.faq details p{color:var(--muted);margin:-5px 30px 20px 2px;font-size:.92rem}.footer{border-top:1px solid var(--line);padding:25px 0;color:var(--muted);font-size:.82rem}.footer-inner{display:flex;justify-content:space-between;gap:20px}.footer a{color:var(--green);text-decoration:none} :focus-visible{outline:3px solid #d29135;outline-offset:3px;border-radius:4px}
+@media(prefers-color-scheme:dark){:root{--bg:#141815;--surface:#1d231f;--ink:#edf1eb;--muted:#a9b1a8;--line:#343d36;--green:#8dc4a0;--green-dark:#6dab83;--soft:#27382d;--shadow:0 18px 50px #0003;color-scheme:dark}.featured .cta{color:#112117}.nav .nav-cta{color:#122218}.badge{color:#112117}.switch{background:#59996d}.switch span{background:#fff}.save{color:#b0dbbc}.hero .eyebrow{color:#a4d2b0}.yes{color:#a4d2b0}.plan.featured{border-color:#8dc4a0}}
+@media(max-width:760px){.shell{width:min(100% - 32px,560px)}.topbar{height:66px}.nav{gap:14px}.nav a:not(.nav-cta){display:none}.hero{padding:57px 0 40px}.plans{grid-template-columns:1fr;gap:16px;padding-bottom:60px}.plan,.plan.featured{min-height:unset;transform:none;padding:25px}.plan.featured:hover,.plan:hover{transform:translateY(-3px)}.desc{min-height:unset}.section{padding-bottom:60px}.section-heading h2{font-size:1.7rem}.footer-inner{flex-direction:column;gap:5px}}
