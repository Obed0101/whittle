+<script>
+const billingToggle = document.getElementById('billing-toggle');
+billingToggle.addEventListener('change', () => {
+  const yearly = billingToggle.checked;
+  document.querySelectorAll('.amount').forEach(price => {
+    const value = Number(yearly ? price.dataset.year : price.dataset.month);
+    price.textContent = '$' + (Number.isInteger(value) ? value : value.toFixed(2));
+  });
+  document.querySelectorAll('[data-annual-note]').forEach(note => {
+    note.textContent = yearly ? 'Billed annually · Save 20%' : '';
+  });
+  document.querySelectorAll('.period').forEach(period => {
+    period.textContent = yearly ? '/ user / month, billed yearly' : '/ user / month';
+  });
+});
