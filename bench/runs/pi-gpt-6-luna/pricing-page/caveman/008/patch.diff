+<script>(()=>{const toggle=document.getElementById('billing-switch');const amounts=document.querySelectorAll('.amount');const billed=document.querySelectorAll('[data-billed-monthly]');const status=document.getElementById('billing-status');const monthly=document.getElementById('monthly-label');const yearly=document.getElementById('yearly-label');toggle.addEventListener('click',()=>{const isYearly=toggle.getAttribute('aria-checked')!=='true';toggle.setAttribute('aria-checked',String(isYearly));amounts.forEach(el=>{const value=isYearly?el.dataset.yearly:el.dataset.monthly;el.textContent=Number.isInteger(Number(value))?'$'+value:'$'+Number(value).toFixed(2)});billed.forEach(el=>{el.textContent=isYearly?el.dataset.billedYearly:el.dataset.billedMonthly});monthly.classList.toggle('active',!isYearly);yearly.classList.toggle('active',isYearly);status.textContent=isYearly?'Yearly billing selected. Save 20%.':'Monthly billing selected.'})})();</script>
