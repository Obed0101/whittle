+<script>
+(() => {
+ const toggle = document.getElementById('billing-switch');
+ const monthly = document.getElementById('monthly-label');
+ const yearly = document.getElementById('yearly-label');
+ const prices = document.querySelectorAll('.amount');
+ const notes = document.querySelectorAll('.billnote[data-note]');
+ function setYearly(isYearly) {
+  toggle.setAttribute('aria-checked', String(isYearly));
+  toggle.setAttribute('aria-label', isYearly ? 'Use monthly billing' : 'Use yearly billing');
+  monthly.classList.toggle('active', !isYearly);
+  yearly.classList.toggle('active', isYearly);
+  prices.forEach(price => { price.textContent = isYearly ? price.dataset.year : price.dataset.month; });
+  notes.forEach(note => { note.textContent = isYearly ? note.dataset.yearNote : note.dataset.note; });
+ }
+ toggle.addEventListener('click', () => setYearly(toggle.getAttribute('aria-checked') !== 'true'));
+ monthly.addEventListener('click', () => setYearly(false));
+ yearly.addEventListener('click', () => setYearly(true));
+})();
+</script>
