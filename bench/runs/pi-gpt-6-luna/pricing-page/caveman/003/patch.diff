+<script>
+(()=>{const toggle=document.querySelector('.switch');const prices=document.querySelectorAll('.amount');const notes=document.querySelectorAll('[data-annual-note]');function update(yearly){toggle.setAttribute('aria-checked',String(yearly));prices.forEach(price=>{const value=yearly?price.dataset.yearly:price.dataset.monthly;price.textContent='$'+(Number(value)%1?Number(value).toFixed(2).replace(/0$/,''):value)});notes.forEach(note=>note.textContent=yearly?'Billed annually':'\u00a0')}toggle.addEventListener('click',()=>update(toggle.getAttribute('aria-checked')!=='true'))})();
