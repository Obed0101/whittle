+<script>
+(() => {
+ const toggle = document.getElementById('billing-switch');
+ const amounts = document.querySelectorAll('.amount');
+ const notes = document.querySelectorAll('[data-note]');
+ const update = () => {
+  const yearly = toggle.getAttribute('aria-checked') === 'true';
+  amounts.forEach(amount => { amount.textContent = '$' + (yearly ? amount.dataset.year : amount.dataset.month); });
+  notes.forEach(note => { note.textContent = yearly ? 'Billed yearly · save 20%' : 'Billed monthly'; });
+ };
+ toggle.addEventListener('click', () => {
+  toggle.setAttribute('aria-checked', toggle.getAttribute('aria-checked') === 'false' ? 'true' : 'false');
