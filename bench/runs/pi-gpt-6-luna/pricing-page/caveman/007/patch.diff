+(() => {const toggle=document.getElementById('billing-switch');const amounts=document.querySelectorAll('.amount');const notes=document.querySelectorAll('[data-note]');const monthly=document.getElementById('monthly-label');const yearly=document.getElementById('yearly-label');function setYearly(yearlyOn){toggle.setAttribute('aria-checked',String(yearlyOn));amounts.forEach(item=>{const value=yearlyOn?item.dataset.year:item.dataset.month;item.textContent='$'+(Number.isInteger(Number(value))?value:Number(value).toFixed(2).replace(/0$/,''))});notes.forEach(item=>item.textContent=yearlyOn?'Billed annually':'Billed monthly');monthly.classList.toggle('active',!yearlyOn);yearly.classList.toggle('active',yearlyOn)}toggle.addEventListener('click',()=>setYearly(toggle.getAttribute('aria-checked')!=='true'));monthly.addEventListener('click',()=>setYearly(false));yearly.addEventListener('click',()=>setYearly(true));})();
