+(function(){const toggle=document.getElementById('billing-toggle');const prices=document.querySelectorAll('.price[data-month]');const bills=document.querySelectorAll('[data-bill-month]');toggle.addEventListener('change',function(){const yearly=toggle.checked;toggle.setAttribute('aria-label',yearly?'Switch to monthly billing':'Switch to yearly billing');prices.forEach(function(el){const amount=Number(yearly?el.dataset.year:el.dataset.month);el.textContent='$'+(Number.isInteger(amount)?amount:amount.toFixed(2).replace(/0$/,''));});bills.forEach(function(el){el.textContent=yearly?el.dataset.billYear:el.dataset.billMonth;});});})();
