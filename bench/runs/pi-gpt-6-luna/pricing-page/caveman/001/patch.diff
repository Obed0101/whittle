ne);border-radius:20px;padding:29px;box-shadow:var(--shadow);display:flex;flex-direction:column;animation:rise .55s both}.plan:nth-child(2){animation-delay:.08s}.plan:nth-child(3){animation-delay:.16s}.plan.featured{border:2px solid var(--green);transform:translateY(-9px);box-shadow:0 20px 55px #176b4b20}.badge{position:absolute;right:18px;top:17px;font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;font-weight:800;color:var(--green);background:var(--green2);padding:5px 9px;border-radius:30px}.plan h2{font-size:1.15rem;margin:0 0 5px}.desc{color:var(--muted);font-size:.9rem;min-height:45px;margin:0}.price{display:flex;align-items:baseline;gap:5px;margin:20px 0 2px}.amount{font-size:3rem;letter-spacing:-.07em;line-height:1;font-weight:760}.period{color:var(--muted);font-size:.84rem}.billing-note{height:22px;font-size:.77rem;color:var(--muted)}.cta{display:block;text-align:center;text-decoration:none;border:1px solid var(--line);border-radius:10px;padding:11px 15px;font-weight:700;margin:15px 0 20px;transition:transform .2s,background .2s}.cta:hover{transform:translateY(-2px);background:var(--green2)}.featured .cta{background:var(--green);color:white;border-color:var(--green)}.featured .cta:hover{background:#10583d}.list-title{border-top:1px solid var(--line);padding-top:17px;font-size:.78rem;font-weight:750}.features{list-style:none;padding:0;margin:10px 0 0;display:grid;gap:10px;font-size:.87rem}.features li:before{content:"✓";font-weight:800;color:var(--green);margin-right:9px}.section{padding:59px 0;border-top:1px solid var(--line)}.section-head{text-align:center;margin-bottom:30px}.section h2{font-size:clamp(1.8rem,4vw,2.5rem);letter-spacing:-.05em;margin:8px 0}.section-head p{color:var(--muted);margin:0}.table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:16px;background:var(--paper);box-shadow:var(--shadow)}table{width:100%;border-collapse:collapse;min-width:650px;text-align:center}th,td{padding:15px 18px;border-bottom:1px solid var(--line)}thead th{font-size:.9rem;background:color-mix(in srgb,var(--paper),var(--bg) 45%)}th:first-child,td:first-child{text-align:left;width:45%}tbody th{font-size:.88rem;font-weight:600}td{font-size:.92rem;color:var(--muted)}.yes{color:var(--green);font-weight:800;font-size:1.1rem}.highlight{background:color-mix(in srgb,var(--green2),transparent 55%)}.faq{max-width:770px;margin:0 auto}.faq details{border-bottom:1px solid var(--line)}.faq summary{list-style:none;cursor:pointer;padding:19px 36px 19px 2px;font-weight:700;position:relative}.faq summary::-webkit-details-marker{display:none}.faq summary:after{content:"+";position:absolute;right:6px;font-size:1.3rem;color:var(--green);top:14px;transition:transform .2s}.faq details[open] summary:after{transform:rotate(45deg)}.answer{color:var(--muted);padding:0 30px 19px 2px;margin:0}.footer{padding:30px 0 42px;text-align:center;color:var(--muted);font-size:.82rem}.footer a{color:var(--green)}:focus-visible{outline:3px solid #79b83d;outline-offset:4px;border-radius:4px}@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}@media(max-width:760px){.hero{padding:56px 0 32px}.plans{grid-template-columns:1fr;max-width:500px;margin:auto;gap:14px;padding-bottom:50px}.plan.featured{transform:none;order:-1}.desc{min-height:0}.plan{padding:25px}.section{padding:47px 0}.nav{height:66px}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
