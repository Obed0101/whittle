+<script>
+(() => {const toggle=document.querySelector('.switch');const prices=document.querySelectorAll('.amount');const notes=document.querySelectorAll('[data-note]');toggle.addEventListener('click',()=>{const yearly=toggle.getAttribute('aria-checked')!=='true';toggle.setAttribute('aria-checked',String(yearly));prices.forEach(el=>{const value=yearly?el.dataset.year:el.dataset.month;el.textContent='$'+(value==='0'?'0':value)});notes.forEach(el=>{el.textContent=yearly?el.dataset.note:'Billed monthly'})})})();
