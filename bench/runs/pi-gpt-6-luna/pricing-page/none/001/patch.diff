face);border:1px solid var(--line);border-radius:18px;padding:28px;box-shadow:var(--shadow);display:flex;flex-direction:column;position:relative;transition:transform .22s ease,box-shadow .22s ease}.card:hover{transform:translateY(-4px);box-shadow:0 24px 58px #183a2b1c}.card.featured{border:2px solid var(--green);padding:27px;background:linear-gradient(160deg,var(--soft),var(--surface) 42%);box-shadow:0 20px 55px #176b501c}.popular{position:absolute;right:18px;top:18px;background:var(--green);color:white;text-transform:uppercase;letter-spacing:.1em;font-size:.65rem;font-weight:800;border-radius:99px;padding:6px 9px}.card h2{font-size:1.2rem;margin:0 0 6px}.desc{color:var(--muted);font-size:.9rem;min-height:45px;margin:0}.price{display:flex;align-items:baseline;gap:4px;margin:23px 0 2px}.amount{font-size:3.25rem;font-weight:760;letter-spacing:-.07em;line-height:1}.per{color:var(--muted);font-size:.85rem}.billed{min-height:23px;color:var(--muted);font-size:.78rem}.card ul{list-style:none;padding:17px 0 20px;margin:10px 0 0;border-top:1px solid var(--line);display:grid;gap:11px;font-size:.9rem}.card li{display:flex;gap:10px}.check{color:var(--green);font-weight:900}.button{display:block;text-align:center;text-decoration:none;border:1px solid var(--ink);border-radius:9px;padding:12px 14px;font-weight:700;margin-top:auto;transition:background .18s,color .18s,transform .18s}.button:hover{transform:translateY(-1px);background:var(--ink);color:var(--bg)}.featured .button{background:var(--green);border-color:var(--green);color:white}.featured .button:hover{background:var(--green-dark)}.section{padding:62px 0;border-top:1px solid var(--line)}.section-heading{text-align:center;margin:0 auto 35px}.section-heading h2{font-size:clamp(1.8rem,4vw,2.6rem);letter-spacing:-.05em;margin:0 0 8px}.section-heading p{color:var(--muted);margin:0}.table-scroll{overflow-x:auto;border:1px solid var(--line);border-radius:14px;background:var(--surface);box-shadow:var(--shadow)}table{width:100%;border-collapse:collapse;min-width:620px;text-align:center}th,td{padding:16px 20px;border-bottom:1px solid var(--line)}thead th{font-size:.9rem}thead th:first-child{text-align:left;width:42%}tbody th{text-align:left;font-size:.9rem;font-weight:550}tbody td{color:var(--green);font-weight:750}tbody tr:last-child th,tbody tr:last-child td{border-bottom:0}.muted-cell{color:#a0aaa4!important}.faq{max-width:760px;margin:auto}.faq details{border-bottom:1px solid var(--line)}.faq summary{cursor:pointer;list-style:none;padding:20px 42px 20px 0;font-weight:700;position:relative}.faq summary::-webkit-details-marker{display:none}.faq summary:after{content:'+';position:absolute;right:6px;top:15px;font-size:1.5rem;color:var(--green);font-weight:400}.faq details[open] summary:after{content:'−'}.faq details p{margin:0;padding:0 35px 20px 0;color:var(--muted)}.bottom-cta{margin:60px 0 70px;padding:42px;border-radius:18px;background:var(--ink);color:var(--bg);display:flex;align-items:center;justify-content:space-between;gap:24px}.bottom-cta h2{margin:0;font-size:1.7rem;letter-spacing:-.04em}.bottom-cta p{margin:5px 0 0;color:#c2cec7}.bottom-cta a{white-space:nowrap;background:#fff;color:#17251f;text-decoration:none;border-radius:9px;padding:12px 18px;font-weight:700}.footer{border-top:1px solid var(--line);padding:24px 0;color:var(--muted);font-size:.85rem;display:flex;justify-content:space-between}.footer a{text-decoration:none}
