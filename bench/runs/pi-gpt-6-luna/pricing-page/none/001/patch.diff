+<script>
+const billingButtons = document.querySelectorAll('[data-billing]');
+billingButtons.forEach(button => button.addEventListener('click', () => {
+  const yearly = button.dataset.billing === 'yearly';
+  billingButtons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
+  document.querySelectorAll('.amount').forEach(price => {
+    const value = Number(price.dataset[yearly ? 'yearly' : 'monthly']);
+    price.textContent = '$' + (Number.isInteger(value) ? value : value.toFixed(2));
+  });
+  document.querySelectorAll('[data-billed]').forEach(note => {
+    note.textContent = yearly ? 'Billed annually' : 'Billed monthly';
+  });
+}));
+</script>
