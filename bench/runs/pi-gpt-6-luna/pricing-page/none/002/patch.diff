+  <script>
+    (() => {
+      const toggle = document.getElementById('billing-toggle');
+      const amounts = document.querySelectorAll('.amount');
+      const notes = document.querySelectorAll('.price-note');
+      const monthly = document.getElementById('monthly-label');
+      const yearly = document.getElementById('yearly-label');
+      function updatePrices() {
+        const annual = toggle.checked;
+        amounts.forEach((el) => {
+          el.textContent = '$' + (annual ? el.dataset.year : el.dataset.month);
+        });
+        notes.forEach((el, index) => {
+          el.textContent = index === 0 ? 'No credit card required' : annual ? 'Billed annually' : 'Billed monthly';
+        });
+        monthly.classList.toggle('active', !annual);
+        yearly.classList.toggle('active', annual);
+        toggle.setAttribute('aria-label', annual ? 'Switch to monthly billing' : 'Switch to yearly billing');
+        toggle.setAttribute('aria-checked', String(annual));
+      }
+      toggle.addEventListener('change', updatePrices);
+      monthly.addEventListener('click', () => { toggle.checked = false; updatePrices(); });
