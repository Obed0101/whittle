+(()=>{const controls=[...document.querySelectorAll('[data-billing]')];const prices=[...document.querySelectorAll('.amount')];const notes=[...document.querySelectorAll('[data-note-monthly]')];function setBilling(period){controls.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.billing===period)));prices.forEach(price=>{const value=price.dataset[period];price.textContent='$'+(period==='yearly'&&value!=='0'?Number(value).toFixed(value.includes('.')?2:0):value)});notes.forEach(note=>note.textContent=note.dataset['note'+period[0].toUpperCase()+period.slice(1)])}controls.forEach(button=>button.addEventListener('click',()=>setBilling(button.dataset.billing)))})();
