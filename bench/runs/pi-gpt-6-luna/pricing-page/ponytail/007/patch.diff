ive;background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:29px;box-shadow:var(--shadow);display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s}.plan:hover{transform:translateY(-4px);box-shadow:0 23px 60px #183c2b1d}.plan.featured{border:2px solid var(--green);padding:28px;box-shadow:0 20px 60px #176b501c}.badge{position:absolute;right:18px;top:18px;background:var(--lime);color:#26351d;border-radius:99px;padding:5px 10px;font-size:.7rem;font-weight:800;letter-spacing:.04em}.plan h2{font-size:1.15rem;margin:0 0 8px}.desc{color:var(--muted);font-size:.9rem;min-height:44px;margin-bottom:24px}.price{display:flex;align-items:baseline;gap:3px;margin-bottom:4px}.amount{font-size:3.2rem;line-height:1;font-weight:720;letter-spacing:-.07em}.period{color:var(--muted);font-size:.86rem}.billing-note{height:22px;color:var(--muted);font-size:.76rem}.plan hr{width:100%;border:0;border-top:1px solid var(--line);margin:18px 0}.plan h3{font-size:.75rem;text-transform:uppercase;letter-spacing:.1em;margin-bottom:13px}.features{list-style:none;padding:0;margin:0 0 26px;display:grid;gap:11px;color:var(--muted);font-size:.88rem}.features li{display:flex;gap:10px;align-items:flex-start}.check{color:var(--green);font-weight:800}.cta{display:block;text-align:center;text-decoration:none;border:1px solid var(--line);border-radius:9px;padding:11px 15px;font-weight:700;font-size:.9rem;margin-top:auto;transition:background .15s,color .15s,transform .15s}.cta:hover{transform:translateY(-1px);background:var(--soft)}.featured .cta{background:var(--green);color:white;border-color:var(--green)}.featured .cta:hover{background:#10553f}.section{padding:66px 0;border-top:1px solid var(--line)}.section-head{text-align:center;margin-bottom:32px}.section-head h2{font-size:clamp(1.8rem,4vw,2.55rem);letter-spacing:-.055em;margin:10px 0}.section-head p{color:var(--muted);margin:0}.table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:14px;background:var(--surface);box-shadow:var(--shadow)}table{width:100%;border-collapse:collapse;text-align:center;min-width:600px}th,td{padding:15px 20px;border-bottom:1px solid var(--line)}thead th{font-size:.85rem}th:first-child,td:first-child{text-align:left;width:43%}thead th:first-child{color:var(--muted);font-weight:500}tbody th{font-weight:550;font-size:.9rem}tbody td{color:var(--green);font-weight:750}tbody tr:last-child th,tbody tr:last-child td{border-bottom:0}.faq{max-width:760px;margin:0 auto;padding-bottom:85px}.faq details{border-bottom:1px solid var(--line)}.faq summary{cursor:pointer;list-style:none;padding:20px 36px 20px 2px;font-weight:650;position:relative}.faq summary::-webkit-details-marker{display:none}.faq summary:after{content:"+";position:absolute;right:5px;top:15px;font-size:1.4rem;font-weight:400;color:var(--green);transition:transform .2s}.faq details[open] summary:after{transform:rotate(45deg)}.faq details p{color:var(--muted);margin:-3px 32px 20px 2px;font-size:.93rem}.closing{text-align:center;background:var(--soft);padding:38px 20px;border-radius:16px;margin:0 auto 70px}.closing h2{font-size:1.5rem;letter-spacing:-.04em;margin-bottom:8px}.closing p{color:var(--muted);margin-bottom:18px}.closing a{display:inline-block;background:var(--green);color:#fff;text-decoration:none;font-size:.9rem;font-weight:700;padding:11px 18px;border-radius:9px}.foot{border-top:1px solid var(--line);padding:22px 0;color:var(--muted);font-size:.82rem}.foot .wrap{display:flex;justify-content:space-between;gap:16px}.foot a{text-decoration:none}
