erflow-x:auto;border:1px solid var(--line);border-radius:14px;background:var(--paper);box-shadow:var(--shadow)}table{border-collapse:collapse;width:100%;min-width:620px;text-align:center;font-size:.87rem}th,td{padding:14px 18px;border-bottom:1px solid var(--line)}thead th{font-size:.82rem;background:var(--soft)}th:first-child,td:first-child{text-align:left;width:43%}tbody tr:last-child td{border-bottom:0}tbody td:first-child{font-weight:600}.yes{color:var(--green);font-weight:800;font-size:1.05rem}.no{color:#a6afa8}.faq{max-width:760px;margin:0 auto;padding-bottom:82px}.faq details{border-bottom:1px solid var(--line)}.faq summary{cursor:pointer;list-style:none;padding:19px 30px 19px 0;font-weight:680;position:relative}.faq summary::-webkit-details-marker{display:none}.faq summary:after{content:"+";position:absolute;right:4px;color:var(--green);font-size:1.3rem;top:14px}.faq details[open] summary:after{content:"−"}.faq details p{margin:0;padding:0 35px 19px 0;color:var(--muted);font-size:.92rem}.footer{border-top:1px solid var(--line);padding:25px 0 35px;color:var(--muted);font-size:.82rem;display:flex;justify-content:space-between;gap:18px}.footer a{color:var(--green)}:focus-visible{outline:3px solid #71a953;outline-offset:3px;border-radius:3px}
