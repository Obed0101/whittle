+:root{color-scheme:light dark;--bg:#f7f7f4;--surface:#fff;--ink:#17231f;--muted:#68746e;--line:#e2e7e2;--green:#176b4b;--mint:#e4f3e9;--shadow:0 20px 55px #183d2612;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);line-height:1.55}a{color:inherit}.wrap{width:min(1120px,calc(100% - 40px));margin:auto}.topbar{height:76px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:10px;text-decoration:none;font-weight:760;font-size:1.15rem;letter-spacing:-.04em}.mark{display:grid;place-items:center;width:32px;height:32px;border-radius:11px;background:var(--green);color:white;font-size:17px}.nav{display:flex;align-items:center;gap:26px;font-size:.9rem;color:var(--muted)}.nav a{text-decoration:none}.nav .login{color:var(--ink);font-weight:650}.intro{text-align:center;padding:75px 0 34px}.eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--green);font-size:.75rem;font-weight:750;letter-spacing:.12em;text-transform:uppercase}.eyebrow:before{content:"";width:7px;height:7px;background:#65b987;border-radius:50%}h1{font-size:clamp(2.6rem,6vw,4.3rem);line-height:1.04;letter-spacing:-.065em;margin:16px 0} .intro p{max-width:570px;margin:0 auto;color:var(--muted);font-size:1.08rem}.billing{display:flex;align-items:center;justify-content:center;gap:13px;margin:30px auto 0}.switch{display:flex;padding:4px;border:1px solid var(--line);background:var(--surface);border-radius:999px}.switch button{border:0;background:transparent;color:var(--muted);padding:9px 16px;border-radius:999px;font:inherit;font-size:.88rem;font-weight:650;cursor:pointer}.switch button[aria-checked="true"]{background:var(--ink);color:var(--surface)}.save{font-size:.78rem;font-weight:700;color:var(--green)}button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #72bd91;outline-offset:3px}.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;align-items:stretch;padding:22px 0 76px}.plan{position:relative;background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:29px;box-shadow:var(--shadow);animation:rise .55s both}.plan:nth-child(2){animation-delay:.08s}.plan:nth-child(3){animation-delay:.16s}.plan.featured{border:2px solid var(--green);transform:translateY(-8px);box-shadow:0 25px 65px #176b4b20}.badge{position:absolute;top:-14px;left:50%;transform:translateX(-50%);white-space:nowrap;background:var(--green);color:#fff;border-radius:99px;padding:5px 13px;font-size:.72rem;font-weight:750;letter-spacing:.04em}.plan h2{font-size:1.16rem;margin:0 0 5px;letter-spacing:-.02em}.desc{color:var(--muted);font-size:.89rem;min-height:44px;margin:0}.price{display:flex;align-items:baseline;gap:5px;margin:23px 0 0}.price strong{font-size:3rem;letter-spacing:-.07em;line-height:1}.price span{color:var(--muted);font-size:.87rem}.billing-note{height:22px;color:var(--muted);font-size:.77rem;margin-top:7px}.cta{display:block;text-align:center;text-decoration:none;border:1px solid var(--line);border-radius:10px;padding:11px 14px;margin:13px 0 22px;font-weight:700;font-size:.91rem;transition:transform .2s,background .2s}.cta:hover{transform:translateY(-2px);background:var(--mint)}.featured .cta{background:var(--green);border-color:var(--green);color:white}.featured .cta:hover{background:#10563b}.plan ul{list-style:none;padding:18px 0 0;margin:0;border-top:1px solid var(--line)}.plan li{display:flex;gap:10px;margin:11px 0;font-size:.87rem}.check{color:var(--green);font-weight:800}.section{padding:10px 0 75px}.section-head{text-align:center;margin-bottom:28px}.section-head h2{font-size:2rem;letter-spacing:-.05em;margin:0 0 6px}.section-head p{color:var(--muted);margin:0}.table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:16px;background:var(--surface);box-shadow:var(--shadow)}table{width:100%;border-collapse:collapse;min-width:620px;text-align:center}th,td{padding:15px 20px;border-bottom:1px solid var(--line)}thead th{font-size:.9rem}th:first-child,td:first-child{text-align:left;width:43%}thead th:nth-child(3){color:var(--green)}tbody th{font-size:.88rem;font-weight:560}td{color:var(--green);font-weight:750}td.no{color:#a0aaa4}tbody tr:last-child>*{border-bottom:0}.faq{max-width:760px;margin:0 auto;padding-bottom:92px}.faq .section-head{margin-bottom:22px}.faq details{border-bottom:1px solid var(--line)}.faq summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:19px 3px;font-weight:680}.faq summary::-webkit-details-marker{display:none}.faq summary:after{content:"+";font-size:1.35rem;color:var(--green);transition:transform .2s}.faq details[open] summary:after{content:"−"}.faq details p{color:var(--muted);margin:-3px 35px 19px 3px;font-size:.94rem}.footer{border-top:1px solid var(--line);padding:24px 0;color:var(--muted);font-size:.82rem;display:flex;justify-content:space-between}.footer a{text-decoration:none}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}@media(max-width:760px){.intro{padding:57px 0 24px}.plans{grid-template-columns:1fr;gap:20px;padding-top:28px}.plan{padding:25px}.plan.featured{transform:none;order:-1}.plan .desc{min-height:0}.nav{gap:15px}.section{padding-bottom:55px}}@media(max-width:430px){.wrap{width:min(100% - 28px,1120px)}.nav a:first-child{display:none}.nav{gap:14px}.intro p{font-size:1rem}.billing{gap:8px}.save{font-size:.7rem}.footer{gap:12px;flex-wrap:wrap}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
+@media(prefers-color-scheme:dark){:root{--bg:#101713;--surface:#18211c;--ink:#edf4ef;--muted:#a1afa6;--line:#2b3930;--green:#75d39a;--mint:#20382a;--shadow:0 20px 55px #0003}.mark{background:#287c53}.featured .cta{color:#07160d}.featured .cta:hover{background:#8be0a9}.switch button[aria-checked="true"]{background:#edf4ef;color:#18211c}.plan.featured{box-shadow:0 25px 65px #0005}.check{color:#75d39a}td{color:#75d39a}td.no{color:#647169}}
