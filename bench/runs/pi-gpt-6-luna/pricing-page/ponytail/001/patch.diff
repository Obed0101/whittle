ble+.track{outline:3px solid #76aa8c;outline-offset:3px}.save{color:var(--green);font-size:.78rem;background:var(--soft);padding:4px 9px;border-radius:20px}.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;align-items:stretch;padding-bottom:86px}.card{position:relative;background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:30px;box-shadow:0 5px 24px #183a2507;display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-4px);box-shadow:var(--shadow)}.card.featured{border:2px solid var(--green);box-shadow:var(--shadow);padding:29px}.ribbon{position:absolute;top:-13px;left:50%;transform:translateX(-50%);white-space:nowrap;background:var(--green);color:white;padding:4px 13px;border-radius:30px;font-size:.72rem;font-weight:700;letter-spacing:.04em}.plan-name{font-weight:700;font-size:1.15rem;margin:0}.description{color:var(--muted);font-size:.88rem;min-height:44px;margin:5px 0 21px}.price{display:flex;align-items:baseline;gap:5px;margin-bottom:3px}.amount{font-size:3.15rem;line-height:1;letter-spacing:-.075em;font-weight:750;font-variant-numeric:tabular-nums}.per{color:var(--muted);font-size:.9rem}.billing-note{height:23px;color:var(--muted);font-size:.78rem}.card hr{border:0;border-top:1px solid var(--line);width:100%;margin:20px 0}.list-label{font-size:.78rem;font-weight:700;margin-bottom:12px}.features{padding:0;margin:0 0 25px;list-style:none;color:var(--muted);font-size:.88rem}.features li{display:flex;gap:10px;margin:10px 0}.check{color:var(--green);font-weight:800}.button{display:flex;justify-content:center;align-items:center;min-height:48px;margin-top:auto;background:transparent;border:1px solid var(--line);border-radius:9px;text-decoration:none;font-weight:700;font-size:.9rem;transition:background .15s,border-color .15s}.button:hover{background:var(--soft);border-color:var(--green)}.button.primary{background:var(--green);border-color:var(--green);color:white}.button.primary:hover{background:#10583f}.section{padding:74px 0;border-top:1px solid var(--line)}.section-heading{text-align:center;margin-bottom:37px}.section-heading h2{font-size:clamp(1.8rem,4vw,2.6rem);letter-spacing:-.06em;margin:0 0 8px}.section-heading p{margin:0;color:var(--muted)}.table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:14px;background:var(--paper)}table{width:100%;border-collapse:collapse;text-align:center;min-width:650px}th,td{padding:15px 20px;border-bottom:1px solid var(--line)}thead th{font-size:.9rem}th:first-child,td:first-child{text-align:left;width:40%}tbody th{font-weight:550;color:var(--muted);font-size:.9rem}tbody tr:last-child>*{border-bottom:0}.highlight{background:var(--soft);color:var(--green);font-weight:750}.table-plan{color:var(--muted);font-weight:600}.table-plan.highlight{color:var(--green)}.yes{color:var(--green);font-weight:750}.no{color:#a2aaa4}.faq{max-width:760px;margin:0 auto;padding-bottom:94px}.faq .section-heading{margin-bottom:27px}.faq details{border-bottom:1px solid var(--line)}.faq details:first-of-type{border-top:1px solid var(--line)}.faq summary{cursor:pointer;list-style:none;position:relative;padding:20px 42px 20px 2px;font-weight:650}.faq summary::-webkit-details-marker{display:none}.faq summary:after{content:"+";position:absolute;right:5px;top:15px;font-size:1.5rem;color:var(--green);font-weight:400}.faq details[open] summary:after{content:"−"}.faq details p{margin:-4px 35px 21px 2px;color:var(--muted);font-size:.94rem}.footer{border-top:1px solid var(--line);padding:25px 0;color:var(--muted);font-size:.85rem}.footer .wrap{display:flex;justify-content:space-between;gap:16px}.footer a{color:var(--ink);text-decoration:none}
