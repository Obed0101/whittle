+<script>
+const toggle=document.querySelector('#yearly');const prices=document.querySelectorAll('.amount');const billed=document.querySelectorAll('[data-billed]');function updatePricing(){const annual=toggle.checked;prices.forEach(price=>{const value=annual?price.dataset.yearly:price.dataset.monthly;price.textContent='$'+(Number(value)%1?Number(value).toFixed(2):value)});billed.forEach((label,index)=>{const amount=annual?prices[index+1].dataset.yearly:prices[index+1].dataset.monthly;label.textContent='$'+(Number(amount)%1?Number(amount).toFixed(2):amount)+' per user, billed '+(annual?'yearly':'monthly')})}toggle.addEventListener('change',updatePricing);
