tion{padding:67px 0;border-top:1px solid var(--line)}.section-heading{text-align:center;margin-bottom:34px}.section-heading h2{font-size:clamp(29px,4vw,40px);letter-spacing:-.055em;line-height:1.1;margin:0 0 10px}.section-heading p{margin:0;color:var(--muted)}.table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:14px;background:var(--paper);box-shadow:var(--shadow)}table{border-collapse:collapse;width:100%;min-width:660px;text-align:center;font-size:14px}th,td{padding:15px 18px;border-bottom:1px solid var(--line)}thead th{font-size:13px;background:var(--soft);color:var(--ink)}thead th:first-child{text-align:left;border-radius:13px 0 0 0}thead th:last-child{border-radius:0 13px 0 0}tbody tr:last-child th,tbody tr:last-child td{border-bottom:0}tbody th{text-align:left;font-weight:550;color:var(--muted)}td{font-weight:650}.yes{color:var(--green);font-size:17px}.no{color:#a0aaa3}.faq{max-width:760px;margin:auto}.faq details{border-bottom:1px solid var(--line)}.faq details:first-child{border-top:1px solid var(--line)}.faq summary{padding:20px 35px 20px 2px;cursor:pointer;list-style:none;font-weight:680;position:relative}.faq summary::-webkit-details-marker{display:none}.faq summary:after{content:"+";position:absolute;right:5px;top:17px;color:var(--green);font-size:22px;font-weight:400;transition:transform .2s}.faq details[open] summary:after{transform:rotate(45deg)}.faq details p{color:var(--muted);margin:-5px 30px 21px 2px;font-size:14px}.cta{margin:20px auto 70px;padding:42px 30px;border-radius:18px;background:#183f31;color:#fff;text-align:center}.cta h2{font-size:30px;letter-spacing:-.05em;margin:0 0 8px}.cta p{color:#d1e2d8;margin:0 auto 20px}.cta .btn{display:inline-block;background:#fff;color:#173d30;border-color:#fff;padding:10px 22px}.footer{border-top:1px solid var(--line);padding:24px 0 35px;display:flex;justify-content:space-between;color:var(--muted);font-size:12px}.footer a{margin-left:18px;text-decoration:none}
