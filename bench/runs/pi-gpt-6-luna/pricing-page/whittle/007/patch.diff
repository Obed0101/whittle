+<script>(()=>{const controls=[...document.querySelectorAll('[data-period]')],prices=[...document.querySelectorAll('.amount')],note=document.getElementById('billing-note');function setPeriod(period,focus=false){controls.forEach(button=>{const active=button.dataset.period===period;button.setAttribute('aria-checked',String(active));button.tabIndex=active?0:-1;if(active&&focus)button.focus()});prices.forEach(price=>{const value=price.dataset[period];price.textContent=value==='0'?'0':value});document.querySelectorAll('[data-detail]').forEach(detail=>{detail.textContent=period==='yearly'?'Billed annually':'Billed monthly'});note.textContent=period==='yearly'?'Billed annually. Save 20% with yearly billing.':'Billed monthly. Change or cancel anytime.'}controls.forEach((button,index)=>{button.addEventListener('click',()=>setPeriod(button.dataset.period));button.addEventListener('keydown',event=>{if(['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].includes(event.key)){event.preventDefault();setPeriod(controls[index===0?1:0].dataset.period,true)}})});setPeriod('monthly')})();</script></body></html>
