+<script>
+(() => {
+ const buttons = document.querySelectorAll('[data-billing]');
+ const amounts = document.querySelectorAll('.amount');
+ const notes = document.querySelectorAll('[data-annual-note]');
+ buttons.forEach(button => button.addEventListener('click', () => {
+  const yearly = button.dataset.billing === 'yearly';
+  buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
+  amounts.forEach(amount => {
+   const value = Number(amount.dataset[yearly ? 'yearly' : 'monthly']);
+   amount.textContent = '$' + (Number.isInteger(value) ? value : value.toFixed(2).replace(/0$/, ''));
+  });
+  notes.forEach(note => note.textContent = yearly ? 'Billed annually' : 'Billed monthly');
+ }));
+})();
+</script>
