index 0000000..5ce7c00
--- /dev/null
+++ b/notes/style.css
@@ -0,0 +1,72 @@
+:root{--bg:#fff;--bg2:#f6f6f4;--bg3:#ebebe7;--fg:#1d1d1b;--mut:#6b6b66;--ac:#2f6fed;--acfg:#fff;--bd:#dcdcd6;--dng:#c0392b}
+@media(prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#17181a;--bg2:#1f2124;--bg3:#2a2d31;--fg:#e8e8e4;--mut:#9a9a94;--ac:#6b9cff;--acfg:#101114;--bd:#34373c;--dng:#ff7b6b}}
+:root[data-theme=dark]{--bg:#17181a;--bg2:#1f2124;--bg3:#2a2d31;--fg:#e8e8e4;--mut:#9a9a94;--ac:#6b9cff;--acfg:#101114;--bd:#34373c;--dng:#ff7b6b}
+*{box-sizing:border-box}
+html,body{height:100%;margin:0}
+body{background:var(--bg);color:var(--fg);font:15px/1.5 system-ui,-apple-system,Segoe UI,sans-serif}
+button,.btn,select,input,textarea{font:inherit;color:inherit}
+button,.btn{background:var(--bg2);border:1px solid var(--bd);border-radius:6px;padding:4px 10px;cursor:pointer}
+button:hover,.btn:hover{background:var(--bg3)}
+button.primary{background:var(--ac);color:var(--acfg);border-color:var(--ac)}
+button.danger{color:var(--dng)}
+button.icon{display:none}
+button[aria-pressed=true]{background:var(--ac);color:var(--acfg)}
+:focus-visible{outline:2px solid var(--ac);outline-offset:1px}
+[hidden]{display:none!important}
+.app{display:grid;grid-template-columns:200px 320px 1fr;height:100%}
+#sidebar{background:var(--bg2);border-right:1px solid var(--bd);padding:12px;display:flex;flex-direction:column;overflow:auto}
+#sidebar h1{font-size:18px;margin:0 0 12px}
+#sidebar h2{font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--mut);margin:16px 0 4px}
+#sidebar ul{list-style:none;margin:0;padding:0}
+#sidebar li button{width:100%;text-align:left;border:0;background:none;display:flex;justify-content:space-between;padding:5px 8px}
+#sidebar li button[aria-current=true]{background:var(--bg3);font-weight:600}
+.side-foot{margin-top:auto;padding-top:12px;display:flex;flex-wrap:wrap;gap:6px}
+#listPane{border-right:1px solid var(--bd);display:flex;flex-direction:column;min-height:0}
+.list-head{display:flex;gap:6px;padding:10px}
+#search{flex:1;min-width:0;padding:5px 8px;border:1px solid var(--bd);border-radius:6px;background:var(--bg)}
+.list-tools{display:flex;gap:8px;align-items:center;padding:0 10px 8px;color:var(--mut);font-size:13px;flex-wrap:wrap}
+.list-tools #count{flex:1}
+.list-tools select{background:var(--bg);border:1px solid var(--bd);border-radius:4px}
+#list{list-style:none;margin:0;padding:0;overflow:auto;flex:1}
+#list button{display:block;width:100%;text-align:left;border:0;border-bottom:1px solid var(--bd);border-radius:0;background:none;padding:10px 12px}
+#list button[aria-current=true]{background:var(--bg3)}
+#list .t{font-weight:600;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+#list .s{color:var(--mut);font-size:13px;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+#list .d{color:var(--mut);font-size:12px}
+.empty{color:var(--mut);padding:24px;text-align:center}
+#editorPane{min-width:0;min-height:0;display:flex}
+#editor{display:flex;flex-direction:column;flex:1;min-width:0;padding:12px 20px;gap:8px}
+#noEditor{margin:auto}
+.ed-bar{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
+.ed-bar #meta{color:var(--mut);font-size:13px}
+.spacer{flex:1}
+#trashBar{background:var(--bg3);padding:8px;border-radius:6px}
+#title{font-size:24px;font-weight:700;border:0;background:none;padding:4px 0;outline:none;width:100%}
+.tagrow{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
+.chip{background:var(--bg3);border-radius:12px;padding:1px 4px 1px 10px;font-size:13px}
+.chip button{border:0;background:none;padding:0 6px;color:var(--mut)}
+#tagIn{border:0;background:none;outline:none;min-width:100px}
+#body{flex:1;resize:none;border:0;background:none;outline:none;line-height:1.6;min-height:0}
+#preview{flex:1;overflow:auto}
+#preview pre{background:var(--bg2);padding:10px;border-radius:6px;overflow:auto}
+#preview code{background:var(--bg2);padding:0 4px;border-radius:3px}
+#preview pre code{padding:0}
+#preview blockquote{margin:0;padding-left:12px;border-left:3px solid var(--bd);color:var(--mut)}
+#preview a{color:var(--ac)}
+#preview li.task{list-style:none;margin-left:-20px}
+.ed-foot{color:var(--mut);font-size:12px}
+#banner{background:var(--dng);color:#fff;padding:8px 12px;text-align:center}
+#toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);background:var(--fg);color:var(--bg);padding:8px 14px;border-radius:8px;display:flex;gap:12px;align-items:center;z-index:9}
+#toast button{background:none;border:0;color:var(--ac);font-weight:700}
+dialog{background:var(--bg);color:var(--fg);border:1px solid var(--bd);border-radius:10px;max-width:420px}
+dl{display:grid;grid-template-columns:auto 1fr;gap:4px 16px}dt{font-family:monospace}dd{margin:0}
+@media(max-width:900px){
+  .app{grid-template-columns:1fr}
+  button.icon{display:inline-block}
+  #sidebar{position:fixed;inset:0 25% 0 0;z-index:5;transform:translateX(-100%);transition:transform .2s}
+  body.drawer #sidebar{transform:none;box-shadow:0 0 0 100vmax rgba(0,0,0,.4)}
+  #editorPane{display:none}
+  body[data-pane=editor] #listPane{display:none}
+  body[data-pane=editor] #editorPane{display:flex}
+}
+@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
