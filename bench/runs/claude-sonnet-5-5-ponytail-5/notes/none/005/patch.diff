+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Notes</title>
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<div id="app" data-view="list">
+  <aside id="sidebar" aria-label="Navigation">
+    <div class="brand">Notes</div>
+    <nav id="nav"></nav>
+    <div class="side-title">Tags</div>
+    <div id="tags"></div>
+    <div class="side-foot">
+      <button class="btn ghost" id="btn-theme" title="Change theme"></button>
+      <button class="btn ghost" id="btn-export" title="Export all notes as JSON">Export</button>
+      <button class="btn ghost" id="btn-import" title="Import notes from JSON">Import</button>
+      <button class="btn ghost" id="btn-help" title="Keyboard shortcuts">?</button>
+      <input type="file" id="file-import" accept="application/json,.json" hidden>
+    </div>
+  </aside>
+  <div id="scrim"></div>
+
+  <section id="list-pane" aria-label="Note list">
+    <div class="list-head">
+      <button class="btn icon only-mobile" id="btn-menu" aria-label="Menu">☰</button>
+      <input id="search" type="search" placeholder="Search notes  (⌘/Ctrl+K)" aria-label="Search notes" autocomplete="off">
+      <button class="btn primary" id="btn-new" title="New note (⌘/Ctrl+Alt+N)">+ New</button>
+    </div>
+    <div class="list-sub">
+      <span id="list-title"></span>
+      <select id="sort" aria-label="Sort notes">
+        <option value="updated">Last edited</option>
+        <option value="created">Created</option>
+        <option value="title">Title</option>
+      </select>
+    </div>
+    <div id="list" role="list"></div>
+  </section>
+
+  <main id="editor-pane" aria-label="Editor">
+    <div id="empty" class="empty">
+      <p>No note selected</p>
+      <button class="btn primary" id="btn-new-empty">Create a note</button>
+    </div>
+    <div id="editor" hidden>
+      <div class="ed-bar">
+        <button class="btn icon only-mobile" id="btn-back" aria-label="Back to list">←</button>
+        <div class="toolbar" id="toolbar">
+          <button data-act="h" title="Heading">H</button>
+          <button data-act="b" title="Bold (⌘/Ctrl+B)"><b>B</b></button>
+          <button data-act="i" title="Italic (⌘/Ctrl+I)"><i>I</i></button>
+          <button data-act="s" title="Strikethrough"><s>S</s></button>
+          <button data-act="code" title="Code">&lt;/&gt;</button>
+          <button data-act="ul" title="Bulleted list">•</button>
+          <button data-act="task" title="Checklist">☑</button>
+          <button data-act="quote" title="Quote">❝</button>
+          <button data-act="link" title="Link (⌘/Ctrl+L)">🔗</button>
+        </div>
+        <div class="spacer"></div>
+        <div class="seg" id="mode">
+          <button data-mode="edit">Edit</button>
+          <button data-mode="split" class="hide-narrow">Split</button>
+          <button data-mode="preview">Preview</button>
+        </div>
+        <button class="btn ghost" id="btn-pin" title="Pin / unpin">📌</button>
+        <button class="btn ghost" id="btn-md" title="Download as Markdown">⬇</button>
+        <button class="btn ghost" id="btn-del" title="Move to trash">🗑</button>
+        <button class="btn ghost" id="btn-restore" hidden>Restore</button>
+        <button class="btn ghost danger" id="btn-purge" hidden>Delete forever</button>
+      </div>
+      <input id="title" placeholder="Title" aria-label="Title" autocomplete="off">
+      <div id="tag-box" class="tag-box"></div>
+      <div id="panes">
+        <textarea id="body" placeholder="Start writing… Markdown supported." aria-label="Note body" spellcheck="true"></textarea>
+        <div id="preview" class="md"></div>
+      </div>
+      <div class="ed-foot"><span id="stats"></span><span id="status"></span></div>
+    </div>
+  </main>
+</div>
+
+<div id="toast" role="status" aria-live="polite" hidden></div>
+
+<dialog id="help">
+  <h3>Keyboard shortcuts</h3>
+  <table>
+    <tr><td><kbd>Ctrl/⌘</kbd> + <kbd>Alt</kbd> + <kbd>N</kbd></td><td>New note</td></tr>
+    <tr><td><kbd>Ctrl/⌘</kbd> + <kbd>K</kbd></td><td>Search</td></tr>
+    <tr><td><kbd>Ctrl/⌘</kbd> + <kbd>E</kbd></td><td>Cycle edit / split / preview</td></tr>
+    <tr><td><kbd>Ctrl/⌘</kbd> + <kbd>B</kbd> / <kbd>I</kbd> / <kbd>L</kbd></td><td>Bold / italic / link</td></tr>
+    <tr><td><kbd>Tab</kbd> / <kbd>Shift</kbd>+<kbd>Tab</kbd></td><td>Indent / outdent list item</td></tr>
+    <tr><td><kbd>Enter</kbd></td><td>Continue list or checklist</td></tr>
+    <tr><td><kbd>↑</kbd> <kbd>↓</kbd> in search</td><td>Move between notes</td></tr>
+    <tr><td><kbd>Esc</kbd></td><td>Clear search / close</td></tr>
+  </table>
+  <p class="muted">Search supports <code>#tag</code> terms, e.g. <code>#work budget</code>. Notes are stored in this browser only — use Export for backups.</p>
+  <form method="dialog"><button class="btn primary">Close</button></form>
+</dialog>
+
+<script src="app.js"></script>
+</body>
+</html>
diff --git a/notes/style.css b/notes/style.css
new file mode 100644
index 0000000..7c5a67d
--- /dev/null
+++ b/notes/style.css
@@ -0,0 +1,138 @@
+:root {
+  --bg: #ffffff; --bg2: #f6f6f4; --bg3: #ecebe7; --fg: #1f2328; --muted: #6b7280;
+  --line: #e2e1dc; --accent: #2f6fed; --accent-fg: #fff; --danger: #c93434;
+  --sel: #e5edff; --code: #f1f0ec; color-scheme: light;
+}
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme="light"]) {
+    --bg: #18191b; --bg2: #1f2023; --bg3: #2a2b2f; --fg: #e6e6e6; --muted: #9096a0;
+    --line: #333439; --accent: #6d9bff; --accent-fg: #101114; --danger: #ff7a7a;
+    --sel: #26334f; --code: #2a2b2f; color-scheme: dark;
+  }
+}
+:root[data-theme="dark"] {
+  --bg: #18191b; --bg2: #1f2023; --bg3: #2a2b2f; --fg: #e6e6e6; --muted: #9096a0;
+  --line: #333439; --accent: #6d9bff; --accent-fg: #101114; --danger: #ff7a7a;
+  --sel: #26334f; --code: #2a2b2f; color-scheme: dark;
+}
+* { box-sizing: border-box; }
+html, body { height: 100%; margin: 0; }
+body { font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: var(--bg); color: var(--fg); }
+button, input, select, textarea { font: inherit; color: inherit; }
+[hidden] { display: none !important; }
+.muted { color: var(--muted); }
+
+#app { display: grid; grid-template-columns: 210px 320px 1fr; height: 100%; }
+
+.btn { border: 1px solid var(--line); background: var(--bg); border-radius: 6px; padding: 5px 10px; cursor: pointer; }
+.btn:hover { background: var(--bg3); }
+.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-fg); font-weight: 600; }
+.btn.primary:hover { filter: brightness(1.08); }
+.btn.ghost { border-color: transparent; background: transparent; }
+.btn.ghost:hover { background: var(--bg3); }
+.btn.danger { color: var(--danger); }
+.btn.icon { padding: 4px 9px; }
+button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, .note:focus-visible {
+  outline: 2px solid var(--accent); outline-offset: -2px;
+}
+
+/* sidebar */
+#sidebar { background: var(--bg2); border-right: 1px solid var(--line); display: flex; flex-direction: column; padding: 14px 10px; overflow-y: auto; }
+.brand { font-weight: 700; font-size: 18px; padding: 0 8px 12px; }
+.nav-item { display: flex; justify-content: space-between; align-items: center; width: 100%; text-align: left; border: 0; background: none; padding: 6px 8px; border-radius: 6px; cursor: pointer; }
+.nav-item:hover { background: var(--bg3); }
+.nav-item.active { background: var(--sel); font-weight: 600; }
+.nav-item .count { color: var(--muted); font-size: 12px; }
+.side-title { margin: 16px 8px 4px; font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
+#tags { flex: 1; }
+.side-foot { display: flex; flex-wrap: wrap; gap: 2px; border-top: 1px solid var(--line); padding-top: 8px; margin-top: 8px; }
+.side-foot .btn { font-size: 13px; padding: 4px 7px; }
+
+/* list */
+#list-pane { border-right: 1px solid var(--line); display: flex; flex-direction: column; min-width: 0; min-height: 0; }
+.list-head { display: flex; gap: 6px; padding: 10px; }
+#search { flex: 1; min-width: 0; padding: 6px 10px; border: 1px solid var(--line); border-radius: 6px; background: var(--bg); }
+.list-sub { display: flex; justify-content: space-between; align-items: center; padding: 0 12px 6px; font-size: 12px; color: var(--muted); }
+.list-sub select { border: 0; background: none; color: var(--muted); cursor: pointer; }
+#list { overflow-y: auto; flex: 1; border-top: 1px solid var(--line); }
+.note { padding: 10px 12px; border-bottom: 1px solid var(--line); cursor: pointer; }
+.note:hover { background: var(--bg2); }
+.note.active { background: var(--sel); }
+.note .t { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.note .m { display: flex; gap: 8px; font-size: 12px; color: var(--muted); }
+.note .snip { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
+.note .d { flex: none; }
+.note .tg { margin-top: 3px; display: flex; flex-wrap: wrap; gap: 4px; }
+.chip { font-size: 11px; background: var(--bg3); border-radius: 10px; padding: 0 7px; color: var(--muted); }
+.no-notes { padding: 30px 16px; text-align: center; color: var(--muted); }
+
+/* editor */
+#editor-pane { min-width: 0; min-height: 0; display: flex; flex-direction: column; }
+.empty { margin: auto; text-align: center; color: var(--muted); }
+#editor { display: flex; flex-direction: column; height: 100%; min-height: 0; }
+.ed-bar { display: flex; align-items: center; gap: 4px; padding: 6px 10px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
+.spacer { flex: 1; }
+.toolbar { display: flex; gap: 2px; }
+.toolbar button { border: 0; background: none; min-width: 30px; height: 30px; border-radius: 6px; cursor: pointer; }
+.toolbar button:hover { background: var(--bg3); }
+.seg { display: flex; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
+.seg button { border: 0; background: none; padding: 4px 10px; cursor: pointer; font-size: 13px; }
+.seg button.on { background: var(--accent); color: var(--accent-fg); }
+#title { border: 0; background: none; font-size: 24px; font-weight: 700; padding: 14px 20px 4px; outline-offset: -2px; }
+.tag-box { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; padding: 2px 20px 8px; }
+.tag-box .chip { cursor: pointer; font-size: 12px; padding: 1px 8px; }
+.tag-box .chip:hover { text-decoration: line-through; }
+.tag-box input { border: 0; background: none; min-width: 110px; padding: 2px 0; font-size: 13px; }
+#panes { flex: 1; display: grid; grid-template-columns: 1fr; min-height: 0; border-top: 1px solid var(--line); }
+#panes[data-mode="split"] { grid-template-columns: 1fr 1fr; }
+#panes[data-mode="edit"] #preview, #panes[data-mode="preview"] #body { display: none; }
+#body { border: 0; resize: none; background: none; padding: 16px 20px; min-height: 0; font: 14.5px/1.6 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
+#panes[data-mode="split"] #body { border-right: 1px solid var(--line); }
+#preview { overflow-y: auto; padding: 16px 20px; min-height: 0; }
+.ed-foot { display: flex; justify-content: space-between; padding: 4px 20px; font-size: 12px; color: var(--muted); border-top: 1px solid var(--line); }
+
+/* markdown */
+.md > :first-child { margin-top: 0; }
+.md h1, .md h2, .md h3, .md h4 { line-height: 1.25; margin: 1.2em 0 .4em; }
+.md h1 { font-size: 1.7em; } .md h2 { font-size: 1.4em; } .md h3 { font-size: 1.15em; }
+.md p, .md ul, .md ol, .md pre, .md blockquote { margin: .6em 0; }
+.md ul, .md ol { padding-left: 1.6em; }
+.md li.task { list-style: none; margin-left: -1.3em; }
+.md li.task input { margin-right: 6px; cursor: pointer; }
+.md li.done { color: var(--muted); text-decoration: line-through; }
+.md code { background: var(--code); padding: 1px 5px; border-radius: 4px; font-size: .9em; }
+.md pre { background: var(--code); padding: 10px 12px; border-radius: 6px; overflow-x: auto; }
+.md pre code { padding: 0; background: none; }
+.md blockquote { border-left: 3px solid var(--line); margin-left: 0; padding-left: 12px; color: var(--muted); }
+.md a { color: var(--accent); }
+.md hr { border: 0; border-top: 1px solid var(--line); }
+.md img { max-width: 100%; }
+
+/* misc */
+#toast { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); background: var(--fg); color: var(--bg); padding: 8px 14px; border-radius: 8px; display: flex; gap: 12px; align-items: center; z-index: 20; box-shadow: 0 4px 16px rgba(0,0,0,.25); }
+#toast button { background: none; border: 0; color: var(--accent); font-weight: 700; cursor: pointer; filter: brightness(1.3); }
+dialog { border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--fg); max-width: 480px; }
+dialog::backdrop { background: rgba(0,0,0,.4); }
+dialog table { border-collapse: collapse; width: 100%; }
+dialog td { padding: 4px 8px 4px 0; }
+kbd { background: var(--bg3); border: 1px solid var(--line); border-radius: 4px; padding: 0 5px; font-size: 12px; }
+.only-mobile { display: none; }
+#scrim { display: none; }
+
+@media (max-width: 860px) {
+  #app { grid-template-columns: 1fr; }
+  .only-mobile { display: inline-block; }
+  .hide-narrow { display: none; }
+  #sidebar { position: fixed; z-index: 10; top: 0; bottom: 0; left: 0; width: 240px; transform: translateX(-100%); transition: transform .18s; }
+  #app.menu #sidebar { transform: none; }
+  #app.menu #scrim { display: block; position: fixed; inset: 0; background: rgba(0,0,0,.35); z-index: 9; }
+  #app[data-view="list"] #editor-pane { display: none; }
+  #app[data-view="editor"] #list-pane { display: none; }
+  #title { font-size: 20px; padding-left: 14px; }
+  .tag-box, .ed-foot { padding-left: 14px; padding-right: 14px; }
+  .toolbar { order: 5; width: 100%; overflow-x: auto; }
+}
+@media print {
+  #sidebar, #list-pane, .ed-bar, #tag-box, .ed-foot, #body { display: none !important; }
+  #app { display: block; } #preview { display: block !important; overflow: visible; }
+}
