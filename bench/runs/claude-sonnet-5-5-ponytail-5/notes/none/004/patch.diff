+function words(s) { var m = s.trim().match(/\S+/g); return m ? m.length : 0; }
+function fmtDate(t) {
+  var d = new Date(t), now = new Date();
+  if (d.toDateString() === now.toDateString()) return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
+  var o = { month: 'short', day: 'numeric' };
+  if (d.getFullYear() !== now.getFullYear()) o.year = 'numeric';
+  return d.toLocaleDateString([], o);
+}
+var toastTimer;
+function toast(msg, actionLabel, action) {
+  var t = $('toast');
+  t.innerHTML = '';
+  var s = document.createElement('span'); s.textContent = msg; t.appendChild(s);
+  if (actionLabel) {
+    var b = document.createElement('button'); b.textContent = actionLabel;
+    b.onclick = function () { t.hidden = true; action(); };
+    t.appendChild(b);
+  }
+  t.hidden = false;
+  clearTimeout(toastTimer);
+  toastTimer = setTimeout(function () { t.hidden = true; }, actionLabel ? 6000 : 3500);
+}
+function normTag(s) { return s.trim().replace(/^#+/, '').replace(/\s+/g, '-').toLowerCase().slice(0, 30); }
+
+/* ---------- markdown ---------- */
+function inline(src) {
+  var codes = [];
+  var s = src.replace(/`([^`]+)`/g, function (_, c) { codes.push(c); return '\u0000' + (codes.length - 1) + '\u0000'; });
+  s = esc(s);
+  s = s.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, function (m, t, u) {
+    u = u.replace(/&amp;/g, '&');
+    if (!/^(https?:|mailto:|#|\/|\.)/i.test(u)) return m;
+    return '<a href="' + esc(u) + '" target="_blank" rel="noopener noreferrer">' + t + '</a>';
+  });
+  s = s.replace(/(^|[\s(])(https?:\/\/[^\s<)]+)/g, '$1<a href="$2" target="_blank" rel="noopener noreferrer">$2</a>');
+  s = s.replace(/\*\*([^*]+)\*\*|__([^_]+)__/g, function (_, a, b) { return '<strong>' + (a || b) + '</strong>'; });
+  s = s.replace(/(^|[^*\w])\*([^*\s][^*]*)\*(?!\*)/g, '$1<em>$2</em>');
+  s = s.replace(/(^|[^_\w])_([^_\s][^_]*)_(?![_\w])/g, '$1<em>$2</em>');
+  s = s.replace(/~~([^~]+)~~/g, '<del>$1</del>');
+  s = s.replace(/\u0000(\d+)\u0000/g, function (_, i) { return '<code>' + esc(codes[+i]) + '</code>'; });
+  return s;
+}
+function renderMarkdown(src) {
+  var lines = src.replace(/\r\n?/g, '\n').split('\n');
+  var out = [], i = 0;
+  function isBlockStart(l) {
+    return /^(#{1,6})\s/.test(l) || /^```/.test(l) || /^\s*([-*+]|\d+\.)\s/.test(l) || /^>\s?/.test(l) || /^(-{3,}|\*{3,}|_{3,})\s*$/.test(l);
+  }
+  while (i < lines.length) {
+    var l = lines[i], m;
+    if (/^```/.test(l)) {
+      var buf = []; i++;
+      while (i < lines.length && !/^```/.test(lines[i])) buf.push(lines[i++]);
+      i++;
+      out.push('<pre><code>' + esc(buf.join('\n')) + '</code></pre>');
+    } else if ((m = /^(#{1,6})\s+(.*)$/.exec(l))) {
+      out.push('<h' + m[1].length + '>' + inline(m[2]) + '</h' + m[1].length + '>'); i++;
+    } else if (/^(-{3,}|\*{3,}|_{3,})\s*$/.test(l)) {
+      out.push('<hr>'); i++;
+    } else if (/^>\s?/.test(l)) {
+      var q = [];
+      while (i < lines.length && /^>\s?/.test(lines[i])) q.push(lines[i++].replace(/^>\s?/, ''));
+      out.push('<blockquote>' + renderMarkdown(q.join('\n')) + '</blockquote>');
+    } else if (/^\s*\|.*\|\s*$/.test(l) && i + 1 < lines.length && /^\s*\|?\s*:?-+:?\s*(\|\s*:?-+:?\s*)*\|?\s*$/.test(lines[i + 1])) {
+      var cells = function (r) { return r.trim().replace(/^\||\|$/g, '').split('|').map(function (c) { return c.trim(); }); };
+      var h = cells(l), t = '<table><thead><tr>' + h.map(function (c) { return '<th>' + inline(c) + '</th>'; }).join('') + '</tr></thead><tbody>';
+      i += 2;
+      while (i < lines.length && /^\s*\|.*\|\s*$/.test(lines[i])) {
+        t += '<tr>' + cells(lines[i++]).map(function (c) { return '<td>' + inline(c) + '</td>'; }).join('') + '</tr>';
+      }
+      out.push(t + '</tbody></table>');
+    } else if (/^\s*([-*+]|\d+\.)\s/.test(l)) {
+      var ordered = /^\s*\d+\./.test(l), items = '', hasTask = false;
+      while (i < lines.length && /^\s*([-*+]|\d+\.)\s/.test(lines[i])) {
+        var im = /^(\s*)(?:[-*+]|\d+\.)\s+(.*)$/.exec(lines[i]);
+        var depth = Math.min(4, Math.floor(im[1].replace(/\t/g, '  ').length / 2));
+        var tm = /^\[( |x|X)\]\s+(.*)$/.exec(im[2]);
+        var st = depth ? ' style="margin-left:' + depth * 1.4 + 'em"' : '';
+        if (tm) {
+          hasTask = true;
+          var done = tm[1] !== ' ';
+          items += '<li class="task' + (done ? ' done' : '') + '"' + st + '><input type="checkbox" data-line="' + i + '"' + (done ? ' checked' : '') + '>' + inline(tm[2]) + '</li>';
+        } else items += '<li' + st + '>' + inline(im[2]) + '</li>';
+        i++;
+      }
+      var tag = ordered ? 'ol' : 'ul';
+      out.push('<' + tag + (hasTask ? ' class="tasks"' : '') + '>' + items + '</' + tag + '>');
+    } else if (!l.trim()) {
+      i++;
+    } else {
+      var p = [];
+      while (i < lines.length && lines[i].trim() && !isBlockStart(lines[i])) p.push(lines[i++]);
+      if (!p.length) { p.push(lines[i++]); }
+      out.push('<p>' + p.map(inline).join('<br>') + '</p>');
+    }
+  }
+  return out.join('\n');
+}
+
+/* ---------- filtering ---------- */
+function matches(n) {
+  var v = settings.view;
+  if (v === 'trash') { if (!n.trashed) return false; }
+  else {
+    if (n.trashed) return false;
+    if (v === 'archive') { if (!n.archived) return false; }
+    else {
+      if (n.archived && !query) return false;
+      if (v === 'pinned' && !n.pinned) return false;
+      if (v.indexOf('tag:') === 0 && n.tags.indexOf(v.slice(4)) < 0) return false;
+    }
+  }
+  if (query) {
+    var hay = (n.title + '\n' + n.body + '\n' + n.tags.join(' ')).toLowerCase();
+    var terms = query.toLowerCase().split(/\s+/).filter(Boolean);
+    for (var i = 0; i < terms.length; i++) {
+      var t = terms[i];
+      if (t.charAt(0) === '#' && t.length > 1) { if (n.tags.indexOf(t.slice(1)) < 0) return false; }
+      else if (hay.indexOf(t) < 0) return false;
+    }
+  }
+  return true;
+}
+function sorted(list) {
+  var s = settings.sort;
+  return list.slice().sort(function (a, b) {
+    if (a.pinned !== b.pinned && settings.view !== 'trash') return a.pinned ? -1 : 1;
+    if (s === 'title') return noteTitle(a).localeCompare(noteTitle(b));
+    return b[s] - a[s];
+  });
+}
+
+/* ---------- rendering ---------- */
+function highlight(text) {
+  var h = esc(text);
+  if (!query) return h;
+  query.split(/\s+/).filter(function (t) { return t && t.charAt(0) !== '#'; }).forEach(function (t) {
+    var re = new RegExp('(' + esc(t).replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
+    h = h.replace(re, function (m, g, off, str) {
+      // do not break entities / tags
+      var before = str.lastIndexOf('&', off), semi = str.lastIndexOf(';', off);
+      return before > semi ? m : '<mark>' + g + '</mark>';
+    });
+  });
+  return h;
+}
+function snippet(n) {
+  var b = n.body.replace(/[#>*`\-\[\]]/g, ' ').replace(/\s+/g, ' ').trim();
+  if (query) {
+    var t = query.split(/\s+/).filter(function (x) { return x && x.charAt(0) !== '#'; })[0];
+    if (t) {
+      var idx = b.toLowerCase().indexOf(t.toLowerCase());
+      if (idx > 40) b = '…' + b.slice(idx - 30);
+    }
+  }
+  return b.slice(0, 160);
+}
+function renderViews() {
+  var live = notes.filter(function (n) { return !n.trashed; });
+  var counts = {
+    all: live.filter(function (n) { return !n.archived; }).length,
+    pinned: live.filter(function (n) { return n.pinned && !n.archived; }).length,
+    archive: live.filter(function (n) { return n.archived; }).length,
+    trash: notes.length - live.length
