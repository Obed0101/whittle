+}
+function touch(n) { n.updated = Date.now(); scheduleSave(); }
+function trash(n) {
+  n.trashed = true; n.trashedAt = Date.now(); n.pinned = false;
+  persist();
+  if (settings.selected === n.id) { var nx = sorted(notes.filter(matches))[0]; settings.selected = nx ? nx.id : null; }
+  renderAll(); renderEditor();
