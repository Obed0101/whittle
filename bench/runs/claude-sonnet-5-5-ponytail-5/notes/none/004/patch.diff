+  if (settings.selected === n.id) settings.selected = null;
+  persist(); renderAll(); renderEditor();
+  $('app').classList.remove('show-editor');
+}
+function download(name, text, type) {
+  var a = document.createElement('a');
+  a.href = URL.createObjectURL(new Blob([text], { type: type }));
+  a.download = name; document.body.appendChild(a); a.click();
+  setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 500);
+}
+function importFiles(files) {
+  var added = 0, pending = files.length;
+  function done() {
+    if (--pending) return;
+    persist(); renderAll();
+    toast('Imported ' + added + ' note' + (added === 1 ? '' : 's'));
+  }
+  Array.prototype.forEach.call(files, function (f) {
+    var r = new FileReader();
+    r.onload = function () {
+      try {
+        if (/\.json$/i.test(f.name)) {
+          var data = JSON.parse(r.result);
+          var arr = Array.isArray(data) ? data : data.notes;
+          arr.forEach(function (x) {
