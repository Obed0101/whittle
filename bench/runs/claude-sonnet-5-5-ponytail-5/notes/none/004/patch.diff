+    r.readAsText(f);
+  });
+}
+
+/* ---------- editor formatting ---------- */
+function wrapSel(before, after, ph) {
+  var ta = $('body'), s = ta.selectionStart, e = ta.selectionEnd;
+  var sel = ta.value.slice(s, e) || ph;
+  ta.setRangeText(before + sel + after, s, e, 'end');
+  ta.setSelectionRange(s + before.length, s + before.length + sel.length);
+  ta.focus(); onBodyInput();
+}
+function prefixLines(prefix) {
+  var ta = $('body'), v = ta.value;
+  var s = v.lastIndexOf('\n', ta.selectionStart - 1) + 1;
+  var e = v.indexOf('\n', ta.selectionEnd); if (e < 0) e = v.length;
+  var block = v.slice(s, e).split('\n').map(function (l) { return prefix + l; }).join('\n');
+  ta.setRangeText(block, s, e, 'select');
+  ta.focus(); onBodyInput();
+}
+function format(f) {
+  if (current() && current().trashed) return;
+  switch (f) {
+    case 'bold': wrapSel('**', '**', 'bold'); break;
+    case 'italic': wrapSel('*', '*', 'italic'); break;
+    case 'strike': wrapSel('~~', '~~', 'text'); break;
+    case 'code': wrapSel('`', '`', 'code'); break;
+    case 'h': prefixLines('## '); break;
+    case 'ul': prefixLines('- '); break;
+    case 'task': prefixLines('- [ ] '); break;
+    case 'quote': prefixLines('> '); break;
+    case 'link':
+      var ta = $('body'), sel = ta.value.slice(ta.selectionStart, ta.selectionEnd);
+      if (/^https?:\/\//.test(sel)) wrapSel('[link](', ')', sel); else wrapSel('[', '](https://)', 'text');
+  }
+}
+
+/* ---------- events ---------- */
