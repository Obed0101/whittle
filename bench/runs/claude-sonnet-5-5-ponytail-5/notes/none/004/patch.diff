+  var defs = [['all', 'All notes'], ['pinned', 'Pinned'], ['archive', 'Archive'], ['trash', 'Trash']];
+  $('views').innerHTML = defs.map(function (d) {
+    return '<button data-view="' + d[0] + '" class="' + (settings.view === d[0] ? 'active' : '') + '"><span>' + d[1] + '</span><span class="n">' + counts[d[0]] + '</span></button>';
+  }).join('');
+  var tc = {};
+  live.forEach(function (n) { n.tags.forEach(function (t) { tc[t] = (tc[t] || 0) + 1; }); });
+  var names = Object.keys(tc).sort();
+  $('tagList').innerHTML = names.length ? names.map(function (t) {
+    return '<button data-view="tag:' + esc(t) + '" class="' + (settings.view === 'tag:' + t ? 'active' : '') + '"><span>#' + esc(t) + '</span><span class="n">' + tc[t] + '</span></button>';
+  }).join('') : '<div class="list-empty" style="padding:8px 9px;text-align:left">No tags yet</div>';
+  $('tagSuggest').innerHTML = names.map(function (t) { return '<option value="' + esc(t) + '">'; }).join('');
+}
+function viewTitle() {
+  var v = settings.view;
+  if (query) return 'Search';
+  return { all: 'All notes', pinned: 'Pinned', archive: 'Archive', trash: 'Trash' }[v] || '#' + v.slice(4);
+}
+function renderList() {
+  var list = sorted(notes.filter(matches));
+  $('listTitle').textContent = viewTitle();
+  $('listCount').textContent = list.length + (list.length === 1 ? ' note' : ' notes');
+  $('emptyTrash').hidden = !(settings.view === 'trash' && list.length);
+  if (!list.length) {
+    var msg = query ? 'No notes match your search.' : settings.view === 'trash' ? 'Trash is empty.' : settings.view === 'all' ? 'No notes yet. Create your first one!' : 'Nothing here.';
+    $('noteList').innerHTML = '<li class="list-empty" style="cursor:default">' + msg + '</li>';
+    return;
+  }
+  $('noteList').innerHTML = list.map(function (n) {
+    return '<li data-id="' + n.id + '" class="' + (n.id === settings.selected ? 'active' : '') + '">' +
+      '<div class="t">' + (n.pinned ? '📌 ' : '') + highlight(noteTitle(n)) + '</div>' +
+      '<div class="s">' + highlight(snippet(n)) + '</div>' +
+      '<div class="m"><span>' + fmtDate(n.updated) + '</span>' +
+      n.tags.slice(0, 3).map(function (t) { return '<span class="tg">#' + esc(t) + '</span>'; }).join('') + '</div></li>';
+  }).join('');
+}
+function renderPreview() {
+  var n = current();
+  if (!n) return;
+  $('preview').innerHTML = n.body.trim() ? renderMarkdown(n.body) : '<p style="color:var(--muted)">Nothing to preview yet.</p>';
+}
+function renderStats() {
+  var n = current();
+  if (!n) return;
+  $('stats').textContent = words(n.body) + ' words · ' + n.body.length + ' chars · edited ' + new Date(n.updated).toLocaleString();
+}
+function renderChips() {
+  var n = current();
+  $('chips').innerHTML = n.tags.map(function (t) {
+    return '<span class="chip">#' + esc(t) + '<button data-rm="' + esc(t) + '" title="Remove tag">×</button></span>';
+  }).join('');
+  $('tagInput').disabled = n.trashed;
+}
+function renderEditor(focus) {
+  var n = current();
+  $('emptyState').hidden = !!n;
+  $('editor').hidden = !n;
+  $('app').classList.toggle('show-editor', !!n && $('app').classList.contains('show-editor'));
+  if (!n) return;
+  $('title').value = n.title;
+  $('body').value = n.body;
+  $('title').readOnly = $('body').readOnly = n.trashed;
+  $('pinBtn').classList.toggle('on', n.pinned);
+  $('archiveBtn').classList.toggle('on', n.archived);
+  $('archiveBtn').title = n.archived ? 'Unarchive' : 'Archive';
+  $('pinBtn').hidden = $('archiveBtn').hidden = $('trashBtn').hidden = n.trashed;
+  $('restoreBtn').hidden = $('purgeBtn').hidden = !n.trashed;
+  renderChips(); renderPreview(); renderStats();
+  if (focus && !n.trashed) (n.title || n.body ? $('body') : $('title')).focus();
+}
+function renderMode() {
+  var m = settings.mode;
+  $('panes').className = 'panes m-' + m;
+  Array.prototype.forEach.call($('modeSeg').children, function (b) { b.classList.toggle('on', b.dataset.mode === m); });
+  $('toolbar').hidden = m === 'preview';
+}
+function applyTheme() {
+  var r = document.documentElement;
+  if (settings.theme === 'auto') r.removeAttribute('data-theme'); else r.setAttribute('data-theme', settings.theme);
+  $('themeBtn').textContent = 'Theme: ' + settings.theme;
+}
+function renderAll() { renderViews(); renderList(); }
+
+/* ---------- actions ---------- */
+function select(id, focus) {
+  settings.selected = id;
+  renderList(); renderEditor(focus);
+  if (id) $('app').classList.add('show-editor');
+  $('app').classList.remove('show-sidebar');
+  try { localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings)); } catch (e) {}
+}
+function newNote(body) {
+  var now = Date.now();
+  var n = { id: uid(), title: '', body: body || '', tags: [], pinned: false, archived: false, trashed: false, created: now, updated: now, trashedAt: null };
