+  };
+  $('title').oninput = function () {
+    var n = current(); if (!n || n.trashed) return;
+    n.title = this.value; touch(n); renderList();
+  };
+  $('title').onkeydown = function (e) { if (e.key === 'Enter') { e.preventDefault(); $('body').focus(); } };
+  $('body').oninput = onBodyInput;
+  $('body').onkeydown = function (e) {
+    var ta = this, v = ta.value, s = ta.selectionStart;
+    if (e.key === 'Tab' && !e.shiftKey && !e.ctrlKey && !e.metaKey) {
+      e.preventDefault(); document.execCommand('insertText', false, '  ');
+      if (ta.value === v) { ta.setRangeText('  ', s, ta.selectionEnd, 'end'); onBodyInput(); }
+    } else if (e.key === 'Enter' && !e.shiftKey && s === ta.selectionEnd) {
+      var ls = v.lastIndexOf('\n', s - 1) + 1, line = v.slice(ls, s);
+      var m = /^(\s*)([-*+]|\d+\.)(\s+)(\[[ xX]\]\s+)?/.exec(line);
+      if (m) {
+        e.preventDefault();
+        if (line.length === m[0].length) { ta.setRangeText('', ls, s, 'end'); }
+        else {
+          var mk = /\d/.test(m[2]) ? (parseInt(m[2], 10) + 1) + '.' : m[2];
+          ta.setRangeText('\n' + m[1] + mk + m[3] + (m[4] ? '[ ] ' : ''), s, s, 'end');
+        }
+        onBodyInput();
+      }
+    }
+  };
+  $('toolbar').onclick = function (e) { var b = e.target.closest('[data-fmt]'); if (b) format(b.dataset.fmt); };
+  $('preview').onchange = function (e) {
+    var cb = e.target; if (cb.type !== 'checkbox') return;
+    var n = current(); if (!n || n.trashed) { cb.checked = !cb.checked; return; }
+    var lines = n.body.split('\n'), i = +cb.dataset.line;
+    lines[i] = lines[i].replace(/\[( |x|X)\]/, cb.checked ? '[x]' : '[ ]');
+    n.body = lines.join('\n'); $('body').value = n.body;
+    touch(n); renderPreview(); renderList();
+  };
+  $('modeSeg').onclick = function (e) {
+    var b = e.target.closest('[data-mode]'); if (!b) return;
+    settings.mode = b.dataset.mode; renderMode(); persist();
+  };
+  $('pinBtn').onclick = function () { var n = current(); n.pinned = !n.pinned; persist(); renderAll(); renderEditor(); };
+  $('archiveBtn').onclick = function () {
+    var n = current(); n.archived = !n.archived; n.pinned = n.archived ? false : n.pinned; persist();
+    if (n.archived && settings.view !== 'archive' && !query) { settings.selected = null; $('app').classList.remove('show-editor'); }
+    renderAll(); renderEditor();
+    toast(n.archived ? 'Archived' : 'Unarchived');
+  };
+  $('trashBtn').onclick = function () { trash(current()); };
+  $('restoreBtn').onclick = function () { restore(current()); };
+  $('purgeBtn').onclick = function () {
+    if (confirm('Delete this note forever? This cannot be undone.')) purge(current());
+  };
+  $('emptyTrash').onclick = function () {
+    var c = notes.filter(function (n) { return n.trashed; }).length;
+    if (c && confirm('Permanently delete ' + c + ' note(s) in trash?')) {
+      notes = notes.filter(function (n) { return !n.trashed; });
+      settings.selected = null; persist(); renderAll(); renderEditor();
+    }
+  };
+  $('tagInput').onkeydown = function (e) {
+    var n = current();
+    if ((e.key === 'Enter' || e.key === ',') && n) {
+      e.preventDefault();
+      var t = normTag(this.value);
+      if (t && n.tags.indexOf(t) < 0) { n.tags.push(t); touch(n); renderChips(); renderAll(); }
+      this.value = '';
+    } else if (e.key === 'Backspace' && !this.value && n && n.tags.length) {
+      n.tags.pop(); touch(n); renderChips(); renderAll();
+    }
+  };
+  $('tagInput').onchange = function () {
+    var n = current(), t = normTag(this.value);
+    if (n && t && n.tags.indexOf(t) < 0) { n.tags.push(t); touch(n); renderChips(); renderAll(); }
+    this.value = '';
+  };
+  $('chips').onclick = function (e) {
+    var b = e.target.closest('[data-rm]'), n = current(); if (!b || !n || n.trashed) return;
+    n.tags = n.tags.filter(function (t) { return t !== b.dataset.rm; });
+    touch(n); renderChips(); renderAll();
+  };
+  /* mobile */
+  $('toSidebar').onclick = function () { $('app').classList.add('show-sidebar'); };
+  $('backBtn').onclick = function () { $('app').classList.remove('show-editor'); };
+  $('listPane').addEventListener('click', function () { $('app').classList.remove('show-sidebar'); });
+  /* menu */
+  $('menuBtn').onclick = function (e) { e.stopPropagation(); $('menu').hidden = !$('menu').hidden; };
+  document.addEventListener('click', function (e) { if (!$('menu').contains(e.target)) $('menu').hidden = true; });
+  $('exportJson').onclick = function () {
+    download('notes-' + new Date().toISOString().slice(0, 10) + '.json', JSON.stringify({ version: 1, notes: notes }, null, 2), 'application/json');
+    $('menu').hidden = true;
+  };
+  $('exportMd').onclick = function () {
+    var n = current(); $('menu').hidden = true;
+    if (!n) return toast('Select a note first');
+    var head = n.tags.length ? n.tags.map(function (t) { return '#' + t; }).join(' ') + '\n\n' : '';
+    download(noteTitle(n).replace(/[\\/:*?"<>|]+/g, '_') + '.md', head + n.body, 'text/markdown');
+  };
+  $('importBtn').onclick = function () { $('importFile').click(); $('menu').hidden = true; };
+  $('importFile').onchange = function () { if (this.files.length) importFiles(this.files); this.value = ''; };
+  $('themeBtn').onclick = function () {
+    var order = ['auto', 'light', 'dark'];
+    settings.theme = order[(order.indexOf(settings.theme) + 1) % 3];
+    applyTheme(); persist();
+  };
+  /* keyboard */
+  document.addEventListener('keydown', function (e) {
+    var mod = e.ctrlKey || e.metaKey;
+    if (!mod) return;
+    var inBody = document.activeElement === $('body');
+    if (e.code === 'KeyK' && !e.shiftKey) { e.preventDefault(); $('search').focus(); $('search').select(); }
+    else if (e.code === 'KeyN' && e.altKey) { e.preventDefault(); newNote(); }
+    else if (e.code === 'KeyS') { e.preventDefault(); persist(); toast('Saved'); }
+    else if (e.code === 'Slash') {
+      e.preventDefault();
+      var o = ['edit', 'split', 'preview'];
+      settings.mode = o[(o.indexOf(settings.mode) + 1) % 3]; renderMode(); persist();
+    }
+    else if (inBody && e.code === 'KeyB') { e.preventDefault(); format('bold'); }
+    else if (inBody && e.code === 'KeyI') { e.preventDefault(); format('italic'); }
+    else if (inBody && e.code === 'KeyK' && e.shiftKey) { e.preventDefault(); format('link'); }
+  });
+  /* cross-tab sync */
+  window.addEventListener('storage', function (e) {
+    if (e.key !== KEY) return;
+    try { notes = JSON.parse(e.newValue) || []; } catch (x) { return; }
+    if (settings.selected && !byId(settings.selected)) settings.selected = null;
+    renderAll();
+    var n = current();
+    if (n && document.activeElement !== $('body') && document.activeElement !== $('title')) renderEditor();
+  });
+  window.addEventListener('beforeunload', function () { if (saveTimer) persist(); });
+  document.addEventListener('visibilitychange', function () { if (document.hidden && saveTimer) persist(); });
+}
+
+/* ---------- init ---------- */
+function init() {
+  load();
+  var now = Date.now(), cutoff = now - TRASH_DAYS * 864e5;
+  notes = notes.filter(function (n) { return !(n.trashed && n.trashedAt && n.trashedAt < cutoff); });
+  notes.forEach(function (n) {
+    n.title = n.title || ''; n.body = n.body || ''; n.tags = n.tags || [];
+    n.created = n.created || now; n.updated = n.updated || n.created;
+  });
+  if (!notes.length && !localStorage.getItem(KEY)) {
+    notes.push({
+      id: uid(), title: 'Welcome to Notes', pinned: true, archived: false, trashed: false, trashedAt: null,
+      created: now, updated: now, tags: ['welcome'],
+      body: '# Welcome\n\nYour notes are saved automatically in this browser.\n\n## Tips\n\n- [x] Write in **Markdown**: `#` headings, *italic*, **bold**, `code`, [links](https://example.com)\n- [ ] Click a checkbox in the preview to tick it\n- [ ] Add tags above, then filter by them in the sidebar\n- [ ] Search with words or `#tag`\n\n> Ctrl/Cmd+K search · Ctrl/Cmd+Alt+N new note · Ctrl/Cmd+/ switch edit/preview\n\nUse the ⚙ menu to export a JSON backup — do this regularly, since browser data can be cleared.'
+    });
+  }
+  if (!byId(settings.selected)) settings.selected = null;
+  if (['all', 'pinned', 'archive', 'trash'].indexOf(settings.view) < 0 && settings.view.indexOf('tag:') !== 0) settings.view = 'all';
+  $('sort').value = settings.sort;
+  bind(); applyTheme(); renderMode(); renderAll(); renderEditor();
+  persist();
+  $('saved').textContent = '';
+  if (!settings.selected && window.innerWidth > 900) {
+    var f = sorted(notes.filter(matches))[0];
+    if (f) { settings.selected = f.id; renderList(); renderEditor(); }
+  }
+}
+init();
+})();
diff --git a/notes/index.html b/notes/index.html
new file mode 100644
index 0000000..24e602d
--- /dev/null
+++ b/notes/index.html
@@ -0,0 +1,103 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Notes</title>
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<div class="app" id="app">
+  <aside class="sidebar" id="sidebar">
+    <div class="side-top">
+      <div class="brand">Notes</div>
+      <button class="btn primary" id="newBtn" title="New note (Ctrl/Cmd+Alt+N)">+ New</button>
+    </div>
+    <div class="search-wrap">
+      <input type="search" id="search" placeholder="Search notes…  (Ctrl/Cmd+K)" autocomplete="off">
+    </div>
+    <nav class="views" id="views"></nav>
+    <div class="tags-head">Tags</div>
+    <div class="tags" id="tagList"></div>
+    <div class="side-bottom">
+      <select id="sort" title="Sort notes">
+        <option value="updated">Recently edited</option>
+        <option value="created">Recently created</option>
+        <option value="title">Title A–Z</option>
+      </select>
+      <button class="btn" id="menuBtn" title="Settings, import and export">⚙</button>
+    </div>
+  </aside>
+
+  <section class="list-pane" id="listPane">
+    <div class="list-head">
+      <button class="btn icon mobile-only" id="toSidebar" title="Menu">☰</button>
+      <span id="listTitle">All notes</span>
+      <span class="count" id="listCount"></span>
+      <button class="btn small" id="emptyTrash" hidden>Empty trash</button>
+    </div>
+    <ul class="note-list" id="noteList"></ul>
+  </section>
+
+  <main class="editor-pane" id="editorPane">
+    <div class="empty" id="emptyState">
+      <h2>No note selected</h2>
+      <p>Pick a note from the list or create a new one.</p>
+      <button class="btn primary" id="newBtn2">+ New note</button>
+    </div>
+    <div class="editor" id="editor" hidden>
+      <div class="ed-bar">
+        <button class="btn icon mobile-only" id="backBtn" title="Back to list">←</button>
+        <input type="text" id="title" placeholder="Title" spellcheck="true">
+        <div class="ed-actions">
+          <div class="seg" id="modeSeg">
+            <button data-mode="edit" title="Edit">Edit</button>
+            <button data-mode="split" title="Split view">Split</button>
+            <button data-mode="preview" title="Preview">View</button>
+          </div>
+          <button class="btn icon" id="pinBtn" title="Pin">📌</button>
+          <button class="btn icon" id="archiveBtn" title="Archive">🗄</button>
+          <button class="btn icon" id="trashBtn" title="Move to trash">🗑</button>
+          <button class="btn" id="restoreBtn" hidden>Restore</button>
+          <button class="btn danger" id="purgeBtn" hidden>Delete forever</button>
+        </div>
+      </div>
+      <div class="tag-bar">
+        <div class="chips" id="chips"></div>
+        <input type="text" id="tagInput" placeholder="Add tag…" list="tagSuggest" autocomplete="off">
+        <datalist id="tagSuggest"></datalist>
+      </div>
+      <div class="toolbar" id="toolbar">
+        <button data-fmt="bold" title="Bold (Ctrl/Cmd+B)"><b>B</b></button>
+        <button data-fmt="italic" title="Italic (Ctrl/Cmd+I)"><i>I</i></button>
+        <button data-fmt="strike" title="Strikethrough"><s>S</s></button>
+        <button data-fmt="code" title="Code">&lt;/&gt;</button>
+        <button data-fmt="h" title="Heading">H</button>
+        <button data-fmt="ul" title="Bullet list">• List</button>
+        <button data-fmt="task" title="Checklist">☑ Task</button>
+        <button data-fmt="quote" title="Quote">❝</button>
+        <button data-fmt="link" title="Link (Ctrl/Cmd+Shift+K)">Link</button>
+      </div>
+      <div class="panes" id="panes">
+        <textarea id="body" placeholder="Start writing… Markdown is supported." spellcheck="true"></textarea>
+        <div class="preview" id="preview"></div>
+      </div>
+      <div class="statusbar">
+        <span id="stats"></span>
+        <span id="saved"></span>
+      </div>
+    </div>
+  </main>
+</div>
+
+<div class="menu" id="menu" hidden>
+  <button id="exportJson">Export all notes (JSON)</button>
+  <button id="exportMd">Export current note (.md)</button>
+  <button id="importBtn">Import notes (JSON or .md)…</button>
+  <button id="themeBtn">Theme: auto</button>
+  <input type="file" id="importFile" accept=".json,.md,.txt,application/json,text/markdown,text/plain" multiple hidden>
+</div>
+<div class="toast" id="toast" hidden></div>
+<script src="app.js"></script>
+</body>
+</html>
diff --git a/notes/style.css b/notes/style.css
new file mode 100644
index 0000000..220c4a0
--- /dev/null
+++ b/notes/style.css
@@ -0,0 +1,117 @@
+:root{
+  --bg:#ffffff;--bg2:#f6f7f9;--bg3:#eceef2;--fg:#1c2026;--muted:#6b7280;--line:#e1e4ea;
+  --accent:#3b6df0;--accent-fg:#fff;--danger:#d93a3a;--sel:#e6edff;--code:#f1f3f6;
+}
+:root[data-theme=dark]{
+  --bg:#16181d;--bg2:#1c1f26;--bg3:#262a33;--fg:#e6e8ec;--muted:#8d95a3;--line:#2c313b;
+  --accent:#6f95ff;--accent-fg:#0b1020;--danger:#ff6b6b;--sel:#242c44;--code:#242830;
+}
+@media (prefers-color-scheme:dark){
+  :root:not([data-theme=light]){
+    --bg:#16181d;--bg2:#1c1f26;--bg3:#262a33;--fg:#e6e8ec;--muted:#8d95a3;--line:#2c313b;
+    --accent:#6f95ff;--accent-fg:#0b1020;--danger:#ff6b6b;--sel:#242c44;--code:#242830;
+  }
+}
+*{box-sizing:border-box}
+html,body{height:100%;margin:0}
+body{font:15px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;background:var(--bg);color:var(--fg)}
+button,input,select,textarea{font:inherit;color:inherit}
+button{cursor:pointer}
+[hidden]{display:none!important}
+.app{display:grid;grid-template-columns:220px 300px 1fr;height:100%}
+.sidebar{background:var(--bg2);border-right:1px solid var(--line);display:flex;flex-direction:column;min-height:0;padding:12px;gap:10px}
+.side-top{display:flex;align-items:center;justify-content:space-between}
+.brand{font-weight:700;font-size:17px}
+.btn{background:var(--bg3);border:1px solid var(--line);border-radius:6px;padding:5px 10px}
+.btn:hover{border-color:var(--muted)}
+.btn.primary{background:var(--accent);color:var(--accent-fg);border-color:var(--accent);font-weight:600}
+.btn.danger{color:var(--danger);border-color:var(--danger);background:transparent}
+.btn.icon{padding:4px 8px}
+.btn.small{padding:2px 8px;font-size:12px}
+.btn.on{background:var(--sel);border-color:var(--accent)}
+input[type=search],input[type=text],select{width:100%;background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:6px 9px;outline:none}
+input:focus,select:focus,textarea:focus{border-color:var(--accent)}
+.views{display:flex;flex-direction:column;gap:2px}
+.views button,.tags button{display:flex;justify-content:space-between;gap:8px;text-align:left;background:none;border:0;border-radius:6px;padding:6px 9px;width:100%}
+.views button:hover,.tags button:hover{background:var(--bg3)}
+.views button.active,.tags button.active{background:var(--sel);color:var(--accent);font-weight:600}
+.views .n,.tags .n{color:var(--muted);font-size:12px;font-weight:400}
+.tags-head{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);padding:0 9px}
+.tags{flex:1;overflow:auto;min-height:0}
+.side-bottom{display:flex;gap:6px}
+.list-pane{border-right:1px solid var(--line);display:flex;flex-direction:column;min-height:0;min-width:0}
+.list-head{display:flex;align-items:center;gap:8px;padding:12px;border-bottom:1px solid var(--line);font-weight:600}
+.list-head .count{color:var(--muted);font-weight:400;font-size:13px;flex:1}
+.note-list{list-style:none;margin:0;padding:0;overflow:auto;flex:1}
+.note-list li{padding:10px 14px;border-bottom:1px solid var(--line);cursor:pointer}
+.note-list li:hover{background:var(--bg2)}
+.note-list li.active{background:var(--sel)}
+.note-list .t{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.note-list .s{color:var(--muted);font-size:13px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;word-break:break-word}
+.note-list .m{color:var(--muted);font-size:12px;margin-top:3px;display:flex;gap:8px;flex-wrap:wrap}
+.note-list .tg{color:var(--accent)}
+.note-list mark,.preview mark{background:#ffe27a;color:#222;border-radius:2px}
+.list-empty{padding:30px 16px;color:var(--muted);text-align:center}
+.editor-pane{min-width:0;min-height:0;display:flex}
+.empty{margin:auto;text-align:center;color:var(--muted)}
+.editor{display:flex;flex-direction:column;flex:1;min-width:0;min-height:0}
+.ed-bar{display:flex;gap:10px;align-items:center;padding:10px 14px;border-bottom:1px solid var(--line)}
+#title{font-size:20px;font-weight:700;border:0;background:none;padding:4px 0}
+.ed-actions{display:flex;gap:6px;align-items:center;flex-shrink:0}
+.seg{display:flex;border:1px solid var(--line);border-radius:6px;overflow:hidden}
+.seg button{background:none;border:0;padding:4px 10px;font-size:13px}
+.seg button.on{background:var(--accent);color:var(--accent-fg)}
+.tag-bar{display:flex;gap:6px;align-items:center;padding:6px 14px;border-bottom:1px solid var(--line);flex-wrap:wrap}
+.chips{display:flex;gap:6px;flex-wrap:wrap}
+.chip{background:var(--bg3);border-radius:12px;padding:1px 4px 1px 10px;font-size:13px;display:inline-flex;gap:4px;align-items:center}
+.chip button{background:none;border:0;color:var(--muted);padding:0 5px;font-size:15px;line-height:1}
+.tag-bar input{width:140px;border:0;background:none;padding:3px}
+.toolbar{display:flex;gap:2px;padding:4px 14px;border-bottom:1px solid var(--line);flex-wrap:wrap}
+.toolbar button{background:none;border:0;border-radius:4px;padding:3px 9px;font-size:13px;color:var(--muted)}
+.toolbar button:hover{background:var(--bg3);color:var(--fg)}
+.panes{flex:1;display:flex;min-height:0}
+#body{flex:1;min-width:0;resize:none;border:0;outline:none;padding:18px 22px;background:var(--bg);font:14.5px/1.6 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
+.preview{flex:1;min-width:0;overflow:auto;padding:18px 26px;word-wrap:break-word}
+.panes.m-edit .preview,.panes.m-preview #body{display:none}
+.panes.m-split .preview{border-left:1px solid var(--line)}
+.m-edit ~ .x,.editor.nomd .toolbar{display:none}
+.statusbar{display:flex;justify-content:space-between;padding:4px 14px;border-top:1px solid var(--line);color:var(--muted);font-size:12px}
+.preview h1,.preview h2,.preview h3,.preview h4{margin:1.1em 0 .4em;line-height:1.25}
+.preview h1{font-size:1.7em;border-bottom:1px solid var(--line);padding-bottom:.2em}
+.preview h2{font-size:1.4em}.preview h3{font-size:1.15em}.preview h4{font-size:1em}
+.preview p{margin:.6em 0}
+.preview code{background:var(--code);padding:1px 5px;border-radius:4px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.9em}
+.preview pre{background:var(--code);padding:12px;border-radius:6px;overflow:auto}
+.preview pre code{padding:0;background:none}
+.preview blockquote{margin:.6em 0;padding:2px 14px;border-left:3px solid var(--accent);color:var(--muted)}
+.preview ul,.preview ol{padding-left:1.6em;margin:.5em 0}
+.preview ul.tasks{list-style:none;padding-left:.4em}
+.preview li.task input{margin-right:8px}
+.preview li.done{color:var(--muted);text-decoration:line-through}
+.preview a{color:var(--accent)}
+.preview hr{border:0;border-top:1px solid var(--line);margin:1.2em 0}
+.preview table{border-collapse:collapse;margin:.6em 0}
+.preview th,.preview td{border:1px solid var(--line);padding:4px 10px}
+.preview th{background:var(--bg2)}
+.menu{position:fixed;left:14px;bottom:56px;background:var(--bg);border:1px solid var(--line);border-radius:8px;box-shadow:0 6px 24px rgba(0,0,0,.2);padding:4px;z-index:20;display:flex;flex-direction:column;min-width:240px}
+.menu button{background:none;border:0;text-align:left;padding:8px 10px;border-radius:5px}
+.menu button:hover{background:var(--bg3)}
+.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:var(--fg);color:var(--bg);padding:8px 14px;border-radius:8px;z-index:30;display:flex;gap:12px;align-items:center}
+.toast button{background:none;border:0;color:var(--accent);font-weight:700;padding:0}
+.mobile-only{display:none}
+@media (max-width:900px){
+  .app{grid-template-columns:1fr;position:relative}
+  .mobile-only{display:inline-block}
+  .sidebar,.list-pane,.editor-pane{position:absolute;inset:0;background:var(--bg)}
+  .sidebar{background:var(--bg2);z-index:3;transform:translateX(-100%);transition:transform .15s}
+  .app.show-sidebar .sidebar{transform:none}
+  .editor-pane{z-index:2;transform:translateX(100%);transition:transform .15s}
+  .app.show-editor .editor-pane{transform:none}
+  .ed-bar{flex-wrap:wrap}
+  .panes.m-split{flex-direction:column}
+  .panes.m-split .preview{border-left:0;border-top:1px solid var(--line)}
