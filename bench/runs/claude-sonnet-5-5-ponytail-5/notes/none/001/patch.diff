+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Notes</title>
+<link rel="stylesheet" href="styles.css">
+</head>
+<body>
+<div class="app" id="app" data-pane="list">
+  <aside class="nav" id="nav" aria-label="Navigation">
+    <div class="brand">Notes</div>
+    <button class="btn primary block" id="newBtn" title="New note (Ctrl/Cmd+Alt+N)">+ New note</button>
+    <nav id="views"></nav>
+    <div class="nav-title">Tags</div>
+    <nav id="tags"></nav>
+    <div class="nav-spacer"></div>
+    <div class="nav-foot">
+      <button class="btn" id="themeBtn" title="Switch theme">Theme: auto</button>
+      <button class="btn" id="exportBtn">Export backup</button>
+      <button class="btn" id="importBtn">Import backup</button>
+      <button class="btn" id="helpBtn">Shortcuts</button>
+      <input type="file" id="importFile" accept=".json,application/json" hidden>
+    </div>
+  </aside>
+
+  <section class="list-pane" id="listPane">
+    <div class="list-head">
+      <button class="btn icon only-mobile" id="navToggle" aria-label="Menu">☰</button>
+      <input type="search" id="search" placeholder="Search notes…  ( / )" aria-label="Search notes">
+      <select id="sort" aria-label="Sort">
+        <option value="updated">Recently edited</option>
+        <option value="created">Recently created</option>
+        <option value="title">Title A–Z</option>
+      </select>
+    </div>
+    <div class="list-title" id="listTitle"></div>
+    <ul class="notes" id="noteList"></ul>
+  </section>
+
+  <main class="editor-pane" id="editorPane">
+    <div class="empty" id="empty">
+      <p id="emptyMsg">Select a note or create a new one.</p>
+    </div>
+    <div class="editor" id="editor" hidden>
+      <div class="toolbar">
+        <button class="btn icon only-mobile" id="backBtn" aria-label="Back to list">←</button>
+        <div class="seg" role="group" aria-label="Mode">
+          <button id="modeEdit">Edit</button>
+          <button id="modeSplit">Split</button>
+          <button id="modePreview">Preview</button>
+        </div>
+        <div class="grow"></div>
+        <button class="btn" id="pinBtn">Pin</button>
+        <button class="btn" id="archiveBtn">Archive</button>
+        <button class="btn" id="mdBtn" title="Download as Markdown">.md</button>
+        <button class="btn" id="copyBtn">Copy</button>
+        <button class="btn danger" id="deleteBtn">Delete</button>
+      </div>
+      <div class="trash-banner" id="trashBanner" hidden>
+        This note is in the trash.
+        <button class="btn" id="restoreBtn">Restore</button>
+        <button class="btn danger" id="purgeBtn">Delete forever</button>
+      </div>
+      <input id="title" class="title" placeholder="Title" aria-label="Title" maxlength="200">
+      <div class="tagbar" id="tagbar">
+        <span id="tagChips"></span>
+        <input id="tagInput" placeholder="Add tag…" aria-label="Add tag" list="tagSuggest">
+        <datalist id="tagSuggest"></datalist>
+      </div>
+      <div class="panes" id="panes">
+        <textarea id="body" spellcheck="true" placeholder="Start writing… Markdown is supported." aria-label="Note body"></textarea>
+        <div class="preview" id="preview"></div>
+      </div>
+      <div class="status"><span id="stats"></span><span id="saved"></span></div>
+    </div>
+  </main>
+</div>
+
+<div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
+
+<dialog id="helpDlg">
+  <h2>Keyboard shortcuts</h2>
+  <table>
+    <tr><td><kbd>Ctrl/⌘</kbd>+<kbd>Alt</kbd>+<kbd>N</kbd></td><td>New note</td></tr>
+    <tr><td><kbd>/</kbd> or <kbd>Ctrl/⌘</kbd>+<kbd>K</kbd></td><td>Search</td></tr>
+    <tr><td><kbd>Ctrl/⌘</kbd>+<kbd>Alt</kbd>+<kbd>P</kbd></td><td>Cycle edit / split / preview</td></tr>
+    <tr><td><kbd>↑</kbd> <kbd>↓</kbd> (in search)</td><td>Move through notes</td></tr>
+    <tr><td><kbd>Esc</kbd></td><td>Clear search / leave editor</td></tr>
+    <tr><td><kbd>Tab</kbd> in body</td><td>Insert indent</td></tr>
+  </table>
+  <h2>Markdown</h2>
+  <p class="muted"># headings, **bold**, *italic*, ~~strike~~, `code`, fenced ``` blocks, &gt; quotes, - lists, 1. lists, - [ ] tasks (clickable in preview), [links](https://…), tables, ---</p>
+  <form method="dialog"><button class="btn primary">Close</button></form>
+</dialog>
+<script src="app.js"></script>
+</body>
+</html>
diff --git a/notes/styles.css b/notes/styles.css
new file mode 100644
index 0000000..9f78ccc
--- /dev/null
+++ b/notes/styles.css
@@ -0,0 +1,126 @@
+:root {
+  --bg: #ffffff; --bg2: #f6f6f4; --bg3: #ececE8; --fg: #1c1c1a; --muted: #6b6b66;
+  --line: #deded8; --accent: #2f6fed; --accent-fg: #fff; --danger: #c93b3b; --sel: #e3ecfe;
+  --code: #f1f1ee;
+}
+:root[data-theme="dark"] {
+  --bg: #1a1b1d; --bg2: #202225; --bg3: #2a2c30; --fg: #e6e6e3; --muted: #9a9a95;
+  --line: #34363a; --accent: #6b9bff; --accent-fg: #0c1424; --danger: #ef6b6b; --sel: #27344f;
+  --code: #26282c;
+}
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme="light"]) {
+    --bg: #1a1b1d; --bg2: #202225; --bg3: #2a2c30; --fg: #e6e6e3; --muted: #9a9a95;
+    --line: #34363a; --accent: #6b9bff; --accent-fg: #0c1424; --danger: #ef6b6b; --sel: #27344f;
+    --code: #26282c;
+  }
+}
+* { box-sizing: border-box; }
+html, body { height: 100%; margin: 0; }
+body { font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; background: var(--bg); color: var(--fg); }
+button, input, select, textarea { font: inherit; color: inherit; }
+[hidden] { display: none !important; }
+
+.app { display: grid; grid-template-columns: 210px 320px 1fr; height: 100%; }
+.nav { background: var(--bg2); border-right: 1px solid var(--line); padding: 14px 10px; display: flex; flex-direction: column; gap: 6px; overflow-y: auto; }
+.brand { font-weight: 700; font-size: 18px; padding: 0 6px 6px; }
+.nav-title { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); padding: 12px 8px 2px; }
+.nav-spacer { flex: 1; }
+.nav-foot { display: flex; flex-direction: column; gap: 6px; }
+.nav-item { display: flex; justify-content: space-between; width: 100%; background: none; border: 0; text-align: left; padding: 6px 8px; border-radius: 6px; cursor: pointer; }
+.nav-item:hover { background: var(--bg3); }
+.nav-item.active { background: var(--sel); font-weight: 600; }
+.nav-item .count { color: var(--muted); font-size: 12px; }
+
+.btn { background: var(--bg); border: 1px solid var(--line); border-radius: 6px; padding: 5px 10px; cursor: pointer; }
+.btn:hover { background: var(--bg3); }
+.btn.primary { background: var(--accent); color: var(--accent-fg); border-color: var(--accent); }
+.btn.primary:hover { filter: brightness(1.08); }
+.btn.danger { color: var(--danger); }
+.btn.block { width: 100%; padding: 8px; }
+.btn.on { background: var(--sel); border-color: var(--accent); }
+.btn:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, .note:focus-visible, .nav-item:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
+
+.list-pane { border-right: 1px solid var(--line); display: flex; flex-direction: column; min-height: 0; }
+.list-head { display: flex; gap: 6px; padding: 10px; }
+.list-head input { flex: 1; min-width: 0; }
+input[type=search], select, .title, #tagInput {
+  background: var(--bg); border: 1px solid var(--line); border-radius: 6px; padding: 6px 8px;
+}
+.list-title { padding: 0 12px 6px; font-size: 12px; color: var(--muted); display: flex; justify-content: space-between; align-items: center; }
+.notes { list-style: none; margin: 0; padding: 0; overflow-y: auto; flex: 1; }
+.note { padding: 10px 12px; border-top: 1px solid var(--line); cursor: pointer; }
+.note:hover { background: var(--bg2); }
+.note.active { background: var(--sel); }
+.note h3 { margin: 0; font-size: 15px; display: flex; gap: 6px; }
+.note h3 span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.note p { margin: 2px 0 0; color: var(--muted); font-size: 13px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-word; }
+.note .meta { font-size: 11px; color: var(--muted); margin-top: 3px; display: flex; gap: 6px; flex-wrap: wrap; }
+.note mark, .preview mark { background: #ffe58a; color: #000; border-radius: 2px; }
+.none { padding: 20px 12px; color: var(--muted); }
+
+.editor-pane { min-width: 0; min-height: 0; display: flex; flex-direction: column; }
+.empty { margin: auto; color: var(--muted); }
+.editor { display: flex; flex-direction: column; height: 100%; min-height: 0; }
+.toolbar { display: flex; gap: 6px; padding: 10px 14px; border-bottom: 1px solid var(--line); align-items: center; flex-wrap: wrap; }
+.grow { flex: 1; }
+.seg { display: inline-flex; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; }
+.seg button { background: var(--bg); border: 0; padding: 5px 10px; cursor: pointer; border-right: 1px solid var(--line); }
+.seg button:last-child { border-right: 0; }
+.seg button.on { background: var(--accent); color: var(--accent-fg); }
+.trash-banner { background: #fff3cd; color: #5c4600; padding: 8px 14px; display: flex; gap: 8px; align-items: center; }
+.title { margin: 12px 14px 4px; font-size: 22px; font-weight: 700; border: 0; background: transparent; padding: 4px 0; }
+.title:focus { outline: none; }
+.tagbar { padding: 0 14px 8px; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
+.chip { background: var(--bg3); border-radius: 999px; padding: 1px 4px 1px 10px; font-size: 13px; display: inline-flex; gap: 4px; align-items: center; margin-right: 4px; }
+.chip button { background: none; border: 0; cursor: pointer; color: var(--muted); padding: 0 4px; }
+#tagInput { border: 0; background: transparent; width: 110px; padding: 2px 0; }
+#tagInput:focus { outline: none; }
+.panes { flex: 1; display: grid; min-height: 0; border-top: 1px solid var(--line); }
+.panes[data-mode="edit"] { grid-template-columns: 1fr; }
+.panes[data-mode="edit"] .preview { display: none; }
+.panes[data-mode="preview"] { grid-template-columns: 1fr; }
+.panes[data-mode="preview"] textarea { display: none; }
+.panes[data-mode="split"] { grid-template-columns: 1fr 1fr; }
+.panes[data-mode="split"] .preview { border-left: 1px solid var(--line); }
+textarea { border: 0; resize: none; padding: 14px; background: var(--bg); font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 14px; line-height: 1.6; min-height: 0; }
+textarea:focus { outline: none; }
+.panes[data-readonly="1"] textarea { opacity: .7; }
+.preview { padding: 14px 18px; overflow-y: auto; min-height: 0; word-break: break-word; }
+.preview > :first-child { margin-top: 0; }
+.preview h1, .preview h2, .preview h3 { line-height: 1.25; margin: 1.2em 0 .4em; }
+.preview h1 { font-size: 1.7em; } .preview h2 { font-size: 1.4em; } .preview h3 { font-size: 1.15em; }
+.preview code { background: var(--code); padding: 1px 5px; border-radius: 4px; font-size: .9em; }
+.preview pre { background: var(--code); padding: 10px 12px; border-radius: 6px; overflow-x: auto; }
+.preview pre code { background: none; padding: 0; }
+.preview blockquote { margin: .8em 0; padding: 0 12px; border-left: 3px solid var(--line); color: var(--muted); }
+.preview a { color: var(--accent); }
+.preview hr { border: 0; border-top: 1px solid var(--line); }
+.preview table { border-collapse: collapse; }
+.preview th, .preview td { border: 1px solid var(--line); padding: 4px 10px; }
+.preview ul.tasks { list-style: none; padding-left: 4px; }
+.preview .done { color: var(--muted); text-decoration: line-through; }
+.status { display: flex; justify-content: space-between; padding: 5px 14px; font-size: 12px; color: var(--muted); border-top: 1px solid var(--line); }
+
+.toast { position: fixed; bottom: 18px; left: 50%; transform: translateX(-50%); background: var(--fg); color: var(--bg); padding: 9px 14px; border-radius: 8px; display: flex; gap: 12px; align-items: center; box-shadow: 0 4px 16px #0004; z-index: 10; }
+.toast button { background: none; border: 0; color: inherit; font-weight: 700; text-decoration: underline; cursor: pointer; }
+dialog { background: var(--bg); color: var(--fg); border: 1px solid var(--line); border-radius: 10px; max-width: 520px; }
+dialog::backdrop { background: #0006; }
+dialog h2 { margin: 0 0 8px; font-size: 17px; }
+dialog td { padding: 3px 12px 3px 0; }
+kbd { background: var(--bg3); border: 1px solid var(--line); border-radius: 4px; padding: 0 5px; font-size: 12px; }
+.muted { color: var(--muted); }
+.only-mobile { display: none; }
+
+@media (max-width: 860px) {
+  .app { grid-template-columns: 1fr; }
+  .nav { position: fixed; inset: 0 auto 0 0; width: 250px; z-index: 5; transform: translateX(-100%); transition: transform .15s; }
+  .app.nav-open .nav { transform: none; box-shadow: 0 0 40px #0006; }
