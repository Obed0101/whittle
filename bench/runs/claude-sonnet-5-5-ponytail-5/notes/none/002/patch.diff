--- /dev/null
+++ b/notes/app.js
@@ -0,0 +1,460 @@
+(() => {
+'use strict';
+const KEY = 'notes.v1', PREF = 'notes.prefs.v1', TRASH_DAYS = 30;
+const $ = id => document.getElementById(id);
+const el = {};
+['app','list','listTitle','search','sortSel','trashBar','emptyTrash','emptyState','editor','title','body','preview','chips','tagInput','tagSuggest','tagList','views','stats','saved','toast','importFile','toolbar','tagEdit'].forEach(i => el[i] = $(i));
+
+let notes = [], prefs = { theme: 'auto', sort: 'updated', preview: false };
+let view = 'all', tagFilter = null, currentId = null, saveTimer = null, toastTimer = null;
+
+// ---------- storage ----------
+function load() {
+  try { notes = JSON.parse(localStorage.getItem(KEY)) || []; } catch { notes = []; }
+  try { Object.assign(prefs, JSON.parse(localStorage.getItem(PREF)) || {}); } catch {}
+  const cutoff = Date.now() - TRASH_DAYS * 864e5;
+  const before = notes.length;
+  notes = notes.filter(n => !(n.trashed && n.trashedAt < cutoff));
+  if (notes.length !== before) persist();
+}
+function persist() {
+  try {
+    localStorage.setItem(KEY, JSON.stringify(notes));
+    el.saved.textContent = 'Saved';
+  } catch (e) { el.saved.textContent = 'Save failed (storage full?)'; }
+}
+function savePrefs() { try { localStorage.setItem(PREF, JSON.stringify(prefs)); } catch {} }
+function flush() { if (saveTimer) { clearTimeout(saveTimer); saveTimer = null; persist(); } }
+const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
+const get = id => notes.find(n => n.id === id);
+const cur = () => get(currentId);
+
+// ---------- helpers ----------
+const esc = s => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
+const titleOf = n => n.title.trim() || n.body.trim().split('\n')[0].replace(/^[#>\s*-]+/, '').slice(0, 60) || 'Untitled';
+function fmtDate(t) {
+  const d = new Date(t), now = new Date();
+  if (d.toDateString() === now.toDateString()) return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
+  return d.toLocaleDateString([], { month: 'short', day: 'numeric', year: d.getFullYear() === now.getFullYear() ? undefined : 'numeric' });
+}
+function toast(msg, actionLabel, action) {
+  el.toast.textContent = msg;
+  if (action) {
+    const b = document.createElement('button');
+    b.textContent = actionLabel;
+    b.onclick = () => { action(); el.toast.hidden = true; };
+    el.toast.appendChild(b);
+  }
+  el.toast.hidden = false;
+  clearTimeout(toastTimer);
+  toastTimer = setTimeout(() => el.toast.hidden = true, 5000);
+}
+
+// ---------- markdown ----------
+function inline(s) {
+  const codes = [];
+  s = s.replace(/`([^`]+)`/g, (_, c) => { codes.push(c); return '\u0000' + (codes.length - 1) + '\u0000'; });
+  s = esc(s);
+  s = s.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, (m, t, u) =>
+    /^(https?:\/\/|mailto:)/i.test(u) ? `<a href="${u}" target="_blank" rel="noopener noreferrer">${t}</a>` : m);
+  s = s.replace(/(^|[\s(])(https?:\/\/[^\s<)]+)/g, '$1<a href="$2" target="_blank" rel="noopener noreferrer">$2</a>');
+  s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>').replace(/(^|[^*\w])\*([^*]+)\*(?!\w)/g, '$1<em>$2</em>')
+       .replace(/~~([^~]+)~~/g, '<del>$1</del>');
+  return s.replace(/\u0000(\d+)\u0000/g, (_, i) => `<code>${esc(codes[i])}</code>`);
+}
+function render(md) {
+  const lines = md.split('\n'), out = [];
+  let i = 0, para = [], list = null;
+  const endPara = () => { if (para.length) { out.push('<p>' + para.map(inline).join('<br>') + '</p>'); para = []; } };
+  const endList = () => { if (list) { out.push(`</${list}>`); list = null; } };
+  for (; i < lines.length; i++) {
+    const l = lines[i];
+    let m;
+    if ((m = l.match(/^```/))) {
+      endPara(); endList();
+      const buf = [];
+      for (i++; i < lines.length && !/^```/.test(lines[i]); i++) buf.push(lines[i]);
+      out.push('<pre><code>' + esc(buf.join('\n')) + '</code></pre>');
+    } else if ((m = l.match(/^(#{1,3})\s+(.*)/))) {
+      endPara(); endList(); out.push(`<h${m[1].length}>${inline(m[2])}</h${m[1].length}>`);
+    } else if (/^(-{3,}|\*{3,})\s*$/.test(l)) {
+      endPara(); endList(); out.push('<hr>');
+    } else if ((m = l.match(/^\s*[-*+]\s+\[([ xX])\]\s+(.*)/))) {
+      endPara();
+      if (list !== 'ul class="tasks"') { endList(); out.push('<ul class="tasks">'); list = 'ul class="tasks"'; }
+      out.push(`<li><label><input type="checkbox" data-line="${i}"${m[1] === ' ' ? '' : ' checked'}> ${inline(m[2])}</label></li>`);
+    } else if ((m = l.match(/^\s*[-*+]\s+(.*)/))) {
+      endPara();
+      if (list !== 'ul') { endList(); out.push('<ul>'); list = 'ul'; }
+      out.push(`<li>${inline(m[1])}</li>`);
+    } else if ((m = l.match(/^\s*\d+\.\s+(.*)/))) {
+      endPara();
+      if (list !== 'ol') { endList(); out.push('<ol>'); list = 'ol'; }
+      out.push(`<li>${inline(m[1])}</li>`);
+    } else if ((m = l.match(/^>\s?(.*)/))) {
+      endPara(); endList(); out.push(`<blockquote>${inline(m[1])}</blockquote>`);
+    } else if (!l.trim()) { endPara(); endList(); }
+    else { endList(); para.push(l); }
+  }
+  endPara(); endList();
+  // list closers for tasks need the tag name only
+  return out.join('\n').replace(/<\/ul class="tasks">/g, '</ul>');
+}
+
+// ---------- list / sidebar ----------
+function visible() {
+  const q = el.search.value.trim().toLowerCase();
+  let r = notes.filter(n => {
+    if (view === 'trash') return n.trashed;
+    if (n.trashed) return false;
+    if (view === 'archive') return n.archived;
+    if (n.archived) return false;
+    if (view === 'pinned') return n.pinned;
+    return true;
+  });
+  if (tagFilter) r = r.filter(n => n.tags.includes(tagFilter));
+  if (q) r = r.filter(n => (n.title + '\n' + n.body + '\n' + n.tags.join(' ')).toLowerCase().includes(q));
+  const s = prefs.sort;
+  r.sort((a, b) => (b.pinned - a.pinned) ||
+    (s === 'title' ? titleOf(a).localeCompare(titleOf(b)) : b[s] - a[s]));
+  return r;
+}
+function renderSidebar() {
+  const live = notes.filter(n => !n.trashed);
+  const counts = {
+    all: live.filter(n => !n.archived).length,
+    pinned: live.filter(n => !n.archived && n.pinned).length,
+    archive: live.filter(n => n.archived).length,
+    trash: notes.length - live.length
+  };
+  el.views.querySelectorAll('button').forEach(b => {
+    const v = b.dataset.view;
+    b.classList.toggle('active', v === view);
+    b.querySelector('.count').textContent = counts[v] || '';
+  });
+  const tc = {};
+  live.forEach(n => n.tags.forEach(t => tc[t] = (tc[t] || 0) + 1));
+  el.tagList.innerHTML = '';
+  Object.keys(tc).sort().forEach(t => {
+    const b = document.createElement('button');
+    b.className = t === tagFilter ? 'active' : '';
+    b.innerHTML = `<span>#${esc(t)}</span><span class="count">${tc[t]}</span>`;
+    b.onclick = () => { tagFilter = tagFilter === t ? null : t; renderAll(); };
+    el.tagList.appendChild(b);
+  });
+  el.tagSuggest.innerHTML = Object.keys(tc).map(t => `<option value="${esc(t)}">`).join('');
+}
+function renderList() {
+  const r = visible();
+  const names = { all: 'All notes', pinned: 'Pinned', archive: 'Archive', trash: 'Trash' };
+  el.listTitle.textContent = names[view] + (tagFilter ? ' · #' + tagFilter : '') + ` (${r.length})`;
+  el.trashBar.hidden = !(view === 'trash' && r.length);
+  el.sortSel.value = prefs.sort;
+  el.list.innerHTML = '';
+  if (!r.length) {
+    const li = document.createElement('li');
+    li.className = 'none';
+    li.textContent = el.search.value ? 'No matching notes.' : view === 'trash' ? 'Trash is empty.' : 'No notes here yet.';
+    el.list.appendChild(li);
+    return;
+  }
+  r.forEach(n => {
+    const li = document.createElement('li');
+    li.tabIndex = 0;
+    li.className = n.id === currentId ? 'active' : '';
+    const snippet = n.body.replace(/[#>*`\[\]-]/g, '').replace(/\s+/g, ' ').trim().slice(0, 140);
+    li.innerHTML = `<div class="t">${n.pinned ? '📌 ' : ''}${esc(titleOf(n))}</div>` +
+      `<div class="s">${esc(snippet) || '&nbsp;'}</div>` +
+      `<div class="m">${fmtDate(n.updated)}${n.tags.length ? ' · ' + n.tags.map(t => '#' + esc(t)).join(' ') : ''}</div>`;
+    li.onclick = () => open(n.id);
+    li.onkeydown = e => { if (e.key === 'Enter') open(n.id); };
+    el.list.appendChild(li);
+  });
+}
+function renderAll() { renderSidebar(); renderList(); }
+
+// ---------- editor ----------
+function discardIfBlank() {
+  const n = cur();
+  if (n && !n.title.trim() && !n.body.trim() && !n.tags.length) {
+    notes = notes.filter(x => x !== n);
+    persist();
+  }
+}
+function open(id) {
+  flush();
+  if (id !== currentId) discardIfBlank();
+  currentId = id;
+  const n = cur();
+  el.emptyState.hidden = !!n;
+  el.editor.hidden = !n;
+  el.app.classList.toggle('editing', !!n);
+  if (n) {
+    el.title.value = n.title;
+    el.body.value = n.body;
+    syncEditorState();
+    renderChips();
+    updateStats();
+    el.saved.textContent = '';
+  }
+  renderAll();
+}
+function syncEditorState() {
+  const n = cur();
+  if (!n) return;
+  const t = n.trashed;
+  el.title.readOnly = el.body.readOnly = t;
+  el.tagEdit.hidden = el.toolbar.hidden = t;
+  $('pinBtn').textContent = n.pinned ? 'Unpin' : 'Pin';
+  $('archiveBtn').textContent = n.archived ? 'Unarchive' : 'Archive';
+  ['pinBtn', 'archiveBtn', 'deleteBtn'].forEach(b => $(b).hidden = t);
+  $('restoreBtn').hidden = $('purgeBtn').hidden = !t;
+  const showPrev = prefs.preview || t;
+  el.preview.hidden = !showPrev;
+  el.body.hidden = showPrev;
+  $('previewBtn').textContent = prefs.preview ? 'Edit' : 'Preview';
+  $('previewBtn').hidden = t;
+  el.toolbar.hidden = t || prefs.preview;
+  if (showPrev) el.preview.innerHTML = render(n.body) || '<p style="color:var(--muted)">Nothing to preview.</p>';
+}
+function renderChips() {
+  const n = cur();
+  el.chips.innerHTML = '';
+  if (!n) return;
+  n.tags.forEach(t => {
+    const s = document.createElement('span');
+    s.className = 'chip';
+    s.innerHTML = `#${esc(t)}<button aria-label="Remove tag ${esc(t)}">×</button>`;
+    s.querySelector('button').onclick = () => { n.tags = n.tags.filter(x => x !== t); touch(); renderChips(); renderAll(); };
+    el.chips.appendChild(s);
+  });
+}
+function updateStats() {
+  const n = cur();
+  if (!n) return;
+  const w = n.body.trim() ? n.body.trim().split(/\s+/).length : 0;
+  el.stats.textContent = `${w} word${w === 1 ? '' : 's'} · ${n.body.length} chars`;
+}
+function touch() {
+  const n = cur();
+  if (!n) return;
+  n.updated = Date.now();
+  el.saved.textContent = 'Saving…';
+  clearTimeout(saveTimer);
+  saveTimer = setTimeout(() => { saveTimer = null; persist(); }, 300);
+}
+function newNote() {
+  flush();
+  discardIfBlank();
+  if (view === 'trash' || view === 'archive') view = 'all';
+  el.search.value = '';
+  const now = Date.now();
+  const n = { id: uid(), title: '', body: '', tags: tagFilter ? [tagFilter] : [], pinned: view === 'pinned', archived: false, trashed: false, created: now, updated: now };
+  notes.push(n);
+  persist();
+  open(n.id);
+  el.title.focus();
+}
+
+// ---------- actions ----------
+function setFlag(fn, msg) {
+  const n = cur();
+  if (!n) return;
+  fn(n);
+  n.updated = Date.now();
+  persist();
+  syncEditorState();
+  renderAll();
+  if (msg) toast(msg);
+}
+function closeIfHidden() {
+  const n = cur();
+  if (n && !visible().includes(n) && !el.search.value) {
+    currentId = null; el.editor.hidden = true; el.emptyState.hidden = false; el.app.classList.remove('editing');
+  }
+}
+function trashNote() {
+  const n = cur(); if (!n) return;
+  n.trashed = true; n.trashedAt = Date.now(); persist();
+  currentId = null; el.editor.hidden = true; el.emptyState.hidden = false; el.app.classList.remove('editing');
+  renderAll();
+  toast('Moved to trash', 'Undo', () => { n.trashed = false; delete n.trashedAt; persist(); renderAll(); });
+}
+function download(name, text, type) {
+  const a = document.createElement('a');
+  a.href = URL.createObjectURL(new Blob([text], { type }));
+  a.download = name;
+  document.body.appendChild(a); a.click(); a.remove();
+  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
+}
+function fmt(kind) {
+  const t = el.body, s = t.selectionStart, e = t.selectionEnd, sel = t.value.slice(s, e);
+  const wrap = (a, b, ph) => { const x = sel || ph; t.setRangeText(a + x + b, s, e, 'end'); t.setSelectionRange(s + a.length, s + a.length + x.length); };
+  const prefix = p => {
+    const ls = t.value.lastIndexOf('\n', s - 1) + 1;
+    t.setRangeText(p, ls, ls, 'end');
+    t.setSelectionRange(s + p.length, e + p.length);
+  };
+  if (kind === 'bold') wrap('**', '**', 'bold');
+  else if (kind === 'italic') wrap('*', '*', 'italic');
+  else if (kind === 'code') wrap('`', '`', 'code');
+  else if (kind === 'link') { wrap('[', '](https://)', 'text'); }
+  else if (kind === 'h') prefix('## ');
+  else if (kind === 'ul') prefix('- ');
+  else if (kind === 'task') prefix('- [ ] ');
+  t.focus();
+  t.dispatchEvent(new Event('input'));
+}
+function addTag(raw) {
+  const n = cur();
+  const t = raw.trim().replace(/^#/, '').toLowerCase().replace(/\s+/g, '-');
+  if (!n || !t || n.tags.includes(t)) return;
+  n.tags.push(t);
+  touch(); renderChips(); renderAll();
+}
+
+// ---------- events ----------
+el.title.addEventListener('input', () => { const n = cur(); if (n) { n.title = el.title.value; touch(); renderList(); } });
+el.body.addEventListener('input', () => { const n = cur(); if (n) { n.body = el.body.value; touch(); updateStats(); renderList(); } });
+el.body.addEventListener('keydown', e => {
+  if (e.key === 'Tab') {
+    e.preventDefault();
+    el.body.setRangeText('  ', el.body.selectionStart, el.body.selectionEnd, 'end');
+    el.body.dispatchEvent(new Event('input'));
+  } else if (e.key === 'Enter' && !e.shiftKey && !e.isComposing && el.body.selectionStart === el.body.selectionEnd) {
+    const t = el.body, p = t.selectionStart, ls = t.value.lastIndexOf('\n', p - 1) + 1;
+    const line = t.value.slice(ls, p);
+    const m = line.match(/^(\s*)([-*+]|\d+\.)\s(\[[ xX]\]\s)?/);
+    if (!m) return;
+    e.preventDefault();
+    if (line.length === m[0].length) { t.setRangeText('', ls, p, 'end'); }
+    else {
+      let marker = m[2];
+      if (/\d/.test(marker)) marker = (parseInt(marker, 10) + 1) + '.';
+      t.setRangeText('\n' + m[1] + marker + ' ' + (m[3] ? '[ ] ' : ''), p, p, 'end');
+    }
+    t.dispatchEvent(new Event('input'));
+  }
+});
+el.preview.addEventListener('change', e => {
+  const cb = e.target;
+  const n = cur();
+  if (!n || cb.type !== 'checkbox') return;
+  const lines = n.body.split('\n'), i = +cb.dataset.line;
+  lines[i] = lines[i].replace(/\[([ xX])\]/, cb.checked ? '[x]' : '[ ]');
+  n.body = lines.join('\n'); el.body.value = n.body;
+  touch(); renderList();
+});
+el.tagInput.addEventListener('keydown', e => {
+  if (e.key === 'Enter' || e.key === ',') { e.preventDefault(); addTag(el.tagInput.value); el.tagInput.value = ''; }
+  else if (e.key === 'Backspace' && !el.tagInput.value) {
+    const n = cur(); if (n && n.tags.length) { n.tags.pop(); touch(); renderChips(); renderAll(); }
+  }
+});
+el.tagInput.addEventListener('change', () => { if (el.tagInput.value) { addTag(el.tagInput.value); el.tagInput.value = ''; } });
+el.search.addEventListener('input', renderList);
+el.search.addEventListener('keydown', e => { if (e.key === 'Escape') { el.search.value = ''; renderList(); } });
+el.sortSel.addEventListener('change', () => { prefs.sort = el.sortSel.value; savePrefs(); renderList(); });
+el.views.addEventListener('click', e => {
+  const b = e.target.closest('button'); if (!b) return;
+  view = b.dataset.view; tagFilter = null;
+  renderAll();
+});
+el.toolbar.addEventListener('click', e => { const b = e.target.closest('button'); if (b) fmt(b.dataset.fmt); });
+$('newBtn').onclick = $('newBtn2').onclick = newNote;
+$('backBtn').onclick = () => { flush(); discardIfBlank(); currentId = null; el.editor.hidden = true; el.emptyState.hidden = false; el.app.classList.remove('editing'); renderAll(); };
+$('previewBtn').onclick = () => { prefs.preview = !prefs.preview; savePrefs(); syncEditorState(); if (!prefs.preview) el.body.focus(); };
+$('pinBtn').onclick = () => setFlag(n => n.pinned = !n.pinned);
+$('archiveBtn').onclick = () => { const n = cur(); const was = n && n.archived; setFlag(n => n.archived = !n.archived, was ? 'Unarchived' : 'Archived'); closeIfHidden(); renderAll(); };
+$('deleteBtn').onclick = trashNote;
+$('restoreBtn').onclick = () => { setFlag(n => { n.trashed = false; delete n.trashedAt; }, 'Restored'); closeIfHidden(); renderAll(); };
+$('purgeBtn').onclick = () => {
+  const n = cur(); if (!n || !confirm('Permanently delete this note? This cannot be undone.')) return;
+  notes = notes.filter(x => x !== n); persist(); currentId = null;
+  el.editor.hidden = true; el.emptyState.hidden = false; el.app.classList.remove('editing'); renderAll();
+};
+el.emptyTrash.onclick = () => {
+  const c = notes.filter(n => n.trashed).length;
+  if (!c || !confirm(`Permanently delete ${c} note${c === 1 ? '' : 's'}?`)) return;
+  notes = notes.filter(n => !n.trashed); persist();
+  if (!cur()) { currentId = null; el.editor.hidden = true; el.emptyState.hidden = false; el.app.classList.remove('editing'); }
+  renderAll();
+};
+$('mdBtn').onclick = () => {
+  const n = cur(); if (!n) return;
+  const name = (titleOf(n).replace(/[\\/:*?"<>|]+/g, '').trim() || 'note') + '.md';
+  download(name, (n.title.trim() ? '# ' + n.title.trim() + '\n\n' : '') + n.body, 'text/markdown');
+};
+$('exportBtn').onclick = () => {
+  flush();
+  download('notes-backup-' + new Date().toISOString().slice(0, 10) + '.json', JSON.stringify({ app: 'notes', version: 1, notes }, null, 2), 'application/json');
+};
+$('importBtn').onclick = () => el.importFile.click();
+el.importFile.addEventListener('change', async () => {
+  const f = el.importFile.files[0]; el.importFile.value = '';
+  if (!f) return;
+  try {
+    const data = JSON.parse(await f.text());
+    const arr = Array.isArray(data) ? data : data.notes;
+    if (!Array.isArray(arr)) throw 0;
+    let added = 0, updated = 0;
+    arr.forEach(r => {
+      if (!r || typeof r !== 'object') return;
+      const now = Date.now();
+      const n = {
+        id: String(r.id || uid()), title: String(r.title || ''), body: String(r.body || ''),
+        tags: Array.isArray(r.tags) ? r.tags.map(String) : [], pinned: !!r.pinned, archived: !!r.archived,
+        trashed: !!r.trashed, trashedAt: r.trashed ? (+r.trashedAt || now) : undefined,
+        created: +r.created || now, updated: +r.updated || now
+      };
+      const ex = get(n.id);
+      if (!ex) { notes.push(n); added++; }
+      else if (n.updated > ex.updated) { Object.assign(ex, n); updated++; }
+    });
+    persist(); open(currentId && get(currentId) ? currentId : null);
+    toast(`Imported ${added} new, ${updated} updated`);
+  } catch { toast('Import failed: not a valid notes backup'); }
+});
+function applyTheme() {
+  if (prefs.theme === 'auto') document.documentElement.removeAttribute('data-theme');
+  else document.documentElement.dataset.theme = prefs.theme;
+}
+$('themeBtn').onclick = () => {
+  const dark = matchMedia('(prefers-color-scheme: dark)').matches;
+  const eff = prefs.theme === 'auto' ? (dark ? 'dark' : 'light') : prefs.theme;
+  prefs.theme = eff === 'dark' ? 'light' : 'dark';
+  savePrefs(); applyTheme();
+};
+document.addEventListener('keydown', e => {
+  const mod = e.metaKey || e.ctrlKey;
+  if (mod && e.key.toLowerCase() === 'k') { e.preventDefault(); el.search.focus(); el.search.select(); }
+  else if (mod && e.altKey && e.code === 'KeyN') { e.preventDefault(); newNote(); }
+  else if (mod && e.key.toLowerCase() === 'e' && cur() && !cur().trashed) { e.preventDefault(); $('previewBtn').click(); }
+  else if (mod && e.key.toLowerCase() === 's') { e.preventDefault(); flush(); persist(); }
+});
+window.addEventListener('beforeunload', () => { flush(); discardIfBlank(); });
+// sync across tabs
+window.addEventListener('storage', e => {
+  if (e.key !== KEY) return;
+  try { notes = JSON.parse(e.newValue) || []; } catch { return; }
+  const n = cur();
+  if (!n) { currentId = null; el.editor.hidden = true; el.emptyState.hidden = false; }
+  else if (document.activeElement !== el.body && document.activeElement !== el.title) {
+    el.title.value = n.title; el.body.value = n.body; renderChips(); updateStats(); syncEditorState();
+  }
+  renderAll();
+});
+
+// ---------- init ----------
+load();
+applyTheme();
+if (!notes.length) {
+  const now = Date.now();
+  notes.push({
+    id: uid(), title: 'Welcome to Notes', pinned: true, archived: false, trashed: false, created: now, updated: now, tags: ['welcome'],
+    body: 'Your notes are saved automatically in this browser.\n\n## Tips\n- Write in **Markdown**; toggle *Preview* with Ctrl/⌘ E\n- Search with Ctrl/⌘ K, new note with Ctrl/⌘ Alt N\n- Add tags below the title and filter by them in the sidebar\n- Use **Export all** regularly to keep a backup\n\n- [ ] Try a checklist item\n- [x] Read this note\n'
+  });
+  persist();
+}
+renderAll();
+})();
