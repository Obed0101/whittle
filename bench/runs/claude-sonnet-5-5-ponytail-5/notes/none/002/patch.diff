+    </div>
+    <nav class="views" id="views">
+      <button data-view="all">All notes <span class="count"></span></button>
+      <button data-view="pinned">Pinned <span class="count"></span></button>
+      <button data-view="archive">Archive <span class="count"></span></button>
+      <button data-view="trash">Trash <span class="count"></span></button>
+    </nav>
+    <div class="tags-head">Tags</div>
+    <div class="tags" id="tagList"></div>
+    <div class="side-bottom">
+      <button id="exportBtn">Export all</button>
+      <button id="importBtn">Import</button>
+      <input type="file" id="importFile" accept="application/json,.json" hidden>
+    </div>
+  </aside>
+
+  <section class="list-pane" id="listPane">
+    <div class="list-top">
+      <input id="search" type="search" placeholder="Search notes  (Ctrl/⌘ K)" aria-label="Search notes">
+      <button id="newBtn" class="primary" title="New note (Ctrl/⌘ Alt N)">+ New</button>
+    </div>
+    <div class="list-meta">
+      <span id="listTitle"></span>
+      <select id="sortSel" aria-label="Sort notes">
+        <option value="updated">Last edited</option>
+        <option value="created">Created</option>
+        <option value="title">Title</option>
+      </select>
+    </div>
+    <ul class="list" id="list"></ul>
+    <div class="trash-bar" id="trashBar" hidden><button id="emptyTrash" class="danger">Empty trash</button></div>
+  </section>
+
+  <main class="editor-pane" id="editorPane">
+    <div class="empty" id="emptyState">
+      <p>Select a note or create a new one.</p>
+      <button class="primary" id="newBtn2">+ New note</button>
+    </div>
+    <div class="editor" id="editor" hidden>
+      <div class="ed-top">
+        <button id="backBtn" class="icon back" aria-label="Back to list">←</button>
+        <input id="title" placeholder="Title" aria-label="Title">
+        <div class="ed-actions">
+          <button id="previewBtn" title="Toggle preview (Ctrl/⌘ E)">Preview</button>
+          <button id="pinBtn" title="Pin">Pin</button>
+          <button id="archiveBtn" title="Archive">Archive</button>
+          <button id="mdBtn" title="Download as Markdown">.md</button>
+          <button id="deleteBtn" class="danger" title="Move to trash">Delete</button>
+          <button id="restoreBtn" hidden>Restore</button>
+          <button id="purgeBtn" class="danger" hidden>Delete forever</button>
+        </div>
+      </div>
+      <div class="toolbar" id="toolbar">
+        <button data-fmt="bold" title="Bold"><b>B</b></button>
+        <button data-fmt="italic" title="Italic"><i>I</i></button>
+        <button data-fmt="h" title="Heading">H</button>
+        <button data-fmt="ul" title="Bullet list">• List</button>
+        <button data-fmt="task" title="Checklist">☑ Task</button>
+        <button data-fmt="code" title="Code">&lt;/&gt;</button>
+        <button data-fmt="link" title="Link">Link</button>
+      </div>
+      <div class="tag-edit" id="tagEdit">
+        <span id="chips"></span>
+        <input id="tagInput" placeholder="Add tag…" aria-label="Add tag" list="tagSuggest">
+        <datalist id="tagSuggest"></datalist>
+      </div>
+      <textarea id="body" placeholder="Start writing… Markdown supported." aria-label="Note body"></textarea>
+      <div class="preview" id="preview" hidden></div>
+      <div class="ed-foot"><span id="stats"></span><span id="saved"></span></div>
+    </div>
+  </main>
+</div>
+<div class="toast" id="toast" role="status" hidden></div>
+<script src="app.js"></script>
+</body>
+</html>
diff --git a/notes/styles.css b/notes/styles.css
new file mode 100644
index 0000000..43e64af
