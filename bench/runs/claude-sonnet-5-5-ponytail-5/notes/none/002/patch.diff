+++ b/notes/styles.css
@@ -0,0 +1,71 @@
+:root{--bg:#fff;--bg2:#f6f7f9;--bg3:#eceef2;--fg:#1c1f26;--muted:#6b7280;--line:#dfe2e8;--accent:#3b6df0;--accent-fg:#fff;--danger:#d33;--sel:#e6edff;color-scheme:light}
+@media(prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#16181d;--bg2:#1c1f26;--bg3:#262a33;--fg:#e6e8ec;--muted:#9097a3;--line:#2d323c;--accent:#6c93ff;--accent-fg:#0b1020;--danger:#ff6b6b;--sel:#273453;color-scheme:dark}}
+:root[data-theme=dark]{--bg:#16181d;--bg2:#1c1f26;--bg3:#262a33;--fg:#e6e8ec;--muted:#9097a3;--line:#2d323c;--accent:#6c93ff;--accent-fg:#0b1020;--danger:#ff6b6b;--sel:#273453;color-scheme:dark}
+*{box-sizing:border-box}
+html,body{height:100%;margin:0}
+body{font:15px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--fg)}
+button,input,select,textarea{font:inherit;color:inherit}
+button{background:var(--bg3);border:1px solid var(--line);border-radius:6px;padding:5px 10px;cursor:pointer}
+button:hover{border-color:var(--accent)}
+button.primary{background:var(--accent);color:var(--accent-fg);border-color:var(--accent)}
+button.danger{color:var(--danger)}
+button.icon{padding:3px 8px}
+button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,li:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
+input,select{background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:6px 8px}
+.app{display:grid;grid-template-columns:210px 320px 1fr;height:100%}
+.sidebar{background:var(--bg2);border-right:1px solid var(--line);padding:12px;display:flex;flex-direction:column;gap:6px;overflow:auto}
+.side-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
+.side-top h1{font-size:18px;margin:0}
+.views button,.tags button{display:flex;justify-content:space-between;width:100%;background:none;border:0;text-align:left;padding:6px 8px}
+.views button.active,.tags button.active{background:var(--sel);font-weight:600}
+.count{color:var(--muted);font-weight:400}
+.tags-head{margin-top:12px;font-size:12px;text-transform:uppercase;color:var(--muted);letter-spacing:.05em;padding:0 8px}
+.tags{flex:1}
+.side-bottom{display:flex;gap:6px}
+.side-bottom button{flex:1}
+.list-pane{border-right:1px solid var(--line);display:flex;flex-direction:column;min-height:0}
+.list-top{display:flex;gap:6px;padding:10px}
+.list-top input{flex:1;min-width:0}
+.list-meta{display:flex;justify-content:space-between;align-items:center;padding:0 10px 6px;color:var(--muted);font-size:13px}
+.list-meta select{padding:2px 4px;font-size:13px}
+.list{list-style:none;margin:0;padding:0;overflow:auto;flex:1}
+.list li{padding:10px 12px;border-top:1px solid var(--line);cursor:pointer}
+.list li:hover{background:var(--bg2)}
+.list li.active{background:var(--sel)}
+.list .t{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.list .s{color:var(--muted);font-size:13px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;word-break:break-word}
+.list .m{color:var(--muted);font-size:12px;margin-top:2px}
+.list .none{padding:20px;color:var(--muted);cursor:default}
+.trash-bar{padding:8px 10px;border-top:1px solid var(--line)}
+.editor-pane{min-width:0;min-height:0;display:flex}
+.empty{margin:auto;text-align:center;color:var(--muted)}
+.editor{flex:1;display:flex;flex-direction:column;min-width:0;min-height:0}
+.ed-top{display:flex;gap:8px;padding:10px 14px;align-items:center;flex-wrap:wrap}
+.ed-top #title{flex:1;min-width:140px;font-size:20px;font-weight:600;border:0;background:none;padding:4px 0}
+.ed-actions{display:flex;gap:6px;flex-wrap:wrap}
+.back{display:none}
+.toolbar{display:flex;gap:4px;padding:0 14px 6px;flex-wrap:wrap}
+.toolbar button{padding:2px 8px;font-size:13px}
+.tag-edit{padding:0 14px 8px;display:flex;flex-wrap:wrap;gap:6px;align-items:center}
+.tag-edit input{border:0;background:none;padding:2px;min-width:100px}
+.chip{background:var(--bg3);border-radius:10px;padding:1px 4px 1px 9px;font-size:13px}
+.chip button{background:none;border:0;padding:0 5px;color:var(--muted)}
+#body{flex:1;resize:none;border:0;border-top:1px solid var(--line);padding:14px;background:var(--bg);font:15px/1.6 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;min-height:0}
+#body:focus{outline:0}
+.preview{flex:1;overflow:auto;padding:14px 20px;border-top:1px solid var(--line);word-wrap:break-word}
+.preview h1,.preview h2,.preview h3{margin:1em 0 .4em}
+.preview code{background:var(--bg3);padding:1px 4px;border-radius:4px}
+.preview pre{background:var(--bg3);padding:10px;border-radius:6px;overflow:auto}
+.preview pre code{padding:0;background:none}
+.preview blockquote{margin:.5em 0;padding-left:12px;border-left:3px solid var(--line);color:var(--muted)}
+.preview a{color:var(--accent)}
+.preview ul.tasks{list-style:none;padding-left:4px}
+.preview hr{border:0;border-top:1px solid var(--line)}
+.ed-foot{display:flex;justify-content:space-between;padding:4px 14px;color:var(--muted);font-size:12px;border-top:1px solid var(--line)}
+.toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:var(--fg);color:var(--bg);padding:8px 14px;border-radius:8px;display:flex;gap:12px;align-items:center;z-index:9}
+.toast button{background:none;border:0;color:inherit;text-decoration:underline;padding:0}
+[hidden]{display:none!important}
+@media(max-width:900px){.app{grid-template-columns:170px 1fr}.editor-pane{display:none}
+ .app.editing .list-pane,.app.editing .sidebar{display:none}.app.editing{grid-template-columns:1fr}.app.editing .editor-pane{display:flex}.back{display:inline-block}}
+@media(max-width:600px){.app{grid-template-columns:1fr;grid-template-rows:auto 1fr}.sidebar{flex-direction:row;flex-wrap:wrap;align-items:center;max-height:40vh}
+ .tags,.tags-head,.side-bottom{display:none}.views{display:flex;flex-wrap:wrap}.views button{width:auto}.app.editing{grid-template-rows:1fr}}
