diff --git a/board/app.js b/board/app.js
new file mode 100644
index 0000000..8d442c3
--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,493 @@
+(() => {
+'use strict';
+
+const KEY = 'kanban.v1';
+const PRIORITIES = ['none', 'low', 'med', 'high'];
+const $ = (id) => document.getElementById(id);
+const el = (tag, cls, text) => {
+  const n = document.createElement(tag);
+  if (cls) n.className = cls;
+  if (text != null) n.textContent = text;
+  return n;
+};
+const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
+const todayStr = () => {
+  const d = new Date();
+  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
+};
+
+// ---- state ---------------------------------------------------------------
+
+function defaults() {
+  return { columns: ['To do', 'Doing', 'Done'].map((title) => ({ id: uid(), title, cards: [] })) };
+}
+
+// Coerce untrusted data (storage, imports) into a well-formed state, or null.
+function sanitize(s) {
+  if (!s || !Array.isArray(s.columns) || !s.columns.length) return null;
+  const seen = new Set();
+  const id = (v) => {
+    let i = typeof v === 'string' && v && !seen.has(v) ? v : uid();
+    while (seen.has(i)) i = uid();
+    seen.add(i);
+    return i;
+  };
+  return {
+    columns: s.columns.filter((c) => c && typeof c === 'object').map((c) => ({
+      id: id(c.id),
+      title: String(c.title ?? 'Untitled').slice(0, 100),
+      cards: (Array.isArray(c.cards) ? c.cards : []).filter((k) => k && typeof k === 'object').map((k) => ({
+        id: id(k.id),
+        title: String(k.title ?? '').slice(0, 200) || 'Untitled',
+        notes: String(k.notes ?? '').slice(0, 5000),
+        priority: PRIORITIES.includes(k.priority) ? k.priority : 'none',
+        due: /^\d{4}-\d{2}-\d{2}$/.test(k.due) ? k.due : '',
+        created: Number(k.created) || Date.now(),
+      })),
+    })),
+  };
+}
+
+function load() {
+  try {
+    return sanitize(JSON.parse(localStorage.getItem(KEY))) || defaults();
+  } catch {
+    return defaults();
+  }
+}
+
+let state = load();
+let undoStack = [];
+let query = '';
+let addingIn = null;   // column id whose add-card form is open
+let addingCol = false;
+let drag = null;       // { kind: 'card' | 'col', id }
+
+function save() {
+  try {
+    localStorage.setItem(KEY, JSON.stringify(state));
+  } catch {
+    toast('Could not save: browser storage is unavailable or full. Use Export to keep a copy.');
+  }
+}
+
+// Every mutation goes through here so it can be undone.
+function commit(fn, message) {
+  undoStack.push(JSON.stringify(state));
+  if (undoStack.length > 50) undoStack.shift();
+  fn();
+  save();
+  render();
+  if (message) toast(message, 'Undo', undo);
+}
+
+function undo() {
+  if (!undoStack.length) return;
+  state = JSON.parse(undoStack.pop());
+  save();
+  render();
+  hideToast();
+}
+
+const findCol = (id) => state.columns.find((c) => c.id === id);
+function findCard(id) {
+  for (const col of state.columns) {
+    const card = col.cards.find((k) => k.id === id);
+    if (card) return { col, card };
+  }
+  return null;
+}
+
+function moveCard(cardId, toColId, beforeId) {
+  const hit = findCard(cardId);
+  const to = findCol(toColId);
+  if (!hit || !to) return;
+  hit.col.cards.splice(hit.col.cards.indexOf(hit.card), 1);
+  const at = beforeId ? to.cards.findIndex((k) => k.id === beforeId) : -1;
+  if (at < 0) to.cards.push(hit.card);
+  else to.cards.splice(at, 0, hit.card);
+}
+
+function moveCol(colId, beforeId) {
+  const i = state.columns.findIndex((c) => c.id === colId);
+  if (i < 0) return;
+  const [col] = state.columns.splice(i, 1);
+  const at = beforeId ? state.columns.findIndex((c) => c.id === beforeId) : -1;
+  if (at < 0) state.columns.push(col);
+  else state.columns.splice(at, 0, col);
+}
+
+// ---- toast ---------------------------------------------------------------
+
+let toastTimer;
+function toast(msg, actionLabel, action) {
+  const t = $('toast');
+  t.replaceChildren(el('span', null, msg));
+  if (actionLabel) {
+    const b = el('button', null, actionLabel);
+    b.type = 'button';
+    b.addEventListener('click', action);
+    t.append(b);
+  }
+  t.hidden = false;
+  clearTimeout(toastTimer);
+  toastTimer = setTimeout(hideToast, 6000);
+}
+function hideToast() {
+  $('toast').hidden = true;
+}
+
+// ---- rendering -----------------------------------------------------------
+
+function matches(card) {
+  if (!query) return true;
+  return (card.title + '\n' + card.notes).toLowerCase().includes(query);
+}
+
+function dueLabel(due) {
+  const [y, m, d] = due.split('-').map(Number);
+  return new Date(y, m - 1, d).toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
+}
+
+function render() {
+  const board = $('board');
+  const focused = document.activeElement && document.activeElement.dataset && document.activeElement.dataset.cardId;
+  const scroll = board.scrollLeft;
+  board.replaceChildren(...state.columns.map((c, i) => renderCol(c, i === state.columns.length - 1)), renderAddCol());
+  board.scrollLeft = scroll;
+  $('undo').disabled = !undoStack.length;
+  const target = (focused && board.querySelector(`[data-card-id="${focused}"]`)) || board.querySelector('.add-form textarea, input.add-col');
+  if (target) target.focus();
+}
+
+function renderCol(col, isLast) {
+  const root = el('section', 'col');
+  root.dataset.colId = col.id;
+
+  const head = el('div', 'col-head');
+  head.draggable = true;
+  const title = el('span', 'col-title', col.title);
+  title.title = 'Double-click to rename';
+  title.addEventListener('dblclick', () => startRename(head, title, col));
+  const visible = col.cards.filter(matches);
+  const count = el('span', 'count', query ? `${visible.length}/${col.cards.length}` : String(col.cards.length));
+  const del = el('button', 'icon', '✕');
+  del.type = 'button';
+  del.title = 'Delete column';
+  del.setAttribute('aria-label', `Delete column ${col.title}`);
+  del.disabled = state.columns.length <= 1;
+  del.addEventListener('click', () => {
+    if (col.cards.length && !confirm(`Delete "${col.title}" and its ${col.cards.length} card(s)?`)) return;
+    commit(() => { state.columns = state.columns.filter((c) => c.id !== col.id); }, `Deleted column "${col.title}"`);
+  });
+  head.append(title, count, del);
+  head.addEventListener('dragstart', (e) => {
+    drag = { kind: 'col', id: col.id };
+    e.dataTransfer.setData('text/plain', col.id);
+    e.dataTransfer.effectAllowed = 'move';
+    setTimeout(() => root.style.opacity = '.4', 0);
+  });
+  head.addEventListener('dragend', endDrag);
+
+  const list = el('div', 'cards');
+  list.append(...visible.map((k) => renderCard(k, col, isLast)));
+  if (!col.cards.length) list.append(el('div', 'empty', 'No cards'));
+
+  root.addEventListener('dragover', (e) => {
+    if (!drag || drag.kind !== 'card') return;
+    e.preventDefault();
+    const after = [...list.querySelectorAll('.card:not(.dragging)')].find((c) => {
+      const r = c.getBoundingClientRect();
+      return e.clientY < r.top + r.height / 2;
+    });
+    const ph = placeholder('ph');
+    if (ph.parentNode !== list || ph.nextElementSibling !== (after || null)) list.insertBefore(ph, after || null);
+  });
+  root.addEventListener('drop', (e) => {
+    if (!drag || drag.kind !== 'card') return;
+    e.preventDefault();
+    const ph = placeholder('ph');
+    let next = ph.nextElementSibling;
+    while (next && !(next.classList.contains('card') && !next.classList.contains('dragging'))) next = next.nextElementSibling;
+    const id = drag.id;
+    const beforeId = next ? next.dataset.cardId : null;
+    drag = null;
+    commit(() => moveCard(id, col.id, beforeId));
+  });
+
+  root.append(head, list, renderAdd(col));
+  return root;
+}
+
+let phNode = null;
+function placeholder(cls) {
+  if (!phNode || phNode.className !== cls) phNode = el('div', cls);
+  return phNode;
+}
+function endDrag() {
+  drag = null;
+  phNode = null;
+  render();
+}
+
+function startRename(head, title, col) {
+  const input = el('input');
+  input.value = col.title;
+  input.maxLength = 100;
+  input.setAttribute('aria-label', 'Column name');
+  head.draggable = false;
+  title.replaceWith(input);
+  input.focus();
+  input.select();
+  let done = false;
+  const finish = (ok) => {
+    if (done) return;
+    done = true;
+    const v = input.value.trim();
+    if (ok && v && v !== col.title) commit(() => { col.title = v; });
+    else render();
+  };
+  input.addEventListener('keydown', (e) => {
+    if (e.key === 'Enter') finish(true);
+    else if (e.key === 'Escape') finish(false);
+  });
+  input.addEventListener('blur', () => finish(true));
+}
+
+function renderCard(card, col, isLast) {
+  const n = el('div', `card p-${card.priority}`);
+  n.dataset.cardId = card.id;
+  n.tabIndex = 0;
+  n.draggable = true;
+  n.setAttribute('role', 'button');
+  n.title = 'Enter: edit · Alt+arrows: move';
+  n.append(el('div', 'card-title', card.title));
+
+  const meta = el('div', 'meta');
+  if (card.due) {
+    const t = todayStr();
+    const flag = card.due < t && !isLast ? 'overdue' : card.due === t && !isLast ? 'today' : '';
+    meta.append(el('span', `due ${flag}`, '📅 ' + dueLabel(card.due)));
+  }
+  if (card.notes) meta.append(el('span', null, '≡ notes'));
+  if (meta.childNodes.length) n.append(meta);
+
+  n.addEventListener('click', () => openDialog(card.id));
+  n.addEventListener('keydown', (e) => {
+    if (e.target !== n) return;
+    if (e.key === 'Enter') { e.preventDefault(); openDialog(card.id); return; }
+    if (!e.altKey || !e.key.startsWith('Arrow')) return;
+    e.preventDefault();
+    const ci = state.columns.indexOf(col);
+    const i = col.cards.indexOf(card);
+    if (e.key === 'ArrowUp' && i > 0) commit(() => moveCard(card.id, col.id, col.cards[i - 1].id));
+    else if (e.key === 'ArrowDown' && i < col.cards.length - 1) {
+      commit(() => moveCard(card.id, col.id, col.cards[i + 2] ? col.cards[i + 2].id : null));
+    } else if (e.key === 'ArrowLeft' && ci > 0) commit(() => moveCard(card.id, state.columns[ci - 1].id, null));
+    else if (e.key === 'ArrowRight' && ci < state.columns.length - 1) commit(() => moveCard(card.id, state.columns[ci + 1].id, null));
+  });
+  n.addEventListener('dragstart', (e) => {
+    drag = { kind: 'card', id: card.id };
+    e.dataTransfer.setData('text/plain', card.id);
+    e.dataTransfer.effectAllowed = 'move';
+    setTimeout(() => n.classList.add('dragging'), 0);
+  });
+  n.addEventListener('dragend', endDrag);
+  return n;
+}
+
+function renderAdd(col) {
+  if (addingIn !== col.id) {
+    const b = el('button', 'add', '+ Add card');
+    b.type = 'button';
+    b.addEventListener('click', () => { addingIn = col.id; render(); });
+    return b;
+  }
+  const form = el('form', 'add-form');
+  const ta = el('textarea');
+  ta.rows = 2;
+  ta.maxLength = 200;
+  ta.placeholder = 'Card title (Enter to add, Esc to close)';
+  ta.setAttribute('aria-label', 'New card title');
+  const ok = el('button', 'primary', 'Add');
+  ok.type = 'submit';
+  const cancel = el('button', null, 'Close');
+  cancel.type = 'button';
+  const btns = el('div', 'btns');
+  btns.append(ok, cancel);
+  form.append(ta, btns);
+  cancel.addEventListener('click', () => { addingIn = null; render(); });
+  ta.addEventListener('keydown', (e) => {
+    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); }
+    else if (e.key === 'Escape') { addingIn = null; render(); }
+  });
+  form.addEventListener('submit', (e) => {
+    e.preventDefault();
+    const t = ta.value.trim();
+    if (!t) return;
+    commit(() => col.cards.push({ id: uid(), title: t, notes: '', priority: 'none', due: '', created: Date.now() }));
+  });
+  return form;
+}
+
+function renderAddCol() {
+  if (!addingCol) {
+    const b = el('button', 'add-col', '+ Add column');
+    b.type = 'button';
+    b.addEventListener('click', () => { addingCol = true; render(); });
+    return b;
+  }
+  const input = el('input', 'add-col');
+  input.placeholder = 'Column name (Enter to add)';
+  input.maxLength = 100;
+  input.setAttribute('aria-label', 'New column name');
+  let done = false;
+  const finish = (ok) => {
+    if (done) return;
+    done = true;
+    addingCol = false;
+    const v = input.value.trim();
+    if (ok && v) commit(() => state.columns.push({ id: uid(), title: v, cards: [] }));
+    else render();
+  };
+  input.addEventListener('keydown', (e) => {
+    if (e.key === 'Enter') finish(true);
+    else if (e.key === 'Escape') finish(false);
+  });
+  input.addEventListener('blur', () => finish(true));
+  return input;
+}
+
+// column drag & drop lives on the board
+$('board').addEventListener('dragover', (e) => {
+  if (!drag || drag.kind !== 'col') return;
+  e.preventDefault();
+  const board = $('board');
+  const after = [...board.querySelectorAll('.col:not(.ph)')].find((c) => {
+    if (c.dataset.colId === drag.id) return false;
+    const r = c.getBoundingClientRect();
+    return e.clientX < r.left + r.width / 2;
+  });
+  const ph = placeholder('col ph');
+  board.insertBefore(ph, after || board.querySelector('.add-col'));
+});
+$('board').addEventListener('drop', (e) => {
+  if (!drag || drag.kind !== 'col') return;
+  e.preventDefault();
+  let next = placeholder('col ph').nextElementSibling;
+  while (next && (!next.dataset.colId || next.dataset.colId === drag.id)) next = next.nextElementSibling;
+  const id = drag.id;
+  const beforeId = next ? next.dataset.colId : null;
+  drag = null;
+  commit(() => moveCol(id, beforeId));
+});
+
+// ---- card dialog ---------------------------------------------------------
+
+const dlg = $('dlg');
+let editingId = null;
+
+function openDialog(cardId) {
+  const hit = findCard(cardId);
+  if (!hit) return;
+  editingId = cardId;
+  $('f-title').value = hit.card.title;
+  $('f-notes').value = hit.card.notes;
+  $('f-priority').value = hit.card.priority;
+  $('f-due').value = hit.card.due;
+  const sel = $('f-col');
+  sel.replaceChildren(...state.columns.map((c) => {
+    const o = el('option', null, c.title);
+    o.value = c.id;
+    return o;
+  }));
+  sel.value = hit.col.id;
+  dlg.showModal();
+  $('f-title').focus();
+}
+
+$('form').addEventListener('submit', () => {
+  const hit = findCard(editingId);
+  if (!hit) return;
+  const title = $('f-title').value.trim();
+  if (!title) return;
+  const toCol = $('f-col').value;
+  commit(() => {
+    Object.assign(hit.card, {
+      title,
+      notes: $('f-notes').value,
+      priority: $('f-priority').value,
+      due: $('f-due').value,
+    });
+    if (toCol !== hit.col.id) moveCard(hit.card.id, toCol, null);
+  });
+});
+$('f-cancel').addEventListener('click', () => dlg.close());
+$('f-delete').addEventListener('click', () => {
+  const hit = findCard(editingId);
+  dlg.close();
+  if (!hit) return;
+  commit(() => hit.col.cards.splice(hit.col.cards.indexOf(hit.card), 1), `Deleted "${hit.card.title}"`);
+});
+dlg.addEventListener('close', () => {
+  const card = document.querySelector(`[data-card-id="${editingId}"]`);
+  if (card) card.focus();
+});
+
+// ---- header, import/export, shortcuts -----------------------------------
+
+$('search').addEventListener('input', (e) => {
+  query = e.target.value.trim().toLowerCase();
+  const pos = e.target.selectionStart;
+  render();
+  e.target.focus();
+  e.target.setSelectionRange(pos, pos);
+});
+$('undo').addEventListener('click', undo);
+
+$('export').addEventListener('click', () => {
+  const a = el('a');
+  a.href = URL.createObjectURL(new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' }));
+  a.download = `kanban-${todayStr()}.json`;
+  a.click();
+  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
+});
+
+$('import').addEventListener('click', () => $('file').click());
+$('file').addEventListener('change', async (e) => {
+  const file = e.target.files[0];
+  e.target.value = '';
+  if (!file) return;
+  let next = null;
+  try {
+    next = sanitize(JSON.parse(await file.text()));
+  } catch { /* handled below */ }
+  if (!next) { toast('That file is not a valid board export.'); return; }
+  if (!confirm('Replace the current board with the imported one? You can undo this.')) return;
+  commit(() => { state = next; }, 'Board imported');
+});
+
+document.addEventListener('keydown', (e) => {
+  const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName) || dlg.open;
+  if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z' && !typing) {
+    e.preventDefault();
+    undo();
+  } else if (!typing && !e.ctrlKey && !e.metaKey && !e.altKey) {
+    if (e.key === '/') { e.preventDefault(); $('search').focus(); }
+    else if (e.key === 'n') {
+      e.preventDefault();
+      addingIn = state.columns[0].id;
+      render();
+    }
+  }
+});
+
+// stay in sync with other tabs
+window.addEventListener('storage', (e) => {
+  if (e.key !== KEY || dlg.open) return;
+  state = load();
+  render();
+});
+
+render();
+})();
diff --git a/board/index.html b/board/index.html
new file mode 100644
index 0000000..85af676
--- /dev/null
+++ b/board/index.html
@@ -0,0 +1,58 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Kanban</title>
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<header class="top">
+  <h1>Kanban</h1>
+  <input id="search" type="search" placeholder="Search cards  ( / )" aria-label="Search cards">
+  <div class="spacer"></div>
+  <button id="undo" type="button" title="Undo (Ctrl/Cmd+Z)" disabled>Undo</button>
+  <button id="export" type="button">Export</button>
+  <button id="import" type="button">Import</button>
+  <input id="file" type="file" accept="application/json,.json" hidden>
+</header>
+
+<main id="board" class="board" aria-label="Board"></main>
+
+<dialog id="dlg">
+  <form id="form" method="dialog">
+    <label>Title
+      <input id="f-title" required maxlength="200" autocomplete="off">
+    </label>
+    <label>Notes
+      <textarea id="f-notes" rows="5" maxlength="5000"></textarea>
+    </label>
+    <div class="row">
+      <label>Priority
+        <select id="f-priority">
+          <option value="none">None</option>
+          <option value="low">Low</option>
+          <option value="med">Medium</option>
+          <option value="high">High</option>
+        </select>
+      </label>
+      <label>Due
+        <input id="f-due" type="date">
+      </label>
+      <label>Column
+        <select id="f-col"></select>
+      </label>
+    </div>
+    <div class="actions">
+      <button type="button" id="f-delete" class="danger">Delete</button>
+      <div class="spacer"></div>
+      <button type="button" id="f-cancel">Cancel</button>
+      <button type="submit" class="primary">Save</button>
+    </div>
+  </form>
+</dialog>
+
+<div id="toast" role="status" aria-live="polite" hidden></div>
+<script src="app.js"></script>
+</body>
+</html>
diff --git a/board/style.css b/board/style.css
new file mode 100644
index 0000000..e994131
--- /dev/null
+++ b/board/style.css
@@ -0,0 +1,90 @@
+:root {
+  --bg: #f3f4f6; --col: #e5e7eb; --card: #fff; --text: #111827; --muted: #6b7280;
+  --line: #d1d5db; --accent: #2563eb; --danger: #dc2626;
+  --high: #dc2626; --med: #f59e0b; --low: #16a34a;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #111318; --col: #1c1f27; --card: #262a35; --text: #e5e7eb; --muted: #9ca3af;
+    --line: #3a3f4d; --accent: #60a5fa; --danger: #f87171;
+  }
+}
+* { box-sizing: border-box; }
+html, body { height: 100%; margin: 0; }
+body {
+  display: flex; flex-direction: column;
+  background: var(--bg); color: var(--text);
+  font: 14px/1.4 system-ui, -apple-system, "Segoe UI", sans-serif;
+}
+button, input, select, textarea { font: inherit; color: inherit; }
+button {
+  background: var(--card); border: 1px solid var(--line); border-radius: 6px;
+  padding: 5px 10px; cursor: pointer;
+}
+button:hover:not(:disabled) { border-color: var(--accent); }
+button:disabled { opacity: .45; cursor: default; }
+button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
+button.danger { color: var(--danger); }
+input, select, textarea {
+  background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 6px 8px;
+}
+:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
+.spacer { flex: 1; }
+
+.top { display: flex; gap: 8px; align-items: center; padding: 10px 16px; border-bottom: 1px solid var(--line); }
+.top h1 { font-size: 18px; margin: 0 8px 0 0; }
+#search { width: 240px; max-width: 40vw; }
+
+.board {
+  flex: 1; min-height: 0; display: flex; gap: 12px; align-items: flex-start;
+  padding: 16px; overflow-x: auto;
+}
+.col {
+  flex: 0 0 290px; max-height: 100%; display: flex; flex-direction: column;
+  background: var(--col); border-radius: 10px; padding: 8px;
+}
+.col-head { display: flex; align-items: center; gap: 6px; padding: 2px 4px 8px; cursor: grab; }
+.col-title { flex: 1; font-weight: 600; overflow-wrap: anywhere; }
+.col-head input { flex: 1; font-weight: 600; }
+.count { color: var(--muted); font-size: 12px; }
+.icon { padding: 0 6px; border: 0; background: none; color: var(--muted); }
+.icon:hover:not(:disabled) { color: var(--danger); }
+.cards { flex: 1; min-height: 40px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; padding: 2px; }
+.card {
+  background: var(--card); border: 1px solid var(--line); border-left: 4px solid transparent;
+  border-radius: 8px; padding: 8px 10px; cursor: pointer; box-shadow: 0 1px 2px rgba(0,0,0,.08);
+}
+.card:hover { border-color: var(--accent); }
+.card.p-high { border-left-color: var(--high); }
+.card.p-med { border-left-color: var(--med); }
+.card.p-low { border-left-color: var(--low); }
+.card.dragging { opacity: .4; }
+.card-title { overflow-wrap: anywhere; white-space: pre-wrap; }
+.meta { display: flex; gap: 8px; margin-top: 4px; font-size: 12px; color: var(--muted); }
+.due.overdue { color: var(--danger); font-weight: 600; }
+.due.today { color: var(--med); font-weight: 600; }
+.ph { height: 36px; border: 2px dashed var(--accent); border-radius: 8px; flex: 0 0 auto; }
+.col.ph { width: 290px; height: 80px; background: none; border-radius: 10px; }
+.add { margin-top: 8px; text-align: left; background: none; border: 0; color: var(--muted); }
+.add:hover:not(:disabled) { color: var(--text); }
+.add-form { margin-top: 8px; display: flex; flex-direction: column; gap: 6px; }
+.add-form textarea { resize: vertical; }
+.add-form .btns { display: flex; gap: 6px; }
+.add-col { flex: 0 0 290px; border: 1px dashed var(--line); background: none; color: var(--muted); padding: 10px; }
+.empty { color: var(--muted); font-size: 12px; text-align: center; padding: 8px; }
+
+dialog { border: 1px solid var(--line); border-radius: 10px; background: var(--bg); color: var(--text); width: min(480px, 92vw); padding: 16px; }
+dialog::backdrop { background: rgba(0,0,0,.45); }
+dialog form { display: flex; flex-direction: column; gap: 12px; }
+dialog label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--muted); flex: 1; }
+dialog label > * { font-size: 14px; color: var(--text); }
+dialog .row { display: flex; gap: 8px; }
+dialog .actions { display: flex; gap: 8px; }
+
+#toast {
+  position: fixed; left: 50%; bottom: 20px; transform: translateX(-50%);
+  background: #111827; color: #fff; padding: 8px 14px; border-radius: 8px;
+  display: flex; gap: 12px; align-items: center; box-shadow: 0 4px 12px rgba(0,0,0,.3);
+}
+#toast[hidden] { display: none; }
+#toast button { background: none; border: 0; color: #93c5fd; padding: 0; font-weight: 600; }
