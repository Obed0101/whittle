+$('#helpBtn').onclick = () => $('#helpDlg').showModal();
+
+$('#exportBtn').onclick = () => {
+  const blob = new Blob([JSON.stringify({ app: 'kanban', version: VERSION, exported: new Date().toISOString(), boards: S.boards }, null, 2)], { type: 'application/json' });
+  const a = h('a', { href: URL.createObjectURL(blob), download: `kanban-${today()}.json` });
+  document.body.append(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
+};
+$('#importBtn').onclick = () => $('#importFile').click();
+$('#importFile').onchange = async e => {
+  const file = e.target.files[0]; e.target.value = ''; if (!file) return;
+  try {
+    const d = JSON.parse(await file.text());
+    const src = Array.isArray(d.boards) ? d.boards : (d && Array.isArray(d.columns) ? [d] : null);
+    if (!src || !src.length) throw 0;
+    const boards = src.map(cleanBoard).map(b => ({ ...b, id: uid() }));
+    commit(() => { S.boards.push(...boards); S.active = boards[0].id; }, `Imported ${boards.length} board${boards.length > 1 ? 's' : ''}`);
+  } catch (err) { toast('That file is not a valid Kanban export.', false, true); }
+};
+
+const themes = ['auto', 'light', 'dark'];
+function applyTheme(t) {
+  document.documentElement.dataset.theme = t; $('#themeBtn').textContent = 'Theme: ' + t;
+  try { localStorage.setItem(THEME_KEY, t); } catch (e) {}
+}
+$('#themeBtn').onclick = () => applyTheme(themes[(themes.indexOf(document.documentElement.dataset.theme) + 1) % 3]);
+
+document.addEventListener('keydown', e => {
+  const inField = e.target.closest('input,textarea,select');
+  if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z' && !inField && !document.querySelector('dialog[open]')) {
+    e.preventDefault(); e.shiftKey ? redo() : undo();
+  } else if (!inField && !e.ctrlKey && !e.metaKey && !e.altKey && !document.querySelector('dialog[open]')) {
+    if (e.key === '/') { e.preventDefault(); $('#search').focus(); }
+    else if (e.key === '?') $('#helpDlg').showModal();
+    else if (e.key === 'n') { const c = board().columns[0]; if (c) { e.preventDefault(); adding = c.id; render(); } }
+  }
+});
+window.addEventListener('storage', e => {
+  if (e.key !== KEY) return;
+  S = load(); hist = []; fut = []; render();
+});
+
+/* ---------- pointer drag ---------- */
+let drag = null, ghost = null, marker = null, last = { x: 0, y: 0 }, ticker = null, target = null, suppress = false;
+const boardEl = $('#board');
+function beginDrag() {
+  const r = drag.el.getBoundingClientRect();
+  ghost = drag.el.cloneNode(true); ghost.removeAttribute('tabindex'); ghost.classList.add('ghost');
+  ghost.style.width = r.width + 'px'; drag.dx = drag.sx - r.left; drag.dy = drag.sy - r.top;
+  document.body.append(ghost); drag.el.classList.add('dragging');
+  marker = h('div', { class: 'marker' }); drag.on = true;
+  ticker = setInterval(dragTick, 30); dragTick();
+}
+function dragTick() {
+  if (!drag || !drag.on) return;
+  ghost.style.left = last.x - drag.dx + 'px'; ghost.style.top = last.y - drag.dy + 'px';
+  const br = boardEl.getBoundingClientRect();
+  if (last.x < br.left + 50) boardEl.scrollLeft -= 14; else if (last.x > br.right - 50) boardEl.scrollLeft += 14;
+  const colEl = document.elementFromPoint(last.x, last.y);
+  const col = colEl && colEl.closest('.col');
+  if (!col) { marker.remove(); target = null; return; }
+  const list = col.querySelector('.cards'), lr = list.getBoundingClientRect();
+  if (last.y < lr.top + 30) list.scrollTop -= 10; else if (last.y > lr.bottom - 30) list.scrollTop += 10;
+  const before = [...list.querySelectorAll('.card:not(.dragging)')].find(c => { const r = c.getBoundingClientRect(); return last.y < r.top + r.height / 2; });
+  if (before) list.insertBefore(marker, before); else list.append(marker);
+  target = { col: col.dataset.id, before: before ? before.dataset.id : null };
+}
+function endDrag(drop) {
+  if (!drag) return;
+  clearTimeout(drag.timer); clearInterval(ticker);
+  const was = drag.on, id = drag.id; drag = null;
+  if (!was) return;
+  ghost.remove(); marker.remove();
+  suppress = true; setTimeout(() => { suppress = false; }, 0);
+  if (drop && target) moveCard(id, target.col, target.before); else render();
+  target = null;
+}
+boardEl.addEventListener('pointerdown', e => {
+  if (e.button !== 0 || e.target.closest('input,textarea,button,select')) return;
+  const el = e.target.closest('.card'); if (!el) return;
+  drag = { id: el.dataset.id, el, sx: e.clientX, sy: e.clientY, on: false, touch: e.pointerType === 'touch' };
+  last = { x: e.clientX, y: e.clientY };
+  if (drag.touch) drag.timer = setTimeout(() => { if (drag && !drag.on) beginDrag(); }, 280);
+});
+window.addEventListener('pointermove', e => {
+  if (!drag) return;
+  last = { x: e.clientX, y: e.clientY };
+  if (drag.on) { dragTick(); return; }
+  const d = Math.hypot(e.clientX - drag.sx, e.clientY - drag.sy);
+  if (drag.touch) { if (d > 8) endDrag(false); } else if (d > 5) beginDrag();
+});
+window.addEventListener('pointerup', () => endDrag(true));
+window.addEventListener('pointercancel', () => endDrag(false));
+window.addEventListener('touchmove', e => { if (drag && drag.on) e.preventDefault(); }, { passive: false });
+window.addEventListener('keydown', e => { if (e.key === 'Escape' && drag && drag.on) endDrag(false); });
+
+/* ---------- start ---------- */
+S = load();
+let th = 'auto'; try { th = localStorage.getItem(THEME_KEY) || 'auto'; } catch (e) {}
+applyTheme(themes.includes(th) ? th : 'auto');
+render();
+})();
diff --git a/board/index.html b/board/index.html
new file mode 100644
index 0000000..977d49c
--- /dev/null
+++ b/board/index.html
@@ -0,0 +1,118 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>Kanban</title>
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<header class="bar">
+  <div class="group">
+    <label class="sr" for="boardSel">Board</label>
+    <select id="boardSel"></select>
+    <button id="boardNew" type="button">+ Board</button>
+    <button id="boardRename" type="button">Rename</button>
+    <button id="boardDel" type="button">Delete</button>
+  </div>
+  <div class="group">
+    <input id="search" type="search" placeholder="Search cards (/)" aria-label="Search cards">
+    <select id="labelFilter" aria-label="Filter by label"></select>
+    <button id="undo" type="button">Undo</button>
+    <button id="redo" type="button">Redo</button>
+    <button id="labelsBtn" type="button">Labels</button>
+    <button id="archiveBtn" type="button">Archive</button>
+    <button id="exportBtn" type="button">Export</button>
+    <button id="importBtn" type="button">Import</button>
+    <input id="importFile" type="file" accept="application/json,.json" hidden>
+    <button id="themeBtn" type="button">Theme</button>
+    <button id="helpBtn" type="button" aria-label="Help and shortcuts">?</button>
+  </div>
+</header>
+<main id="board" aria-label="Board"></main>
+<div id="toast" role="status" aria-live="polite"></div>
+
+<dialog id="cardDlg">
+  <form id="cardForm" class="dlg">
+    <h2>Card</h2>
+    <label>Title <input id="cTitle" required maxlength="300"></label>
+    <label>Description <textarea id="cDesc" rows="5"></textarea></label>
+    <div class="row">
+      <label>Column <select id="cCol"></select></label>
+      <label>Priority <select id="cPri"><option value="">None</option><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option></select></label>
+      <label>Due <input id="cDue" type="date"></label>
+    </div>
+    <fieldset><legend>Labels</legend><div id="cLabels" class="chips"></div></fieldset>
+    <fieldset><legend>Checklist</legend>
+      <div id="cList"></div>
+      <div class="row"><input id="cNewItem" placeholder="Add item" aria-label="New checklist item"><button id="cAddItem" type="button">Add</button></div>
+    </fieldset>
+    <div class="foot">
+      <button id="cDelete" type="button" class="danger">Delete</button>
+      <button id="cArchive" type="button">Archive</button>
+      <span class="spacer"></span>
+      <button type="button" data-close>Cancel</button>
+      <button type="submit" class="primary">Save</button>
+    </div>
+  </form>
+</dialog>
+
+<dialog id="colDlg">
+  <form id="colForm" class="dlg">
+    <h2>Column</h2>
+    <label>Name <input id="colName" required maxlength="80"></label>
+    <label>Work-in-progress limit (0 = none) <input id="colWip" type="number" min="0" max="999"></label>
+    <div class="row">
+      <button id="colLeft" type="button">Move left</button>
+      <button id="colRight" type="button">Move right</button>
+      <button id="colArchive" type="button">Archive all cards</button>
+    </div>
+    <div class="foot">
+      <button id="colDelete" type="button" class="danger">Delete column</button>
+      <span class="spacer"></span>
+      <button type="button" data-close>Cancel</button>
+      <button type="submit" class="primary">Save</button>
+    </div>
+  </form>
+</dialog>
+
+<dialog id="labelsDlg">
+  <div class="dlg">
+    <h2>Labels</h2>
+    <div id="labelList"></div>
+    <div class="foot"><button id="labelAdd" type="button">Add label</button><span class="spacer"></span><button type="button" data-close class="primary">Done</button></div>
+  </div>
+</dialog>
+
+<dialog id="archiveDlg">
+  <div class="dlg">
+    <h2>Archive</h2>
+    <div id="archiveList"></div>
+    <div class="foot"><button id="archiveEmpty" type="button" class="danger">Empty archive</button><span class="spacer"></span><button type="button" data-close class="primary">Close</button></div>
+  </div>
+</dialog>
+
+<dialog id="askDlg">
+  <form id="askForm" class="dlg">
+    <h2 id="askTitle"></h2>
+    <label><span class="sr">Name</span><input id="askInput" required maxlength="80"></label>
+    <div class="foot"><span class="spacer"></span><button type="button" data-close>Cancel</button><button type="submit" class="primary">OK</button></div>
+  </form>
+</dialog>
+
+<dialog id="helpDlg">
+  <div class="dlg">
+    <h2>Shortcuts</h2>
+    <ul>
+      <li><kbd>/</kbd> search · <kbd>n</kbd> new card in first column · <kbd>?</kbd> this help</li>
+      <li><kbd>Ctrl/⌘ Z</kbd> undo · <kbd>Ctrl/⌘ Shift Z</kbd> redo</li>
+      <li>On a focused card: <kbd>Enter</kbd> open · <kbd>Alt</kbd>+arrows move · <kbd>Delete</kbd> delete</li>
+      <li>Drag cards with mouse, or press and hold on touch screens. You can also change a card's column in its editor.</li>
+      <li>Data is saved in this browser. Use Export regularly to keep a backup file.</li>
+    </ul>
+    <div class="foot"><span class="spacer"></span><button type="button" data-close class="primary">Close</button></div>
+  </div>
+</dialog>
+<script src="app.js"></script>
+</body>
+</html>
diff --git a/board/style.css b/board/style.css
new file mode 100644
index 0000000..f654370
--- /dev/null
+++ b/board/style.css
@@ -0,0 +1,75 @@
+:root{--bg:#f3f4f7;--panel:#e6e8ee;--card:#fff;--text:#1c2030;--muted:#667;--line:#cfd3dd;--accent:#2f6fed;--danger:#d12a3a;--warn:#b7791f;--ok:#1f8f55;color-scheme:light}
+:root[data-theme=dark]{--bg:#14161c;--panel:#1d2029;--card:#272b36;--text:#e8eaf0;--muted:#9aa1b2;--line:#3a3f4d;--accent:#6b9bff;--danger:#ff6b78;--warn:#e8b45a;--ok:#4cc88a;color-scheme:dark}
+@media(prefers-color-scheme:dark){:root[data-theme=auto]{--bg:#14161c;--panel:#1d2029;--card:#272b36;--text:#e8eaf0;--muted:#9aa1b2;--line:#3a3f4d;--accent:#6b9bff;--danger:#ff6b78;--warn:#e8b45a;--ok:#4cc88a;color-scheme:dark}}
+*{box-sizing:border-box}
+html,body{height:100%;margin:0}
+body{display:flex;flex-direction:column;background:var(--bg);color:var(--text);font:15px/1.4 system-ui,-apple-system,Segoe UI,sans-serif}
+.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
+button,select,input,textarea{font:inherit;color:inherit;background:var(--card);border:1px solid var(--line);border-radius:6px;padding:5px 9px}
+button{cursor:pointer}
+button:hover:not(:disabled){border-color:var(--accent)}
+button:disabled{opacity:.45;cursor:default}
+button.primary{background:var(--accent);border-color:var(--accent);color:#fff}
+button.danger{color:var(--danger)}
+:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
+.bar{display:flex;flex-wrap:wrap;gap:8px 16px;justify-content:space-between;padding:8px 12px;border-bottom:1px solid var(--line);background:var(--panel)}
+.group{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
+#search{width:180px}
+#board{flex:1;display:flex;gap:12px;align-items:flex-start;overflow-x:auto;padding:12px;scroll-snap-type:x proximity}
+.col{flex:0 0 290px;max-height:100%;display:flex;flex-direction:column;background:var(--panel);border-radius:10px;scroll-snap-align:start}
+.col header{display:flex;align-items:center;gap:6px;padding:8px 8px 4px 12px}
+.col h2{flex:1;margin:0;font-size:15px;min-width:0}
+.col h2 button{border:0;background:none;padding:2px 0;font-weight:700;text-align:left;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.count{color:var(--muted);font-size:13px}
+.count.over{color:var(--danger);font-weight:700}
+.col header>button{border:0;background:none;padding:2px 8px}
+.cards{flex:1;overflow-y:auto;padding:4px 8px;min-height:40px;display:flex;flex-direction:column;gap:8px}
+.empty{color:var(--muted);font-size:13px;text-align:center;padding:10px}
+.card{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:8px 10px;cursor:grab;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;word-break:break-word;box-shadow:0 1px 2px #0002}
+.card:hover{border-color:var(--accent)}
+.card.dragging{opacity:.35}
+.ghost{position:fixed;z-index:50;pointer-events:none;opacity:.92;transform:rotate(2deg);box-shadow:0 8px 20px #0005}
+.marker{height:4px;border-radius:2px;background:var(--accent);flex:none}
+.card .t{white-space:pre-wrap}
+.meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px;font-size:12px;color:var(--muted)}
+.meta .overdue{color:var(--danger);font-weight:600}.meta .today{color:var(--warn);font-weight:600}.meta .ok{color:var(--ok)}
+.pri{text-transform:capitalize;font-weight:600}.pri.high{color:var(--danger)}.pri.medium{color:var(--warn)}
+.chips{display:flex;flex-wrap:wrap;gap:4px}
+.chip{font-size:11px;padding:1px 7px;border-radius:9px;color:#fff;font-weight:600}
+.card .chips{margin-bottom:5px}
+.add{padding:8px}
+.add>button{width:100%;text-align:left;border-style:dashed;color:var(--muted)}
+.add textarea{width:100%;resize:vertical}
+.add .row{margin-top:6px}
+.newcol{flex:0 0 290px}
+.newcol>button{width:100%;border-style:dashed}
+.newcol form{background:var(--panel);padding:8px;border-radius:10px;display:flex;flex-direction:column;gap:6px}
+.big{margin:auto;text-align:center;color:var(--muted)}
+.note{padding:4px 12px;color:var(--muted);font-size:13px}
+#toast{position:fixed;left:50%;bottom:16px;transform:translateX(-50%);z-index:100;display:flex;flex-direction:column;gap:6px;align-items:center;pointer-events:none}
+.toast{pointer-events:auto;background:var(--text);color:var(--bg);padding:8px 14px;border-radius:8px;display:flex;gap:12px;align-items:center;box-shadow:0 4px 14px #0004}
+.toast button{background:none;border:1px solid currentColor;padding:2px 8px}
+.toast.err{background:var(--danger);color:#fff}
+dialog{border:1px solid var(--line);border-radius:12px;background:var(--bg);color:var(--text);padding:0;width:min(560px,94vw);max-height:92vh}
+dialog::backdrop{background:#0008}
+.dlg{display:flex;flex-direction:column;gap:12px;padding:16px}
+.dlg h2{margin:0;font-size:18px}
+.dlg label{display:flex;flex-direction:column;gap:4px;font-size:13px;color:var(--muted)}
+.dlg label input,.dlg label textarea,.dlg label select{color:var(--text)}
+.dlg fieldset{border:1px solid var(--line);border-radius:8px;display:flex;flex-direction:column;gap:6px}
+.dlg .row{display:flex;gap:8px;flex-wrap:wrap}
+.dlg .row>*{flex:1}
+.foot{display:flex;gap:8px;flex-wrap:wrap}
+.spacer{flex:1}
+.chips label{flex-direction:row;align-items:center;gap:4px;color:var(--text)}
+.item{display:flex;gap:6px;align-items:center;margin-bottom:4px}
+.item input[type=text]{flex:1}
+.item.done input[type=text]{text-decoration:line-through;color:var(--muted)}
+.lrow{display:flex;gap:6px;margin-bottom:6px}.lrow input{flex:1}
+.arow{display:flex;gap:6px;align-items:center;padding:6px 0;border-bottom:1px solid var(--line)}
+.arow span{flex:1;word-break:break-word}
+kbd{background:var(--card);border:1px solid var(--line);border-radius:4px;padding:0 4px;font-size:12px}
+li{margin-bottom:6px}
+@media(max-width:600px){#board{padding:8px;gap:8px}.col,.newcol{flex-basis:84vw}#search{width:130px}}
+@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important;scroll-behavior:auto!important}.ghost{transform:none}}
+@media print{.bar,#toast{display:none}#board{overflow:visible;flex-wrap:wrap}}
