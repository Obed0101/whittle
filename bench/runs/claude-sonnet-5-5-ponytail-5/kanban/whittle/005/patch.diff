+  drawCl();
+  const newItem = h('input', { placeholder: 'Add checklist item', 'aria-label': 'New checklist item' });
+  const addItem = () => { if (newItem.value.trim()) { c.checklist.push({ id: uid(), text: newItem.value.trim(), done: false }); newItem.value = ''; drawCl(); } newItem.focus(); };
