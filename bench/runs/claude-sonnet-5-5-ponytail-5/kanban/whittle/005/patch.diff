+'use strict';
+const KEY = 'kanban.v1', VERSION = 1;
+const COLORS = ['#2563eb', '#16a34a', '#d97706', '#dc2626', '#7c3aed', '#0891b2', '#db2777', '#4b5563'];
+const PRI = ['None', 'Low', 'Medium', 'High'];
+const $ = s => document.querySelector(s);
+const uid = () => Math.random().toString(36).slice(2, 10) + Date.now().toString(36).slice(-4);
+const today = () => { const d = new Date(); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); };
+
+function h(tag, attrs, ...kids) {
+  const e = document.createElement(tag);
+  for (const k in attrs || {}) {
+    const v = attrs[k];
+    if (k.startsWith('on')) e.addEventListener(k.slice(2), v);
+    else if (k === 'class') e.className = v;
+    else if (v === true) e.setAttribute(k, '');
+    else if (v !== false && v != null) e.setAttribute(k, v);
+  }
+  for (const c of kids.flat()) if (c != null && c !== false) e.append(c.nodeType ? c : String(c));
+  return e;
+}
+
+function newBoard(name) {
+  const lbl = n => ({ id: uid(), name: n[0], color: n[1] });
+  return {
+    id: uid(), name,
+    labels: [lbl(['Bug', COLORS[3]]), lbl(['Feature', COLORS[0]]), lbl(['Chore', COLORS[7]])],
+    columns: ['To do', 'Doing', 'Done'].map(n => ({ id: uid(), name: n, wip: 0, cards: [] })),
+    archive: []
+  };
+}
+
+function normalize(s) {
+  if (!s || !Array.isArray(s.boards) || !s.boards.length) throw new Error('Not a board file');
+  s.boards.forEach(b => {
+    b.id = b.id || uid(); b.name = String(b.name || 'Board');
+    b.labels = Array.isArray(b.labels) ? b.labels : [];
+    b.archive = Array.isArray(b.archive) ? b.archive : [];
+    b.columns = Array.isArray(b.columns) ? b.columns : [];
+    b.columns.forEach(c => { c.id = c.id || uid(); c.name = String(c.name || ''); c.wip = +c.wip || 0; c.cards = Array.isArray(c.cards) ? c.cards : []; });
+  });
+  s.version = VERSION;
+  s.theme = ['auto', 'light', 'dark'].includes(s.theme) ? s.theme : 'auto';
+  if (!s.boards.some(b => b.id === s.current)) s.current = s.boards[0].id;
+  return s;
+}
+
+let state, undo = [], redo = [], filter = { q: '', label: '' }, dragId = null;
+function load() {
+  try { const r = localStorage.getItem(KEY); if (r) return normalize(JSON.parse(r)); } catch (e) { }
+  const b = newBoard('My board');
+  return { version: VERSION, boards: [b], current: b.id, theme: 'auto' };
+}
+function save() {
+  try { localStorage.setItem(KEY, JSON.stringify(state)); }
+  catch (e) { toast('Could not save: browser storage unavailable or full. Export a backup.'); }
+}
+const board = () => state.boards.find(b => b.id === state.current);
+const snap = () => JSON.stringify({ boards: state.boards, current: state.current });
+function mutate(fn, msg, undoable = true) {
+  if (undoable) { undo.push(snap()); if (undo.length > 100) undo.shift(); redo = []; }
+  fn(); save(); render();
+  if (msg) toast(msg, undoable ? ['Undo', doUndo] : null);
+}
+function restore(s) { const o = JSON.parse(s); state.boards = o.boards; state.current = o.current; save(); render(); }
+function doUndo() { if (!undo.length) return; redo.push(snap()); restore(undo.pop()); }
+function doRedo() { if (!redo.length) return; undo.push(snap()); restore(redo.pop()); }
+
+function toast(msg, action) {
+  const t = h('div', { class: 'toast' }, msg, action && h('button', { onclick() { action[1](); t.remove(); } }, action[0]));
+  $('#toast').append(t);
+  setTimeout(() => t.remove(), 6000);
+}
+
+function findCard(id) {
+  for (const col of board().columns) { const i = col.cards.findIndex(c => c.id === id); if (i >= 0) return { col, i, card: col.cards[i] }; }
+}
+function matches(c) {
+  if (filter.label && !c.labels.includes(filter.label)) return false;
+  const q = filter.q.trim().toLowerCase();
+  if (!q) return true;
+  return (c.title + ' ' + c.desc + ' ' + c.checklist.map(x => x.text).join(' ')).toLowerCase().includes(q);
+}
+function moveCard(id, toColId, idx) {
+  const f = findCard(id); if (!f) return;
+  const to = board().columns.find(c => c.id === toColId);
+  mutate(() => {
+    f.col.cards.splice(f.i, 1);
+    if (f.col === to && idx > f.i) idx--;
+    to.cards.splice(Math.max(0, Math.min(idx, to.cards.length)), 0, f.card);
+    f.card.updated = Date.now();
+  });
+}
+
+function render() {
+  document.documentElement.dataset.theme = state.theme;
+  const b = board();
+  const bs = $('#boardSel'); bs.replaceChildren(...state.boards.map(x => h('option', { value: x.id, selected: x.id === b.id }, x.name)));
+  const lf = $('#labelFilter');
+  if (filter.label && !b.labels.some(l => l.id === filter.label)) filter.label = '';
+  lf.replaceChildren(h('option', { value: '' }, 'All labels'), ...b.labels.map(l => h('option', { value: l.id, selected: l.id === filter.label }, l.name)));
+  $('#undoBtn').disabled = !undo.length; $('#redoBtn').disabled = !redo.length;
+  const focusId = document.activeElement && document.activeElement.dataset && document.activeElement.dataset.card;
+  const el = $('#board'), sl = el.scrollLeft;
+  el.replaceChildren(...b.columns.map(colEl),
+    h('div', { class: 'newcol' }, h('button', { class: 'add', onclick: () => columnDialog(null) }, '+ Add column')));
+  el.scrollLeft = sl;
+  if (focusId) { const n = el.querySelector(`[data-card="${focusId}"]`); if (n) n.focus(); }
+}
+
+function colEl(col) {
+  const b = board();
+  const shown = col.cards.filter(matches);
+  const full = col.wip && col.cards.length > col.wip;
+  const list = h('div', { class: 'cards', role: 'list', 'aria-label': col.name });
+  shown.forEach(c => list.append(cardEl(c, col)));
+  if (!shown.length) list.append(h('div', { class: 'empty' }, col.cards.length ? 'No matching cards' : 'No cards yet'));
+  const node = h('section', { class: 'col', 'aria-label': col.name },
+    h('div', { class: 'colhead' },
+      h('h2', null, col.name),
+      h('span', { class: 'count' + (full ? ' full' : ''), title: col.wip ? 'WIP limit ' + col.wip : '' }, col.cards.length + (col.wip ? '/' + col.wip : '')),
+      h('button', { 'aria-label': 'Column options for ' + col.name, onclick: () => columnDialog(col) }, '⋯')),
+    list,
+    h('button', { class: 'add', onclick: () => cardDialog(null, col.id) }, '+ Add card'));
+  node.addEventListener('dragover', e => {
+    if (!dragId) return; e.preventDefault(); node.classList.add('over');
+  });
+  node.addEventListener('dragleave', e => { if (!node.contains(e.relatedTarget)) node.classList.remove('over'); });
+  node.addEventListener('drop', e => {
+    e.preventDefault(); node.classList.remove('over');
+    if (!dragId) return;
+    const kids = [...list.querySelectorAll('.card')].filter(k => k.dataset.card !== dragId);
+    let idx = kids.length;
+    for (let i = 0; i < kids.length; i++) {
+      const r = kids[i].getBoundingClientRect();
+      if (e.clientY < r.top + r.height / 2) { idx = i; break; }
+    }
+    // map visible index to real index
+    const vis = kids.map(k => k.dataset.card);
+    const real = col.cards.map(c => c.id).filter(id => id !== dragId);
+    const target = idx < vis.length ? real.indexOf(vis[idx]) : real.length;
+    const f = findCard(dragId);
+    const adj = f && f.col === col && f.i < target ? 1 : 0; // moveCard compensates
+    moveCard(dragId, col.id, target + adj);
+    dragId = null;
+  });
+  return node;
+}
+
+function cardEl(c, col) {
+  const b = board();
+  const done = c.checklist.filter(x => x.done).length;
+  const last = b.columns[b.columns.length - 1] === col;
+  const meta = [];
+  if (c.due) meta.push(h('span', { class: !last && c.due < today() ? 'overdue' : '' }, (!last && c.due < today() ? 'Overdue · ' : 'Due ') + c.due));
+  if (c.priority) meta.push(h('span', null, PRI[c.priority] + ' priority'));
+  if (c.checklist.length) meta.push(h('span', null, `☑ ${done}/${c.checklist.length}`));
+  if (c.desc) meta.push(h('span', null, '≡'));
+  const labels = c.labels.map(id => b.labels.find(l => l.id === id)).filter(Boolean);
+  const n = h('div', { class: 'card pri-' + c.priority, role: 'listitem', tabindex: '0', draggable: 'true', 'data-card': c.id,
+    'aria-label': c.title + (c.due ? ', due ' + c.due : '') + (c.priority ? ', ' + PRI[c.priority] + ' priority' : '') + '. Enter to edit, Alt+arrows to move.' },
+    h('div', { class: 't' }, c.title),
+    labels.length ? h('div', { class: 'meta' }, labels.map(l => h('span', { class: 'chip', style: 'background:' + l.color }, l.name))) : null,
+    meta.length ? h('div', { class: 'meta' }, meta) : null);
+  n.addEventListener('dragstart', e => { dragId = c.id; e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', c.id); setTimeout(() => n.classList.add('dragging'), 0); });
+  n.addEventListener('dragend', () => { dragId = null; n.classList.remove('dragging'); document.querySelectorAll('.over').forEach(x => x.classList.remove('over')); });
+  n.addEventListener('click', () => cardDialog(c.id));
+  n.addEventListener('keydown', e => {
+    if (e.key === 'Enter') { e.preventDefault(); cardDialog(c.id); return; }
+    if (!e.altKey) return;
+    const cols = b.columns, f = findCard(c.id);
+    const ci = cols.indexOf(f.col);
+    if (e.key === 'ArrowUp' && f.i > 0) moveCard(c.id, f.col.id, f.i - 1);
+    else if (e.key === 'ArrowDown' && f.i < f.col.cards.length - 1) moveCard(c.id, f.col.id, f.i + 2);
+    else if (e.key === 'ArrowLeft' && ci > 0) moveCard(c.id, cols[ci - 1].id, Math.min(f.i, cols[ci - 1].cards.length));
+    else if (e.key === 'ArrowRight' && ci < cols.length - 1) moveCard(c.id, cols[ci + 1].id, Math.min(f.i, cols[ci + 1].cards.length));
+    else return;
+    e.preventDefault();
+  });
+  return n;
+}
