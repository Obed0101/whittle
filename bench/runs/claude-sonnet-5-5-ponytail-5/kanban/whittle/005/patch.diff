+/* ---------- wiring ---------- */
+state = load();
+$('#boardSel').addEventListener('change', e => { state.current = e.target.value; save(); render(); });
+$('#search').addEventListener('input', e => { filter.q = e.target.value; render(); });
+$('#labelFilter').addEventListener('change', e => { filter.label = e.target.value; render(); });
+$('#undoBtn').addEventListener('click', doUndo);
+$('#redoBtn').addEventListener('click', doRedo);
+$('#menuBtn').addEventListener('click', menuDialog);
+$('#importFile').addEventListener('change', e => {
+  const file = e.target.files[0]; e.target.value = '';
