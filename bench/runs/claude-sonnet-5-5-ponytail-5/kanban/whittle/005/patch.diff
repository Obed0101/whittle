+    h('input', { type: 'checkbox', checked: it.done, 'aria-label': 'Done', style: 'flex:0 0 auto', onchange: e => it.done = e.target.checked }),
+    h('input', { value: it.text, 'aria-label': 'Checklist item', oninput: e => it.text = e.target.value }),
