+  file.text().then(txt => {
+    const s = normalize(JSON.parse(txt));
+    mutate(() => { state.boards = s.boards; state.current = s.current; state.theme = s.theme; }, 'Backup imported');
+  }).catch(err => toast('Import failed: ' + err.message));
+});
+window.addEventListener('storage', e => { if (e.key === KEY && e.newValue) { try { state = normalize(JSON.parse(e.newValue)); render(); } catch (x) { } } });
+document.addEventListener('keydown', e => {
+  const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName) || $('#dlg').open;
+  if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z' && !typing) { e.preventDefault(); e.shiftKey ? doRedo() : doUndo(); }
+  else if (typing || e.ctrlKey || e.metaKey || e.altKey) return;
+  else if (e.key === '/') { e.preventDefault(); $('#search').focus(); }
+  else if (e.key === '?') helpDialog();
+  else if (e.key.toLowerCase() === 'n' && board().columns.length) { e.preventDefault(); cardDialog(null, board().columns[0].id); }
+});
+render();
