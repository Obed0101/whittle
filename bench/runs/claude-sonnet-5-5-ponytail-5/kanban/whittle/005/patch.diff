+  const lbls = h('div', { class: 'row' }, b.labels.length ? b.labels.map(l =>
+    h('label', { class: 'chk' }, h('input', { type: 'checkbox', checked: c.labels.includes(l.id), onchange(e) {
+      c.labels = e.target.checked ? [...c.labels, l.id] : c.labels.filter(x => x !== l.id);
+    } }), h('span', { class: 'chip', style: 'background:' + l.color }, l.name))) : h('span', { class: 'count' }, 'No labels yet. Create some in Menu → Labels.'));
+  const cl = h('ul', { class: 'list' });
