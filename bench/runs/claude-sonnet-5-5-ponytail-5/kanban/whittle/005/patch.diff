diff --git a/board/style.css b/board/style.css
new file mode 100644
index 0000000..76e09d6
--- /dev/null
+++ b/board/style.css
@@ -0,0 +1,55 @@
+:root{--bg:#f3f4f6;--panel:#e5e7eb;--card:#fff;--text:#111827;--muted:#6b7280;--accent:#2563eb;--border:#d1d5db;--danger:#dc2626;color-scheme:light}
+:root[data-theme=dark]{--bg:#111318;--panel:#1c1f26;--card:#262a33;--text:#e5e7eb;--muted:#9ca3af;--accent:#60a5fa;--border:#3a3f4b;--danger:#f87171;color-scheme:dark}
+@media(prefers-color-scheme:dark){:root[data-theme=auto]{--bg:#111318;--panel:#1c1f26;--card:#262a33;--text:#e5e7eb;--muted:#9ca3af;--accent:#60a5fa;--border:#3a3f4b;--danger:#f87171;color-scheme:dark}}
+*{box-sizing:border-box}
+html,body{height:100%;margin:0}
+body{display:flex;flex-direction:column;background:var(--bg);color:var(--text);font:15px/1.4 system-ui,sans-serif}
+button,input,select,textarea{font:inherit;color:inherit;background:var(--card);border:1px solid var(--border);border-radius:6px;padding:6px 10px}
+button{cursor:pointer}button:hover{border-color:var(--accent)}
+button.primary{background:var(--accent);color:#fff;border-color:var(--accent)}
+button.danger{color:var(--danger)}
+button:disabled{opacity:.45;cursor:default}
+:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
+.bar{display:flex;gap:8px;padding:10px;flex-wrap:wrap;align-items:center;border-bottom:1px solid var(--border);background:var(--panel)}
+.grow{flex:1}
+#search{min-width:160px;flex:0 1 260px}
+#board{flex:1;display:flex;gap:12px;padding:12px;overflow:auto;align-items:flex-start}
+.col{flex:0 0 290px;max-height:100%;display:flex;flex-direction:column;background:var(--panel);border-radius:10px;padding:8px}
+.col.over{outline:2px dashed var(--accent)}
+.col h2{font-size:15px;margin:0;flex:1;overflow:hidden;text-overflow:ellipsis}
+.colhead{display:flex;align-items:center;gap:6px;padding:2px 2px 8px}
+.count{color:var(--muted);font-size:13px}.count.full{color:var(--danger);font-weight:600}
+.cards{overflow:auto;display:flex;flex-direction:column;gap:8px;min-height:24px;padding:2px}
+.card{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:8px 10px;cursor:grab;overflow-wrap:anywhere}
+.card:hover{border-color:var(--accent)}
+.card.dragging{opacity:.4}
+.card .t{font-weight:500}
+.meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;font-size:12px;color:var(--muted)}
+.chip{padding:0 7px;border-radius:10px;color:#fff;font-size:12px}
+.overdue{color:var(--danger);font-weight:600}
+.pri-3{border-left:4px solid #dc2626}.pri-2{border-left:4px solid #f59e0b}.pri-1{border-left:4px solid #3b82f6}
+.add{margin-top:8px;text-align:left;background:transparent;border-style:dashed}
+.empty{color:var(--muted);font-size:13px;padding:6px;text-align:center}
+.newcol{flex:0 0 200px}
+dialog{border:1px solid var(--border);border-radius:12px;background:var(--bg);color:var(--text);width:min(560px,94vw);max-height:90vh;padding:16px}
+dialog::backdrop{background:rgba(0,0,0,.45)}
+dialog form{display:flex;flex-direction:column;gap:10px}
+dialog h3{margin:0}
+label{display:flex;flex-direction:column;gap:3px;font-size:13px;color:var(--muted)}
+label input,label select,label textarea{color:var(--text)}
+.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
+.row>*{flex:1}.row>button{flex:0 0 auto}
+.chk{flex-direction:row;align-items:center;color:var(--text);gap:8px}
+.chk input{flex:0 0 auto}
+.actions{display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap}
+.actions .left{margin-right:auto;display:flex;gap:8px}
+#toast{position:fixed;left:50%;bottom:16px;transform:translateX(-50%);display:flex;flex-direction:column;gap:6px;z-index:10}
+.toast{background:var(--text);color:var(--bg);padding:8px 14px;border-radius:8px;display:flex;gap:12px;align-items:center}
+.toast button{background:transparent;color:var(--accent);border:0;padding:0;font-weight:600}
+ul.list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px}
+@media(max-width:640px){
+  #board{scroll-snap-type:x mandatory;padding:8px}
+  .col{flex-basis:86vw;scroll-snap-align:center}
+  #search{flex:1 1 100%}
+}
+@media(prefers-reduced-motion:no-preference){.card{transition:border-color .15s,opacity .15s}}
