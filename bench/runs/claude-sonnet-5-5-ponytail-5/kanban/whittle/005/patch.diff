+        h('button', { type: 'button', class: 'danger', onclick() { mutate(() => f.col.cards.splice(f.i, 1), 'Card deleted'); closeDlg(); } }, 'Delete')) : null,
+      h('button', { type: 'button', onclick: closeDlg }, 'Cancel'),
