+        h('button', { class: 'danger', onclick: () => { commit(() => delete b.cards[c.id]); draw(); } }, 'Delete')))
+        : h('p', { class: 'count' }, 'Nothing archived.'),
+      h('div', { class: 'row end' }, h('button', { class: 'primary', onclick: () => dlg.close() }, 'Close')));
+  };
+  draw(); dlg.showModal();
+}
+
+/* ---------- import / export ---------- */
+function exportData() {
+  const a = h('a', { href: URL.createObjectURL(new Blob([JSON.stringify(S, null, 2)], { type: 'application/json' })), download: 'kanban-' + todayStr() + '.json' });
+  document.body.append(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
+}
+function importData(file) {
+  const r = new FileReader();
+  r.onload = () => {
+    try {
+      const d = migrate(JSON.parse(r.result));
+      commit(() => { S.boards = d.boards; S.active = d.active; ui.q = ''; ui.label = ''; $('search').value = ''; }, 'Imported ' + d.boards.length + ' board(s).');
+    } catch { toast('That file is not a valid board export.'); }
+  };
+  r.readAsText(file);
+}
+
+/* ---------- wiring ---------- */
+function init() {
+  S = load(); save(); render();
+  const closeMenus = () => document.querySelectorAll('.bar details[open]').forEach(d => d.removeAttribute('open'));
+  const menuBtn = (id, fn) => $(id).addEventListener('click', () => { closeMenus(); fn(); });
+  $('boardSel').onchange = e => { S.active = e.target.value; ui.adding = null; save(); render(); };
+  $('newBoard').onclick = async () => { const n = await ask('New board name'); if (n) commit(() => { const b = newBoard(n); S.boards.push(b); S.active = b.id; }); };
+  menuBtn('renameBoard', async () => { const n = await ask('Rename board', board().name); if (n) commit(() => board().name = n); });
+  menuBtn('deleteBoard', () => {
+    if (S.boards.length < 2) return;
+    const b = board();
+    commit(() => { S.boards = S.boards.filter(x => x !== b); S.active = S.boards[0].id; }, 'Board "' + b.name + '" deleted.');
+  });
+  menuBtn('labelsBtn', openLabels); menuBtn('archiveBtn', openArchive); menuBtn('exportBtn', exportData);
+  menuBtn('importBtn', () => $('file').click()); menuBtn('helpBtn', () => $('helpDlg').showModal());
+  $('file').onchange = e => { if (e.target.files[0]) importData(e.target.files[0]); e.target.value = ''; };
+  $('search').oninput = e => { ui.q = e.target.value.trim(); render(); };
+  $('labelFilter').onchange = e => { ui.label = e.target.value; render(); };
+  $('undo').onclick = doUndo; $('redo').onclick = doRedo;
+  $('theme').onclick = () => { S.theme = { auto: 'light', light: 'dark', dark: 'auto' }[S.theme]; save(); render(); };
+  document.addEventListener('keydown', e => {
+    const mod = e.ctrlKey || e.metaKey, typing = /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName) || document.querySelector('dialog[open]');
+    if (mod && e.key.toLowerCase() === 'z' && !typing) { e.preventDefault(); e.shiftKey ? doRedo() : doUndo(); }
+    else if (!mod && !typing && e.key === '/') { e.preventDefault(); $('search').focus(); }
+    else if (!mod && !typing && e.key === 'n') { e.preventDefault(); ui.adding = board().columns[0].id; render(); }
+  });
+  document.addEventListener('click', e => { if (!e.target.closest('details')) closeMenus(); });
+  window.addEventListener('storage', e => {
+    if (e.key !== KEY || !e.newValue) return;
+    try { S = migrate(JSON.parse(e.newValue)); render(); } catch {}
+  });
+}
+init();
+})();
diff --git a/board/index.html b/board/index.html
new file mode 100644
index 0000000..b7fbf37
--- /dev/null
+++ b/board/index.html
@@ -0,0 +1,67 @@
+<!DOCTYPE html>
+<html lang="en" data-theme="auto">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="color-scheme" content="light dark">
+<title>Kanban</title>
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<header class="bar">
+  <label class="sr" for="boardSel">Board</label>
+  <select id="boardSel"></select>
+  <button id="newBoard" title="New board">+ Board</button>
+  <input id="search" type="search" placeholder="Search cards ( / )" aria-label="Search cards">
+  <label class="sr" for="labelFilter">Filter by label</label>
+  <select id="labelFilter"></select>
+  <span class="grow"></span>
+  <button id="undo" title="Undo (Ctrl/Cmd+Z)" aria-label="Undo">↶</button>
+  <button id="redo" title="Redo (Ctrl/Cmd+Shift+Z)" aria-label="Redo">↷</button>
+  <button id="theme" title="Theme"></button>
+  <details class="menu right">
+    <summary aria-label="More">⋯</summary>
+    <div class="pop">
+      <button id="renameBoard">Rename board</button>
+      <button id="deleteBoard">Delete board</button>
+      <button id="labelsBtn">Manage labels</button>
+      <button id="archiveBtn">Archive</button>
+      <button id="exportBtn">Export JSON</button>
+      <button id="importBtn">Import JSON</button>
+      <button id="helpBtn">Shortcuts</button>
+    </div>
+  </details>
+  <input id="file" type="file" accept="application/json,.json" hidden>
+</header>
+<div id="banner" role="alert" hidden></div>
+<main id="board" aria-label="Board"></main>
+<div id="toast" role="status" aria-live="polite" hidden></div>
+
+<dialog id="cardDlg" aria-label="Card"></dialog>
+<dialog id="askDlg">
+  <form method="dialog" id="askForm">
+    <h2 id="askTitle"></h2>
+    <input id="askInput" required>
+    <div class="row end"><button value="cancel" formnovalidate>Cancel</button><button class="primary" value="ok">OK</button></div>
+  </form>
+</dialog>
+<dialog id="listDlg" aria-label="Dialog"></dialog>
+<dialog id="helpDlg">
+  <form method="dialog">
+    <h2>Shortcuts</h2>
+    <dl>
+      <dt>n</dt><dd>Add a card to the first column</dd>
+      <dt>/</dt><dd>Search</dd>
+      <dt>Ctrl/Cmd + Z</dt><dd>Undo</dd>
+      <dt>Ctrl/Cmd + Shift + Z</dt><dd>Redo</dd>
+      <dt>Enter</dt><dd>Open the focused card</dd>
+      <dt>Alt + ← → ↑ ↓</dt><dd>Move the focused card</dd>
+      <dt>Delete</dt><dd>Delete the focused card (undoable)</dd>
+    </dl>
+    <p>Everything is saved automatically in this browser. Use Export to back up or move your data.</p>
+    <div class="row end"><button class="primary">Close</button></div>
+  </form>
+</dialog>
+<script src="app.js"></script>
+</body>
+</html>
diff --git a/board/style.css b/board/style.css
new file mode 100644
index 0000000..03bb2b4
--- /dev/null
+++ b/board/style.css
@@ -0,0 +1,70 @@
+:root{--bg:#f4f5f7;--panel:#e6e8ec;--card:#fff;--text:#1d2330;--muted:#667085;--line:#d0d5dd;--accent:#2f6fed;--danger:#d92d20;--warn:#b54708;color-scheme:light}
+@media(prefers-color-scheme:dark){:root[data-theme=auto]{--bg:#12151c;--panel:#1c212b;--card:#262c38;--text:#e8eaf0;--muted:#98a2b3;--line:#3a4252;--accent:#6f9bff;--danger:#ff6b61;--warn:#fdb022;color-scheme:dark}}
+:root[data-theme=dark]{--bg:#12151c;--panel:#1c212b;--card:#262c38;--text:#e8eaf0;--muted:#98a2b3;--line:#3a4252;--accent:#6f9bff;--danger:#ff6b61;--warn:#fdb022;color-scheme:dark}
+*{box-sizing:border-box}
+html,body{height:100%;margin:0}
+body{display:flex;flex-direction:column;background:var(--bg);color:var(--text);font:14px/1.4 system-ui,-apple-system,Segoe UI,sans-serif}
+button,input,select,textarea{font:inherit;color:inherit}
+button,select,input,textarea{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:6px 10px}
+button{cursor:pointer}button:hover:not(:disabled){border-color:var(--accent)}button:disabled{opacity:.4;cursor:default}
+button.primary{background:var(--accent);border-color:var(--accent);color:#fff}
+button.danger{color:var(--danger)}
+button.ghost{border-color:transparent;background:transparent;padding:4px 7px}
+:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
+.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
+.bar{display:flex;gap:8px;align-items:center;padding:8px 12px;background:var(--panel);border-bottom:1px solid var(--line);flex-wrap:wrap}
+.grow{flex:1}
+#search{min-width:0;width:200px}
+.menu{position:relative}.menu summary{list-style:none;cursor:pointer;padding:6px 10px;border:1px solid var(--line);border-radius:6px;background:var(--card)}
+.menu summary::-webkit-details-marker{display:none}
+.pop{position:absolute;z-index:20;min-width:170px;background:var(--card);border:1px solid var(--line);border-radius:8px;padding:4px;display:flex;flex-direction:column;box-shadow:0 8px 24px #0004;top:100%;margin-top:4px;left:0}
+.menu.right .pop{left:auto;right:0}
+.pop button{border:0;text-align:left;background:transparent}.pop button:hover{background:var(--panel)}
+#banner{background:var(--warn);color:#fff;padding:8px 12px}
+#board{flex:1;display:flex;gap:12px;padding:12px;overflow:auto;align-items:flex-start}
+.col{flex:0 0 280px;max-height:100%;display:flex;flex-direction:column;background:var(--panel);border-radius:10px;border:1px solid var(--line)}
+.col.over{border-color:var(--accent)}
+.col-h{display:flex;align-items:center;gap:6px;padding:8px 8px 4px 12px}
+.col-h h2{font-size:14px;margin:0;flex:1;overflow-wrap:anywhere}
+.count{color:var(--muted);font-size:12px}.count.full{color:var(--danger);font-weight:600}
+.cards{list-style:none;margin:0;padding:6px 8px;overflow-y:auto;display:flex;flex-direction:column;gap:8px;min-height:24px}
+.card{background:var(--card);border:1px solid var(--line);border-left:4px solid var(--line);border-radius:8px;padding:8px 10px;cursor:pointer;overflow-wrap:anywhere}
+.card:hover{border-color:var(--accent)}
+.card.dragging{opacity:.4}
+.card.p-low{border-left-color:#30a46c}.card.p-med{border-left-color:#e5a50a}.card.p-high{border-left-color:var(--danger)}
+.card .t{white-space:pre-wrap}
+.chips,.meta{display:flex;flex-wrap:wrap;gap:4px;margin-top:4px}
+.chip{font-size:11px;color:#fff;border-radius:10px;padding:1px 8px}
+.meta{color:var(--muted);font-size:12px;gap:10px}
+.meta .late{color:var(--danger);font-weight:600}
+.drop-line{height:3px;background:var(--accent);border-radius:2px;flex:none}
+.empty{color:var(--muted);text-align:center;padding:8px;font-size:12px;list-style:none}
+.add{padding:6px 8px 8px}
+.add button.open{width:100%;text-align:left;border-color:transparent;background:transparent;color:var(--muted)}
+.add textarea,.newcol input{width:100%;resize:vertical}
+.row{display:flex;gap:6px;margin-top:6px;align-items:center}.row.end{justify-content:flex-end}
+.newcol{flex:0 0 280px;display:flex;gap:6px}
+.nomatch{padding:24px;color:var(--muted)}
+dialog{background:var(--bg);color:var(--text);border:1px solid var(--line);border-radius:12px;padding:16px;width:min(560px,94vw);max-height:90vh}
+dialog::backdrop{background:#0008}
+dialog h2{margin:0 0 10px;font-size:16px}
+dialog label{display:block;margin-top:10px;font-weight:600;font-size:12px;color:var(--muted)}
+dialog input:not([type=checkbox]):not([type=color]),dialog textarea,dialog select{width:100%;display:block;margin-top:4px}
+dialog textarea{min-height:90px;resize:vertical}
+.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}
+.pick{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}
+.pick label{display:flex;gap:4px;align-items:center;margin:0;font-weight:400;color:var(--text)}
+.check{display:flex;gap:6px;align-items:center;margin-top:4px}.check input[type=text]{flex:1}
+.check .done{text-decoration:line-through;color:var(--muted)}
+.item{display:flex;gap:8px;align-items:center;padding:6px 0;border-bottom:1px solid var(--line)}.item .grow{overflow-wrap:anywhere}
+dl{display:grid;grid-template-columns:auto 1fr;gap:4px 14px}dt{font-weight:600}dd{margin:0}
+#toast{position:fixed;left:50%;bottom:16px;transform:translateX(-50%);background:var(--text);color:var(--bg);padding:8px 14px;border-radius:8px;display:flex;gap:12px;align-items:center;z-index:50;max-width:92vw}
+#toast button{background:transparent;color:inherit;border-color:currentColor;padding:2px 8px}
+@media(max-width:640px){
+ .col{flex-basis:84vw;scroll-snap-align:center}
+ #board{scroll-snap-type:x mandatory}
+ .newcol{flex-basis:84vw}
+ #search{width:100%;order:5;flex:1 0 100%}
+ .two{grid-template-columns:1fr}
+}
+@media(prefers-reduced-motion:no-preference){.card{transition:border-color .15s,opacity .15s}}
