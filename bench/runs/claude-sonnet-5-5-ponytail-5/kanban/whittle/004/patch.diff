+    for (const c of b.columns || []) nb.columns.push({ id: String(c.id || uid()), name: String(c.name || 'Column'), cards: (c.cards || []).map(card) });
+    for (const a of b.archive || []) nb.archive.push({ card: card(a.card || a), from: String(a.from || '') });
+    if (!nb.columns.length) nb.columns.push({ id: uid(), name: 'To do', cards: [] });
