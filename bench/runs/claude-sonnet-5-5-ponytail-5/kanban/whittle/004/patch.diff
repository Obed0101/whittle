+  return out;
+}
+function load() {
+  let raw = null;
+  try { raw = localStorage.getItem(KEY); if (raw) return normalize(JSON.parse(raw)); } catch (e) {
+    try { localStorage.setItem(KEY + '.corrupt', raw); } catch (_) { }
+  }
+  const b = newBoard('My board');
+  return { version: VERSION, boards: [b], current: b.id, theme: 'auto' };
+}
+
+let state = load();
+let undoS = [], redoS = [];
