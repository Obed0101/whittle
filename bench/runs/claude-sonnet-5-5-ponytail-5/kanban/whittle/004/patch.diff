+'use strict';
+const KEY = 'kanban.v1', VERSION = 1;
+const COLORS = ['#e5484d', '#f76b15', '#c98a00', '#30a46c', '#0091ff', '#8e4ec6', '#6e6e80'];
+const uid = () => Math.random().toString(36).slice(2, 10) + Date.now().toString(36).slice(-4);
+const $ = s => document.querySelector(s);
+const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+const today = () => { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; };
+const addDays = n => { const d = new Date(); d.setDate(d.getDate() + n); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; };
+
+function newBoard(name) {
+  return {
+    id: uid(), name,
+    columns: ['To do', 'In progress', 'Done'].map(n => ({ id: uid(), name: n, cards: [] })),
+    labels: [['Bug', 0], ['Feature', 4], ['Idea', 5]].map(([n, c]) => ({ id: uid(), name: n, color: COLORS[c] })),
