@@ -0,0 +1,68 @@
+:root{--bg:#f4f5f7;--col:#e9ebef;--card:#fff;--fg:#1d2330;--mut:#667085;--bd:#d0d5dd;--acc:#2563eb;--danger:#d92d20;--sh:0 1px 2px rgba(0,0,0,.12)}
+:root[data-theme=dark]{--bg:#12151c;--col:#1b1f29;--card:#252a37;--fg:#e6e8ee;--mut:#9aa3b5;--bd:#3a4152;--acc:#6ea0ff;--danger:#ff6b61;--sh:0 1px 2px rgba(0,0,0,.5)}
+@media(prefers-color-scheme:dark){:root[data-theme=auto]{--bg:#12151c;--col:#1b1f29;--card:#252a37;--fg:#e6e8ee;--mut:#9aa3b5;--bd:#3a4152;--acc:#6ea0ff;--danger:#ff6b61;--sh:0 1px 2px rgba(0,0,0,.5)}}
+*{box-sizing:border-box}
+html,body{height:100%;margin:0}
+body{display:flex;flex-direction:column;background:var(--bg);color:var(--fg);font:15px/1.4 system-ui,-apple-system,Segoe UI,sans-serif}
+button,input,select,textarea{font:inherit;color:inherit}
+button,select,input,textarea{background:var(--card);border:1px solid var(--bd);border-radius:6px;padding:6px 10px}
+button{cursor:pointer}
+button:hover{border-color:var(--acc)}
+button.primary{background:var(--acc);color:#fff;border-color:var(--acc)}
+button.danger{color:var(--danger)}
+button.ghost{border-color:transparent;background:transparent}
+:focus-visible{outline:2px solid var(--acc);outline-offset:1px}
+.sr{position:absolute;left:-9999px}
+header{display:flex;gap:8px;align-items:center;padding:8px 12px;flex-wrap:wrap;border-bottom:1px solid var(--bd);background:var(--col)}
+header input[type=search]{min-width:0;width:200px}
+.grow{flex:1}
+.chk{display:flex;gap:4px;align-items:center;white-space:nowrap}
+.chk input{width:auto}
+main{flex:1;display:flex;gap:12px;padding:12px;overflow-x:auto;align-items:flex-start;scroll-snap-type:x proximity}
+.col{background:var(--col);border-radius:10px;width:290px;flex:none;max-height:100%;display:flex;flex-direction:column;scroll-snap-align:start;padding:8px}
+.col.over{outline:2px dashed var(--acc)}
+.col-h{display:flex;gap:2px;align-items:center;margin-bottom:6px}
+.col-h .name{flex:1;min-width:0;font-weight:600;background:transparent;border-color:transparent;padding:4px 6px}
+.col-h .name:hover,.col-h .name:focus{border-color:var(--bd);background:var(--card)}
+.count{color:var(--mut);font-size:13px;padding:0 4px}
+.col-h button{padding:2px 6px}
+.cards{overflow-y:auto;display:flex;flex-direction:column;gap:8px;min-height:24px;padding:2px}
+.card{background:var(--card);border-radius:8px;padding:8px 10px;box-shadow:var(--sh);cursor:grab;border:1px solid transparent;word-break:break-word}
+.card:hover{border-color:var(--bd)}
+.card.drag{opacity:.4}
+.card.before{box-shadow:0 -3px 0 var(--acc)}
+.card.done .t{text-decoration:line-through;color:var(--mut)}
+.chips{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:4px}
+.chip{font-size:12px;color:#fff;border-radius:10px;padding:0 8px}
+.meta{display:flex;gap:10px;font-size:12px;color:var(--mut);margin-top:4px;flex-wrap:wrap}
+.meta .od{color:var(--danger);font-weight:600}
+.p-high{border-left:4px solid #e5484d}.p-med{border-left:4px solid #f5a524}.p-low{border-left:4px solid #30a46c}
+.add{margin-top:6px;text-align:left;border-color:transparent;background:transparent;color:var(--mut)}
+.add:hover{background:var(--card)}
+.addform textarea{width:100%;resize:vertical;min-height:60px;margin-top:6px}
+.row{display:flex;gap:8px;align-items:center;margin-top:8px}
+.row.end{justify-content:flex-end}
+.empty{color:var(--mut);text-align:center;padding:40px 20px;margin:auto}
+.colempty{color:var(--mut);font-size:13px;text-align:center;padding:8px}
+.newcol{flex:none;width:290px}
+dialog{border:1px solid var(--bd);border-radius:12px;background:var(--bg);color:var(--fg);width:min(560px,94vw);max-height:90vh;padding:16px}
+dialog::backdrop{background:rgba(0,0,0,.45)}
+dialog h2{margin:0 0 10px;font-size:18px}
+dialog label{display:block;font-weight:600;font-size:13px;margin-top:10px}
+dialog input:not([type=checkbox]),dialog textarea,dialog select{width:100%;margin-top:4px}
+.lbls{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px}
+.lbls label{display:flex;gap:4px;align-items:center;margin:0;font-weight:400;color:#fff;padding:2px 8px;border-radius:12px}
+.lbls input{width:auto;margin:0}
+.ci,.li{display:flex;gap:6px;align-items:center;margin-top:4px}
+.ci input[type=checkbox]{width:auto}
+.ci .ct{flex:1}
+.ci.done .ct{text-decoration:line-through;color:var(--mut)}
+.li input[type=color]{width:44px;padding:0;height:34px;flex:none}
+.li input[type=text]{flex:1}
+.menu button{display:block;width:100%;text-align:left;margin-top:6px}
+.arch{display:flex;gap:6px;align-items:center;margin-top:6px}.arch span{flex:1}
+#toast{position:fixed;left:50%;bottom:16px;transform:translateX(-50%);background:#222;color:#fff;padding:8px 14px;border-radius:8px;display:none;gap:12px;align-items:center;z-index:99}
+#toast.show{display:flex}
+#toast button{background:transparent;color:#8ab4ff;border:0;padding:0}
+@media(max-width:700px){.col,.newcol{width:86vw}header input[type=search]{width:100%;flex:1 1 100%}}
+@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important;scroll-behavior:auto!important}}
