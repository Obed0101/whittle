+    for (const l of b.labels || []) nb.labels.push({ id: String(l.id || uid()), name: String(l.name || ''), color: String(l.color || COLORS[6]) });
+    const card = c => ({
+      id: String(c.id || uid()), title: String(c.title || 'Untitled'), desc: String(c.desc || ''),
+      labels: (c.labels || []).map(String), due: /^\d{4}-\d\d-\d\d$/.test(c.due) ? c.due : '',
