+function moveCard(id, toCol, idx) {
+  commit(() => {
+    const f = find(id); if (!f) return;
+    f.col.cards.splice(f.i, 1);
+    const dest = f.b.columns.find(c => c.id === toCol);
+    if (idx == null || idx > dest.cards.length) idx = dest.cards.length;
+    dest.cards.splice(idx, 0, f.card); f.card.updated = Date.now();
+  });
