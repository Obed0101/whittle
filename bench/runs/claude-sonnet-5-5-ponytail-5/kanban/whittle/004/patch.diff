+    if (m === 'close') d.close();
+    else if (m === 'back') main();
+    else if (m === 'labels') labels();
+    else if (m === 'archive') archive();
+    else if (m === 'nl') { commit(() => b.labels.push({ id: uid(), name: 'New label', color: COLORS[b.labels.length % COLORS.length] })); labels(); }
+    else if (m === 'dl') { const id = e.target.closest('.li').dataset.id; commit(() => { b.labels = b.labels.filter(l => l.id !== id); b.columns.forEach(c => c.cards.forEach(k => k.labels = k.labels.filter(x => x !== id))); }); labels(); }
+    else if (m === 'restore') { commit(() => { const a = b.archive.splice(i, 1)[0]; b.columns[0].cards.push(a.card); }); archive(); }
+    else if (m === 'purge') { commit(() => b.archive.splice(i, 1)); archive(); }
+    else if (m === 'theme') { state.theme = { auto: 'light', light: 'dark', dark: 'auto' }[state.theme]; save(); render(); main(); }
+    else if (m === 'rename') { d.close(); const n = await ask('Rename board', b.name); if (n) commit(() => b.name = n); }
+    else if (m === 'delete') {
+      if (state.boards.length === 1) return toast('You need at least one board.');
+      if (!confirm(`Delete board "${b.name}" with all its cards? You can undo.`)) return;
+      d.close(); commit(() => { state.boards = state.boards.filter(x => x !== b); state.current = state.boards[0].id; }, 'Board deleted');
+    }
+    else if (m === 'export') {
+      const a = document.createElement('a');
+      a.href = URL.createObjectURL(new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' }));
+      a.download = `kanban-${today()}.json`; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
+    }
+    else if (m === 'import') $('#importFile').click();
+  };
+  d.oninput = e => {
+    const li = e.target.closest('.li'); if (!li) return;
+    const l = b.labels.find(x => x.id === li.dataset.id);
+    l.name = li.querySelector('[type=text]').value; l.color = li.querySelector('[type=color]').value; save(); render();
+  };
+  main(); d.showModal();
+}
+$('#menuBtn').onclick = menu;
+$('#importFile').onchange = async e => {
+  const f = e.target.files[0]; e.target.value = ''; if (!f) return;
+  try {
+    const s = normalize(JSON.parse(await f.text()));
+    if (!confirm('Replace all current boards with the imported data? You can undo.')) return;
+    $('#menuDlg').close();
+    commit(() => { state.boards = s.boards; state.current = s.current; state.theme = s.theme; }, 'Imported');
+  } catch (err) { toast('Import failed: ' + err.message); }
+};
+window.addEventListener('storage', e => { if (e.key === KEY) { state = load(); render(); } });
+
+render();
