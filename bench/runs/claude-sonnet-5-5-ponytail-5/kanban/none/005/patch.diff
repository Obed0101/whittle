+  renderChecklist();
+
+  const form = h('form', { class: 'dlg', method: 'dialog' },
+    h('label', {}, 'Title', title),
+    h('div', { class: 'grid' },
+      h('label', {}, 'Column', colSel),
+      h('label', {}, 'Priority', prio),
+      h('label', {}, 'Due date', h('div', { style: 'display:flex;gap:6px' }, due, h('button', { type: 'button', class: 'ghost', title: 'Clear date', onclick: () => { due.value = ''; } }, '✕'))),
+      h('label', {}, 'Labels', labels, datalist)),
+    h('label', {}, 'Description', desc),
+    h('label', {}, 'Checklist', bar, ckBox, newItem),
+    h('div', { class: 'muted' }, 'Created ' + new Date(card.created).toLocaleString() +
+      (card.completed ? ' · Completed ' + new Date(card.completed).toLocaleString() : '')),
+    h('div', { class: 'actions' },
+      h('div', { class: 'left' },
+        h('button', { type: 'button', class: 'danger', onclick: () => { if (confirm('Permanently delete this card?')) { dlg.close(); deleteCard(id); } } }, 'Delete'),
+        h('button', { type: 'button', onclick: () => { dlg.close(); archiveCard(id); } }, 'Archive')),
+      h('button', { type: 'button', onclick: () => dlg.close() }, 'Cancel'),
+      h('button', { class: 'primary' }, 'Save')));
+
+  form.addEventListener('submit', () => {
+    const t = title.value.trim();
+    if (!t) return;
+    commit(() => {
+      const c = state.cards[id];
+      c.title = t; c.desc = desc.value; c.priority = prio.value; c.due = due.value;
+      c.labels = parseLabels(labels.value);
+      c.checklist = w.checklist.filter((i) => i.text.trim());
+      c.updated = Date.now();
+      const to = findCol(colSel.value);
+      if (to && to !== col) {
+        col.cards.splice(col.cards.indexOf(id), 1);
+        to.cards.push(id);
+        c.completed = to.done ? Date.now() : 0;
+      }
+    });
+  });
+  title.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); form.requestSubmit(); } });
+  dlg.replaceChildren(form);
+  dlg.showModal();
+  title.focus();
+}
+
+// ---------- archive ----------
+function openArchive() {
+  const dlg = $('#dlg-archive');
+  const draw = () => {
+    const items = state.archive.map((c, i) => h('div', { class: 'arch-item' },
+      h('span', { class: 't' }, c.title),
+      h('button', { onclick: () => {
+        commit(() => {
+          const col = state.columns[0];
+          state.archive.splice(i, 1);
+          state.cards[c.id] = c; col.cards.push(c.id);
+        });
+        draw();
+      } }, 'Restore'),
+      h('button', { class: 'danger', onclick: () => {
+        if (!confirm('Permanently delete “' + c.title + '”?')) return;
+        commit(() => { state.archive.splice(i, 1); });
+        draw();
+      } }, 'Delete')));
+    dlg.replaceChildren(h('div', { class: 'dlg' },
+      h('h2', {}, 'Archive (' + state.archive.length + ')'),
+      state.archive.length ? h('div', { class: 'arch-list' }, items) : h('p', { class: 'muted' }, 'No archived cards. Archive finished cards to keep the board clear without losing them.'),
+      h('div', { class: 'actions' },
+        state.archive.length ? h('div', { class: 'left' }, h('button', { class: 'danger', onclick: () => {
+          if (!confirm('Permanently delete all ' + state.archive.length + ' archived cards?')) return;
+          commit(() => { state.archive = []; }); draw();
+        } }, 'Empty archive')) : null,
+        h('button', { class: 'primary', onclick: () => dlg.close() }, 'Close'))));
+  };
+  draw();
+  dlg.showModal();
+}
+
+// ---------- data ----------
+function openData() {
+  const dlg = $('#dlg-data');
+  const file = h('input', { type: 'file', accept: 'application/json,.json', hidden: true,
+    onchange: async () => {
+      const f = file.files[0];
+      if (!f) return;
+      try {
+        const next = sanitize(JSON.parse(await f.text()));
+        if (!confirm('Replace the current board with “' + f.name + '”? You can undo this.')) return;
+        dlg.close();
+        commit(() => { state = next; });
+        toast('Board imported', 'Undo', undo);
+      } catch (e) { alert('Import failed: ' + e.message); }
+      file.value = '';
+    } });
+  dlg.replaceChildren(h('div', { class: 'dlg' },
+    h('h2', {}, 'Your data'),
+    h('p', { class: 'muted' }, 'Everything is stored in this browser only. Export a backup regularly, and to move the board to another browser or computer.'),
+    h('div', { class: 'actions', style: 'justify-content:flex-start' },
+      h('button', { onclick: exportData }, 'Export JSON'),
+      h('button', { onclick: () => file.click() }, 'Import JSON…'), file),
+    h('div', { class: 'actions' },
+      h('div', { class: 'left' }, h('button', { class: 'danger', onclick: () => {
+        if (!confirm('Erase the whole board, including the archive? You can undo this.')) return;
+        dlg.close(); commit(() => { state = defaultState(); });
+      } }, 'Reset board')),
+      h('button', { class: 'primary', onclick: () => dlg.close() }, 'Close'))));
+  dlg.showModal();
+}
+function exportData() {
+  const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
+  const a = h('a', { href: URL.createObjectURL(blob), download: 'kanban-' + todayStr() + '.json' });
+  document.body.append(a); a.click(); a.remove();
+  setTimeout(() => URL.revokeObjectURL(a.href), 1000);
+}
+
+// ---------- theme ----------
+function applyTheme(t) {
+  if (t) document.documentElement.dataset.theme = t;
+  else document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
+}
+
+// ---------- init ----------
+function init() {
+  state = load();
+  let theme = null;
+  try { theme = localStorage.getItem(THEME_KEY); } catch (_) {}
+  applyTheme(theme);
+
+  $('#btn-theme').onclick = () => {
+    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
+    applyTheme(next);
+    try { localStorage.setItem(THEME_KEY, next); } catch (_) {}
+  };
+  $('#btn-undo').onclick = undo;
+  $('#btn-redo').onclick = redo;
+  $('#btn-archive').onclick = openArchive;
+  $('#btn-data').onclick = openData;
+  $('#btn-help').onclick = () => $('#dlg-help').showModal();
+  $('#search').oninput = (e) => { filters.q = e.target.value.trim(); render(); };
+  $('#filter-label').onchange = (e) => { filters.label = e.target.value; render(); };
+  $('#filter-due').onchange = (e) => { filters.due = e.target.value; render(); };
+
+  document.addEventListener('keydown', (e) => {
+    const t = e.target;
+    const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) || t.isContentEditable;
+    const open = document.querySelector('dialog[open]');
+    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z' && !typing && !open) { e.preventDefault(); e.shiftKey ? redo() : undo(); return; }
+    if (typing || open || e.ctrlKey || e.metaKey || e.altKey) return;
+    if (e.key === 'n') { e.preventDefault(); openQuick(state.columns[0].id); }
+    else if (e.key === '/') { e.preventDefault(); $('#search').focus(); }
+    else if (e.key === 'z') undo();
+    else if (e.key === 'Z') redo();
+    else if (e.key === '?') $('#dlg-help').showModal();
+  });
+
+  // click backdrop to close dialogs
+  document.querySelectorAll('dialog').forEach((d) => d.addEventListener('mousedown', (e) => { if (e.target === d) d.close(); }));
+
+  // keep tabs in sync
+  window.addEventListener('storage', (e) => {
+    if (e.key !== KEY || !e.newValue) return;
+    try { state = sanitize(JSON.parse(e.newValue)); render(); } catch (_) {}
+  });
+
+  // refresh due-date highlighting after midnight / when returning to tab
+  let day = todayStr();
+  document.addEventListener('visibilitychange', () => { if (!document.hidden && day !== todayStr()) { day = todayStr(); render(); } });
+
+  render();
+}
+
+init();
+})();
diff --git a/board/index.html b/board/index.html
new file mode 100644
index 0000000..909f1bc
--- /dev/null
+++ b/board/index.html
@@ -0,0 +1,55 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Kanban</title>
+<link rel="stylesheet" href="styles.css">
+</head>
+<body>
+<header class="topbar">
+  <h1>Kanban</h1>
+  <input id="search" type="search" placeholder="Search cards ( / )" aria-label="Search cards">
+  <select id="filter-label" aria-label="Filter by label"><option value="">All labels</option></select>
+  <select id="filter-due" aria-label="Filter by due date">
+    <option value="">Any due date</option>
+    <option value="overdue">Overdue</option>
+    <option value="week">Due in 7 days</option>
+    <option value="none">No due date</option>
+  </select>
+  <span class="spacer"></span>
+  <button id="btn-undo" title="Undo (Z)" disabled>Undo</button>
+  <button id="btn-redo" title="Redo (Shift+Z)" disabled>Redo</button>
+  <button id="btn-archive" title="View archived cards">Archive <span id="archive-count"></span></button>
+  <button id="btn-data" title="Export / import">Data</button>
+  <button id="btn-theme" title="Toggle theme" aria-label="Toggle theme">◐</button>
+  <button id="btn-help" title="Keyboard shortcuts" aria-label="Help">?</button>
+</header>
+
+<main id="board" class="board" aria-label="Board"></main>
+
+<div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
+
+<dialog id="dlg-card"></dialog>
+<dialog id="dlg-column"></dialog>
+<dialog id="dlg-archive"></dialog>
+<dialog id="dlg-data"></dialog>
+<dialog id="dlg-help">
+  <form method="dialog" class="dlg">
+    <h2>Keyboard shortcuts</h2>
+    <dl class="keys">
+      <dt>n</dt><dd>Add a card to the first column</dd>
+      <dt>/</dt><dd>Search</dd>
+      <dt>z / Shift+z</dt><dd>Undo / redo (also Ctrl/⌘+Z)</dd>
+      <dt>Enter</dt><dd>Save new card (Shift+Enter for new line)</dd>
+      <dt>Esc</dt><dd>Cancel / close</dd>
+      <dt>Enter on a card</dt><dd>Open card</dd>
+    </dl>
+    <p class="muted">Drag cards between columns, and drag column headers to reorder. On touch devices use the column picker inside a card.</p>
+    <div class="actions"><button class="primary">Close</button></div>
+  </form>
+</dialog>
+
+<script src="app.js"></script>
+</body>
+</html>
diff --git a/board/styles.css b/board/styles.css
new file mode 100644
index 0000000..76719e6
--- /dev/null
+++ b/board/styles.css
@@ -0,0 +1,95 @@
+:root {
+  --bg: #f1f2f6; --col: #e4e6ee; --card: #fff; --text: #1d2130; --muted: #6b7185;
+  --border: #d0d4e0; --accent: #4f6bed; --danger: #d6455d; --warn: #c77d0a; --ok: #2f9e66;
+  --shadow: 0 1px 2px rgba(20,25,50,.12);
+}
+:root[data-theme="dark"] {
+  --bg: #14161d; --col: #1d2029; --card: #272b37; --text: #e6e8f0; --muted: #98a0b5;
+  --border: #383d4d; --accent: #7b92ff; --danger: #ff6b82; --warn: #f0b04a; --ok: #4cc58a;
+  --shadow: 0 1px 2px rgba(0,0,0,.4);
+}
+* { box-sizing: border-box; }
+html, body { height: 100%; margin: 0; }
+body { display: flex; flex-direction: column; background: var(--bg); color: var(--text);
+  font: 14px/1.4 system-ui, -apple-system, "Segoe UI", sans-serif; }
+button, input, select, textarea { font: inherit; color: inherit; }
+button { background: var(--card); border: 1px solid var(--border); border-radius: 6px; padding: 5px 10px; cursor: pointer; }
+button:hover { border-color: var(--accent); }
+button:disabled { opacity: .45; cursor: default; }
+button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
+button.danger { color: var(--danger); }
+button.ghost { background: none; border-color: transparent; color: var(--muted); }
+button.ghost:hover { color: var(--text); background: var(--col); }
+input, select, textarea { background: var(--card); border: 1px solid var(--border); border-radius: 6px; padding: 5px 8px; }
+input:focus, select:focus, textarea:focus, button:focus-visible, .card:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
+textarea { width: 100%; resize: vertical; }
+.muted { color: var(--muted); }
+
+.topbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 10px 14px;
+  background: var(--card); border-bottom: 1px solid var(--border); }
+.topbar h1 { font-size: 18px; margin: 0 8px 0 0; }
+.topbar #search { width: 220px; }
+.spacer { flex: 1; }
+
+.board { flex: 1; display: flex; gap: 12px; padding: 14px; overflow-x: auto; align-items: flex-start; }
+.column { flex: 0 0 290px; max-height: 100%; display: flex; flex-direction: column;
+  background: var(--col); border-radius: 10px; border: 2px solid transparent; }
+.column.drop { border-color: var(--accent); }
+.column.dragging { opacity: .5; }
+.col-head { display: flex; align-items: center; gap: 6px; padding: 10px 10px 6px; cursor: grab; }
+.col-title { font-weight: 600; flex: 1; overflow-wrap: anywhere; }
+.col-count { font-size: 12px; color: var(--muted); background: var(--card); border-radius: 10px; padding: 0 8px; }
+.col-count.over { background: var(--danger); color: #fff; }
+.col-done-mark { color: var(--ok); }
+.cards { overflow-y: auto; padding: 4px 8px; min-height: 24px; display: flex; flex-direction: column; gap: 8px; }
+.card { background: var(--card); border-radius: 8px; padding: 8px 10px; box-shadow: var(--shadow);
+  cursor: pointer; border-left: 4px solid transparent; }
+.card.p-high { border-left-color: var(--danger); }
+.card.p-medium { border-left-color: var(--warn); }
+.card.p-low { border-left-color: var(--ok); }
+.card.dragging { opacity: .4; }
+.card-title { overflow-wrap: anywhere; white-space: pre-wrap; }
+.card-meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; font-size: 12px; color: var(--muted); align-items: center; }
+.badge { padding: 0 6px; border-radius: 4px; background: var(--col); }
+.badge.overdue { background: var(--danger); color: #fff; }
+.badge.soon { background: var(--warn); color: #fff; }
+.badge.complete { background: var(--ok); color: #fff; }
+.label { padding: 0 6px; border-radius: 4px; color: #fff; font-size: 11px; }
+.drop-line { height: 3px; background: var(--accent); border-radius: 2px; flex: none; }
+.col-foot { padding: 8px; }
+.col-foot .add { width: 100%; text-align: left; color: var(--muted); background: none; border-color: transparent; }
+.col-foot .add:hover { background: var(--card); }
+.quick textarea { min-height: 54px; }
+.quick .row { display: flex; gap: 6px; margin-top: 6px; }
+.add-col { flex: 0 0 290px; }
+.add-col button { width: 100%; padding: 10px; border-style: dashed; background: none; color: var(--muted); }
+.empty { text-align: center; color: var(--muted); padding: 6px; font-size: 13px; }
+
+dialog { border: 1px solid var(--border); border-radius: 12px; background: var(--card); color: var(--text);
+  padding: 0; width: min(560px, 94vw); max-height: 92vh; box-shadow: 0 10px 40px rgba(0,0,0,.35); }
+dialog::backdrop { background: rgba(10,12,20,.5); }
+.dlg { padding: 18px; display: flex; flex-direction: column; gap: 12px; }
+.dlg h2 { margin: 0; font-size: 16px; }
+.dlg label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--muted); }
+.dlg label input, .dlg label select, .dlg label textarea { color: var(--text); font-size: 14px; }
+.dlg .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
+.dlg .check { flex-direction: row; align-items: center; gap: 8px; font-size: 14px; color: var(--text); }
+.actions { display: flex; gap: 8px; justify-content: flex-end; align-items: center; flex-wrap: wrap; }
+.actions .left { margin-right: auto; display: flex; gap: 8px; }
+.checklist { display: flex; flex-direction: column; gap: 4px; }
+.ck { display: flex; gap: 6px; align-items: center; }
+.ck input[type=text] { flex: 1; }
+.ck.done input[type=text] { text-decoration: line-through; color: var(--muted); }
+.progress { height: 6px; background: var(--col); border-radius: 3px; overflow: hidden; }
+.progress div { height: 100%; background: var(--ok); }
+.arch-list { overflow: auto; max-height: 60vh; display: flex; flex-direction: column; gap: 6px; }
+.arch-item { display: flex; gap: 8px; align-items: center; padding: 6px 8px; background: var(--col); border-radius: 6px; }
+.arch-item .t { flex: 1; overflow-wrap: anywhere; }
+.keys { display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; margin: 0; }
+.keys dt { font-family: ui-monospace, monospace; background: var(--col); padding: 0 6px; border-radius: 4px; }
+.keys dd { margin: 0; }
+.toast { position: fixed; bottom: 18px; left: 50%; transform: translateX(-50%); background: #23283a; color: #fff;
+  padding: 8px 14px; border-radius: 8px; display: flex; gap: 12px; align-items: center; box-shadow: 0 4px 20px rgba(0,0,0,.4); z-index: 10; }
+.toast[hidden] { display: none; }
+.toast button { background: none; border: 1px solid #8892b0; color: #fff; padding: 2px 8px; }
+@media (max-width: 600px) { .column, .add-col { flex-basis: 84vw; } .topbar #search { width: 100%; } }
