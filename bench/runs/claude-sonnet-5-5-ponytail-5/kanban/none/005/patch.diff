+(function () {
+'use strict';
+
+const KEY = 'kanban.v1';
+const THEME_KEY = 'kanban.theme';
+const PRIORITIES = ['none', 'low', 'medium', 'high'];
+
+// ---------- helpers ----------
+const $ = (s) => document.querySelector(s);
+const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
+
+function h(tag, attrs, ...kids) {
+  const el = document.createElement(tag);
+  for (const [k, v] of Object.entries(attrs || {})) {
+    if (v == null || v === false) continue;
+    if (k === 'class') el.className = v;
+    else if (k.startsWith('on')) el.addEventListener(k.slice(2), v);
+    else if (k in el && k !== 'list') el[k] = v;
+    else el.setAttribute(k, v === true ? '' : v);
+  }
+  for (const kid of kids.flat()) {
+    if (kid == null || kid === false) continue;
+    el.append(kid.nodeType ? kid : document.createTextNode(String(kid)));
+  }
+  return el;
+}
+
+function todayStr() {
+  const d = new Date();
+  return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
+}
+function dayDiff(dateStr) {
+  const [y, m, d] = dateStr.split('-').map(Number);
+  const [ty, tm, td] = todayStr().split('-').map(Number);
+  return Math.round((Date.UTC(y, m - 1, d) - Date.UTC(ty, tm - 1, td)) / 864e5);
+}
+function fmtDate(s) {
+  const [y, m, d] = s.split('-').map(Number);
+  return new Date(y, m - 1, d).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
+}
+function labelColor(name) {
+  let x = 0;
+  for (const c of name.toLowerCase()) x = (x * 31 + c.charCodeAt(0)) >>> 0;
+  return 'hsl(' + (x % 360) + ',55%,42%)';
+}
+function parseLabels(str) {
+  const seen = new Set(), out = [];
+  for (const raw of str.split(',')) {
+    const t = raw.trim();
+    if (t && !seen.has(t.toLowerCase())) { seen.add(t.toLowerCase()); out.push(t.slice(0, 30)); }
+  }
+  return out;
+}
+
+// ---------- state ----------
+function defaultState() {
+  const cols = [
+    { id: uid() + 'a', title: 'To do', wip: 0, done: false, cards: [] },
+    { id: uid() + 'b', title: 'Doing', wip: 3, done: false, cards: [] },
+    { id: uid() + 'c', title: 'Done', wip: 0, done: true, cards: [] },
+  ];
+  return { v: 1, columns: cols, cards: {}, archive: [] };
+}
+
+function sanitize(raw) {
+  if (!raw || typeof raw !== 'object' || !Array.isArray(raw.columns) || typeof raw.cards !== 'object' || !raw.cards) {
+    throw new Error('Not a valid board file');
+  }
+  const str = (v, max) => (typeof v === 'string' ? v.slice(0, max) : '');
+  const card = (c) => ({
+    id: str(c.id, 60) || uid(),
+    title: str(c.title, 500) || 'Untitled',
+    desc: str(c.desc, 20000),
+    labels: Array.isArray(c.labels) ? c.labels.filter((l) => typeof l === 'string').slice(0, 20) : [],
+    due: /^\d{4}-\d{2}-\d{2}$/.test(c.due) ? c.due : '',
+    priority: PRIORITIES.includes(c.priority) ? c.priority : 'none',
+    checklist: Array.isArray(c.checklist)
+      ? c.checklist.map((i) => ({ id: str(i.id, 60) || uid(), text: str(i.text, 300), done: !!i.done }))
+      : [],
+    created: Number(c.created) || Date.now(),
+    updated: Number(c.updated) || Date.now(),
+    completed: Number(c.completed) || 0,
+  });
+  const cards = {};
+  for (const [id, c] of Object.entries(raw.cards)) if (c && typeof c === 'object') { const k = card({ ...c, id }); cards[k.id] = k; }
+  const placed = new Set();
+  const columns = raw.columns.filter((c) => c && typeof c === 'object').map((c) => ({
+    id: str(c.id, 60) || uid(),
+    title: str(c.title, 100) || 'Column',
+    wip: Math.max(0, parseInt(c.wip, 10) || 0),
+    done: !!c.done,
+    cards: (Array.isArray(c.cards) ? c.cards : []).filter((id) => cards[id] && !placed.has(id) && placed.add(id)),
+  }));
+  if (!columns.length) columns.push({ id: uid(), title: 'To do', wip: 0, done: false, cards: [] });
+  // orphans go to first column
+  for (const id of Object.keys(cards)) if (!placed.has(id)) columns[0].cards.push(id);
+  const archive = (Array.isArray(raw.archive) ? raw.archive : []).filter((c) => c && typeof c === 'object').map(card);
+  return { v: 1, columns, cards, archive };
+}
+
+let state;
+let storageOK = true;
+function load() {
+  try {
+    const s = localStorage.getItem(KEY);
+    if (s) return sanitize(JSON.parse(s));
+  } catch (e) {
+    try { localStorage.setItem(KEY + '.corrupt', localStorage.getItem(KEY) || ''); } catch (_) {}
+    setTimeout(() => toast('Saved data was unreadable; a copy was kept and a fresh board started.'), 0);
+  }
+  return defaultState();
+}
+function save() {
+  try { localStorage.setItem(KEY, JSON.stringify(state)); storageOK = true; }
+  catch (e) { if (storageOK) toast('Could not save to browser storage — export your data!'); storageOK = false; }
+}
+
+const undoStack = [], redoStack = [];
+function commit(fn, opts) {
+  undoStack.push(JSON.stringify(state));
+  if (undoStack.length > 100) undoStack.shift();
+  redoStack.length = 0;
+  fn();
+  save();
+  render();
+  return opts;
+}
+function undo() {
+  if (!undoStack.length) return;
+  redoStack.push(JSON.stringify(state));
+  state = JSON.parse(undoStack.pop());
+  save(); render();
+}
+function redo() {
+  if (!redoStack.length) return;
+  undoStack.push(JSON.stringify(state));
+  state = JSON.parse(redoStack.pop());
+  save(); render();
+}
+
+const findCol = (id) => state.columns.find((c) => c.id === id);
+const colOfCard = (id) => state.columns.find((c) => c.cards.includes(id));
+
+function moveCard(cardId, toColId, beforeId) {
+  const from = colOfCard(cardId), to = findCol(toColId);
+  if (!to || !from) return;
+  commit(() => {
+    from.cards.splice(from.cards.indexOf(cardId), 1);
+    let i = beforeId ? to.cards.indexOf(beforeId) : -1;
+    if (i < 0) i = to.cards.length;
+    to.cards.splice(i, 0, cardId);
+    const c = state.cards[cardId];
+    c.updated = Date.now();
+    if (from !== to) c.completed = to.done ? Date.now() : 0;
+  });
+}
+
+function archiveCard(id) {
+  const col = colOfCard(id);
+  if (!col) return;
+  commit(() => {
+    col.cards.splice(col.cards.indexOf(id), 1);
+    state.archive.unshift(state.cards[id]);
+    delete state.cards[id];
+  });
+  toast('Card archived', 'Undo', undo);
+}
+function deleteCard(id) {
+  const col = colOfCard(id);
+  if (!col) return;
+  commit(() => { col.cards.splice(col.cards.indexOf(id), 1); delete state.cards[id]; });
+  toast('Card deleted', 'Undo', undo);
+}
+
+// ---------- toast ----------
+let toastTimer;
+function toast(msg, actionLabel, action) {
+  const t = $('#toast');
+  t.replaceChildren(h('span', {}, msg));
+  if (actionLabel) t.append(h('button', { onclick: () => { action(); t.hidden = true; } }, actionLabel));
+  t.hidden = false;
+  clearTimeout(toastTimer);
+  toastTimer = setTimeout(() => { t.hidden = true; }, actionLabel ? 6000 : 4000);
+}
+
+// ---------- filters ----------
+const filters = { q: '', label: '', due: '' };
+const filtersActive = () => !!(filters.q || filters.label || filters.due);
+function matches(card, col) {
+  if (filters.q) {
+    const q = filters.q.toLowerCase();
+    const hay = (card.title + '\n' + card.desc + '\n' + card.labels.join(' ')).toLowerCase();
+    if (!hay.includes(q)) return false;
+  }
+  if (filters.label && !card.labels.some((l) => l.toLowerCase() === filters.label.toLowerCase())) return false;
+  if (filters.due) {
+    if (filters.due === 'none') return !card.due;
+    if (!card.due) return false;
+    const d = dayDiff(card.due);
+    if (filters.due === 'overdue') return d < 0 && !col.done;
+    if (filters.due === 'week') return d >= 0 && d <= 7;
+  }
+  return true;
+}
+function refreshLabelFilter() {
+  const all = new Set();
+  for (const c of Object.values(state.cards)) c.labels.forEach((l) => all.add(l));
+  const sel = $('#filter-label');
+  if (filters.label && ![...all].some((l) => l.toLowerCase() === filters.label.toLowerCase())) filters.label = '';
+  sel.replaceChildren(h('option', { value: '' }, 'All labels'),
+    [...all].sort((a, b) => a.localeCompare(b)).map((l) => h('option', { value: l, selected: l === filters.label }, l)));
+}
+
+// ---------- drag & drop ----------
+let drag = null; // {type:'card'|'col', id}
+const dropLine = h('div', { class: 'drop-line' });
+
+function dropTarget(listEl, y) {
+  const els = [...listEl.querySelectorAll('.card:not(.dragging)')];
+  for (const el of els) {
+    const r = el.getBoundingClientRect();
+    if (y < r.top + r.height / 2) return el;
+  }
+  return null;
+}
+
+// ---------- render ----------
+let quickOpen = null; // column id with open quick-add
+let quickText = '';
+
+function cardEl(card, col) {
+  const done = card.checklist.filter((i) => i.done).length;
+  const meta = [];
+  if (card.due) {
+    const d = dayDiff(card.due);
+    let cls = 'badge', txt = fmtDate(card.due);
+    if (col.done) cls += ' complete';
+    else if (d < 0) { cls += ' overdue'; txt += ' · overdue'; }
+    else if (d <= 2) { cls += ' soon'; txt += d === 0 ? ' · today' : d === 1 ? ' · tomorrow' : ''; }
+    meta.push(h('span', { class: cls }, '📅 ' + txt));
+  }
+  if (card.checklist.length) meta.push(h('span', { class: 'badge' + (done === card.checklist.length ? ' complete' : '') }, '☑ ' + done + '/' + card.checklist.length));
+  if (card.desc) meta.push(h('span', { title: 'Has description' }, '≡'));
+  const el = h('div', {
+    class: 'card' + (card.priority !== 'none' ? ' p-' + card.priority : ''),
+    draggable: true, tabIndex: 0, 'data-id': card.id,
+    ondragstart: (e) => { drag = { type: 'card', id: card.id }; e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', card.id); setTimeout(() => el.classList.add('dragging'), 0); },
+    ondragend: () => { drag = null; dropLine.remove(); render(); },
+    onclick: () => openCard(card.id),
+    onkeydown: (e) => { if (e.key === 'Enter' && e.target === el) openCard(card.id); },
+  },
+    card.labels.length ? h('div', { class: 'card-meta', style: 'margin:0 0 4px' }, card.labels.map((l) => h('span', { class: 'label', style: 'background:' + labelColor(l) }, l))) : null,
+    h('div', { class: 'card-title' }, card.title),
+    meta.length ? h('div', { class: 'card-meta' }, meta) : null);
+  return el;
+}
+
+function columnEl(col) {
+  const visible = col.cards.filter((id) => matches(state.cards[id], col));
+  const over = col.wip > 0 && col.cards.length > col.wip;
+  const list = h('div', { class: 'cards' },
+    visible.map((id) => cardEl(state.cards[id], col)),
+    !visible.length ? h('div', { class: 'empty' }, filtersActive() && col.cards.length ? 'No matches' : 'No cards') : null);
+
+  const el = h('section', { class: 'column', 'data-id': col.id },
+    h('div', {
+      class: 'col-head', draggable: true,
+      ondragstart: (e) => { drag = { type: 'col', id: col.id }; e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', col.id); setTimeout(() => el.classList.add('dragging'), 0); },
+      ondragend: () => { drag = null; el.classList.remove('dragging'); document.querySelectorAll('.drop').forEach((x) => x.classList.remove('drop')); },
+    },
+      col.done ? h('span', { class: 'col-done-mark', title: 'Done column' }, '✓') : null,
+      h('span', { class: 'col-title' }, col.title),
+      h('span', { class: 'col-count' + (over ? ' over' : ''), title: over ? 'WIP limit exceeded' : '' },
+        col.wip ? col.cards.length + '/' + col.wip : col.cards.length),
+      h('button', { class: 'ghost', title: 'Column settings', 'aria-label': 'Column settings', onclick: () => openColumn(col.id) }, '⋯')),
+    list,
+    h('div', { class: 'col-foot' }, quickOpen === col.id ? quickForm(col) : h('button', { class: 'add', onclick: () => openQuick(col.id) }, '+ Add card')));
+
+  // card drop target
+  el.addEventListener('dragover', (e) => {
+    if (!drag) return;
+    e.preventDefault();
+    if (drag.type === 'card') {
+      el.classList.add('drop');
+      const before = dropTarget(list, e.clientY);
+      list.insertBefore(dropLine, before);
+      const empty = list.querySelector('.empty'); if (empty) empty.remove();
+    } else if (drag.id !== col.id) el.classList.add('drop');
+  });
+  el.addEventListener('dragleave', (e) => { if (!el.contains(e.relatedTarget)) { el.classList.remove('drop'); if (dropLine.parentNode === list) dropLine.remove(); } });
+  el.addEventListener('drop', (e) => {
+    if (!drag) return;
+    e.preventDefault();
+    const d = drag; drag = null;
+    if (d.type === 'card') {
+      const before = dropTarget(list, e.clientY);
+      dropLine.remove();
+      moveCard(d.id, col.id, before ? before.dataset.id : null);
+    } else if (d.id !== col.id) {
+      const rect = el.getBoundingClientRect();
+      const after = e.clientX > rect.left + rect.width / 2;
+      commit(() => {
+        const moving = state.columns.splice(state.columns.findIndex((c) => c.id === d.id), 1)[0];
+        let i = state.columns.findIndex((c) => c.id === col.id);
+        if (after) i++;
+        state.columns.splice(i, 0, moving);
+      });
+    }
+  });
+  return el;
+}
+
+function openQuick(colId) {
+  quickOpen = colId; quickText = '';
+  render();
+  const ta = document.querySelector('.quick textarea');
+  if (ta) { ta.focus(); ta.scrollIntoView({ block: 'nearest', inline: 'nearest' }); }
+}
+function closeQuick() { quickOpen = null; quickText = ''; render(); }
+
+function quickForm(col) {
+  const submit = () => {
+    const lines = ta.value.split('\n').map((s) => s.trim()).filter(Boolean);
+    if (!lines.length) { closeQuick(); return; }
+    commit(() => {
+      for (const t of lines) {
+        const c = { id: uid(), title: t.slice(0, 500), desc: '', labels: [], due: '', priority: 'none', checklist: [], created: Date.now(), updated: Date.now(), completed: col.done ? Date.now() : 0 };
+        state.cards[c.id] = c; col.cards.push(c.id);
+      }
+    });
+    openQuick(col.id); // stay open for rapid entry
+  };
+  const ta = h('textarea', {
+    placeholder: 'Card title… (one card per line)', value: quickText, rows: 2,
+    oninput: () => { quickText = ta.value; },
+    onkeydown: (e) => {
+      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); submit(); }
+      else if (e.key === 'Escape') { e.preventDefault(); closeQuick(); }
+    },
+  });
+  return h('div', { class: 'quick' }, ta,
+    h('div', { class: 'row' }, h('button', { class: 'primary', onclick: submit }, 'Add'), h('button', { class: 'ghost', onclick: closeQuick }, 'Cancel')));
+}
+
+function render() {
+  refreshLabelFilter();
+  const board = $('#board');
+  const scroll = board.scrollLeft;
+  const scrolls = [...board.querySelectorAll('.cards')].map((e) => e.scrollTop);
+  board.replaceChildren(
+    state.columns.map(columnEl),
+    h('div', { class: 'add-col' }, h('button', { onclick: addColumn }, '+ Add column')));
+  board.scrollLeft = scroll;
+  board.querySelectorAll('.cards').forEach((e, i) => { if (scrolls[i]) e.scrollTop = scrolls[i]; });
+  $('#btn-undo').disabled = !undoStack.length;
+  $('#btn-redo').disabled = !redoStack.length;
+  $('#archive-count').textContent = state.archive.length ? '(' + state.archive.length + ')' : '';
+}
+
+// ---------- column dialogs ----------
+function addColumn() {
+  commit(() => state.columns.push({ id: uid(), title: 'New column', wip: 0, done: false, cards: [] }));
+  openColumn(state.columns[state.columns.length - 1].id);
+}
+
+function openColumn(id) {
+  const col = findCol(id);
+  if (!col) return;
+  const dlg = $('#dlg-column');
+  const title = h('input', { type: 'text', value: col.title, maxLength: 100, required: true });
+  const wip = h('input', { type: 'number', min: 0, value: col.wip, title: '0 = no limit' });
+  const done = h('input', { type: 'checkbox', checked: col.done });
+  const idx = state.columns.indexOf(col);
+  const form = h('form', { class: 'dlg', method: 'dialog' },
+    h('h2', {}, 'Column settings'),
+    h('label', {}, 'Name', title),
+    h('label', {}, 'WIP limit (0 = none)', wip),
+    h('label', { class: 'check' }, done, 'Counts as “done” (cards here aren’t flagged overdue)'),
+    h('div', { class: 'actions' },
+      h('div', { class: 'left' },
+        h('button', { type: 'button', class: 'danger', onclick: () => {
+          const n = col.cards.length;
+          if (state.columns.length === 1) { alert('A board needs at least one column.'); return; }
+          if (!confirm(n ? 'Delete “' + col.title + '” and archive its ' + n + ' card(s)?' : 'Delete “' + col.title + '”?')) return;
+          dlg.close();
+          commit(() => {
+            for (const cid of col.cards) { state.archive.unshift(state.cards[cid]); delete state.cards[cid]; }
+            state.columns.splice(state.columns.indexOf(col), 1);
+          });
+        } }, 'Delete'),
+        col.cards.length ? h('button', { type: 'button', onclick: () => {
+          if (!confirm('Archive all ' + col.cards.length + ' card(s) in this column?')) return;
+          dlg.close();
+          commit(() => { for (const cid of col.cards) { state.archive.unshift(state.cards[cid]); delete state.cards[cid]; } col.cards = []; });
+          toast('Cards archived', 'Undo', undo);
+        } }, 'Archive all') : null),
+      h('button', { type: 'button', disabled: idx === 0, title: 'Move left', onclick: () => { dlg.close(); commit(() => { state.columns.splice(idx, 1); state.columns.splice(idx - 1, 0, col); }); } }, '←'),
+      h('button', { type: 'button', disabled: idx === state.columns.length - 1, title: 'Move right', onclick: () => { dlg.close(); commit(() => { state.columns.splice(idx, 1); state.columns.splice(idx + 1, 0, col); }); } }, '→'),
+      h('button', { type: 'button', onclick: () => dlg.close() }, 'Cancel'),
+      h('button', { class: 'primary' }, 'Save')));
+  form.addEventListener('submit', () => {
+    const t = title.value.trim() || col.title;
+    commit(() => { col.title = t; col.wip = Math.max(0, parseInt(wip.value, 10) || 0); col.done = done.checked; });
+  });
+  dlg.replaceChildren(form);
+  dlg.showModal();
+  title.select();
+}
+
+// ---------- card dialog ----------
+function openCard(id) {
+  const card = state.cards[id];
+  const col = colOfCard(id);
+  if (!card) return;
+  const w = JSON.parse(JSON.stringify(card)); // working copy
+  const dlg = $('#dlg-card');
+
+  const title = h('textarea', { rows: 2, maxLength: 500, required: true }, '');
+  title.value = w.title;
+  const desc = h('textarea', { rows: 5, placeholder: 'Notes, links, details…' });
+  desc.value = w.desc;
+  const colSel = h('select', {}, state.columns.map((c) => h('option', { value: c.id, selected: c.id === col.id }, c.title)));
+  const prio = h('select', {}, PRIORITIES.map((p) => h('option', { value: p, selected: p === w.priority }, p === 'none' ? 'No priority' : p[0].toUpperCase() + p.slice(1))));
+  const due = h('input', { type: 'date', value: w.due });
+  const labels = h('input', { type: 'text', value: w.labels.join(', '), placeholder: 'comma, separated', list: 'label-options' });
+  const known = new Set();
+  Object.values(state.cards).forEach((c) => c.labels.forEach((l) => known.add(l)));
+  const datalist = h('datalist', { id: 'label-options' }, [...known].map((l) => h('option', { value: l })));
+
+  const ckBox = h('div', { class: 'checklist' });
+  const bar = h('div', { class: 'progress' }, h('div'));
+  const renderChecklist = () => {
+    const done = w.checklist.filter((i) => i.done).length;
+    bar.hidden = !w.checklist.length;
+    bar.firstChild.style.width = (w.checklist.length ? (done / w.checklist.length) * 100 : 0) + '%';
+    ckBox.replaceChildren(w.checklist.map((item, i) => h('div', { class: 'ck' + (item.done ? ' done' : '') },
+      h('input', { type: 'checkbox', checked: item.done, 'aria-label': 'Done', onchange: (e) => { item.done = e.target.checked; renderChecklist(); } }),
+      h('input', { type: 'text', value: item.text, maxLength: 300, 'aria-label': 'Item text', oninput: (e) => { item.text = e.target.value; } }),
+      h('button', { type: 'button', class: 'ghost', title: 'Remove item', onclick: () => { w.checklist.splice(i, 1); renderChecklist(); } }, '✕'))));
+  };
+  const newItem = h('input', { type: 'text', placeholder: 'Add checklist item and press Enter', maxLength: 300,
+    onkeydown: (e) => {
+      if (e.key === 'Enter') {
+        e.preventDefault();
