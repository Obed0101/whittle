diff --git a/board/style.css b/board/style.css
new file mode 100644
index 0000000..8d96802
--- /dev/null
+++ b/board/style.css
@@ -0,0 +1,61 @@
+:root{--bg:#f1f2f6;--col:#e3e5ec;--card:#fff;--text:#1d2230;--muted:#667;--border:#cdd1dc;--accent:#3b6df0;--danger:#d93a3a;--warn:#c98a00;--shadow:0 1px 2px rgba(0,0,0,.15)}
+[data-theme=dark]{--bg:#14161c;--col:#1f222b;--card:#2a2e3a;--text:#e6e8ee;--muted:#9aa0b0;--border:#3a3f4e;--accent:#6f93ff;--danger:#ff6b6b;--warn:#e0b040;--shadow:0 1px 2px rgba(0,0,0,.5)}
+*{box-sizing:border-box}
+html,body{height:100%;margin:0}
+body{display:flex;flex-direction:column;background:var(--bg);color:var(--text);font:14px/1.4 system-ui,-apple-system,Segoe UI,sans-serif}
+button,input,select,textarea{font:inherit;color:inherit}
+button{background:var(--card);border:1px solid var(--border);border-radius:6px;padding:5px 10px;cursor:pointer}
+button:hover{border-color:var(--accent)}
+button:disabled{opacity:.4;cursor:default}
+button.primary{background:var(--accent);border-color:var(--accent);color:#fff}
+button.danger{color:var(--danger)}
+input,select,textarea{background:var(--card);border:1px solid var(--border);border-radius:6px;padding:6px 8px}
+:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
+.topbar{display:flex;gap:8px;align-items:center;padding:8px 12px;border-bottom:1px solid var(--border);flex-wrap:wrap}
+.topbar h1{font-size:18px;margin:0 8px 0 0}
+.topbar #search{width:220px}
+.spacer{flex:1}
+.count{color:var(--muted)}
+.board{flex:1;display:flex;gap:12px;padding:12px;overflow:auto;align-items:flex-start}
+.column{background:var(--col);border-radius:10px;width:290px;flex:none;display:flex;flex-direction:column;max-height:100%}
+.column.dragging,.card.dragging{opacity:.4}
+.col-head{display:flex;align-items:center;gap:6px;padding:8px 8px 4px 10px;cursor:grab}
+.col-title{flex:1;font-weight:600;background:transparent;border:1px solid transparent;padding:2px 4px;min-width:0;cursor:text}
+.col-title:focus{background:var(--card);border-color:var(--border)}
+.col-count{color:var(--muted);font-size:12px}
+.col-count.over{color:var(--danger);font-weight:700}
+.icon{padding:2px 7px;border:none;background:transparent;color:var(--muted)}
+.cards{overflow-y:auto;padding:4px 8px;min-height:20px;display:flex;flex-direction:column;gap:6px;flex:1}
+.card{background:var(--card);border-radius:8px;padding:8px 10px;box-shadow:var(--shadow);cursor:pointer;border-left:4px solid transparent;word-break:break-word}
+.card:hover{outline:1px solid var(--accent)}
+.card.p-high{border-left-color:var(--danger)}
+.card.p-medium{border-left-color:var(--warn)}
+.card.p-low{border-left-color:var(--accent)}
+.card-title{white-space:pre-wrap}
+.meta{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px;font-size:12px;color:var(--muted)}
+.chip{border-radius:10px;padding:0 7px;color:#fff;font-size:11px;line-height:18px}
+.due.overdue{color:var(--danger);font-weight:600}
+.due.today{color:var(--warn);font-weight:600}
+.drop-line{height:3px;background:var(--accent);border-radius:2px;flex:none}
+.add{padding:8px}
+.add textarea{width:100%;resize:none;display:block}
+.add-btn{width:100%;text-align:left;border:none;background:transparent;color:var(--muted)}
+.add-row{display:flex;gap:6px;margin-top:6px}
+.new-col{width:290px;flex:none}
+.empty{color:var(--muted);text-align:center;padding:30px;width:100%}
+.toast{position:fixed;bottom:16px;left:50%;transform:translateX(-50%);background:#222;color:#fff;padding:8px 14px;border-radius:8px;display:flex;gap:12px;align-items:center;z-index:10}
+.toast button{background:transparent;color:#8fb0ff;border:none;padding:0}
+dialog{border:1px solid var(--border);border-radius:12px;background:var(--bg);color:var(--text);width:min(560px,94vw);padding:16px;max-height:90vh;overflow:auto}
+dialog::backdrop{background:rgba(0,0,0,.5)}
+.field{display:flex;flex-direction:column;gap:3px;margin-bottom:10px}
+.field>label,.field>span{font-size:12px;color:var(--muted)}
+.row{display:flex;gap:10px}
+.row>*{flex:1}
+.check{display:flex;gap:6px;align-items:center;margin:3px 0}
+.check input[type=text]{flex:1}
+.check .done{text-decoration:line-through;color:var(--muted)}
+.actions{display:flex;gap:8px;justify-content:flex-end;margin-top:12px}
+.actions .left{margin-right:auto;display:flex;gap:8px}
+.arch-item{display:flex;gap:8px;align-items:center;padding:6px 0;border-bottom:1px solid var(--border)}
+.arch-item span{flex:1;word-break:break-word}
+.hint{color:var(--muted);font-size:12px}
