+    const b = board();
+    if (state.boards.length < 2) return;
+    if (!confirm(`Delete board "${b.name}" and all its cards?`)) return;
+    commit(() => { state.boards = state.boards.filter((x) => x !== b); state.active = state.boards[0].id; });
+    toast('Board deleted', { label: 'Undo', fn: undo });
+  });
+  $('#search').addEventListener('input', (e) => { ui.q = e.target.value.trim(); render(); });
+  $('#labelFilter').addEventListener('change', (e) => { ui.label = e.target.value; render(); });
+  $('#dueFilter').addEventListener('change', (e) => { ui.due = e.target.value; render(); });
+  $('#labelsBtn').addEventListener('click', labelsDialog);
+  $('#archiveBtn').addEventListener('click', archiveDialog);
+  $('#undoBtn').addEventListener('click', undo);
+  $('#themeBtn').addEventListener('click', () => { state.theme = state.theme === 'dark' ? 'light' : 'dark'; save(); render(); });
+  $('#exportBtn').addEventListener('click', () => {
+    const a = h('a', { href: URL.createObjectURL(new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' })), download: `kanban-${todayStr()}.json` });
+    document.body.append(a); a.click(); a.remove();
+    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
+  });
+  $('#importBtn').addEventListener('click', () => $('#importFile').click());
+  $('#importFile').addEventListener('change', async (e) => {
+    const file = e.target.files[0];
+    e.target.value = '';
+    if (!file) return;
+    try {
+      const data = JSON.parse(await file.text());
+      if (!Array.isArray(data.boards) || !data.boards.length) throw new Error('no boards');
+      for (const b of data.boards) {
+        if (!b.id || !Array.isArray(b.columns)) throw new Error('bad board');
+        b.labels = b.labels || []; b.archive = b.archive || [];
+        for (const col of b.columns) for (const c of col.cards) { c.labels = c.labels || []; c.checklist = c.checklist || []; c.desc = c.desc || ''; c.due = c.due || ''; c.priority = c.priority || ''; }
+      }
+      if (!confirm('Importing replaces all current boards. Continue? (You can undo.)')) return;
+      commit(() => { state = { theme: state.theme, ...data, active: data.boards.some((b) => b.id === data.active) ? data.active : data.boards[0].id }; });
+    } catch (err) { toast('Import failed: not a valid board file'); }
+  });
+
+  document.addEventListener('keydown', (e) => {
+    const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName);
+    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z' && !typing && !dlg.open) { e.preventDefault(); undo(); }
+    else if (e.key === '/' && !typing && !dlg.open) { e.preventDefault(); $('#search').focus(); }
+    else if (e.key === 'n' && !typing && !dlg.open && !e.ctrlKey && !e.metaKey) {
+      const c = board().columns[0];
+      if (c) { e.preventDefault(); ui.adding = c.id; render(); }
+    }
+  });
+  dlg.addEventListener('close', () => { dlg.onkeydown = null; });
+  window.addEventListener('storage', (e) => {
+    if (e.key === KEY && e.newValue && !dlg.open) { try { state = JSON.parse(e.newValue); render(); } catch (_) { /* ignore */ } }
+  });
+
+  render();
+})();
diff --git a/board/index.html b/board/index.html
new file mode 100644
index 0000000..9e090d1
--- /dev/null
+++ b/board/index.html
@@ -0,0 +1,37 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Kanban</title>
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<header class="topbar">
+  <select id="boardSelect" aria-label="Board"></select>
+  <button id="boardNew" title="New board">+ Board</button>
+  <button id="boardRename" title="Rename board">Rename</button>
+  <button id="boardDelete" title="Delete board">Delete</button>
+  <span class="spacer"></span>
+  <input id="search" type="search" placeholder="Search ( / )" aria-label="Search cards">
+  <select id="labelFilter" aria-label="Filter by label"></select>
+  <select id="dueFilter" aria-label="Filter by due date">
+    <option value="">Any due date</option>
+    <option value="overdue">Overdue</option>
+    <option value="soon">Due in 7 days</option>
+    <option value="none">No due date</option>
+  </select>
+  <button id="labelsBtn">Labels</button>
+  <button id="archiveBtn">Archive</button>
+  <button id="undoBtn" title="Undo (Ctrl+Z)">Undo</button>
+  <button id="exportBtn">Export</button>
+  <button id="importBtn">Import</button>
+  <button id="themeBtn" title="Toggle theme">◐</button>
+  <input id="importFile" type="file" accept="application/json" hidden>
+</header>
+<main id="board" class="board"></main>
+<div id="toast" class="toast" hidden></div>
+<dialog id="dlg"></dialog>
+<script src="app.js"></script>
+</body>
+</html>
diff --git a/board/style.css b/board/style.css
new file mode 100644
index 0000000..b02ea01
--- /dev/null
+++ b/board/style.css
@@ -0,0 +1,65 @@
+:root{--bg:#f1f2f6;--col:#e4e6ee;--card:#fff;--text:#1d2130;--muted:#69708a;--line:#cfd3e0;--accent:#3b6df0;--danger:#d93b3b;--warn:#c77d00}
+:root[data-theme=dark]{--bg:#14161d;--col:#1e212b;--card:#2a2e3b;--text:#e6e8f0;--muted:#98a0b8;--line:#3a3f50;--accent:#6b93ff;--danger:#ff6b6b;--warn:#f0b24a}
+*{box-sizing:border-box}
+html,body{height:100%;margin:0}
+body{display:flex;flex-direction:column;background:var(--bg);color:var(--text);font:14px/1.4 system-ui,-apple-system,Segoe UI,sans-serif}
+button,select,input,textarea{font:inherit;color:inherit}
+button,select,input[type=search],input[type=text],input[type=date],textarea,input[type=number]{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:5px 9px}
+button{cursor:pointer}
+button:hover{border-color:var(--accent)}
+button:disabled{opacity:.4;cursor:default}
+button.primary{background:var(--accent);border-color:var(--accent);color:#fff}
+button.danger{color:var(--danger)}
+:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
+.topbar{display:flex;flex-wrap:wrap;gap:6px;padding:8px 12px;border-bottom:1px solid var(--line);align-items:center}
+.spacer{flex:1}
+.board{flex:1;display:flex;gap:12px;padding:12px;overflow:auto;align-items:flex-start}
+.column{background:var(--col);border-radius:10px;width:290px;flex:none;display:flex;flex-direction:column;max-height:100%}
+.column.dragging,.card.dragging{opacity:.4}
+.col-head{display:flex;align-items:center;gap:4px;padding:8px 8px 4px;cursor:grab}
+.col-title{flex:1;min-width:0;background:transparent;border:1px solid transparent;font-weight:600;cursor:text}
+.col-title:focus{background:var(--card);border-color:var(--line)}
+.count{color:var(--muted);font-size:12px;white-space:nowrap}
+.count.over{color:var(--danger);font-weight:700}
+.col-head button{border:none;background:transparent;padding:2px 6px}
+.cards{overflow-y:auto;padding:4px 8px;min-height:30px;display:flex;flex-direction:column;gap:7px;flex:1}
+.cards.over{outline:2px dashed var(--accent);outline-offset:-3px;border-radius:8px}
+.card{background:var(--card);border-radius:8px;padding:8px 10px;border:1px solid var(--line);cursor:grab;box-shadow:0 1px 2px #0002}
+.card:hover{border-color:var(--accent)}
+.card.drop-before{box-shadow:0 -3px 0 var(--accent)}
+.card .t{overflow-wrap:anywhere;white-space:pre-wrap}
+.chips{display:flex;flex-wrap:wrap;gap:4px;margin-top:5px;align-items:center}
+.chip{font-size:11px;padding:0 7px;border-radius:9px;color:#fff;background:var(--muted)}
+.meta{font-size:11px;color:var(--muted)}
+.meta.overdue{color:var(--danger);font-weight:600}
+.meta.soon{color:var(--warn)}
+.pri{width:4px;border-radius:2px;align-self:stretch}
+.card.p-high{border-left:4px solid var(--danger)}
+.card.p-medium{border-left:4px solid var(--warn)}
+.card.p-low{border-left:4px solid #3aa86b}
+.add{padding:8px}
+.add>button{width:100%;text-align:left;background:transparent;border:none;color:var(--muted)}
+.add textarea{width:100%;resize:vertical}
+.add .row{display:flex;gap:6px;margin-top:5px}
+.newcol{width:290px;flex:none}
+.newcol button{width:100%;padding:10px;background:transparent;border:2px dashed var(--line);color:var(--muted)}
+dialog{border:1px solid var(--line);border-radius:12px;background:var(--bg);color:var(--text);padding:18px;width:min(560px,94vw);max-height:90vh}
+dialog::backdrop{background:#0008}
+dialog h2{margin:0 0 12px;font-size:17px}
+dialog label{display:block;margin:10px 0 3px;font-weight:600;font-size:12px;color:var(--muted)}
+dialog input[type=text],dialog textarea,dialog input[type=date],dialog select,dialog input[type=number]{width:100%}
+dialog textarea{min-height:90px;resize:vertical}
+.foot{display:flex;gap:8px;margin-top:16px;justify-content:flex-end}
+.foot .l{margin-right:auto;display:flex;gap:8px}
+.lbl-pick{display:flex;flex-wrap:wrap;gap:6px}
+.lbl-pick label{display:flex;align-items:center;gap:4px;margin:0;font-weight:400;color:#fff;padding:2px 9px;border-radius:10px;cursor:pointer}
+.lbl-pick input{margin:0}
+.item{display:flex;gap:6px;align-items:center;margin:4px 0}
+.item input[type=text]{flex:1}
+.item.done input[type=text]{text-decoration:line-through;color:var(--muted)}
+.arch{display:flex;gap:8px;align-items:center;padding:6px 0;border-bottom:1px solid var(--line)}
+.arch span{flex:1;overflow-wrap:anywhere}
+.toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);background:#222;color:#fff;padding:9px 14px;border-radius:8px;display:flex;gap:12px;align-items:center;z-index:99}
+.toast[hidden]{display:none}
+.toast button{background:transparent;color:#8fb0ff;border:none}
+.empty{color:var(--muted);padding:10px 0}
