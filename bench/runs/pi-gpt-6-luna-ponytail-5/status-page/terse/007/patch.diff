@@ -0,0 +1,118 @@
+"""Render a self-contained public service status page."""
+
+import html
+import json
+import re
+import sys
+from datetime import datetime, timezone
+
+
+LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+CSS = """<style>
+:root { --bg: #f5f7fa; --text: #17212b; --ok: #16834b; --warn: #a35b00; --down: #bd2525; --maint: #5367a5; }
+@media (prefers-color-scheme: dark) { :root { --bg: #151a21; --text: #edf1f5; --ok: #54d18a; --warn: #ffc05c; --down: #ff7474; --maint: #aabaff; } }
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, main, footer { max-width: 640px; margin: 0 auto; }
+h1 { margin: 0 0 1.25rem; }
+.banner { padding: 1rem; margin-bottom: 1.5rem; border-radius: .5rem; font-weight: 600; }
+.banner--ok { background: color-mix(in srgb, var(--ok) 14%, var(--bg)); }
+.banner--warn { background: color-mix(in srgb, var(--warn) 14%, var(--bg)); }
+.banner--down { background: color-mix(in srgb, var(--down) 14%, var(--bg)); }
+.services { display: flex; flex-direction: column; gap: .75rem; padding: 0; margin: 0; list-style: none; }
+.service { display: flex; align-items: center; gap: .75rem; padding: 1rem; border: 1px solid #8884; border-radius: .5rem; }
+.service h2 { flex: 1; margin: 0; font-size: 1.05rem; }
+.dot { flex: 0 0 .7rem; width: .7rem; height: .7rem; border-radius: 50%; background: var(--ok); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; transform: scale(.8); } }
+@media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
+.state, .uptime { white-space: nowrap; font-size: .9rem; }
+.note { margin: .4rem 0 0; }
+a { color: inherit; }
+a:focus-visible { outline: 3px solid var(--maint); outline-offset: 3px; }
+.empty { text-align: center; }
+footer { margin-top: 2rem; font-size: .9rem; opacity: .75; }
+@media (max-width: 480px) { .service { flex-direction: column; align-items: flex-start; } }
+</style>"""
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    """Return a complete static HTML status page."""
+    for service in services:
+        if service["state"] not in LABELS:
+            raise ValueError(f"unknown state: {service['state']}")
+
+    count = len(services)
+    if not count:
+        title = "Status · no services"
+    else:
+        operational = sum(s["state"] == "operational" for s in services)
+        title = f"Status · {operational} of {count} operational"
+
+    parts = ["<!doctype html>", '<html lang="en">', "<head>",
+             '<meta charset="utf-8">', '<meta name="viewport" content="width=device-width, initial-scale=1">',
+             f"<title>{html.escape(title)}</title>", CSS, "</head>", "<body>",
+             "<header><h1>System status</h1></header>"]
+
+    if count:
+        attention = sum(s["state"] in ("degraded", "outage") for s in services)
+        maintenance = sum(s["state"] == "maintenance" for s in services)
+        if not attention:
+            message = "All systems operational"
+        else:
+            verb = "needs" if attention == 1 else "need"
+            message = f"{attention} of {count} services {verb} attention"
+        if maintenance:
+            message += f" · {maintenance} under maintenance"
+        modifier = "down" if any(s["state"] == "outage" for s in services) else (
+            "warn" if any(s["state"] == "degraded" for s in services) else "ok")
+        parts.append(f'<div class="banner banner--{modifier}" role="status">{html.escape(message)}</div>')
+        parts.append('<main><ul class="services">')
+        ordered = sorted(services, key=lambda s: (SEVERITY[s["state"]], s["name"].casefold()))
+        for service in ordered:
+            state = service["state"]
+            name = html.escape(str(service["name"]))
+            slug = re.sub(r"-+", "-", re.sub(r"[^\w]+", "-", str(service["name"]).lower(), flags=re.UNICODE)).strip("-")
+            url = service.get("url")
+            if url is not None:
+                escaped_url = html.escape(str(url), quote=True)
+                rel = ' rel="noopener"' if re.match(r"https?://", str(url), re.IGNORECASE) else ""
+                name = f'<a href="{escaped_url}"{rel}>{name}</a>'
+            parts.append(f'<li class="service" id="service-{html.escape(slug, quote=True)}" data-state="{state}">')
+            parts.append('<span class="dot" aria-hidden="true"></span>')
+            parts.append(f"<h2>{name}</h2><span class=\"state\">{LABELS[state]}</span>")
+            if service.get("note"):
+                parts.append(f'<p class="note">{html.escape(str(service["note"]))}</p>')
+            if service.get("uptime") is not None:
+                parts.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            parts.append("</li>")
+        parts.extend(["</ul></main>"])
+    else:
+        parts.append('<main><p class="empty">No services configured.</p></main>')
+
+    stamp = html.escape(generated_at, quote=True)
+    parts.extend([f'<footer><time datetime="{stamp}">Updated {html.escape(generated_at)}</time></footer>',
+                  "</body>", "</html>"])
+    return "\n".join(parts)
+
+
+def main() -> None:
+    from .status import load
+
+    services = load(sys.argv[1])
+    generated_at = datetime.now(timezone.utc).isoformat()
+    print(render(services, generated_at))
+
+
+if __name__ == "__main__":
+    main()
