+++ b/app/page.py
@@ -0,0 +1,123 @@
+"""Render a self-contained public service status page."""
+import html
+import re
+import sys
+from datetime import datetime, timezone
+
+from app.status import STATES, load
+
+_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+_SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _escape(value):
+    return html.escape(str(value), quote=True)
+
+
+def _slug(value):
+    parts = []
+    for char in str(value).lower():
+        if char.isalnum():
+            parts.append(char)
+        elif parts and parts[-1] != "-":
+            parts.append("-")
+    return "".join(parts).strip("-")
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    """Return a complete, static HTML status document."""
+    for service in services:
+        if service["state"] not in STATES:
+            raise ValueError(f"unknown state: {service['state']}")
+
+    count = len(services)
+    operational = sum(service["state"] == "operational" for service in services)
+    title = f"Status · {operational} of {count} operational" if count else "Status · no services"
+    rows = []
+    if count:
+        attention = sum(service["state"] in ("degraded", "outage") for service in services)
+        maintenance = sum(service["state"] == "maintenance" for service in services)
+        if attention:
+            banner_text = f"{attention} of {count} services {'needs' if attention == 1 else 'need'} attention"
+        else:
+            banner_text = "All systems operational"
+        if maintenance:
+            banner_text += f" · {maintenance} under maintenance"
+        modifier = "down" if any(s["state"] == "outage" for s in services) else (
+            "warn" if any(s["state"] == "degraded" for s in services) else "ok")
+        banner = f'<p class="banner banner--{modifier}" role="status">{_escape(banner_text)}</p>'
+        ordered = sorted(services, key=lambda s: (_SEVERITY[s["state"]], s["name"].casefold()))
+        for service in ordered:
+            state = service["state"]
+            name = _escape(service["name"])
+            if "url" in service:
+                url = _escape(service["url"])
+                rel = ' rel="noopener"' if re.match(r"^https?://", str(service["url"]), re.I) else ""
+                heading = f'<a href="{url}"{rel}>{name}</a>'
+            else:
+                heading = name
+            parts = [f'<li class="service" id="service-{_escape(_slug(service["name"]))}" data-state="{_escape(state)}">',
+                     '<span class="dot" aria-hidden="true"></span>', f'<h2>{heading}</h2>',
+                     f'<span class="state">{_LABELS[state]}</span>']
+            if service.get("note"):
+                parts.append(f'<p class="note">{_escape(service["note"])}</p>')
+            if "uptime" in service:
+                parts.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            parts.append("</li>")
+            rows.append("\n    ".join(parts))
+        content = banner + '\n<main>\n  <ul class="services">\n    ' + "\n    ".join(rows) + '\n  </ul>\n</main>'
+    else:
+        content = '<main>\n  <p class="empty">No services configured.</p>\n</main>'
+
+    return f'''<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>{_escape(title)}</title>
+<style>
+:root {{ --bg: #f5f7fa; --text: #182230; --ok: #16803c; --warn: #a15c00; --down: #c62828; --maint: #52657a; }}
+@media (prefers-color-scheme: dark) {{ :root {{ --bg: #111820; --text: #e8edf2; }} }}
+* {{ box-sizing: border-box; }}
+body {{ margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }}
+header, .banner, main, footer {{ width: 100%; max-width: 640px; margin-left: auto; margin-right: auto; }}
+header h1 {{ margin: 0 0 1.25rem; }}
+.banner {{ padding: 1rem; border-radius: .5rem; font-weight: 600; }}
+.banner--ok {{ background: color-mix(in srgb, var(--ok) 12%, var(--bg)); }}
+.banner--warn {{ background: color-mix(in srgb, var(--warn) 14%, var(--bg)); }}
+.banner--down {{ background: color-mix(in srgb, var(--down) 14%, var(--bg)); }}
+.services {{ display: flex; flex-direction: column; gap: .75rem; margin: 1.25rem 0; padding: 0; list-style: none; }}
+.service {{ display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; padding: 1rem; border: 1px solid #8793a033; border-radius: .5rem; }}
+.service h2 {{ margin: 0; font-size: 1.1rem; }}
+.dot {{ width: .7rem; height: .7rem; flex: 0 0 .7rem; border-radius: 50%; background: var(--ok); }}
+[data-state="operational"] .dot {{ background: var(--ok); }}
+[data-state="degraded"] .dot {{ background: var(--warn); }}
+[data-state="outage"] .dot {{ background: var(--down); animation: pulse 1.5s ease-in-out infinite; }}
+[data-state="maintenance"] .dot {{ background: var(--maint); }}
+.state {{ margin-left: auto; }}
+.note {{ flex-basis: 100%; margin: 0 0 0 1.45rem; }}
+.uptime {{ font-size: .9rem; }}
+a {{ color: inherit; }}
+a:focus-visible {{ outline: 3px solid var(--warn); outline-offset: 3px; }}
+footer {{ margin-top: 2rem; font-size: .9rem; opacity: .75; }}
+@keyframes pulse {{ 50% {{ opacity: .35; }} }}
+@media (prefers-reduced-motion: reduce) {{ [data-state="outage"] .dot {{ animation: none; }} }}
+@media (max-width: 480px) {{ .service {{ flex-direction: column; align-items: flex-start; }} .state {{ margin-left: 0; }} .note {{ margin-left: 0; }} }}
+</style>
+</head>
+<body>
+<header><h1>System status</h1></header>
+{content}
+<footer><time datetime="{_escape(generated_at)}">Updated {_escape(generated_at)}</time></footer>
+</body>
+</html>'''
+
+
+if __name__ == "__main__":
+    services = load(sys.argv[1])
+    print(render(services, datetime.now(timezone.utc).isoformat()))
