+"""Render a self-contained public service status page."""
+import datetime
+import html
+import json
+import re
+import sys
+
+_STATE_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+_SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _escape(value):
+    return html.escape(str(value), quote=True)
+
+
+def _slug(name):
+    result = []
+    separator = False
+    for char in name.lower():
+        if char.isalnum():
+            if separator and result:
+                result.append("-")
+            result.append(char)
+            separator = False
+        else:
+            separator = True
+    return "".join(result)
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    for service in services:
+        state = service["state"]
+        if state not in _STATE_LABELS:
+            raise ValueError(f"unknown state: {state}")
+
+    ordered = sorted(services, key=lambda item: (_SEVERITY[item["state"]], item["name"].casefold()))
+    total = len(services)
+    if not total:
+        title = "Status · no services"
+        status_markup = '<p class="empty">No services configured.</p>'
+    else:
+        operational = sum(item["state"] == "operational" for item in services)
+        title = f"Status · {operational} of {total} operational"
+        attention = sum(item["state"] in ("degraded", "outage") for item in services)
+        maintenance = sum(item["state"] == "maintenance" for item in services)
+        if attention:
+            message = f"{attention} of {total} services {'needs' if attention == 1 else 'need'} attention"
+        else:
+            message = "All systems operational"
+        if maintenance:
+            message += f" · {maintenance} under maintenance"
+        modifier = "down" if any(item["state"] == "outage" for item in services) else "warn" if any(item["state"] == "degraded" for item in services) else "ok"
+        rows = []
+        for item in ordered:
+            state = item["state"]
+            name = _escape(item["name"])
+            url = item.get("url")
+            if url:
+                link_attrs = ' rel="noopener"' if re.match(r"^https?://", str(url), re.IGNORECASE) else ""
+                name = f'<a href="{_escape(url)}"{link_attrs}>{name}</a>'
+            parts = [f'<li class="service" id="service-{_escape(_slug(str(item["name"]))) }" data-state="{_escape(state)}">',
+                     '<span class="dot" aria-hidden="true"></span>', f'<h2>{name}</h2>',
+                     f'<span class="state">{_STATE_LABELS[state]}</span>']
+            if item.get("note"):
+                parts.append(f'<p class="note">{_escape(item["note"])}</p>')
+            if item.get("uptime") is not None:
+                parts.append(f'<span class="uptime">{float(item["uptime"]):.2f}% uptime</span>')
+            parts.append("</li>")
+            rows.append("".join(parts))
+        status_markup = f'<div class="banner banner--{modifier}" role="status">{_escape(message)}</div><ul class="services">{"".join(rows)}</ul>'
+
+    return f'''<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>{_escape(title)}</title>
+<style>
+:root {{ --bg: #f5f7fa; --text: #17212b; --ok: #218739; --warn: #a86400; --down: #c62828; --maint: #52647a; }}
+@media (prefers-color-scheme: dark) {{ :root {{ --bg: #151a20; --text: #e7edf3; }} }}
+* {{ box-sizing: border-box; }}
+body {{ margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }}
+header, main, footer {{ max-width: 640px; margin: 0 auto; }}
+h1 {{ font-size: 1.8rem; }}
+.banner {{ padding: 1rem; margin: 1.5rem auto; border-radius: .5rem; font-weight: 700; }}
+.banner--ok {{ background: color-mix(in srgb, var(--ok) 14%, var(--bg)); color: var(--ok); }}
+.banner--warn {{ background: color-mix(in srgb, var(--warn) 14%, var(--bg)); color: var(--warn); }}
+.banner--down {{ background: color-mix(in srgb, var(--down) 14%, var(--bg)); color: var(--down); }}
+.services {{ list-style: none; padding: 0; margin: 1.5rem auto; max-width: 640px; }}
+.service {{ display: flex; align-items: center; gap: 1rem; padding: 1rem; margin-bottom: .75rem; border: 1px solid #8994a033; border-radius: .5rem; }}
+.service h2 {{ font-size: 1.05rem; margin: 0; flex: 1; }}
+a {{ color: inherit; }}
+a:focus-visible {{ outline: 3px solid var(--warn); outline-offset: 3px; }}
+.state, .uptime {{ white-space: nowrap; }}
+.note {{ flex-basis: 100%; margin: .5rem 0 0; }}
+.dot {{ width: .7rem; height: .7rem; border-radius: 50%; flex: 0 0 .7rem; background: var(--ok); }}
+[data-state="operational"] .dot {{ background: var(--ok); }}
+[data-state="degraded"] .dot {{ background: var(--warn); }}
+[data-state="outage"] .dot {{ background: var(--down); animation: pulse 1.5s ease-in-out infinite; }}
+[data-state="maintenance"] .dot {{ background: var(--maint); }}
+@keyframes pulse {{ 50% {{ opacity: .35; }} }}
+@media (prefers-reduced-motion: reduce) {{ .dot {{ animation: none; }} }}
+@media (max-width: 480px) {{ .service {{ flex-direction: column; align-items: flex-start; }} }}
+footer {{ margin-top: 2rem; color: #73808c; font-size: .9rem; }}
+</style>
+</head>
+<body>
+<header><h1>System status</h1></header>
+<main>{status_markup}</main>
+<footer><time datetime="{_escape(generated_at)}">Updated {_escape(generated_at)}</time></footer>
+</body>
+</html>'''
+
+
+def main():
+    from app.status import load
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: python -m app.page services.json")
+    generated_at = datetime.datetime.now(datetime.timezone.utc).isoformat()
+    print(render(load(sys.argv[1]), generated_at))
+
+
+if __name__ == "__main__":
+    main()
