index 0000000..4d1fd65
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,115 @@
+"""Render a self-contained public status page."""
+import html
+import json
+import re
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+from .status import STATES, load
+
+STATE_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+CSS = """<style>
+:root { --bg: #f6f8fa; --text: #17212b; --ok: #16834a; --warn: #a86200; --down: #c22d36; --maint: #5264a8; }
+@media (prefers-color-scheme: dark) { :root { --bg: #15191e; --text: #e8edf2; } }
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, main, footer { max-width: 640px; margin: 0 auto; }
+h1 { margin-top: 0; }
+.banner { padding: 1rem; border-radius: .5rem; margin-bottom: 1rem; }
+.banner--ok { background: color-mix(in srgb, var(--ok) 14%, var(--bg)); }
+.banner--warn { background: color-mix(in srgb, var(--warn) 14%, var(--bg)); }
+.banner--down { background: color-mix(in srgb, var(--down) 14%, var(--bg)); }
+.services { max-width: 640px; margin: 0 auto; padding: 0; list-style: none; }
+.service { display: flex; align-items: center; gap: .75rem; padding: 1rem; border-bottom: 1px solid #8884; }
+.service h2 { font-size: 1.1rem; margin: 0; }
+.service p { margin: .25rem 0 0; }
+.dot { flex: 0 0 .7rem; width: .7rem; height: .7rem; border-radius: 50%; background: var(--ok); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; transform: scale(.8); } }
+@media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
+.state, .uptime { font-size: .9rem; opacity: .8; }
+a { color: inherit; }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; }
+.empty { max-width: 640px; margin: 1rem auto; }
+footer { margin-top: 2rem; font-size: .9rem; opacity: .75; }
+@media (max-width: 480px) { .service { flex-direction: column; align-items: flex-start; } }
+</style>"""
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    """Return the complete status page HTML document."""
+    services = list(services)
+    for service in services:
+        state = service["state"]
+        if state not in STATES:
+            raise ValueError(f"unknown state: {state}")
+
+    esc = lambda value: html.escape(str(value), quote=True)
+    total = len(services)
+    if total:
+        attention = sum(s["state"] in ("degraded", "outage") for s in services)
+        maintenance = sum(s["state"] == "maintenance" for s in services)
+        if attention:
+            label = "service needs attention" if attention == 1 else "services need attention"
+            banner_text = f"{attention} of {total} {label}"
+        else:
+            banner_text = "All systems operational"
+        if maintenance:
+            banner_text += f" · {maintenance} under maintenance"
+        modifier = "down" if any(s["state"] == "outage" for s in services) else (
+            "warn" if any(s["state"] == "degraded" for s in services) else "ok"
+        )
+        title = f"Status · {total - attention} of {total} operational"
+        banner = f'<div class="banner banner--{modifier}" role="status">{esc(banner_text)}</div>'
+        items = []
+        for service in sorted(services, key=lambda s: (SEVERITY[s["state"]], s["name"].casefold())):
+            name, state = service["name"], service["state"]
+            safe_name = esc(name)
+            if "url" in service:
+                url = esc(service["url"])
+                rel = ' rel="noopener"' if re.match(r"^https?://", str(service["url"]), re.I) else ""
+                heading = f'<a href="{url}"{rel}>{safe_name}</a>'
+            else:
+                heading = safe_name
+            slug = re.sub(r"[^a-z0-9]+", "-", str(name).lower()).strip("-")
+            parts = [f'<li class="service" data-state="{esc(state)}" id="service-{esc(slug)}">',
+                     '<span class="dot" aria-hidden="true"></span>', f'<h2>{heading}</h2>',
+                     f'<span class="state">{STATE_LABELS[state]}</span>']
+            if service.get("note"):
+                parts.append(f'<p class="note">{esc(service["note"])}</p>')
+            if "uptime" in service:
+                parts.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            parts.append('</li>')
+            items.append("".join(parts))
+        content = banner + '<ul class="services">' + "".join(items) + "</ul>"
+    else:
+        title = "Status · no services"
+        content = '<p class="empty">No services configured.</p>'
+
+    return (f'<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n'
+            '<meta name="viewport" content="width=device-width, initial-scale=1">\n'
+            f'<title>{esc(title)}</title>\n{CSS}\n</head>\n<body>\n<header><h1>System status</h1></header>\n'
+            f'<main>{content}</main>\n<footer><time datetime="{esc(generated_at)}">Updated {esc(generated_at)}</time></footer>\n'
+            '</body>\n</html>\n')
+
+
+def main() -> None:
+    if len(sys.argv) != 2:
+        raise SystemExit(f"usage: {sys.executable} -m app.page services.json")
+    generated_at = datetime.now(timezone.utc).isoformat()
+    print(render(load(Path(sys.argv[1])), generated_at), end="")
+
+
+if __name__ == "__main__":
+    main()
