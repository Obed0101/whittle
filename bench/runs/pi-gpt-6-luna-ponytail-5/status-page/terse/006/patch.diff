diff --git a/app/page.py b/app/page.py
new file mode 100644
index 0000000..96a1448
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,124 @@
+"""Render a self-contained public service status page."""
+import datetime
+import html
+import json
+import re
+import sys
+
+STATES = ("operational", "degraded", "outage", "maintenance")
+LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    """Return a complete, accessible HTML status page."""
+    for service in services:
+        state = service["state"]
+        if state not in STATES:
+            raise ValueError(f"unknown state: {state}")
+
+    count = len(services)
+    operational = sum(service["state"] == "operational" for service in services)
+    if not count:
+        title = "Status · no services"
+    else:
+        title = f"Status · {operational} of {count} operational"
+
+    banner = ""
+    items = ""
+    if count:
+        attention = sum(service["state"] in ("degraded", "outage") for service in services)
+        maintenance = sum(service["state"] == "maintenance" for service in services)
+        if attention:
+            message = f"{attention} of {count} services {'needs' if attention == 1 else 'need'} attention"
+        else:
+            message = "All systems operational"
+        if maintenance:
+            message += f" · {maintenance} under maintenance"
+        modifier = ("down" if any(s["state"] == "outage" for s in services)
+                    else "warn" if any(s["state"] == "degraded" for s in services)
+                    else "ok")
+        banner = f'<p class="banner banner--{modifier}" role="status">{message}</p>'
+
+        ordered = sorted(services, key=lambda s: (SEVERITY[s["state"]], s["name"].casefold()))
+        rendered = []
+        for service in ordered:
+            name = html.escape(str(service["name"]))
+            state = service["state"]
+            slug = re.sub(r"-+", "-", re.sub(r"[^\w]+", "-", str(service["name"]).lower(), flags=re.UNICODE)).strip("-")
+            heading = name
+            if service.get("url"):
+                url = html.escape(str(service["url"]), quote=True)
+                rel = ' rel="noopener"' if re.match(r"^https?://", str(service["url"]), re.I) else ""
+                heading = f'<a href="{url}"{rel}>{name}</a>'
+            note = f'<p class="note">{html.escape(str(service["note"]))}</p>' if service.get("note") else ""
+            uptime = f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>' if service.get("uptime") is not None else ""
+            rendered.append(
+                f'<li class="service" id="service-{html.escape(slug, quote=True)}" data-state="{state}">'
+                f'<span class="dot" aria-hidden="true"></span><div class="service-info">'
+                f'<h2>{heading}</h2><span class="state">{LABELS[state]}</span>{note}{uptime}</div></li>'
+            )
+        items = '<ul class="services">' + "".join(rendered) + "</ul>"
+    else:
+        items = '<p class="empty">No services configured.</p>'
+
+    timestamp = html.escape(str(generated_at), quote=True)
+    return f'''<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>{html.escape(title)}</title>
+<style>
+:root {{ --bg: #f5f7fa; --text: #182230; --ok: #18864b; --warn: #a66300; --down: #c32f36; --maint: #5367a5; }}
+@media (prefers-color-scheme: dark) {{ :root {{ --bg: #151a22; --text: #edf1f7; }} }}
+body {{ margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }}
+header, .banner, .services, .empty, footer {{ max-width: 640px; margin-left: auto; margin-right: auto; }}
+h1 {{ margin-top: 0; }}
+.banner {{ padding: 1rem; border-radius: .5rem; }}
+.banner--ok {{ background: color-mix(in srgb, var(--ok) 15%, var(--bg)); }}
+.banner--warn {{ background: color-mix(in srgb, var(--warn) 15%, var(--bg)); }}
+.banner--down {{ background: color-mix(in srgb, var(--down) 15%, var(--bg)); }}
+.services {{ list-style: none; padding: 0; display: flex; flex-direction: column; gap: .75rem; }}
+.service {{ display: flex; align-items: flex-start; gap: 1rem; padding: 1rem; border: 1px solid #8885; border-radius: .5rem; }}
+.service-info {{ flex: 1; }}
+h2 {{ display: inline; font-size: 1.1rem; margin: 0 1rem 0 0; }}
+.state, .uptime {{ font-size: .9rem; }}
+.note {{ margin: .5rem 0 0; }}
+.dot {{ width: .7rem; height: .7rem; border-radius: 50%; background: var(--text); flex: 0 0 auto; margin-top: .4rem; }}
+[data-state="operational"] .dot {{ background: var(--ok); }}
+[data-state="degraded"] .dot {{ background: var(--warn); }}
+[data-state="outage"] .dot {{ background: var(--down); animation: pulse 1.5s ease-in-out infinite; }}
+[data-state="maintenance"] .dot {{ background: var(--maint); }}
+@keyframes pulse {{ 50% {{ opacity: .35; }} }}
+@media (prefers-reduced-motion: reduce) {{ .dot {{ animation: none; }} }}
+a:focus-visible {{ outline: 3px solid var(--warn); outline-offset: 3px; }}
+footer {{ margin-top: 2rem; font-size: .9rem; }}
+@media (max-width: 480px) {{ .service {{ flex-direction: column; }} }}
+</style>
+</head>
+<body>
+<header><h1>System status</h1></header>
+{banner}
+<main>{items}</main>
+<footer><time datetime="{timestamp}">Updated {timestamp}</time></footer>
+</body>
+</html>'''
+
+
+def main() -> None:
+    from app.status import load
+
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: python -m app.page services.json")
+    generated_at = datetime.datetime.now(datetime.timezone.utc).isoformat()
+    print(render(load(sys.argv[1]), generated_at))
+
+
+if __name__ == "__main__":
+    main()
