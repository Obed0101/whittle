diff --git a/app/page.py b/app/page.py
new file mode 100644
index 0000000..18e27c1
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,107 @@
+"""Render a self-contained public service status page."""
+import html
+import json
+import re
+import sys
+from datetime import datetime, timezone
+
+from .status import load
+
+_STATE_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+_SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+_STYLE = """<style>
+:root { --bg: #f5f7fa; --text: #17212b; --ok: #218739; --warn: #a15c00; --down: #c62828; --maint: #52647a; }
+@media (prefers-color-scheme: dark) { :root { --bg: #171b21; --text: #e8edf3; } }
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, main, footer { margin: 0 auto; max-width: 640px; }
+.banner { padding: 1rem; border-radius: .5rem; margin: 1rem auto; max-width: 640px; }
+.banner--ok { background: color-mix(in srgb, var(--ok) 14%, var(--bg)); }
+.banner--warn { background: color-mix(in srgb, var(--warn) 14%, var(--bg)); }
+.banner--down { background: color-mix(in srgb, var(--down) 14%, var(--bg)); }
+.services { list-style: none; padding: 0; margin: 1rem auto; max-width: 640px; }
+.service { display: flex; align-items: center; gap: .8rem; padding: 1rem; border-bottom: 1px solid color-mix(in srgb, var(--text) 18%, transparent); }
+.dot { width: .7rem; height: .7rem; flex: 0 0 .7rem; border-radius: 50%; background: var(--ok); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; } }
+@media (prefers-reduced-motion: reduce) { [data-state="outage"] .dot { animation: none; } }
+.service h2 { margin: 0; font-size: 1.1rem; }
+.service p { margin: .35rem 0 0; }
+.details { flex: 1; }
+.state, .uptime { font-size: .9rem; }
+.state { display: block; }
+a { color: inherit; }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; }
+.empty { max-width: 640px; margin: 2rem auto; }
+footer { margin-top: 2rem; font-size: .9rem; }
+@media (max-width: 480px) { .service { flex-direction: column; align-items: flex-start; } }
+</style>"""
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    """Return a complete HTML document for the supplied service records."""
+    records = list(services)
+    for service in records:
+        state = service["state"]
+        if state not in _STATE_LABELS:
+            raise ValueError(f"unknown state: {state}")
+
+    esc = lambda value: html.escape(str(value), quote=True)
+    total = len(records)
+    if not records:
+        title = "Status · no services"
+        body = '<main><p class="empty">No services configured.</p></main>'
+    else:
+        operational = sum(s["state"] == "operational" for s in records)
+        title = f"Status · {operational} of {total} operational"
+        attention = sum(s["state"] in ("degraded", "outage") for s in records)
+        maintenance = sum(s["state"] == "maintenance" for s in records)
+        if attention:
+            noun = "service needs" if attention == 1 else "services need"
+            banner_text = f"{attention} of {total} {noun} attention"
+        else:
+            banner_text = "All systems operational"
+        if maintenance:
+            banner_text += f" · {maintenance} under maintenance"
+        modifier = "down" if any(s["state"] == "outage" for s in records) else "warn" if any(s["state"] == "degraded" for s in records) else "ok"
+        banner = f'<div class="banner banner--{modifier}" role="status">{esc(banner_text)}</div>'
+        ordered = sorted(records, key=lambda s: (_SEVERITY[s["state"]], s["name"].casefold()))
+        items = []
+        for service in ordered:
+            name, state = service["name"], service["state"]
+            slug = re.sub(r"-+", "-", re.sub(r"[^a-z0-9]+", "-", name.lower())).strip("-")
+            linked = "url" in service
+            url = esc(service["url"]) if linked else ""
+            external = bool(re.match(r"^https?://", str(service.get("url", "")), re.I))
+            heading = f'<a href="{url}"' + (' rel="noopener"' if external else "") + f'>{esc(name)}</a>' if linked else esc(name)
+            note = f'<p class="note">{esc(service["note"])}</p>' if service.get("note") else ""
+            uptime = f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>' if "uptime" in service else ""
+            items.append(f'<li class="service" id="service-{esc(slug)}" data-state="{esc(state)}"><span class="dot" aria-hidden="true"></span><div class="details"><h2>{heading}</h2><span class="state">{_STATE_LABELS[state]}</span>{note}</div>{uptime}</li>')
+        body = f'{banner}<main><ul class="services">{"".join(items)}</ul></main>'
+
+    stamp = esc(generated_at)
+    return (f'<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n'
+            '<meta name="viewport" content="width=device-width, initial-scale=1">\n'
+            f'<title>{esc(title)}</title>\n{_STYLE}\n</head>\n<body>\n<header><h1>System status</h1></header>\n'
+            f'{body}\n<footer><time datetime="{stamp}">Updated {stamp}</time></footer>\n'
+            '</body>\n</html>')
+
+
+def main() -> None:
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: python -m app.page services.json")
+    generated_at = datetime.now(timezone.utc).isoformat()
+    print(render(load(sys.argv[1]), generated_at))
+
+
+if __name__ == "__main__":
+    main()
