diff --git a/app/page.py b/app/page.py
new file mode 100644
index 0000000..f2308ce
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,124 @@
+"""Render a self-contained public service status page."""
+import html
+import re
+import sys
+from datetime import datetime, timezone
+
+from app.status import STATES, load
+
+_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+_SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _escape(value):
+    return html.escape(str(value), quote=True)
+
+
+def _slug(name):
+    slug = "".join(char.lower() if char.isalnum() else " " for char in str(name))
+    return "-".join(slug.split())
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    for service in services:
+        state = service["state"]
+        if state not in STATES:
+            raise ValueError(f"unknown state: {state}")
+
+    total = len(services)
+    operational = sum(service["state"] == "operational" for service in services)
+    if total:
+        title = f"Status · {operational} of {total} operational"
+    else:
+        title = "Status · no services"
+
+    css = """<style>
+:root { --bg: #f5f7fa; --text: #17212b; --ok: #16803c; --warn: #a45b00; --down: #c62828; --maint: #6255a5; }
+@media (prefers-color-scheme: dark) { :root { --bg: #15191e; --text: #e8edf2; --ok: #63d787; --warn: #ffc266; --down: #ff7777; --maint: #b4a8ff; } }
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, main, footer { width: 100%; max-width: 640px; margin: 0 auto; }
+h1 { margin: 0 0 1rem; }
+.banner { padding: 1rem; margin-bottom: 1rem; border-radius: .5rem; font-weight: 600; }
+.banner--ok { background: color-mix(in srgb, var(--ok) 14%, var(--bg)); }
+.banner--warn { background: color-mix(in srgb, var(--warn) 14%, var(--bg)); }
+.banner--down { background: color-mix(in srgb, var(--down) 14%, var(--bg)); }
+.services { display: flex; flex-direction: column; gap: .75rem; margin: 0; padding: 0; list-style: none; }
+.service { display: flex; align-items: center; gap: .75rem; padding: 1rem; border: 1px solid #8885; border-radius: .5rem; }
+.dot { flex: 0 0 .7rem; width: .7rem; height: .7rem; border-radius: 50%; background: var(--text); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; } }
+@media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
+.service-content { flex: 1; min-width: 0; }
+.service h2 { margin: 0; font-size: 1.1rem; }
+.service a { color: inherit; }
+a:focus-visible { outline: 3px solid currentColor; outline-offset: 3px; }
+.state, .uptime { font-size: .9rem; }
+.note { margin: .35rem 0 0; }
+.empty { text-align: center; padding: 2rem 0; }
+footer { margin-top: 1.5rem; font-size: .875rem; opacity: .8; }
+@media (max-width: 480px) { .service { flex-direction: column; align-items: flex-start; } }
+</style>"""
+    parts = [
+        '<!doctype html>', '<html lang="en">', '<head>',
+        '<meta charset="utf-8">',
+        '<meta name="viewport" content="width=device-width, initial-scale=1">',
+        f'<title>{_escape(title)}</title>', css, '</head>', '<body>',
+        '<header><h1>System status</h1></header>', '<main>',
+    ]
+    if total:
+        attention = sum(service["state"] in ("degraded", "outage") for service in services)
+        maintenance = sum(service["state"] == "maintenance" for service in services)
+        if attention:
+            banner_text = f"{attention} of {total} services {'needs' if attention == 1 else 'need'} attention"
+        else:
+            banner_text = "All systems operational"
+        if maintenance:
+            banner_text += f" · {maintenance} under maintenance"
+        modifier = "down" if any(s["state"] == "outage" for s in services) else (
+            "warn" if any(s["state"] == "degraded" for s in services) else "ok"
+        )
+        parts.append(f'<div class="banner banner--{modifier}" role="status">{_escape(banner_text)}</div>')
+        parts.append('<ul class="services">')
+        ordered = sorted(services, key=lambda service: (_SEVERITY[service["state"]], str(service["name"]).casefold()))
+        for service in ordered:
+            name = _escape(service["name"])
+            state = service["state"]
+            parts.append(f'<li class="service" id="service-{_escape(_slug(service["name"]))}" data-state="{_escape(state)}">')
+            parts.append('<span class="dot" aria-hidden="true"></span><div class="service-content"><h2>')
+            if service.get("url"):
+                url = _escape(service["url"])
+                rel = ' rel="noopener"' if re.match(r"^https?://", str(service["url"]), re.IGNORECASE) else ""
+                parts.append(f'<a href="{url}"{rel}>{name}</a>')
+            else:
+                parts.append(name)
+            parts.append(f'</h2><span class="state">{_LABELS[state]}</span>')
+            if service.get("note"):
+                parts.append(f'<p class="note">{_escape(service["note"])}</p>')
+            if service.get("uptime") is not None:
+                parts.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            parts.append('</div></li>')
+        parts.append('</ul>')
+    else:
+        parts.append('<p class="empty">No services configured.</p>')
+    parts.extend(['</main>', f'<footer><time datetime="{_escape(generated_at)}">Updated {_escape(generated_at)}</time></footer>', '</body>', '</html>'])
+    return '\n'.join(parts)
+
+
+def main():
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: python -m app.page services.json")
+    generated_at = datetime.now(timezone.utc).isoformat()
+    print(render(load(sys.argv[1]), generated_at))
+
+
+if __name__ == "__main__":
+    main()
