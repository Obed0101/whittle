@@ -0,0 +1,130 @@
+"""Render service data as a self-contained public status page."""
+import html
+import re
+import sys
+from datetime import datetime, timezone
+
+from app.status import STATES, load
+
+_STATE_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+_SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _escape(value):
+    return html.escape(str(value), quote=True)
+
+
+def _slug(name):
+    pieces = []
+    separating = False
+    for char in name.lower():
+        if char.isalnum():
+            pieces.append(char)
+            separating = False
+        elif pieces and not separating:
+            pieces.append("-")
+            separating = True
+    if pieces and pieces[-1] == "-":
+        pieces.pop()
+    return "".join(pieces)
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    for service in services:
+        state = service["state"]
+        if state not in STATES:
+            raise ValueError(f"unknown state: {state}")
+
+    total = len(services)
+    operational = sum(service["state"] == "operational" for service in services)
+    title = f"Status · {operational} of {total} operational" if total else "Status · no services"
+    css = """<style>
+:root { --bg: #f5f7fa; --text: #182230; --ok: #16803c; --warn: #a45b00; --down: #c62828; --maint: #526477; }
+@media (prefers-color-scheme: dark) { :root { --bg: #151a21; --text: #e7edf5; } }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, main, footer { margin: 0 auto; max-width: 640px; }
+.banner { padding: 1rem; border-radius: .5rem; margin: 1rem 0; }
+.banner--ok { background: color-mix(in srgb, var(--ok) 14%, var(--bg)); }
+.banner--warn { background: color-mix(in srgb, var(--warn) 14%, var(--bg)); }
+.banner--down { background: color-mix(in srgb, var(--down) 14%, var(--bg)); }
+.services { max-width: 640px; margin: 1rem auto; padding: 0; list-style: none; }
+.service { display: flex; align-items: center; gap: .8rem; padding: 1rem; border-bottom: 1px solid #8885; }
+.service h2 { margin: 0; font-size: 1.1rem; }
+.service-content { flex: 1; }
+.dot { width: .7rem; height: .7rem; flex: none; border-radius: 50%; background: var(--ok); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+.state, .uptime { font-size: .9rem; }
+.note { margin: .4rem 0 0; }
+a { color: inherit; }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; }
+.empty { max-width: 640px; margin: 2rem auto; }
+footer { margin-top: 2rem; font-size: .9rem; }
+@keyframes pulse { 50% { opacity: .35; } }
+@media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
+@media (max-width: 480px) { .service { flex-direction: column; align-items: flex-start; } }
+</style>"""
+    parts = [
+        "<!doctype html>", '<html lang="en">', "<head>",
+        '<meta charset="utf-8">', '<meta name="viewport" content="width=device-width, initial-scale=1">',
+        f"<title>{_escape(title)}</title>", css, "</head>", "<body>",
+        "<header><h1>System status</h1></header>", "<main>",
+    ]
+
+    if total:
+        attention = sum(service["state"] in ("degraded", "outage") for service in services)
+        maintenance = sum(service["state"] == "maintenance" for service in services)
+        if not attention:
+            message = "All systems operational"
+        else:
+            verb = "needs" if attention == 1 else "need"
+            message = f"{attention} of {total} services {verb} attention"
+        if maintenance:
+            message += f" · {maintenance} under maintenance"
+        modifier = "down" if any(s["state"] == "outage" for s in services) else (
+            "warn" if any(s["state"] == "degraded" for s in services) else "ok"
+        )
+        parts.append(f'<div class="banner banner--{modifier}" role="status">{_escape(message)}</div>')
+        parts.append('<ul class="services">')
+        ordered = sorted(services, key=lambda s: (_SEVERITY[s["state"]], s["name"].casefold()))
+        for service in ordered:
+            state = service["state"]
+            name = _escape(service["name"])
+            parts.append(f'<li class="service" id="service-{_escape(_slug(service["name"]))}" data-state="{_escape(state)}">')
+            parts.append('<span class="dot" aria-hidden="true"></span><div class="service-content"><h2>')
+            if service.get("url"):
+                url = _escape(service["url"])
+                rel = ' rel="noopener"' if re.match(r"^https?://", str(service["url"]), re.I) else ""
+                parts.append(f'<a href="{url}"{rel}>{name}</a>')
+            else:
+                parts.append(name)
+            parts.append(f'</h2><span class="state">{_STATE_LABELS[state]}</span>')
+            if service.get("note"):
+                parts.append(f'<p class="note">{_escape(service["note"])}</p>')
+            if service.get("uptime") is not None:
+                parts.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            parts.append('</div></li>')
+        parts.append('</ul>')
+    else:
+        parts.append('<p class="empty">No services configured.</p>')
+
+    parts.extend(["</main>", f'<footer><time datetime="{_escape(generated_at)}">Updated {_escape(generated_at)}</time></footer>', "</body>", "</html>"])
+    return "\n".join(parts)
+
+
+def main():
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: python -m app.page services.json")
+    generated_at = datetime.now(timezone.utc).isoformat()
+    print(render(load(sys.argv[1]), generated_at))
+
+
+if __name__ == "__main__":
+    main()
