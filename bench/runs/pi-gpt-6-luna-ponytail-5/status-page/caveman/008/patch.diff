+"""Render a self-contained public service status page."""
+import argparse
+from datetime import datetime, timezone
+import html
+import json
+import re
+
+
+STATE_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _escape(value):
+    return html.escape(str(value), quote=True)
+
+
+def _slug(name):
+    parts = []
+    separating = False
+    for char in name.lower():
+        if char.isalnum():
+            parts.append(char)
+            separating = False
+        elif parts and not separating:
+            parts.append("-")
+            separating = True
+    return "".join(parts).rstrip("-")
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    for service in services:
+        state = service["state"]
+        if state not in STATE_LABELS:
+            raise ValueError(f"unknown state: {state}")
+
+    total = len(services)
+    operational = sum(service["state"] == "operational" for service in services)
+    title = f"Status · {operational} of {total} operational" if total else "Status · no services"
+    css = """<style>
+:root { --bg: #f5f7fa; --text: #17212b; --ok: #16803c; --warn: #a45b00; --down: #c62828; --maint: #52677d; }
+@media (prefers-color-scheme: dark) { :root { --bg: #151a20; --text: #edf2f7; } }
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, main, footer { max-width: 640px; margin: 0 auto; }
+h1 { margin-top: 0; }
+.banner { padding: 1rem; border-radius: .5rem; margin-bottom: 1rem; }
+.banner--ok { background: color-mix(in srgb, var(--ok) 14%, var(--bg)); }
+.banner--warn { background: color-mix(in srgb, var(--warn) 14%, var(--bg)); }
+.banner--down { background: color-mix(in srgb, var(--down) 14%, var(--bg)); }
+.services { max-width: 640px; margin: 0 auto; padding: 0; list-style: none; }
+.service { display: flex; align-items: center; gap: 1rem; padding: 1rem; border-bottom: 1px solid #8885; }
+.dot { width: .75rem; height: .75rem; flex: 0 0 .75rem; border-radius: 50%; background: var(--maint); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; } }
+@media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
+.service h2 { margin: 0; font-size: 1.1rem; }
+.state, .uptime { font-size: .9rem; }
+.note { margin: .35rem 0 0; }
+a { color: inherit; }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; }
+.empty { max-width: 640px; margin: 0 auto; }
+footer { margin-top: 2rem; font-size: .9rem; }
+@media (max-width: 480px) { .service { flex-direction: column; align-items: flex-start; } }
+</style>"""
+    lines = ["<!doctype html>", '<html lang="en">', "<head>", '<meta charset="utf-8">', '<meta name="viewport" content="width=device-width, initial-scale=1">', f"<title>{_escape(title)}</title>", css, "</head>", "<body>", "<header><h1>System status</h1></header>"]
+    if total:
+        attention = sum(service["state"] in ("degraded", "outage") for service in services)
+        maintenance = sum(service["state"] == "maintenance" for service in services)
+        if attention:
+            banner = f"{attention} of {total} services need{'s' if attention == 1 else ''} attention"
+        else:
+            banner = "All systems operational"
+        if maintenance:
+            banner += f" · {maintenance} under maintenance"
+        modifier = "down" if any(s["state"] == "outage" for s in services) else "warn" if any(s["state"] == "degraded" for s in services) else "ok"
+        lines.append(f'<div class="banner banner--{modifier}" role="status">{_escape(banner)}</div>')
+        lines.append('<main><ul class="services">')
+        ordered = sorted(services, key=lambda s: (SEVERITY[s["state"]], s["name"].casefold()))
+        for service in ordered:
+            state = service["state"]
+            name = _escape(service["name"])
+            url = service.get("url")
+            name_html = name
+            if url:
+                rel = ' rel="noopener"' if re.match(r"^https?://", str(url), re.IGNORECASE) else ""
+                name_html = f'<a href="{_escape(url)}"{rel}>{name}</a>'
+            lines.append(f'<li class="service" id="service-{_escape(_slug(service["name"]))}" data-state="{_escape(state)}"><span class="dot" aria-hidden="true"></span><div><h2>{name_html}</h2><span class="state">{STATE_LABELS[state]}</span>')
+            if service.get("note"):
+                lines.append(f'<p class="note">{_escape(service["note"])}</p>')
+            if service.get("uptime") is not None:
+                lines.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            lines.append("</div></li>")
+        lines.append("</ul></main>")
+    else:
+        lines.append('<main><p class="empty">No services configured.</p></main>')
+    stamp = _escape(generated_at)
+    lines.extend([f'<footer><time datetime="{stamp}">Updated {stamp}</time></footer>', "</body>", "</html>"])
+    return "\n".join(lines)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("services_json")
+    args = parser.parse_args()
+    with open(args.services_json, encoding="utf-8") as handle:
+        services = json.load(handle)
+    generated_at = datetime.now(timezone.utc).isoformat()
+    print(render(services, generated_at))
+
+
+if __name__ == "__main__":
+    main()
