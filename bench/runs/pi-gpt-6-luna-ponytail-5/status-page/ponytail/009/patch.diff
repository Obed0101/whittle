diff --git a/app/page.py b/app/page.py
new file mode 100644
index 0000000..f661339
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,123 @@
+"""Render a self-contained public service status page."""
+import html
+import json
+import re
+import sys
+from datetime import datetime, timezone
+
+from app.status import STATES
+
+LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    counts = {state: 0 for state in STATES}
+    for service in services:
+        state = service["state"]
+        if state not in STATES:
+            raise ValueError(f"unknown state: {state}")
+        counts[state] += 1
+
+    total = len(services)
+    if counts["outage"]:
+        modifier = "down"
+    elif counts["degraded"]:
+        modifier = "warn"
+    else:
+        modifier = "ok"
+
+    if total:
+        attention = counts["outage"] + counts["degraded"]
+        if not attention:
+            banner = "All systems operational"
+        else:
+            verb = "needs" if attention == 1 else "need"
+            banner = f"{attention} of {total} services {verb} attention"
+        if counts["maintenance"]:
+            n = counts["maintenance"]
+            banner += f" · {n} under maintenance"
+        title = f"Status · {counts['operational']} of {total} operational"
+    else:
+        title = "Status · no services"
+
+    e = lambda value: html.escape(str(value), quote=True)
+    items = []
+    for service in sorted(services, key=lambda s: (SEVERITY[s["state"]], s["name"].casefold())):
+        state = service["state"]
+        name = e(service["name"])
+        slug = re.sub(r"-+", "-", re.sub(r"[^\w]+", "-", service["name"].lower(), flags=re.UNICODE)).strip("-")
+        if service.get("url"):
+            url = e(service["url"])
+            rel = ' rel="noopener"' if re.match(r"^https?://", service["url"], re.I) else ""
+            name = f'<a href="{url}"{rel}>{name}</a>'
+        note = f'<p class="note">{e(service["note"])}</p>' if service.get("note") else ""
+        uptime = f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>' if service.get("uptime") is not None else ""
+        items.append(
+            f'<li class="service" id="service-{e(slug)}" data-state="{e(state)}">'
+            '<span class="dot" aria-hidden="true"></span>'
+            f'<div class="details"><h2>{name}</h2><span class="state">{LABELS[state]}</span>{note}</div>{uptime}</li>'
+        )
+
+    content = (f'<div class="banner banner--{modifier}" role="status">{e(banner)}</div>' if total else '')
+    content += f'<ul class="services">{"".join(items)}</ul>' if total else '<p class="empty">No services configured.</p>'
+    return f'''<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>{e(title)}</title>
+<style>
+:root {{ --bg: #f5f7fa; --text: #17212b; --ok: #20834a; --warn: #a86600; --down: #bd2929; --maint: #5366a5; }}
+@media (prefers-color-scheme: dark) {{ :root {{ --bg: #151a20; --text: #edf1f5; }} }}
+* {{ box-sizing: border-box; }}
+body {{ margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }}
+header, main, footer {{ max-width: 640px; margin: 0 auto; }}
+h1 {{ margin: 0 0 1rem; }}
+.banner {{ padding: 1rem; border-radius: .5rem; margin-bottom: 1rem; }}
+.banner--ok {{ background: color-mix(in srgb, var(--ok) 14%, transparent); }}
+.banner--warn {{ background: color-mix(in srgb, var(--warn) 14%, transparent); }}
+.banner--down {{ background: color-mix(in srgb, var(--down) 14%, transparent); }}
+.services {{ list-style: none; padding: 0; margin: 0 auto; max-width: 640px; }}
+.service {{ display: flex; align-items: center; gap: 1rem; padding: 1rem; border-bottom: 1px solid #8885; }}
+.dot {{ width: .75rem; height: .75rem; border-radius: 50%; flex: none; background: var(--ok); }}
+[data-state="operational"] .dot {{ background: var(--ok); }}
+[data-state="degraded"] .dot {{ background: var(--warn); }}
+[data-state="outage"] .dot {{ background: var(--down); animation: pulse 1.5s ease-in-out infinite; }}
+[data-state="maintenance"] .dot {{ background: var(--maint); }}
+@keyframes pulse {{ 50% {{ opacity: .35; }} }}
+@media (prefers-reduced-motion: reduce) {{ .dot {{ animation: none; }} }}
+.details {{ flex: 1; }}
+h2 {{ font-size: 1rem; margin: 0; }}
+.state, .uptime, .note {{ font-size: .9rem; }}
+.note {{ margin: .35rem 0 0; }}
+a {{ color: inherit; }}
+a:focus-visible {{ outline: 3px solid var(--warn); outline-offset: 3px; }}
+.empty {{ text-align: center; }}
+footer {{ margin: 2rem auto 0; font-size: .85rem; }}
+@media (max-width: 480px) {{ .service {{ flex-direction: column; align-items: flex-start; }} }}
+</style>
+</head>
+<body>
+<header><h1>System status</h1></header>
+<main>{content}</main>
+<footer><time datetime="{e(generated_at)}">Updated {e(generated_at)}</time></footer>
+</body>
+</html>'''
+
+
+def main() -> None:
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: python -m app.page services.json")
+    with open(sys.argv[1], encoding="utf-8") as handle:
+        services = json.load(handle)
+    print(render(services, datetime.now(timezone.utc).isoformat()))
+
+
+if __name__ == "__main__":
+    main()
