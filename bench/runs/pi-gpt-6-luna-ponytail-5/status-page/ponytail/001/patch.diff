@@ -0,0 +1,111 @@
+"""Render a self-contained public service status page."""
+import html
+import json
+import re
+import sys
+from datetime import datetime, timezone
+
+from .status import STATES, load
+
+LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _escape(value):
+    return html.escape(str(value), quote=True)
+
+
+def _service_id(name):
+    result = []
+    separator = False
+    for char in name.lower():
+        if char.isalnum():
+            if separator and result:
+                result.append("-")
+            result.append(char)
+            separator = False
+        else:
+            separator = True
+    return "".join(result)
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    for service in services:
+        if service["state"] not in STATES:
+            raise ValueError(f"unknown state: {service['state']}")
+
+    count = len(services)
+    operational = sum(service["state"] == "operational" for service in services)
+    attention = sum(service["state"] in ("degraded", "outage") for service in services)
+    maintenance = sum(service["state"] == "maintenance" for service in services)
+    if not count:
+        title = "Status · no services"
+    else:
+        title = f"Status · {operational} of {count} operational"
+
+    parts = [
+        "<!doctype html>",
+        '<html lang="en"><head><meta charset="utf-8">',
+        '<meta name="viewport" content="width=device-width, initial-scale=1">',
+        f"<title>{_escape(title)}</title>",
+        """<style>
+:root { --bg: #f6f8fa; --text: #182230; --ok: #16803c; --warn: #a15c00; --down: #c62828; --maint: #5365a5; }
+@media (prefers-color-scheme: dark) { :root { --bg: #141922; --text: #edf1f7; } }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, .banner, main, footer { max-width: 640px; margin: 0 auto 1rem; }
+.banner { padding: 1rem; border-radius: .5rem; }
+.banner--ok { background: color-mix(in srgb, var(--ok) 15%, var(--bg)); }
+.banner--warn { background: color-mix(in srgb, var(--warn) 15%, var(--bg)); }
+.banner--down { background: color-mix(in srgb, var(--down) 15%, var(--bg)); }
+.services { max-width: 640px; margin: 0 auto; padding: 0; list-style: none; }
+.service { display: flex; align-items: center; gap: .75rem; padding: 1rem; border-bottom: 1px solid #8885; }
+.service h2 { margin: 0; font-size: 1.1rem; }
+.service p { margin: .25rem 0 0; }
+.dot { flex: 0 0 .7rem; width: .7rem; height: .7rem; border-radius: 50%; background: var(--text); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; } }
+@media (prefers-reduced-motion: reduce) { .dot { animation: none !important; } }
+@media (max-width: 480px) { .service { flex-direction: column; align-items: flex-start; } }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; }
+footer { margin-top: 2rem; color: #778; font-size: .9rem; }
+</style></head><body><header><h1>System status</h1></header>""",
+    ]
+    if count:
+        modifier = "down" if any(s["state"] == "outage" for s in services) else "warn" if any(s["state"] == "degraded" for s in services) else "ok"
+        if attention:
+            banner = f"{attention} of {count} services need{'s' if attention == 1 else ''} attention"
+        else:
+            banner = "All systems operational"
+        if maintenance:
+            banner += f" · {maintenance} under maintenance"
+        parts.append(f'<div class="banner banner--{modifier}" role="status">{_escape(banner)}</div>')
+        parts.append('<main><ul class="services">')
+        for service in sorted(services, key=lambda s: (SEVERITY[s["state"]], s["name"].casefold())):
+            state = service["state"]
+            name = _escape(service["name"])
+            url = service.get("url")
+            heading = f'<a href="{_escape(url)}"' + (' rel="noopener"' if re.match(r"^https?://", str(url), re.I) else "") + f">{name}</a>" if url else name
+            parts.append(f'<li class="service" id="service-{_escape(_service_id(service["name"]))}" data-state="{_escape(state)}"><span class="dot" aria-hidden="true"></span><div><h2>{heading}</h2><span class="state">{LABELS[state]}</span>')
+            if service.get("note"):
+                parts.append(f'<p class="note">{_escape(service["note"])}</p>')
+            if service.get("uptime") is not None:
+                parts.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            parts.append("</div></li>")
+        parts.append("</ul></main>")
+    else:
+        parts.append('<main><p class="empty">No services configured.</p></main>')
+    parts.append(f'<footer><time datetime="{_escape(generated_at)}">Updated {_escape(generated_at)}</time></footer></body></html>')
+    return "\n".join(parts)
+
+
+if __name__ == "__main__":
+    services = load(sys.argv[1])
+    print(render(services, datetime.now(timezone.utc).isoformat()))
