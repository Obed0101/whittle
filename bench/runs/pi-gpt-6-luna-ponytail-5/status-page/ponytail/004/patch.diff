+++ b/app/page.py
@@ -0,0 +1,114 @@
+"""Render a self-contained public service status page."""
+import html
+import json
+import re
+import sys
+from datetime import datetime, timezone
+
+STATES = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _escape(value):
+    return html.escape(str(value), quote=True)
+
+
+def _slug(name):
+    result = []
+    separator = False
+    for char in name.lower():
+        if char.isalnum():
+            result.append(char)
+            separator = False
+        elif result and not separator:
+            result.append("-")
+            separator = True
+    return "".join(result).rstrip("-")
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    for service in services:
+        if service["state"] not in STATES:
+            raise ValueError(f"unknown state: {service['state']}")
+
+    total = len(services)
+    operational = sum(service["state"] == "operational" for service in services)
+    if not total:
+        title = "Status · no services"
+    else:
+        title = f"Status · {operational} of {total} operational"
+
+    styles = """<style>
+:root { --bg: #fff; --text: #202a35; --ok: #16803c; --warn: #a65a00; --down: #bd2525; --maint: #596579; }
+@media (prefers-color-scheme: dark) { :root { --bg: #151a21; --text: #e8edf4; } }
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, .banner, main, footer { max-width: 640px; margin: 0 auto 1rem; }
+h1 { margin: 0 0 1rem; }
+.banner { padding: .8rem 1rem; border-radius: .5rem; }
+.banner--ok { background: color-mix(in srgb, var(--ok) 12%, var(--bg)); }
+.banner--warn { background: color-mix(in srgb, var(--warn) 12%, var(--bg)); }
+.banner--down { background: color-mix(in srgb, var(--down) 12%, var(--bg)); }
+.services { max-width: 640px; margin: 0 auto; padding: 0; list-style: none; }
+.service { display: flex; align-items: center; gap: .75rem; padding: 1rem; border-bottom: 1px solid #8885; }
+.dot { width: .7rem; height: .7rem; flex: none; border-radius: 50%; background: var(--ok); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; } }
+@media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
+.service h2 { margin: 0; font-size: 1.1rem; }
+.service p { margin: .25rem 0 0; }
+.service-info { flex: 1; }
+.state, .uptime { font-size: .9rem; }
+a { color: inherit; }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; }
+.empty { max-width: 640px; margin: 2rem auto; }
+footer { margin-top: 2rem; font-size: .9rem; }
+@media (max-width: 480px) { .service { flex-direction: column; align-items: flex-start; } }
+</style>"""
+    parts = ["<!doctype html>", '<html lang="en"><head><meta charset="utf-8">',
+             '<meta name="viewport" content="width=device-width, initial-scale=1">',
+             f"<title>{_escape(title)}</title>", styles, "</head><body>",
+             "<header><h1>System status</h1></header>"]
+    if total:
+        attention = sum(service["state"] in ("degraded", "outage") for service in services)
+        maintenance = sum(service["state"] == "maintenance" for service in services)
+        modifier = "down" if any(s["state"] == "outage" for s in services) else "warn" if any(s["state"] == "degraded" for s in services) else "ok"
+        if attention:
+            banner = f"{attention} of {total} services {'needs' if attention == 1 else 'need'} attention"
+        else:
+            banner = "All systems operational"
+        if maintenance:
+            banner += f" · {maintenance} under maintenance"
+        parts.append(f'<div class="banner banner--{modifier}" role="status">{_escape(banner)}</div>')
+        parts.append('<main><ul class="services">')
+        for service in sorted(services, key=lambda s: (SEVERITY[s["state"]], s["name"].casefold())):
+            state = service["state"]
+            name = _escape(service["name"])
+            url = service.get("url")
+            heading = f'<a href="{_escape(url)}"' + (' rel="noopener"' if re.match(r"^https?://", str(url), re.I) else "") + f">{name}</a>" if url else name
+            parts.append(f'<li class="service" id="service-{_escape(_slug(str(service["name"]))) }" data-state="{state}"><span class="dot" aria-hidden="true"></span><div class="service-info"><h2>{heading}</h2><span class="state">{STATES[state]}</span>')
+            if service.get("note"):
+                parts.append(f'<p class="note">{_escape(service["note"])}</p>')
+            if service.get("uptime") is not None:
+                parts.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            parts.append("</div></li>")
+        parts.append("</ul></main>")
+    else:
+        parts.append('<p class="empty">No services configured.</p>')
+    escaped_time = _escape(generated_at)
+    parts.append(f'<footer><time datetime="{escaped_time}">Updated {escaped_time}</time></footer></body></html>')
+    return "\n".join(parts)
+
+
+if __name__ == "__main__":
+    with open(sys.argv[1], encoding="utf-8") as handle:
+        records = json.load(handle)
+    print(render(records, datetime.now(timezone.utc).isoformat()))
