diff --git a/app/page.py b/app/page.py
new file mode 100644
index 0000000..270d52b
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,107 @@
+"""Render a self-contained public service status page."""
+import html
+import json
+import re
+import sys
+from datetime import datetime, timezone
+
+from app.status import STATES, load
+
+LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    for service in services:
+        if service["state"] not in STATES:
+            raise ValueError(f"unknown state: {service['state']}")
+
+    total = len(services)
+    counts = {state: sum(s["state"] == state for s in services) for state in STATES}
+    attention = counts["degraded"] + counts["outage"]
+    if not total:
+        title = "Status · no services"
+        banner = ""
+    else:
+        title = f"Status · {counts['operational']} of {total} operational"
+        modifier = "down" if counts["outage"] else "warn" if counts["degraded"] else "ok"
+        if attention:
+            text = f"{attention} of {total} services {'needs' if attention == 1 else 'need'} attention"
+        else:
+            text = "All systems operational"
+        if counts["maintenance"]:
+            text += f" · {counts['maintenance']} under maintenance"
+        banner = f'<p class="banner banner--{modifier}" role="status">{text}</p>'
+
+    items = []
+    for service in sorted(services, key=lambda s: (SEVERITY[s["state"]], s["name"].casefold())):
+        state = service["state"]
+        name = html.escape(str(service["name"]))
+        slug = re.sub(r"[^\w]+", "-", str(service["name"]).lower(), flags=re.UNICODE).strip("-_")
+        url = service.get("url")
+        heading = f'<a href="{html.escape(str(url), quote=True)}"' + (' rel="noopener"' if re.match(r"https?://", str(url), re.I) else "") + f">{name}</a>" if url else name
+        note = f'<p class="note">{html.escape(str(service["note"]))}</p>' if service.get("note") else ""
+        uptime = f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>' if service.get("uptime") is not None else ""
+        items.append(
+            f'<li class="service" id="service-{html.escape(slug, quote=True)}" data-state="{state}">'
+            f'<span class="dot" aria-hidden="true"></span><div class="details"><h2>{heading}</h2>'
+            f'<span class="state">{LABELS[state]}</span>{note}{uptime}</div></li>'
+        )
+    content = f'<ul class="services">{"".join(items)}</ul>' if total else '<p class="empty">No services configured.</p>'
+    return f'''<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>{html.escape(title)}</title>
+<style>
+:root {{ --bg: #f5f7fa; --text: #172033; --ok: #218739; --warn: #b36b00; --down: #c62828; --maint: #53657d; }}
+@media (prefers-color-scheme: dark) {{ :root {{ --bg: #121821; --text: #e8edf4; }} }}
+* {{ box-sizing: border-box; }}
+body {{ margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }}
+header, main, footer {{ max-width: 640px; margin: 0 auto; }}
+h1 {{ font-size: 1.8rem; }}
+.banner {{ padding: 1rem; border-radius: .5rem; }}
+.banner--ok {{ background: color-mix(in srgb, var(--ok) 14%, var(--bg)); }}
+.banner--warn {{ background: color-mix(in srgb, var(--warn) 14%, var(--bg)); }}
+.banner--down {{ background: color-mix(in srgb, var(--down) 14%, var(--bg)); }}
+.services {{ max-width: 640px; margin: 1.5rem auto; padding: 0; list-style: none; }}
+.service {{ display: flex; align-items: flex-start; gap: 1rem; padding: 1rem; margin-bottom: .75rem; border: 1px solid #8792a033; border-radius: .5rem; }}
+.dot {{ width: .75rem; height: .75rem; flex: 0 0 .75rem; margin-top: .45rem; border-radius: 50%; background: var(--ok); }}
+[data-state="operational"] .dot {{ background: var(--ok); }}
+[data-state="degraded"] .dot {{ background: var(--warn); }}
+[data-state="outage"] .dot {{ background: var(--down); animation: pulse 1.5s infinite; }}
+[data-state="maintenance"] .dot {{ background: var(--maint); }}
+@keyframes pulse {{ 50% {{ opacity: .35; }} }}
+@media (prefers-reduced-motion: reduce) {{ .dot {{ animation: none !important; }} }}
+.details {{ flex: 1; }}
+h2 {{ margin: 0 0 .25rem; font-size: 1.1rem; }}
+a {{ color: inherit; }}
+a:focus-visible {{ outline: 3px solid var(--warn); outline-offset: 3px; }}
+.state, .uptime {{ font-size: .9rem; }}
+.note {{ margin: .5rem 0; }}
+.uptime {{ display: block; }}
+footer {{ margin-top: 2rem; font-size: .85rem; }}
+@media (max-width: 480px) {{ .service {{ flex-direction: column; }} }}
+</style>
+</head>
+<body>
+<header><h1>System status</h1></header>
+<main>{banner}{content}</main>
+<footer><time datetime="{html.escape(generated_at, quote=True)}">Updated {html.escape(generated_at)}</time></footer>
+</body>
+</html>'''
+
+
+def main() -> None:
+    services = load(sys.argv[1])
+    print(render(services, datetime.now(timezone.utc).isoformat()))
+
+
+if __name__ == "__main__":
+    main()
