index 0000000..1afab2b
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,111 @@
+"""Render a standalone public status page."""
+import html
+import json
+import re
+import sys
+from datetime import datetime, timezone
+
+from app.status import STATES, load
+
+LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _escape(value):
+    return html.escape(str(value), quote=True)
+
+
+def _slug(name):
+    return re.sub(r"-+", "-", "".join(c.lower() if c.isalnum() else "-" for c in name)).strip("-")
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    for service in services:
+        if service["state"] not in STATES:
+            raise ValueError(f"unknown state: {service['state']}")
+
+    total = len(services)
+    counts = {state: sum(s["state"] == state for s in services) for state in STATES}
+    if total:
+        attention = counts["outage"] + counts["degraded"]
+        if not attention:
+            banner_text = "All systems operational"
+        else:
+            banner_text = f"{attention} of {total} services need{'s' if attention == 1 else ''} attention"
+        if counts["maintenance"]:
+            banner_text += f" · {counts['maintenance']} under maintenance"
+        modifier = "down" if counts["outage"] else "warn" if counts["degraded"] else "ok"
+        banner = f'<p class="banner banner--{modifier}" role="status">{_escape(banner_text)}</p>'
+        title = f"Status · {counts['operational']} of {total} operational"
+        items = []
+        for service in sorted(services, key=lambda s: (SEVERITY[s["state"]], s["name"].casefold())):
+            state, name = service["state"], service["name"]
+            url = service.get("url")
+            if url is None:
+                heading = f"<h2>{_escape(name)}</h2>"
+            else:
+                rel = ' rel="noopener"' if re.match(r"https?://", str(url), re.I) else ""
+                heading = f'<h2><a href="{_escape(url)}"{rel}>{_escape(name)}</a></h2>'
+            note = f'<p class="note">{_escape(service["note"])}</p>' if service.get("note") else ""
+            uptime = f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>' if service.get("uptime") is not None else ""
+            items.append(
+                f'<li class="service" id="service-{_escape(_slug(name))}" data-state="{_escape(state)}">'
+                f'<span class="dot" aria-hidden="true"></span>{heading}'
+                f'<span class="state">{LABELS[state]}</span>{note}{uptime}</li>'
+            )
+        content = banner + '<main><ul class="services">' + "".join(items) + "</ul></main>"
+    else:
+        title = "Status · no services"
+        content = '<main><p class="empty">No services configured.</p></main>'
+
+    stamp = _escape(generated_at)
+    return f'''<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>{_escape(title)}</title>
+<style>
+:root {{ --bg: #f5f7fa; --text: #18212b; --ok: #16834a; --warn: #a96700; --down: #c62828; --maint: #52627a; }}
+@media (prefers-color-scheme: dark) {{ :root {{ --bg: #151a21; --text: #edf2f7; }} }}
+body {{ margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }}
+header, .banner, .services, .empty, footer {{ max-width: 640px; margin-left: auto; margin-right: auto; }}
+h1 {{ margin-top: 0; }}
+.banner {{ padding: 1rem; border-radius: .5rem; }}
+.banner--ok {{ background: color-mix(in srgb, var(--ok) 14%, var(--bg)); }}
+.banner--warn {{ background: color-mix(in srgb, var(--warn) 14%, var(--bg)); }}
+.banner--down {{ background: color-mix(in srgb, var(--down) 14%, var(--bg)); }}
+.services {{ list-style: none; padding: 0; }}
+.service {{ display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; padding: 1rem; border-bottom: 1px solid #8885; }}
+.service h2 {{ margin: 0; font-size: 1.1rem; }}
+.service .note {{ flex-basis: 100%; margin: 0; }}
+.dot {{ width: .7rem; height: .7rem; border-radius: 50%; background: var(--ok); flex: 0 0 auto; }}
+[data-state="operational"] .dot {{ background: var(--ok); }}
+[data-state="degraded"] .dot {{ background: var(--warn); }}
+[data-state="outage"] .dot {{ background: var(--down); animation: pulse 1.5s ease-in-out infinite; }}
+[data-state="maintenance"] .dot {{ background: var(--maint); }}
+@keyframes pulse {{ 50% {{ opacity: .35; }} }}
+@media (prefers-reduced-motion: reduce) {{ .dot {{ animation: none !important; }} }}
+a {{ color: inherit; }}
+a:focus-visible {{ outline: 3px solid var(--warn); outline-offset: 3px; }}
+footer {{ margin-top: 2rem; opacity: .75; }}
+@media (max-width: 480px) {{ .service {{ flex-direction: column; align-items: flex-start; }} }}
+</style>
+</head>
+<body>
+<header><h1>System status</h1></header>
+{content}
+<footer><time datetime="{stamp}">Updated {stamp}</time></footer>
+</body>
+</html>'''
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: python -m app.page services.json")
+    print(render(load(sys.argv[1]), datetime.now(timezone.utc).isoformat()))
