diff --git a/app/page.py b/app/page.py
new file mode 100644
index 0000000..7e8983c
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,96 @@
+"""Render a self-contained public service status page."""
+import html
+import json
+import re
+import sys
+from datetime import datetime, timezone
+from urllib.parse import urlsplit
+
+from app.status import load, STATES
+
+_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+_SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    for service in services:
+        if service["state"] not in STATES:
+            raise ValueError(f"unknown state: {service['state']}")
+
+    count = len(services)
+    if count:
+        counts = {state: sum(s["state"] == state for s in services) for state in STATES}
+        attention = counts["outage"] + counts["degraded"]
+        if attention:
+            banner_text = f"{attention} of {count} service{'s' if attention != 1 else ''} need{'s' if attention == 1 else ''} attention"
+        else:
+            banner_text = "All systems operational"
+        if counts["maintenance"]:
+            n = counts["maintenance"]
+            banner_text += f" · {n} under maintenance"
+        modifier = "down" if counts["outage"] else "warn" if counts["degraded"] else "ok"
+        title = f"Status · {counts['operational']} of {count} operational"
+    else:
+        title = "Status · no services"
+
+    css = '''<style>
+:root { --bg: #f6f8fa; --text: #17212b; --ok: #16834a; --warn: #b87500; --down: #c62828; --maint: #596579; }
+@media (prefers-color-scheme: dark) { :root { --bg: #111820; --text: #e8eef4; } }
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, main, footer { max-width: 640px; margin: 0 auto; }
+.banner { padding: 1rem; border-radius: .5rem; margin: 1rem auto; max-width: 640px; }
+.banner--ok { background: color-mix(in srgb, var(--ok) 14%, var(--bg)); }
+.banner--warn { background: color-mix(in srgb, var(--warn) 14%, var(--bg)); }
+.banner--down { background: color-mix(in srgb, var(--down) 14%, var(--bg)); }
+.services { list-style: none; padding: 0; margin: 1.5rem auto; max-width: 640px; }
+.service { display: flex; align-items: center; gap: 1rem; padding: 1rem; border-bottom: 1px solid #8885; }
+.service h2 { margin: 0; font-size: 1.1rem; flex: 1; }
+.service p { margin: .25rem 0 0; }
+.dot { width: .7rem; height: .7rem; border-radius: 50%; flex: none; background: var(--text); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+.state, .uptime { font-size: .9rem; }
+.note { flex-basis: 100%; }
+a { color: inherit; }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; }
+footer { margin-top: 2rem; font-size: .9rem; }
+.empty { max-width: 640px; margin: 2rem auto; }
+@keyframes pulse { 50% { opacity: .35; } }
+@media (prefers-reduced-motion: reduce) { [data-state="outage"] .dot { animation: none; } }
+@media (max-width: 480px) { .service { flex-direction: column; align-items: flex-start; } }
+</style>'''
+    parts = ['<!doctype html>', '<html lang="en">', '<head>', '<meta charset="utf-8">', '<meta name="viewport" content="width=device-width, initial-scale=1">', f'<title>{html.escape(title)}</title>', css, '</head>', '<body>', '<header><h1>System status</h1></header>']
+    if count:
+        parts.append(f'<div class="banner banner--{modifier}" role="status">{html.escape(banner_text)}</div>')
+        parts.append('<main><ul class="services">')
+        for service in sorted(services, key=lambda s: (_SEVERITY[s["state"]], s["name"].casefold())):
+            name = html.escape(str(service["name"]))
+            state = service["state"]
+            slug = re.sub(r"-+", "-", re.sub(r"[^a-z0-9]+", "-", str(service["name"]).lower())).strip("-")
+            label = f'<a href="{html.escape(str(service["url"]), quote=True)}"' + (' rel="noopener"' if urlsplit(str(service["url"])).scheme.lower() in ("http", "https") else '') + f'>{name}</a>' if service.get("url") else name
+            parts.append(f'<li class="service" id="service-{html.escape(slug, quote=True)}" data-state="{state}"><span class="dot" aria-hidden="true"></span><h2>{label}</h2><span class="state">{_LABELS[state]}</span>')
+            if service.get("note"):
+                parts.append(f'<p class="note">{html.escape(str(service["note"]))}</p>')
+            if service.get("uptime") is not None:
+                parts.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            parts.append('</li>')
+        parts.extend(['</ul></main>'])
+    else:
+        parts.append('<main><p class="empty">No services configured.</p></main>')
+    stamp = html.escape(generated_at, quote=True)
+    parts.extend([f'<footer><time datetime="{stamp}">Updated {html.escape(generated_at)}</time></footer>', '</body>', '</html>'])
+    return '\n'.join(parts)
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: python -m app.page services.json")
+    print(render(load(sys.argv[1]), datetime.now(timezone.utc).isoformat()))
