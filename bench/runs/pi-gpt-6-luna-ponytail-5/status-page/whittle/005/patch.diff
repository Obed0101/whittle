new file mode 100644
index 0000000..393cf86
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,126 @@
+"""Render a self-contained public service status page."""
+import html
+import re
+import sys
+from datetime import datetime, timezone
+
+from app.status import load
+
+STATES = ("operational", "degraded", "outage", "maintenance")
+LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _e(value):
+    return html.escape(str(value), quote=True)
+
+
+def _slug(name):
+    parts = []
+    for char in str(name).lower():
+        if char.isalnum():
+            parts.append(char)
+        elif parts and parts[-1] != "-":
+            parts.append("-")
+    return "".join(parts).strip("-")
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    """Return a complete static HTML status page for services."""
+    for service in services:
+        if service["state"] not in STATES:
+            raise ValueError(f"unknown state: {service['state']}")
+
+    total = len(services)
+    if total:
+        sorted_services = sorted(services, key=lambda service: (SEVERITY[service["state"]], str(service["name"]).casefold()))
+        down = sum(service["state"] in ("degraded", "outage") for service in services)
+        maintenance = sum(service["state"] == "maintenance" for service in services)
+        if down:
+            banner_text = f"{down} of {total} service{'s' if down != 1 else ''} {'need' if down != 1 else 'needs'} attention"
+            if maintenance:
+                banner_text += f" · {maintenance} under maintenance"
+            modifier = "down" if any(service["state"] == "outage" for service in services) else "warn"
+        else:
+            banner_text = "All systems operational"
+            if maintenance:
+                banner_text += f" · {maintenance} under maintenance"
+            modifier = "ok"
+        operational = sum(service["state"] == "operational" for service in services)
+        title = f"Status · {operational} of {total} operational"
+        banner = f'<div class="banner banner--{modifier}" role="status">{_e(banner_text)}</div>'
+        items = []
+        for service in sorted_services:
+            state = service["state"]
+            name = _e(service["name"])
+            if service.get("url"):
+                url = _e(service["url"])
+                external = re.match(r"^https?://", str(service["url"]), re.IGNORECASE)
+                name = f'<a href="{url}"' + (' rel="noopener"' if external else "") + f">{name}</a>"
+            note = f'<p class="note">{_e(service["note"])}</p>' if service.get("note") else ""
+            uptime = f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>' if service.get("uptime") is not None else ""
+            items.append(
+                f'<li class="service" id="service-{_e(_slug(service["name"]))}" data-state="{_e(state)}">'
+                f'<span class="dot" aria-hidden="true"></span><div class="service-content">'
+                f'<h2>{name}</h2><span class="state">{LABELS[state]}</span>{note}{uptime}</div></li>'
+            )
+        content = banner + '<main><ul class="services">' + "".join(items) + "</ul></main>"
+    else:
+        title = "Status · no services"
+        content = '<main><p class="empty">No services configured.</p></main>'
+
+    return f'''<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>{_e(title)}</title>
+<style>
+:root {{ --bg: #f5f7fa; --text: #172033; --ok: #16803c; --warn: #a85b00; --down: #c62828; --maint: #53657d; }}
+@media (prefers-color-scheme: dark) {{ :root {{ --bg: #111827; --text: #e5e7eb; --ok: #52d273; --warn: #ffc267; --down: #ff7272; --maint: #a9b8cc; }} }}
+* {{ box-sizing: border-box; }}
+body {{ margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }}
+header, .banner, main, footer {{ width: 100%; max-width: 640px; margin-left: auto; margin-right: auto; }}
+h1 {{ margin: 0 0 1.25rem; font-size: 1.8rem; }}
+.banner {{ margin-bottom: 1rem; padding: 1rem; border-radius: .5rem; font-weight: 650; }}
+.banner--ok {{ background: color-mix(in srgb, var(--ok) 14%, var(--bg)); color: var(--ok); }}
+.banner--warn {{ background: color-mix(in srgb, var(--warn) 14%, var(--bg)); color: var(--warn); }}
+.banner--down {{ background: color-mix(in srgb, var(--down) 14%, var(--bg)); color: var(--down); }}
+.services {{ list-style: none; padding: 0; margin: 0; }}
+.service {{ display: flex; align-items: flex-start; gap: .8rem; padding: 1rem; margin-bottom: .75rem; border: 1px solid #80889955; border-radius: .5rem; }}
+.dot {{ flex: 0 0 .7rem; width: .7rem; height: .7rem; margin-top: .45rem; border-radius: 50%; background: var(--ok); }}
+[data-state="operational"] .dot {{ background: var(--ok); }}
+[data-state="degraded"] .dot {{ background: var(--warn); }}
+[data-state="outage"] .dot {{ background: var(--down); animation: pulse 1.5s ease-in-out infinite; }}
+[data-state="maintenance"] .dot {{ background: var(--maint); }}
+@keyframes pulse {{ 50% {{ opacity: .35; transform: scale(.8); }} }}
+@media (prefers-reduced-motion: reduce) {{ [data-state="outage"] .dot {{ animation: none; }} }}
+.service-content {{ min-width: 0; }}
+h2 {{ margin: 0; font-size: 1.1rem; }}
+a {{ color: inherit; }}
+a:focus-visible {{ outline: 3px solid var(--warn); outline-offset: 3px; }}
+.state, .uptime {{ display: inline-block; margin-top: .35rem; font-size: .9rem; }}
+.note {{ margin: .5rem 0 0; }}
+.uptime {{ margin-left: .75rem; }}
+.empty {{ padding: 1rem; }}
+footer {{ margin-top: 2rem; color: #758092; font-size: .85rem; }}
+@media (max-width: 480px) {{ .service {{ flex-direction: column; }} .dot {{ margin-top: 0; }} .uptime {{ margin-left: 0; }} }}
+</style>
+</head>
+<body>
+<header><h1>System status</h1></header>
+{content}
+<footer><time datetime="{_e(generated_at)}">Updated {_e(generated_at)}</time></footer>
+</body>
+</html>'''
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: python -m app.page services.json")
+    print(render(load(sys.argv[1]), datetime.now(timezone.utc).isoformat()))
