diff --git a/app/page.py b/app/page.py
new file mode 100644
index 0000000..40da7c1
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,99 @@
+"""Render a self-contained public service status page."""
+import html
+import re
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+from .status import STATES, load
+
+LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+STYLE = """<style>
+:root { color-scheme: light; --bg: #f4f7fb; --text: #172033; --ok: #16804a; --warn: #a45b00; --down: #c62828; --maint: #596579; }
+@media (prefers-color-scheme: dark) { :root { color-scheme: dark; --bg: #111827; --text: #e5eaf2; --ok: #52d18a; --warn: #ffc266; --down: #ff7373; --maint: #aab6c8; } }
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, main, footer { margin: 0 auto; max-width: 640px; }
+header h1 { margin: 0 0 1.25rem; font-size: 1.8rem; }
+.banner { margin: 0 auto 1.5rem; padding: 1rem 1.1rem; border-radius: .6rem; font-weight: 650; }
+.banner--ok { color: var(--ok); background: color-mix(in srgb, var(--ok) 12%, var(--bg)); }
+.banner--warn { color: var(--warn); background: color-mix(in srgb, var(--warn) 12%, var(--bg)); }
+.banner--down { color: var(--down); background: color-mix(in srgb, var(--down) 12%, var(--bg)); }
+.services { max-width: 640px; margin: 0 auto; padding: 0; list-style: none; }
+.service { display: flex; align-items: center; gap: 1rem; margin: 0 0 .8rem; padding: 1rem; border: 1px solid color-mix(in srgb, var(--text) 14%, transparent); border-radius: .6rem; }
+.dot { flex: 0 0 .7rem; width: .7rem; height: .7rem; border-radius: 50%; background: var(--maint); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; transform: scale(.78); } }
+@media (prefers-reduced-motion: reduce) { [data-state="outage"] .dot { animation: none; } }
+.service-content { flex: 1; min-width: 0; }
+.service h2 { margin: 0; font-size: 1.1rem; }
+.service a { color: inherit; text-decoration-thickness: .08em; text-underline-offset: .15em; }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; border-radius: 2px; }
+.state, .uptime { display: inline-block; margin-top: .3rem; font-size: .9rem; }
+.note { margin: .45rem 0 0; color: color-mix(in srgb, var(--text) 78%, transparent); }
+.uptime { white-space: nowrap; }
+.empty { padding: 1rem 0; }
+footer { margin-top: 1.5rem; color: color-mix(in srgb, var(--text) 70%, transparent); font-size: .9rem; }
+@media (max-width: 480px) { .service { flex-direction: column; align-items: flex-start; gap: .4rem; } }
+</style>"""
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    """Return a complete, escaped status page for service records."""
+    for service in services:
+        if service.get("state") not in STATES:
+            raise ValueError(f"unknown state: {service.get('state')}")
+
+    if not services:
+        title = "Status · no services"
+        content = '<p class="empty">No services configured.</p>'
+    else:
+        attention = sum(s["state"] in ("degraded", "outage") for s in services)
+        maintenance = sum(s["state"] == "maintenance" for s in services)
+        if attention:
+            message = f"{attention} of {len(services)} services {'needs' if attention == 1 else 'need'} attention"
+        else:
+            message = "All systems operational"
+        if maintenance:
+            message += f" · {maintenance} under maintenance"
+        modifier = "down" if any(s["state"] == "outage" for s in services) else "warn" if any(s["state"] == "degraded" for s in services) else "ok"
+        title = f"Status · {len(services) - attention} of {len(services)} operational"
+        banner = f'<div class="banner banner--{modifier}" role="status">{html.escape(message)}</div>'
+        items = []
+        for service in sorted(services, key=lambda s: (SEVERITY[s["state"]], s["name"].casefold())):
+            state = service["state"]
+            name = html.escape(str(service["name"]))
+            identifier = re.sub(r"-+", "-", re.sub(r"[^\w]+", "-", str(service["name"]).lower(), flags=re.UNICODE)).strip("-")
+            url = service.get("url")
+            if url is not None:
+                safe_url = html.escape(str(url), quote=True)
+                external = ' rel="noopener"' if re.match(r"^https?://", str(url), re.I) else ""
+                name = f'<a href="{safe_url}"{external}>{name}</a>'
+            note = f'<p class="note">{html.escape(str(service["note"]))}</p>' if service.get("note") else ""
+            uptime = f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>' if service.get("uptime") is not None else ""
+            items.append(f'<li class="service" id="service-{html.escape(identifier, quote=True)}" data-state="{state}"><span class="dot" aria-hidden="true"></span><div class="service-content"><h2>{name}</h2><span class="state">{LABELS[state]}</span>{note}</div>{uptime}</li>')
+        content = banner + '<ul class="services">' + "".join(items) + "</ul>"
+
+    timestamp = html.escape(str(generated_at), quote=True)
+    return (f'<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n'
+            '<meta name="viewport" content="width=device-width, initial-scale=1">\n'
+            f'<title>{html.escape(title)}</title>\n{STYLE}\n</head>\n<body>\n'
+            '<header><h1>System status</h1></header>\n<main>\n' + content + '\n</main>\n'
+            f'<footer><time datetime="{timestamp}">Updated {html.escape(str(generated_at))}</time></footer>\n'
+            '</body>\n</html>')
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: python -m app.page services.json")
+    print(render(load(Path(sys.argv[1])), datetime.now(timezone.utc).isoformat()))
