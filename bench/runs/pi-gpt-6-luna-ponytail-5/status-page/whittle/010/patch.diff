diff --git a/app/page.py b/app/page.py
new file mode 100644
index 0000000..a6d5281
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,107 @@
+"""Render a self-contained public service status page."""
+
+import html
+import json
+import re
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+from .status import STATES, load
+
+_STATE_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+_SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _escape(value):
+    return html.escape(str(value), quote=True)
+
+
+def _service_id(name):
+    return "service-" + re.sub(r"-+", "-", re.sub(r"[^a-z0-9]+", "-", str(name).lower())).strip("-")
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    for service in services:
+        state = service["state"]
+        if state not in STATES:
+            raise ValueError(f"unknown state: {state}")
+
+    css = '''
+:root { color-scheme: light dark; --bg: #f5f7fa; --text: #17212b; --ok: #16803c; --warn: #9a6700; --down: #c62828; --maint: #52677a; }
+@media (prefers-color-scheme: dark) { :root { --bg: #111820; --text: #e7edf3; --ok: #5bd17a; --warn: #ffd166; --down: #ff7373; --maint: #a9bfd0; } }
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, main, footer { width: 100%; max-width: 640px; margin: 0 auto; }
+h1 { margin: 0 0 1rem; font-size: 2rem; }
+.banner { padding: 1rem 1.25rem; margin-bottom: 1.5rem; border-radius: .6rem; font-weight: 650; }
+.banner--ok { color: var(--ok); background: color-mix(in srgb, var(--ok) 12%, var(--bg)); }
+.banner--warn { color: var(--warn); background: color-mix(in srgb, var(--warn) 12%, var(--bg)); }
+.banner--down { color: var(--down); background: color-mix(in srgb, var(--down) 12%, var(--bg)); }
+.services { list-style: none; padding: 0; margin: 0 auto; max-width: 640px; display: grid; gap: .75rem; }
+.service { display: flex; align-items: center; gap: .8rem; padding: 1rem; border: 1px solid color-mix(in srgb, var(--text) 14%, transparent); border-radius: .6rem; }
+.dot { width: .7rem; height: .7rem; flex: 0 0 .7rem; border-radius: 50%; background: var(--maint); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; transform: scale(.8); } }
+.service h2 { margin: 0; font-size: 1.05rem; }
+.service a { color: inherit; text-decoration-thickness: .08em; text-underline-offset: .15em; }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; border-radius: 2px; }
+.state { margin-left: auto; font-size: .9rem; }
+.note { flex-basis: 100%; margin: .25rem 0 0; opacity: .8; }
+.uptime { font-size: .85rem; white-space: nowrap; }
+.empty { text-align: center; padding: 2rem 0; }
+footer { margin: 2rem auto 0; font-size: .85rem; opacity: .7; text-align: center; }
+@media (max-width: 480px) { .service { flex-direction: column; align-items: flex-start; } .state { margin-left: 0; } }
+@media (prefers-reduced-motion: reduce) { .dot { animation: none !important; } }
+'''
+    total = len(services)
+    if not total:
+        title = "Status · no services"
+        body = '<main><p class="empty">No services configured.</p></main>'
+    else:
+        counts = {state: sum(s["state"] == state for s in services) for state in STATES}
+        title = f"Status · {counts['operational']} of {total} operational"
+        attention = counts["degraded"] + counts["outage"]
+        modifier = "down" if counts["outage"] else "warn" if counts["degraded"] else "ok"
+        banner = "All systems operational" if not attention else f"{attention} of {total} services need{'s' if attention == 1 else ''} attention"
+        if counts["maintenance"]:
+            banner += f" · {counts['maintenance']} under maintenance"
+        rows = []
+        for service in sorted(services, key=lambda s: (_SEVERITY[s["state"]], str(s["name"]).casefold())):
+            state = service["state"]
+            name = _escape(service["name"])
+            if "url" in service:
+                href = _escape(service["url"])
+                external = ' rel="noopener"' if re.match(r"https?://", str(service["url"]), re.I) else ""
+                name = f'<a href="{href}"{external}>{name}</a>'
+            fields = [f'<span class="dot" aria-hidden="true"></span>', f'<h2>{name}</h2>', f'<span class="state">{_STATE_LABELS[state]}</span>']
+            if service.get("uptime") is not None:
+                fields.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            if service.get("note"):
+                fields.append(f'<p class="note">{_escape(service["note"])}</p>')
+            rows.append(f'<li class="service" id="{_escape(_service_id(service["name"]))}" data-state="{_escape(state)}">' + "".join(fields) + "</li>")
+        body = f'<header><h1>System status</h1><div class="banner banner--{modifier}" role="status">{_escape(banner)}</div></header><main><ul class="services">{"".join(rows)}</ul></main>'
+
+    stamp = _escape(generated_at)
+    return (f'<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n'
+            f'<meta name="viewport" content="width=device-width, initial-scale=1">\n<title>{_escape(title)}</title>\n'
+            f'<style>{css}</style>\n</head>\n<body>\n{body}\n<footer><time datetime="{stamp}">Updated {stamp}</time></footer>\n</body>\n</html>\n')
+
+
+def main():
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: python -m app.page services.json")
+    generated_at = datetime.now(timezone.utc).isoformat()
+    print(render(load(Path(sys.argv[1])), generated_at), end="")
+
+
+if __name__ == "__main__":
+    main()
