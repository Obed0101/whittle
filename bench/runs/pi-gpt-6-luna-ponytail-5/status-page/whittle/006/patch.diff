diff --git a/app/page.py b/app/page.py
new file mode 100644
index 0000000..e100256
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,129 @@
+"""Render a self-contained public status page."""
+import html
+import json
+import re
+import sys
+from datetime import datetime, timezone
+
+
+STATE_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _escape(value):
+    return html.escape(str(value), quote=True)
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    for service in services:
+        state = service.get("state")
+        if state not in STATE_LABELS:
+            raise ValueError(f"unknown state: {state}")
+
+    total = len(services)
+    operational = sum(service["state"] == "operational" for service in services)
+    if not total:
+        title = "Status · no services"
+    else:
+        title = f"Status · {operational} of {total} operational"
+
+    styles = """<style>
+:root {
+  --bg: #f5f7fa;
+  --text: #182230;
+  --ok: #16803c;
+  --warn: #a65b00;
+  --down: #c62828;
+  --maint: #5263a5;
+}
+@media (prefers-color-scheme: dark) {
+  :root { --bg: #151922; --text: #edf1f7; --ok: #63d889; --warn: #ffc266; --down: #ff7474; --maint: #aab7ff; }
+}
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, .banner, main, footer { max-width: 640px; margin-left: auto; margin-right: auto; }
+h1 { margin: 0 0 1rem; font-size: 2rem; }
+.banner { padding: 1rem; margin-bottom: 1.25rem; border-radius: .5rem; font-weight: 650; }
+.banner--ok { background: color-mix(in srgb, var(--ok) 14%, var(--bg)); color: var(--ok); }
+.banner--warn { background: color-mix(in srgb, var(--warn) 14%, var(--bg)); color: var(--warn); }
+.banner--down { background: color-mix(in srgb, var(--down) 14%, var(--bg)); color: var(--down); }
+.services { display: flex; flex-direction: column; gap: .75rem; list-style: none; padding: 0; margin: 0 auto; max-width: 640px; }
+.service { display: flex; align-items: center; gap: .8rem; padding: 1rem; border: 1px solid color-mix(in srgb, var(--text) 16%, transparent); border-radius: .5rem; }
+.dot { flex: 0 0 .7rem; width: .7rem; height: .7rem; border-radius: 50%; background: var(--text); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; transform: scale(.8); } }
+.service h2 { flex: 1; margin: 0; font-size: 1.05rem; }
+.service a { color: inherit; text-decoration-thickness: .08em; text-underline-offset: .15em; }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; border-radius: 2px; }
+.state { font-size: .9rem; }
+.note { margin: .4rem 0 0; }
+.uptime { white-space: nowrap; font-size: .9rem; }
+.empty { max-width: 640px; margin: 0 auto; }
+footer { margin-top: 1.5rem; color: color-mix(in srgb, var(--text) 70%, transparent); font-size: .875rem; }
+@media (max-width: 480px) { .service { flex-direction: column; align-items: flex-start; } }
+@media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
+</style>"""
+
+    parts = [
+        '<!doctype html>', '<html lang="en">', '<head>',
+        '<meta charset="utf-8">',
+        '<meta name="viewport" content="width=device-width, initial-scale=1">',
+        f'<title>{_escape(title)}</title>', styles, '</head>', '<body>',
+        '<header><h1>System status</h1></header>',
+    ]
+    if total:
+        attention = sum(service["state"] in ("degraded", "outage") for service in services)
+        maintenance = sum(service["state"] == "maintenance" for service in services)
+        if attention:
+            message = f"{attention} of {total} service{'s' if attention != 1 else ''} {'need' if attention != 1 else 'needs'} attention"
+        else:
+            message = "All systems operational"
+        if maintenance:
+            message += f" · {maintenance} under maintenance"
+        modifier = "down" if any(s["state"] == "outage" for s in services) else "warn" if any(s["state"] == "degraded" for s in services) else "ok"
+        parts.append(f'<div class="banner banner--{modifier}" role="status">{_escape(message)}</div>')
+        parts.append('<main><ul class="services">')
+        ordered = sorted(services, key=lambda s: (SEVERITY[s["state"]], s["name"].casefold()))
+        for service in ordered:
+            state = service["state"]
+            slug = re.sub(r"[^a-z0-9]+", "-", service["name"].lower()).strip("-")
+            name = _escape(service["name"])
+            if service.get("url"):
+                url = _escape(service["url"])
+                rel = ' rel="noopener"' if re.match(r"^https?://", str(service["url"]), re.I) else ""
+                name = f'<a href="{url}"{rel}>{name}</a>'
+            pieces = [f'<li class="service" id="service-{_escape(slug)}" data-state="{_escape(state)}">',
+                      '<span class="dot" aria-hidden="true"></span>', f'<h2>{name}</h2>',
+                      f'<span class="state">{STATE_LABELS[state]}</span>']
+            if service.get("note"):
+                pieces.append(f'<p class="note">{_escape(service["note"])}</p>')
+            if service.get("uptime") is not None:
+                pieces.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            pieces.append('</li>')
+            parts.append(''.join(pieces))
+        parts.append('</ul></main>')
+    else:
+        parts.append('<main><p class="empty">No services configured.</p></main>')
+    escaped_time = _escape(generated_at)
+    parts.extend([f'<footer><time datetime="{escaped_time}">Updated {escaped_time}</time></footer>', '</body>', '</html>'])
+    return '\n'.join(parts)
+
+
+def main():
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: python -m app.page services.json")
+    with open(sys.argv[1], encoding="utf-8") as handle:
+        services = json.load(handle)
+    print(render(services, datetime.now(timezone.utc).isoformat()))
+
+
+if __name__ == "__main__":
+    main()
