index 0000000..b8e2b87
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,124 @@
+"""Render a self-contained public service status page."""
+import html
+import json
+import re
+import sys
+from datetime import datetime, timezone
+
+from app.status import load
+
+STATE_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _e(value):
+    return html.escape(str(value), quote=True)
+
+
+def _slug(name):
+    # Unicode letters and digits are retained; punctuation runs become one dash.
+    return re.sub(r"-+", "-", "".join(
+        char.lower() if char.isalnum() else "-" for char in name
+    )).strip("-")
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    """Return a complete, static HTML status page for *services*."""
+    for service in services:
+        if service["state"] not in STATE_LABELS:
+            raise ValueError(f"unknown state: {service['state']}")
+
+    count = len(services)
+    operational = sum(s["state"] == "operational" for s in services)
+    title = (f"Status · {operational} of {count} operational" if count
+             else "Status · no services")
+    css = """<style>
+:root { --bg: #f5f7fa; --text: #182230; --ok: #16803c; --warn: #a15c00; --down: #c62828; --maint: #536579; }
+@media (prefers-color-scheme: dark) { :root { --bg: #111820; --text: #e7edf4; } }
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, main, footer, .banner { max-width: 640px; margin-left: auto; margin-right: auto; }
+h1 { margin-top: 0; }
+.banner { padding: 1rem; border-radius: .5rem; margin-bottom: 1.25rem; }
+.banner--ok { background: color-mix(in srgb, var(--ok) 14%, var(--bg)); }
+.banner--warn { background: color-mix(in srgb, var(--warn) 14%, var(--bg)); }
+.banner--down { background: color-mix(in srgb, var(--down) 14%, var(--bg)); }
+.services { max-width: 640px; margin: 0 auto; padding: 0; list-style: none; }
+.service { display: flex; align-items: center; gap: .75rem; padding: 1rem; border-bottom: 1px solid #8885; }
+.dot { flex: 0 0 .7rem; width: .7rem; height: .7rem; border-radius: 50%; background: var(--ok); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; } }
+@media (prefers-reduced-motion: reduce) { .dot { animation: none !important; } }
+.service h2 { margin: 0; font-size: 1.1rem; }
+.service p { margin: .25rem 0 0; }
+.service-content { flex: 1; }
+.state, .uptime { font-size: .9rem; }
+.state { margin-left: auto; }
+a { color: inherit; }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; }
+.empty { max-width: 640px; margin: auto; }
+footer { margin-top: 2rem; color: #667085; font-size: .9rem; }
+@media (max-width: 480px) { .service { flex-direction: column; align-items: flex-start; } .state { margin-left: 0; } }
+</style>"""
+    parts = ["<!doctype html>", '<html lang="en">', "<head>",
+             '<meta charset="utf-8">',
+             '<meta name="viewport" content="width=device-width, initial-scale=1">',
+             f"<title>{_e(title)}</title>", css, "</head>", "<body>",
+             "<header><h1>System status</h1></header>"]
+    if count:
+        attention = sum(s["state"] in ("degraded", "outage") for s in services)
+        maintenance = sum(s["state"] == "maintenance" for s in services)
+        if not attention:
+            message = "All systems operational"
+        else:
+            noun = "service" if attention == 1 else "services"
+            verb = "needs" if attention == 1 else "need"
+            message = f"{attention} of {count} {noun} {verb} attention"
+        if maintenance:
+            message += f" · {maintenance} under maintenance"
+        modifier = ("down" if any(s["state"] == "outage" for s in services)
+                    else "warn" if any(s["state"] == "degraded" for s in services)
+                    else "ok")
+        parts.append(f'<div class="banner banner--{modifier}" role="status">{_e(message)}</div>')
+        parts.append('<main><ul class="services">')
+        for service in sorted(services, key=lambda s: (SEVERITY[s["state"]], s["name"].casefold())):
+            state = service["state"]
+            name = _e(service["name"])
+            if service.get("url"):
+                url = _e(service["url"])
+                rel = ' rel="noopener"' if re.match(r"https?://", str(service["url"]), re.I) else ""
+                name = f'<a href="{url}"{rel}>{name}</a>'
+            parts.append(f'<li class="service" id="service-{_e(_slug(service["name"]))}" data-state="{_e(state)}">')
+            parts.append('<span class="dot" aria-hidden="true"></span><div class="service-content">')
+            parts.append(f"<h2>{name}</h2>")
+            if service.get("note"):
+                parts.append(f'<p class="note">{_e(service["note"])}</p>')
+            if service.get("uptime") is not None:
+                parts.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            parts.append(f'</div><span class="state">{STATE_LABELS[state]}</span></li>')
+        parts.append('</ul></main>')
+    else:
+        parts.append('<main><p class="empty">No services configured.</p></main>')
+    parts.append(f'<footer><time datetime="{_e(generated_at)}">Updated {_e(generated_at)}</time></footer>')
+    parts.extend(["</body>", "</html>"])
+    return "\n".join(parts)
+
+
+def main():
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: python -m app.page services.json")
+    services = load(sys.argv[1])
+    generated_at = datetime.now(timezone.utc).isoformat()
+    print(render(services, generated_at))
+
+
+if __name__ == "__main__":
+    main()
