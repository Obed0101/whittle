index 0000000..d8cb58a
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,109 @@
+"""Render a self-contained public service status page."""
+import html
+import json
+import re
+import sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+from .status import STATES, load
+
+STATE_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _escape(value):
+    return html.escape(str(value), quote=True)
+
+
+def _service_id(name):
+    slug = re.sub(r"[^a-z0-9]+", "-", str(name).lower()).strip("-")
+    return "service-" + slug
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    for service in services:
+        state = service["state"]
+        if state not in STATES:
+            raise ValueError(f"unknown state: {state}")
+
+    count = len(services)
+    title = "Status · no services" if not count else f"Status · {sum(s['state'] == 'operational' for s in services)} of {count} operational"
+    lines = [
+        "<!doctype html>",
+        '<html lang="en">',
+        "<head>",
+        '  <meta charset="utf-8">',
+        '  <meta name="viewport" content="width=device-width, initial-scale=1">',
+        f"  <title>{_escape(title)}</title>",
+        "  <style>",
+        "    :root { --bg: #f5f7fa; --text: #17212b; --ok: #16803c; --warn: #a15c00; --down: #c62828; --maint: #5265a8; }",
+        "    @media (prefers-color-scheme: dark) { :root { --bg: #151a20; --text: #e8edf2; } }",
+        "    * { box-sizing: border-box; }",
+        "    body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }",
+        "    header, main, footer { max-width: 640px; margin: 0 auto; }",
+        "    h1 { margin: 0 0 1rem; }",
+        "    .banner { padding: 1rem; border-radius: .5rem; margin-bottom: 1rem; }",
+        "    .banner--ok { background: color-mix(in srgb, var(--ok) 14%, var(--bg)); }",
+        "    .banner--warn { background: color-mix(in srgb, var(--warn) 16%, var(--bg)); }",
+        "    .banner--down { background: color-mix(in srgb, var(--down) 16%, var(--bg)); }",
+        "    .services { max-width: 640px; margin: 0 auto; padding: 0; list-style: none; }",
+        "    .service { display: flex; align-items: center; gap: 1rem; padding: 1rem; margin-bottom: .75rem; border: 1px solid #8885; border-radius: .5rem; }",
+        "    .dot { flex: 0 0 .75rem; width: .75rem; height: .75rem; border-radius: 50%; background: var(--ok); }",
+        '    [data-state="operational"] .dot { background: var(--ok); }',
+        '    [data-state="degraded"] .dot { background: var(--warn); }',
+        '    [data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }',
+        '    [data-state="maintenance"] .dot { background: var(--maint); }',
+        "    @keyframes pulse { 50% { opacity: .35; transform: scale(.8); } }",
+        "    @media (prefers-reduced-motion: reduce) { .dot { animation: none; } }",
+        "    .service h2 { margin: 0; font-size: 1.1rem; }",
+        "    .service-info { flex: 1; } .state, .uptime { display: inline-block; margin-top: .25rem; }",
+        "    .note { margin: .5rem 0 0; }",
+        "    a { color: inherit; } a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; }",
+        "    footer { margin-top: 2rem; color: #68727c; }",
+        "    @media (max-width: 480px) { .service { flex-direction: column; align-items: flex-start; } }",
+        "  </style>",
+        "</head>",
+        "<body>",
+        "  <header><h1>System status</h1></header>",
+    ]
+    if services:
+        attention = sum(s["state"] in ("degraded", "outage") for s in services)
+        maintenance = sum(s["state"] == "maintenance" for s in services)
+        if attention:
+            banner = f"{attention} of {count} services {'needs' if attention == 1 else 'need'} attention"
+        else:
+            banner = "All systems operational"
+        if maintenance:
+            banner += f" · {maintenance} under maintenance"
+        modifier = "down" if any(s["state"] == "outage" for s in services) else "warn" if any(s["state"] == "degraded" for s in services) else "ok"
+        lines.append(f'  <div class="banner banner--{modifier}" role="status">{_escape(banner)}</div>')
+        lines.append("  <main><ul class=\"services\">")
+        for service in sorted(services, key=lambda s: (SEVERITY[s["state"]], str(s["name"]).casefold())):
+            name = _escape(service["name"])
+            url = service.get("url")
+            name_html = f'<a href="{_escape(url)}"' + (' rel="noopener"' if re.match(r"https?://", str(url), re.I) else "") + f">{name}</a>" if url else name
+            lines.append(f'    <li class="service" id="{_escape(_service_id(service["name"]))}" data-state="{_escape(service["state"])}">')
+            lines.append('      <span class="dot" aria-hidden="true"></span>')
+            lines.append(f'      <div class="service-info"><h2>{name_html}</h2><span class="state">{STATE_LABELS[service["state"]]}</span>')
+            if service.get("note"):
+                lines.append(f'      <p class="note">{_escape(service["note"])}</p>')
+            if service.get("uptime") is not None:
+                lines.append(f'      <span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            lines.append("      </div></li>")
+        lines.append("  </ul></main>")
+    else:
+        lines.append('  <main><p class="empty">No services configured.</p></main>')
+    lines.extend([f'  <footer><time datetime="{_escape(generated_at)}">Updated {_escape(generated_at)}</time></footer>', "</body>", "</html>"])
+    return "\n".join(lines) + "\n"
+
+
+if __name__ == "__main__":
+    services = load(sys.argv[1])
+    generated_at = datetime.now(timezone.utc).isoformat()
+    print(render(services, generated_at), end="")
