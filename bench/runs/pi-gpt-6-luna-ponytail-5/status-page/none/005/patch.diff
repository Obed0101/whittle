+++ b/app/page.py
@@ -0,0 +1,130 @@
+"""Render a self-contained public service status page."""
+import html
+import re
+import sys
+from datetime import datetime, timezone
+
+from .status import STATES, load
+
+_STATE_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+_SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _escape(value):
+    return html.escape(str(value), quote=True)
+
+
+def _service_id(name):
+    # Replace each run of non-alphanumeric characters with one hyphen.
+    result = []
+    separating = False
+    for char in str(name).lower():
+        if char.isalnum():
+            if separating and result:
+                result.append("-")
+            result.append(char)
+            separating = False
+        else:
+            separating = True
+    return "service-" + "".join(result)
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    """Return a complete, escaped HTML status document."""
+    for service in services:
+        state = service["state"]
+        if state not in STATES:
+            raise ValueError(f"unknown state: {state}")
+
+    total = len(services)
+    operational = sum(service["state"] == "operational" for service in services)
+    title = f"Status · {operational} of {total} operational" if total else "Status · no services"
+    css = """<style>
+:root { --bg: #f5f7fa; --text: #17212b; --ok: #16803c; --warn: #a96000; --down: #c62828; --maint: #536579; }
+@media (prefers-color-scheme: dark) { :root { --bg: #151a20; --text: #edf2f7; --ok: #59d27c; --warn: #ffc15a; --down: #ff7272; --maint: #a9bbce; } }
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, main, footer { margin: 0 auto; max-width: 640px; }
+h1 { margin: 0 0 1rem; }
+.banner { padding: 1rem; border-radius: .5rem; margin-bottom: 1.5rem; }
+.banner--ok { background: color-mix(in srgb, var(--ok) 14%, var(--bg)); }
+.banner--warn { background: color-mix(in srgb, var(--warn) 14%, var(--bg)); }
+.banner--down { background: color-mix(in srgb, var(--down) 14%, var(--bg)); }
+.services { list-style: none; padding: 0; margin: 0 auto; max-width: 640px; }
+.service { display: flex; align-items: center; gap: .75rem; padding: 1rem; border-bottom: 1px solid #8885; }
+.service h2 { font-size: 1.1rem; margin: 0; flex: 1; }
+.service a { color: inherit; }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; }
+.dot { width: .7rem; height: .7rem; border-radius: 50%; flex: 0 0 .7rem; background: var(--ok); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; } }
+@media (prefers-reduced-motion: reduce) { [data-state="outage"] .dot { animation: none; } }
+.state, .uptime { white-space: nowrap; }
+.note { flex-basis: 100%; margin: .5rem 0 0 1.45rem; }
+.empty { text-align: center; }
+footer { margin-top: 2rem; color: #687582; font-size: .9rem; }
+@media (max-width: 480px) { .service { flex-direction: column; align-items: flex-start; } .note { margin-left: 0; } }
+</style>"""
+    parts = [
+        "<!doctype html>", '<html lang="en">', "<head>",
+        '<meta charset="utf-8">',
+        '<meta name="viewport" content="width=device-width, initial-scale=1">',
+        f"<title>{_escape(title)}</title>", css, "</head>", "<body>",
+        "<header><h1>System status</h1></header>",
+    ]
+    if services:
+        attention = sum(service["state"] in ("degraded", "outage") for service in services)
+        maintenance = sum(service["state"] == "maintenance" for service in services)
+        if attention:
+            banner_text = f"{attention} of {total} service{'s' if attention != 1 else ''} {'need' if attention != 1 else 'needs'} attention"
+        else:
+            banner_text = "All systems operational"
+        if maintenance:
+            banner_text += f" · {maintenance} under maintenance"
+        modifier = "down" if any(s["state"] == "outage" for s in services) else "warn" if any(s["state"] == "degraded" for s in services) else "ok"
+        parts.append(f'<div class="banner banner--{modifier}" role="status">{_escape(banner_text)}</div>')
+        parts.append('<main><ul class="services">')
+        for service in sorted(services, key=lambda s: (_SEVERITY[s["state"]], str(s["name"]).casefold())):
+            name = _escape(service["name"])
+            state = service["state"]
+            parts.append(f'<li class="service" id="{_escape(_service_id(service["name"]))}" data-state="{_escape(state)}">')
+            parts.append('<span class="dot" aria-hidden="true"></span>')
+            if service.get("url"):
+                url = _escape(service["url"])
+                external = re.match(r"^https?://", str(service["url"]), re.IGNORECASE)
+                rel = ' rel="noopener"' if external else ""
+                parts.append(f'<h2><a href="{url}"{rel}>{name}</a></h2>')
+            else:
+                parts.append(f"<h2>{name}</h2>")
+            parts.append(f'<span class="state">{_STATE_LABELS[state]}</span>')
+            if service.get("uptime") is not None:
+                parts.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            if service.get("note"):
+                parts.append(f'<p class="note">{_escape(service["note"])}</p>')
+            parts.append("</li>")
+        parts.append("</ul></main>")
+    else:
+        parts.append('<main><p class="empty">No services configured.</p></main>')
+    stamp = _escape(generated_at)
+    parts.append(f'<footer><time datetime="{stamp}">Updated {stamp}</time></footer>')
+    parts.append("</body></html>")
+    return "\n".join(parts)
+
+
+def main():
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: python -m app.page services.json")
+    generated_at = datetime.now(timezone.utc).isoformat()
+    print(render(load(sys.argv[1]), generated_at))
+
+
+if __name__ == "__main__":
+    main()
