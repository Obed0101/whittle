diff --git a/app/page.py b/app/page.py
new file mode 100644
index 0000000..6ec5922
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,134 @@
+"""Render a self-contained public service status page."""
+import datetime
+import html
+import json
+import re
+import sys
+
+from app.status import STATES, load
+
+_STATE_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+_SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _escape(value):
+    return html.escape(str(value), quote=True)
+
+
+def _slug(name):
+    slug = re.sub(r"[^\w]+", "-", str(name).lower(), flags=re.UNICODE)
+    return slug.strip("-")
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    """Return a complete, self-contained HTML status page."""
+    for service in services:
+        state = service["state"]
+        if state not in STATES:
+            raise ValueError(f"unknown state: {state}")
+
+    count = len(services)
+    if count:
+        operational = sum(s["state"] == "operational" for s in services)
+        title = f"Status · {operational} of {count} operational"
+    else:
+        title = "Status · no services"
+
+    styles = """<style>
+:root { --bg: #f5f7fa; --text: #17212b; --ok: #218739; --warn: #a86400; --down: #c62828; --maint: #5266a8; }
+@media (prefers-color-scheme: dark) { :root { --bg: #151a21; --text: #edf1f5; --ok: #64cf7a; --warn: #ffc45c; --down: #ff7070; --maint: #aab8ff; } }
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, main, footer { width: 100%; max-width: 640px; margin: 0 auto; }
+h1 { margin: 0 0 1rem; }
+.banner { padding: 1rem; margin-bottom: 1rem; border-radius: .5rem; font-weight: 600; }
+.banner--ok { color: var(--ok); background: color-mix(in srgb, var(--ok) 12%, var(--bg)); }
+.banner--warn { color: var(--warn); background: color-mix(in srgb, var(--warn) 12%, var(--bg)); }
+.banner--down { color: var(--down); background: color-mix(in srgb, var(--down) 12%, var(--bg)); }
+.services { list-style: none; padding: 0; margin: 0 auto; max-width: 640px; }
+.service { display: flex; align-items: flex-start; gap: .75rem; padding: 1rem; margin-bottom: .75rem; border: 1px solid #8884; border-radius: .5rem; }
+.dot { flex: 0 0 .7rem; width: .7rem; height: .7rem; margin-top: .5rem; border-radius: 50%; background: var(--text); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; transform: scale(.8); } }
+@media (prefers-reduced-motion: reduce) { .dot { animation: none !important; } }
+.service-content { min-width: 0; }
+.service h2 { margin: 0; font-size: 1.1rem; }
+.service p { margin: .35rem 0 0; }
+.state, .uptime { display: inline-block; margin-top: .35rem; margin-right: .75rem; }
+a { color: inherit; }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; }
+.empty { text-align: center; }
+footer { margin-top: 1.5rem; color: var(--text); opacity: .75; }
+@media (max-width: 480px) { .service { flex-direction: column; } .dot { margin-top: 0; } }
+</style>"""
+
+    parts = [
+        "<!doctype html>",
+        '<html lang="en">',
+        "<head>",
+        '<meta charset="utf-8">',
+        '<meta name="viewport" content="width=device-width, initial-scale=1">',
+        f"<title>{_escape(title)}</title>",
+        styles,
+        "</head>",
+        "<body>",
+        "<header><h1>System status</h1></header>",
+    ]
+
+    if services:
+        attention = sum(s["state"] in ("degraded", "outage") for s in services)
+        maintenance = sum(s["state"] == "maintenance" for s in services)
+        if attention:
+            banner_text = f"{attention} of {count} service{'s' if attention != 1 else ''} {'need' if attention != 1 else 'needs'} attention"
+        else:
+            banner_text = "All systems operational"
+        if maintenance:
+            banner_text += f" · {maintenance} under maintenance"
+        modifier = "down" if any(s["state"] == "outage" for s in services) else "warn" if any(s["state"] == "degraded" for s in services) else "ok"
+        parts.append(f'<div class="banner banner--{modifier}" role="status">{_escape(banner_text)}</div>')
+        parts.append('<main><ul class="services">')
+        ordered = sorted(services, key=lambda s: (_SEVERITY[s["state"]], str(s["name"]).casefold()))
+        for service in ordered:
+            state = service["state"]
+            name = _escape(service["name"])
+            link = ""
+            if service.get("url"):
+                url = _escape(service["url"])
+                rel = ' rel="noopener"' if re.match(r"https?://", str(service["url"]), re.I) else ""
+                link = f'<a href="{url}"{rel}>{name}</a>'
+            else:
+                link = name
+            parts.append(f'<li class="service" id="service-{_escape(_slug(service["name"]))}" data-state="{_escape(state)}"><span class="dot" aria-hidden="true"></span><div class="service-content"><h2>{link}</h2><span class="state">{_STATE_LABELS[state]}</span>')
+            if service.get("uptime") is not None:
+                parts.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            if service.get("note"):
+                parts.append(f'<p class="note">{_escape(service["note"])}</p>')
+            parts.append("</div></li>")
+        parts.append("</ul></main>")
+    else:
+        parts.append('<main><p class="empty">No services configured.</p></main>')
+
+    escaped_time = _escape(generated_at)
+    parts.append(f'<footer><time datetime="{escaped_time}">Updated {escaped_time}</time></footer>')
+    parts.append("</body></html>")
+    return "\n".join(parts)
+
+
+def main():
+    if len(sys.argv) != 2:
+        raise SystemExit("usage: python -m app.page services.json")
+    services = load(sys.argv[1])
+    generated_at = datetime.datetime.now(datetime.timezone.utc).isoformat()
+    print(render(services, generated_at))
+
+
+if __name__ == "__main__":
+    main()
