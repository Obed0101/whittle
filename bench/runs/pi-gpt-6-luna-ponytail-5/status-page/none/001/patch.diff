diff --git a/app/page.py b/app/page.py
new file mode 100644
index 0000000..41d8973
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,123 @@
+"""Render a self-contained public service status page."""
+import html
+import json
+import re
+import sys
+from datetime import datetime, timezone
+
+
+STATE_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _e(value):
+    return html.escape(str(value), quote=True)
+
+
+def _slug(name):
+    slug = re.sub(r"[^\w]+", "-", name.lower(), flags=re.UNICODE).strip("-")
+    return re.sub(r"_", "-", slug)
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    """Return a complete, self-contained HTML status page."""
+    for service in services:
+        state = service["state"]
+        if state not in STATE_LABELS:
+            raise ValueError(f"unknown state: {state}")
+
+    css = """<style>
+:root { --bg: #f5f7fa; --text: #18212f; --ok: #16803c; --warn: #a86400; --down: #c62828; --maint: #536579; }
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, main, footer { margin: 0 auto; max-width: 640px; }
+h1 { margin-top: 0; }
+.banner { padding: 1rem; border-radius: .5rem; margin-bottom: 1.25rem; }
+.banner--ok { background: color-mix(in srgb, var(--ok) 12%, var(--bg)); }
+.banner--warn { background: color-mix(in srgb, var(--warn) 14%, var(--bg)); }
+.banner--down { background: color-mix(in srgb, var(--down) 14%, var(--bg)); }
+.services { list-style: none; padding: 0; margin: 0 auto; max-width: 640px; }
+.service { display: flex; align-items: center; gap: .75rem; padding: 1rem; margin-bottom: .75rem; border: 1px solid #8884; border-radius: .5rem; }
+.service h2 { font-size: 1.05rem; margin: 0; }
+.service p { margin: .25rem 0 0; }
+.service-details { flex: 1; min-width: 0; }
+.dot { width: .75rem; height: .75rem; border-radius: 50%; flex: 0 0 .75rem; background: var(--ok); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; transform: scale(.8); } }
+.state, .uptime { font-size: .9rem; }
+.note { opacity: .85; }
+a { color: inherit; }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; }
+.empty { text-align: center; padding: 2rem; }
+footer { margin-top: 2rem; font-size: .9rem; opacity: .75; }
+@media (max-width: 480px) { .service { flex-direction: column; align-items: flex-start; } }
+@media (prefers-reduced-motion: reduce) { [data-state="outage"] .dot { animation: none; } }
+@media (prefers-color-scheme: dark) { :root { --bg: #151a22; --text: #edf1f7; --ok: #55c779; --warn: #f0b44d; --down: #ff7070; --maint: #a8b7c9; } }
+</style>"""
+
+    if not services:
+        title = "Status · no services"
+        content = '<main><p class="empty">No services configured.</p></main>'
+    else:
+        operational = sum(s["state"] == "operational" for s in services)
+        total = len(services)
+        title = f"Status · {operational} of {total} operational"
+        attention = sum(s["state"] in ("degraded", "outage") for s in services)
+        maintenance = sum(s["state"] == "maintenance" for s in services)
+        if not attention:
+            message = "All systems operational"
+        else:
+            noun = "service needs" if attention == 1 else "services need"
+            message = f"{attention} of {total} {noun} attention"
+        if maintenance:
+            message += f" · {maintenance} under maintenance"
+        modifier = "down" if any(s["state"] == "outage" for s in services) else (
+            "warn" if any(s["state"] == "degraded" for s in services) else "ok"
+        )
+        banner = f'<div class="banner banner--{modifier}" role="status">{_e(message)}</div>'
+        items = []
+        for service in sorted(services, key=lambda s: (SEVERITY[s["state"]], s["name"].casefold())):
+            name = _e(service["name"])
+            if service.get("url"):
+                url = _e(service["url"])
+                rel = ' rel="noopener"' if re.match(r"^https?://", str(service["url"]), re.I) else ""
+                name = f'<a href="{url}"{rel}>{name}</a>'
+            parts = [f'<li class="service" id="service-{_e(_slug(str(service["name"]))) }" data-state="{_e(service["state"])}">',
+                     '<span class="dot" aria-hidden="true"></span>',
+                     f'<div class="service-details"><h2>{name}</h2>',
+                     f'<span class="state">{STATE_LABELS[service["state"]]}</span>']
+            if service.get("uptime") is not None:
+                parts.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            if service.get("note"):
+                parts.append(f'<p class="note">{_e(service["note"])}</p>')
+            parts.extend(['</div></li>'])
+            items.append("".join(parts))
+        content = f'<main>{banner}<ul class="services">{"".join(items)}</ul></main>'
+
+    timestamp = _e(generated_at)
+    return (f'<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n'
+            f'<meta name="viewport" content="width=device-width, initial-scale=1">\n'
+            f'<title>{_e(title)}</title>\n{css}\n</head>\n<body>\n<header><h1>System status</h1></header>\n'
+            f'{content}\n<footer><time datetime="{timestamp}">Updated {timestamp}</time></footer>\n'
+            '</body>\n</html>\n')
+
+
+def main(argv=None):
+    argv = sys.argv[1:] if argv is None else argv
+    if len(argv) != 1:
+        raise SystemExit("usage: python -m app.page services.json")
+    from app.status import load
+    generated_at = datetime.now(timezone.utc).isoformat()
+    print(render(load(argv[0]), generated_at), end="")
+
+
+if __name__ == "__main__":
+    main()
