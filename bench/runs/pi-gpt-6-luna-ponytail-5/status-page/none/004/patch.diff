index 0000000..d1d98f8
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,115 @@
+"""Render a self-contained public service status page."""
+import datetime
+import html
+import json
+import re
+import sys
+
+
+LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+STYLE = """<style>
+:root { --bg: #f5f7fa; --text: #17212b; --ok: #16834b; --warn: #a85c00; --down: #c62828; --maint: #5265a8; }
+@media (prefers-color-scheme: dark) { :root { --bg: #15191f; --text: #edf1f5; --ok: #54d18a; --warn: #ffc266; --down: #ff7777; --maint: #a9b6ff; } }
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, main, footer { margin: 0 auto; max-width: 640px; }
+h1 { margin-top: 0; }
+.banner { padding: 1rem; border-radius: .5rem; margin-bottom: 1rem; }
+.banner--ok { background: color-mix(in srgb, var(--ok) 14%, var(--bg)); }
+.banner--warn { background: color-mix(in srgb, var(--warn) 14%, var(--bg)); }
+.banner--down { background: color-mix(in srgb, var(--down) 14%, var(--bg)); }
+.services { list-style: none; padding: 0; margin: 0 auto; max-width: 640px; }
+.service { display: flex; align-items: center; gap: 1rem; padding: 1rem; margin-bottom: .75rem; border: 1px solid #8885; border-radius: .5rem; }
+.dot { flex: 0 0 .75rem; width: .75rem; height: .75rem; border-radius: 50%; background: var(--ok); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; } }
+@media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
+.service h2 { margin: 0; font-size: 1.1rem; }
+.service p { margin: .35rem 0 0; }
+.state, .uptime { margin-left: auto; }
+.note { flex-basis: 100%; }
+a { color: inherit; }
+a:focus-visible { outline: 3px solid var(--maint); outline-offset: 3px; }
+.empty { text-align: center; }
+footer { margin-top: 2rem; opacity: .75; }
+@media (max-width: 480px) { .service { flex-direction: column; align-items: flex-start; } .state, .uptime { margin-left: 0; } }
+</style>"""
+
+
+def _escape(value):
+    return html.escape(str(value), quote=True)
+
+
+def _service_id(name):
+    slug = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
+    return "service-" + slug
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    """Return a complete, standalone HTML status page."""
+    for service in services:
+        if service["state"] not in LABELS:
+            raise ValueError(f"unknown state: {service['state']}")
+
+    count = len(services)
+    attention = sum(s["state"] in ("degraded", "outage") for s in services)
+    maintenance = sum(s["state"] == "maintenance" for s in services)
+    if count:
+        if attention:
+            banner_text = f"{attention} of {count} services {'needs' if attention == 1 else 'need'} attention"
+        else:
+            banner_text = "All systems operational"
+        if maintenance:
+            banner_text += f" · {maintenance} under maintenance"
+        modifier = "down" if any(s["state"] == "outage" for s in services) else "warn" if any(s["state"] == "degraded" for s in services) else "ok"
+        banner = f'<div class="banner banner--{modifier}" role="status">{_escape(banner_text)}</div>'
+        ordered = sorted(services, key=lambda s: (SEVERITY[s["state"]], s["name"].casefold()))
+        items = []
+        for service in ordered:
+            state = service["state"]
+            name = _escape(service["name"])
+            if service.get("url"):
+                url = _escape(service["url"])
+                rel = ' rel="noopener"' if re.match(r"^https?://", str(service["url"]), re.I) else ""
+                name = f'<a href="{url}"{rel}>{name}</a>'
+            fields = [f'<span class="dot" aria-hidden="true"></span>', f"<h2>{name}</h2>", f'<span class="state">{LABELS[state]}</span>']
+            if service.get("uptime") is not None:
+                fields.append(f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>')
+            if service.get("note"):
+                fields.append(f'<p class="note">{_escape(service["note"])}</p>')
+            items.append(f'<li class="service" id="{_escape(_service_id(str(service["name"])))}" data-state="{state}">' + "".join(fields) + "</li>")
+        content = banner + '<ul class="services">' + "".join(items) + "</ul>"
+        title = f"Status · {sum(s['state'] == 'operational' for s in services)} of {count} operational"
+    else:
+        title = "Status · no services"
+        content = '<p class="empty">No services configured.</p>'
+
+    timestamp = _escape(generated_at)
+    return ('<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n'
+            '<meta name="viewport" content="width=device-width, initial-scale=1">\n'
+            f'<title>{_escape(title)}</title>\n{STYLE}\n</head>\n<body>\n'
+            f'<header><h1>System status</h1></header>\n<main>{content}</main>\n'
+            f'<footer><time datetime="{timestamp}">Updated {timestamp}</time></footer>\n'
+            '</body>\n</html>')
+
+
+def main():
+    with open(sys.argv[1], encoding="utf-8") as handle:
+        services = json.load(handle)
+    generated_at = datetime.datetime.now(datetime.timezone.utc).isoformat()
+    print(render(services, generated_at))
+
+
+if __name__ == "__main__":
+    main()
