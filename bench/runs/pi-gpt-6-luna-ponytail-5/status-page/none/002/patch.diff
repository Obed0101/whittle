diff --git a/app/page.py b/app/page.py
new file mode 100644
index 0000000..56e6252
--- /dev/null
+++ b/app/page.py
@@ -0,0 +1,121 @@
+"""Render a self-contained public service status page."""
+
+import html
+import json
+import re
+import sys
+from datetime import datetime, timezone
+
+from app.status import STATES, load
+
+_STATE_LABELS = {
+    "operational": "Operational",
+    "degraded": "Degraded performance",
+    "outage": "Major outage",
+    "maintenance": "Under maintenance",
+}
+_SEVERITY = {"outage": 0, "degraded": 1, "maintenance": 2, "operational": 3}
+
+
+def _escape(value):
+    return html.escape(str(value), quote=True)
+
+
+def _service_id(name):
+    slug = "".join(char if char.isalnum() else "-" for char in str(name).lower())
+    return re.sub(r"-+", "-", slug).strip("-")
+
+
+def render(services: list[dict], generated_at: str) -> str:
+    """Return a complete, self-contained HTML status page."""
+    for service in services:
+        state = service["state"]
+        if state not in STATES:
+            raise ValueError(f"unknown state: {state}")
+
+    total = len(services)
+    if not total:
+        title = "Status · no services"
+        content = '<main><p class="empty">No services configured.</p></main>'
+    else:
+        attention = sum(s["state"] in ("degraded", "outage") for s in services)
+        maintenance = sum(s["state"] == "maintenance" for s in services)
+        if attention:
+            banner_text = f"{attention} of {total} services {'needs' if attention == 1 else 'need'} attention"
+        else:
+            banner_text = "All systems operational"
+        if maintenance:
+            banner_text += f" · {maintenance} under maintenance"
+        modifier = ("down" if any(s["state"] == "outage" for s in services)
+                    else "warn" if any(s["state"] == "degraded" for s in services)
+                    else "ok")
+        title = f"Status · {total - attention - maintenance} of {total} operational"
+        ordered = sorted(services, key=lambda s: (_SEVERITY[s["state"]], s["name"].casefold()))
+        rows = []
+        for service in ordered:
+            state = service["state"]
+            name = _escape(service["name"])
+            url = service.get("url")
+            if url is not None:
+                safe_url = _escape(url)
+                rel = ' rel="noopener"' if re.match(r"^https?://", str(url), re.I) else ""
+                heading = f'<a href="{safe_url}"{rel}>{name}</a>'
+            else:
+                heading = name
+            note = f'<p class="note">{_escape(service["note"])}</p>' if service.get("note") else ""
+            uptime = (f'<span class="uptime">{float(service["uptime"]):.2f}% uptime</span>'
+                      if service.get("uptime") is not None else "")
+            rows.append(
+                f'<li class="service" id="service-{_escape(_service_id(service["name"]))}" data-state="{_escape(state)}">'
+                f'<span class="dot" aria-hidden="true"></span><div class="service-info">'
+                f'<h2>{heading}</h2><span class="state">{_STATE_LABELS[state]}</span>{note}{uptime}</div></li>'
+            )
+        content = (f'<main><div class="banner banner--{modifier}" role="status">{_escape(banner_text)}</div>'
+                   f'<ul class="services">{"".join(rows)}</ul></main>')
+
+    css = """<style>
+:root { --bg: #f5f7fa; --text: #172033; --ok: #218739; --warn: #a76500; --down: #c62828; --maint: #5267a5; }
+@media (prefers-color-scheme: dark) { :root { --bg: #141820; --text: #edf1f7; --ok: #65d47b; --warn: #ffc45c; --down: #ff7272; --maint: #aabaff; } }
+* { box-sizing: border-box; }
+body { margin: 0; padding: 2rem 1rem; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; }
+header, main, footer { max-width: 640px; margin: 0 auto; }
+h1 { margin: 0 0 1.25rem; }
+.banner { padding: 1rem; margin-bottom: 1.25rem; border-radius: .5rem; font-weight: 700; }
+.banner--ok { background: color-mix(in srgb, var(--ok) 14%, var(--bg)); color: var(--ok); }
+.banner--warn { background: color-mix(in srgb, var(--warn) 14%, var(--bg)); color: var(--warn); }
+.banner--down { background: color-mix(in srgb, var(--down) 14%, var(--bg)); color: var(--down); }
+.services { list-style: none; padding: 0; margin: 0 auto; max-width: 640px; }
+.service { display: flex; align-items: flex-start; gap: 1rem; padding: 1.25rem; margin-bottom: .75rem; background: color-mix(in srgb, var(--text) 4%, var(--bg)); border-radius: .5rem; }
+.dot { flex: 0 0 .75rem; width: .75rem; height: .75rem; margin-top: .45rem; border-radius: 50%; background: var(--text); }
+[data-state="operational"] .dot { background: var(--ok); }
+[data-state="degraded"] .dot { background: var(--warn); }
+[data-state="outage"] .dot { background: var(--down); animation: pulse 1.5s ease-in-out infinite; }
+[data-state="maintenance"] .dot { background: var(--maint); }
+@keyframes pulse { 50% { opacity: .35; transform: scale(.8); } }
+.service-info { flex: 1; }
+h2 { margin: 0 0 .25rem; font-size: 1.1rem; }
+.state, .uptime { font-size: .9rem; }
+.note { margin: .75rem 0 0; }
+.uptime { display: block; margin-top: .5rem; }
+a { color: inherit; }
+a:focus-visible { outline: 3px solid var(--warn); outline-offset: 3px; }
+.empty { padding: 1rem 0; }
+footer { margin-top: 2rem; font-size: .875rem; opacity: .75; }
+@media (max-width: 480px) { .service { flex-direction: column; gap: .5rem; } .dot { margin-top: 0; } }
+@media (prefers-reduced-motion: reduce) { [data-state="outage"] .dot { animation: none; } }
+</style>"""
+    return (f'<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n'
+            f'<meta name="viewport" content="width=device-width, initial-scale=1">\n'
+            f'<title>{_escape(title)}</title>\n{css}\n</head>\n<body>\n<header><h1>System status</h1></header>\n'
+            f'{content}\n<footer><time datetime="{_escape(generated_at)}">Updated {_escape(generated_at)}</time></footer>\n'
+            '</body>\n</html>\n')
+
+
+def main():
+    services = load(sys.argv[1])
+    generated_at = datetime.now(timezone.utc).isoformat()
+    print(render(services, generated_at), end="")
+
+
+if __name__ == "__main__":
+    main()
