+"""Render expense CSV files as tables, JSON, CSV, or Markdown."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _date(value):
+    try:
+        result = date.fromisoformat(value)
+        if result.isoformat() == value:
+            return result
+    except (ValueError, TypeError):
+        pass
+    raise argparse.ArgumentTypeError(f"invalid date: {value}")
+
+
+def _amount(value):
+    try:
+        return Decimal(value.strip())
+    except (InvalidOperation, AttributeError):
+        return None
+
+
+def _money(value, currency=""):
+    return f"({currency}{abs(value):,.2f})" if value < 0 else f"{currency}{value:,.2f}"
+
+
+def _table(headers, rows, numeric, total, no_header, currency):
+    rows = [[str(value) for value in row] for row in rows]
+    total_row = ["Total"] + [""] * (len(headers) - 2) + [_money(total, currency)]
+    widths = [len(header) for header in headers]
+    for row in rows + [total_row]:
+        for i, value in enumerate(row):
+            widths[i] = max(widths[i], len(value))
+    output = []
+    if not no_header:
+        output.extend(("  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)).rstrip(),
+                       "  ".join("-" * width for width in widths).rstrip()))
+    for row in rows + [total_row]:
+        output.append("  ".join((value.rjust(widths[i]) if i in numeric else value.ljust(widths[i]))
+                                for i, value in enumerate(row)).rstrip())
+    return "\n".join(output) + "\n"
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report",
+        description="Create a report from an expense CSV.",
+        epilog="Example: python -m app.report expenses.csv --by category")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[], metavar="NAME")
+    parser.add_argument("--exclude", action="append", default=[], metavar="NAME",
+                        help="exclude a category (may be repeated)")
+    parser.add_argument("--from", dest="from_date", type=_date, metavar="DATE")
+    parser.add_argument("--to", dest="to_date", type=_date, metavar="DATE")
+    parser.add_argument("--min", dest="minimum", type=_amount, metavar="AMOUNT")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="", metavar="SYMBOL")
+    parser.add_argument("--top", type=int, metavar="N")
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _records(rows):
+    result, invalid = [], 0
+    for index, row in enumerate(rows):
+        amount = _amount(row.get("amount", ""))
+        if amount is None:
+            invalid += 1
+            continue
+        day = _date(row.get("date", ""))
+        result.append({"date": day, "category": row.get("category", ""),
+                       "amount": amount, "note": row.get("note", ""), "index": index})
+    return result, invalid
+
+
+def _render(args, records, invalid):
+    total = sum((row["amount"] for row in records), Decimal(0))
+    if args.by:
+        groups = {}
+        for row in records:
+            key = row["category"].title() if args.by == "category" else row["date"].strftime("%Y-%m")
+            count, amount = groups.get(key, (0, Decimal(0)))
+            groups[key] = count + 1, amount + row["amount"]
+        items = sorted(groups.items(), key=(lambda item: (-item[1][1], item[0].casefold()))
+                        if args.by == "category" else lambda item: item[0])
+        data = [{"group": key, "count": value[0], "total": float(value[1])} for key, value in items]
+        headers = ["group", "count", "total"]
+        csv_rows = [(key, value[0], f"{value[1]:.2f}") for key, value in items]
+        col = "Category" if args.by == "category" else "Month"
+        table_rows = [[key, value[0], _money(value[1], args.currency)] for key, value in items]
+    else:
+        data = [{"date": r["date"].isoformat(), "category": r["category"],
+                 "amount": float(r["amount"]), "note": r["note"]} for r in records]
+        headers = ["date", "category", "amount", "note"]
+        csv_rows = [(r["date"].isoformat(), r["category"], f"{r['amount']:.2f}", r["note"]) for r in records]
+        col = None
+        table_rows = [[r["date"].isoformat(), r["category"], _money(r["amount"], args.currency),
+                       r["note"][:23] + "…" if len(r["note"]) > 24 else r["note"]] for r in records]
+    if not records:
+        print("No expenses.")
+    elif args.format == "json":
+        print(json.dumps(data, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(headers)
+        writer.writerows(csv_rows)
+    elif args.format == "markdown":
+        if col:
+            print("error: Markdown format requires an ungrouped expense report", file=sys.stderr)
+            return
+        print("| Date | Category | Amount | Note |")
+        print("| --- | --- | ---: | --- |")
+        for row in records:
+            note = row["note"].replace("\\", "\\\\").replace("|", "\\|").replace("\n", "<br>")
+            category = row["category"].replace("\\", "\\\\").replace("|", "\\|").replace("\n", "<br>")
+            print(f"| {row['date'].isoformat()} | {category} | {_money(row['amount'])} | {note} |")
+        print(f"| Total | | {_money(total)} | |")
+    elif col:
+        print(_table([col, "Count", "Total"], table_rows, {2}, total, args.no_header, args.currency), end="")
+    else:
+        print(_table(["Date", "Category", "Amount", "Note"], table_rows, {2}, total,
+                     args.no_header, args.currency), end="")
+    if invalid:
+        print(f"warning: skipped {invalid} row{'s' if invalid != 1 else ''} with invalid amount", file=sys.stderr)
+
+
+def main(argv=None):
+    args = _parser().parse_args(argv)
+    if args.from_date and args.to_date and args.from_date > args.to_date:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    if args.minimum is None and any(arg == "--min" for arg in (argv or sys.argv[1:])):
+        print("error: invalid amount for --min", file=sys.stderr)
+        return 2
+    if args.top is not None and args.top < 0:
+        print("error: --top must be non-negative", file=sys.stderr)
+        return 2
+    try:
+        rows = load(args.path)
+        records, invalid = _records(rows)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except argparse.ArgumentTypeError as error:
+        print(f"error: {error}", file=sys.stderr)
+        return 2
+    except (TypeError, AttributeError):
+        print("error: invalid expense data", file=sys.stderr)
+        return 2
+    categories = {name.casefold() for name in args.category}
+    excluded = {name.casefold() for name in args.exclude}
+    records = [r for r in records if (not categories or r["category"].casefold() in categories)
+               and r["category"].casefold() not in excluded
+               and (args.from_date is None or r["date"] >= args.from_date)
+               and (args.to_date is None or r["date"] <= args.to_date)
+               and (args.minimum is None or r["amount"] >= args.minimum)]
+    records.sort(key=lambda r: (r["date"], r["index"]))
+    if args.top is not None:
+        records = sorted(records, key=lambda r: r["amount"], reverse=True)[:args.top]
+    _render(args, records, invalid)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
