+"""Create a formatted report from an expense CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Report expenses from a CSV file.", epilog="Example: python -m app.report expenses.csv --by month --format json")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--exclude", action="append", default=[], metavar="NAME", help="exclude a category (repeatable)")
+    parser.add_argument("--from", dest="date_from")
+    parser.add_argument("--to", dest="date_to")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _date(value):
+    try:
+        result = date.fromisoformat(value)
+        if result.isoformat() != value:
+            raise ValueError
+        return result
+    except (ValueError, TypeError):
+        raise ValueError(value)
+
+
+def _money(value, currency):
+    return f"{currency}({abs(value):,.2f})" if value < 0 else f"{currency}{value:,.2f}"
+
+
+def _table(headers, rows, amount_column=None, no_header=False):
+    if not rows:
+        return "No expenses."
+    rows = [[str(cell) for cell in row] for row in rows]
+    widths = [max(len(header), *(len(row[i]) for row in rows)) for i, header in enumerate(headers)]
+    lines = []
+    if not no_header:
+        lines += ["  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)), "  ".join("-" * w for w in widths)]
+    for row in rows:
+        lines.append("  ".join(cell.rjust(widths[i]) if i == amount_column else cell.ljust(widths[i]) for i, cell in enumerate(row)).rstrip())
+    return "\n".join(lines)
+
+
+def _markdown(records, total=None):
+    if not records:
+        return "No expenses."
+    lines = ["| Date | Category | Amount | Note |", "| --- | --- | ---: | --- |"]
+    for date_value, category, amount, note in records:
+        cells = (date_value, category, amount, note)
+        lines.append("| " + " | ".join(str(cell).replace("|", "\\|").replace("\n", "<br>") for cell in cells) + " |")
+    if total:
+        lines.append(f"| Total | | {total[2]} | |")
+    return "\n".join(lines)
+
+
+def _emit(records, headers, json_rows, csv_rows, args, total=None):
+    if args.format == "json":
+        print(json.dumps(json_rows, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(headers)
+        writer.writerows(csv_rows)
+    elif args.format == "markdown":
+        print(_markdown(records, total))
+    elif not records:
+        print("No expenses.")
+    else:
+        print(_table(headers, records + ([total] if total else []), amount_column=2, no_header=args.no_header))
+
+
+def main(argv: list[str]) -> int:
+    args = _parser().parse_args(argv)
+    if args.format not in ("table", "json", "csv", "markdown"):
+        print(f"error: unknown format: {args.format}", file=sys.stderr)
+        return 2
+    try:
+        start = _date(args.date_from) if args.date_from else None
+        end = _date(args.date_to) if args.date_to else None
+    except ValueError as exc:
+        print(f"error: invalid date: {exc.args[0]}", file=sys.stderr)
+        return 2
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    valid, invalid_count = [], 0
+    for index, row in enumerate(rows):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, ValueError, TypeError, KeyError):
+            invalid_count += 1
+            continue
+        try:
+            row_date = _date(row["date"])
+        except (ValueError, TypeError, KeyError):
+            continue
+        valid.append({"date": row["date"], "_date": row_date, "category": row.get("category", ""), "amount": amount, "note": row.get("note", ""), "_index": index})
+
+    categories = {value.casefold() for value in args.category}
+    excluded = {value.casefold() for value in args.exclude}
+    minimum = Decimal(args.minimum) if args.minimum is not None else None
+    selected = [r for r in valid if (not categories or r["category"].casefold() in categories)
+                and r["category"].casefold() not in excluded
+                and (start is None or r["_date"] >= start) and (end is None or r["_date"] <= end)
+                and (minimum is None or r["amount"] >= minimum)]
+
+    if args.by:
+        groups = {}
+        for row in selected:
+            key = row["category"] if args.by == "category" else row["date"][:7]
+            count, amount = groups.get(key, (0, Decimal(0)))
+            groups[key] = count + 1, amount + row["amount"]
+        groups = sorted(groups.items(), key=(lambda item: (-item[1][1], item[0].casefold())) if args.by == "category" else lambda item: item[0])
+        records = [(key.title() if args.by == "category" else key, count, _money(amount, args.currency)) for key, (count, amount) in groups]
+        total = sum((amount for _, (_, amount) in groups), Decimal(0))
+        count = sum(n for _, (n, _) in groups)
+        _emit(records, ["group", "count", "total"],
+              [{"group": k, "count": n, "total": float(a)} for k, (n, a) in groups],
+              [[k, n, f"{a:.2f}"] for k, (n, a) in groups], args,
+              ("Total", count, _money(total, args.currency)))
+    else:
+        selected.sort(key=lambda r: (r["_date"], r["_index"]))
+        if args.top is not None:
+            selected = sorted(selected, key=lambda r: (-r["amount"], r["_index"]))[:max(0, args.top)]
+        total = sum((r["amount"] for r in selected), Decimal(0))
+        records = [(r["date"], r["category"], _money(r["amount"], args.currency), r["note"] if args.format == "markdown" or len(r["note"]) <= 24 else r["note"][:23] + "…") for r in selected]
+        _emit(records, ["date", "category", "amount", "note"],
+              [{"date": r["date"], "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in selected],
+              [[r["date"], r["category"], f"{r['amount']:.2f}", r["note"]] for r in selected], args,
+              ("Total", "", _money(total, args.currency), ""))
+
+    if invalid_count:
+        noun = "row" if invalid_count == 1 else "rows"
+        print(f"warning: skipped {invalid_count} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
