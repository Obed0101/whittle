+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Report expenses from a CSV file.")
+    parser.add_argument("path", help="expense CSV file")
+    parser.add_argument("--category", action="append", default=[], metavar="NAME", help="keep this category (repeatable)")
+    parser.add_argument("--exclude", action="append", default=[], metavar="NAME", help="exclude this category (repeatable)")
+    parser.add_argument("--from", dest="date_from", metavar="DATE", help="include expenses on or after DATE (YYYY-MM-DD)")
+    parser.add_argument("--to", dest="date_to", metavar="DATE", help="include expenses on or before DATE (YYYY-MM-DD)")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT", help="minimum expense amount")
+    parser.add_argument("--by", choices=("category", "month"), help="group expenses by category or month")
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table", help="output format")
+    parser.add_argument("--currency", default="", metavar="SYMBOL", help="prefix table amounts with SYMBOL")
+    parser.add_argument("--top", type=int, metavar="N", help="show the N largest expenses")
+    parser.add_argument("--no-header", action="store_true", help="omit the table header")
+    return parser
+
+
+def _amount(value):
+    try:
+        amount = Decimal(value)
+        return amount if amount.is_finite() else None
+    except (InvalidOperation, TypeError):
+        return None
+
+
+def _money(value, currency=""):
+    formatted = f"{currency}{abs(value):,.2f}"
+    return f"({formatted})" if value < 0 else formatted
+
+
+def _table(headers, rows, total, currency, no_header, amount_column):
+    if not rows:
+        return "No expenses.\n"
+    rows = [[_money(value, currency) if i == amount_column else str(value)
+             for i, value in enumerate(row)] for row in rows]
+    widths = [max(len(header), *(len(row[i]) for row in rows)) for i, header in enumerate(headers)]
+    widths[amount_column] = max(widths[amount_column], len(_money(total, currency)))
+
+    def line(values):
+        cells = [value.rjust(widths[i]) if i == amount_column else value.ljust(widths[i])
+                 for i, value in enumerate(values)]
+        return "  ".join(cells).rstrip()
+
+    output = []
+    if not no_header:
+        output.extend((line(headers), line(["-" * len(header) for header in headers])))
+    output.extend(line(row) for row in rows)
+    ending = [""] * len(headers)
+    ending[0], ending[-1] = "Total", _money(total, currency)
+    output.append(line(ending))
+    return "\n".join(output) + "\n"
+
+
+def _groups(rows, by):
+    grouped = {}
+    for row in rows:
+        key = row["category"] if by == "category" else row["date"][:7]
+        grouped.setdefault(key, []).append(row)
+    if by == "category":
+        return sorted(grouped.items(), key=lambda item: (-sum(r["amount"] for r in item[1]), item[0].casefold()))
+    return sorted(grouped.items())
+
+
+def main(argv=None):
+    parser = _parser()
+    args = parser.parse_args(argv)
+    try:
+        start = date.fromisoformat(args.date_from) if args.date_from else None
+        end = date.fromisoformat(args.date_to) if args.date_to else None
+    except ValueError:
+        print(f"error: invalid date: {args.date_from if args.date_from else args.date_to}", file=sys.stderr)
+        return 2
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+
+    minimum = _amount(args.minimum) if args.minimum is not None else None
+    if args.minimum is not None and minimum is None:
+        parser.error(f"invalid minimum amount: {args.minimum}")
+    try:
+        raw = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    records, skipped = [], 0
+    for row in raw:
+        amount = _amount(row.get("amount"))
+        if amount is None:
+            skipped += 1
+            continue
+        value = {key: row.get(key, "") for key in ("date", "category", "note")}
+        value["amount"] = amount
+        try:
+            value["_date"] = date.fromisoformat(value["date"])
+        except ValueError:
+            value["_date"] = None
+        records.append(value)
+
+    categories = {value.casefold() for value in args.category}
+    excluded = {value.casefold() for value in args.exclude}
+    selected = [row for row in records
+                if (not categories or row["category"].casefold() in categories)
+                and row["category"].casefold() not in excluded
+                and (start is None or row["_date"] is not None and row["_date"] >= start)
+                and (end is None or row["_date"] is not None and row["_date"] <= end)
+                and (minimum is None or row["amount"] >= minimum)]
+    selected.sort(key=lambda row: (row["_date"] is None, row["_date"] or date.min))
+    if args.top is not None:
+        selected = sorted(selected, key=lambda row: row["amount"], reverse=True)[:max(0, args.top)]
+
+    total = sum((row["amount"] for row in selected), Decimal(0))
+    if args.format == "json":
+        if args.by:
+            result = [{"group": key, "count": len(items),
+                       "total": float(sum((row["amount"] for row in items), Decimal(0)))}
+                      for key, items in _groups(selected, args.by)]
+        else:
+            result = [{key: float(row[key]) if key == "amount" else row[key]
+                       for key in ("date", "category", "amount", "note")} for row in selected]
+        print(json.dumps(result, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(("date", "category", "amount", "note"))
+        for row in selected:
+            writer.writerow((row["date"], row["category"], f"{row['amount']:.2f}", row["note"]))
+    elif args.format == "markdown":
+        print("| Date | Category | Amount | Note |")
+        print("| --- | --- | ---: | --- |")
+        for row in selected:
+            print(f"| {row['date']} | {row['category']} | {row['amount']:,.2f} | {row['note']} |")
+        print(f"| Total | | {total:,.2f} | |")
+    elif args.by:
+        groups = _groups(selected, args.by)
+        label = "Category" if args.by == "category" else "Month"
+        rows = [[key.title() if args.by == "category" else key, str(len(items)),
+                 sum((row["amount"] for row in items), Decimal(0))] for key, items in groups]
+        print(_table([label, "Count", "Total"], rows, total, args.currency, args.no_header, 2), end="")
+    else:
+        rows = [[row["date"], row["category"], row["amount"],
+                 row["note"] if len(row["note"]) <= 24 else row["note"][:23] + "…"]
+                for row in selected]
+        print(_table(["Date", "Category", "Amount", "Note"], rows, total,
+                     args.currency, args.no_header, 2), end="")
+
+    if skipped:
+        print(f"warning: skipped {skipped} row{'s' if skipped != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
