+"""Generate reports from expense CSV files."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Report expenses from a CSV file.", epilog="Example: python -m app.report expenses.csv --by category")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", dest="categories", metavar="NAME")
+    parser.add_argument("--exclude", action="append", dest="excluded_categories", metavar="NAME", help="exclude a category (repeatable)")
+    parser.add_argument("--from", dest="date_from", type=date.fromisoformat, metavar="DATE")
+    parser.add_argument("--to", dest="date_to", type=date.fromisoformat, metavar="DATE")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="", metavar="SYMBOL")
+    parser.add_argument("--top", type=int, metavar="N")
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _groups(rows, by):
+    groups = {}
+    for row in rows:
+        key = row["category"] if by == "category" else row["_date"].strftime("%Y-%m")
+        count, total = groups.get(key, (0, Decimal(0)))
+        groups[key] = count + 1, total + row["amount"]
+    return sorted(((key, *value) for key, value in groups.items()),
+                  key=(lambda group: (-group[2], group[0].casefold())) if by == "category" else lambda group: group[0])
+
+
+def _table(rows, groups, args):
+    headers = (["Category" if args.by == "category" else "Month", "Count", "Total"]
+               if args.by else ["Date", "Category", "Amount", "Note"])
+    if args.by:
+        values = [[key, str(count), args.currency + f"{total:,.2f}"] for key, count, total in groups]
+    else:
+        values = []
+        for row in rows:
+            note = row["note"][:23] + "…" if len(row["note"]) > 24 else row["note"]
+            amount = row["amount"]
+            money = args.currency + f"{abs(amount):,.2f}"
+            values.append([row["date"], row["category"], f"({money})" if amount < 0 else money, note])
+    widths = [max(len(header), *(len(row[i]) for row in values)) for i, header in enumerate(headers)]
+    lines = [] if args.no_header else [
+        "  ".join(header.ljust(widths[i]) for i, header in enumerate(headers)),
+        "  ".join("-" * width for width in widths),
+    ]
+    for row in values:
+        lines.append("  ".join(value.rjust(widths[i]) if i == 2 else value.ljust(widths[i])
+                                 for i, value in enumerate(row)).rstrip())
+    total = sum((row["amount"] for row in rows), Decimal(0))
+    lines.append(f"Total  {sum(group[1] for group in groups)}  {args.currency}{total:,.2f}" if args.by
+                 else f"Total  {args.currency}{total:,.2f}")
+    return "\n".join(lines) + "\n"
+
+
+def _markdown(rows):
+    lines = [
+        "| Date | Category | Amount | Note |",
+        "| --- | --- | ---: | --- |",
+    ]
+    for row in rows:
+        note = row["note"].replace("\\", "\\\\").replace("|", "\\|").replace("\r\n", "<br>").replace("\r", "<br>").replace("\n", "<br>")
+        lines.append(f"| {row['date']} | {row['category']} | {row['amount']:,.2f} | {note} |")
+    total = sum((row["amount"] for row in rows), Decimal(0))
+    lines.append(f"| Total | | {total:,.2f} | |")
+    return "\n".join(lines) + "\n"
+
+
+def _valid_rows(raw):
+    rows, skipped = [], 0
+    for index, row in enumerate(raw):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, KeyError, TypeError):
+            skipped += 1
+            continue
+        try:
+            parsed_date = date.fromisoformat(row["date"])
+        except (TypeError, ValueError):
+            parsed_date = None
+        rows.append({**row, "amount": amount, "_date": parsed_date, "_index": index})
+    return rows, skipped
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    if args.date_from and args.date_to and args.date_from > args.date_to:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+        if minimum is not None and not minimum.is_finite():
+            raise InvalidOperation
+    except (InvalidOperation, ValueError):
+        print(f"error: invalid amount: {args.minimum}", file=sys.stderr)
+        return 2
+    try:
+        raw = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    rows, skipped = _valid_rows(raw)
+    categories = {item.casefold() for item in args.categories or []}
+    excluded = {item.casefold() for item in args.excluded_categories or []}
+    selected = [row for row in rows if row["_date"] is not None
+                and (not categories or row["category"].casefold() in categories)
+                and row["category"].casefold() not in excluded
+                and (not args.date_from or row["_date"] >= args.date_from)
+                and (not args.date_to or row["_date"] <= args.date_to)
+                and (minimum is None or row["amount"] >= minimum)]
+    selected.sort(key=lambda row: (row["_date"], row["_index"]))
+    if args.top is not None:
+        if args.top < 0:
+            parser.error("--top must be non-negative")
+        selected = sorted(selected, key=lambda row: (-row["amount"], row["_index"]))[:args.top]
+
+    if not selected:
+        print("No expenses.")
+    elif args.format == "json":
+        groups = _groups(selected, args.by) if args.by else None
+        payload = ([{"group": key, "count": count, "total": float(total)} for key, count, total in groups]
+                   if groups is not None else [{key: row[key] for key in ("date", "category", "amount", "note")}
+                                               | {"amount": float(row["amount"])} for row in selected])
+        print(json.dumps(payload, indent=2))
+    elif args.format == "markdown":
+        sys.stdout.write(_markdown(selected))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        writer.writerows([row["date"], row["category"], f"{row['amount']:.2f}", row["note"]] for row in selected)
+    else:
+        groups = _groups(selected, args.by) if args.by else []
+        if args.by == "category":
+            groups = [(key.title(), count, total) for key, count, total in groups]
+        sys.stdout.write(_table(selected, groups, args))
+    if skipped:
+        print(f"warning: skipped {skipped} row{'s' if skipped != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
