+"""Generate reports from expense CSV files."""
+import argparse
+import csv
+import json
+import sys
+from collections import defaultdict
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report",
+                                     description="Report expenses from a CSV file.",
+                                     epilog="Example: python -m app.report expenses.csv --by category")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--exclude", action="append", default=[], metavar="NAME",
+                        help="exclude a category (can be repeated; case-insensitive)")
+    parser.add_argument("--from", dest="date_from")
+    parser.add_argument("--to", dest="date_to")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _amount(value):
+    try:
+        amount = Decimal(value)
+        return amount if amount.is_finite() else None
+    except (InvalidOperation, TypeError, ValueError):
+        return None
+
+
+def _money(value):
+    return f"({abs(value):,.2f})" if value < 0 else f"{value:,.2f}"
+
+
+def _groups(selected, by):
+    groups = defaultdict(list)
+    for item in selected:
+        row = item[0]
+        groups[row.get("category", "") if by == "category" else row.get("date", "")[:7]].append(item)
+    result = [(key, items, sum((item[1] for item in items), Decimal(0)))
+              for key, items in groups.items()]
+    return sorted(result, key=(lambda x: (-x[2], x[0].casefold())) if by == "category" else lambda x: x[0])
+
+
+def _table(headings, data, right=(), total=None, no_header=False):
+    widths = [max(len(headings[i]), *(len(row[i]) for row in data)) for i in range(len(headings))]
+    if not no_header:
+        print("  ".join((headings[i].rjust(widths[i]) if i in right else headings[i].ljust(widths[i]))
+                        for i in range(len(headings))))
+        print("  ".join("-" * width for width in widths))
+    for row in data:
+        print("  ".join(row[i].rjust(widths[i]) if i in right else row[i].ljust(widths[i])
+                        for i in range(len(row))))
+    if total is not None:
+        print(total(widths))
+
+
+def _display(selected, total, args):
+    if not selected:
+        print("No expenses.")
+    elif args.format == "json":
+        data = ([{"group": key, "count": len(items), "total": float(amount)}
+                 for key, items, amount in _groups(selected, args.by)] if args.by else
+                [{"date": row[0]["date"], "category": row[0]["category"],
+                  "amount": float(row[1]), "note": row[0].get("note", "")} for row in selected])
+        print(json.dumps(data, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        for row, amount, _, _ in selected:
+            writer.writerow([row.get("date", ""), row.get("category", ""), f"{amount:.2f}", row.get("note", "")])
+    elif args.format == "markdown":
+        print("| Date | Category | Amount | Note |")
+        print("| --- | --- | ---: | --- |")
+        for row, amount, _, _ in selected:
+            note = row.get("note", "").replace("|", "\\|")
+            print(f"| {row.get('date', '')} | {row.get('category', '')} | {args.currency}{_money(amount)} | {note} |")
+        print(f"| Total | | {args.currency}{_money(total)} | |")
+    elif args.by:
+        heading = "Category" if args.by == "category" else "Month"
+        data = [[key.title() if args.by == "category" else key, str(len(items)), args.currency + _money(amount)]
+                for key, items, amount in _groups(selected, args.by)]
+        _table([heading, "Count", "Total"], data, total=lambda _: f"Total  {args.currency}{_money(total)}",
+               no_header=args.no_header)
+    else:
+        headings = ["Date", "Category", "Amount", "Note"]
+        data = []
+        for row, amount, _, _ in selected:
+            note = row.get("note", "")
+            data.append([row.get("date", ""), row.get("category", ""), args.currency + _money(amount),
+                         note[:23] + "…" if len(note) > 24 else note])
+        _table(headings, data, right=(2,), no_header=args.no_header,
+               total=lambda w: f"Total{' ' * max(2, w[0] + w[1] + 2)}{args.currency}{_money(total)}")
+
+
+def main(argv: list[str]) -> int:
+    args = _parser().parse_args(argv)
+    try:
+        start = date.fromisoformat(args.date_from) if args.date_from else None
+        end = date.fromisoformat(args.date_to) if args.date_to else None
+    except ValueError:
+        bad = args.date_from if args.date_from and _invalid_date(args.date_from) else args.date_to
+        print(f"error: invalid date: {bad}", file=sys.stderr)
+        return 2
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    valid, invalid = [], 0
+    for index, row in enumerate(rows):
+        amount = _amount(row.get("amount"))
+        if amount is None:
+            invalid += 1
+            continue
+        try:
+            row_date = date.fromisoformat(row.get("date", ""))
+        except ValueError:
+            continue
+        valid.append((row, amount, row_date, index))
+    minimum = _amount(args.minimum) if args.minimum is not None else None
+    categories = {value.casefold() for value in args.category}
+    excluded = {value.casefold() for value in args.exclude}
+    selected = [item for item in valid if
+                (not categories or item[0].get("category", "").casefold() in categories)
+                and item[0].get("category", "").casefold() not in excluded
+                and (start is None or item[2] >= start) and (end is None or item[2] <= end)
+                and (minimum is None or item[1] >= minimum)]
+    if args.by is None:
+        selected.sort(key=lambda item: (item[2], item[3]))
+        if args.top is not None:
+            selected = sorted(selected, key=lambda item: (-item[1], item[3]))[:max(0, args.top)]
+            selected.sort(key=lambda item: (item[2], item[3]))
+    _display(selected, sum((item[1] for item in selected), Decimal(0)), args)
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _invalid_date(value):
+    try:
+        date.fromisoformat(value)
+        return False
+    except ValueError:
+        return True
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
