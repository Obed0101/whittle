+"""Render expense CSV files as reports."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[], metavar="NAME")
+    parser.add_argument("--exclude", action="append", default=[], metavar="NAME")
+    parser.add_argument("--from", dest="date_from", metavar="DATE")
+    parser.add_argument("--to", dest="date_to", metavar="DATE")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int, metavar="N")
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _date(value):
+    try:
+        result = date.fromisoformat(value)
+        if result.isoformat() != value:
+            raise ValueError
+        return result
+    except (TypeError, ValueError):
+        raise ValueError(value) from None
+
+
+def _groups(expenses, by):
+    groups = {}
+    for expense in expenses:
+        name = expense["category"] if by == "category" else expense["date"][:7]
+        count, total = groups.get(name, (0, Decimal(0)))
+        groups[name] = count + 1, total + expense["amount"]
+    key = (lambda item: (-item[1][1], item[0].casefold(), item[0])) if by == "category" else lambda item: item[0]
+    return [(name, *values) for name, values in sorted(groups.items(), key=key)]
+
+
+def _print_table(headers, rows, total, args, amount_col):
+    currency = args.currency
+    rows = [list(row) for row in rows]
+    for row in rows:
+        amount = row[amount_col]
+        row[amount_col] = currency + (f"({amount[1:]})" if amount.startswith("-") else amount)
+    widths = [max(len(str(header)), *(len(str(row[i])) for row in rows)) for i, header in enumerate(headers)]
+    if not args.no_header:
+        print("  ".join(str(h).ljust(widths[i]) for i, h in enumerate(headers)))
+        print("  ".join("-" * width for width in widths))
+    for row in rows:
+        print("  ".join((str(v).rjust(widths[i]) if i == amount_col else str(v).ljust(widths[i]))
+                         for i, v in enumerate(row)))
+    total = f"({_money(-total)})" if total < 0 else _money(total)
+    print(f"Total  {currency}{total}")
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _report(expenses, args):
+    if args.format == "json":
+        data = (_groups(expenses, args.by) if args.by else expenses)
+        if args.by:
+            data = [{"group": name, "count": count, "total": float(total)} for name, count, total in data]
+        else:
+            data = [{key: (float(e[key]) if key == "amount" else e[key])
+                     for key in ("date", "category", "amount", "note")} for e in data]
+        print(json.dumps(data, indent=2, ensure_ascii=False))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        writer.writerows((e["date"], e["category"], f'{e["amount"]:.2f}', e["note"]) for e in expenses)
+    elif args.format == "markdown":
+        print("| Date | Category | Amount | Note |")
+        print("| --- | --- | ---: | --- |")
+        for expense in expenses:
+            print(f'| {expense["date"]} | {expense["category"]} | {_money(expense["amount"])} | {expense["note"]} |')
+        print(f"| Total | | {_money(_total(expenses))} | |")
+    elif args.by:
+        groups = _groups(expenses, args.by)
+        label = "Category" if args.by == "category" else "Month"
+        rows = [(name.title() if args.by == "category" else name, str(count), _money(total))
+                for name, count, total in groups]
+        _print_table([label, "Count", "Total"], rows, _total(expenses), args, 2)
+    else:
+        rows = [(e["date"], e["category"], _money(e["amount"]),
+                 e["note"][:23] + "…" if len(e["note"]) > 24 else e["note"]) for e in expenses]
+        _print_table(["Date", "Category", "Amount", "Note"], rows, _total(expenses), args, 2)
+
+
+def _total(expenses):
+    return sum((e["amount"] for e in expenses), Decimal(0))
+
+
+def main(argv: list[str]) -> int:
+    args = _parser().parse_args(argv)
+    try:
+        start, end = (_date(value) if value else None for value in (args.date_from, args.date_to))
+    except ValueError as exc:
+        print(f"error: invalid date: {exc.args[0]}", file=sys.stderr)
+        return 2
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    expenses, invalid = [], 0
+    try:
+        for index, row in enumerate(rows):
+            try:
+                amount = Decimal(row.get("amount", ""))
+                if not amount.is_finite():
+                    raise InvalidOperation
+            except (InvalidOperation, ValueError):
+                invalid += 1
+                continue
+            day = _date(row.get("date", ""))
+            expenses.append({"date": day.isoformat(), "category": row.get("category", ""),
+                             "amount": amount, "note": row.get("note", ""), "_day": day, "_index": index})
+    except ValueError as exc:
+        print(f"error: invalid date: {exc.args[0]}", file=sys.stderr)
+        return 2
+
+    categories = {name.casefold() for name in args.category}
+    excluded = {name.casefold() for name in args.exclude}
+    expenses = [e for e in expenses if (not categories or e["category"].casefold() in categories)
+                and e["category"].casefold() not in excluded
+                and (start is None or e["_day"] >= start) and (end is None or e["_day"] <= end)
+                and (args.minimum is None or e["amount"] >= Decimal(args.minimum))]
+    expenses.sort(key=lambda e: (e["_day"], e["_index"]))
+    if args.top is not None:
+        expenses = sorted(expenses, key=lambda e: e["amount"], reverse=True)[:max(0, args.top)]
+    if expenses:
+        _report(expenses, args)
+    else:
+        print("No expenses.")
+    if invalid:
+        print(f"warning: skipped {invalid} {'row' if invalid == 1 else 'rows'} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
