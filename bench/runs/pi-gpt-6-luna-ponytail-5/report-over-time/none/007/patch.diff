+"""Command-line expense reports."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from .expenses import load
+
+
+def _date(value):
+    try:
+        result = date.fromisoformat(value)
+        if result.isoformat() != value:
+            raise ValueError
+        return result
+    except (ValueError, TypeError):
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+
+
+def _amount(value):
+    try:
+        result = Decimal(value)
+        return result if result.is_finite() else None
+    except (InvalidOperation, TypeError):
+        return None
+
+
+def _table(headers, rows, total, currency, no_header):
+    widths = [max(len(header), *(len(row[i]) for row in rows)) for i, header in enumerate(headers)]
+    lines = [] if no_header else [
+        "  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)),
+        "  ".join("-" * width for width in widths),
+    ]
+    amount_col = 2 if headers == ["Date", "Category", "Amount", "Note"] else None
+    lines += ["  ".join((cell.rjust(widths[i]) if i == amount_col else cell.ljust(widths[i]))
+                       for i, cell in enumerate(row)) for row in rows]
+    lines.append(f"Total  {currency}{total:,.2f}")
+    return "\n".join(lines) + "\n"
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Create an expense report.",
+                                     epilog="Example: python -m app.report expenses.csv --by month")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--exclude", action="append", default=[], metavar="NAME",
+                        help="exclude a category (may be repeated; case-insensitive)")
+    parser.add_argument("--from", dest="from_date", type=_date)
+    parser.add_argument("--to", dest="to_date", type=_date)
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _groups(records, by):
+    groups = {}
+    for record in records:
+        key = record["category"].title() if by == "category" else record["date"][:7]
+        count, total = groups.get(key, (0, Decimal(0)))
+        groups[key] = count + 1, total + record["amount"]
+    return sorted(groups.items(), key=(lambda item: (-item[1][1], item[0].casefold()))
+                  if by == "category" else lambda item: item[0])
+
+
+def _output(records, args):
+    if not records:
+        print("No expenses.")
+        return
+    total = sum((r["amount"] for r in records), Decimal(0))
+    if args.by:
+        groups = _groups(records, args.by)
+        if args.format == "json":
+            print(json.dumps([{"group": key, "count": count, "total": float(amount)}
+                              for key, (count, amount) in groups], indent=2))
+        elif args.format == "csv":
+            writer = csv.writer(sys.stdout, lineterminator="\n")
+            writer.writerow(["group", "count", "total"])
+            writer.writerows((key, count, f"{amount:.2f}") for key, (count, amount) in groups)
+        else:
+            rows = [[key, str(count), f"{amount:,.2f}"] for key, (count, amount) in groups]
+            heading = "Category" if args.by == "category" else "Month"
+            print(_table([heading, "Count", "Total"], rows, total, args.currency, args.no_header), end="")
+    elif args.format == "json":
+        print(json.dumps([{k: (float(v) if k == "amount" else v)
+                           for k, v in r.items() if not k.startswith("_")} for r in records], indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        writer.writerows((r["date"], r["category"], f"{r['amount']:.2f}", r["note"]) for r in records)
+    elif args.format == "markdown":
+        print("| Date | Category | Amount | Note |")
+        print("| --- | --- | ---: | --- |")
+        for record in records:
+            amount = args.currency + (f"({abs(record['amount']):,.2f})" if record["amount"] < 0
+                                      else f"{record['amount']:,.2f}")
+            print(f"| {record['date']} | {record['category']} | {amount} | {record['note']} |")
+        amount = args.currency + (f"({abs(total):,.2f})" if total < 0 else f"{total:,.2f}")
+        print(f"| Total | | {amount} | |")
+    else:
+        rows = [[r["date"], r["category"], args.currency +
+                 (f"({abs(r['amount']):,.2f})" if r["amount"] < 0 else f"{r['amount']:,.2f}"),
+                 r["note"] if len(r["note"]) <= 24 else r["note"][:23] + "…"] for r in records]
+        print(_table(["Date", "Category", "Amount", "Note"], rows, total, args.currency, args.no_header), end="")
+
+
+def main(argv: list[str]) -> int:
+    args = _parser().parse_args(argv)
+    if args.from_date and args.to_date and args.from_date > args.to_date:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    minimum = _amount(args.minimum) if args.minimum is not None else None
+    if args.minimum is not None and minimum is None:
+        print(f"error: invalid amount: {args.minimum}", file=sys.stderr)
+        return 2
+    try:
+        raw = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except OSError as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 2
+
+    records, skipped = [], 0
+    for index, row in enumerate(raw):
+        amount = _amount(row.get("amount", ""))
+        if amount is None:
+            skipped += 1
+            continue
+        try:
+            parsed = _date(row.get("date", ""))
+        except argparse.ArgumentTypeError as exc:
+            print(f"error: {exc}", file=sys.stderr)
+            return 2
+        records.append({"date": parsed.isoformat(), "_date": parsed, "category": row.get("category", ""),
+                        "amount": amount, "note": row.get("note", ""), "_index": index})
+
+    categories = {name.casefold() for name in args.category}
+    excluded = {name.casefold() for name in args.exclude}
+    records = [r for r in records if (not categories or r["category"].casefold() in categories)
+               and r["category"].casefold() not in excluded
+               and (args.from_date is None or r["_date"] >= args.from_date)
+               and (args.to_date is None or r["_date"] <= args.to_date)
+               and (minimum is None or r["amount"] >= minimum)]
+    records.sort(key=lambda r: (r["_date"], r["_index"]))
+    if args.top is not None:
+        records = sorted(records, key=lambda r: (-r["amount"], r["_index"]))[:max(0, args.top)]
+    _output(records, args)
+    if skipped:
+        print(f"warning: skipped {skipped} {'row' if skipped == 1 else 'rows'} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
