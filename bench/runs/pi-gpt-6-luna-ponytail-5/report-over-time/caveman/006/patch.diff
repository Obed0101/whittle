@@ -0,0 +1,161 @@
+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _date(value):
+    try:
+        parsed = date.fromisoformat(value)
+        if parsed.isoformat() == value:
+            return parsed
+    except (TypeError, ValueError):
+        pass
+    raise argparse.ArgumentTypeError(f"invalid date: {value}")
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Create an expense report.", epilog="Example: python -m app.report expenses.csv --format json")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--exclude", action="append", default=[], help="exclude a category (can be repeated)")
+    parser.add_argument("--from", dest="from_date", type=_date)
+    parser.add_argument("--to", dest="to_date", type=_date)
+    parser.add_argument("--min", dest="minimum", type=Decimal)
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _amount(value):
+    try:
+        amount = Decimal(value)
+        return amount if amount.is_finite() else None
+    except (InvalidOperation, TypeError, ValueError):
+        return None
+
+
+def _money(value):
+    number = f"{abs(value):,.2f}"
+    return f"({number})" if value < 0 else number
+
+
+def _table(headers, rows, amount_columns=()):
+    widths = [max(len(str(row[i])) for row in [headers, *rows]) for i in range(len(headers))]
+    lines = ["  ".join(str(v).ljust(widths[i]) for i, v in enumerate(headers)),
+             "  ".join("-" * width for width in widths)]
+    for row in rows:
+        lines.append("  ".join(str(v).rjust(widths[i]) if i in amount_columns else str(v).ljust(widths[i])
+                               for i, v in enumerate(row)))
+    return lines
+
+
+def _print_table(headers, rows, args, amount_columns):
+    lines = _table(headers, rows, amount_columns)
+    print("\n".join(lines[2:] if args.no_header else lines))
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as exc:
+        return int(exc.code)
+
+    error = ("error: --top must be non-negative" if args.top is not None and args.top < 0 else
+             "error: --from is after --to" if args.from_date and args.to_date and args.from_date > args.to_date else None)
+    if error:
+        print(error, file=sys.stderr)
+        return 2
+    try:
+        source = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    included = {value.casefold() for value in args.category}
+    excluded = {value.casefold() for value in args.exclude}
+    rows, invalid = [], 0
+    for row in source:
+        amount = _amount(row.get("amount"))
+        if amount is None:
+            invalid += 1
+            continue
+        raw_date = row.get("date", "")
+        try:
+            parsed = _date(raw_date)
+        except argparse.ArgumentTypeError:
+            print(f"error: invalid date: {raw_date}", file=sys.stderr)
+            return 2
+        category = row.get("category", "")
+        if included and category.casefold() not in included or category.casefold() in excluded:
+            continue
+        if args.from_date and parsed < args.from_date or args.to_date and parsed > args.to_date:
+            continue
+        if args.minimum is not None and amount < args.minimum:
+            continue
+        rows.append({"date": raw_date, "_date": parsed, "category": category,
+                     "amount": amount, "note": row.get("note", "")})
+
+    rows.sort(key=lambda row: row["_date"])
+    if args.top is not None:
+        rows = sorted(rows, key=lambda row: -row["amount"])[:args.top]
+    total = sum((row["amount"] for row in rows), Decimal("0"))
+    if args.by:
+        groups = {}
+        for row in rows:
+            key = row["category"].title() if args.by == "category" else row["_date"].strftime("%Y-%m")
+            count, subtotal = groups.get(key, (0, Decimal("0")))
+            groups[key] = count + 1, subtotal + row["amount"]
+        ordered = sorted(groups.items(), key=lambda item: (
+            -item[1][1] if args.by == "category" else item[0],
+            item[0].casefold() if args.by == "category" else ""))
+        if not ordered:
+            print("No expenses.")
+        elif args.format == "json":
+            print(json.dumps([{"group": key, "count": count, "total": float(amount)}
+                              for key, (count, amount) in ordered], indent=2))
+        else:
+            rows_out = [[key, count, f"{args.currency}{_money(amount)}"]
+                        for key, (count, amount) in ordered]
+            rows_out.append(["Total", "", f"{args.currency}{_money(total)}"])
+            _print_table(["Category" if args.by == "category" else "Month", "Count", "Total"],
+                         rows_out, args, (2,))
+    elif not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        print(json.dumps([{"date": row["date"], "category": row["category"],
+                           "amount": float(row["amount"]), "note": row["note"]} for row in rows], indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        writer.writerows([[row["date"], row["category"], f"{row['amount']:.2f}", row["note"]]
+                          for row in rows])
+    elif args.format == "markdown":
+        lines = ["| Date | Category | Amount | Note |",
+                 "| --- | --- | ---: | --- |"]
+        lines.extend(f"| {row['date']} | {row['category']} | {_money(row['amount'])} | {row['note']} |"
+                     for row in rows)
+        lines.append(f"| Total | | {_money(total)} | |")
+        print("\n".join(lines))
+    else:
+        shown = [[row["date"], row["category"], f"{args.currency}{_money(row['amount'])}",
+                  row["note"][:23] + "…" if len(row["note"]) > 24 else row["note"]] for row in rows]
+        shown.append(["Total", "", f"{args.currency}{_money(total)}", ""])
+        _print_table(["Date", "Category", "Amount", "Note"], shown, args, (2,))
+
+    if invalid:
+        print(f"warning: skipped {invalid} {'row' if invalid == 1 else 'rows'} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
