+"""Render expense CSV files as reports."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Create a report from an expense CSV.")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--exclude", action="append", default=[])
+    parser.add_argument("--from", dest="from_date")
+    parser.add_argument("--to", dest="to_date")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _date(value):
+    try:
+        parsed = date.fromisoformat(value)
+        if parsed.isoformat() == value:
+            return parsed
+    except (TypeError, ValueError):
+        pass
+    raise ValueError(value)
+
+
+def _money(value):
+    try:
+        result = Decimal(value)
+        return result if result.is_finite() else None
+    except (InvalidOperation, ValueError, TypeError):
+        return None
+
+
+def _amount(value, currency=""):
+    result = f"{currency}{abs(value):,.2f}"
+    return f"({result})" if value < 0 else result
+
+
+def _table(headers, rows, amount_column=None):
+    columns = len(headers) if headers is not None else (len(rows[0]) if rows else 0)
+    widths = [max([len(str(row[i])) for row in rows] + ([len(str(headers[i]))] if headers else [0])) for i in range(columns)]
+    lines = []
+    if headers is not None:
+        lines.extend(("  ".join(str(v).ljust(widths[i]) for i, v in enumerate(headers)),
+                      "  ".join("-" * width for width in widths)))
+    for row in rows:
+        lines.append("  ".join(str(value).rjust(widths[i]) if i == amount_column else str(value).ljust(widths[i])
+                                for i, value in enumerate(row)))
+    return "\n".join(lines)
+
+
+def _read_rows(path):
+    rows, invalid = [], 0
+    for index, item in enumerate(load(path)):
+        amount = _money(item.get("amount"))
+        if amount is None:
+            invalid += 1
+            continue
+        parsed = _date(item.get("date"))
+        rows.append({"date": parsed, "date_text": item["date"], "category": item.get("category", ""),
+                     "amount": amount, "note": item.get("note", ""), "index": index})
+    return rows, invalid
+
+
+def _groups(rows, by):
+    groups = {}
+    for row in rows:
+        key = row["category"].title() if by == "category" else row["date"].strftime("%Y-%m")
+        groups.setdefault(key, []).append(row)
+    result = [(key, items) for key, items in groups.items()]
+    return sorted(result, key=lambda group: (-sum((r["amount"] for r in group[1]), Decimal(0)), group[0].casefold())
+                  if by == "category" else group[0])
+
+
+def _render(rows, args):
+    if args.by:
+        groups = _groups(rows, args.by)
+        if args.top is not None:
+            groups = groups[:args.top]
+        if not groups:
+            print("No expenses.")
+        elif args.format == "json":
+            print(json.dumps([{"group": k, "count": len(items), "total": float(sum((r["amount"] for r in items), Decimal(0)))}
+                              for k, items in groups], indent=2))
+        else:
+            label = "Category" if args.by == "category" else "Month"
+            body = [[k, len(items), _amount(sum((r["amount"] for r in items), Decimal(0)), args.currency)]
+                    for k, items in groups]
+            body.append(["Total", sum(len(items) for _, items in groups),
+                         _amount(sum((r["amount"] for _, items in groups for r in items), Decimal(0)), args.currency)])
+            print(_table(None if args.no_header else [label, "Count", "Total"], body))
+    elif not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        print(json.dumps([{"date": r["date_text"], "category": r["category"], "amount": float(r["amount"]), "note": r["note"]}
+                          for r in rows], indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        writer.writerows([r["date_text"], r["category"], f"{r['amount']:.2f}", r["note"]] for r in rows)
+    elif args.format == "markdown":
+        print("| Date | Category | Amount | Note |")
+        print("| --- | --- | ---: | --- |")
+        for r in rows:
+            print(f"| {r['date_text']} | {r['category']} | {_amount(r['amount'])} | {r['note']} |")
+        total = sum((r["amount"] for r in rows), Decimal(0))
+        print(f"| Total | | {_amount(total)} | |")
+    else:
+        body = []
+        for r in rows:
+            note = r["note"][:23] + "…" if len(r["note"]) > 24 else r["note"]
+            body.append([r["date_text"], r["category"], _amount(r["amount"], args.currency), note])
+        body.append(["Total", "", _amount(sum((r["amount"] for r in rows), Decimal(0)), args.currency), ""])
+        print(_table(None if args.no_header else ["Date", "Category", "Amount", "Note"], body, 2))
+
+
+def main(argv=None):
+    parser = _parser()
+    args = parser.parse_args(argv)
+    try:
+        lower = _date(args.from_date) if args.from_date else None
+        upper = _date(args.to_date) if args.to_date else None
+    except ValueError as exc:
+        print(f"error: invalid date: {exc.args[0]}", file=sys.stderr)
+        return 2
+    if lower and upper and lower > upper:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    minimum = _money(args.minimum) if args.minimum is not None else None
+    if args.minimum is not None and minimum is None:
+        print(f"error: invalid minimum amount: {args.minimum}", file=sys.stderr)
+        return 2
+    if args.top is not None and args.top < 0:
+        print("error: --top must be non-negative", file=sys.stderr)
+        return 2
+    try:
+        rows, invalid = _read_rows(args.path)
+    except (FileNotFoundError, IsADirectoryError):
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except ValueError as exc:
+        print(f"error: invalid date: {exc.args[0]}", file=sys.stderr)
+        return 2
+
+    included, excluded = {x.casefold() for x in args.category}, {x.casefold() for x in args.exclude}
+    rows = [r for r in rows if (not included or r["category"].casefold() in included)
+            and r["category"].casefold() not in excluded
+            and (lower is None or r["date"] >= lower) and (upper is None or r["date"] <= upper)
+            and (minimum is None or r["amount"] >= minimum)]
+    rows.sort(key=lambda r: (r["date"], r["index"]))
+    if args.top is not None:
+        rows = sorted(rows, key=lambda r: (-r["amount"], r["date"], r["index"]))[:args.top]
+    _render(rows, args)
+    if invalid:
+        print(f"warning: skipped {invalid} {'row' if invalid == 1 else 'rows'} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
