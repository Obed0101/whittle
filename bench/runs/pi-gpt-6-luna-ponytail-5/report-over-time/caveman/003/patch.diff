+"""Render expense CSV files as tables, JSON, CSV, or Markdown."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        raise ValueError(message)
+
+
+def _parser():
+    parser = Parser(prog="python -m app.report")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--exclude", action="append", default=[], metavar="NAME",
+                        help="exclude a category (repeatable; case-insensitive)")
+    parser.add_argument("--from", dest="start")
+    parser.add_argument("--to", dest="end")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise ValueError(f"error: invalid date: {value}")
+
+
+def _money(value):
+    try:
+        return Decimal(value)
+    except (InvalidOperation, TypeError, ValueError):
+        return None
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as exc:
+        return int(exc.code)
+    except ValueError as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 2
+
+    if args.start:
+        try:
+            start = _date(args.start)
+        except ValueError as exc:
+            print(exc, file=sys.stderr)
+            return 2
+    else:
+        start = None
+    if args.end:
+        try:
+            end = _date(args.end)
+        except ValueError as exc:
+            print(exc, file=sys.stderr)
+            return 2
+    else:
+        end = None
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    minimum = _money(args.minimum) if args.minimum is not None else None
+    if args.minimum is not None and minimum is None:
+        print(f"error: invalid amount: {args.minimum}", file=sys.stderr)
+        return 2
+
+    try:
+        rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    valid = []
+    skipped = 0
+    for row in rows:
+        amount = _money(row.get("amount"))
+        if amount is None:
+            skipped += 1
+            continue
+        try:
+            parsed = _date(row.get("date"))
+        except ValueError as exc:
+            print(exc, file=sys.stderr)
+            return 2
+        item = dict(row)
+        item["_amount"] = amount
+        item["_date"] = parsed
+        valid.append(item)
+
+    categories = {name.casefold() for name in args.category}
+    excluded = {name.casefold() for name in args.exclude}
+    filtered = [r for r in valid if
+                (not categories or r.get("category", "").casefold() in categories)
+                and r.get("category", "").casefold() not in excluded
+                and (start is None or r["_date"] >= start)
+                and (end is None or r["_date"] <= end)
+                and (minimum is None or r["_amount"] >= minimum)]
+    if args.top is not None:
+        filtered.sort(key=lambda r: -r["_amount"])
+        filtered = filtered[:max(0, args.top)]
+    else:
+        filtered.sort(key=lambda r: r["_date"])
+
+    if not filtered:
+        print("No expenses.")
+    elif args.format == "json":
+        if args.by:
+            groups = _groups(filtered, args.by)
+            result = [{"group": name, "count": count, "total": float(total)} for name, count, total in groups]
+        else:
+            result = [{"date": r["date"], "category": r["category"], "amount": float(r["_amount"]), "note": r.get("note", "")} for r in filtered]
+        print(json.dumps(result, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(("date", "category", "amount", "note"))
+        for r in filtered:
+            writer.writerow((r["date"], r["category"], f'{r["_amount"]:.2f}', r.get("note", "")))
+    elif args.format == "markdown":
+        print("| Date | Category | Amount | Note |")
+        print("| --- | --- | ---: | --- |")
+        for r in filtered:
+            print(f'| {r["date"]} | {r["category"]} | {_table_amount(r["_amount"], args.currency)} | {r.get("note", "")} |')
+        total = sum((r["_amount"] for r in filtered), Decimal(0))
+        print(f"| Total | | {_table_amount(total, args.currency)} | |")
+    elif args.by:
+        groups = _groups(filtered, args.by)
+        heading = "Category" if args.by == "category" else "Month"
+        _print_table([heading, "Count", "Total"], [(name, str(count), _table_amount(total, args.currency)) for name, count, total in groups], args.no_header)
+        print(f'Total{ " " * 1}{_table_amount(sum((r["_amount"] for r in filtered), Decimal(0)), args.currency)}')
+    else:
+        records = [(r["date"], r["category"], _table_amount(r["_amount"], args.currency), (r.get("note", "") if len(r.get("note", "")) <= 24 else r.get("note", "")[:23] + "…")) for r in filtered]
+        _print_table(["Date", "Category", "Amount", "Note"], records, args.no_header)
+        print(f'Total  {_table_amount(sum((r["_amount"] for r in filtered), Decimal(0)), args.currency)}')
+
+    if skipped:
+        noun = "row" if skipped == 1 else "rows"
+        print(f"warning: skipped {skipped} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _groups(rows, by):
+    values = {}
+    for row in rows:
+        name = row["category"].title() if by == "category" else row["_date"].strftime("%Y-%m")
+        count, total = values.get(name, (0, Decimal(0)))
+        values[name] = count + 1, total + row["_amount"]
+    groups = [(name, count, total) for name, (count, total) in values.items()]
+    if by == "category":
+        groups.sort(key=lambda x: (-x[2], x[0].casefold()))
+    else:
+        groups.sort(key=lambda x: x[0])
+    return groups
+
+
+def _table_amount(amount, currency=""):
+    if amount < 0:
+        return f"{currency}({abs(amount):,.2f})"
+    return f"{currency}{amount:,.2f}"
+
+
+def _print_table(headers, rows, no_header):
+    values = [list(map(str, row)) for row in rows]
+    widths = [max(len(str(headers[i])), *(len(row[i]) for row in values)) for i in range(len(headers))]
+    if not no_header:
+        print("  ".join(str(h).ljust(widths[i]) for i, h in enumerate(headers)))
+        print("  ".join("-" * width for width in widths))
+    amount_col = 2 if len(headers) == 4 else -1
+    for row in values:
+        print("  ".join((value.rjust(widths[i]) if i == amount_col else value.ljust(widths[i])) for i, value in enumerate(row)))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
