+"""Render expense CSV files in table, JSON, or CSV form."""
+import argparse
+import csv
+import json
+import sys
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--exclude", action="append", default=[])
+    parser.add_argument("--from", dest="start")
+    parser.add_argument("--to", dest="end")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _date(value):
+    parsed = date.fromisoformat(value)
+    if parsed.isoformat() != value:
+        raise ValueError(value)
+    return parsed
+
+
+def _rows(path):
+    result, invalid = [], 0
+    for row in load(path):
+        try:
+            day = _date(row.get("date", ""))
+        except ValueError:
+            raise ValueError(f"invalid date: {row.get('date', '')}")
+        try:
+            amount = Decimal(row.get("amount", ""))
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, ValueError):
+            invalid += 1
+            continue
+        result.append({"date": day, "category": row.get("category", ""),
+                       "amount": amount, "note": row.get("note", "")})
+    return result, invalid
+
+
+def _select(rows, args, start, end):
+    if args.category:
+        allowed = {value.casefold() for value in args.category}
+        rows = [r for r in rows if r["category"].casefold() in allowed]
+    excluded = {value.casefold() for value in args.exclude}
+    rows = [r for r in rows if r["category"].casefold() not in excluded
+            and (start is None or r["date"] >= start)
+            and (end is None or r["date"] <= end)]
+    if args.minimum is not None:
+        try:
+            minimum = Decimal(args.minimum)
+        except InvalidOperation:
+            raise ValueError(f"invalid amount: {args.minimum}")
+        rows = [r for r in rows if r["amount"] >= minimum]
+    return (sorted(rows, key=lambda r: -r["amount"])[:max(0, args.top)]
+            if args.top is not None else sorted(rows, key=lambda r: r["date"]))
+
+
+def _groups(rows, mode):
+    grouped = {}
+    for row in rows:
+        key = row["category"].title() if mode == "category" else row["date"].strftime("%Y-%m")
+        count, total = grouped.get(key, (0, Decimal(0)))
+        grouped[key] = count + 1, total + row["amount"]
+    result = [(key, count, total) for key, (count, total) in grouped.items()]
+    return sorted(result, key=(lambda item: (-item[2], item[0].casefold())) if mode == "category"
+                  else lambda item: item[0])
+
+
+def _money(value):
+    return f"({abs(value):,.2f})" if value < 0 else f"{value:,.2f}"
+
+
+def _table(headers, rows, no_header, total):
+    widths = [max(len(str(h)), *(len(str(row[i])) for row in rows)) for i, h in enumerate(headers)]
+    if not no_header:
+        print("  ".join(str(h).ljust(widths[i]) for i, h in enumerate(headers)))
+        print("  ".join("-" * width for width in widths))
+    for row in rows:
+        print("  ".join(str(value).rjust(widths[i]) if headers[i] in ("Amount", "Total")
+                        else str(value).ljust(widths[i]) for i, value in enumerate(row)))
+    print("Total" + " " * max(1, sum(widths) + 2 * (len(widths) - 1) - len("Total") - len(total)) + total)
+
+
+def _render(rows, args):
+    total = sum((r["amount"] for r in rows), Decimal(0))
+    if args.format == "json":
+        output = ([{"group": key, "count": count, "total": float(amount)}
+                   for key, count, amount in _groups(rows, args.by)] if args.by else
+                  [{"date": r["date"].isoformat(), "category": r["category"],
+                    "amount": float(r["amount"]), "note": r["note"]} for r in rows])
+        print(json.dumps(output, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(("date", "category", "amount", "note"))
+        for r in rows:
+            writer.writerow((r["date"].isoformat(), r["category"], f"{r['amount']:.2f}", r["note"]))
+    elif args.format == "markdown":
+        print("| Date | Category | Amount | Note |")
+        print("| --- | --- | ---: | --- |")
+        for r in rows:
+            print(f"| {r['date'].isoformat()} | {r['category']} | {_money(r['amount'])} | {r['note']} |")
+        print(f"| Total | | {_money(total)} | |")
+    elif not rows:
+        print("No expenses.")
+    elif args.by:
+        title = "Category" if args.by == "category" else "Month"
+        data = [[key, str(count), args.currency + _money(amount)]
+                for key, count, amount in _groups(rows, args.by)]
+        _table([title, "Count", "Total"], data, args.no_header, args.currency + _money(total))
+    else:
+        data = [[r["date"].isoformat(), r["category"], args.currency + _money(r["amount"]),
+                 r["note"][:23] + "…" if len(r["note"]) > 24 else r["note"]] for r in rows]
+        _table(["Date", "Category", "Amount", "Note"], data, args.no_header,
+               args.currency + _money(total))
+
+
+def main(argv):
+    args = _parser().parse_args(argv)
+    try:
+        start = _date(args.start) if args.start is not None else None
+        end = _date(args.end) if args.end is not None else None
+    except ValueError as error:
+        value = str(error)
+        print(f"error: invalid date: {value}", file=sys.stderr)
+        return 2
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        rows, invalid = _rows(args.path)
+        rows = _select(rows, args, start, end)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except ValueError as error:
+        print(f"error: {error}", file=sys.stderr)
+        return 2
+    _render(rows, args)
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
