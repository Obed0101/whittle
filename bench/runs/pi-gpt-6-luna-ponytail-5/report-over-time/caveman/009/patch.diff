+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+import json
+import sys
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+from app.expenses import load
+
+
+def _date(value):
+    try:
+        parsed = date.fromisoformat(value)
+        if parsed.isoformat() != value:
+            raise ValueError
+        return parsed
+    except (TypeError, ValueError):
+        raise argparse.ArgumentTypeError(value)
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Create an expense report.", epilog="Example: python -m app.report expenses.csv --by month")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", dest="categories", help="Keep this category; repeat to keep several")
+    parser.add_argument("--exclude", action="append", dest="excluded_categories", metavar="NAME", help="Exclude this category; repeat to exclude several")
+    parser.add_argument("--from", dest="date_from", metavar="DATE", help="Include expenses on or after DATE (YYYY-MM-DD)")
+    parser.add_argument("--to", dest="date_to", metavar="DATE", help="Include expenses on or before DATE (YYYY-MM-DD)")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT", help="Keep expenses at least this amount")
+    parser.add_argument("--by", choices=("category", "month"), help="Group by category or month")
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table", help="Output format")
+    parser.add_argument("--currency", default="", metavar="SYMBOL", help="Prefix table amounts with SYMBOL")
+    parser.add_argument("--top", type=int, metavar="N", help="Show the N largest expenses")
+    parser.add_argument("--no-header", action="store_true", help="Omit table header")
+    return parser
+
+
+def _amount(value):
+    amount = Decimal(value)
+    if not amount.is_finite():
+        raise InvalidOperation
+    return amount
+
+
+def _rows(source):
+    rows, invalid = [], 0
+    for index, raw in enumerate(source):
+        try:
+            amount = _amount(raw["amount"])
+        except (InvalidOperation, TypeError, KeyError):
+            invalid += 1
+            continue
+        try:
+            parsed = _date(raw["date"])
+        except (argparse.ArgumentTypeError, KeyError, TypeError):
+            raise ValueError(f"error: invalid date: {raw.get('date', '')}")
+        rows.append({"date": raw["date"], "_date": parsed, "category": raw.get("category", ""), "amount": amount, "note": raw.get("note", "") or "", "_index": index})
+    return sorted(rows, key=lambda row: row["_date"]), invalid
+
+
+def _filter(rows, args, minimum):
+    included = {value.casefold() for value in args.categories or []}
+    excluded = {value.casefold() for value in args.excluded_categories or []}
+    result = [r for r in rows if (not included or r["category"].casefold() in included)
+              and r["category"].casefold() not in excluded
+              and (not args.date_from or r["_date"] >= args.date_from)
+              and (not args.date_to or r["_date"] <= args.date_to)
+              and (minimum is None or r["amount"] >= minimum)]
+    return sorted(result, key=lambda r: r["amount"], reverse=True)[:max(args.top, 0)] if args.top is not None else result
+
+
+def _groups(rows, by):
+    if not by:
+        return None
+    grouped = {}
+    for row in rows:
+        key = row["category"].casefold() if by == "category" else row["_date"].strftime("%Y-%m")
+        if key not in grouped:
+            grouped[key] = [row["category"] if by == "category" else key, 0, Decimal(0)]
+        grouped[key][1] += 1
+        grouped[key][2] += row["amount"]
+    result = list(grouped.values())
+    result.sort(key=(lambda g: (-g[2], g[0].casefold())) if by == "category" else lambda g: g[0])
+    return result
+
+
+def _table(rows, groups, currency, no_header, by):
+    if groups is None:
+        headers = ["Date", "Category", "Amount", "Note"]
+        data = [[r["date"], r["category"], f"({currency}{-r['amount']:,.2f})" if r["amount"] < 0 else f"{currency}{r['amount']:,.2f}", r["note"][:23] + "…" if len(r["note"]) > 24 else r["note"]] for r in rows]
+        total = sum((r["amount"] for r in rows), Decimal(0))
+    else:
+        headers = ["Category" if by == "category" else "Month", "Count", "Total"]
+        data = [[g[0].title() if headers[0] == "Category" else g[0], str(g[1]), f"{currency}{g[2]:,.2f}"] for g in groups]
+        total = sum((g[2] for g in groups), Decimal(0))
+    widths = [max(len(h), *(len(row[i]) for row in data)) for i, h in enumerate(headers)]
+    lines = []
+    if not no_header:
+        lines.extend(["  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)), "  ".join("-" * w for w in widths)])
+    for row in data:
+        lines.append("  ".join(row[i].rjust(widths[i]) if headers[i] in ("Amount", "Total", "Count") else row[i].ljust(widths[i]) for i in range(len(headers))).rstrip())
+    lines.append(f"Total  {currency}{total:,.2f}")
+    return "\n".join(lines) + "\n"
+
+
+def _markdown(rows):
+    lines = ["| Date | Category | Amount | Note |", "| --- | --- | ---: | --- |"]
+    for row in rows:
+        amount = f"({-row['amount']:,.2f})" if row["amount"] < 0 else f"{row['amount']:,.2f}"
+        note = row["note"].replace("|", "\\|").replace("\n", "<br>")
+        category = row["category"].replace("|", "\\|")
+        lines.append(f"| {row['date']} | {category} | {amount} | {note} |")
+    total = sum((row["amount"] for row in rows), Decimal(0))
+    amount = f"({-total:,.2f})" if total < 0 else f"{total:,.2f}"
+    lines.append(f"| Total | | {amount} | |")
+    return "\n".join(lines) + "\n"
+
+
+def _output(rows, groups, args):
+    if args.format == "markdown":
+        sys.stdout.write(_markdown(rows))
+    elif args.format == "json":
+        payload = ([{"date": r["date"], "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in rows]
+                   if groups is None else [{"group": g[0], "count": g[1], "total": float(g[2])} for g in groups])
+        print(json.dumps(payload, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        if groups is None:
+            writer.writerow(["date", "category", "amount", "note"])
+            writer.writerows([r["date"], r["category"], f"{r['amount']:.2f}", r["note"]] for r in rows)
+        else:
+            writer.writerow(["group", "count", "total"])
+            writer.writerows([g[0], g[1], f"{g[2]:.2f}"] for g in groups)
+    else:
+        sys.stdout.write(_table(rows, groups, args.currency, args.no_header, args.by))
+
+
+def main(argv: list[str]) -> int:
+    try:
+        args = _parser().parse_args(argv)
+        args.date_from = _date(args.date_from) if args.date_from else None
+        args.date_to = _date(args.date_to) if args.date_to else None
+        if args.date_from and args.date_to and args.date_from > args.date_to:
+            raise ValueError("error: --from is after --to")
+        try:
+            minimum = _amount(args.minimum) if args.minimum is not None else None
+        except (InvalidOperation, TypeError):
+            raise ValueError(f"error: invalid minimum amount: {args.minimum}")
+        rows, invalid = _rows(load(args.path))
+        rows = _filter(rows, args, minimum)
+    except SystemExit as exc:
+        return int(exc.code)
+    except argparse.ArgumentTypeError as exc:
+        print(f"error: invalid date: {exc}", file=sys.stderr)
+        return 2
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except ValueError as exc:
+        print(str(exc), file=sys.stderr)
+        return 2
+    groups = _groups(rows, args.by)
+    if not rows:
+        print("No expenses.")
+    else:
+        _output(rows, groups, args)
+    if invalid:
+        print(f"warning: skipped {invalid} {'row' if invalid == 1 else 'rows'} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
