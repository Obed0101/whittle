@@ -0,0 +1,155 @@
+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", epilog="Example: python -m app.report expenses.csv --by month")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", dest="categories")
+    parser.add_argument("--exclude", action="append", dest="excluded_categories", metavar="NAME")
+    parser.add_argument("--from", dest="from_date")
+    parser.add_argument("--to", dest="to_date")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (ValueError, TypeError):
+        raise ValueError(value)
+
+
+def _amount(value):
+    try:
+        amount = Decimal(value)
+        return amount if amount.is_finite() else None
+    except (InvalidOperation, TypeError, ValueError):
+        return None
+
+
+def _money(value, currency=""):
+    return currency + (f"({abs(value):,.2f})" if value < 0 else f"{value:,.2f}")
+
+
+def _table(rows, grouped, args):
+    if grouped is None:
+        headers = ["Date", "Category", "Amount", "Note"]
+        data = [[r["date"], r["category"], _money(r["_amount"], args.currency),
+                 r["note"] if len(r["note"]) <= 24 else r["note"][:23] + "…"] for r in rows]
+        right = {2}
+    else:
+        headers = ["Category" if args.by == "category" else "Month", "Count", "Total"]
+        data = [[key.title() if args.by == "category" else key, str(count), _money(total, args.currency)]
+                for key, count, total in grouped]
+        right = set()
+    widths = [max(len(header), *(len(row[i]) for row in data)) if data else len(header)
+              for i, header in enumerate(headers)]
+    lines = []
+    if not args.no_header:
+        lines += ["  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)),
+                  "  ".join("-" * width for width in widths)]
+    lines += ["  ".join(value.rjust(widths[i]) if i in right else value.ljust(widths[i])
+                       for i, value in enumerate(row)) for row in data]
+    total = _money(sum((r["_amount"] for r in rows), Decimal(0)), args.currency)
+    lines.append("Total" + " " * max(1, sum(widths) + (4 if grouped is not None else 6) - len("Total") - len(total)) + total)
+    return "\n".join(lines) + "\n"
+
+
+def _markdown(rows):
+    lines = ["| Date | Category | Amount | Note |", "| --- | --- | ---: | --- |"]
+    for row in rows:
+        lines.append(f"| {row['date']} | {row['category']} | {_money(row['_amount'])} | {row['note']} |")
+    total = _money(sum((r["_amount"] for r in rows), Decimal(0)))
+    lines.append(f"| Total | | {total} | |")
+    return "\n".join(lines)
+
+
+def _groups(rows, by):
+    groups = {}
+    for row in rows:
+        key = row["category"] if by == "category" else row["date"][:7]
+        count, total = groups.get(key, (0, Decimal(0)))
+        groups[key] = count + 1, total + row["_amount"]
+    result = [(key, count, total) for key, (count, total) in groups.items()]
+    return sorted(result, key=(lambda x: (-x[2], x[0].casefold())) if by == "category" else lambda x: x[0])
+
+
+def main(argv: list[str]) -> int:
+    args = _parser().parse_args(argv)
+    try:
+        start = _date(args.from_date) if args.from_date else None
+        end = _date(args.to_date) if args.to_date else None
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+        if minimum is not None and not minimum.is_finite():
+            raise InvalidOperation
+        if start and end and start > end:
+            print("error: --from is after --to", file=sys.stderr)
+            return 2
+    except (ValueError, InvalidOperation):
+        value = args.from_date or args.to_date or args.minimum
+        print(f"error: invalid date: {value}", file=sys.stderr)
+        return 2
+    try:
+        source = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    rows, skipped = [], 0
+    included = {c.casefold() for c in args.categories or []}
+    excluded = {c.casefold() for c in args.excluded_categories or []}
+    for index, row in enumerate(source):
+        amount = _amount(row.get("amount"))
+        if amount is None:
+            skipped += 1
+            continue
+        try:
+            row_date = _date(row.get("date"))
+        except ValueError:
+            print(f"error: invalid date: {row.get('date')}", file=sys.stderr)
+            return 2
+        category = row.get("category", "").casefold()
+        if ((start and row_date < start) or (end and row_date > end)
+                or (included and category not in included) or category in excluded
+                or (minimum is not None and amount < minimum)):
+            continue
+        rows.append({**row, "_amount": amount, "_date": row_date, "_index": index})
+    rows.sort(key=lambda row: (row["_date"], row["_index"]))
+    if args.top is not None:
+        rows = sorted(rows, key=lambda row: -row["_amount"])[:max(0, args.top)]
+    grouped = _groups(rows, args.by) if args.by else None
+
+    if not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        output = ([{"date": r["date"], "category": r["category"], "amount": float(r["_amount"]), "note": r["note"]} for r in rows]
+                  if grouped is None else [{"group": k, "count": n, "total": float(t)} for k, n, t in grouped])
+        print(json.dumps(output, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        writer.writerows([r["date"], r["category"], format(r["_amount"], ".2f"), r["note"]] for r in rows)
+    elif args.format == "markdown":
+        print(_markdown(rows))
+    else:
+        print(_table(rows, grouped, args), end="")
+    if skipped:
+        print(f"warning: skipped {skipped} {'row' if skipped == 1 else 'rows'} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
