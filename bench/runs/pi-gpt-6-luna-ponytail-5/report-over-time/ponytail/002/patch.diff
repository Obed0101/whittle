+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+import json
+import sys
+from io import StringIO
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Report expenses.")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--exclude", action="append", default=[], metavar="NAME", help="exclude a category (repeatable)")
+    parser.add_argument("--from", dest="start")
+    parser.add_argument("--to", dest="end")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (ValueError, TypeError):
+        raise ValueError(f"error: invalid date: {value}") from None
+
+
+def _money(value):
+    try:
+        return Decimal(value)
+    except (InvalidOperation, TypeError):
+        return None
+
+
+def _amount(items):
+    return sum((item[1] for item in items), Decimal(0))
+
+
+def _groups(items, by):
+    grouped = {}
+    for item in items:
+        key = item[0].get("category", "") if by == "category" else item[2].strftime("%Y-%m")
+        grouped.setdefault(key, []).append(item)
+    order = (lambda pair: (-_amount(pair[1]), pair[0].casefold())) if by == "category" else (lambda pair: pair[0])
+    return sorted(grouped.items(), key=order)
+
+
+def _ordered(items):
+    return sorted(items, key=lambda item: (item[2], item[3]))
+
+
+def _format_amount(value):
+    return f"({abs(value):,.2f})" if value < 0 else f"{value:,.2f}"
+
+
+def _render(items, args):
+    if args.format == "json":
+        if args.by:
+            return json.dumps([{"group": key, "count": len(group), "total": float(_amount(group))}
+                               for key, group in _groups(items, args.by)], indent=2)
+        return json.dumps([{"date": row["date"], "category": row["category"], "amount": float(amount), "note": row.get("note", "")}
+                           for row, amount, _, _ in _ordered(items)], indent=2)
+    if args.format == "csv":
+        output = StringIO()
+        writer = csv.writer(output, lineterminator="\n")
+        writer.writerow(("date", "category", "amount", "note"))
+        for row, amount, _, _ in _ordered(items):
+            writer.writerow((row["date"], row["category"], f"{amount:.2f}", row.get("note", "")))
+        return output.getvalue().rstrip("\n")
+    if args.format == "markdown":
+        rows = _ordered(items)
+        lines = [
+            "| Date | Category | Amount | Note |",
+            "| --- | --- | ---: | --- |",
+        ]
+        lines.extend(
+            f"| {row.get('date', '')} | {row.get('category', '')} | {_format_amount(amount)} | {row.get('note', '')} |"
+            for row, amount, _, _ in rows
+        )
+        lines.append(f"| Total | | {_format_amount(_amount(rows))} | |")
+        return "\n".join(lines)
+    if args.by:
+        label = "Category" if args.by == "category" else "Month"
+        lines = [] if args.no_header else [f"{label}  Count  Total", "-" * 34]
+        for key, group in _groups(items, args.by):
+            name = key.title() if args.by == "category" else key
+            lines.append(f"{name}  {len(group)}  {args.currency}{_format_amount(_amount(group))}")
+        lines.append(f"Total  {args.currency}{_format_amount(_amount(items))}")
+        return "\n".join(lines)
+    rows = _ordered(items)
+    datew = max(4, *(len(row.get("date", "")) for row, *_ in rows))
+    catw = max(8, *(len(row.get("category", "")) for row, *_ in rows))
+    amountw = max(6, *(len(_format_amount(amount)) for _, amount, *_ in rows))
+    lines = [] if args.no_header else [
+        f"{'Date':<{datew}}  {'Category':<{catw}}  {'Amount':>{amountw}}  Note",
+        f"{'-'*datew}  {'-'*catw}  {'-'*amountw}  ----",
+    ]
+    for row, amount, _, _ in rows:
+        note = row.get("note", "")
+        if len(note) > 24:
+            note = note[:23] + "…"
+        formatted = _format_amount(amount)
+        lines.append(f"{row.get('date',''):<{datew}}  {row.get('category',''):<{catw}}  {args.currency + formatted:>{amountw + len(args.currency)}}  {note}")
+    lines.append(f"Total  {args.currency}{_format_amount(_amount(rows))}")
+    return "\n".join(lines)
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as exc:
+        return int(exc.code)
+    try:
+        start, end = (_date(args.start) if args.start else None), (_date(args.end) if args.end else None)
+        if start and end and start > end:
+            raise ValueError("error: --from is after --to")
+        minimum = _money(args.minimum) if args.minimum is not None else None
+        if args.minimum is not None and minimum is None:
+            raise ValueError(f"error: invalid amount: {args.minimum}")
+        rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except ValueError as exc:
+        print(str(exc), file=sys.stderr)
+        return 2
+
+    valid, invalid = [], 0
+    for index, row in enumerate(rows):
+        amount = _money(row.get("amount"))
+        if amount is None:
+            invalid += 1
+            continue
+        try:
+            row_date = _date(row.get("date"))
+        except ValueError as exc:
+            print(str(exc), file=sys.stderr)
+            return 2
+        valid.append((row, amount, row_date, index))
+    categories = {name.casefold() for name in args.category}
+    excluded = {name.casefold() for name in args.exclude}
+    selected = [item for item in valid
+                if (not categories or item[0].get("category", "").casefold() in categories)
+                and item[0].get("category", "").casefold() not in excluded
+                and (not start or item[2] >= start) and (not end or item[2] <= end)
+                and (minimum is None or item[1] >= minimum)]
+    if args.top is not None:
+        selected = sorted(selected, key=lambda item: -item[1])[:max(0, args.top)]
+    print(_render(selected, args) if selected else "No expenses.")
+    if invalid:
+        print(f"warning: skipped {invalid} row{'s' if invalid != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
