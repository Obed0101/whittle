+"""Render expense CSV data as a table, JSON, or CSV report."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise ValueError(f"error: invalid date: {value}")
+
+
+def _money(value, currency="", thousands=True):
+    value = Decimal(value)
+    if value < 0:
+        return f"({currency}{format(abs(value), ',.2f' if thousands else '.2f')})"
+    return currency + format(value, ',.2f' if thousands else '.2f')
+
+
+def _table(headers, rows, amount_columns=(), no_header=False):
+    widths = [max([len(str(row[i])) for row in rows] + [len(h)]) for i, h in enumerate(headers)]
+    lines = [] if no_header else [
+        "  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)),
+        "  ".join("-" * width for width in widths),
+    ]
+    lines.extend("  ".join(str(value).rjust(widths[i]) if i in amount_columns else str(value).ljust(widths[i])
+                            for i, value in enumerate(row)) for row in rows)
+    return "\n".join(lines)
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Report on an expense CSV.")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[], metavar="NAME")
+    parser.add_argument("--exclude", action="append", default=[], metavar="NAME")
+    parser.add_argument("--from", dest="from_date", metavar="DATE")
+    parser.add_argument("--to", dest="to_date", metavar="DATE")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="", metavar="SYMBOL")
+    parser.add_argument("--top", type=int, metavar="N")
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by month"
+    return parser
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    try:
+        start = _date(args.from_date) if args.from_date else None
+        end = _date(args.to_date) if args.to_date else None
+        if start and end and start > end:
+            raise ValueError("error: --from is after --to")
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+        if minimum is not None and not minimum.is_finite():
+            raise InvalidOperation
+    except (ValueError, InvalidOperation) as error:
+        print(str(error) or "error: invalid amount", file=sys.stderr)
+        return 2
+    try:
+        source = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    records, invalid = [], 0
+    for row in source:
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, KeyError, TypeError):
+            invalid += 1
+            continue
+        try:
+            day = _date(row["date"])
+        except (ValueError, KeyError):
+            print(f"error: invalid date: {row.get('date', '')}", file=sys.stderr)
+            return 2
+        records.append({"date": day, "category": row.get("category", ""), "amount": amount,
+                        "note": row.get("note", "")})
+
+    categories = {name.casefold() for name in args.category}
+    excluded = {name.casefold() for name in args.exclude}
+    records = [r for r in records
+               if (not categories or r["category"].casefold() in categories)
+               and r["category"].casefold() not in excluded
+               and (start is None or r["date"] >= start)
+               and (end is None or r["date"] <= end)
+               and (minimum is None or r["amount"] >= minimum)]
+    records.sort(key=lambda r: r["date"])
+    if args.top is not None:
+        records = sorted(records, key=lambda r: r["amount"], reverse=True)[:max(args.top, 0)]
+
+    if not records:
+        print("No expenses.")
+    elif args.format == "json":
+        if args.by:
+            groups = _groups(records, args.by)
+            result = [{"group": key, "count": len(items), "total": float(sum((r["amount"] for r in items), Decimal(0)))}
+                      for key, items in groups]
+        else:
+            result = [{"date": r["date"].isoformat(), "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in records]
+        print(json.dumps(result, indent=2))
+    elif args.format == "markdown":
+        print("| Date | Category | Amount | Note |")
+        print("| --- | --- | ---: | --- |")
+        for r in records:
+            note = r["note"].replace("|", r"\|").replace("\n", "<br>")
+            print(f"| {r['date'].isoformat()} | {r['category']} | {_money(r['amount'])} | {note} |")
+        total = sum((r["amount"] for r in records), Decimal(0))
+        print(f"| Total | | {_money(total)} | |")
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        if args.by:
+            writer.writerow(["group", "count", "total"])
+            for key, items in _groups(records, args.by):
+                writer.writerow([key, len(items), format(sum((r["amount"] for r in items), Decimal(0)), ".2f")])
+        else:
+            writer.writerow(["date", "category", "amount", "note"])
+            for r in records:
+                writer.writerow([r["date"].isoformat(), r["category"], format(r["amount"], ".2f"), r["note"]])
+    else:
+        if args.by:
+            groups = _groups(records, args.by)
+            label = "Category" if args.by == "category" else "Month"
+            rows = [[key, str(len(items)), _money(sum((r["amount"] for r in items), Decimal(0)), args.currency)] for key, items in groups]
+            rows.append(["Total", "", _money(sum((r["amount"] for r in records), Decimal(0)), args.currency)])
+            print(_table([label, "Count", "Total"], rows, (1, 2), args.no_header))
+        else:
+            rows = [[r["date"].isoformat(), r["category"], _money(r["amount"], args.currency),
+                     r["note"] if len(r["note"]) <= 24 else r["note"][:23] + "…"] for r in records]
+            rows.append(["Total", "", _money(sum((r["amount"] for r in records), Decimal(0)), args.currency), ""])
+            print(_table(["Date", "Category", "Amount", "Note"], rows, (2,), args.no_header))
+    if invalid:
+        suffix = "" if invalid == 1 else "s"
+        print(f"warning: skipped {invalid} row{suffix} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _groups(records, by):
+    grouped = {}
+    for record in records:
+        key = record["category"].title() if by == "category" else record["date"].strftime("%Y-%m")
+        grouped.setdefault(key, []).append(record)
+    if by == "category":
+        return sorted(grouped.items(), key=lambda pair: (-sum((r["amount"] for r in pair[1]), Decimal(0)), pair[0]))
+    return sorted(grouped.items())
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
