+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", epilog="Example: python -m app.report expenses.csv --by month")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--exclude", action="append", default=[], metavar="NAME", help="exclude a category (repeatable)")
+    parser.add_argument("--from", dest="date_from")
+    parser.add_argument("--to", dest="date_to")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _table(rows, headers=None, amount_column=None):
+    if headers:
+        rows = [headers, ["-" * max(len(str(row[i])) for row in [headers, *rows]) for i in range(len(headers))], *rows]
+    if not rows:
+        return ""
+    widths = [max(len(str(row[i])) for row in rows) for i in range(len(rows[0]))]
+    return "\n".join("  ".join(str(value).rjust(widths[i]) if i == amount_column else str(value).ljust(widths[i]) for i, value in enumerate(row)) for row in rows)
+
+
+def _groups(rows, by):
+    groups = {}
+    for row in rows:
+        name = row["category"] if by == "category" else row.get("date", "")[:7]
+        count, total = groups.get(name, (0, Decimal(0)))
+        groups[name] = count + 1, total + row["_amount"]
+    key = (lambda item: (-item[2], item[0].casefold())) if by == "category" else (lambda item: item[0])
+    return sorted(((name, count, total) for name, (count, total) in groups.items()), key=key)
+
+
+def _amount(value):
+    try:
+        return Decimal(value)
+    except (InvalidOperation, TypeError):
+        return None
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    try:
+        start, end = (date.fromisoformat(value) if value else None for value in (args.date_from, args.date_to))
+    except ValueError:
+        value = args.date_from if args.date_from and _invalid_date(args.date_from) else args.date_to
+        print(f"error: invalid date: {value}", file=sys.stderr)
+        return 2
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    minimum = _amount(args.minimum) if args.minimum is not None else None
+    if args.minimum is not None and minimum is None:
+        parser.error("--min must be a number")
+    try:
+        raw = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    rows, skipped = [], 0
+    categories = {value.casefold() for value in args.category}
+    excluded = {value.casefold() for value in args.exclude}
+    for row in raw:
+        amount = _amount(row.get("amount"))
+        if amount is None or not amount.is_finite():
+            skipped += 1
+            continue
+        try:
+            row_date = date.fromisoformat(row.get("date", ""))
+        except ValueError:
+            row_date = None
+        category = row.get("category", "").casefold()
+        if categories and category not in categories or category in excluded:
+            continue
+        if start and (row_date is None or row_date < start) or end and (row_date is None or row_date > end):
+            continue
+        if minimum is not None and amount < minimum:
+            continue
+        rows.append({**row, "_amount": amount})
+    rows.sort(key=lambda row: row.get("date", ""))
+    if args.top is not None:
+        rows = sorted(rows, key=lambda row: row["_amount"], reverse=True)[:max(0, args.top)]
+
+    if not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        result = ([{"group": name, "count": count, "total": float(total)} for name, count, total in _groups(rows, args.by)]
+                  if args.by else [{"date": r["date"], "category": r["category"], "amount": float(r["_amount"]), "note": r.get("note", "")} for r in rows])
+        print(json.dumps(result, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(("date", "category", "amount", "note"))
+        for row in rows:
+            writer.writerow((row.get("date", ""), row.get("category", ""), f'{row["_amount"]:.2f}', row.get("note", "")))
+    elif args.format == "markdown":
+        print("| Date | Category | Amount | Note |")
+        print("| --- | --- | ---: | --- |")
+        for row in rows:
+            print(f'| {row.get("date", "")} | {row.get("category", "")} | {row["_amount"]:,.2f} | {row.get("note", "")} |')
+        total = sum((r["_amount"] for r in rows), Decimal(0))
+        print(f"| Total | | {total:,.2f} | |")
+    elif args.by:
+        groups = _groups(rows, args.by)
+        values = [[name.title() if args.by == "category" else name, str(count), f"{args.currency}{total:,.2f}"] for name, count, total in groups]
+        values.append(["Total", "", f"{args.currency}{sum((r['_amount'] for r in rows), Decimal(0)):,.2f}"])
+        print(_table(values, None if args.no_header else ["Category" if args.by == "category" else "Month", "Count", "Total"]))
+    else:
+        values = [[r.get("date", ""), r.get("category", ""), f"({args.currency}{abs(r['_amount']):,.2f})" if r["_amount"] < 0 else f"{args.currency}{r['_amount']:,.2f}", (r.get("note", "")[:23] + "…") if len(r.get("note", "")) > 24 else r.get("note", "")] for r in rows]
+        values.append(["Total", "", f"{args.currency}{sum((r['_amount'] for r in rows), Decimal(0)):,.2f}", ""])
+        print(_table(values, None if args.no_header else ["Date", "Category", "Amount", "Note"], 2))
+    if skipped:
+        print(f"warning: skipped {skipped} row{'s' if skipped != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _invalid_date(value):
+    try:
+        date.fromisoformat(value)
+        return False
+    except ValueError:
+        return True
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
