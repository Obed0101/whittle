+"""Print expense reports in table, JSON, CSV, or Markdown form."""
+import argparse
+import csv
+import json
+import sys
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+from app.expenses import load
+
+
+def main(argv: list[str]) -> int:
+    parser = argparse.ArgumentParser(description="Create a report from an expense CSV.",
+                                     epilog="Example: python -m app.report expenses.csv --by category")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--exclude", action="append", default=[], help="exclude a category (repeatable)")
+    parser.add_argument("--from", dest="date_from")
+    parser.add_argument("--to", dest="date_to")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    args = parser.parse_args(argv)
+
+    try:
+        start = date.fromisoformat(args.date_from) if args.date_from else None
+        end = date.fromisoformat(args.date_to) if args.date_to else None
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+    except InvalidOperation:
+        print("error: invalid amount", file=sys.stderr)
+        return 2
+    except ValueError:
+        print("error: invalid date", file=sys.stderr)
+        return 2
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    valid, invalid = [], 0
+    for index, row in enumerate(rows):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, TypeError):
+            invalid += 1
+            continue
+        try:
+            day = date.fromisoformat(row["date"])
+        except (ValueError, TypeError):
+            print(f"error: invalid date: {row.get('date', '')}", file=sys.stderr)
+            return 2
+        valid.append({**row, "_amount": amount, "_day": day, "_index": index})
+
+    categories = {value.casefold() for value in args.category}
+    excluded = {value.casefold() for value in args.exclude}
+    selected = [row for row in valid if
+        (not categories or row["category"].casefold() in categories)
+        and row["category"].casefold() not in excluded
+        and (start is None or row["_day"] >= start)
+        and (end is None or row["_day"] <= end)
+        and (minimum is None or row["_amount"] >= minimum)]
+    selected.sort(key=lambda row: (row["_day"], row["_index"]))
+    if args.top is not None:
+        selected = sorted(selected, key=lambda row: -row["_amount"])[:max(0, args.top)]
+
+    if args.by:
+        groups = {}
+        for row in selected:
+            key = row["category"] if args.by == "category" else row["_day"].strftime("%Y-%m")
+            groups.setdefault(key, []).append(row)
+        grouped = [(key, len(items), sum((r["_amount"] for r in items), Decimal(0)))
+                   for key, items in groups.items()]
+        grouped.sort(key=(lambda item: (-item[2], item[0].casefold())) if args.by == "category" else lambda item: item[0])
+        if not grouped:
+            print("No expenses.")
+        elif args.format == "json":
+            print(json.dumps([{"group": key, "count": count, "total": float(total)}
+                              for key, count, total in grouped], indent=2))
+        else:
+            headers = ("Category" if args.by == "category" else "Month", "Count", "Total")
+            lines = [[key.title() if args.by == "category" else key, str(count),
+                      f"{args.currency}{total:,.2f}"] for key, count, total in grouped]
+            _print_table(headers, lines, sum((item[2] for item in grouped), Decimal(0)),
+                         args.currency, args.no_header)
+    elif not selected:
+        print("No expenses.")
+    elif args.format == "json":
+        print(json.dumps([{"date": r["date"], "category": r["category"],
+                           "amount": float(r["_amount"]), "note": r["note"]}
+                          for r in selected], indent=2))
+    elif args.format == "markdown":
+        print("| Date | Category | Amount | Note |")
+        print("| --- | --- | ---: | --- |")
+        for row in selected:
+            note = row["note"].replace("|", "\\|")
+            print(f"| {row['date']} | {row['category']} | {_money(row['_amount'], args.currency, True)} | {note} |")
+        total = sum((row["_amount"] for row in selected), Decimal(0))
+        print(f"| Total | | {_money(total, args.currency, True)} | |")
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(("date", "category", "amount", "note"))
+        for row in selected:
+            writer.writerow((row["date"], row["category"], f"{row['_amount']:.2f}", row["note"]))
+    else:
+        lines = [[r["date"], r["category"], _money(r["_amount"], args.currency, True),
+                  r["note"][:23] + "…" if len(r["note"]) > 24 else r["note"]]
+                 for r in selected]
+        _print_table(("Date", "Category", "Amount", "Note"), lines,
+                     sum((r["_amount"] for r in selected), Decimal(0)), args.currency,
+                     args.no_header, amount_column=2)
+
+    if invalid:
+        print(f"warning: skipped {invalid} row{'s' if invalid != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _money(amount, currency, negatives=False):
+    if negatives and amount < 0:
+        return f"{currency}({abs(amount):,.2f})"
+    return f"{currency}{amount:,.2f}"
+
+
+def _print_table(headers, rows, total, currency, no_header, amount_column=-1):
+    total_row = [""] * len(headers)
+    total_row[0], total_row[-1] = "Total", _money(total, currency, True)
+    rows = [*rows, total_row]
+    widths = [max(len(str(row[i])) for row in [headers, *rows]) for i in range(len(headers))]
+
+    def render(row):
+        return "  ".join(str(value).rjust(widths[i]) if i == amount_column else
+                          str(value).ljust(widths[i]) for i, value in enumerate(row)).rstrip()
+
+    if not no_header:
+        print(render(headers))
+        print(render(["-" * len(value) for value in headers]))
+    for row in rows:
+        print(render(row))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
