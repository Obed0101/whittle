+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        self._print_message(f"error: {message}\n", sys.stderr)
+        raise SystemExit(2)
+
+
+def _parser():
+    parser = Parser(prog="python -m app.report", description="Report expenses from a CSV file.",
+                    epilog="Example: python -m app.report expenses.csv --by month")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--exclude", action="append", default=[])
+    parser.add_argument("--from", dest="start")
+    parser.add_argument("--to", dest="end")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (ValueError, TypeError):
+        raise ValueError(value)
+
+
+def _amount(value):
+    try:
+        return Decimal(value)
+    except (InvalidOperation, TypeError):
+        return None
+
+
+def _table(rows, grouped, currency, no_header):
+    if grouped:
+        headers = ["Category" if grouped == "category" else "Month", "Count", "Total"]
+        data = [[r[0], str(r[1]), _money(r[2], currency)] for r in rows]
+        total = sum((r[2] for r in rows), Decimal(0))
+    else:
+        headers = ["Date", "Category", "Amount", "Note"]
+        data = [[r["date"], r["category"], _money(r["amount"], currency),
+                 r["note"] if len(r["note"]) <= 24 else r["note"][:23] + "…"] for r in rows]
+        total = sum((r["amount"] for r in rows), Decimal(0))
+    widths = [max(len(headers[i]), *(len(row[i]) for row in data)) for i in range(len(headers))]
+    if not grouped:
+        widths[2] = max(widths[2], len(_money(total, currency)))
+    lines = []
+    if not no_header:
+        lines += ["  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)),
+                  "  ".join("-" * w for w in widths)]
+    for row in data:
+        lines.append("  ".join(row[i].rjust(widths[i]) if (grouped and i == 2) or (not grouped and i == 2) else row[i].ljust(widths[i]) for i in range(len(headers))))
+    lines.append("Total".ljust(widths[0]) + "  " + "  ".join([""] * (len(headers)-2) + [_money(total, currency).rjust(widths[-1])]))
+    return "\n".join(lines) + "\n"
+
+
+def _markdown(rows):
+    lines = ["| Date | Category | Amount | Note |", "| --- | --- | ---: | --- |"]
+    for row in rows:
+        cells = [row["date"], row["category"], _money(row["amount"]), row["note"]]
+        lines.append("| " + " | ".join(cell.replace("|", r"\\|") for cell in cells) + " |")
+    total = sum((row["amount"] for row in rows), Decimal(0))
+    lines.append(f"| Total | | {_money(total)} | |")
+    return "\n".join(lines) + "\n"
+
+
+def _money(value, currency=""):
+    rendered = f"{abs(value):,.2f}"
+    if value < 0:
+        rendered = f"({rendered})"
+    return currency + rendered if value >= 0 else f"({currency}{abs(value):,.2f})"
+
+
+def main(argv: list[str]) -> int:
+    args = _parser().parse_args(argv)
+    try:
+        start = _date(args.start) if args.start else None
+        end = _date(args.end) if args.end else None
+    except ValueError as exc:
+        print(f"error: invalid date: {exc}", file=sys.stderr)
+        return 2
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        source = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    rows = []
+    invalid = 0
+    categories = {c.casefold() for c in args.category}
+    excluded = {c.casefold() for c in args.exclude}
+    minimum = (_amount(args.minimum) or Decimal(0)) if args.minimum is not None else None
+    for row in source:
+        amount = _amount(row.get("amount"))
+        if amount is None:
+            invalid += 1
+            continue
+        try:
+            d = _date(row.get("date"))
+        except ValueError:
+            # Expense dates are expected to be valid by the CSV contract.
+            continue
+        category = row["category"].casefold()
+        if categories and category not in categories or category in excluded:
+            continue
+        if (start and d < start) or (end and d > end) or (minimum is not None and amount < minimum):
+            continue
+        rows.append((d, dict(row, amount=amount)))
+    rows.sort(key=lambda item: item[0])
+    rows = [row for _, row in rows]
+    if args.top is not None:
+        rows = sorted(rows, key=lambda r: r["amount"], reverse=True)[:max(0, args.top)]
+    if not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        if args.by:
+            grouped = _groups(rows, args.by)
+            result = [{"group": name, "count": count, "total": float(total)} for name, count, total in grouped]
+        else:
+            result = [{"date": r["date"], "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in rows]
+        print(json.dumps(result, indent=2))
+    elif args.format == "markdown":
+        print(_markdown(rows), end="")
+    elif args.format == "csv":
+        if args.by:
+            grouped = _groups(rows, args.by)
+            writer_rows = [["group", "count", "total"]] + [[n, c, f"{t:.2f}"] for n, c, t in grouped]
+        else:
+            writer_rows = [["date", "category", "amount", "note"]] + [[r["date"], r["category"], f"{r['amount']:.2f}", r["note"]] for r in rows]
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerows(writer_rows)
+    elif args.by:
+        groups = _groups(rows, args.by)
+        if args.by == "category":
+            groups = [(name.title(), count, total) for name, count, total in groups]
+        print(_table(groups, args.by, args.currency, args.no_header), end="")
+    else:
+        print(_table(rows, None, args.currency, args.no_header), end="")
+    if invalid:
+        print(f"warning: skipped {invalid} row{'s' if invalid != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _groups(rows, by):
+    groups = {}
+    for row in rows:
+        key = row["category"] if by == "category" else row["date"][:7]
+        count, total = groups.get(key, (0, Decimal(0)))
+        groups[key] = count + 1, total + row["amount"]
+    result = [(key, count, total) for key, (count, total) in groups.items()]
+    return sorted(result, key=(lambda x: (-x[2], x[0].casefold())) if by == "category" else (lambda x: x[0]))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
