+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+import json
+import sys
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+from app.expenses import load
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+
+
+def _parser():
+    parser = argparse.ArgumentParser(usage="%(prog)s PATH [options]", description="Print an expense report.")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--exclude", action="append", default=[], metavar="NAME",
+                        help="exclude a category (repeatable; case-insensitive)")
+    parser.add_argument("--from", dest="start", type=_date)
+    parser.add_argument("--to", dest="end", type=_date)
+    parser.add_argument("--min", dest="minimum", type=Decimal)
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv", "markdown"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by month"
+    return parser
+
+
+def _money(amount):
+    return f"{amount:,.2f}"
+
+
+def _print_table(headers, rows, total, no_header, currency):
+    widths = [max(len(str(header)), *(len(row[i]) for row in rows)) for i, header in enumerate(headers)]
+    if not no_header:
+        print("  ".join(header.ljust(widths[i]) for i, header in enumerate(headers)))
+        print("  ".join("-" * width for width in widths))
+    for row in rows:
+        print("  ".join(row[i].rjust(widths[i]) if headers[i] in ("Amount", "Total") else row[i].ljust(widths[i])
+                        for i in range(len(headers))))
+    print(f"Total  {currency}{_money(total)}")
+
+
+def _emit(headers, table_headers, records, csv_rows, table_rows, total, args):
+    if not records:
+        print("No expenses.")
+    elif args.format == "json":
+        print(json.dumps(records, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(headers)
+        writer.writerows(csv_rows)
+    elif args.format == "markdown":
+        if len(headers) == 4:
+            print("| Date | Category | Amount | Note |")
+            print("| --- | --- | ---: | --- |")
+            for date_value, category, amount, note in csv_rows:
+                print(f"| {date_value} | {category} | {_money(Decimal(amount))} | {note} |")
+            print(f"| Total | | {_money(total)} | |")
+        else:
+            print("| " + " | ".join(table_headers) + " |")
+            print("| " + " | ".join("---:" if header == "Total" else "---" for header in table_headers) + " |")
+            for row in csv_rows:
+                print("| " + " | ".join(map(str, row)) + " |")
+            print(f"| Total | | {_money(total)} |")
+    else:
+        _print_table(table_headers, table_rows, total, args.no_header, args.currency)
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as exc:
+        return int(exc.code)
+    if args.start and args.end and args.start > args.end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    if args.top is not None and args.top < 0:
+        print("error: --top must be non-negative", file=sys.stderr)
+        return 2
+    try:
+        rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    valid, invalid = [], 0
+    for index, row in enumerate(rows):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (KeyError, TypeError, InvalidOperation, ValueError):
+            invalid += 1
+            continue
+        try:
+            row_date = date.fromisoformat(row["date"])
+        except (KeyError, TypeError, ValueError):
+            print(f"error: invalid date: {row.get('date', '')}", file=sys.stderr)
+            return 2
+        valid.append((index, row, amount, row_date))
+
+    categories = {name.casefold() for name in args.category}
+    excluded = {name.casefold() for name in args.exclude}
+    selected = [item for item in valid if
+                (not categories or item[1]["category"].casefold() in categories)
+                and item[1]["category"].casefold() not in excluded
+                and (args.start is None or item[3] >= args.start)
+                and (args.end is None or item[3] <= args.end)
+                and (args.minimum is None or item[2] >= args.minimum)]
+
+    if args.by:
+        groups = {}
+        for _, row, amount, row_date in selected:
+            key = row["category"] if args.by == "category" else row_date.strftime("%Y-%m")
+            count, subtotal = groups.get(key, (0, Decimal(0)))
+            groups[key] = count + 1, subtotal + amount
+        output = sorted(groups.items(), key=(lambda pair: (-pair[1][1], pair[0].casefold()))
+                        if args.by == "category" else None)
+        total = sum((item[2] for item in selected), Decimal(0))
+        headers = ["group", "count", "total"]
+        table_headers = ["Category" if args.by == "category" else "Month", "Count", "Total"]
+        records = [{"group": key, "count": count, "total": float(amount)}
+                   for key, (count, amount) in output]
+        csv_rows = [(key, count, f"{amount:.2f}") for key, (count, amount) in output]
+        table = [(key.title() if args.by == "category" else key, str(count), _money(amount))
+                 for key, (count, amount) in output]
+        _emit(headers, table_headers, records, csv_rows, table, total, args)
+    else:
+        selected.sort(key=lambda item: (item[3], item[0]))
+        if args.top is not None:
+            selected = sorted(selected, key=lambda item: (-item[2], item[0]))[:args.top]
+        total = sum((item[2] for item in selected), Decimal(0))
+        records = [{"date": row["date"], "category": row["category"], "amount": float(amount), "note": row["note"]}
+                   for _, row, amount, _ in selected]
+        csv_rows = [(row["date"], row["category"], f"{amount:.2f}", row["note"])
+                    for _, row, amount, _ in selected]
+        table = [(row["date"], row["category"],
+                  f"({args.currency}{_money(-amount)})" if amount < 0 else f"{args.currency}{_money(amount)}",
+                  row["note"] if len(row["note"]) <= 24 else row["note"][:23] + "…")
+                 for _, row, amount, _ in selected]
+        headers = ["date", "category", "amount", "note"]
+        _emit(headers, ["Date", "Category", "Amount", "Note"], records, csv_rows, table, total, args)
+
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
