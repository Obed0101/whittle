+(()=>{const toggle=document.querySelector('.switch'),labels=[...document.querySelectorAll('.billing-label')],prices=[...document.querySelectorAll('.amount')],notes=[...document.querySelectorAll('[data-note]')];function setPeriod(yearly){toggle.setAttribute('aria-checked',String(yearly));toggle.setAttribute('aria-label',yearly?'Switch to monthly billing':'Switch to yearly billing');labels.forEach(label=>label.setAttribute('aria-pressed',String(label.dataset.period===(yearly?'yearly':'monthly'))));prices.forEach(price=>{const value=yearly?price.dataset.yearly:price.dataset.monthly;price.textContent='$'+(Number(value)%1?Number(value).toFixed(2):value)});notes.forEach(note=>note.textContent=yearly?'Billed annually':'Billed monthly')}toggle.addEventListener('click',()=>setPeriod(toggle.getAttribute('aria-checked')!=='true'));labels.forEach(label=>label.addEventListener('click',()=>setPeriod(label.dataset.period==='yearly')));})();
