+(function(){const toggle=document.getElementById('billing-switch');const amounts=document.querySelectorAll('.amount');const notes=document.querySelectorAll('[data-annual-note]');const status=document.getElementById('billing-status');const monthly=document.getElementById('monthly-label');const yearly=document.getElementById('yearly-label');function update(){const annual=toggle.getAttribute('aria-checked')==='true';toggle.setAttribute('aria-checked',String(annual));amounts.forEach(function(el){const value=annual?el.dataset.year:el.dataset.month;el.textContent='$'+(Number(value)%1?Number(value).toFixed(2):value)});notes.forEach(function(el){el.textContent=annual?'Billed annually':'Pay monthly'});monthly.classList.toggle('active-label',!annual);yearly.classList.toggle('active-label',annual);status.textContent=(annual?'Yearly':'Monthly')+' billing selected.'}toggle.addEventListener('click',function(){toggle.setAttribute('aria-checked',String(toggle.getAttribute('aria-checked')!=='true'));update()});update()})();
