und:var(--accent)}.switch span{display:block;width:21px;height:21px;border-radius:50%;background:white;box-shadow:0 1px 4px #0003;transition:transform .2s}.switch[aria-checked="true"] span{transform:translateX(21px)}.save{color:var(--green);font-size:.78rem;font-weight:750}.plans{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));align-items:stretch;gap:18px;padding:18px 0 80px}.card{position:relative;padding:28px;border:1px solid var(--line);border-radius:20px;background:var(--surface);box-shadow:0 8px 28px rgba(34,38,71,.04);display:flex;flex-direction:column;animation:rise .6s both}.card:nth-child(2){animation-delay:.08s}.card:nth-child(3){animation-delay:.16s}.card.featured{border:2px solid var(--accent);box-shadow:var(--shadow);transform:translateY(-8px)}.popular{position:absolute;top:-14px;left:50%;transform:translateX(-50%);white-space:nowrap;padding:5px 13px;border-radius:99px;background:var(--accent);color:white;font-size:.72rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase}.plan-name{margin:0;font-size:1.15rem;font-weight:750}.desc{min-height:48px;margin:7px 0 22px;color:var(--muted);font-size:.9rem}.price{display:flex;align-items:baseline;gap:5px;min-height:57px}.amount{font-size:2.9rem;line-height:1;font-weight:800;letter-spacing:-.07em}.unit{color:var(--muted);font-size:.86rem}.annual-note{height:21px;color:var(--green);font-size:.76rem;font-weight:650}.cta{display:block;margin:15px 0 24px;padding:12px 16px;text-align:center;text-decoration:none;border:1px solid var(--line);border-radius:10px;font-weight:750;font-size:.91rem;transition:transform .18s,background .18s}.cta:hover{transform:translateY(-2px);background:var(--soft)}.featured .cta{background:var(--accent);border-color:var(--accent);color:white}.featured .cta:hover{background:var(--accent-dark)}.card h3{margin:0 0 12px;font-size:.77rem;color:var(--muted);letter-spacing:.07em;text-transform:uppercase}.features{list-style:none;padding:0;margin:0;display:grid;gap:11px;font-