r(--line);border-radius:20px;padding:30px;position:relative;box-shadow:var(--shadow);transition:transform .22s,box-shadow .22s,border-color .22s}.card:hover{transform:translateY(-4px);box-shadow:0 24px 60px #24224b1c}.card.featured{border:2px solid var(--accent);padding:29px;background:linear-gradient(155deg,var(--surface) 55%,var(--soft))}.badge{position:absolute;top:-13px;left:50%;transform:translateX(-50%);white-space:nowrap;background:var(--accent);color:#fff;border-radius:99px;padding:5px 13px;font-size:.72rem;font-weight:750;letter-spacing:.04em}.plan-name{font-size:1.1rem;font-weight:750;margin:0 0 4px}.plan-desc{color:var(--muted);font-size:.9rem;min-height:44px;margin:0}.price{display:flex;align-items:baseline;gap:4px;margin:22px 0 0}.amount{font-size:3.2rem;line-height:1;font-weight:800;letter-spacing:-.07em;font-variant-numeric:tabular-nums}.unit{color:var(--muted);font-size:.88rem}.bill-note{height:23px;margin:7px 0 20px;color:var(--muted);font-size:.78rem}.cta{display:block;text-align:center;text-decoration:none;border:1px solid var(--line);border-radius:10px;padding:12px 15px;font-weight:700;font-size:.92rem;transition:background .2s,transform .2s}.cta:hover{transform:translateY(-1px);background:var(--soft);border-color:var(--accent);color:var(--accent)}.featured .cta{background:var(--accent);color:#fff;border-color:var(--accent)}.featured .cta:hover{background:var(--accent-dark)}.rule{height:1px;background:var(--line);margin:24px 0 19px}.includes{font-size:.78rem;font-weight:700;margin:0 0 13px}.features{padding:0;margin:0;list-style:none;display:grid;gap:11px;color:var(--muted);font-size:.87rem}.features li{display:flex;gap:9px}.check{color:var(--accent);font-weight:800}.section{padding:0 0 82px}.section-heading{text-align:center;margin-bottom:30px}.section-heading h2{font-size:clamp(1.8rem,4vw,2.6rem);letter-spacing:-.05em;margin:0 0 8px}.section-heading p{color:var(--muted);margin:0}.table-shell{overflow-x:auto;border:1px solid var(--line);border-radius:16px;background:var(--surface);box-shadow:var(--shadow)}table{border-collapse:collapse;width:100%;min-width:650px;text-align:center}th,td{padding:16px 20px;border-bottom:1px solid var(--line)}thead th{font-size:.88rem;background:var(--surface)}th:first-child,td:first-child{text-align:left;width:40%}tbody th{font-weight:550;color:var(--muted);font-size:.9rem}tbody td{font-size:1rem}tbody tr:last-child th,tbody tr:last-child td{border-bottom:0}.yes{color:var(--accent);font-weight:800}.no{color:#a5a9b7}.table-note{text-align:center;color:var(--muted);font-size:.78rem;margin:12px 0 0}.faq{max-width:760px;margin:0 auto}.faq details{border-bottom:1px solid var(--line)}.faq details:first-child{border-top:1px solid var(--line)}.faq summary{padding:20px 36px 20px 2px;cursor:pointer;font-weight:700;list-style:none;position:relative}.faq summary::-webkit-details-marker{display:none}.faq summary:after{content:'+';position:absolute;right:5px;top:15px;font-size:1.4rem;color:var(--accent);font-weight:400}.faq details[open] summary:after{content:'−'}.faq details p{margin:-5px 30px 20px 2px;color:var(--muted);font-size:.94rem}.footer{border-top:1px solid var(--line);padding:26px 0;color:var(--muted);font-size:.85rem}.footer .wrap{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}.footer a{color:var(--accent);text-decoration:none}button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #9088ff;outline-offset:3px;border-radius:6px}
