+(()=>{const buttons=[document.getElementById('monthly'),document.getElementById('yearly')];const prices=document.querySelectorAll('.amount');const notes=document.querySelectorAll('[data-note]');function setBilling(yearly){buttons[0].setAttribute('aria-pressed',String(!yearly));buttons[1].setAttribute('aria-pressed',String(yearly));prices.forEach(price=>{const value=yearly?price.dataset.yearly:price.dataset.monthly;price.textContent='$'+(yearly&&value.includes('.')?Number(value).toFixed(2).replace(/0$/,''):value)});notes.forEach(note=>{note.textContent=yearly?'Billed annually':'Billed monthly'})}buttons[0].addEventListener('click',()=>setBilling(false));buttons[1].addEventListener('click',()=>setBilling(true))})();
