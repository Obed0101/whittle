ection-head p{color:var(--muted);margin:0}.table-shell{overflow-x:auto;border:1px solid var(--line);border-radius:15px;background:var(--surface);box-shadow:var(--shadow)}table{border-collapse:collapse;width:100%;min-width:620px;text-align:center;font-size:13px}th,td{padding:15px 18px;border-bottom:1px solid var(--line)}thead th{font-weight:700;background:var(--soft);color:var(--ink)}thead th:first-child{text-align:left;width:40%;background:var(--surface)}tbody th{text-align:left;font-weight:550}tbody tr:last-child th,tbody tr:last-child td{border-bottom:0}.yes{color:var(--green);font-weight:750;font-size:16px}.no{color:#a3ada6}.faq{max-width:760px;margin:auto}.faq details{border-bottom:1px solid var(--line)}.faq details:first-child{border-top:1px solid var(--line)}.faq summary{list-style:none;cursor:pointer;padding:21px 4px;font-weight:650;display:flex;justify-content:space-between;gap:20px}.faq summary::-webkit-details-marker{display:none}.faq summary:after{content:"+";font-size:20px;line-height:1;color:var(--green);transition:transform .2s}.faq details[open] summary:after{content:"−"}.faq summary:focus-visible{outline:3px solid #72ab8c;outline-offset:3px;border-radius:4px}.faq p{margin:-5px 30px 20px 4px;color:var(--muted);font-size:14px}.footer{text-align:center;padding:28px;border-top:1px solid var(--line);color:var(--muted);font-size:12px}.footer a{color:var(--green)}
