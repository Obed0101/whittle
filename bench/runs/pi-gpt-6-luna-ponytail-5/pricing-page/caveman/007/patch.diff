+<script>
+const toggle=document.getElementById('billing-toggle');
+const monthlyLabel=document.getElementById('monthly-label');
+const yearlyLabel=document.getElementById('yearly-label');
+toggle.addEventListener('change',()=>{
+  const yearly=toggle.checked;
+  document.querySelectorAll('.amount').forEach(price=>{
+    const value=Number(price.dataset[yearly?'year':'month']);
+    price.textContent='$'+(Number.isInteger(value)?value:value.toFixed(2).replace(/0$/,''));
+  });
+  document.querySelectorAll('.annual-note[data-month-note]').forEach(note=>{
+    note.textContent=yearly?note.dataset.yearNote:note.dataset.monthNote;
+  });
+  monthlyLabel.setAttribute('aria-current',yearly?'false':'true');
+  yearlyLabel.setAttribute('aria-current',yearly?'true':'false');
+});
+</script>
