+<script>
+const toggle=document.getElementById('billing-toggle');
+toggle.addEventListener('change',()=>{
+  const yearly=toggle.checked;
+  document.querySelectorAll('.price [data-month]').forEach(price=>{
+    const amount=yearly?price.dataset.year:price.dataset.month;
+    price.textContent='$'+(amount.endsWith('.00')?amount.slice(0,-3):amount);
+  });
+  document.querySelectorAll('.per[data-per-month]').forEach(label=>{
+    label.textContent=yearly?label.dataset.perYear:label.dataset.perMonth;
+  });
+});
