+<script>
+(()=>{const toggle=document.getElementById('billing-switch');const amounts=document.querySelectorAll('.amount');const notes=document.querySelectorAll('[data-note]');const month=document.getElementById('monthly-label');const year=document.getElementById('yearly-label');toggle.addEventListener('click',()=>{const yearly=toggle.getAttribute('aria-checked')!=='true';toggle.setAttribute('aria-checked',String(yearly));toggle.setAttribute('aria-label',yearly?'Switch to monthly billing':'Switch to yearly billing');amounts.forEach(el=>{const value=Number(yearly?el.dataset.year:el.dataset.month);el.textContent='$'+(Number.isInteger(value)?value:value.toFixed(2).replace(/0$/,''))});notes.forEach(el=>el.textContent=yearly?'Billed yearly':'Billed monthly');month.style.color=yearly?'':'var(--accent)';year.style.color=yearly?'var(--accent)':''})})();
