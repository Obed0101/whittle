r(--muted);font-size:.8rem;text-align:center}.plans{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;align-items:stretch;padding:24px 0 72px}.plan{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:27px;box-shadow:var(--shadow);position:relative;display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s}.plan:hover{transform:translateY(-4px);box-shadow:0 23px 60px #19392a1c}.plan.featured{border:2px solid var(--green);padding:26px;box-shadow:0 20px 60px #126b5224}.badge{position:absolute;right:17px;top:17px;background:var(--soft);color:var(--green);padding:5px 10px;border-radius:100px;font-size:.7rem;font-weight:800;letter-spacing:.03em}.plan h2{font-size:1.2rem;margin:0 0 5px;letter-spacing:-.02em}.desc{min-height:46px;color:var(--muted);font-size:.9rem;margin:0 0 17px}.price{display:flex;align-items:baseline;gap:5px;margin-bottom:2px}.amount{font-size:2.8rem;line-height:1;font-weight:800;letter-spacing:-.07em}.period{font-size:.85rem;color:var(--muted)}.billing-note{font-size:.78rem;color:var(--muted);min-height:23px}.plan hr{border:0;border-top:1px solid var(--line);width:100%;margin:19px 0}.includes{font-size:.82rem;font-weight:750;margin:0 0 10px}.features{list-style:none;padding:0;margin:0 0 25px;display:grid;gap:10px;font-size:.88rem;color:var(--muted)}.features li{display:flex;gap:9px}.check{color:var(--green);font-weight:900}.button{display:block;text-align:center;text-decoration:none;margin-top:auto;padding:12px 16px;border:1px solid var(--line);border-radius:9px;font-weight:750;font-size:.9rem;transition:background .15s,transform .15s}.button:hover{transform:translateY(-1px);background:var(--soft)}.featured .button{background:var(--green);border-color:var(--green);color:white}.featured .button:hover{background:var(--green2)}.section{padding:62px 0;border-top:1px solid var(--line)}.section-head{text-align:center;margin:0 auto 32px}.section-head h2{font-size:clamp(1.8rem,4vw,2.6rem);letter-spacing:-.055em;line-height:1.1;margin:0 0 10px}.section-head p{color:var(--muted);margin:0}.table-scroll{overflow-x:auto;border:1px solid var(--line);border-radius:14px;background:var(--surface);box-shadow:var(--shadow)}table{width:100%;border-collapse:collapse;text-align:center;min-width:640px}th,td{padding:15px 18px;border-bottom:1px solid var(--line)}thead th{font-size:.9rem;background:var(--soft);color:var(--ink)}thead th:first-child{text-align:left;border-radius:13px 0 0 0}thead th:last-child{border-radius:0 13px 0 0}tbody th{text-align:left;font-weight:600;font-size:.9rem}tbody td{color:var(--green);font-weight:750}tbody tr:last-child th,tbody tr:last-child td{border-bottom:0}.no{color:#9aa49e}caption{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.faq{max-width:760px;margin:auto}.faq details{border-bottom:1px solid var(--line)}.faq details:first-child{border-top:1px solid var(--line)}.faq summary{list-style:none;cursor:pointer;padding:20px 42px 20px 4px;font-weight:700;position:relative}.faq summary::-webkit-details-marker{display:none}.faq summary:after{content:"+";position:absolute;right:7px;top:15px;font-size:1.5rem;font-weight:400;color:var(--green);transition:transform .2s}.faq details[open] summary:after{transform:rotate(45deg)}.faq details p{color:var(--muted);margin:-5px 40px 20px 4px}.closing{text-align:center;padding:46px 20px 60px}.closing h2{letter-spacing:-.04em;margin:0 0 10px}.closing p{color:var(--muted);margin:0 0 20px}.closing a{display:inline-block;background:var(--green);color:white;padding:11px 18px;border-radius:9px;text-decoration:none;font-weight:750}.footer{border-top:1px solid var(--line);padding:24px 0;color:var(--muted);font-size:.82rem}.footer .wrap{display:flex;justify-content:space-between;gap:12px}
