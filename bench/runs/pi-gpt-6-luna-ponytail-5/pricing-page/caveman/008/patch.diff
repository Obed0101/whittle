+<script>
+(()=>{const toggle=document.querySelector('.switch');const prices=document.querySelectorAll('.amount');const notes=document.querySelectorAll('.billing-note[data-note-month]');const hint=document.getElementById('billing-hint');function update(yearly){toggle.setAttribute('aria-checked',String(yearly));prices.forEach(price=>{price.textContent='$'+(yearly?price.dataset.year:price.dataset.month)});notes.forEach(note=>{note.textContent=yearly?note.dataset.noteYear:note.dataset.noteMonth});hint.textContent=yearly?'Billed yearly. Prices shown per user, per month; save 20%.':'Billed monthly. Switch to yearly and save 20%.'}toggle.addEventListener('click',()=>update(toggle.getAttribute('aria-checked')!=='true'));})();
