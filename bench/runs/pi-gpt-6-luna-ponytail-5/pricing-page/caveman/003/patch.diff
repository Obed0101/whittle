+<script>
+(() => {
+  const buttons = [...document.querySelectorAll('[data-cycle]')];
+  const prices = [...document.querySelectorAll('.price[data-monthly]')];
+  const notes = [...document.querySelectorAll('[data-note-monthly]')];
+  const status = document.getElementById('billing-status');
+  buttons.forEach(button => button.addEventListener('click', () => {
+    const cycle = button.dataset.cycle;
+    buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
+    prices.forEach(price => {
+      const amount = price.dataset[cycle];
+      price.textContent = `$${Number(amount).toLocaleString('en-US', {maximumFractionDigits: 2})}`;
+    });
+    notes.forEach(note => { note.textContent = note.dataset[`note${cycle[0].toUpperCase()}${cycle.slice(1)}`]; });
+    status.textContent = `${cycle === 'yearly' ? 'Yearly' : 'Monthly'} billing selected.`;
+  }));
+})();
