und:var(--surface)}table{border-collapse:collapse;width:100%;min-width:570px;text-align:center}th,td{padding:15px 20px;border-bottom:1px solid var(--line)}thead th{font-size:.88rem}th:first-child,td:first-child{text-align:left;width:43%}tbody th{font-size:.88rem;font-weight:550}td{color:var(--muted)}.yes{color:var(--green);font-weight:800}.faq{max-width:760px;margin:0 auto}.faq details{border-bottom:1px solid var(--line)}.faq summary{cursor:pointer;list-style:none;padding:19px 34px 19px 0;font-weight:650;position:relative}.faq summary::-webkit-details-marker{display:none}.faq summary:after{content:"+";position:absolute;right:4px;font-size:1.3rem;color:var(--green);top:14px}.faq details[open] summary:after{content:"−"}.faq details p{margin:-3px 30px 20px 0;color:var(--muted);font-size:.94rem}.footer{border-top:1px solid var(--line);padding:24px 0 35px;color:var(--muted);font-size:.84rem;display:flex;justify-content:space-between}.footer a{text-decoration:none}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}:focus-visible{outline:3px solid #b1d55c;outline-offset:4px;border-radius:4px}
