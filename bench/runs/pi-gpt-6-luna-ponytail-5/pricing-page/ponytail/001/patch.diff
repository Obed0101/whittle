+<script>
+const toggle = document.querySelector('#billing-switch');
+toggle.addEventListener('click', () => {
+  const yearly = toggle.getAttribute('aria-checked') !== 'true';
+  toggle.setAttribute('aria-checked', String(yearly));
+  toggle.setAttribute('aria-label', `Switch to ${yearly ? 'monthly' : 'yearly'} billing`);
+  document.querySelector('#billing-status').textContent = `${yearly ? 'Yearly' : 'Monthly'} billing selected`;
+  document.querySelectorAll('.amount[data-monthly]').forEach(price => {
+    price.textContent = `$${yearly ? price.dataset.yearly : price.dataset.monthly}`;
+  });
+  document.querySelectorAll('.billing-note[data-note]').forEach(note => {
+    note.textContent = yearly ? note.dataset.yearNote : note.dataset.note;
+  });
+});
+</script>
