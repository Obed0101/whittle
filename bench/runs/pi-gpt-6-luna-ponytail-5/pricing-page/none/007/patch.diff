+:root{color-scheme:light dark;--bg:#f7f6f2;--surface:#fff;--ink:#20251f;--muted:#687066;--line:#e5e7df;--green:#315e45;--green2:#eaf1e9;--accent:#d7f078;--shadow:0 18px 50px #28352312}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}a{color:inherit}button{font:inherit}.wrap{max-width:1120px;margin:auto;padding:0 28px}.nav{height:76px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{font-size:21px;font-weight:750;letter-spacing:-.06em;text-decoration:none;display:flex;gap:10px;align-items:center}.logo{height:29px;width:29px;background:var(--green);color:white;border-radius:9px;display:grid;place-items:center;font-size:15px}.navlinks{display:flex;align-items:center;gap:26px;font-size:14px;color:var(--muted)}.navlinks a{text-decoration:none}.navlinks a:hover{color:var(--ink)}.navlinks .navcta{background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:8px}.hero{text-align:center;padding:76px 0 42px}.eyebrow{display:inline-flex;gap:8px;align-items:center;color:var(--green);font-size:12px;font-weight:750;letter-spacing:.12em;text-transform:uppercase}.dot{width:7px;height:7px;border-radius:50%;background:#86a85d}h1{font-size:clamp(42px,6vw,66px);line-height:1.04;letter-spacing:-.065em;margin:17px 0 16px;font-weight:650}.hero p{color:var(--muted);font-size:18px;margin:0 auto;max-width:550px}.billing{display:flex;justify-content:center;align-items:center;gap:13px;margin-top:28px;font-size:14px}.switch{width:46px;height:26px;background:var(--green);border:0;border-radius:20px;padding:3px;cursor:pointer;transition:background .2s}.knob{width:20px;height:20px;border-radius:50%;background:white;display:block;transition:transform .2s}.switch[aria-checked="true"] .knob{transform:translateX(20px)}.save{font-size:12px;color:var(--green);background:var(--green2);padding:4px 9px;border-radius:20px;font-weight:700}.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;align-items:stretch;padding:8px 0 94px}.card{position:relative;border:1px solid var(--line);border-radius:16px;background:var(--surface);padding:28px;box-shadow:var(--shadow);display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-3px);box-shadow:0 22px 50px #2835231b}.card.featured{background:var(--green);color:#fff;border-color:var(--green);transform:translateY(-10px);box-shadow:0 24px 55px #315e4530}.card.featured:hover{transform:translateY(-13px)}.badge{position:absolute;top:17px;right:17px;background:var(--accent);color:#263322;border-radius:20px;padding:5px 10px;font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}.card h2{font-size:19px;margin:0 0 5px;letter-spacing:-.03em}.desc{font-size:13px;color:var(--muted);min-height:41px}.featured .desc,.featured .unit,.featured .features{color:#d7e4d7}.price{display:flex;align-items:baseline;gap:4px;margin:22px 0 0}.amount{font-size:46px;font-weight:650;letter-spacing:-.07em;line-height:1}.unit{font-size:13px;color:var(--muted)}.billing-note{height:24px;font-size:12px;color:var(--muted);padding-top:4px}.featured .billing-note{color:#d7e4d7}.features{list-style:none;margin:19px 0 25px;padding:0;color:var(--muted);font-size:13px;display:grid;gap:11px}.features li:before{content:"✓";color:var(--green);font-weight:800;margin-right:9px}.featured .features li:before{color:var(--accent)}.button{display:block;text-align:center;text-decoration:none;background:var(--ink);color:white;padding:12px;border-radius:8px;font-size:14px;font-weight:650;margin-top:auto;transition:filter .2s}.button:hover{filter:brightness(1.2)}.featured .button{background:var(--accent);color:#263322}.section{padding:0 0 90px}.section-heading{text-align:center;margin-bottom:30px}.section-heading .eyebrow{margin-bottom:7px}.section-heading h2{font-size:34px;letter-spacing:-.05em;margin:0}.section-heading p{color:var(--muted);margin:8px 0}.table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:14px;background:var(--surface);box-shadow:var(--shadow)}table{border-collapse:collapse;width:100%;min-width:650px;text-align:center;font-size:14px}th,td{padding:16px 20px;border-bottom:1px solid var(--line)}thead th{font-size:13px;color:var(--muted);font-weight:650}th:first-child,td:first-child{text-align:left;width:40%}thead th:nth-child(3){color:var(--green)}tbody tr:last-child td{border-bottom:0}.check{color:var(--green);font-weight:800;font-size:17px}.no{color:#9a9f96}.faq{max-width:760px;margin:auto}.faq details{border-bottom:1px solid var(--line)}.faq summary{cursor:pointer;list-style:none;padding:20px 42px 20px 0;font-weight:650;position:relative}.faq summary::-webkit-details-marker{display:none}.faq summary:after{content:"+";position:absolute;right:8px;top:17px;font-size:23px;color:var(--green);font-weight:400}.faq details[open] summary:after{content:"−"}.faq details p{color:var(--muted);margin:-3px 36px 20px 0;font-size:14px}.footer{border-top:1px solid var(--line);padding:25px 0 35px;color:var(--muted);font-size:13px;display:flex;justify-content:space-between}.footer a{color:var(--green);text-decoration:none} :focus-visible{outline:3px solid #a6cb52;outline-offset:3px;border-radius:4px}
