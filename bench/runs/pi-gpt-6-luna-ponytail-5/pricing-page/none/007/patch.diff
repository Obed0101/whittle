+@media(prefers-color-scheme:dark){:root{--bg:#151a16;--surface:#1e251f;--ink:#edf1e9;--muted:#a4aea2;--line:#323b33;--green:#9bc69f;--green2:#253629;--shadow:0 18px 50px #0003}.logo{background:#42684d}.card.featured{background:#27412f;color:#f2f5ed;border-color:#42684d}.featured .desc,.featured .unit,.featured .features,.featured .billing-note{color:#cad9ca}.button{background:#dce9d9;color:#1d2a20}.featured .button{background:var(--accent);color:#263322}.features li:before{color:var(--green)}.check{color:#a8d3aa}.save{color:#c7e4c5}.table-wrap{box-shadow:0 18px 50px #0002}}
