+:root{color-scheme:light dark;--bg:#f7f8f5;--surface:#fff;--ink:#18231f;--muted:#66736d;--line:#e1e8e2;--green:#146b50;--green2:#0e523d;--lime:#d8f276;--soft:#edf4ec;--shadow:0 18px 55px #173b2914;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);line-height:1.55}a{color:inherit}.wrap{width:min(1120px,calc(100% - 40px));margin:auto}.topbar{height:76px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:10px;font-size:1.25rem;font-weight:800;letter-spacing:-.04em;text-decoration:none}.mark{width:31px;height:31px;border-radius:10px;background:var(--green);display:grid;place-items:center;color:white;font-size:17px}.nav{display:flex;align-items:center;gap:28px;font-size:.91rem;color:var(--muted)}.nav a{text-decoration:none}.nav a:hover{color:var(--green)}.nav .login{color:var(--ink);font-weight:650}.hero{text-align:center;padding:70px 0 37px}.eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--green);font-size:.75rem;letter-spacing:.13em;text-transform:uppercase;font-weight:800}.eyebrow:before{content:"";height:1px;width:20px;background:currentColor}h1{font-size:clamp(2.5rem,6vw,4.25rem);letter-spacing:-.065em;line-height:1.04;margin:15px 0 16px}h1 span{color:var(--green)}.lede{max-width:550px;margin:0 auto;color:var(--muted);font-size:1.08rem}.billing{margin:27px auto 0;display:inline-flex;align-items:center;gap:13px;padding:6px 8px;border:1px solid var(--line);border-radius:999px;background:var(--surface);font-size:.85rem}.billing label{cursor:pointer;padding:7px 10px;border-radius:999px;color:var(--muted);font-weight:650}.billing label:has(input:checked){background:var(--soft);color:var(--green)}.billing input{position:absolute;opacity:0;width:1px;height:1px}.billing input:focus-visible+span{outline:3px solid #87c9a6;outline-offset:3px;border-radius:3px}.save{font-size:.72rem;background:#e7f3dc;color:#3a6c31;padding:4px 8px;border-radius:999px;font-weight:750}.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;align-items:stretch;padding:14px 0 75px}.plan{position:relative;background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:29px 27px 25px;box-shadow:var(--shadow);display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s}.plan:hover{transform:translateY(-4px);box-shadow:0 24px 65px #173b2920}.plan.featured{border:2px solid var(--green);padding:28px 26px 24px;box-shadow:0 20px 60px #146b5024}.popular{position:absolute;top:-14px;left:50%;transform:translateX(-50%);border-radius:999px;background:var(--green);color:white;padding:5px 14px;font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;font-weight:800;white-space:nowrap}.plan h2{font-size:1.19rem;margin:0 0 5px;letter-spacing:-.025em}.desc{color:var(--muted);font-size:.88rem;min-height:42px;margin:0}.price{display:flex;align-items:baseline;gap:5px;margin:21px 0 2px}.price .amount{font-size:3rem;line-height:1;letter-spacing:-.07em;font-weight:750}.price small{color:var(--muted);font-size:.9rem}.billing-note{color:var(--muted);font-size:.76rem;min-height:22px}.cta{display:block;text-align:center;text-decoration:none;background:var(--ink);color:var(--surface);border:1px solid var(--ink);border-radius:9px;padding:11px 14px;font-weight:700;font-size:.9rem;margin:22px 0 24px;transition:background .15s,transform .15s}.cta:hover{background:var(--green);border-color:var(--green);transform:translateY(-1px)}.featured .cta{background:var(--green);border-color:var(--green);color:white}.featured .cta:hover{background:var(--green2)}.features{list-style:none;padding:0;margin:0;border-top:1px solid var(--line);padding-top:18px;display:grid;gap:11px;font-size:.86rem}.features li{display:flex;gap:10px;align-items:flex-start}.check{color:var(--green);font-weight:900}.section{padding:0 0 76px}.section-heading{text-align:center;margin-bottom:28px}.section-heading .eyebrow{justify-content:center}.section-heading h2{font-size:2rem;letter-spacing:-.05em;margin:9px 0}.section-heading p{color:var(--muted);margin:0}.table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:14px;background:var(--surface);box-shadow:var(--shadow)}table{width:100%;border-collapse:collapse;text-align:center;min-width:660px}th,td{padding:15px 18px;border-bottom:1px solid var(--line)}thead th{font-size:.9rem;background:var(--soft);color:var(--ink)}thead th:first-child{text-align:left;width:40%;border-radius:14px 0 0 0}thead th:last-child{border-radius:0 14px 0 0}tbody th{text-align:left;font-size:.88rem;font-weight:600}td{color:var(--green);font-size:1.05rem;font-weight:750}td.no{color:#9aa69f;font-weight:500}.faq{max-width:790px;margin:auto}.faq details{border-bottom:1px solid var(--line)}.faq details:first-of-type{border-top:1px solid var(--line)}.faq summary{list-style:none;cursor:pointer;padding:20px 42px 20px 2px;font-weight:700;position:relative}.faq summary::-webkit-details-marker{display:none}.faq summary:after{content:"+";position:absolute;right:8px;top:15px;font-size:1.35rem;color:var(--green);transition:transform .2s}.faq details[open] summary:after{content:"−"}.faq summary:focus-visible,.cta:focus-visible,.nav a:focus-visible{outline:3px solid #87c9a6;outline-offset:4px}.answer{color:var(--muted);padding:0 36px 20px 2px;font-size:.93rem}.footer{border-top:1px solid var(--line);padding:24px 0 35px;color:var(--muted);font-size:.84rem;display:flex;justify-content:space-between;gap:20px}.footer a{color:var(--green);text-decoration:none}@media(max-width:760px){.wrap{width:min(100% - 30px,560px)}.nav{gap:15px}.nav a:not(.login){display:none}.hero{padding:54px 0 30px}.plans{grid-template-columns:1fr;gap:16px;padding-bottom:58px}.plan{padding:25px}.plan.featured{padding:24px}.plan .desc{min-height:auto}.section{padding-bottom:58px}.section-heading h2{font-size:1.75rem}.footer{flex-direction:column;gap:8px}}@media(prefers-color-scheme:dark){:root{--bg:#111814;--surface:#19221d;--ink:#edf4ee;--muted:#a5b3aa;--line:#2e3b33;--green:#82d5ad;--green2:#69bd96;--lime:#d8f276;--soft:#24372b;--shadow:0 18px 55px #0004}.mark{background:#286448}.featured .cta{color:#10251a;background:#82d5ad;border-color:#82d5ad}.featured .cta:hover{background:#9be4be}.cta{color:#111814;background:#edf4ee;border-color:#edf4ee}.billing label:has(input:checked){background:#294232;color:#9be4be}.save{background:#2b4028;color:#c0e5a5}.popular{color:#10251a;background:#82d5ad}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
