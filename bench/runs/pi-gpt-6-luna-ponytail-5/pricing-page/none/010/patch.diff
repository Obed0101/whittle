+<script>
+(()=>{const prices=document.querySelectorAll('.price');const radios=document.querySelectorAll('input[name="billing"]');const notes=document.querySelectorAll('.billing-note[data-note]');function update(){const yearly=document.querySelector('input[name="billing"]:checked').value==='yearly';prices.forEach(el=>{el.textContent=el.dataset[yearly?'yearly':'monthly']});notes.forEach(el=>{el.textContent=yearly?'per user / month, billed annually':'per user / month, billed monthly'})}radios.forEach(r=>r.addEventListener('change',update))})();
