755}.save{color:var(--green);font-size:.72rem;font-weight:750;white-space:nowrap}.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;align-items:stretch;padding-bottom:92px}.card{position:relative;border:1px solid var(--line);border-radius:18px;padding:29px 27px 25px;background:var(--surface);box-shadow:var(--shadow);display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s}.card:hover{transform:translateY(-4px);box-shadow:0 24px 60px #242b501c}.card.featured{border:2px solid var(--accent);padding:28px 26px 24px;box-shadow:0 18px 54px #635bdb24}.popular{position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:var(--accent);color:white;border-radius:99px;padding:5px 13px;font-size:.72rem;font-weight:760;letter-spacing:.02em;white-space:nowrap}.plan-name{font-size:1.1rem;font-weight:740}.description{font-size:.88rem;color:var(--muted);min-height:44px;margin:6px 0 20px}.price-line{display:flex;align-items:baseline;gap:5px;min-height:56px}.currency{font-size:1.4rem;font-weight:650;align-self:flex-start;margin-top:6px}.price{font-size:3.45rem;font-weight:760;letter-spacing:-.075em;line-height:1}.period{color:var(--muted);font-size:.85rem}.billing-note{font-size:.76rem;color:var(--muted);margin:5px 0 22px;min-height:18px}.rule{border:0;border-top:1px solid var(--line);width:100%;margin:0 0 20px}.features{list-style:none;padding:0;margin:0 0 27px;display:grid;gap:12px;font-size:.87rem}.features li{display:flex;gap:10px;align-items:flex-start}.check{color:var(--green);font-weight:800;flex:none}.cta{display:block;text-align:center;text-decoration:none;border:1px solid var(--line);border-radius:9px;padding:11px 14px;font-size:.9rem;font-weight:700;margin-top:auto;transition:background .15s,color .15s,transform .15s}.cta:hover{transform:translateY(-1px);background:var(--soft);border-color:#c8c4fa}.featured .cta{background:var(--accent);border-color:var(--accent);color:white}.featured .cta:hover{background:var(--accent-dark)}.fineprint{text-align:center;color:var(--muted);font-size:.8rem;margin:-66px 0 89px}.section{padding:0 0 88px}.section-heading{text-align:center;margin-bottom:34px}.section-heading h2{font-size:clamp(1.8rem,4vw,2.5rem);letter-spacing:-.05em;margin:0 0 8px}.section-heading p{color:var(--muted);margin:0}.table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:14px;background:var(--surface);box-shadow:var(--shadow)}table{width:100%;border-collapse:collapse;text-align:center;min-width:630px}th,td{padding:16px 19px;border-bottom:1px solid var(--line);font-size:.88rem}thead th{font-size:.85rem;color:var(--ink);font-weight:720;background:var(--surface)}th:first-child,td:first-child{text-align:left;width:46%}tbody th{font-weight:560;color:var(--muted)}tbody tr:last-child th,tbody tr:last-child td{border-bottom:0}.yes{color:var(--green);font-weight:750}.no{color:#9aa2b2}.faq{max-width:760px;margin:0 auto}.faq details{background:var(--surface);border:1px solid var(--line);border-radius:12px;margin:10px 0;box-shadow:0 5px 18px #242b5008}.faq summary{list-style:none;cursor:pointer;padding:18px 21px;font-weight:680;display:flex;justify-content:space-between;gap:16px;align-items:center}.faq summary::-webkit-details-marker{display:none}.faq summary:after{content:"+";color:var(--accent);font-size:1.35rem;font-weight:500;line-height:1}.faq details[open] summary:after{content:"−"}.faq summary:focus-visible,.cta:focus-visible,.nav a:focus-visible{outline:3px solid #827cf7;outline-offset:3px}.answer{padding:0 21px 18px;color:var(--muted);font-size:.92rem}.answer p{margin:0}.footer{border-top:1px solid var(--line);padding:24px 0;color:var(--muted);font-size:.82rem}.footer-inner{display:flex;justify-content:space-between;gap:18px}.footer a{text-decoration:none}.reveal{animation:rise .55s both}.reveal:nth-child(2){animation-delay:.08s}.reveal:nth-child(3){animation-delay:.16s}@keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
