-size:12px;margin-top:8px}.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;align-items:stretch;padding-bottom:78px}.card{position:relative;background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:28px 27px 25px;box-shadow:var(--shadow);display:flex;flex-direction:column;transition:transform .22s ease,box-shadow .22s ease}.card:hover{transform:translateY(-4px);box-shadow:0 24px 55px #143d281a}.card.featured{border:2px solid var(--green);padding:27px 26px 24px;box-shadow:0 20px 54px #167b551b}.popular{position:absolute;right:18px;top:17px;background:var(--soft);color:var(--green);font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;padding:6px 9px;border-radius:99px}.card h2{font-size:19px;margin:0 0 4px;letter-spacing:-.4px}.desc{min-height:43px;font-size:13px;color:var(--muted);margin:0 0 22px}.price-line{display:flex;align-items:baseline;gap:4px;min-height:51px}.currency{font-size:20px;font-weight:650;align-self:flex-start;margin-top:7px}.amount{font-size:45px;font-weight:750;letter-spacing:-2.7px;line-height:1}.period{font-size:13px;color:var(--muted)}.per-user{font-size:12px;color:var(--muted);margin:4px 0 22px;min-height:18px}.rule{border:0;border-top:1px solid var(--line);width:100%;margin:0 0 19px}.includes{font-size:12px;font-weight:700;margin:0 0 12px}.features{list-style:none;padding:0;margin:0 0 26px;display:grid;gap:11px;font-size:13px;color:var(--muted)}.features li{display:flex;gap:9px;align-items:flex-start}.check{color:var(--green);font-weight:800}.button{display:block;text-align:center;margin-top:auto;text-decoration:none;border:1px solid var(--line);border-radius:9px;padding:12px 16px;font-size:13px;font-weight:700;background:var(--surface);transition:background .15s,color .15s,transform .15s}.button:hover{background:var(--soft);transform:translateY(-1px)}.button.primary{background:var(--green);border-color:var(--green);color:#fff}.button.primary:hover{background:var(--green-dark)}.sect