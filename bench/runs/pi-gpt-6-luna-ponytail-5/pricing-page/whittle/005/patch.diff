+<script>
+const billingSwitch=document.querySelector('.switch');
+billingSwitch.addEventListener('click',()=>{const yearly=billingSwitch.getAttribute('aria-checked')!=='true';billingSwitch.setAttribute('aria-checked',String(yearly));document.querySelectorAll('.amount').forEach(price=>{const value=yearly?price.dataset.year:price.dataset.month;price.textContent='$'+(Number(value)%1?Number(value).toFixed(2):value)});document.querySelectorAll('[data-annual-note]').forEach(note=>{note.textContent=yearly?'Billed annually':'Billed monthly'})});
