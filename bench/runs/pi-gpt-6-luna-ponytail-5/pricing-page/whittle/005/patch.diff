sible,summary:focus-visible{outline:3px solid #a89cff;outline-offset:3px}.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;align-items:stretch;padding:18px 0 76px}.plan{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:29px;box-shadow:var(--shadow);position:relative;display:flex;flex-direction:column;animation:rise .55s both}.plan:nth-child(2){animation-delay:.08s}.plan:nth-child(3){animation-delay:.16s}.plan.featured{border:2px solid var(--purple);transform:translateY(-10px);box-shadow:0 22px 65px #6654e826}.badge{position:absolute;top:-13px;left:50%;transform:translateX(-50%);white-space:nowrap;background:var(--purple);color:white;padding:4px 13px;border-radius:30px;text-transform:uppercase;letter-spacing:.09em;font-size:10px;font-weight:800}.plan h2{font-size:20px;margin:3px 0}.plan-desc{min-height:46px;color:var(--muted);font-size:14px;margin:4px 0 20px}.price{display:flex;align-items:baseline;gap:5px;margin-bottom:4px}.amount{font-size:43px;line-height:1;font-weight:750;letter-spacing:-.06em}.per{font-size:13px;color:var(--muted)}.year-note{height:22px;color:var(--green);font-size:12px}.plan hr{width:100%;border:0;border-top:1px solid var(--line);margin:18px 0}.features{list-style:none;margin:0 0 27px;padding:0;display:grid;gap:12px;font-size:14px}.features li{display:flex;gap:10px;align-items:flex-start}.check{color:var(--green);font-weight:800}.cta{display:block;text-align:center;text-decoration:none;border:1px solid var(--line);border-radius:9px;padding:11px 14px;font-weight:700;font-size:14px;margin-top:auto;transition:transform .15s,background .15s}.cta:hover{transform:translateY(-2px);background:var(--soft);border-color:var(--purple)}.featured .cta{background:var(--purple);border-color:var(--purple);color:#fff}.featured .cta:hover{background:var(--purple-dark)}.section{padding:18px 0 78px}.section-head{text-align:center;margin-bottom:31px}.section-head h2{font-size:32px;letter-spacing:-.04em;margin:0 0 8px}.section-head p{color:var(--muted);margin:0}.table-shell{overflow-x:auto;background:var(--surface);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow)}table{border-collapse:collapse;width:100%;min-width:660px;text-align:center}th,td{padding:16px 20px;border-bottom:1px solid var(--line);font-size:14px}thead th{font-size:13px;color:var(--muted);font-weight:700;background:var(--surface)}thead th:first-child{text-align:left;width:40%}tbody th{text-align:left;font-weight:600}tbody tr:last-child th,tbody tr:last-child td{border-bottom:0}.yes{color:var(--green);font-weight:800;font-size:17px}.no{color:#9ca3b2}.faq{max-width:760px;margin:0 auto}.faq details{background:var(--surface);border:1px solid var(--line);border-radius:12px;margin:10px 0;padding:0 20px}.faq summary{cursor:pointer;list-style:none;font-weight:650;padding:18px 30px 18px 0;position:relative}.faq summary::-webkit-details-marker{display:none}.faq summary::after{content:"+";position:absolute;right:0;color:var(--purple);font-size:22px;top:12px}.faq details[open] summary::after{content:"−"}.faq details p{color:var(--muted);margin:0;padding:0 0 18px;font-size:14px}.footer{border-top:1px solid var(--line);padding:24px 0;color:var(--muted);font-size:13px}.footer-inner{display:flex;justify-content:space-between;align-items:center}.footer a{color:var(--purple);text-decoration:none}
