+<script>
+const billingInputs=document.querySelectorAll('input[name="billing"]');
+billingInputs.forEach(input=>input.addEventListener('change',()=>{const yearly=input.value==='yearly'&&input.checked;document.querySelectorAll('.amount').forEach(price=>{const value=yearly?price.dataset.year:price.dataset.month;price.textContent=Number(value)===0?'$0':`$${Number(value).toFixed(Number(value)%1?2:0)}`});document.querySelectorAll('.billing-note[data-note-month]').forEach(note=>{note.textContent=yearly?note.dataset.noteYear:note.dataset.noteMonth});document.querySelectorAll('.period').forEach(period=>{period.textContent=yearly?'/ user / month, billed yearly':'/ user / month'})}));
