+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+import json
+import sys
+from datetime import date
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        raise ValueError(message)
+
+
+def _parser():
+    parser = Parser(prog="python -m app.report", description="Report on an expense CSV.")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[], metavar="NAME")
+    parser.add_argument("--from", dest="date_from", metavar="DATE")
+    parser.add_argument("--to", dest="date_to", metavar="DATE")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int, metavar="N")
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by category"
+    return parser
+
+
+def _parse_date(value):
+    try:
+        parsed = date.fromisoformat(value)
+        if parsed.isoformat() != value:
+            raise ValueError
+        return parsed
+    except (TypeError, ValueError):
+        raise ValueError(f"error: invalid date: {value}")
+
+
+def _amount(value):
+    return float(value)
+
+
+def _table(rows, grouped, currency, no_header):
+    if grouped:
+        headers = ["Category" if grouped == "category" else "Month", "Count", "Total"]
+        data = [[r["group"], str(r["count"]), f"{currency}{r['total']:,.2f}"] for r in rows]
+        total = sum(r["total"] for r in rows)
+    else:
+        headers = ["Date", "Category", "Amount", "Note"]
+        data = [[r["date"], r["category"], f"{currency}{abs(r['amount']):,.2f}" if r["amount"] >= 0 else f"({currency}{abs(r['amount']):,.2f})", r["note"][:23] + "…" if len(r["note"]) > 24 else r["note"]] for r in rows]
+        total = sum(r["amount"] for r in rows)
+    if not rows:
+        return "No expenses.\n"
+    data.append(["Total", "", f"{currency}{total:,.2f}"] + ([] if grouped else [""]))
+    widths = [max(len(str(row[i])) for row in [headers] + data) for i in range(len(headers))]
+    lines = []
+    if not no_header:
+        lines += ["  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)), "  ".join("-" * w for w in widths)]
+    for row in data:
+        lines.append("  ".join(str(v).rjust(widths[i]) if (i == 2 and (grouped or not grouped)) else str(v).ljust(widths[i]) for i, v in enumerate(row)))
+    return "\n".join(lines) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+        lower = _parse_date(args.date_from) if args.date_from else None
+        upper = _parse_date(args.date_to) if args.date_to else None
+        if lower and upper and lower > upper:
+            raise ValueError("error: --from is after --to")
+        minimum = _amount(args.minimum) if args.minimum is not None else None
+        rows = load(args.path)
+    except SystemExit as exc:
+        return int(exc.code)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except ValueError as exc:
+        print(str(exc) if str(exc).startswith("error:") else f"error: {exc}", file=sys.stderr)
+        return 2
+
+    valid = []
+    invalid = 0
+    for index, row in enumerate(rows):
+        try:
+            row["amount"] = float(row["amount"])
+        except (ValueError, TypeError):
+            invalid += 1
+            continue
+        try:
+            row["_date"] = _parse_date(row["date"])
+        except ValueError as exc:
+            print(str(exc), file=sys.stderr)
+            return 2
+        row["_index"] = index
+        valid.append(row)
+    categories = {name.casefold() for name in args.category}
+    valid = [r for r in valid if (not categories or r["category"].casefold() in categories)
+             and (lower is None or r["_date"] >= lower) and (upper is None or r["_date"] <= upper)
+             and (minimum is None or r["amount"] >= minimum)]
+    valid.sort(key=lambda r: r["_date"])
+    if args.top is not None:
+        valid = sorted(valid, key=lambda r: r["amount"], reverse=True)[:max(0, args.top)]
+    if args.by:
+        groups = {}
+        for row in valid:
+            key = row["category"].title() if args.by == "category" else row["date"][:7]
+            groups.setdefault(key, []).append(row)
+        grouped = [{"group": key, "count": len(items), "total": sum(r["amount"] for r in items)} for key, items in groups.items()]
+        if args.by == "category":
+            grouped.sort(key=lambda r: (-r["total"], r["group"].casefold()))
+        else:
+            grouped.sort(key=lambda r: r["group"])
+        if args.format == "json":
+            output = json.dumps(grouped, indent=2) + "\n" if grouped else "No expenses.\n"
+        elif args.format == "csv":
+            import io
+            stream = io.StringIO(newline="")
+            writer = csv.writer(stream)
+            writer.writerow(["group", "count", "total"])
+            writer.writerows((r["group"], r["count"], f"{r['total']:.2f}") for r in grouped)
+            output = stream.getvalue() if grouped else "No expenses.\n"
+        else:
+            output = _table(grouped, args.by, args.currency, args.no_header)
+    else:
+        if args.format == "json":
+            output = json.dumps([{k: (r["amount"] if k == "amount" else r[k]) for k in ("date", "category", "amount", "note")} for r in valid], indent=2) + "\n" if valid else "No expenses.\n"
+        elif args.format == "csv":
+            import io
+            stream = io.StringIO(newline="")
+            writer = csv.writer(stream)
+            writer.writerow(["date", "category", "amount", "note"])
+            writer.writerows((r["date"], r["category"], f"{r['amount']:.2f}", r["note"]) for r in valid)
+            output = stream.getvalue() if valid else "No expenses.\n"
+        else:
+            output = _table(valid, None, args.currency, args.no_header)
+    sys.stdout.write(output)
+    if invalid:
+        print(f"warning: skipped {invalid} row{'s' if invalid != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
