+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(description="Report expenses.")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[], metavar="NAME")
+    parser.add_argument("--from", dest="start", metavar="DATE")
+    parser.add_argument("--to", dest="end", metavar="DATE")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="", metavar="SYMBOL")
+    parser.add_argument("--top", type=int, metavar="N")
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by category"
+    return parser
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise ValueError(value)
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _table(headers, rows, amount_columns=()):
+    widths = [max(len(str(headers[i])), *(len(str(row[i])) for row in rows)) for i in range(len(headers))]
+    for i in amount_columns:
+        widths[i] = max(widths[i], 7)
+    lines = []
+    if not getattr(_table, "no_header", False):
+        lines.extend(("  ".join(str(v).ljust(widths[i]) for i, v in enumerate(headers)),
+                      "  ".join("-" * widths[i] for i in range(len(headers)))))
+    for row in rows:
+        lines.append("  ".join((str(v).rjust(widths[i]) if i in amount_columns else str(v).ljust(widths[i]))
+                                for i, v in enumerate(row)))
+    return lines
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    try:
+        start = _date(args.start) if args.start else None
+        end = _date(args.end) if args.end else None
+        if start and end and start > end:
+            raise RuntimeError("--from is after --to")
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+        records = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except ValueError as exc:
+        if str(exc) == "--from is after --to":
+            print("error: --from is after --to", file=sys.stderr)
+        elif args.start and str(exc) == args.start:
+            print(f"error: invalid date: {args.start}", file=sys.stderr)
+        elif args.end and str(exc) == args.end:
+            print(f"error: invalid date: {args.end}", file=sys.stderr)
+        else:
+            print(f"error: invalid amount: {exc}", file=sys.stderr)
+        return 2
+    except RuntimeError as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 2
+
+    valid = []
+    invalid_amounts = 0
+    try:
+        for index, row in enumerate(records):
+            try:
+                amount = Decimal(row["amount"])
+                if not amount.is_finite():
+                    raise InvalidOperation
+            except (InvalidOperation, ValueError, TypeError, KeyError):
+                invalid_amounts += 1
+                continue
+            try:
+                day = _date(row["date"])
+            except ValueError:
+                print(f"error: invalid date: {row.get('date', '')}", file=sys.stderr)
+                return 2
+            valid.append({"date": day, "category": row["category"], "amount": amount,
+                          "note": row.get("note", ""), "index": index})
+    except TypeError:
+        print("error: invalid expense row", file=sys.stderr)
+        return 2
+
+    categories = {name.casefold() for name in args.category}
+    expenses = [r for r in valid if (not categories or r["category"].casefold() in categories)
+                and (start is None or r["date"] >= start) and (end is None or r["date"] <= end)
+                and (minimum is None or r["amount"] >= minimum)]
+    expenses.sort(key=lambda r: (r["date"], r["index"]))
+    if args.top is not None:
+        expenses = sorted(expenses, key=lambda r: r["amount"], reverse=True)[:max(0, args.top)]
+
+    _table.no_header = args.no_header
+    if args.by:
+        groups = {}
+        for row in expenses:
+            key = row["category"] if args.by == "category" else row["date"].strftime("%Y-%m")
+            groups.setdefault(key, []).append(row["amount"])
+        grouped = [(key, len(values), sum(values, Decimal(0))) for key, values in groups.items()]
+        if args.by == "category":
+            grouped.sort(key=lambda x: (-x[2], x[0].casefold()))
+            title = "Category"
+            grouped = [(k.title(), n, t) for k, n, t in grouped]
+        else:
+            grouped.sort(key=lambda x: x[0])
+            title = "Month"
+        if not grouped:
+            print("No expenses.")
+        elif args.format == "json":
+            print(json.dumps([{"group": k, "count": n, "total": float(t)} for k, n, t in grouped], indent=2))
+        else:
+            rows = [(k, str(n), args.currency + _money(t)) for k, n, t in grouped]
+            rows.append(("Total", str(sum(x[1] for x in grouped)), args.currency + _money(sum((x[2] for x in grouped), Decimal(0)))))
+            print("\n".join(_table((title, "Count", "Total"), rows, (1, 2))))
+    elif not expenses:
+        print("No expenses.")
+    elif args.format == "json":
+        print(json.dumps([{"date": r["date"].isoformat(), "category": r["category"],
+                           "amount": float(r["amount"]), "note": r["note"]} for r in expenses], indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(("date", "category", "amount", "note"))
+        for r in expenses:
+            writer.writerow((r["date"].isoformat(), r["category"], f'{r["amount"]:.2f}', r["note"]))
+    else:
+        rows = [(r["date"].isoformat(), r["category"],
+                 args.currency + (f"({_money(abs(r['amount']))})" if r["amount"] < 0 else _money(r["amount"])),
+                 r["note"] if len(r["note"]) <= 24 else r["note"][:23] + "…") for r in expenses]
+        rows.append(("Total", "", args.currency + (f"({_money(abs(sum((r['amount'] for r in expenses), Decimal(0))))})" if sum((r['amount'] for r in expenses), Decimal(0)) < 0 else _money(sum((r['amount'] for r in expenses), Decimal(0)))), ""))
+        print("\n".join(_table(("Date", "Category", "Amount", "Note"), rows, (2,))))
+
+    if invalid_amounts:
+        suffix = "" if invalid_amounts == 1 else "s"
+        print(f"warning: skipped {invalid_amounts} row{suffix} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
