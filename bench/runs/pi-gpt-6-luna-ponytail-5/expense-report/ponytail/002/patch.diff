+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        self.print_usage(sys.stderr)
+        print(f"error: {message}", file=sys.stderr)
+        raise SystemExit(2)
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except ValueError:
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+
+
+def _money(value):
+    try:
+        return Decimal(value)
+    except InvalidOperation:
+        return None
+
+
+def _parser():
+    parser = Parser(prog="python -m app.report", description="Create an expense report.",
+                    usage="python -m app.report PATH [options]")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", dest="categories")
+    parser.add_argument("--from", dest="start", type=_date, metavar="DATE")
+    parser.add_argument("--to", dest="end", type=_date, metavar="DATE")
+    parser.add_argument("--min", type=Decimal, metavar="AMOUNT")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int, metavar="N")
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by category"
+    return parser
+
+
+def _table(rows, grouped, args):
+    if grouped:
+        labels = ["Category" if args.by == "category" else "Month", "Count", "Total"]
+        values = [[key, str(count), f"{args.currency}{total:,.2f}"] for key, count, total in grouped]
+    else:
+        labels = ["Date", "Category", "Amount", "Note"]
+        values = [[r["date"], r["category"], _format_amount(r["value"], args.currency),
+                   r["note"] if len(r["note"]) <= 24 else r["note"][:23] + "…"] for r in rows]
+    total = sum((r["value"] for r in rows), Decimal(0))
+    if not args.no_header:
+        widths = [max(len(labels[i]), *(len(row[i]) for row in values)) if values else len(labels[i]) for i in range(len(labels))]
+        if not grouped:
+            widths[2] = max(widths[2], len(f"{args.currency}{total:,.2f}"))
+        output = ["  ".join(x.ljust(widths[i]) for i, x in enumerate(labels)),
+                  "  ".join("-" * w for w in widths)]
+    else:
+        widths = [max((len(row[i]) for row in values), default=0) for i in range(len(labels))]
+        output = []
+    for row in values:
+        output.append("  ".join((x.rjust(widths[i]) if (grouped and i == 2) or (not grouped and i == 2) else x.ljust(widths[i])) for i, x in enumerate(row)))
+    output.append(f"Total  {args.currency}{total:,.2f}")
+    return "\n".join(output) + "\n"
+
+
+def _format_amount(value, currency):
+    rendered = f"{abs(value):,.2f}"
+    if value < 0:
+        rendered = f"({rendered})"
+    return currency + rendered
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as exc:
+        return int(exc.code)
+    if args.start and args.end and args.start > args.end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        source = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    rows, invalid = [], 0
+    for index, raw in enumerate(source):
+        amount = _money(raw.get("amount", ""))
+        if amount is None:
+            invalid += 1
+            continue
+        try:
+            day = date.fromisoformat(raw["date"])
+        except (ValueError, KeyError):
+            print(f"error: invalid date: {raw.get('date', '')}", file=sys.stderr)
+            return 2
+        row = {**raw, "value": amount, "day": day, "index": index}
+        rows.append(row)
+    if args.categories:
+        accepted = {c.casefold() for c in args.categories}
+        rows = [r for r in rows if r["category"].casefold() in accepted]
+    if args.start:
+        rows = [r for r in rows if r["day"] >= args.start]
+    if args.end:
+        rows = [r for r in rows if r["day"] <= args.end]
+    if args.min is not None:
+        rows = [r for r in rows if r["value"] >= args.min]
+    if args.top is not None:
+        rows = sorted(rows, key=lambda r: -r["value"])[:max(0, args.top)]
+    else:
+        rows.sort(key=lambda r: r["day"])
+    grouped = None
+    if args.by:
+        groups = {}
+        for r in rows:
+            key = r["category"].title() if args.by == "category" else r["day"].strftime("%Y-%m")
+            count, total = groups.get(key, (0, Decimal(0)))
+            groups[key] = count + 1, total + r["value"]
+        grouped = [(key, count, total) for key, (count, total) in groups.items()]
+        grouped.sort(key=(lambda x: (-x[2], x[0].casefold())) if args.by == "category" else (lambda x: x[0]))
+    if not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        if grouped is None:
+            result = [{"date": r["date"], "category": r["category"], "amount": float(r["value"]), "note": r["note"]} for r in rows]
+        else:
+            result = [{"group": k, "count": n, "total": float(v)} for k, n, v in grouped]
+        print(json.dumps(result, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        for r in rows:
+            writer.writerow([r["date"], r["category"], f"{r['value']:.2f}", r["note"]])
+    else:
+        print(_table(rows, grouped, args), end="")
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
