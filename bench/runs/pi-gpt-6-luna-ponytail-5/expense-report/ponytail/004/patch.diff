+"""Print filtered expense reports."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        self.print_usage(sys.stderr)
+        self.exit(2, f"error: {message}\n")
+
+
+def _parser():
+    parser = Parser(prog="python -m app.report", description="Report expenses from a CSV file.")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="start")
+    parser.add_argument("--to", dest="end")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by category"
+    return parser
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (ValueError, TypeError):
+        raise ValueError(value)
+
+
+def _money(value):
+    try:
+        number = Decimal(value)
+        if not number.is_finite():
+            raise InvalidOperation
+        return number
+    except (InvalidOperation, ValueError, TypeError):
+        return None
+
+
+def _table(headers, rows, total, currency, no_header, amount_column):
+    rows = [[str(value) for value in row] for row in rows]
+    if amount_column is not None:
+        for row in rows:
+            value = Decimal(row[amount_column])
+            row[amount_column] = f"({currency}{abs(value):,.2f})" if value < 0 else f"{currency}{value:,.2f}"
+    widths = [max(len(h), *(len(row[i]) for row in rows)) for i, h in enumerate(headers)]
+    lines = []
+    if not no_header:
+        lines += ["  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)),
+                  "  ".join("-" * w for w in widths)]
+    for row in rows:
+        lines.append("  ".join(row[i].rjust(widths[i]) if i == amount_column else row[i].ljust(widths[i]) for i in range(len(headers))))
+    lines.append(f"Total{' ' * max(1, sum(widths) + 2 * (len(widths) - 1) - len('Total') - len(currency + format(total, ',.2f')))}{currency}{total:,.2f}")
+    return "\n".join(lines) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    try:
+        start = _date(args.start) if args.start else None
+        end = _date(args.end) if args.end else None
+    except ValueError as exc:
+        print(f"error: invalid date: {exc}", file=sys.stderr)
+        return 2
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    minimum = _money(args.minimum) if args.minimum is not None else None
+    if args.minimum is not None and minimum is None:
+        print(f"error: invalid amount: {args.minimum}", file=sys.stderr)
+        return 2
+    try:
+        raw_rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    rows, skipped = [], 0
+    for index, row in enumerate(raw_rows):
+        amount = _money(row.get("amount"))
+        if amount is None:
+            skipped += 1
+            continue
+        try:
+            day = _date(row.get("date"))
+        except ValueError:
+            continue
+        if args.category and row.get("category", "").casefold() not in {c.casefold() for c in args.category}:
+            continue
+        if start and day < start or end and day > end or minimum is not None and amount < minimum:
+            continue
+        rows.append({"date": day, "category": row.get("category", ""), "amount": amount,
+                     "note": row.get("note", ""), "index": index})
+    total = sum((r["amount"] for r in rows), Decimal(0))
+    if args.by:
+        groups = {}
+        for row in rows:
+            key = row["category"].title() if args.by == "category" else row["date"].strftime("%Y-%m")
+            groups.setdefault(key, []).append(row["amount"])
+        if args.by == "category":
+            items = sorted(groups.items(), key=lambda item: (-sum(item[1]), item[0].casefold()))
+        else:
+            items = sorted(groups.items())
+        if args.format == "json":
+            print(json.dumps([{"group": k, "count": len(v), "total": float(sum(v))} for k, v in items], indent=2))
+        elif args.format == "csv":
+            writer = csv.writer(sys.stdout, lineterminator="\n")
+            writer.writerow([args.by, "count", "total"])
+            writer.writerows((k, len(v), f"{sum(v):.2f}") for k, v in items)
+        elif not items:
+            print("No expenses.")
+        else:
+            col = "Category" if args.by == "category" else "Month"
+            print(_table([col, "Count", "Total"], [[k, len(v), f"{sum(v):.2f}"] for k, v in items], total, args.currency, args.no_header, 2), end="")
+    else:
+        if args.top is not None:
+            rows = sorted(rows, key=lambda r: (-r["amount"], r["index"]))[:max(0, args.top)]
+            total = sum((r["amount"] for r in rows), Decimal(0))
+        else:
+            rows.sort(key=lambda r: r["date"])
+        if args.format == "json":
+            print(json.dumps([{"date": r["date"].isoformat(), "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in rows], indent=2))
+        elif args.format == "csv":
+            writer = csv.writer(sys.stdout, lineterminator="\n")
+            writer.writerow(["date", "category", "amount", "note"])
+            writer.writerows((r["date"].isoformat(), r["category"], f"{r['amount']:.2f}", r["note"]) for r in rows)
+        elif not rows:
+            print("No expenses.")
+        else:
+            rendered = [[r["date"].isoformat(), r["category"], f"{r['amount']:.2f}", r["note"][:23] + "…" if len(r["note"]) > 24 else r["note"]] for r in rows]
+            print(_table(["Date", "Category", "Amount", "Note"], rendered, total, args.currency, args.no_header, 2), end="")
+    if skipped:
+        print(f"warning: skipped {skipped} row{'s' if skipped != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
