+"""Render expense CSV files as reports."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", epilog="Example: python -m app.report expenses.csv --by month")
+    parser.add_argument("path", nargs="?")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="date_from")
+    parser.add_argument("--to", dest="date_to")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _error(message):
+    print(f"error: {message}", file=sys.stderr)
+    return 2
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    if args.path is None:
+        parser.error("the following arguments are required: PATH")
+    if args.format not in ("table", "json", "csv"):
+        return _error(f"unknown format: {args.format}")
+    try:
+        start = date.fromisoformat(args.date_from) if args.date_from else None
+        end = date.fromisoformat(args.date_to) if args.date_to else None
+    except ValueError:
+        value = args.date_from if args.date_from and (not args.date_to or _invalid_date(args.date_from)) else args.date_to
+        return _error(f"invalid date: {value}")
+    if start and end and start > end:
+        return _error("--from is after --to")
+    try:
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+        if minimum is not None and not minimum.is_finite():
+            raise InvalidOperation
+    except InvalidOperation:
+        return _error(f"invalid amount: {args.minimum}")
+    try:
+        rows = load(args.path)
+    except FileNotFoundError:
+        return _error(f"file not found: {args.path}")
+
+    valid = []
+    skipped = 0
+    for row in rows:
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, TypeError, KeyError):
+            skipped += 1
+            continue
+        valid.append((row, amount))
+    categories = {name.casefold() for name in args.category}
+    filtered = []
+    for index, (row, amount) in enumerate(valid):
+        try:
+            row_date = date.fromisoformat(row["date"])
+        except (ValueError, TypeError, KeyError):
+            continue
+        if categories and row.get("category", "").casefold() not in categories:
+            continue
+        if start and row_date < start or end and row_date > end:
+            continue
+        if minimum is not None and amount < minimum:
+            continue
+        filtered.append((row, amount, row_date, index))
+
+    if args.by:
+        groups = {}
+        for row, amount, row_date, _ in filtered:
+            key = row.get("category", "") if args.by == "category" else row_date.strftime("%Y-%m")
+            groups.setdefault(key, []).append(amount)
+        grouped = [(key, len(values), sum(values, Decimal(0))) for key, values in groups.items()]
+        if args.by == "category":
+            grouped.sort(key=lambda item: (-item[2], item[0].casefold()))
+        else:
+            grouped.sort(key=lambda item: item[0])
+        if not grouped:
+            print("No expenses.")
+        elif args.format == "json":
+            print(json.dumps([{"group": key, "count": count, "total": float(total)} for key, count, total in grouped], indent=2))
+        elif args.format == "csv":
+            writer = csv.writer(sys.stdout, lineterminator="\n")
+            writer.writerow(["group", "count", "total"])
+            writer.writerows((key, count, f"{total:.2f}") for key, count, total in grouped)
+        else:
+            heading = "Category" if args.by == "category" else "Month"
+            _print_table([heading, "Count", "Total"], [(key.title() if args.by == "category" else key, str(count), _money(total, args.currency)) for key, count, total in grouped], _money(sum((a for _, _, a in grouped), Decimal(0)), args.currency), args.no_header, amount_column=2)
+    else:
+        filtered.sort(key=lambda item: (item[2], item[3]))
+        if args.top is not None:
+            filtered = sorted(filtered, key=lambda item: (-item[1], item[3]))[:max(0, args.top)]
+        if not filtered:
+            print("No expenses.")
+        elif args.format == "json":
+            print(json.dumps([{"date": row["date"], "category": row["category"], "amount": float(amount), "note": row.get("note", "")} for row, amount, _, _ in filtered], indent=2))
+        elif args.format == "csv":
+            writer = csv.writer(sys.stdout, lineterminator="\n")
+            writer.writerow(["date", "category", "amount", "note"])
+            writer.writerows((row["date"], row["category"], f"{amount:.2f}", row.get("note", "")) for row, amount, _, _ in filtered)
+        else:
+            values = [(row["date"], row["category"], _money(amount, args.currency), _truncate(row.get("note", ""))) for row, amount, _, _ in filtered]
+            _print_table(["Date", "Category", "Amount", "Note"], values, _money(sum((a for _, a, _, _ in filtered), Decimal(0)), args.currency), args.no_header, amount_column=2)
+    if skipped:
+        print(f"warning: skipped {skipped} row{'s' if skipped != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _invalid_date(value):
+    try:
+        date.fromisoformat(value)
+        return False
+    except (ValueError, TypeError):
+        return True
+
+
+def _money(amount, currency=""):
+    rendered = f"{abs(amount):,.2f}"
+    return f"{currency}({rendered})" if amount < 0 else f"{currency}{rendered}"
+
+
+def _truncate(note):
+    return note if len(note) <= 24 else note[:23] + "…"
+
+
+def _print_table(headers, rows, total, no_header, amount_column):
+    rows = list(rows)
+    if amount_column is not None:
+        rows.append(tuple("Total" if i == 0 else (total if i == amount_column else "") for i in range(len(headers))))
+    widths = [max(len(header), *(len(row[i]) for row in rows)) for i, header in enumerate(headers)]
+    if amount_column is not None:
+        widths[amount_column] = max(widths[amount_column], len(headers[amount_column]))
+    if not no_header:
+        print("  ".join(header.ljust(widths[i]) for i, header in enumerate(headers)))
+        print("  ".join("-" * width for width in widths))
+    for row in rows:
+        print("  ".join(row[i].rjust(widths[i]) if i == amount_column else row[i].ljust(widths[i]) for i in range(len(headers))))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
