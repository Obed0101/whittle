+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Report expenses.", epilog="Example: python -m app.report expenses.csv --by month")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="start", type=_date)
+    parser.add_argument("--to", dest="end", type=_date)
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _table(headers, rows, amount_columns=()):
+    count = len(headers) if headers else (len(rows[0]) if rows else 0)
+    widths = [max(([len(str(headers[i]))] if headers else []) + [len(str(row[i])) for row in rows]) for i in range(count)]
+    lines = []
+    if headers:
+        lines.append("  ".join(str(h).ljust(widths[i]) for i, h in enumerate(headers)))
+        lines.append("  ".join("-" * widths[i] for i in range(len(headers))))
+    for row in rows:
+        lines.append("  ".join(str(value).rjust(widths[i]) if i in amount_columns else str(value).ljust(widths[i]) for i, value in enumerate(row)))
+    return lines
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    if args.start and args.end and args.start > args.end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+    except InvalidOperation:
+        parser.error("--min must be a number")
+    try:
+        expenses = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    valid, invalid = [], 0
+    for index, row in enumerate(expenses):
+        try:
+            amount = Decimal(row["amount"])
+            parsed_date = date.fromisoformat(row["date"])
+        except InvalidOperation:
+            invalid += 1
+            continue
+        except (ValueError, TypeError, KeyError):
+            print(f"error: invalid date: {row.get('date', '')}", file=sys.stderr)
+            return 2
+        valid.append((index, row, amount, parsed_date))
+
+    categories = {name.casefold() for name in args.category}
+    selected = [item for item in valid if
+                (not categories or item[1]["category"].casefold() in categories) and
+                (not args.start or item[3] >= args.start) and
+                (not args.end or item[3] <= args.end) and
+                (minimum is None or item[2] >= minimum)]
+
+    if args.by:
+        groups = {}
+        for _, row, amount, parsed_date in selected:
+            key = row["category"].title() if args.by == "category" else parsed_date.strftime("%Y-%m")
+            count, total = groups.get(key, (0, Decimal(0)))
+            groups[key] = count + 1, total + amount
+        grouped = list(groups.items())
+        if args.by == "category":
+            grouped.sort(key=lambda pair: (-pair[1][1], pair[0].casefold()))
+        else:
+            grouped.sort(key=lambda pair: pair[0])
+        if not grouped:
+            print("No expenses.")
+        elif args.format == "json":
+            print(json.dumps([{"group": k, "count": v[0], "total": float(v[1])} for k, v in grouped], indent=2))
+        else:
+            headers = ["Category" if args.by == "category" else "Month", "Count", "Total"]
+            rows = [[k, str(v[0]), f"{args.currency}{v[1]:,.2f}"] for k, v in grouped]
+            total = sum((v[1] for _, v in grouped), Decimal(0))
+            lines = _table(headers if not args.no_header else [], rows, (2,) if not args.no_header else ())
+            lines.append(f"Total  {args.currency}{total:,.2f}")
+            print("\n".join(lines))
+    else:
+        selected.sort(key=lambda item: (item[3], item[0]))
+        if args.top is not None:
+            selected = sorted(selected, key=lambda item: (-item[2], item[0]))[:max(0, args.top)]
+        if not selected:
+            print("No expenses.")
+        elif args.format == "json":
+            print(json.dumps([{"date": r["date"], "category": r["category"], "amount": float(a), "note": r["note"]} for _, r, a, _ in selected], indent=2))
+        elif args.format == "csv":
+            writer = csv.writer(sys.stdout, lineterminator="\n")
+            writer.writerow(["date", "category", "amount", "note"])
+            for _, row, amount, _ in selected:
+                writer.writerow([row["date"], row["category"], f"{amount:.2f}", row["note"]])
+        else:
+            headers = ["Date", "Category", "Amount", "Note"]
+            rows = []
+            for _, row, amount, _ in selected:
+                formatted = f"({abs(amount):,.2f})" if amount < 0 else f"{amount:,.2f}"
+                note = row["note"]
+                rows.append([row["date"], row["category"], args.currency + formatted, note[:23] + "…" if len(note) > 24 else note])
+            total = sum((item[2] for item in selected), Decimal(0))
+            lines = _table(headers if not args.no_header else [], rows, (2,) if not args.no_header else ())
+            lines.append(f"Total  {args.currency}{total:,.2f}")
+            print("\n".join(lines))
+    if invalid:
+        print(f"warning: skipped {invalid} row{'s' if invalid != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
