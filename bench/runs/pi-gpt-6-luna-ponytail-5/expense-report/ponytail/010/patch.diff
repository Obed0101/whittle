+"""Render expense CSV reports."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="start", type=_date)
+    parser.add_argument("--to", dest="end", type=_date)
+    parser.add_argument("--min", dest="minimum", type=Decimal)
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by category"
+    return parser
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as exc:
+        return int(exc.code)
+    if args.start and args.end and args.start > args.end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    valid, skipped = [], 0
+    for index, row in enumerate(rows):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, ValueError, TypeError, KeyError):
+            skipped += 1
+            continue
+        valid.append({**row, "_amount": amount, "_index": index})
+
+    cats = {name.casefold() for name in args.category}
+    filtered = []
+    for row in valid:
+        try:
+            row_date = date.fromisoformat(row["date"])
+        except (ValueError, TypeError, KeyError):
+            print(f"error: invalid date: {row.get('date', '')}", file=sys.stderr)
+            return 2
+        if cats and row["category"].casefold() not in cats:
+            continue
+        if args.start and row_date < args.start or args.end and row_date > args.end:
+            continue
+        if args.minimum is not None and row["_amount"] < args.minimum:
+            continue
+        filtered.append((row, row_date))
+
+    if args.top is not None:
+        filtered = sorted(filtered, key=lambda item: item[0]["_amount"], reverse=True)[:max(0, args.top)]
+    if args.by:
+        groups = {}
+        for row, row_date in filtered:
+            key = row["category"] if args.by == "category" else row_date.strftime("%Y-%m")
+            groups.setdefault(key, []).append(row["_amount"])
+        grouped = [(key, len(values), sum(values, Decimal(0))) for key, values in groups.items()]
+        if args.by == "category":
+            grouped.sort(key=lambda item: (-item[2], item[0].casefold()))
+        else:
+            grouped.sort(key=lambda item: item[0])
+    else:
+        filtered.sort(key=lambda item: item[1])
+
+    if not (grouped if args.by else filtered):
+        print("No expenses.")
+    elif args.format == "json":
+        if args.by:
+            output = [{"group": key, "count": count, "total": float(total)} for key, count, total in grouped]
+        else:
+            output = [{"date": row["date"], "category": row["category"], "amount": float(row["_amount"]), "note": row["note"]} for row, _ in filtered]
+        print(json.dumps(output, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(("date", "category", "amount", "note"))
+        for row, _ in filtered:
+            writer.writerow((row["date"], row["category"], f'{row["_amount"]:.2f}', row["note"]))
+    elif args.by:
+        headers = ("Category" if args.by == "category" else "Month", "Count", "Total")
+        records = [(key.title() if args.by == "category" else key, str(count), args.currency + _money(total)) for key, count, total in grouped]
+        _table(headers, records, args.no_header)
+        print(f"Total {args.currency}{_money(sum((r[2] for r in grouped), Decimal(0)))}")
+    else:
+        records = [(row["date"], row["category"], _money(row["_amount"], args.currency), row["note"][:23] + "…" if len(row["note"]) > 24 else row["note"]) for row, _ in filtered]
+        _table(("Date", "Category", "Amount", "Note"), records, args.no_header, right=(2,))
+        print("Total " + args.currency + _money(sum((row["_amount"] for row, _ in filtered), Decimal(0))))
+    if skipped:
+        print(f"warning: skipped {skipped} row{'s' if skipped != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _money(amount, currency=""):
+    if amount < 0:
+        return f"({currency}{abs(amount):,.2f})"
+    return f"{currency}{amount:,.2f}"
+
+
+def _table(headers, records, no_header=False, right=()):
+    widths = [max(len(str(headers[i])), *(len(record[i]) for record in records)) for i in range(len(headers))]
+    if not no_header:
+        print("  ".join(str(value).ljust(widths[i]) for i, value in enumerate(headers)))
+        print("  ".join("-" * width for width in widths))
+    for record in records:
+        print("  ".join(str(value).rjust(widths[i]) if i in right else str(value).ljust(widths[i]) for i, value in enumerate(record)))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
