+++ b/app/report.py
@@ -0,0 +1,152 @@
+"""Print expense reports from CSV files."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(description="Report expenses from a CSV file.")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="date_from")
+    parser.add_argument("--to", dest="date_to")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by category"
+    return parser
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (ValueError, TypeError):
+        raise ValueError(value)
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as exc:
+        return int(exc.code)
+
+    try:
+        start = _date(args.date_from) if args.date_from else None
+        end = _date(args.date_to) if args.date_to else None
+    except ValueError as exc:
+        print(f"error: invalid date: {exc.args[0]}", file=sys.stderr)
+        return 2
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    parsed = []
+    invalid = 0
+    for index, row in enumerate(rows):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, TypeError, KeyError):
+            invalid += 1
+            continue
+        try:
+            day = _date(row["date"])
+        except (ValueError, TypeError, KeyError):
+            day = None
+        parsed.append((index, row, amount, day))
+
+    categories = {name.casefold() for name in args.category}
+    selected = [(i, r, a, d) for i, r, a, d in parsed
+                if (not categories or r.get("category", "").casefold() in categories)
+                and (start is None or (d is not None and d >= start))
+                and (end is None or (d is not None and d <= end))
+                and (args.minimum is None or a >= Decimal(args.minimum))]
+    if args.by:
+        groups = {}
+        for _, row, amount, day in selected:
+            key = row.get("category", "") if args.by == "category" else (day.strftime("%Y-%m") if day else "")
+            groups.setdefault(key, []).append(amount)
+        grouped = [(key, len(vals), sum(vals, Decimal(0))) for key, vals in groups.items()]
+        if args.by == "category":
+            grouped.sort(key=lambda x: (-x[2], x[0].casefold()))
+        else:
+            grouped.sort(key=lambda x: x[0])
+    else:
+        selected.sort(key=lambda item: (item[3] is None, item[3] or date.min, item[0]))
+        if args.top is not None:
+            selected = sorted(selected, key=lambda item: (-item[2], item[0]))[:max(0, args.top)]
+        else:
+            selected = sorted(selected, key=lambda item: (item[3] is None, item[3] or date.min, item[0]))
+        grouped = None
+
+    if args.format == "json":
+        if grouped is None:
+            output = [{"date": r.get("date", ""), "category": r.get("category", ""), "amount": float(a), "note": r.get("note", "")} for _, r, a, _ in selected]
+        else:
+            output = [{"group": k, "count": count, "total": float(total)} for k, count, total in grouped]
+        print(json.dumps(output, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(("date", "category", "amount", "note"))
+        for _, row, amount, _ in selected:
+            writer.writerow((row.get("date", ""), row.get("category", ""), f"{amount:.2f}", row.get("note", "")))
+    elif grouped is None:
+        if not selected:
+            print("No expenses.")
+        else:
+            headers = ("Date", "Category", "Amount", "Note")
+            body = [(r.get("date", ""), r.get("category", ""), _money(a), (r.get("note", "")[:23] + "…") if len(r.get("note", "")) > 24 else r.get("note", "")) for _, r, a, _ in selected]
+            widths = [max(len(headers[n]), *(len(row[n]) for row in body)) for n in range(4)]
+            widths[2] = max(widths[2], *(len(args.currency + (f"({_money(a)[1:]})" if a < 0 else _money(a))) for _, _, a, _ in selected))
+            if not args.no_header:
+                print("  ".join(headers[n].ljust(widths[n]) if n != 2 else headers[n].rjust(widths[n]) for n in range(4)))
+                print("  ".join("-" * w for w in widths))
+            for row, (_, _, amount, _) in zip(body, selected):
+                value = f"({_money(amount)[1:]})" if amount < 0 else _money(amount)
+                row = (*row[:2], args.currency + value, row[3])
+                print("  ".join(row[n].ljust(widths[n]) if n != 2 else row[n].rjust(widths[n]) for n in range(4)))
+            total = sum((a for _, _, a, _ in selected), Decimal(0))
+            print(f"Total{' ' * max(1, sum(widths) + 6 - len('Total') - len(args.currency + _money(total)))}{args.currency}{_money(total)}")
+    else:
+        if not grouped:
+            print("No expenses.")
+        else:
+            first = "Category" if args.by == "category" else "Month"
+            headers = (first, "Count", "Total")
+            body = [(k.title() if args.by == "category" else k, str(count), _money(total)) for k, count, total in grouped]
+            widths = [max(len(headers[n]), *(len(row[n]) for row in body)) for n in range(3)]
+            if not args.no_header:
+                print("  ".join(headers[n].ljust(widths[n]) for n in range(3)))
+                print("  ".join("-" * w for w in widths))
+            for row in body:
+                print("  ".join(row[n].rjust(widths[n]) if n == 2 else row[n].ljust(widths[n]) for n in range(3)))
+            total = sum((x[2] for x in grouped), Decimal(0))
+            print(f"Total{' ' * max(1, sum(widths) + 4 - len('Total') - len(_money(total)))}{_money(total)}")
+
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
