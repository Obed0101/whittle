+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+import datetime
+import json
+import sys
+from decimal import Decimal, InvalidOperation
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="date_from")
+    parser.add_argument("--to", dest="date_to")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _date(value):
+    try:
+        return datetime.date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise ValueError(value)
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    try:
+        start = _date(args.date_from) if args.date_from else None
+        end = _date(args.date_to) if args.date_to else None
+        if start and end and start > end:
+            print("error: --from is after --to", file=sys.stderr)
+            return 2
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+    except (ValueError, InvalidOperation):
+        value = args.date_from if args.date_from and (not args.date_to or args.date_from != args.date_to) else args.date_to
+        if value and ((args.date_from and _invalid_date(args.date_from)) or (args.date_to and _invalid_date(args.date_to))):
+            print(f"error: invalid date: {args.date_from if _invalid_date(args.date_from) else args.date_to}", file=sys.stderr)
+        else:
+            print("error: invalid amount for --min", file=sys.stderr)
+        return 2
+    try:
+        rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    parsed = []
+    skipped = 0
+    for index, row in enumerate(rows):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, ValueError, KeyError):
+            skipped += 1
+            continue
+        try:
+            date = _date(row["date"])
+        except (ValueError, KeyError):
+            print(f"error: invalid date: {row.get('date', '')}", file=sys.stderr)
+            return 2
+        parsed.append({"date": date, "category": row["category"], "amount": amount, "note": row["note"], "index": index})
+
+    categories = {name.casefold() for name in args.category}
+    selected = [r for r in parsed if (not categories or r["category"].casefold() in categories)
+                and (start is None or r["date"] >= start) and (end is None or r["date"] <= end)
+                and (minimum is None or r["amount"] >= minimum)]
+    if args.top is not None:
+        selected = sorted(selected, key=lambda r: (-r["amount"], r["index"]))[:max(0, args.top)]
+    else:
+        selected.sort(key=lambda r: (r["date"], r["index"]))
+
+    if args.by:
+        groups = {}
+        for row in selected:
+            key = row["category"].title() if args.by == "category" else row["date"].strftime("%Y-%m")
+            groups.setdefault(key, []).append(row["amount"])
+        grouped = [(key, values) for key, values in groups.items()]
+        if args.by == "category":
+            grouped.sort(key=lambda pair: (-sum(pair[1]), pair[0]))
+        else:
+            grouped.sort(key=lambda pair: pair[0])
+        total = sum((r["amount"] for r in selected), Decimal(0))
+        if not grouped:
+            print("No expenses.")
+        elif args.format == "json":
+            print(json.dumps([{"group": key, "count": len(vals), "total": float(sum(vals))} for key, vals in grouped], indent=2))
+        elif args.format == "csv":
+            writer = csv.writer(sys.stdout, lineterminator="\n")
+            writer.writerow(["group", "count", "total"])
+            writer.writerows((key, len(vals), f"{sum(vals):.2f}") for key, vals in grouped)
+        else:
+            first = "Category" if args.by == "category" else "Month"
+            lines = []
+            if not args.no_header:
+                lines += [f"{first:<16}  {'Count':>5}  {'Total':>12}", "-" * 38]
+            lines += [f"{key:<16}  {len(vals):>5}  {args.currency}{_money(sum(vals)):>12}" for key, vals in grouped]
+            lines.append(f"{'Total':<16}  {'':>5}  {args.currency}{_money(total):>12}")
+            print("\n".join(lines))
+    elif not selected:
+        print("No expenses.")
+    elif args.format == "json":
+        print(json.dumps([{ "date": r["date"].isoformat(), "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in selected], indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        writer.writerows((r["date"].isoformat(), r["category"], f"{r['amount']:.2f}", r["note"]) for r in selected)
+    else:
+        date_w = max(4, *(len(r["date"].isoformat()) for r in selected))
+        cat_w = max(8, *(len(r["category"]) for r in selected))
+        note_w = 24
+        amount_w = max(6, *(len(_money(r["amount"])) + (1 if r["amount"] < 0 else 0) for r in selected))
+        lines = []
+        if not args.no_header:
+            lines += [f"{'Date':<{date_w}}  {'Category':<{cat_w}}  {'Amount':>{amount_w}}  Note", "-" * (date_w + cat_w + amount_w + note_w + 6)]
+        for r in selected:
+            amount = f"({ _money(abs(r['amount'])) })" if r["amount"] < 0 else _money(r["amount"])
+            note = r["note"] if len(r["note"]) <= note_w else r["note"][:23] + "…"
+            lines.append(f"{r['date'].isoformat():<{date_w}}  {r['category']:<{cat_w}}  {args.currency + amount:>{amount_w}}  {note}")
+        total = sum((r["amount"] for r in selected), Decimal(0))
+        final_amount = f"({ _money(abs(total)) })" if total < 0 else _money(total)
+        lines.append(f"{'Total':<{date_w}}  {'':<{cat_w}}  {args.currency + final_amount:>{amount_w}}")
+        print("\n".join(lines))
+
+    if skipped:
+        noun = "row" if skipped == 1 else "rows"
+        print(f"warning: skipped {skipped} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _invalid_date(value):
+    try:
+        _date(value)
+        return False
+    except ValueError:
+        return True
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
