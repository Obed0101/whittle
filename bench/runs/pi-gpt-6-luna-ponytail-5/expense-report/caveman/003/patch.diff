+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+import json
+import sys
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+from .expenses import load
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise argparse.ArgumentTypeError(f"error: invalid date: {value}")
+
+
+def _money(value, currency=""):
+    amount = Decimal(value)
+    if amount < 0:
+        return f"({currency}{abs(amount):,.2f})"
+    return f"{currency}{amount:,.2f}"
+
+
+def _table(headers, rows, amount_columns=()):
+    widths = [max(len(str(headers[i])), *(len(str(row[i])) for row in rows)) for i in range(len(headers))]
+    lines = []
+    lines.append("  ".join(str(v).ljust(widths[i]) for i, v in enumerate(headers)).rstrip())
+    lines.append("  ".join("-" * width for width in widths).rstrip())
+    for row in rows:
+        lines.append("  ".join((str(value).rjust(widths[i]) if i in amount_columns else str(value).ljust(widths[i])) for i, value in enumerate(row)).rstrip())
+    return lines
+
+
+def main(argv: list[str]) -> int:
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Create an expense report.")
+    parser.add_argument("path", nargs="?")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="date_from", type=_date)
+    parser.add_argument("--to", dest="date_to", type=_date)
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    args = parser.parse_args(argv)
+    if not args.path:
+        parser.error("the following arguments are required: PATH")
+    if args.date_from and args.date_to and args.date_from > args.date_to:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+    except InvalidOperation:
+        parser.error("--min must be a number")
+    if args.top is not None and args.top < 0:
+        parser.error("--top must be non-negative")
+    try:
+        raw = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    expenses, invalid = [], 0
+    for index, row in enumerate(raw):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, KeyError, TypeError):
+            invalid += 1
+            continue
+        entry = dict(row)
+        entry["amount"] = amount
+        entry["_index"] = index
+        expenses.append(entry)
+
+    if args.category:
+        categories = {name.casefold() for name in args.category}
+        expenses = [r for r in expenses if r.get("category", "").casefold() in categories]
+    if args.date_from:
+        expenses = [r for r in expenses if date.fromisoformat(r["date"]) >= args.date_from]
+    if args.date_to:
+        expenses = [r for r in expenses if date.fromisoformat(r["date"]) <= args.date_to]
+    if minimum is not None:
+        expenses = [r for r in expenses if r["amount"] >= minimum]
+    expenses.sort(key=lambda r: (r["date"], r["_index"]))
+    if args.top is not None:
+        expenses = sorted(expenses, key=lambda r: r["amount"], reverse=True)[:args.top]
+
+    if not expenses:
+        print("No expenses.")
+    elif args.by:
+        groups = {}
+        for row in expenses:
+            key = row["category"].title() if args.by == "category" else row["date"][:7]
+            count, total = groups.get(key, (0, Decimal(0)))
+            groups[key] = count + 1, total + row["amount"]
+        grouped = [(key, count, total) for key, (count, total) in groups.items()]
+        if args.by == "category":
+            grouped.sort(key=lambda item: (-item[2], item[0].casefold()))
+        else:
+            grouped.sort(key=lambda item: item[0])
+        if args.format == "json":
+            print(json.dumps([{"group": key, "count": count, "total": float(total)} for key, count, total in grouped], indent=2))
+        else:
+            header = "Category" if args.by == "category" else "Month"
+            rows = [(key, str(count), _money(total, args.currency)) for key, count, total in grouped]
+            rows.append(("Total", str(len(expenses)), _money(sum((r["amount"] for r in expenses), Decimal(0)), args.currency)))
+            lines = _table((header, "Count", "Total"), rows, (1, 2))
+            print("\n".join(lines[2:] if args.no_header else lines))
+    elif args.format == "json":
+        print(json.dumps([{ "date": r["date"], "category": r["category"], "amount": float(r["amount"]), "note": r.get("note", "")} for r in expenses], indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(("date", "category", "amount", "note"))
+        for r in expenses:
+            writer.writerow((r["date"], r["category"], f"{r['amount']:.2f}", r.get("note", "")))
+    else:
+        rows = [(r["date"], r["category"], _money(r["amount"], args.currency), r.get("note", "")[:23] + ("…" if len(r.get("note", "")) > 24 else "")) for r in expenses]
+        rows.append(("Total", "", _money(sum((r["amount"] for r in expenses), Decimal(0)), args.currency), ""))
+        lines = _table(("Date", "Category", "Amount", "Note"), rows, (2,))
+        print("\n".join(lines[2:] if args.no_header else lines))
+
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
