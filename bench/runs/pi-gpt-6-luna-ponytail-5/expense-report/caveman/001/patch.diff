+"""Print expense reports from CSV files."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from .expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        self.print_usage(sys.stderr)
+        self.exit(2, f"error: {message}\n")
+
+
+def _date(value):
+    try:
+        parsed = date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+    if parsed.isoformat() != value:
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+    return parsed
+
+
+def _parser():
+    p = Parser(prog="python -m app.report", usage="%(prog)s PATH [options]", epilog="Example: python -m app.report expenses.csv --by category")
+    p.add_argument("path")
+    p.add_argument("--category", action="append", dest="categories", help="keep category (repeatable)")
+    p.add_argument("--from", dest="date_from", type=_date, metavar="DATE", help="include dates from DATE")
+    p.add_argument("--to", dest="date_to", type=_date, metavar="DATE", help="include dates through DATE")
+    p.add_argument("--min", dest="minimum", metavar="AMOUNT", help="minimum amount")
+    p.add_argument("--by", choices=("category", "month"), help="group by category or month")
+    p.add_argument("--format", choices=("table", "json", "csv"), default="table", help="output format")
+    p.add_argument("--currency", default="", metavar="SYMBOL", help="table currency symbol")
+    p.add_argument("--top", type=int, metavar="N", help="show N largest expenses")
+    p.add_argument("--no-header", action="store_true", help="omit table header")
+    return p
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _table(rows, grouped, currency, no_header):
+    if grouped:
+        heading = "Category" if grouped == "category" else "Month"
+        records = [[r[0], str(r[1]), currency + _money(r[2])] for r in rows]
+        headers = [heading, "Count", "Total"]
+        total = sum((r[2] for r in rows), Decimal(0))
+        records.append(["Total", str(sum(r[1] for r in rows)), currency + _money(total)])
+    else:
+        records = []
+        for r in rows:
+            note = r["note"] or ""
+            if len(note) > 24:
+                note = note[:23] + "…"
+            amount = f"({currency}{_money(-r['amount'])})" if r["amount"] < 0 else currency + _money(r["amount"])
+            records.append([r["date"], r["category"], amount, note])
+        total = sum((r["amount"] for r in rows), Decimal(0))
+        records.append(["Total", "", currency + _money(total), ""])
+        headers = ["Date", "Category", "Amount", "Note"]
+    widths = [max(len(str(row[i])) for row in ([headers] if not no_header else []) + records) for i in range(len(headers))]
+    def line(values):
+        cells = []
+        for i, v in enumerate(values):
+            text = str(v)
+            cells.append(text.rjust(widths[i]) if (i == (2 if grouped else 2) and (grouped or not no_header)) else text.ljust(widths[i]))
+        return "  ".join(cells).rstrip()
+    out = []
+    if not no_header:
+        out.extend([line(headers), "  ".join("-" * w for w in widths)])
+    out.extend(line(r) for r in records)
+    return "\n".join(out) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    p = _parser()
+    args = p.parse_args(argv)
+    if args.date_from and args.date_to and args.date_from > args.date_to:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        raw_rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    valid, skipped = [], 0
+    for row in raw_rows:
+        try:
+            amount = Decimal(row.get("amount", ""))
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, TypeError, ValueError):
+            skipped += 1
+            continue
+        try:
+            row_date = _date(row.get("date", ""))
+        except argparse.ArgumentTypeError:
+            print(f"error: invalid date: {row.get('date', '')}", file=sys.stderr)
+            return 2
+        valid.append({**row, "_date": row_date, "amount": amount})
+    selected = valid
+    if args.categories:
+        names = {n.casefold() for n in args.categories}
+        selected = [r for r in selected if (r.get("category") or "").casefold() in names]
+    if args.date_from:
+        selected = [r for r in selected if r["_date"] >= args.date_from]
+    if args.date_to:
+        selected = [r for r in selected if r["_date"] <= args.date_to]
+    if args.minimum is not None:
+        try:
+            minimum = Decimal(args.minimum)
+            if not minimum.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, ValueError):
+            p.error("--min must be a number")
+        selected = [r for r in selected if r["amount"] >= minimum]
+    if args.top is not None and not args.by:
+        selected = sorted(selected, key=lambda r: -r["amount"])[:max(0, args.top)]
+    elif not args.by:
+        selected = sorted(selected, key=lambda r: r["_date"])
+    if not selected:
+        print("No expenses.")
+    elif args.by:
+        groups = {}
+        for r in selected:
+            key = r["category"].title() if args.by == "category" else r["_date"].strftime("%Y-%m")
+            if key not in groups:
+                groups[key] = [0, Decimal(0)]
+            groups[key][0] += 1
+            groups[key][1] += r["amount"]
+        result = [(k, v[0], v[1]) for k, v in groups.items()]
+        if args.by == "category":
+            result.sort(key=lambda x: (-x[2], x[0].casefold()))
+        else:
+            result.sort(key=lambda x: x[0])
+        if args.format == "json":
+            print(json.dumps([{"group": k, "count": n, "total": float(t)} for k, n, t in result], indent=2))
+        elif args.format == "csv":
+            w = csv.writer(sys.stdout, lineterminator="\n")
+            w.writerow(["group", "count", "total"])
+            w.writerows((k, n, f"{t:.2f}") for k, n, t in result)
+        else:
+            print(_table(result, args.by, args.currency, args.no_header), end="")
+    elif args.format == "json":
+        print(json.dumps([{"date": r["date"], "category": r["category"], "amount": float(r["amount"]), "note": r.get("note", "")} for r in selected], indent=2))
+    elif args.format == "csv":
+        w = csv.writer(sys.stdout, lineterminator="\n")
+        w.writerow(["date", "category", "amount", "note"])
+        w.writerows((r["date"], r["category"], f"{r['amount']:.2f}", r.get("note", "")) for r in selected)
+    else:
+        print(_table(selected, None, args.currency, args.no_header), end="")
+    if skipped:
+        noun = "row" if skipped == 1 else "rows"
+        print(f"warning: skipped {skipped} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
