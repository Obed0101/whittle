diff --git a/app/report.py b/app/report.py
new file mode 100644
index 0000000..b75a586
--- /dev/null
+++ b/app/report.py
@@ -0,0 +1,149 @@
+"""Render expense CSV files as reports."""
+import argparse
+import csv
+import json
+import sys
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="from_date")
+    parser.add_argument("--to", dest="to_date")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _date(value):
+    try:
+        parsed = date.fromisoformat(value)
+        if parsed.isoformat() != value:
+            raise ValueError
+        return parsed
+    except (TypeError, ValueError):
+        raise ValueError(value)
+
+
+def _money(value):
+    return format(value, ",.2f")
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    try:
+        start = _date(args.from_date) if args.from_date else None
+        end = _date(args.to_date) if args.to_date else None
+    except ValueError as exc:
+        print(f"error: invalid date: {exc}", file=sys.stderr)
+        return 2
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    valid = []
+    skipped = 0
+    for index, row in enumerate(rows):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+            row_date = _date(row["date"])
+        except (InvalidOperation, ValueError, KeyError):
+            # Invalid dates are reported, while invalid amounts are skipped.
+            try:
+                Decimal(row["amount"])
+            except (InvalidOperation, ValueError, KeyError):
+                skipped += 1
+                continue
+            print(f"error: invalid date: {row.get('date', '')}", file=sys.stderr)
+            return 2
+        row = dict(row)
+        row["_amount"] = amount
+        row["_date"] = row_date
+        row["_index"] = index
+        valid.append(row)
+
+    categories = {name.casefold() for name in args.category}
+    selected = [r for r in valid
+                if (not categories or r["category"].casefold() in categories)
+                and (start is None or r["_date"] >= start)
+                and (end is None or r["_date"] <= end)
+                and (args.minimum is None or r["_amount"] >= Decimal(args.minimum))]
+    selected.sort(key=lambda r: (r["_date"], r["_index"]))
+    if args.top is not None:
+        selected = sorted(selected, key=lambda r: (-r["_amount"], r["_index"]))[:max(0, args.top)]
+
+    if args.by:
+        groups = {}
+        for row in selected:
+            key = row["category"] if args.by == "category" else row["_date"].strftime("%Y-%m")
+            count, total = groups.get(key, (0, Decimal(0)))
+            groups[key] = count + 1, total + row["_amount"]
+        grouped = [(key, count, total) for key, (count, total) in groups.items()]
+        if args.by == "category":
+            grouped.sort(key=lambda x: (-x[2], x[0].casefold()))
+        else:
+            grouped.sort(key=lambda x: x[0])
+        if not grouped:
+            print("No expenses.")
+        elif args.format == "json":
+            print(json.dumps([{"group": key, "count": count, "total": float(total)} for key, count, total in grouped], indent=2))
+        elif args.format == "csv":
+            writer = csv.writer(sys.stdout, lineterminator="\n")
+            writer.writerow(["group", "count", "total"])
+            writer.writerows((key, count, f"{total:.2f}") for key, count, total in grouped)
+        else:
+            label = "Category" if args.by == "category" else "Month"
+            display = [(key.title() if args.by == "category" else key, str(count), _money(total)) for key, count, total in grouped]
+            headers = [label, "Count", "Total"]
+            widths = [max(len(headers[i]), *(len(row[i]) for row in display)) for i in range(3)]
+            if not args.no_header:
+                print("  ".join(headers[i].ljust(widths[i]) for i in range(3)).rstrip())
+                print("  ".join("-" * widths[i] for i in range(3)))
+            for row in display:
+                print("  ".join(row[i].ljust(widths[i]) for i in range(3)).rstrip())
+            print(f"Total  {len(selected)}  {_money(sum((r['_amount'] for r in selected), Decimal(0)))}")
+    elif not selected:
+        print("No expenses.")
+    elif args.format == "json":
+        print(json.dumps([{ "date": r["date"], "category": r["category"], "amount": float(r["_amount"]), "note": r["note"]} for r in selected], indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        writer.writerows((r["date"], r["category"], f"{r['_amount']:.2f}", r["note"]) for r in selected)
+    else:
+        display = [(r["date"], r["category"], (f"({args.currency}{_money(-r['_amount'])})" if r["_amount"] < 0 else f"{args.currency}{_money(r['_amount'])}"), r["note"][:23] + "…" if len(r["note"]) > 24 else r["note"]) for r in selected]
+        headers = ["Date", "Category", "Amount", "Note"]
+        widths = [max(len(headers[i]), *(len(row[i]) for row in display)) for i in range(4)]
+        if not args.no_header:
+            print("  ".join(headers[i].ljust(widths[i]) for i in range(4)).rstrip())
+            print("  ".join("-" * widths[i] for i in range(4)))
+        for row in display:
+            print("  ".join(row[i].rjust(widths[i]) if i == 2 else row[i].ljust(widths[i]) for i in range(4)).rstrip())
+        total = sum((r["_amount"] for r in selected), Decimal(0))
+        print(f"Total  {_money(total)}")
+
+    if skipped:
+        noun = "row" if skipped == 1 else "rows"
+        print(f"warning: skipped {skipped} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
