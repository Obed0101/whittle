+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="date_from")
+    parser.add_argument("--to", dest="date_to")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by category"
+    return parser
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise ValueError(value)
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _table(headers, rows, total, right_columns=(), no_header=False):
+    widths = [max(len(str(headers[i])), *(len(str(row[i])) for row in rows)) for i in range(len(headers))]
+    lines = [] if no_header else ["  ".join(str(v).ljust(widths[i]) for i, v in enumerate(headers)),
+                                  "  ".join("-" * width for width in widths)]
+    for row in rows:
+        lines.append("  ".join(str(v).rjust(widths[i]) if i in right_columns else str(v).ljust(widths[i])
+                               for i, v in enumerate(row)))
+    lines.append(f"Total  {_money(total)}")
+    return "\n".join(lines) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    try:
+        lower = _date(args.date_from) if args.date_from else None
+        upper = _date(args.date_to) if args.date_to else None
+        if lower and upper and lower > upper:
+            print("error: --from is after --to", file=sys.stderr)
+            return 2
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+        if args.top is not None and args.top < 0:
+            parser.error("--top must be non-negative")
+        expenses = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except (ValueError, InvalidOperation) as exc:
+        value = str(exc) or ""
+        if args.minimum is not None and value == args.minimum:
+            print(f"error: invalid amount: {value}", file=sys.stderr)
+        else:
+            print(f"error: invalid date: {value}", file=sys.stderr)
+        return 2
+
+    valid = []
+    bad_amounts = 0
+    for row in expenses:
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, TypeError, KeyError):
+            bad_amounts += 1
+            continue
+        try:
+            day = _date(row.get("date"))
+        except ValueError as exc:
+            print(f"error: invalid date: {exc}", file=sys.stderr)
+            return 2
+        valid.append({**row, "_amount": amount, "_day": day})
+
+    categories = {name.casefold() for name in args.category}
+    selected = [r for r in valid if
+                (not categories or r.get("category", "").casefold() in categories) and
+                (lower is None or r["_day"] >= lower) and
+                (upper is None or r["_day"] <= upper) and
+                (minimum is None or r["_amount"] >= minimum)]
+    selected.sort(key=lambda r: r["_day"])
+    if args.top is not None:
+        selected = sorted(selected, key=lambda r: r["_amount"], reverse=True)[:args.top]
+
+    if args.by:
+        groups = {}
+        for row in selected:
+            key = row["category"].title() if args.by == "category" else row["_day"].strftime("%Y-%m")
+            groups.setdefault(key, []).append(row)
+        items = [(key, len(rows), sum((r["_amount"] for r in rows), Decimal(0))) for key, rows in groups.items()]
+        if args.by == "category":
+            items.sort(key=lambda x: (-x[2], x[0].casefold()))
+        else:
+            items.sort(key=lambda x: x[0])
+        total = sum((item[2] for item in items), Decimal(0))
+        if not items:
+            print("No expenses.")
+        elif args.format == "json":
+            print(json.dumps([{"group": k, "count": n, "total": float(v)} for k, n, v in items], indent=2))
+        elif args.format == "csv":
+            writer = csv.writer(sys.stdout, lineterminator="\n")
+            writer.writerow(["group", "count", "total"])
+            writer.writerows((k, n, f"{v:.2f}") for k, n, v in items)
+        else:
+            rows = [(k, str(n), args.currency + _money(v)) for k, n, v in items]
+            print(_table(["Category" if args.by == "category" else "Month", "Count", "Total"], rows, total, (1, 2), args.no_header), end="")
+    elif not selected:
+        print("No expenses.")
+    elif args.format == "json":
+        print(json.dumps([{"date": r["date"], "category": r["category"], "amount": float(r["_amount"]), "note": r["note"]} for r in selected], indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        writer.writerows((r["date"], r["category"], f"{r['_amount']:.2f}", r["note"]) for r in selected)
+    else:
+        rows = []
+        for r in selected:
+            amount = r["_amount"]
+            formatted = f"({args.currency}{_money(abs(amount))})" if amount < 0 else args.currency + _money(amount)
+            rows.append((r["date"], r["category"], formatted, r["note"] if len(r["note"]) <= 24 else r["note"][:23] + "…"))
+        total = sum((r["_amount"] for r in selected), Decimal(0))
+        print(_table(["Date", "Category", "Amount", "Note"], rows, total, (2,), args.no_header), end="")
+
+    if bad_amounts:
+        noun = "row" if bad_amounts == 1 else "rows"
+        print(f"warning: skipped {bad_amounts} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
