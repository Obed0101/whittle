+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        raise ValueError(message)
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise ValueError(f"error: invalid date: {value}")
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _table(rows, grouped, currency, no_header):
+    if grouped:
+        headers = ["Category" if grouped == "category" else "Month", "Count", "Total"]
+        data = [[g, str(n), _money(t)] for g, n, t in rows]
+        total = sum((r[2] for r in rows), Decimal(0))
+        data.append(["Total", "", _money(total)])
+        if grouped == "category":
+            data[:-1] = [[r[0].title(), r[1], r[2]] for r in data[:-1]]
+        numeric = {1, 2}
+    else:
+        headers = ["Date", "Category", "Amount", "Note"]
+        data = [[r["date"], r["category"], _money(r["amount"]), r["note"][:23] + "…" if len(r["note"]) > 24 else r["note"]] for r in rows]
+        data.append(["Total", "", _money(sum((r["amount"] for r in rows), Decimal(0))), ""])
+        numeric = {2}
+    for row in data:
+        i = 2
+        if row[i]:
+            val = row[i]
+            if val.startswith("-"):
+                row[i] = f"({currency}{val[1:]})"
+            elif currency:
+                row[i] = currency + val
+    widths = [max(len(str(x)) for x in [headers[i]] + [r[i] for r in data]) for i in range(len(headers))]
+    lines = []
+    if not no_header:
+        lines.extend(["  ".join(headers[i].ljust(widths[i]) for i in range(len(headers))),
+                      "  ".join("-" * widths[i] for i in range(len(headers)))])
+    for row in data:
+        cells = []
+        for i, value in enumerate(row):
+            value = str(value)
+            cells.append(value.rjust(widths[i]) if i in numeric else value.ljust(widths[i]))
+        lines.append("  ".join(cells).rstrip())
+    return "\n".join(lines) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    parser = Parser(prog="python -m app.report", add_help=False)
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="from_date")
+    parser.add_argument("--to", dest="to_date")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=["category", "month"])
+    parser.add_argument("--format", default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    parser.add_argument("--help", action="help", help="show this help message and exit")
+    parser.epilog = "Example: python -m app.report expenses.csv --by category"
+    try:
+        args = parser.parse_args(argv)
+        if args.format not in ("table", "json", "csv"):
+            print(f"error: unknown format: {args.format}", file=sys.stderr)
+            return 2
+        start = _date(args.from_date) if args.from_date else None
+        end = _date(args.to_date) if args.to_date else None
+        if start and end and start > end:
+            print("error: --from is after --to", file=sys.stderr)
+            return 2
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+        raw = load(args.path)
+    except ValueError as exc:
+        msg = str(exc)
+        print(msg if msg.startswith("error:") else f"error: {msg}", file=sys.stderr)
+        return 2
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except SystemExit as exc:
+        return int(exc.code)
+
+    rows, invalid = [], 0
+    for row in raw:
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, TypeError, KeyError):
+            invalid += 1
+            continue
+        try:
+            d = _date(row["date"])
+        except (ValueError, KeyError):
+            print(f"error: invalid date: {row.get('date', '')}", file=sys.stderr)
+            return 2
+        if args.category and row["category"].casefold() not in {x.casefold() for x in args.category}:
+            continue
+        if start and d < start or end and d > end or minimum is not None and amount < minimum:
+            continue
+        rows.append({**row, "amount": amount, "_date": d})
+    rows.sort(key=lambda r: r["_date"])
+    if args.top is not None:
+        rows = sorted(rows, key=lambda r: r["amount"], reverse=True)[:max(0, args.top)]
+    if args.by:
+        groups = {}
+        for row in rows:
+            key = row["category"] if args.by == "category" else row["_date"].strftime("%Y-%m")
+            count, total = groups.get(key, (0, Decimal(0)))
+            groups[key] = (count + 1, total + row["amount"])
+        grouped = [(k, n, t) for k, (n, t) in groups.items()]
+        if args.by == "category":
+            grouped.sort(key=lambda x: (-x[2], x[0].casefold()))
+        else:
+            grouped.sort(key=lambda x: x[0])
+        if not grouped:
+            print("No expenses.")
+        elif args.format == "json":
+            print(json.dumps([{"group": k, "count": n, "total": float(t)} for k, n, t in grouped], indent=2))
+        elif args.format == "csv":
+            writer = csv.writer(sys.stdout, lineterminator="\n")
+            writer.writerow(["group", "count", "total"])
+            writer.writerows((k, n, f"{t:.2f}") for k, n, t in grouped)
+        else:
+            sys.stdout.write(_table(grouped, args.by, args.currency, args.no_header))
+    elif not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        print(json.dumps([{k: (float(r["amount"]) if k == "amount" else r[k]) for k in ("date", "category", "amount", "note")} for r in rows], indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        writer.writerows((r["date"], r["category"], f'{r["amount"]:.2f}', r["note"]) for r in rows)
+    else:
+        sys.stdout.write(_table(rows, None, args.currency, args.no_header))
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
