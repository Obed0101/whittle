+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+import json
+import os
+import sys
+from collections import defaultdict
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Print an expense report.",
+                                     epilog="Example: python -m app.report expenses.csv --by month")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[], metavar="NAME")
+    parser.add_argument("--from", dest="date_from", metavar="DATE")
+    parser.add_argument("--to", dest="date_to", metavar="DATE")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="", metavar="SYMBOL")
+    parser.add_argument("--top", type=int, metavar="N")
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise ValueError("invalid date: " + str(value))
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _table(rows, groups, currency, no_header):
+    if groups is not None:
+        heads = ["Category" if groups == "category" else "Month", "Count", "Total"]
+        data = [[g, str(n), currency + _money(t)] for g, n, t in rows]
+        total = sum((r[2] for r in rows), Decimal(0))
+        data.append(["Total", "", currency + _money(total)])
+    else:
+        heads = ["Date", "Category", "Amount", "Note"]
+        data = [[r["date"], r["category"], ("(" + currency + _money(-r["value"]) + ")") if r["value"] < 0 else currency + _money(r["value"]),
+                 r["note"] if len(r["note"]) <= 24 else r["note"][:23] + "…"] for r in rows]
+        total = sum((r["value"] for r in rows), Decimal(0))
+        data.append(["Total", "", currency + _money(total), ""])
+    widths = [max(len(str(heads[i])), *(len(str(row[i])) for row in data)) for i in range(len(heads))]
+    lines = []
+    if not no_header:
+        lines.append("  ".join(str(heads[i]).ljust(widths[i]) for i in range(len(heads))).rstrip())
+        lines.append("  ".join("-" * widths[i] for i in range(len(heads))).rstrip())
+    for row in data:
+        cells = []
+        for i, val in enumerate(row):
+            text = str(val)
+            cells.append(text.rjust(widths[i]) if (groups is not None and i == 2) or (groups is None and i == 2) else text.ljust(widths[i]))
+        lines.append("  ".join(cells).rstrip())
+    return "\n".join(lines) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as exc:
+        return int(exc.code)
+    try:
+        lower = _date(args.date_from) if args.date_from else None
+        upper = _date(args.date_to) if args.date_to else None
+        if lower and upper and lower > upper:
+            raise ValueError("--from is after --to")
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+    except (ValueError, InvalidOperation):
+        value = args.date_from if args.date_from and _date_safe(args.date_from) is None else args.date_to if args.date_to and _date_safe(args.date_to) is None else None
+        if value is not None:
+            print("error: invalid date: " + value, file=sys.stderr)
+        elif args.date_from and args.date_to and _date_safe(args.date_from) and _date_safe(args.date_to) and _date_safe(args.date_from) > _date_safe(args.date_to):
+            print("error: --from is after --to", file=sys.stderr)
+        else:
+            print("error: invalid amount: " + str(args.minimum), file=sys.stderr)
+        return 2
+    try:
+        raw = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    parsed = []
+    skipped = 0
+    for index, row in enumerate(raw):
+        try:
+            amount = Decimal(row.get("amount", ""))
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, TypeError, ValueError):
+            skipped += 1
+            continue
+        parsed.append((index, row, amount))
+    category_set = {x.casefold() for x in args.category}
+    selected = []
+    for index, row, amount in parsed:
+        try:
+            rowdate = _date(row.get("date", ""))
+        except ValueError as exc:
+            print("error: " + str(exc), file=sys.stderr)
+            return 2
+        if category_set and row.get("category", "").casefold() not in category_set:
+            continue
+        if lower and rowdate < lower or upper and rowdate > upper:
+            continue
+        if minimum is not None and amount < minimum:
+            continue
+        selected.append({**row, "value": amount, "_date": rowdate, "_index": index})
+    if args.top is not None:
+        selected = sorted(selected, key=lambda r: (-r["value"], r["_index"]))[:max(0, args.top)]
+    if args.by:
+        totals = defaultdict(lambda: [0, Decimal(0)])
+        for row in selected:
+            key = row["category"].title() if args.by == "category" else row["_date"].strftime("%Y-%m")
+            totals[key][0] += 1
+            totals[key][1] += row["value"]
+        grouped = [(key, val[0], val[1]) for key, val in totals.items()]
+        if args.by == "category":
+            grouped.sort(key=lambda x: (-x[2], x[0].casefold()))
+        else:
+            grouped.sort(key=lambda x: x[0])
+        if not grouped:
+            print("No expenses.")
+        elif args.format == "json":
+            print(json.dumps([{"group": g, "count": n, "total": float(t)} for g, n, t in grouped], indent=2))
+        elif args.format == "csv":
+            writer = csv.writer(sys.stdout, lineterminator="\n")
+            writer.writerow(["group", "count", "total"])
+            writer.writerows((g, n, f"{t:.2f}") for g, n, t in grouped)
+        else:
+            sys.stdout.write(_table(grouped, args.by, args.currency, args.no_header))
+    else:
+        selected.sort(key=lambda r: (r["_date"], r["_index"]))
+        if not selected:
+            print("No expenses.")
+        elif args.format == "json":
+            print(json.dumps([{k: (float(r["value"]) if k == "amount" else r.get(k, "")) for k in ("date", "category", "amount", "note")} for r in selected], indent=2))
+        elif args.format == "csv":
+            writer = csv.writer(sys.stdout, lineterminator="\n")
+            writer.writerow(["date", "category", "amount", "note"])
+            writer.writerows((r["date"], r["category"], f"{r['value']:.2f}", r["note"]) for r in selected)
+        else:
+            sys.stdout.write(_table(selected, None, args.currency, args.no_header))
+    if skipped:
+        print(f"warning: skipped {skipped} row{'s' if skipped != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _date_safe(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        return None
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
