+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+import json
+import sys
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        self.print_usage(sys.stderr)
+        self.exit(2, f"error: {message}\n")
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+
+
+def _amount(value):
+    try:
+        result = Decimal(value)
+        if not result.is_finite():
+            raise InvalidOperation
+        return result
+    except (InvalidOperation, TypeError):
+        raise argparse.ArgumentTypeError(f"invalid amount: {value}")
+
+
+def _money(value, currency=""):
+    value = Decimal(value)
+    if value < 0:
+        return f"({currency}{abs(value):,.2f})"
+    return f"{currency}{value:,.2f}"
+
+
+def _table(headers, rows, right=()):
+    widths = [len(str(x)) for x in headers]
+    for row in rows:
+        widths = [max(w, len(str(v))) for w, v in zip(widths, row)]
+    def line(row):
+        return "  ".join(str(v).rjust(widths[i]) if i in right else str(v).ljust(widths[i]) for i, v in enumerate(row)).rstrip()
+    return [line(headers), line(["-" * w for w in widths])] + [line(r) for r in rows]
+
+
+def main(argv: list[str]) -> int:
+    parser = Parser(prog="python -m app.report", description="Create an expense report.")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="start", type=_date)
+    parser.add_argument("--to", dest="end", type=_date)
+    parser.add_argument("--min", dest="minimum", type=_amount)
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by category"
+    args = parser.parse_args(argv)
+    if args.top is not None and args.top < 0:
+        parser.error("--top must be non-negative")
+    if args.start and args.end and args.start > args.end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        raw_rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    rows, invalid = [], 0
+    for index, raw in enumerate(raw_rows):
+        try:
+            amount = Decimal(raw["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, TypeError, KeyError):
+            invalid += 1
+            continue
+        try:
+            day = date.fromisoformat(raw["date"])
+        except (TypeError, ValueError, KeyError):
+            print(f"error: invalid date: {raw.get('date', '')}", file=sys.stderr)
+            return 2
+        rows.append({"date": day.isoformat(), "_day": day, "category": raw.get("category", ""), "amount": amount, "note": raw.get("note", ""), "_index": index})
+    categories = {x.casefold() for x in args.category}
+    rows = [r for r in rows if (not categories or r["category"].casefold() in categories)
+            and (args.start is None or r["_day"] >= args.start)
+            and (args.end is None or r["_day"] <= args.end)
+            and (args.minimum is None or r["amount"] >= args.minimum)]
+    rows.sort(key=lambda r: (r["_day"], r["_index"]))
+    if args.top is not None and not args.by:
+        rows = sorted(rows, key=lambda r: r["amount"], reverse=True)[:args.top]
+    if args.by:
+        groups = {}
+        for r in rows:
+            key = r["category"] if args.by == "category" else r["_day"].strftime("%Y-%m")
+            groups.setdefault(key, []).append(r)
+        grouped = [(key, len(items), sum((r["amount"] for r in items), Decimal(0))) for key, items in groups.items()]
+        if args.by == "category":
+            grouped.sort(key=lambda x: (-x[2], x[0].casefold()))
+        else:
+            grouped.sort(key=lambda x: x[0])
+        total = sum((x[2] for x in grouped), Decimal(0))
+        if args.format == "json":
+            output = json.dumps([{"group": k, "count": n, "total": float(v)} for k, n, v in grouped], indent=2)
+        elif args.format == "csv":
+            import io
+            buf = io.StringIO(newline="")
+            writer = csv.writer(buf)
+            writer.writerow(["group", "count", "total"])
+            writer.writerows((k, n, f"{v:.2f}") for k, n, v in grouped)
+            output = buf.getvalue().rstrip("\n")
+        else:
+            label = "Category" if args.by == "category" else "Month"
+            rendered = [(k.title() if args.by == "category" else k, str(n), _money(v, args.currency)) for k, n, v in grouped]
+            lines = _table([label, "Count", "Total"], rendered, right=(1, 2))
+            if args.no_header:
+                lines = lines[2:]
+            lines.append(f"Total  {_money(total, args.currency)}")
+            output = "\n".join(lines)
+    else:
+        total = sum((r["amount"] for r in rows), Decimal(0))
+        if args.format == "json":
+            output = json.dumps([{"date": r["date"], "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in rows], indent=2)
+        elif args.format == "csv":
+            import io
+            buf = io.StringIO(newline="")
+            writer = csv.writer(buf)
+            writer.writerow(["date", "category", "amount", "note"])
+            writer.writerows((r["date"], r["category"], f"{r['amount']:.2f}", r["note"]) for r in rows)
+            output = buf.getvalue().rstrip("\n")
+        else:
+            rendered = [(r["date"], r["category"], _money(r["amount"], args.currency), r["note"] if len(r["note"]) <= 24 else r["note"][:23] + "…") for r in rows]
+            lines = _table(["Date", "Category", "Amount", "Note"], rendered, right=(2,))
+            if args.no_header:
+                lines = lines[2:]
+            lines.append(f"Total  {_money(total, args.currency)}")
+            output = "\n".join(lines)
+    if not rows:
+        # Grouped result and expense result both represent no data.
+        print("No expenses.")
+    else:
+        print(output)
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
