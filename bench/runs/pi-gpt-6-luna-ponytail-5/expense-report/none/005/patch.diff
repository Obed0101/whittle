+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        self.print_usage(sys.stderr)
+        self.exit(2, f"error: {message}\n")
+
+
+def _parser():
+    parser = Parser(prog="python -m app.report", description="Report expenses from a CSV file.",
+                    epilog="Example: python -m app.report expenses.csv --by category")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", dest="categories")
+    parser.add_argument("--from", dest="from_date")
+    parser.add_argument("--to", dest="to_date")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _date(value):
+    try:
+        parsed = date.fromisoformat(value)
+        if parsed.isoformat() != value:
+            raise ValueError
+        return parsed
+    except (ValueError, TypeError):
+        raise ValueError(value)
+
+
+def _money(value):
+    try:
+        result = Decimal(value)
+        if not result.is_finite():
+            raise InvalidOperation
+        return result
+    except (InvalidOperation, ValueError, TypeError):
+        return None
+
+
+def _table(rows, args):
+    if args.by:
+        grouped = {}
+        for row in rows:
+            key = row["category"].title() if args.by == "category" else row["date"][:7]
+            if key not in grouped:
+                grouped[key] = [0, Decimal(0)]
+            grouped[key][0] += 1
+            grouped[key][1] += row["_amount"]
+        groups = list(grouped.items())
+        if args.by == "category":
+            groups.sort(key=lambda item: (-item[1][1], item[0].casefold()))
+        else:
+            groups.sort(key=lambda item: item[0])
+        headers = ["Category" if args.by == "category" else "Month", "Count", "Total"]
+        body = [[key, str(values[0]), _format_amount(values[1], args.currency)] for key, values in groups]
+        total = sum((row["_amount"] for row in rows), Decimal(0))
+    else:
+        headers = ["Date", "Category", "Amount", "Note"]
+        body = [[row["date"], row["category"], _format_amount(row["_amount"], args.currency),
+                 row["note"] if len(row["note"]) <= 24 else row["note"][:23] + "…"] for row in rows]
+        total = sum((row["_amount"] for row in rows), Decimal(0))
+    if not body:
+        return "No expenses."
+    widths = [max(len(headers[i]), *(len(row[i]) for row in body)) for i in range(len(headers))]
+    lines = []
+    if not args.no_header:
+        lines.extend(["  ".join(headers[i].ljust(widths[i]) for i in range(len(headers))),
+                      "  ".join("-" * width for width in widths)])
+    amount_col = 2 if args.by else 2
+    for row in body:
+        cells = [row[i].rjust(widths[i]) if i == amount_col else row[i].ljust(widths[i]) for i in range(len(row))]
+        lines.append("  ".join(cells).rstrip())
+    total_text = _format_amount(total, args.currency)
+    if args.by:
+        label = "Total"
+        lines.append(label.ljust(widths[0]) + "  " + str(len(rows)).rjust(widths[1]) + "  " + total_text.rjust(widths[2]))
+    else:
+        line = ["Total", "", total_text, ""]
+        lines.append("  ".join(line[i].ljust(widths[i]) if i != 2 else line[i].rjust(widths[i]) for i in range(4)).rstrip())
+    return "\n".join(lines)
+
+
+def _format_amount(value, currency):
+    if value < 0:
+        return currency + "(" + format(abs(value), ",.2f") + ")"
+    return currency + format(value, ",.2f")
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    try:
+        start = _date(args.from_date) if args.from_date else None
+        end = _date(args.to_date) if args.to_date else None
+        if start and end and start > end:
+            print("error: --from is after --to", file=sys.stderr)
+            return 2
+        minimum = _money(args.minimum) if args.minimum is not None else None
+        if args.minimum is not None and minimum is None:
+            parser.error("invalid --min amount")
+        source = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except ValueError as exc:
+        value = exc.args[0] if exc.args else ""
+        print(f"error: invalid date: {value}", file=sys.stderr)
+        return 2
+    valid = []
+    skipped = 0
+    for index, original in enumerate(source):
+        amount = _money(original.get("amount"))
+        if amount is None:
+            skipped += 1
+            continue
+        try:
+            row_date = _date(original.get("date"))
+        except ValueError as exc:
+            print(f"error: invalid date: {exc.args[0]}", file=sys.stderr)
+            return 2
+        row = dict(original)
+        row["_amount"] = amount
+        row["_index"] = index
+        valid.append((row_date, row))
+    valid.sort(key=lambda pair: pair[0])
+    rows = [row for row_date, row in valid
+            if (not args.categories or row["category"].casefold() in {c.casefold() for c in args.categories})
+            and (start is None or row_date >= start) and (end is None or row_date <= end)
+            and (minimum is None or row["_amount"] >= minimum)]
+    if args.top is not None:
+        rows = sorted(rows, key=lambda row: -row["_amount"])[:max(0, args.top)]
+    if args.format == "json":
+        if args.by:
+            grouped = {}
+            for row in rows:
+                key = row["category"] if args.by == "category" else row["date"][:7]
+                count, total = grouped.get(key, (0, Decimal(0)))
+                grouped[key] = count + 1, total + row["_amount"]
+            items = [{"group": key, "count": count, "total": float(total)} for key, (count, total) in grouped.items()]
+            if args.by == "category":
+                items.sort(key=lambda item: (-item["total"], item["group"].casefold()))
+            else:
+                items.sort(key=lambda item: item["group"])
+        else:
+            items = [{"date": row["date"], "category": row["category"], "amount": float(row["_amount"]), "note": row["note"]} for row in rows]
+        print(json.dumps(items, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        for row in rows:
+            writer.writerow([row["date"], row["category"], format(row["_amount"], ".2f"), row["note"]])
+    else:
+        print(_table(rows, args))
+    if skipped:
+        noun = "row" if skipped == 1 else "rows"
+        print(f"warning: skipped {skipped} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
