+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+import json
+import sys
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+from app.expenses import load
+
+
+def _date(value):
+    try:
+        parsed = date.fromisoformat(value)
+        if parsed.isoformat() != value:
+            raise ValueError
+        return parsed
+    except (TypeError, ValueError):
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Report expenses from a CSV file.")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="from_date", type=_date)
+    parser.add_argument("--to", dest="to_date", type=_date)
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by month"
+    return parser
+
+
+def _money(amount, currency=""):
+    value = f"{abs(amount):,.2f}"
+    if amount < 0:
+        return f"({currency}{value})"
+    return f"{currency}{value}"
+
+
+def _table(rows, grouped, currency, no_header):
+    if grouped:
+        headers = ["Category" if grouped == "category" else "Month", "Count", "Total"]
+        data = [[r["group"], str(r["count"]), _money(r["total"], currency)] for r in rows]
+        total = sum((r["total"] for r in rows), Decimal(0))
+        data.append(["Total", str(sum(r["count"] for r in rows)), _money(total, currency)])
+        aligns = ["left", "right", "right"]
+    else:
+        headers = ["Date", "Category", "Amount", "Note"]
+        data = [[r["date"], r["category"], _money(r["amount"], currency), r["note"] if len(r["note"]) <= 24 else r["note"][:23] + "…"] for r in rows]
+        total = sum((r["amount"] for r in rows), Decimal(0))
+        data.append(["Total", "", _money(total, currency), ""])
+        aligns = ["left", "left", "right", "left"]
+    if not rows:
+        return "No expenses."
+    widths = [max(len(headers[i]), *(len(row[i]) for row in data)) for i in range(len(headers))]
+    lines = []
+    if not no_header:
+        lines.append("  ".join(headers[i].ljust(widths[i]) for i in range(len(headers))).rstrip())
+        lines.append("  ".join("-" * widths[i] for i in range(len(headers))))
+    for row in data:
+        lines.append("  ".join(row[i].rjust(widths[i]) if aligns[i] == "right" else row[i].ljust(widths[i]) for i in range(len(headers))).rstrip())
+    return "\n".join(lines)
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    if args.from_date and args.to_date and args.from_date > args.to_date:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        source = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    parsed = []
+    invalid = 0
+    for index, row in enumerate(source):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (KeyError, InvalidOperation, ValueError):
+            invalid += 1
+            continue
+        try:
+            parsed_date = date.fromisoformat(row["date"])
+        except (KeyError, TypeError, ValueError):
+            print(f"error: invalid date: {row.get('date', '')}", file=sys.stderr)
+            return 2
+        parsed.append({"date": parsed_date.isoformat(), "_date": parsed_date, "category": row.get("category", ""), "amount": amount, "note": row.get("note", ""), "_index": index})
+    selected = parsed
+    if args.category:
+        categories = {name.casefold() for name in args.category}
+        selected = [r for r in selected if r["category"].casefold() in categories]
+    if args.from_date:
+        selected = [r for r in selected if r["_date"] >= args.from_date]
+    if args.to_date:
+        selected = [r for r in selected if r["_date"] <= args.to_date]
+    if args.minimum is not None:
+        try:
+            minimum = Decimal(args.minimum)
+        except InvalidOperation:
+            parser.error("--min must be a number")
+        selected = [r for r in selected if r["amount"] >= minimum]
+    grouped = args.by
+    if grouped:
+        accum = {}
+        for r in selected:
+            key = r["category"] if grouped == "category" else r["_date"].strftime("%Y-%m")
+            if key not in accum:
+                accum[key] = [0, Decimal(0)]
+            accum[key][0] += 1
+            accum[key][1] += r["amount"]
+        groups = [{"group": key.title() if grouped == "category" else key, "count": count, "total": total} for key, (count, total) in accum.items()]
+        if grouped == "category":
+            groups.sort(key=lambda r: (-r["total"], r["group"].casefold()))
+        else:
+            groups.sort(key=lambda r: r["group"])
+        selected = groups
+    else:
+        selected.sort(key=lambda r: (r["_date"], r["_index"]))
+        if args.top is not None:
+            selected = sorted(selected, key=lambda r: (-r["amount"], r["_date"], r["_index"]))[:max(0, args.top)]
+    if args.format == "json":
+        if grouped:
+            output = [{"group": r["group"], "count": r["count"], "total": float(r["total"])} for r in selected]
+        else:
+            output = [{"date": r["date"], "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in selected]
+        print(json.dumps(output, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        for r in selected:
+            writer.writerow([r["date"], r["category"], f"{r['amount']:.2f}", r["note"]])
+    else:
+        print(_table(selected, grouped, args.currency, args.no_header))
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
