+"""Render expense CSV files as reports."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        self.print_usage(sys.stderr)
+        self.exit(2, f"error: {message}\n")
+
+
+def _parser():
+    parser = Parser(prog="python -m app.report", description="Report expenses from a CSV file.")
+    parser.add_argument("path", metavar="PATH")
+    parser.add_argument("--category", action="append", dest="categories", metavar="NAME")
+    parser.add_argument("--from", dest="start", metavar="DATE")
+    parser.add_argument("--to", dest="end", metavar="DATE")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="", metavar="SYMBOL")
+    parser.add_argument("--top", type=int, metavar="N")
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by category"
+    return parser
+
+
+def _date_arg(value):
+    try:
+        parsed = date.fromisoformat(value)
+        if parsed.isoformat() != value:
+            raise ValueError
+        return parsed
+    except (ValueError, TypeError):
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+
+
+def _money(value):
+    return Decimal(value).quantize(Decimal("0.01"))
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    parser._option_string_actions['--from'].type = _date_arg
+    parser._option_string_actions['--to'].type = _date_arg
+    args = parser.parse_args(argv)
+    if args.start and args.end and args.start > args.end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        minimum = _money(args.minimum) if args.minimum is not None else None
+    except (InvalidOperation, ValueError):
+        print(f"error: invalid amount: {args.minimum}", file=sys.stderr)
+        return 2
+    try:
+        rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    valid = []
+    skipped = 0
+    for index, row in enumerate(rows):
+        try:
+            amount = Decimal(row.get("amount", ""))
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, ValueError, TypeError):
+            skipped += 1
+            continue
+        try:
+            day = date.fromisoformat(row.get("date", ""))
+        except (ValueError, TypeError):
+            continue
+        valid.append((index, day, row, amount))
+
+    selected = [item for item in valid
+                if (not args.categories or item[2].get("category", "").casefold() in {c.casefold() for c in args.categories})
+                and (args.start is None or item[1] >= args.start)
+                and (args.end is None or item[1] <= args.end)
+                and (minimum is None or item[3] >= minimum)]
+    if args.by is None:
+        selected.sort(key=lambda item: (item[1], item[0]))
+        if args.top is not None:
+            selected = sorted(selected, key=lambda item: item[3], reverse=True)[:max(0, args.top)]
+            selected.sort(key=lambda item: item[3], reverse=True)
+    total = sum((item[3] for item in selected), Decimal(0))
+
+    if args.format == "json":
+        if args.by:
+            groups = _groups(selected, args.by)
+            output = [{"group": name, "count": len(items), "total": float(sum((x[3] for x in items), Decimal(0)))} for name, items in groups]
+        else:
+            output = [{"date": item[2].get("date", ""), "category": item[2].get("category", ""), "amount": float(item[3]), "note": item[2].get("note", "")} for item in selected]
+        print(json.dumps(output, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(("date", "category", "amount", "note"))
+        for _, _, row, amount in selected:
+            writer.writerow((row.get("date", ""), row.get("category", ""), f"{amount:.2f}", row.get("note", "")))
+    elif args.by:
+        groups = _groups(selected, args.by)
+        if not groups:
+            print("No expenses.")
+        else:
+            first = "Category" if args.by == "category" else "Month"
+            headers = (first, "Count", "Total")
+            widths = [max(len(headers[0]), max(len(str(g[0])) for g in groups)), len(headers[1]), len(headers[2])]
+            if not args.no_header:
+                print(f"{headers[0]:<{widths[0]}}  {headers[1]:>{widths[1]}}  {headers[2]:>{widths[2]}}")
+                print(f"{'-' * widths[0]}  {'-' * widths[1]}  {'-' * widths[2]}")
+            for name, items in groups:
+                subtotal = sum((x[3] for x in items), Decimal(0))
+                print(f"{name:<{widths[0]}}  {len(items):>{widths[1]}}  {_table_amount(subtotal, args.currency):>{widths[2]}}")
+            print(f"{'Total':<{widths[0]}}  {len(selected):>{widths[1]}}  {_table_amount(total, args.currency):>{widths[2]}}")
+    else:
+        if not selected:
+            print("No expenses.")
+        else:
+            headers = ("Date", "Category", "Amount", "Note")
+            formatted = []
+            for _, day, row, amount in selected:
+                note = row.get("note", "")
+                if len(note) > 24:
+                    note = note[:23] + "…"
+                formatted.append((day.isoformat(), row.get("category", ""), _table_amount(amount, args.currency), note))
+            widths = [max(len(headers[i]), *(len(r[i]) for r in formatted)) for i in range(4)]
+            if not args.no_header:
+                print(f"{headers[0]:<{widths[0]}}  {headers[1]:<{widths[1]}}  {headers[2]:>{widths[2]}}  {headers[3]}")
+                print(f"{'-' * widths[0]}  {'-' * widths[1]}  {'-' * widths[2]}  {'-' * widths[3]}")
+            for row in formatted:
+                print(f"{row[0]:<{widths[0]}}  {row[1]:<{widths[1]}}  {row[2]:>{widths[2]}}  {row[3]}")
+            print(f"{'Total':<{widths[0]}}  {'':<{widths[1]}}  {_table_amount(total, args.currency):>{widths[2]}}  ")
+    if skipped:
+        word = "row" if skipped == 1 else "rows"
+        print(f"warning: skipped {skipped} {word} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _table_amount(amount, currency):
+    if amount < 0:
+        return f"({currency}{abs(amount):,.2f})"
+    return f"{currency}{amount:,.2f}"
+
+
+def _groups(selected, by):
+    grouped = {}
+    for item in selected:
+        key = item[2].get("category", "").title() if by == "category" else item[1].strftime("%Y-%m")
+        grouped.setdefault(key, []).append(item)
+    groups = list(grouped.items())
+    if by == "category":
+        groups.sort(key=lambda pair: (-sum((x[3] for x in pair[1]), Decimal(0)), pair[0].casefold()))
+    else:
+        groups.sort(key=lambda pair: pair[0])
+    return groups
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
