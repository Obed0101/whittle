+"""Render expense CSV files as reports."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+class ReportParser(argparse.ArgumentParser):
+    def error(self, message):
+        self.print_usage(sys.stderr)
+        self.exit(2, f"error: {message}\n")
+
+
+def _parser():
+    parser = ReportParser(prog="python -m app.report", description="Report expenses from a CSV file.")
+    parser.add_argument("path", metavar="PATH")
+    parser.add_argument("--category", action="append", default=[], metavar="NAME")
+    parser.add_argument("--from", dest="date_from", metavar="DATE")
+    parser.add_argument("--to", dest="date_to", metavar="DATE")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="", metavar="SYMBOL")
+    parser.add_argument("--top", type=int, metavar="N")
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by category"
+    return parser
+
+
+def _parse_date(value):
+    try:
+        return date.fromisoformat(value)
+    except (ValueError, TypeError):
+        raise ValueError(value)
+
+
+def _table(rows, currency, no_header):
+    if not rows:
+        return "No expenses.\n"
+    if no_header and not ("group" in rows[0]):
+        lines = []
+        for row in rows:
+            amount = row["amount"]
+            rendered = f"({abs(amount):,.2f})" if amount < 0 else f"{amount:,.2f}"
+            note = row["note"]
+            lines.append(f"{row['date']}  {row['category']}  {currency}{rendered}  {note[:23] + '…' if len(note) > 24 else note}")
+        lines.append(f"Total  {currency}{sum((r['amount'] for r in rows), Decimal(0)):,.2f}")
+        return "\n".join(lines) + "\n"
+    if rows and "group" in rows[0]:
+        first = "Month" if rows[0].get("group_type") == "month" else "Category"
+        headers = [first, "Count", "Total"]
+        body = [[r["group"], str(r["count"]), f"{currency}{r['total']:,.2f}"] for r in rows]
+        total = sum((r["total"] for r in rows), Decimal(0))
+    else:
+        headers = ["Date", "Category", "Amount", "Note"]
+        body = []
+        for r in rows:
+            amount = r["amount"]
+            formatted = f"({abs(amount):,.2f})" if amount < 0 else f"{amount:,.2f}"
+            note = r["note"]
+            body.append([r["date"], r["category"], currency + formatted, note[:23] + "…" if len(note) > 24 else note])
+        total = sum((r["amount"] for r in rows), Decimal(0))
+    widths = [max(len(headers[i]), *(len(line[i]) for line in body)) for i in range(len(headers))]
+    lines = []
+    if not no_header:
+        lines.extend(["  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)), "  ".join("-" * w for w in widths)])
+    for line in body:
+        lines.append("  ".join(line[i].rjust(widths[i]) if headers[i] in ("Amount", "Total", "Count") else line[i].ljust(widths[i]) for i in range(len(headers))))
+    lines.append(f"Total  {currency}{total:,.2f}")
+    return "\n".join(lines) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    try:
+        start = _parse_date(args.date_from) if args.date_from else None
+        end = _parse_date(args.date_to) if args.date_to else None
+    except ValueError as exc:
+        print(f"error: invalid date: {exc}", file=sys.stderr)
+        return 2
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        source = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    rows = []
+    invalid = 0
+    for index, row in enumerate(source):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, TypeError, KeyError):
+            invalid += 1
+            continue
+        try:
+            _parse_date(row["date"])
+        except (ValueError, KeyError) as exc:
+            print(f"error: invalid date: {exc}", file=sys.stderr)
+            return 2
+        row = dict(row)
+        row["amount"] = amount
+        row["_index"] = index
+        rows.append(row)
+    if args.minimum is not None:
+        try:
+            minimum = Decimal(args.minimum)
+        except InvalidOperation:
+            parser.error("invalid --min amount")
+        rows = [r for r in rows if r["amount"] >= minimum]
+    if args.category:
+        categories = {c.casefold() for c in args.category}
+        rows = [r for r in rows if r["category"].casefold() in categories]
+    try:
+        if start:
+            rows = [r for r in rows if _parse_date(r["date"]) >= start]
+        if end:
+            rows = [r for r in rows if _parse_date(r["date"]) <= end]
+    except ValueError as exc:
+        print(f"error: invalid date: {exc}", file=sys.stderr)
+        return 2
+    rows.sort(key=lambda r: (r["date"], r["_index"]))
+    if args.top is not None:
+        rows = sorted(rows, key=lambda r: (-r["amount"], r["_index"]))[:max(0, args.top)]
+    if args.by:
+        groups = {}
+        for row in rows:
+            key = row["category"].title() if args.by == "category" else row["date"][:7]
+            if key not in groups:
+                groups[key] = {"group": key, "count": 0, "total": Decimal(0), "group_type": args.by}
+            groups[key]["count"] += 1
+            groups[key]["total"] += row["amount"]
+        rows = list(groups.values())
+        if args.by == "category":
+            rows.sort(key=lambda r: (-r["total"], r["group"].casefold()))
+        else:
+            rows.sort(key=lambda r: r["group"])
+    if args.format == "json":
+        if args.by:
+            output = [{"group": r["group"], "count": r["count"], "total": float(r["total"])} for r in rows]
+        else:
+            output = [{"date": r["date"], "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in rows]
+        print(json.dumps(output, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        for r in rows:
+            writer.writerow([r["date"], r["category"], f"{r['amount']:.2f}", r["note"]])
+    else:
+        print(_table(rows, args.currency, args.no_header), end="")
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
