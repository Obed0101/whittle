+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", dest="categories")
+    parser.add_argument("--from", dest="date_from")
+    parser.add_argument("--to", dest="date_to")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by category"
+    return parser
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (ValueError, TypeError):
+        raise ValueError(f"error: invalid date: {value}")
+
+
+def _money(value):
+    try:
+        amount = Decimal(value)
+        if not amount.is_finite():
+            raise InvalidOperation
+        return amount
+    except (InvalidOperation, TypeError, ValueError):
+        return None
+
+
+def _table(rows, groups, by, currency, no_header):
+    if by is None:
+        headers = ["Date", "Category", "Amount", "Note"]
+        body = []
+        for row in rows:
+            note = row["note"]
+            if len(note) > 24:
+                note = note[:23] + "…"
+            amount = row["amount"]
+            value = f"({abs(amount):,.2f})" if amount < 0 else f"{amount:,.2f}"
+            body.append([row["date"], row["category"], currency + value, note])
+        total = sum((r["amount"] for r in rows), Decimal(0))
+        total_text = f"({abs(total):,.2f})" if total < 0 else f"{total:,.2f}"
+        total_row = ["Total", "", currency + total_text, ""]
+        numeric_columns = {2}
+    else:
+        label = "Category" if by == "category" else "Month"
+        headers = [label, "Count", "Total"]
+        body = [[g["group"], str(g["count"]), currency + f'{g["total"]:,.2f}'] for g in groups]
+        total = sum((g["total"] for g in groups), Decimal(0))
+        total_text = f"({abs(total):,.2f})" if total < 0 else f"{total:,.2f}"
+        total_row = ["Total", "", currency + total_text]
+        numeric_columns = {1, 2}
+    all_rows = body + [total_row]
+    widths = [max(len(headers[i]), *(len(r[i]) for r in all_rows)) for i in range(len(headers))]
+    def line(row):
+        return "  ".join((value.rjust(widths[i]) if i in numeric_columns else value.ljust(widths[i])) for i, value in enumerate(row)).rstrip()
+    output = []
+    if not no_header:
+        output.extend([line(headers), "  ".join("-" * w for w in widths)])
+    output.extend(line(r) for r in all_rows)
+    return "\n".join(output) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+        from_date = _date(args.date_from) if args.date_from else None
+        to_date = _date(args.date_to) if args.date_to else None
+        if from_date and to_date and from_date > to_date:
+            raise ValueError("error: --from is after --to")
+        minimum = _money(args.minimum) if args.minimum is not None else None
+        if args.minimum is not None and minimum is None:
+            parser.error("--min must be a number")
+        if args.top is not None and args.top < 0:
+            parser.error("--top must be non-negative")
+        try:
+            source = load(args.path)
+        except FileNotFoundError:
+            print(f"error: file not found: {args.path}", file=sys.stderr)
+            return 2
+        valid = []
+        skipped = 0
+        for index, row in enumerate(source):
+            amount = _money(row.get("amount"))
+            if amount is None:
+                skipped += 1
+                continue
+            item = dict(row)
+            item["amount"] = amount
+            item["_index"] = index
+            item["_date"] = _date(item["date"])
+            valid.append(item)
+        filtered = valid
+        if args.categories:
+            categories = {c.casefold() for c in args.categories}
+            filtered = [r for r in filtered if r["category"].casefold() in categories]
+        if from_date:
+            filtered = [r for r in filtered if r["_date"] >= from_date]
+        if to_date:
+            filtered = [r for r in filtered if r["_date"] <= to_date]
+        if minimum is not None:
+            filtered = [r for r in filtered if r["amount"] >= minimum]
+        if args.top is not None:
+            filtered = sorted(filtered, key=lambda r: -r["amount"])[:args.top]
+        else:
+            filtered = sorted(filtered, key=lambda r: (r["_date"], r["_index"]))
+        if not filtered:
+            print("No expenses.")
+        elif args.format == "json":
+            if args.by:
+                groups = _groups(filtered, args.by)
+                result = [{"group": g["group"], "count": g["count"], "total": float(g["total"])} for g in groups]
+            else:
+                result = [{"date": r["date"], "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in filtered]
+            print(json.dumps(result, indent=2))
+        elif args.format == "csv":
+            if args.by:
+                # CSV format describes individual expenses, independent of grouping.
+                pass
+            writer = csv.writer(sys.stdout, lineterminator="\n")
+            writer.writerow(["date", "category", "amount", "note"])
+            for row in filtered:
+                writer.writerow([row["date"], row["category"], f'{row["amount"]:.2f}', row["note"]])
+        else:
+            if args.by:
+                groups_data = _groups(filtered, args.by)
+                print(_table(filtered, groups_data, args.by, args.currency, args.no_header), end="")
+            else:
+                print(_table(filtered, None, None, args.currency, args.no_header), end="")
+        if skipped:
+            noun = "row" if skipped == 1 else "rows"
+            print(f"warning: skipped {skipped} {noun} with invalid amount", file=sys.stderr)
+        return 0
+    except ValueError as exc:
+        print(str(exc), file=sys.stderr)
+        return 2
+
+
+def _groups(rows, by):
+    grouped = {}
+    for row in rows:
+        if by == "category":
+            key = row["category"].title()
+        else:
+            key = row["date"][:7]
+        if key not in grouped:
+            grouped[key] = [0, Decimal(0)]
+        grouped[key][0] += 1
+        grouped[key][1] += row["amount"]
+    values = [{"group": key, "count": value[0], "total": value[1]} for key, value in grouped.items()]
+    if by == "category":
+        values.sort(key=lambda g: (-g["total"], g["group"].casefold()))
+    else:
+        values.sort(key=lambda g: g["group"])
+    return values
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
