+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise ValueError(value)
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", epilog="Example: python -m app.report expenses.csv --by category")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="date_from")
+    parser.add_argument("--to", dest="date_to")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _table(rows, grouped, currency, no_header):
+    if grouped:
+        headings = ["Category" if grouped == "category" else "Month", "Count", "Total"]
+        body = [[r["group"], str(r["count"]), currency + _money(r["total"])] for r in rows]
+        total = sum((r["total"] for r in rows), Decimal(0))
+        body.append(["Total", "", currency + _money(total)])
+    else:
+        headings = ["Date", "Category", "Amount", "Note"]
+        body = []
+        for r in rows:
+            amount = r["amount"]
+            shown = f"({currency}{_money(abs(amount))})" if amount < 0 else currency + _money(amount)
+            note = r["note"]
+            if len(note) > 24:
+                note = note[:23] + "…"
+            body.append([r["date"], r["category"], shown, note])
+        total = sum((r["amount"] for r in rows), Decimal(0))
+        body.append(["Total", "", currency + _money(total), ""])
+    widths = [max(len(headings[i]), *(len(row[i]) for row in body)) for i in range(len(headings))]
+    lines = []
+    if not no_header:
+        lines += ["  ".join(headings[i].ljust(widths[i]) for i in range(len(headings))),
+                  "  ".join("-" * widths[i] for i in range(len(headings)))]
+    for row in body:
+        rendered = []
+        for i, cell in enumerate(row):
+            rendered.append(cell.rjust(widths[i]) if (grouped and i == 2) or (not grouped and i == 2) else cell.ljust(widths[i]))
+        lines.append("  ".join(rendered).rstrip())
+    return "\n".join(lines) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    try:
+        args = _parser().parse_args(argv)
+    except SystemExit as exc:
+        return int(exc.code)
+    try:
+        start = _date(args.date_from) if args.date_from else None
+        end = _date(args.date_to) if args.date_to else None
+        if start and end and start > end:
+            raise RuntimeError("--from is after --to")
+        minimum = Decimal(args.minimum) if args.minimum is not None else None
+        rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except RuntimeError as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 2
+    except ValueError as exc:
+        print(f"error: invalid date: {exc}", file=sys.stderr)
+        return 2
+    except InvalidOperation:
+        print(f"error: invalid amount: {args.minimum}", file=sys.stderr)
+        return 2
+    valid = []
+    skipped = 0
+    for row in rows:
+        try:
+            amount = Decimal(row.get("amount", ""))
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, TypeError):
+            skipped += 1
+            continue
+        try:
+            day = _date(row.get("date", ""))
+        except ValueError as exc:
+            print(f"error: invalid date: {exc}", file=sys.stderr)
+            return 2
+        row = dict(row)
+        row["_date"] = day
+        row["_amount"] = amount
+        valid.append(row)
+    cats = {c.casefold() for c in args.category}
+    selected = [r for r in valid if (not cats or r.get("category", "").casefold() in cats)
+                and (start is None or r["_date"] >= start)
+                and (end is None or r["_date"] <= end)
+                and (minimum is None or r["_amount"] >= minimum)]
+    if args.by:
+        groups = {}
+        for r in selected:
+            key = r["category"].title() if args.by == "category" else r["date"][:7]
+            if key not in groups:
+                groups[key] = [0, Decimal(0)]
+            groups[key][0] += 1
+            groups[key][1] += r["_amount"]
+        result = [{"group": k, "count": v[0], "total": v[1]} for k, v in groups.items()]
+        if args.by == "category":
+            result.sort(key=lambda x: (-x["total"], x["group"].casefold()))
+        else:
+            result.sort(key=lambda x: x["group"])
+    else:
+        selected.sort(key=lambda r: r["_date"])
+        if args.top is not None:
+            selected = sorted(selected, key=lambda r: r["_amount"], reverse=True)[:max(0, args.top)]
+        result = selected
+    if args.format == "json":
+        if args.by:
+            output = [{"group": r["group"], "count": r["count"], "total": float(r["total"])} for r in result]
+        else:
+            output = [{"date": r["date"], "category": r["category"], "amount": float(r["_amount"]), "note": r.get("note", "")} for r in result]
+        print(json.dumps(output, indent=2))
+    elif args.format == "csv":
+        import io
+        out = io.StringIO(newline="")
+        writer = csv.writer(out, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        for r in result:
+            writer.writerow([r["date"], r["category"], f"{r['_amount']:.2f}", r.get("note", "")])
+        sys.stdout.write(out.getvalue())
+    elif not result:
+        print("No expenses.")
+    else:
+        print(_table(result, args.by, args.currency, args.no_header), end="")
+    if skipped:
+        noun = "row" if skipped == 1 else "rows"
+        print(f"warning: skipped {skipped} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
