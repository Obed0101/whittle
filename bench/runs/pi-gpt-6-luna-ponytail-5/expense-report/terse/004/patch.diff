+"""Render expense CSV files in report-friendly formats."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from .expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        self.print_usage(sys.stderr)
+        self.exit(2, f"{self.prog}: error: {message}\n")
+
+
+def _parser():
+    parser = Parser(prog="python -m app.report", description="Report expenses from a CSV file.", epilog="Example: python -m app.report expenses.csv --by month")
+    parser.add_argument("path", nargs="?")
+    parser.add_argument("--category", action="append", default=[], metavar="NAME")
+    parser.add_argument("--from", dest="start", metavar="DATE")
+    parser.add_argument("--to", dest="end", metavar="DATE")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (ValueError, TypeError):
+        raise ValueError(value)
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _table(rows, args):
+    if args.by:
+        groups = {}
+        for row in rows:
+            key = row["category"].title() if args.by == "category" else row["date"][:7]
+            groups.setdefault(key, []).append(row)
+        output = [(key, len(items), sum((r["_amount"] for r in items), Decimal(0))) for key, items in groups.items()]
+        output.sort(key=(lambda item: (-item[2], item[0].casefold())) if args.by == "category" else (lambda item: item[0]))
+        headers = ["Category" if args.by == "category" else "Month", "Count", "Total"]
+        body = [[key, str(count), args.currency + _money(total)] for key, count, total in output]
+        grand = sum((r["_amount"] for r in rows), Decimal(0))
+        total_row = ["Total", "", args.currency + _money(grand)]
+    else:
+        headers = ["Date", "Category", "Amount", "Note"]
+        body = []
+        for row in rows:
+            note = row["note"] or ""
+            if len(note) > 24:
+                note = note[:23] + "…"
+            amount = row["_amount"]
+            rendered = f"({args.currency}{_money(abs(amount))})" if amount < 0 else args.currency + _money(amount)
+            body.append([row["date"], row["category"], rendered, note])
+        total = sum((r["_amount"] for r in rows), Decimal(0))
+        total_row = ["Total", "", args.currency + _money(total), ""]
+    all_rows = body + [total_row]
+    widths = [max(len(headers[i]), *(len(row[i]) for row in all_rows)) for i in range(len(headers))]
+    lines = []
+    if not args.no_header:
+        lines.extend(["  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)), "  ".join("-" * w for w in widths)])
+    for row in all_rows:
+        parts = []
+        for i, value in enumerate(row):
+            right = (not args.by and i == 2) or (bool(args.by) and i in (1, 2))
+            parts.append(value.rjust(widths[i]) if right else value.ljust(widths[i]))
+        lines.append("  ".join(parts).rstrip())
+    return "\n".join(lines) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    if args.path is None:
+        parser.error("the following arguments are required: path")
+    if args.format not in ("table", "json", "csv"):
+        print(f"error: unknown format: {args.format}", file=sys.stderr)
+        return 2
+    try:
+        start = _date(args.start) if args.start else None
+        end = _date(args.end) if args.end else None
+    except ValueError as exc:
+        print(f"error: invalid date: {exc.args[0]}", file=sys.stderr)
+        return 2
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        raw = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    rows, invalid = [], 0
+    for index, item in enumerate(raw):
+        try:
+            parsed_date = _date(item.get("date", ""))
+        except ValueError as exc:
+            print(f"error: invalid date: {exc.args[0]}", file=sys.stderr)
+            return 2
+        try:
+            amount = Decimal(item.get("amount", ""))
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, ValueError):
+            invalid += 1
+            continue
+        item = dict(item)
+        item["_amount"] = amount
+        item["_date"] = parsed_date
+        item["_index"] = index
+        rows.append(item)
+    rows.sort(key=lambda row: (row["_date"], row["_index"]))
+    categories = {name.casefold() for name in args.category}
+    minimum = None
+    if args.minimum is not None:
+        try:
+            minimum = Decimal(args.minimum)
+        except InvalidOperation:
+            parser.error("--min must be a number")
+    rows = [r for r in rows if (not categories or r["category"].casefold() in categories)
+            and (start is None or r["_date"] >= start) and (end is None or r["_date"] <= end)
+            and (minimum is None or r["_amount"] >= minimum)]
+    if args.top is not None:
+        rows = sorted(rows, key=lambda r: -r["_amount"])[:max(0, args.top)]
+    if not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        if args.by:
+            groups = {}
+            for row in rows:
+                key = row["category"] if args.by == "category" else row["date"][:7]
+                groups.setdefault(key, []).append(row)
+            grouped = [{"group": key, "count": len(items), "total": float(sum((r["_amount"] for r in items), Decimal(0)))} for key, items in groups.items()]
+            grouped.sort(key=lambda item: (-item["total"], item["group"]) if args.by == "category" else item["group"])
+            print(json.dumps(grouped, indent=2))
+        else:
+            print(json.dumps([{ "date": r["date"], "category": r["category"], "amount": float(r["_amount"]), "note": r["note"]} for r in rows], indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        for row in rows:
+            writer.writerow([row["date"], row["category"], f"{row['_amount']:.2f}", row["note"]])
+    else:
+        sys.stdout.write(_table(rows, args))
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
