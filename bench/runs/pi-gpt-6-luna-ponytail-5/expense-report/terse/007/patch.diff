+"""Render expense CSV files as reports."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from .expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report", description="Report expenses from a CSV file.")
+    parser.add_argument("path", nargs="?")
+    parser.add_argument("--category", action="append", dest="categories", metavar="NAME")
+    parser.add_argument("--from", dest="from_date", metavar="DATE")
+    parser.add_argument("--to", dest="to_date", metavar="DATE")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="", metavar="SYMBOL")
+    parser.add_argument("--top", type=int, metavar="N")
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by month"
+    return parser
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (ValueError, TypeError):
+        raise ValueError(value)
+
+
+def _amount(value):
+    try:
+        result = Decimal(value)
+        if not result.is_finite():
+            raise InvalidOperation
+        return result
+    except (InvalidOperation, TypeError, ValueError):
+        return None
+
+
+def _table(rows, grouped, currency, no_header):
+    if grouped:
+        headers = ["Category" if grouped == "category" else "Month", "Count", "Total"]
+        records = [[key.title() if grouped == "category" else key, str(count), f"{currency}{total:,.2f}"] for key, count, total in rows]
+    else:
+        headers = ["Date", "Category", "Amount", "Note"]
+        records = [[r["date"], r["category"],
+                    (f"({currency}{abs(r['amount']):,.2f})" if r["amount"] < 0 else f"{currency}{r['amount']:,.2f}"),
+                    r.get("note", "") if len(r.get("note", "")) <= 24 else r.get("note", "")[:23] + "…"] for r in rows]
+    widths = [max(len(headers[i]), *(len(record[i]) for record in records)) for i in range(len(headers))]
+    lines = []
+    if not no_header:
+        lines.extend(["  ".join(h.ljust(widths[i]) if i != 2 or grouped else h.rjust(widths[i]) for i, h in enumerate(headers)),
+                      "  ".join("-" * w for w in widths)])
+    for record in records:
+        lines.append("  ".join(value.rjust(widths[i]) if (i == 2 and not grouped) or (grouped and i == 2) else value.ljust(widths[i]) for i, value in enumerate(record)))
+    total = sum((r["amount"] for r in rows), Decimal(0)) if not grouped else sum((item[2] for item in rows), Decimal(0))
+    lines.append(f"Total  {currency}{total:,.2f}")
+    return "\n".join(lines) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    try:
+        args = parser.parse_args(argv)
+    except SystemExit as exc:
+        return int(exc.code)
+    if not args.path:
+        parser.print_usage(sys.stderr)
+        return 2
+    try:
+        start = _date(args.from_date) if args.from_date else None
+        end = _date(args.to_date) if args.to_date else None
+    except ValueError as exc:
+        print(f"error: invalid date: {exc}", file=sys.stderr)
+        return 2
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        raw = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except OSError as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 2
+    rows = []
+    invalid = 0
+    for row in raw:
+        amount = _amount(row.get("amount"))
+        if amount is None:
+            invalid += 1
+            continue
+        row = dict(row)
+        row["amount"] = amount
+        rows.append(row)
+    if args.minimum is not None:
+        minimum = _amount(args.minimum)
+        if minimum is None:
+            print(f"error: invalid amount: {args.minimum}", file=sys.stderr)
+            return 2
+    else:
+        minimum = None
+    selected = []
+    for row in rows:
+        try:
+            row_date = _date(row.get("date"))
+        except ValueError:
+            # Invalid dates cannot satisfy date-bound comparisons; otherwise retain the input record.
+            row_date = None
+        if args.categories and row.get("category", "").casefold() not in {c.casefold() for c in args.categories}:
+            continue
+        if start and (row_date is None or row_date < start):
+            continue
+        if end and (row_date is None or row_date > end):
+            continue
+        if minimum is not None and row["amount"] < minimum:
+            continue
+        row["_date"] = row_date
+        selected.append(row)
+    if args.top is not None:
+        selected = sorted(selected, key=lambda r: r["amount"], reverse=True)[:max(0, args.top)]
+    elif not args.by:
+        selected = [r for _, r in sorted(enumerate(selected), key=lambda pair: (pair[1]["_date"] is not None, pair[1]["_date"] or date.min, pair[0]))]
+    if not selected:
+        print("No expenses.")
+    elif args.format == "json":
+        if args.by:
+            grouped = _groups(selected, args.by)
+            objects = [{"group": key, "count": count, "total": float(total)} for key, count, total in grouped]
+        else:
+            objects = [{"date": r.get("date"), "category": r.get("category"), "amount": float(r["amount"]), "note": r.get("note", "")} for r in selected]
+        print(json.dumps(objects, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        for r in selected:
+            writer.writerow([r.get("date", ""), r.get("category", ""), f"{r['amount']:.2f}", r.get("note", "")])
+    else:
+        print(_table(_groups(selected, args.by) if args.by else selected, args.by, args.currency, args.no_header), end="")
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _groups(rows, by):
+    grouped = {}
+    for row in rows:
+        if by == "category":
+            key = row.get("category", "")
+        else:
+            key = row.get("date", "")[:7]
+        count, total = grouped.get(key, (0, Decimal(0)))
+        grouped[key] = (count + 1, total + row["amount"])
+    result = [(key, count, total) for key, (count, total) in grouped.items()]
+    if by == "category":
+        result.sort(key=lambda item: (-item[2], item[0].casefold()))
+    else:
+        result.sort(key=lambda item: item[0])
+    return result
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
