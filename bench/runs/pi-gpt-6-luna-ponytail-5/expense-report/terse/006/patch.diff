+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="date_from")
+    parser.add_argument("--to", dest="date_to")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by month"
+    return parser
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise ValueError(value)
+
+
+def _amount(value):
+    try:
+        result = Decimal(value)
+        if not result.is_finite():
+            raise InvalidOperation
+        return result
+    except (InvalidOperation, TypeError, ValueError):
+        return None
+
+
+def _table(headers, rows, total, currency="", no_header=False):
+    # rows are already display-ready; amount and total occupy their relevant columns.
+    widths = [max(len(str(h)), *(len(str(row[i])) for row in rows)) for i, h in enumerate(headers)] if rows else [len(h) for h in headers]
+    lines = []
+    if not no_header:
+        lines.append("  ".join(str(h).ljust(widths[i]) for i, h in enumerate(headers)))
+        lines.append("  ".join("-" * width for width in widths))
+    for row in rows:
+        cells = []
+        for i, cell in enumerate(row):
+            cells.append(str(cell).rjust(widths[i]) if headers[i] in ("Amount", "Count", "Total") else str(cell).ljust(widths[i]))
+        lines.append("  ".join(cells).rstrip())
+    if headers == ["Date", "Category", "Amount", "Note"]:
+        total_text = f"{currency}{total:,.2f}"
+        lines.append(f"Total: {total_text}")
+    else:
+        total_text = f"{currency}{total:,.2f}"
+        lines.append(f"Total  {total_text}")
+    return "\n".join(lines) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    if args.format not in ("table", "json", "csv"):
+        print(f"error: unknown format: {args.format}", file=sys.stderr)
+        return 2
+    try:
+        start = _date(args.date_from) if args.date_from else None
+        end = _date(args.date_to) if args.date_to else None
+    except ValueError as exc:
+        print(f"error: invalid date: {exc}", file=sys.stderr)
+        return 2
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    minimum = None
+    if args.minimum is not None:
+        minimum = _amount(args.minimum)
+        if minimum is None:
+            print(f"error: invalid amount: {args.minimum}", file=sys.stderr)
+            return 2
+    try:
+        records = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    valid = []
+    skipped = 0
+    for index, row in enumerate(records):
+        amount = _amount(row.get("amount"))
+        if amount is None:
+            skipped += 1
+            continue
+        try:
+            record_date = _date(row.get("date"))
+        except ValueError:
+            continue
+        valid.append({"date": row.get("date", ""), "category": row.get("category", ""), "amount": amount, "note": row.get("note", ""), "_date": record_date, "_index": index})
+    categories = {x.casefold() for x in args.category}
+    selected = [r for r in valid if (not categories or r["category"].casefold() in categories)
+                and (start is None or r["_date"] >= start) and (end is None or r["_date"] <= end)
+                and (minimum is None or r["amount"] >= minimum)]
+    selected.sort(key=lambda r: r["_date"])
+    if args.top is not None:
+        selected = sorted(selected, key=lambda r: r["amount"], reverse=True)[:max(0, args.top)]
+
+    if args.by:
+        groups = {}
+        for r in selected:
+            key = r["category"].title() if args.by == "category" else r["date"][:7]
+            groups.setdefault(key, []).append(r)
+        result = [{"group": k, "count": len(v), "total": sum((r["amount"] for r in v), Decimal(0))} for k, v in groups.items()]
+        if args.by == "category":
+            result.sort(key=lambda x: (-x["total"], x["group"].casefold()))
+        else:
+            result.sort(key=lambda x: x["group"])
+        total = sum((r["amount"] for r in selected), Decimal(0))
+        if args.format == "json":
+            print(json.dumps([{"group": x["group"], "count": x["count"], "total": float(x["total"])} for x in result], indent=2))
+        elif not result:
+            print("No expenses.")
+        else:
+            rows = [[x["group"], str(x["count"]), f"{args.currency}{x['total']:,.2f}"] for x in result]
+            print(_table(["Category" if args.by == "category" else "Month", "Count", "Total"], rows, total, args.currency, args.no_header), end="")
+    elif not selected and args.format == "table":
+        print("No expenses.")
+    elif args.format == "json":
+        print(json.dumps([{"date": r["date"], "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in selected], indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        for r in selected:
+            writer.writerow([r["date"], r["category"], f"{r['amount']:.2f}", r["note"]])
+    else:
+        rows = [[r["date"], r["category"], f"{args.currency}{r['amount']:,.2f}" if r["amount"] >= 0 else f"({args.currency}{abs(r['amount']):,.2f})", r["note"][:23] + "…" if len(r["note"]) > 24 else r["note"]] for r in selected]
+        total = sum((r["amount"] for r in selected), Decimal(0))
+        print(_table(["Date", "Category", "Amount", "Note"], rows, total, args.currency, args.no_header), end="")
+    if skipped:
+        print(f"warning: skipped {skipped} row{'s' if skipped != 1 else ''} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
