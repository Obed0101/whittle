+"""Render expense CSV files as reports."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import sys
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        self.print_usage(sys.stderr)
+        self.exit(2, f"error: {message}\n")
+
+
+def _parser():
+    parser = Parser(prog="python -m app.report", description="Report expenses from a CSV file.")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[], metavar="NAME")
+    parser.add_argument("--from", dest="from_date", metavar="DATE")
+    parser.add_argument("--to", dest="to_date", metavar="DATE")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", default="table", metavar="FORMAT")
+    parser.add_argument("--currency", default="", metavar="SYMBOL")
+    parser.add_argument("--top", type=int, metavar="N")
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise ValueError(value)
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    if args.format not in ("table", "json", "csv"):
+        print(f"error: unknown format: {args.format}", file=sys.stderr)
+        return 2
+    bounds = {}
+    for key, value in (("--from", args.from_date), ("--to", args.to_date)):
+        if value is not None:
+            try:
+                bounds[key] = _date(value)
+            except ValueError:
+                print(f"error: invalid date: {value}", file=sys.stderr)
+                return 2
+    if "--from" in bounds and "--to" in bounds and bounds["--from"] > bounds["--to"]:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    minimum = None
+    if args.minimum is not None:
+        try:
+            minimum = Decimal(args.minimum)
+        except InvalidOperation:
+            print(f"error: invalid amount: {args.minimum}", file=sys.stderr)
+            return 2
+    try:
+        raw_rows = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+
+    rows = []
+    invalid_amounts = 0
+    for index, row in enumerate(raw_rows):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, TypeError, KeyError):
+            invalid_amounts += 1
+            continue
+        try:
+            day = _date(row["date"])
+        except (ValueError, TypeError, KeyError):
+            print(f"error: invalid date: {row.get('date', '')}", file=sys.stderr)
+            return 2
+        rows.append({"date": day, "category": row["category"], "amount": amount,
+                     "note": row.get("note", ""), "index": index})
+
+    categories = {x.casefold() for x in args.category}
+    rows = [r for r in rows if (not categories or r["category"].casefold() in categories)
+            and ("--from" not in bounds or r["date"] >= bounds["--from"])
+            and ("--to" not in bounds or r["date"] <= bounds["--to"])
+            and (minimum is None or r["amount"] >= minimum)]
+    if args.top is not None:
+        rows = sorted(rows, key=lambda r: r["amount"], reverse=True)[:max(0, args.top)]
+    else:
+        rows.sort(key=lambda r: (r["date"], r["index"]))
+
+    if args.by:
+        groups = {}
+        for row in rows:
+            key = row["category"].title() if args.by == "category" else row["date"].strftime("%Y-%m")
+            groups.setdefault(key, []).append(row["amount"])
+        data = [{"group": key, "count": len(values), "total": sum(values, Decimal(0))}
+                for key, values in groups.items()]
+        if args.by == "category":
+            data.sort(key=lambda g: (-g["total"], g["group"].casefold()))
+        else:
+            data.sort(key=lambda g: g["group"])
+        total = sum((g["total"] for g in data), Decimal(0))
+    else:
+        total = sum((r["amount"] for r in rows), Decimal(0))
+
+    if args.format == "json":
+        if args.by:
+            result = [{"group": g["group"], "count": g["count"], "total": float(g["total"])} for g in data]
+        else:
+            result = [{"date": r["date"].isoformat(), "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in rows]
+        print(json.dumps(result, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(("date", "category", "amount", "note"))
+        for r in rows:
+            writer.writerow((r["date"].isoformat(), r["category"], f"{r['amount']:.2f}", r["note"]))
+    elif not rows:
+        print("No expenses.")
+    elif args.by:
+        headers = ("Category" if args.by == "category" else "Month", "Count", "Total")
+        body = [[g["group"], str(g["count"]), _money(g["total"])] for g in data]
+        _print_table(headers, body, total, args)
+    else:
+        body = []
+        for r in rows:
+            amount = f"({args.currency}{_money(abs(r['amount']))})" if r["amount"] < 0 else args.currency + _money(r["amount"])
+            note = r["note"] if len(r["note"]) <= 24 else r["note"][:23] + "…"
+            body.append([r["date"].isoformat(), r["category"], amount, note])
+        _print_table(("Date", "Category", "Amount", "Note"), body, total, args)
+
+    if invalid_amounts:
+        noun = "row" if invalid_amounts == 1 else "rows"
+        print(f"warning: skipped {invalid_amounts} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _print_table(headers, rows, total, args):
+    numeric_col = 2 if len(headers) == 4 else 2
+    widths = [max(len(str(h)), *(len(str(row[i])) for row in rows)) for i, h in enumerate(headers)]
+    if len(headers) == 4:
+        total_row = ["Total", "", args.currency + _money(total), ""]
+    else:
+        total_row = ["Total", "", args.currency + _money(total)]
+    widths = [max(w, len(total_row[i])) for i, w in enumerate(widths)]
+    if not args.no_header:
+        print("  ".join(str(h).ljust(widths[i]) for i, h in enumerate(headers)))
+        print("  ".join("-" * w for w in widths))
+    for row in rows:
+        print("  ".join(str(value).rjust(widths[i]) if i == numeric_col else str(value).ljust(widths[i]) for i, value in enumerate(row)))
+    print("  ".join(str(value).rjust(widths[i]) if i == numeric_col else str(value).ljust(widths[i]) for i, value in enumerate(total_row)).rstrip())
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
