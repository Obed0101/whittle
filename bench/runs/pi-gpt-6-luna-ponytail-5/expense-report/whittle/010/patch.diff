+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+import json
+import sys
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        self.print_usage(sys.stderr)
+        self.exit(2, f"error: {message}\n")
+
+
+def _parser():
+    parser = Parser(prog="python -m app.report", description="Create a report from an expense CSV.")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", dest="categories")
+    parser.add_argument("--from", dest="date_from")
+    parser.add_argument("--to", dest="date_to")
+    parser.add_argument("--min", dest="minimum")
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    parser.epilog = "Example: python -m app.report expenses.csv --by category"
+    return parser
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _table(headers, rows, amount_columns, total):
+    # Rows are strings; amount columns are right-aligned, all others left-aligned.
+    widths = [max(len(str(headers[i])), *(len(str(row[i])) for row in rows)) if rows else len(str(headers[i])) for i in range(len(headers))]
+    if amount_columns:
+        widths[amount_columns[0]] = max(widths[amount_columns[0]], len(total))
+    lines = []
+    if not _table.no_header:
+        lines += ["  ".join(str(h).ljust(widths[i]) for i, h in enumerate(headers)),
+                  "  ".join("-" * widths[i] for i in range(len(headers)))]
+    for row in rows:
+        lines.append("  ".join(str(value).rjust(widths[i]) if i in amount_columns else str(value).ljust(widths[i]) for i, value in enumerate(row)))
+    if total is not None:
+        # Keep total aligned under the amount column, with Total at the beginning.
+        if len(headers) == 4:
+            prefix = "Total".ljust(widths[0]) + "  " + "".ljust(widths[1]) + "  " + "".ljust(widths[2])
+            lines.append(prefix + "  " + total.rjust(widths[3]))
+        else:
+            lines.append("Total  " + total)
+    return "\n".join(lines) + "\n"
+
+
+def main(argv: list[str]) -> int:
+    args = _parser().parse_args(argv)
+    try:
+        lower = date.fromisoformat(args.date_from) if args.date_from else None
+        upper = date.fromisoformat(args.date_to) if args.date_to else None
+    except ValueError:
+        bad = args.date_from if args.date_from and (not _valid_date(args.date_from)) else args.date_to
+        print(f"error: invalid date: {bad}", file=sys.stderr)
+        return 2
+    if lower and upper and lower > upper:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        source = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    except OSError as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 2
+
+    records, skipped = [], 0
+    for index, row in enumerate(source):
+        try:
+            amount = Decimal(row.get("amount", ""))
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, TypeError, ValueError):
+            skipped += 1
+            continue
+        raw_date = row.get("date", "")
+        try:
+            parsed_date = date.fromisoformat(raw_date)
+        except (ValueError, TypeError):
+            print(f"error: invalid date: {raw_date}", file=sys.stderr)
+            return 2
+        records.append({"date": raw_date, "_date": parsed_date, "category": row.get("category", ""),
+                        "amount": amount, "note": row.get("note", ""), "_index": index})
+
+    categories = {name.casefold() for name in (args.categories or [])}
+    records = [r for r in records if (not categories or r["category"].casefold() in categories)
+               and (not lower or r["_date"] >= lower) and (not upper or r["_date"] <= upper)
+               and (args.minimum is None or _meets_min(r["amount"], args.minimum))]
+    records.sort(key=lambda r: (r["_date"], r["_index"]))
+    if args.top is not None:
+        records = sorted(records, key=lambda r: r["amount"], reverse=True)[:max(0, args.top)]
+
+    total = sum((r["amount"] for r in records), Decimal(0))
+    if args.format == "json":
+        if args.by:
+            objects = [{"group": key, "count": count, "total": float(value)} for key, count, value in _groups(records, args.by)]
+        else:
+            objects = [{"date": r["date"], "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in records]
+        print(json.dumps(objects, indent=2, ensure_ascii=False))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(("date", "category", "amount", "note"))
+        for r in records:
+            writer.writerow((r["date"], r["category"], f"{r['amount']:.2f}", r["note"]))
+    elif not records:
+        print("No expenses.")
+    elif args.by:
+        groups = _groups(records, args.by)
+        label = "Category" if args.by == "category" else "Month"
+        rows = [[key.title() if args.by == "category" else key, str(count), args.currency + _format_amount(value)] for key, count, value in groups]
+        _table.no_header = args.no_header
+        print(_table([label, "Count", "Total"], rows, [2], args.currency + _format_amount(total)), end="")
+    else:
+        rows = []
+        for r in records:
+            amount = r["amount"]
+            rendered = f"({ _money(abs(amount)) })" if amount < 0 else _money(amount)
+            note = r["note"] if len(r["note"]) <= 24 else r["note"][:23] + "…"
+            rows.append([r["date"], r["category"], args.currency + rendered, note])
+        _table.no_header = args.no_header
+        print(_table(["Date", "Category", "Amount", "Note"], rows, [2], args.currency + _format_amount(total)), end="")
+    if skipped:
+        noun = "row" if skipped == 1 else "rows"
+        print(f"warning: skipped {skipped} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _valid_date(value):
+    try:
+        date.fromisoformat(value)
+        return True
+    except (ValueError, TypeError):
+        return False
+
+
+def _meets_min(amount, value):
+    try:
+        return amount >= Decimal(value)
+    except InvalidOperation:
+        return False
+
+
+def _format_amount(amount):
+    rendered = _money(abs(amount)) if amount < 0 else _money(amount)
+    return f"({rendered})" if amount < 0 else rendered
+
+
+def _groups(records, by):
+    grouped = {}
+    for row in records:
+        key = row["category"] if by == "category" else row["date"][:7]
+        count, subtotal = grouped.get(key, (0, Decimal(0)))
+        grouped[key] = (count + 1, subtotal + row["amount"])
+    values = [(key, count, subtotal) for key, (count, subtotal) in grouped.items()]
+    return sorted(values, key=(lambda item: (-item[2], item[0].casefold())) if by == "category" else (lambda item: item[0]))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
