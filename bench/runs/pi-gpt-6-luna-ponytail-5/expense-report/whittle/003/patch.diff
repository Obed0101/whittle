+"""Render expense CSV files as reports."""
+import argparse
+import csv
+from datetime import date
+from decimal import Decimal, InvalidOperation
+import json
+import os
+import sys
+
+from app.expenses import load
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (TypeError, ValueError):
+        raise argparse.ArgumentTypeError(f"invalid date: {value}")
+
+
+def _parser():
+    parser = argparse.ArgumentParser(prog="python -m app.report")
+    parser.add_argument("path")
+    parser.add_argument("--category", action="append", default=[])
+    parser.add_argument("--from", dest="from_date", type=_date)
+    parser.add_argument("--to", dest="to_date", type=_date)
+    parser.add_argument("--min", dest="minimum", type=Decimal)
+    parser.add_argument("--by", choices=("category", "month"))
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table")
+    parser.add_argument("--currency", default="")
+    parser.add_argument("--top", type=int)
+    parser.add_argument("--no-header", action="store_true")
+    return parser
+
+
+def _money(value):
+    return f"{value:,.2f}"
+
+
+def _table(rows, args):
+    if args.by:
+        groups = {}
+        for row in rows:
+            key = row["category"].title() if args.by == "category" else row["date"].strftime("%Y-%m")
+            if key not in groups:
+                groups[key] = [0, Decimal(0)]
+            groups[key][0] += 1
+            groups[key][1] += row["amount"]
+        items = [(key, count, total) for key, (count, total) in groups.items()]
+        if args.by == "category":
+            items.sort(key=lambda x: (-x[2], x[0].casefold()))
+            first = "Category"
+        else:
+            items.sort(key=lambda x: x[0])
+            first = "Month"
+        headers = [first, "Count", "Total"]
+        lines = []
+        if not args.no_header:
+            lines += ["  ".join(headers), "  ".join("-" * len(h) for h in headers)]
+        for key, count, total in items:
+            lines.append(f"{key}  {count}  {args.currency}{_money(total)}")
+        lines.append(f"Total  {len(rows)}  {args.currency}{_money(sum((r['amount'] for r in rows), Decimal(0)))}")
+        return lines
+
+    headers = ["Date", "Category", "Amount", "Note"]
+    data = []
+    for row in rows:
+        note = row["note"] or ""
+        if len(note) > 24:
+            note = note[:23] + "…"
+        amount = row["amount"]
+        shown = f"({abs(amount):,.2f})" if amount < 0 else _money(amount)
+        data.append([row["date"].isoformat(), row["category"], args.currency + shown, note])
+    widths = [max([len(headers[i])] + [len(row[i]) for row in data]) for i in range(4)]
+    amount_width = max(widths[2], *(len(row[2]) for row in data)) if data else widths[2]
+    lines = []
+    if not args.no_header:
+        lines.extend(["  ".join(headers[i].ljust(widths[i]) if i != 2 else headers[i].rjust(amount_width) for i in range(4)),
+                      "  ".join("-" * widths[i] for i in range(4))])
+    for row in data:
+        lines.append("  ".join(row[i].ljust(widths[i]) if i != 2 else row[i].rjust(amount_width) for i in range(4)))
+    total = sum((r["amount"] for r in rows), Decimal(0))
+    shown_total = f"({abs(total):,.2f})" if total < 0 else _money(total)
+    lines.append(f"Total{ ' ' * max(2, widths[0]-5+2)}{args.currency}{shown_total}")
+    return lines
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    if args.from_date and args.to_date and args.from_date > args.to_date:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        source = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    rows, invalid = [], 0
+    for index, row in enumerate(source):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+            day = date.fromisoformat(row["date"])
+        except (InvalidOperation, ValueError, TypeError, KeyError):
+            if "amount" not in row or _is_bad_amount(row.get("amount")):
+                invalid += 1
+                continue
+            print(f"error: invalid date: {row.get('date', '')}", file=sys.stderr)
+            return 2
+        rows.append({"date": day, "category": row["category"], "amount": amount, "note": row.get("note") or "", "_index": index})
+    categories = {c.casefold() for c in args.category}
+    rows = [r for r in rows if (not categories or r["category"].casefold() in categories)
+            and (not args.from_date or r["date"] >= args.from_date)
+            and (not args.to_date or r["date"] <= args.to_date)
+            and (args.minimum is None or r["amount"] >= args.minimum)]
+    if args.top is not None:
+        if args.top < 0:
+            parser.error("--top must be non-negative")
+        rows = sorted(rows, key=lambda r: (-r["amount"], r["_index"]))[:args.top]
+    else:
+        rows.sort(key=lambda r: r["date"])
+    if not rows:
+        print("No expenses.")
+    elif args.format == "json":
+        if args.by:
+            groups = {}
+            for r in rows:
+                key = r["category"] if args.by == "category" else r["date"].strftime("%Y-%m")
+                count, total = groups.get(key, (0, Decimal(0)))
+                groups[key] = (count + 1, total + r["amount"])
+            entries = [{"group": k, "count": c, "total": float(t)} for k, (c, t) in groups.items()]
+            entries.sort(key=lambda x: (-x["total"], x["group"]) if args.by == "category" else (x["group"],))
+        else:
+            entries = [{"date": r["date"].isoformat(), "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in rows]
+        print(json.dumps(entries, indent=2))
+    elif args.format == "csv":
+        writer = csv.writer(sys.stdout, lineterminator="\n")
+        writer.writerow(["date", "category", "amount", "note"])
+        for r in rows:
+            writer.writerow([r["date"].isoformat(), r["category"], f"{r['amount']:.2f}", r["note"]])
+    else:
+        print("\n".join(_table(rows, args)))
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+def _is_bad_amount(value):
+    try:
+        return not Decimal(value).is_finite()
+    except (InvalidOperation, TypeError, ValueError):
+        return True
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
