+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+import json
+import sys
+from datetime import date
+from decimal import Decimal, InvalidOperation
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        self.print_usage(sys.stderr)
+        self.exit(2, f"error: {message}\n")
+
+
+def _parser():
+    parser = Parser(prog="python -m app.report", description="Report expenses from a CSV file.", add_help=False)
+    parser.add_argument("path")
+    parser.add_argument("--help", action="help", help="show this help message and exit")
+    parser.add_argument("--category", action="append", dest="categories", help="keep this category (repeatable)")
+    parser.add_argument("--from", dest="from_date", metavar="DATE", help="include on or after date (YYYY-MM-DD)")
+    parser.add_argument("--to", dest="to_date", metavar="DATE", help="include on or before date (YYYY-MM-DD)")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT", help="minimum amount")
+    parser.add_argument("--by", choices=("category", "month"), help="group expenses by category or month")
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table", help="output format")
+    parser.add_argument("--currency", default="", metavar="SYMBOL", help="table currency symbol")
+    parser.add_argument("--top", type=int, metavar="N", help="show the N largest expenses")
+    parser.add_argument("--no-header", action="store_true", help="omit table header and separator")
+    return parser
+
+
+def _date(value):
+    try:
+        return date.fromisoformat(value)
+    except (ValueError, TypeError):
+        raise ValueError(value)
+
+
+def _money(value):
+    return f"{value:.2f}"
+
+
+def _table(headers, rows, amount_columns=(), currency="", no_header=False):
+    rendered = [[str(item) for item in row] for row in rows]
+    widths = [len(h) for h in headers]
+    for row in rendered:
+        for i, cell in enumerate(row):
+            widths[i] = max(widths[i], len(cell))
+    lines = []
+    if not no_header:
+        lines.append("  ".join(h.ljust(widths[i]) for i, h in enumerate(headers)).rstrip())
+        lines.append("  ".join("-" * w for w in widths).rstrip())
+    for row in rendered:
+        cells = []
+        for i, cell in enumerate(row):
+            if i in amount_columns:
+                cells.append(cell.rjust(widths[i]))
+            else:
+                cells.append(cell.ljust(widths[i]))
+        lines.append("  ".join(cells).rstrip())
+    return "\n".join(lines)
+
+
+def main(argv: list[str]) -> int:
+    parser = _parser()
+    args = parser.parse_args(argv)
+    try:
+        start = _date(args.from_date) if args.from_date else None
+        end = _date(args.to_date) if args.to_date else None
+    except ValueError as exc:
+        print(f"error: invalid date: {exc}", file=sys.stderr)
+        return 2
+    if start and end and start > end:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    try:
+        source = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    valid, skipped = [], 0
+    for index, row in enumerate(source):
+        try:
+            amount = Decimal(row["amount"])
+            if not amount.is_finite():
+                raise InvalidOperation
+        except (InvalidOperation, ValueError, KeyError, TypeError):
+            skipped += 1
+            continue
+        try:
+            row_date = _date(row["date"])
+        except (ValueError, KeyError):
+            continue
+        record = {"date": row["date"], "category": row.get("category", ""), "amount": amount, "note": row.get("note", ""), "_date": row_date, "_index": index}
+        if args.categories and record["category"].casefold() not in {x.casefold() for x in args.categories}:
+            continue
+        if start and row_date < start or end and row_date > end:
+            continue
+        try:
+            if args.minimum is not None and amount < Decimal(args.minimum):
+                continue
+        except InvalidOperation:
+            print("error: --min must be a number", file=sys.stderr)
+            return 2
+        valid.append(record)
+    if args.top is not None:
+        valid = sorted(valid, key=lambda r: (-r["amount"], r["_index"]))[:max(0, args.top)]
+    else:
+        valid.sort(key=lambda r: (r["_date"], r["_index"]))
+    total = sum((r["amount"] for r in valid), Decimal(0))
+    if args.by:
+        grouped = {}
+        for r in valid:
+            key = r["category"].title() if args.by == "category" else r["date"][:7]
+            grouped.setdefault(key, []).append(r["amount"])
+        entries = [(key, len(vals), sum(vals, Decimal(0))) for key, vals in grouped.items()]
+        if args.by == "category":
+            entries.sort(key=lambda x: (-x[2], x[0].casefold()))
+        else:
+            entries.sort(key=lambda x: x[0])
+        if not entries:
+            print("No expenses.")
+        elif args.format == "json":
+            print(json.dumps([{"group": k, "count": n, "total": float(v)} for k, n, v in entries], indent=2))
+        elif args.format == "csv":
+            w = csv.writer(sys.stdout, lineterminator="\n"); w.writerow(["group", "count", "total"])
+            for k, n, v in entries: w.writerow([k, n, _money(v)])
+        else:
+            label = "Category" if args.by == "category" else "Month"
+            rows = [[k, n, args.currency + _money(v)] for k, n, v in entries]
+            rows.append(["Total", "", args.currency + _money(total)])
+            print(_table([label, "Count", "Total"], rows, (2,), no_header=args.no_header))
+    elif not valid:
+        print("No expenses.")
+    elif args.format == "json":
+        print(json.dumps([{k: (float(r["amount"]) if k == "amount" else r[k]) for k in ("date", "category", "amount", "note")} for r in valid], indent=2))
+    elif args.format == "csv":
+        w = csv.writer(sys.stdout, lineterminator="\n"); w.writerow(["date", "category", "amount", "note"])
+        for r in valid: w.writerow([r["date"], r["category"], _money(r["amount"]), r["note"]])
+    else:
+        rows = []
+        for r in valid:
+            amount = r["amount"]
+            shown = f"({args.currency}{abs(amount):,.2f})" if amount < 0 else f"{args.currency}{amount:,.2f}"
+            note = r["note"] if len(r["note"]) <= 24 else r["note"][:23] + "…"
+            rows.append([r["date"], r["category"], shown, note])
+        rows.append(["Total", "", f"{args.currency}{total:,.2f}" if total >= 0 else f"({args.currency}{abs(total):,.2f})", ""])
+        print(_table(["Date", "Category", "Amount", "Note"], rows, (2,), no_header=args.no_header))
+    if skipped:
+        noun = "row" if skipped == 1 else "rows"
+        print(f"warning: skipped {skipped} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
