+"""Render expense CSV files as tables, JSON, or CSV."""
+import argparse
+import csv
+import datetime as dt
+import json
+import sys
+from decimal import Decimal, InvalidOperation
+
+from app.expenses import load
+
+
+class Parser(argparse.ArgumentParser):
+    def error(self, message):
+        self.print_usage(sys.stderr)
+        self.exit(2, f"error: {message}\n")
+
+
+def _date(value):
+    try:
+        return dt.date.fromisoformat(value)
+    except (ValueError, TypeError):
+        raise ValueError(value)
+
+
+def _amount(value):
+    try:
+        number = Decimal(value)
+        if not number.is_finite():
+            raise InvalidOperation
+        return number
+    except (InvalidOperation, TypeError, ValueError):
+        return None
+
+
+def _money(amount, currency=""):
+    if amount < 0:
+        return f"({currency}{abs(amount):,.2f})"
+    return f"{currency}{amount:,.2f}"
+
+
+def _table(headers, rows, right_columns=()):
+    count = len(headers) if headers is not None else len(rows[0])
+    widths = [max(([len(str(headers[i]))] if headers is not None else [0]) + [len(str(row[i])) for row in rows]) for i in range(count)]
+    lines = []
+    if headers is not None:
+        lines.append("  ".join(str(v).ljust(widths[i]) for i, v in enumerate(headers)).rstrip())
+        lines.append("  ".join("-" * widths[i] for i in range(len(headers))))
+    for row in rows:
+        lines.append("  ".join(str(value).rjust(widths[i]) if i in right_columns else str(value).ljust(widths[i]) for i, value in enumerate(row)).rstrip())
+    return lines
+
+
+def main(argv: list[str]) -> int:
+    parser = Parser(prog="python -m app.report", description="Create a report from an expense CSV.")
+    parser.add_argument("path", nargs="?")
+    parser.add_argument("--category", action="append", dest="categories", help="keep this category (repeatable)")
+    parser.add_argument("--from", dest="date_from", metavar="DATE", help="include expenses on or after DATE")
+    parser.add_argument("--to", dest="date_to", metavar="DATE", help="include expenses on or before DATE")
+    parser.add_argument("--min", dest="minimum", metavar="AMOUNT", help="keep expenses of at least AMOUNT")
+    parser.add_argument("--by", choices=("category", "month"), help="group by category or month")
+    parser.add_argument("--format", choices=("table", "json", "csv"), default="table", help="output format")
+    parser.add_argument("--currency", default="", metavar="SYMBOL", help="table currency symbol")
+    parser.add_argument("--top", type=int, metavar="N", help="show the N largest expenses")
+    parser.add_argument("--no-header", action="store_true", help="omit table header and separator")
+    args = parser.parse_args(argv)
+    if not args.path:
+        parser.error("the following arguments are required: PATH")
+    try:
+        lower = _date(args.date_from) if args.date_from else None
+        upper = _date(args.date_to) if args.date_to else None
+    except ValueError as exc:
+        print(f"error: invalid date: {exc.args[0]}", file=sys.stderr)
+        return 2
+    if lower and upper and lower > upper:
+        print("error: --from is after --to", file=sys.stderr)
+        return 2
+    minimum = None
+    if args.minimum is not None:
+        minimum = _amount(args.minimum)
+        if minimum is None:
+            print(f"error: invalid amount: {args.minimum}", file=sys.stderr)
+            return 2
+    try:
+        raw = load(args.path)
+    except FileNotFoundError:
+        print(f"error: file not found: {args.path}", file=sys.stderr)
+        return 2
+    invalid = 0
+    records = []
+    for index, row in enumerate(raw):
+        amount = _amount(row.get("amount", ""))
+        if amount is None:
+            invalid += 1
+            continue
+        try:
+            day = _date(row.get("date", ""))
+        except ValueError as exc:
+            print(f"error: invalid date: {exc.args[0]}", file=sys.stderr)
+            return 2
+        records.append({"date": day, "category": row.get("category", ""), "amount": amount, "note": row.get("note", ""), "index": index})
+    if args.top is not None:
+        if args.top < 0:
+            parser.error("--top must be non-negative")
+    filtered = [r for r in records if (not args.categories or r["category"].casefold() in {c.casefold() for c in args.categories}) and (lower is None or r["date"] >= lower) and (upper is None or r["date"] <= upper) and (minimum is None or r["amount"] >= minimum)]
+    if args.top is not None:
+        filtered = sorted(filtered, key=lambda r: -r["amount"])[:args.top]
+    else:
+        filtered.sort(key=lambda r: (r["date"], r["index"]))
+    output = []
+    total = sum((r["amount"] for r in filtered), Decimal(0))
+    if not filtered:
+        output = ["No expenses."]
+    elif args.format == "json":
+        if args.by:
+            groups = {}
+            for r in filtered:
+                key = r["category"].title() if args.by == "category" else r["date"].strftime("%Y-%m")
+                groups.setdefault(key, []).append(r["amount"])
+            ordered = sorted(groups.items(), key=(lambda item: (-sum(item[1]), item[0].casefold())) if args.by == "category" else (item[0],))
+            data = [{"group": key, "count": len(vals), "total": float(sum(vals))} for key, vals in ordered]
+        else:
+            data = [{"date": r["date"].isoformat(), "category": r["category"], "amount": float(r["amount"]), "note": r["note"]} for r in filtered]
+        output = [json.dumps(data, indent=2, ensure_ascii=False)]
+    elif args.format == "csv":
+        import io
+        stream = io.StringIO(newline="")
+        writer = csv.writer(stream, lineterminator="\n")
+        writer.writerow(("date", "category", "amount", "note"))
+        for r in filtered:
+            writer.writerow((r["date"].isoformat(), r["category"], f"{r['amount']:.2f}", r["note"]))
+        output = [stream.getvalue().rstrip("\n")]
+    elif args.by:
+        groups = {}
+        for r in filtered:
+            key = r["category"].title() if args.by == "category" else r["date"].strftime("%Y-%m")
+            groups.setdefault(key, []).append(r["amount"])
+        ordered = sorted(groups.items(), key=(lambda item: (-sum(item[1]), item[0].casefold())) if args.by == "category" else (lambda item: item[0]))
+        first = "Category" if args.by == "category" else "Month"
+        rows = [(name, str(len(vals)), _money(sum(vals), args.currency)) for name, vals in ordered]
+        if not args.no_header:
+            output.extend(_table((first, "Count", "Total"), rows, (1, 2)))
+        else:
+            output.extend(_table(None, rows, (1, 2)))
+        output.append(f"Total  {_money(total, args.currency)}")
+    else:
+        rows = [(r["date"].isoformat(), r["category"], _money(r["amount"], args.currency), r["note"] if len(r["note"]) <= 24 else r["note"][:23] + "…") for r in filtered]
+        if not args.no_header:
+            output.extend(_table(("Date", "Category", "Amount", "Note"), rows, (2,)))
+        else:
+            output.extend(_table(None, rows, (2,)))
+        output.append(f"Total  {_money(total, args.currency)}")
+    print("\n".join(output))
+    if invalid:
+        noun = "row" if invalid == 1 else "rows"
+        print(f"warning: skipped {invalid} {noun} with invalid amount", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
