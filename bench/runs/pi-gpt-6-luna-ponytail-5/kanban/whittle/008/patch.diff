+<section class="toolbar" aria-label="Board controls"><label class="search"><span>⌕</span><input id="search" type="search" placeholder="Find a task…" aria-label="Find a task"><kbd>⌘ K</kbd></label><div class="filters"><select id="labelFilter" aria-label="Filter by label"><option value="">All labels</option></select><select id="sort" aria-label="Sort tasks"><option value="manual">Board order</option><option value="due">Due date</option><option value="priority">Priority</option><option value="newest">Recently added</option></select><button id="filterToggle" class="filter-toggle" aria-pressed="false">☷ <span>Filters</span></button></div></section>
