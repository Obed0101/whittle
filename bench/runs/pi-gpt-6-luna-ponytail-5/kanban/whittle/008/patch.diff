+$('#menuBtn').onclick=()=>$('#menu').hidden=!$('#menu').hidden;document.addEventListener('click',e=>{if(!e.target.closest('.top-actions'))$('#menu').hidden=true});$('#themeBtn').onclick=()=>{document.body.classList.toggle('dark');localStorage.setItem('daymark-theme',document.body.classList.contains('dark')?'dark':'light')};if(localStorage.getItem('daymark-theme')==='dark')document.body.classList.add('dark');
