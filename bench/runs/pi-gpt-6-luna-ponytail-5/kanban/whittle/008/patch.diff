+function cardHTML(t){let late=t.due&&t.due<today()&&t.column!=='done';return `<article class="card" draggable="true" data-id="${t.id}" tabindex="0"><div class="card-top"><h3>${esc(t.title)}</h3><button class="small-btn card-menu" aria-label="Edit ${esc(t.title)}">···</button></div>${t.description?`<p class="card-desc">${esc(t.description)}</p>`:''}${t.labels?.length?`<div class="tags">${t.labels.map(x=>`<span class="tag">${esc(x)}</span>`).join('')}</div>`:''}<div class="card-foot"><span class="due ${late?'late':''}">${t.due?`${late?'Overdue · ':''}${new Date(t.due+'T00:00:00').toLocaleDateString(undefined,{month:'short',day:'numeric'})}`:''}</span><span class="priority priority-${t.priority}">${t.priority==='medium'?'':t.priority}</span></div></article>`}
