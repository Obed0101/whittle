+<script>
+(()=>{'use strict';const KEY='daymark-board-v1', statuses=[['todo','To do'],['doing','In progress'],['done','Done'],['later','Someday']];let state={tasks:[],archived:[],theme:'light'},editing=null,archiveView=false,undoSnapshot=null,toastTimer;const $=s=>document.querySelector(s), esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function persist(){try{localStorage.setItem(KEY,JSON.stringify(state))}catch{notify('Could not save — browser storage may be full.')}}function load(){try{const x=JSON.parse(localStorage.getItem(KEY));if(x&&Array.isArray(x.tasks))state={tasks:x.tasks.filter(valid),archived:Array.isArray(x.archived)?x.archived.filter(valid):[],theme:x.theme==='dark'?'dark':'light'}}catch{}if(!localStorage.getItem(KEY)){state.tasks=[{id:id(),title:'Plan the week',description:'Pick three things that would make this week feel successful.',status:'todo',due:'',labels:['Planning'],created:Date.now()-5000},{id:id(),title:'Make space for a walk',description:'A short reset away from the screen.',status:'doing',due:'',labels:['Personal'],created:Date.now()-3000}]}document.body.classList.toggle('dark',state.theme==='dark');persist()}function valid(t){return t&&typeof t.id==='string'&&typeof t.title==='string'&&statuses.some(s=>s[0]===t.status)}function id(){return Math.random().toString(36).slice(2,10)+Date.now().toString(36)}function snapshot(){undoSnapshot=JSON.stringify(state);$('#undoBtn').disabled=false}function notify(s){const e=$('#toast');e.textContent=s;e.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>e.classList.remove('show'),2600)}function render(){const query=$('#search').value.trim().toLowerCase(),label=$('#labelFilter').value,sort=$('#sort').value;let tasks=archiveView?state.archived:state.tasks;const allLabels=[...new Set([...state.tasks,...state.archived].flatMap(t=>t.labels||[]))].sort((a,b)=>a.localeCompare(b));const select=$('#labelFilter'),old=select.value;select.inn