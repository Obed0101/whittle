join('')}</div>${due?`<span class="due ${late?'overdue':t.due===today?'soon':''}" title="Due ${esc(t.due)}">${late?'Overdue · ':''}${esc(due)}</span>`:''}</div></article>`}function openModal(task=null,status='todo'){editing=task?.id||null;$('#modalTitle').textContent=task?'Edit task':'New task';$('#titleInput').value=task?.title||'';$('#descInput').value=task?.description||'';$('#statusInput').value=task?.status||status;$('#dueInput').value=task?.due||'';$('#labelsInput').value=(task?.labels||[]).join(', ');$('#deleteBtn').hidden=!task;$('#modalBack').classList.add('show');$('#titleInput').focus()}function closeModal(){$('#modalBack').classList.remove('show')}$('#board').addEventListener('click',e=>{const add=e.target.closest('[data-add]');if(add)return openModal(null,add.dataset.add);const c=e.target.closest('.card');if(c){let t=(archiveView?state.archived:state.tasks).find(x=>x.id===c.dataset.id);if(t)openModal(t)}});$('#taskForm').addEventListener('submit',e=>{e.preventDefault();const t={id:editing||id(),title:$('#titleInput').value.trim(),description:$('#descInput').value.trim(),status:$('#statusInput').value,due:$('#dueInput').value,labels:[...new Set($('#labelsInput').value.split(',').map(x=>x.trim()).filter(Boolean))],created:editing?(state.tasks.find(x=>x.id===editing)||{}).created||Date.now():Date.now()};if(!t.title)return;snapshot();let arr=archiveView?state.archived:state.tasks;if(editing)arr.splice(arr.findIndex(x=>x.id===editing),1,t);else arr.push(t);persist();closeModal();render();notify(editing?'Task updated':'Task added')});$('#deleteBtn').onclick=()=>{if(!editing)return;snapshot();state.tasks=state.tasks.filter(t=>t.id!==editing);state.archived=state.archived.filter(t=>t.id!==editing);persist();closeModal();render();notify('Task deleted')};$('#cancelBtn').onclick=closeModal;$('#modalBack').addEventListener('click',e=>{if(e.target===$('#modalBack'))closeModal()});document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeModal();$('#menuPop').classList.remove('open')}if(e.key==='/'&&!/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)){e.preventDefault();$('#search').focus()}if(e.key.toLowerCase()==='n'&&!e.ctrlKey&&!e.metaKey&&!/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)){e.preventDefault();openModal()}});$('#board').addEventListener('dragstart',e=>{const c=e.target.closest('.card');if(c){e.dataTransfer.setData('text/plain',c.dataset.id);e.dataTransfer.effectAllowed='move';c.classList.add('dragging')}});$('#board').addEventListener('dragend',e=>e.target.closest('.card')?.classList.remove('dragging'));$('#board').addEventListener('dragover',e=>{const target=e.target.closest('.cards');if(target){e.preventDefault();target.classList.add('over')}});$('#board').addEventListener('dragleave',e=>{if(e.target.matches('.cards'))e.target.classList.remove('over')});$('#board').addEventListener('drop',e=>{const target=e.target.closest('.cards');if(!target)return;e.preventDefault();target.classList.remove('over');const t=state.tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t&&t.status!==target.dataset.drop){snapshot();t.status=target.dataset.drop;persist();render();notify('Task moved')}});$('#search').oninput=render;$('#labelFilter').onchange=render;$('#sort').onchange=render;$('#clearFilters').onclick=()=>{$('#search').value='';$('#labelFilter').value='';$('#sort').value='manual';render()};$('#undoBtn').onclick=()=>{if(!undoSnapshot)return;state=JSON.parse(undoSnapshot);undoSnapshot=null;$('#undoBtn').disabled=true;persist();render();notify('Undone')};$('#menuBtn').onclick=()=>{$('#menuPop').classList.toggle('open');$('#menuBtn').setAttribute('aria-expanded',$('#menuPop').classList.contains('open'))};document.addEventListener('click',e=>{if(!e.target.closest('.menu'))$('#menuPop').classList.remove('open')});$('#themeBtn').onclick=()=>{state.theme=state.theme==='dark'?'light':'dark';document.body.classList.toggle('dark',state.theme==='dark');persist();render()};$('#archiveBtn').onclick=()=>{archiveView=!archiveView;$('#menuPop').classList.remove('open');render()};$('#exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify({format:'daymark',version:1,exportedAt:new Date().toISOString(),...state},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='daymark-board-'+new Date().toISOString().slice(0,10)+'.json';a.click();URL.revokeObjectURL(a.href);notify('Board exported')};$('#importBtn').onclick=()=>$('#fileInput').click();$('#fileInput').onchange=async e=>{const file=e.target.files[0];if(!file)return;try{const d=JSON.parse(await file.text()),tasks=d.tasks,archived=d.archived||[];if(!Array.isArray(tasks)||!tasks.every(valid)||!Array.isArray(archived)||!archived.every(valid))throw Error();snapshot();state={tasks,archived,theme:d.theme==='dark'?'dark':'light'};document.body.classList.toggle('dark',state.theme==='dark');persist();render();notify('Backup restored')}catch{notify('That file is not a valid Daymark backup')}e.target.value=''};load();render()})();
