+(()=>{'use strict';const KEY='daymark-board-v1',columns=[['todo','To do'],['doing','In progress'],['waiting','Up next'],['done','Done']];let tasks=[],undoTimer,dragId=null;const $=s=>document.querySelector(s), board=$('#board');
+const seed=[{title:'Plan the week ahead',description:'Pick three priorities and leave room to breathe.',status:'todo',label:'Personal',due:dateOffset(1)},{title:'Send project update',description:'Share the latest milestones with the team.',status:'todo',label:'Work',due:dateOffset(2)},{title:'Book a dentist appointment',description:'Find a time that works next week.',status:'todo',label:'Errands',due:''},{title:'Review the design notes',description:'',status:'doing',label:'Focus',due:dateOffset(0)},{title:'Sort out travel details',description:'Confirm train times and accommodation.',status:'waiting',label:'Personal',due:dateOffset(4)},{title:'Refill prescription',description:'',status:'done',label:'Errands',due:''}];function dateOffset(n){const d=new Date();d.setDate(d.getDate()+n);return d.toISOString().slice(0,10)}function save(){try{localStorage.setItem(KEY,JSON.stringify(tasks))}catch(e){toast('Could not save: browser storage is full.')}}function init(){try{const x=JSON.parse(localStorage.getItem(KEY));tasks=Array.isArray(x)?x:[]}catch{tasks=[]}if(!localStorage.getItem(KEY)){tasks=seed.map((t,i)=>({...t,id:crypto.randomUUID(),created:Date.now()-i}));save()}columns.forEach(([id,name])=>$('#status').insertAdjacentHTML('beforeend',`<option value="${id}">${name}</option>`));render()}function escape(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function fmt(d){if(!d)return '';return new Date(d+'T00:00:00').toLocaleDateString(undefined,{month:'short',day:'numeric'})}function render(){board.innerHTML='';let filtered=tasks.filter(t=>(!$('#search').value||(`${t.title} ${t.description}`).toLowerCase().includes($('#search').value.toLowerCase()))&&(!$('#filterTag').value||t.label===$('#filterTag').value));columns.forEach(([id,name])=>{let list=filtered.filter(t=>t.status===id);if($('#sort').value==='due')list.sort((a,b)=>(a.due||'9999').localeCompare(b.due||'9999'));if($('#sort').value==='created')list.sort