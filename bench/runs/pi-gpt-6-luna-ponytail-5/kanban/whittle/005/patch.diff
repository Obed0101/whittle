+function cardEl(t){const el=document.createElement('article');el.className='card';el.draggable=true;el.setAttribute('role','listitem');el.innerHTML=`<h3>${escape(t.title)}</h3>${t.description?`<p>${escape(t.description)}</p>`:''}<div class="tags">${t.label?`<span class="tag ${t.label==='Focus'?'rose':t.label==='Work'?'amber':''}">${escape(t.label)}</span>`:''}</div><div class="cardfoot"><span class="due ${t.due&&t.due<dateOffset(0)&&t.status!=='done'?'overdue':''}">${t.due?'◷ '+fmt(t.due):''}</span><span>${t.status==='done'?'✓':''}</span></div>`;el.onclick=()=>openForm(t.id);el.addEventListener('dragstart',()=>{dragId=t.id;el.classList.add('dragging')});el.addEventListener('dragend',()=>el.classList.remove('dragging'));return el}
