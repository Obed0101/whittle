+<body><div class="app"><header class="topbar"><div class="brand"><span class="logo">✳</span> daymark</div><nav class="nav" aria-label="Main"><button class="active">My board</button></nav><button class="profile" id="themeBtn" title="Toggle dark mode"><span class="avatar">Y</span><span>My space</span>⌄</button></header><main><div class="toolbar"><div class="heading"><h1>My board</h1><p id="summary">A little progress, every day.</p></div><div class="search"><input id="search" type="search" placeholder="Search tasks…" aria-label="Search tasks"></div><div class="filters"><select id="filterTag" aria-label="Filter by label"><option value="">All labels</option><option>Work</option><option>Personal</option><option>Focus</option><option>Errands</option></select><select id="sort" aria-label="Sort tasks"><option value="manual">Manual order</option><option value="due">Due date</option><option value="created">Recently added</option></select></div><button class="btn primary" id="newTask">＋ Add task</button><button class="btn" id="menuBtn" title="Board options">···</button></div><p class="mobile-hint">Drag tasks between columns to update their status.</p><section class="board" id="board" aria-label="Kanban board"></section></main></div>
