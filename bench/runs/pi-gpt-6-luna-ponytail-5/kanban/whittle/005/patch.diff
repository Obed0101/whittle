+$('#taskForm').onsubmit=e=>{e.preventDefault();let id=$('#taskId').value,t=tasks.find(x=>x.id===id),old=t?{...t}:null,data={title:$('#title').value.trim(),description:$('#description').value.trim(),status:$('#status').value,label:$('#label').value,due:$('#due').value};if(t)Object.assign(t,data);else tasks.unshift({...data,id:crypto.randomUUID(),created:Date.now()});save();closeForm();render();if(t)toast('Task updated',()=>{Object.assign(t,old);save();render()})};$('#deleteTask').onclick=()=>{let id=$('#taskId').value,t=tasks.find(x=>x.id===id),idx=tasks.indexOf(t);tasks.splice(idx,1);save();closeForm();render();toast('Task deleted',()=>{tasks.splice(idx,0,t);save();render()})};$('#cancel').onclick=closeForm;$('#modalBack').onclick=e=>{if(e.target===$('#modalBack'))closeForm()};document.onkeydown=e=>{if(e.key==='Escape')closeForm();if((e.metaKey||e.ctrlKey)&&e.key==='Enter'&&$('#modalBack').classList.contains('open'))$('#taskForm').requestSubmit()};$('#newTask').onclick=()=>openForm();$('#search').oninput=render;$('#filterTag').onchange=render;$('#sort').onchange=render;$('#themeBtn').onclick=()=>{document.body.classList.toggle('theme-dark');localStorage.setItem('daymark-dark',document.body.classList.contains('theme-dark'))};if(localStorage.getItem('daymark-dark')==='true')document.body.classList.add('theme-dark');$('#menuBtn').onclick=()=>{const a=prompt('Board options: type export or import','export');if(a==='export'){const blob=new Blob([JSON.stringify({version:1,tasks},null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),link=document.createElement('a');link.href=url;link.download='daymark-board.json';link.click();URL.revokeObjectURL(url)}else if(a==='import'){const input=document.createElement('input');input.type='file';input.accept='.json,application/json';input.onchange=()=>{const f=input.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const x=JSON.parse(r.result),arr=Array.isArray(x)?x:x.tasks;if(!Array.isArray(arr)||arr.some(t=>!t.title||!columns.some(c=>c[0]===t.status)))throw Error();tasks=arr.map(t=>({...t,id:t.id||crypto.randomUUID(),created:t.created||Date.now()}));save();render();toast('Board imported')}catch{toast('Import failed: file is not a valid board')}};r.readAsText(f)};input.click()}};init()})();
