ont-weight:700}.dot{width:8px;height:8px;border-radius:50%;background:#9da69f}.column[data-status="doing"] .dot{background:#d39b4d}.column[data-status="done"] .dot{background:#5c9470}.count{color:var(--muted);font-size:12px;font-weight:500}.tasklist{min-height:40px}.card{background:var(--surface);border:1px solid var(--line);box-shadow:var(--shadow);border-radius:10px;padding:13px;margin-bottom:9px;cursor:grab}.card:active{cursor:grabbing}.card.dragging{opacity:.4}.cardtitle{font-weight:650;font-size:14px;line-height:1.4;display:flex;gap:8px;align-items:flex-start}.check{appearance:none;flex:none;margin:2px 0 0;width:15px;height:15px;border:1.5px solid #b8c0b9;border-radius:5px;cursor:pointer}.check:checked{background:var(--accent);border-color:var(--accent)}.check:checked:after{content:'✓';display:block;color:white;font-size:11px;text-align:center;line-height:13px}.done-card .cardtitle span{text-decoration:line-through;color:var(--muted)}.desc{color:var(--muted);font-size:12px;margin:8px 0 0 23px;white-space:pre-wrap;overflow-wrap:anywhere}.meta{margin:12px 0 0 23px;display:flex;align-items:center;gap:7px;flex-wrap:wrap}.tag{font-size:10px;background:#f0f2ed;color:#58645b;padding:3px 7px;border-radius:20px}.date{font-size:11px;color:var(--muted)}.date.overdue{color:#bd594d}.cardfoot{display:flex;justify-content:space-between;margin-top:11px;padding-top:8px;border-top:1px solid #f0f1ed}.cardfoot button{border:0;background:none;color:var(--muted);padding:2px 4px;font-size:12px}.cardfoot button:hover{color:var(--ink)}.addtask{border:0;background:transparent;color:var(--muted);font-size:13px;padding:9px 4px;width:100%;text-align:left;border-radius:7px}.addtask:hover{background:#e5e7e0;color:var(--ink)}.empty{padding:20px 8px;text-align:center;color:#939a94;font-size:12px}.bottom{display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:12px;padding:8px 2px}.textbtn{border:0;background:none;color:var(--muted);padding:5px}.textbtn:hover{c