+<script>
+(()=>{'use strict';const KEY='daymark-board-v1', statuses=[['todo','To do'],['doing','In progress'],['done','Done']];let tasks=[],undo=null,toastTimer;const $=s=>document.querySelector(s);const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(tasks))}catch{notify('Could not save. Export a backup to protect your changes.')}};function load(){try{const d=JSON.parse(localStorage.getItem(KEY)||'[]');tasks=Array.isArray(d)?d.filter(t=>t&&typeof t.id==='string'&&typeof t.title==='string'&&statuses.some(s=>s[0]===t.status)).map(t=>({...t,tags:Array.isArray(t.tags)?t.tags:[]})):[]}catch{tasks=[]}}function notify(s){const el=$('#toast');el.textContent=s;el.hidden=false;clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.hidden=true,2600)}const today=new Date();$('#today').textContent=today.toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'});
+function render(){const q=$('#search').value.trim().toLowerCase();const board=$('#board');board.innerHTML='';statuses.forEach(([key,label])=>{const list=tasks.filter(t=>t.status===key&&(!q||[t.title,t.description,...t.tags].join(' ').toLowerCase().includes(q)));const col=document.createElement('section');col.className='column';col.dataset.status=key;col.innerHTML=`<div class="colhead"><div class="colname"><i class="dot"></i>${label}<span class="count">${tasks.filter(t=>t.status===key).length}</span></div><button class="textbtn" aria-label="Add task to ${label}" data-add="${key}">＋</button></div><div class="tasklist" data-drop="${key}"></div><button class="addtask" data-add="${key}">＋ Add a task</button>`;const listEl=col.querySelector('.tasklist');if(!list.length)listEl.innerHTML=`<div class="empty">${q?'No matching tasks':'Nothing here yet'}</div>`;list.forEach(t=>{const card=document.createElement('article');card.className='card'+(t.status==='done'?' done-card':'');card.draggable=true;card.dataset.id=t.id;const overdue=t.due&&t.due<new Date().toISOString().slice(0,10)&&t.status!=='done';card.innerHTML=`<div class="cardtitle"><input class="check" type="checkbox" aria-label="Mark ${esc(t.title)} complete" ${t.status==='done'?'checked':''}><span>${esc(t.title)}</span></div>${t.description?`<p class="desc">${esc(t.description)}</p>`:''}${t.due||t.tags.length?`<div class="meta">${t.due?`<span class="date ${overdue?'overdue':''}">${overdue?'Overdue · ':''}${new Date(t.due+'T00:00:00').toLocaleDateString(undefined,{month:'short',day:'numeric'})}</span>`:''}${t.tags.map(x=>`<span class="tag">${esc(x)}</span>`).join('')}</div>`:''}<div class="cardfoot"><button data-edit="${esc(t.id)}">Edit</button><button data-move="${esc(t.id)}">Move →</button></div>`;card.addEventListener('dragstart',e=>{card.classList.add('dragging');e.dataTransfer.setData('text/plain',t.id);e.dataTransfer.effectAllowed='move'});card.addEventListener('dragend',()=>card.classList.remove('dragging'));listEl.append(card)});board.append(col)});$('#activeCount').textContent=tasks.filter(t=>t.status!=='done').length;$('#doneCount').textContent=tasks.filter(t=>t.status==='done').length;$('#overdueCount').textContent=tasks.filter(t=>t.due&&t.due<new Date().toISOString().slice(0,10)&&t.status!=='done').length;$('#undoBtn').disabled=!undo}
+function openForm(t=null,status='todo'){const form=$('#taskForm');form.reset();$('#taskId').value=t?.id||'';$('#title').value=t?.title||'';$('#description').value=t?.description||'';$('#status').value=t?.status||status;$('#due').value=t?.due||'';$('#tags').value=(t?.tags||[]).join(', ');$('#formTitle').textContent=t?'Edit task':'New task';$('#deleteBtn').hidden=!t;$('#modal').hidden=false;$('#title').focus()}function closeForm(){$('#modal').hidden=true;$('#newBtn').focus()}
+$('#board').addEventListener('click',e=>{const add=e.target.closest('[data-add]');if(add)return openForm(null,add.dataset.add);const edit=e.target.closest('[data-edit]');if(edit)return openForm(tasks.find(t=>t.id===edit.dataset.edit));const move=e.target.closest('[data-move]');if(move){const t=tasks.find(t=>t.id===move.dataset.move);t.status=statuses[(statuses.findIndex(s=>s[0]===t.status)+1)%3][0];save();render();notify('Task moved')}});$('#board').addEventListener('change',e=>{if(e.target.matches('.check')){const card=e.target.closest('[data-id]'),t=tasks.find(t=>t.id===card.dataset.id);t.status=e.target.checked?'done':'todo';save();render()}});$('#board').addEventListener('dragover',e=>{const drop=e.target.closest('[data-drop]');if(drop){e.preventDefault();e.dataTransfer.dropEffect='move'}});$('#board').addEventListener('drop',e=>{const drop=e.target.closest('[data-drop]');if(!drop)return;e.preventDefault();const t=tasks.find(t=>t.id===e.dataTransfer.getData('text/plain'));if(t){t.status=drop.dataset.drop;save();render()}});$('#search').addEventListener('input',render);$('#newBtn').onclick=()=>openForm();$('#cancelBtn').onclick=closeForm;$('#modal').addEventListener('click',e=>{if(e.target===$('#modal'))closeForm()});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!$('#modal').hidden)closeForm();if((e.metaKey||e.ctrlKey)&&e.key==='Enter'&&!$('#modal').hidden)$('#taskForm').requestSubmit()});$('#taskForm').addEventListener('submit',e=>{e.preventDefault();const id=$('#taskId').value,existing=tasks.find(t=>t.id===id),task={id:id||crypto.randomUUID?.()||String(Date.now()),title:$('#title').value.trim(),description:$('#description').value.trim(),status:$('#status').value,due:$('#due').value,tags:$('#tags').value.split(',').map(x=>x.trim()).filter(Boolean).slice(0,8)};if(existing)Object.assign(existing,task);else tasks.unshift(task);save();render();closeForm();notify(existing?'Task updated':'Task added')});$('#deleteBtn').onclick=()=>{const id=$('#taskId').value;undo=tasks.find(t=>t.id===id);tasks=tasks.filter(t=>t.id!==id);save();render();closeForm();notify('Task deleted · use Undo to restore')};$('#undoBtn').onclick=()=>{if(undo){tasks.push(undo);undo=null;save();render();notify('Task restored')}};$('#clearDone').onclick=()=>{const done=tasks.filter(t=>t.status==='done');if(!done.length)return notify('No completed tasks to clear');if(!confirm(`Permanently clear ${done.length} completed ${done.length===1?'task':'tasks'}?`))return;tasks=tasks.filter(t=>t.status!=='done');undo=done.length===1?done[0]:null;save();render();notify(done.length===1?'Completed task cleared · use Undo to restore':'Completed tasks cleared')};$('#exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify({format:'daymark',version:1,exportedAt:new Date().toISOString(),tasks},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`daymark-backup-${new Date().toISOString().slice(0,10)}.json`;a.click();URL.revokeObjectURL(a.href);notify('Backup downloaded')};$('#importBtn').onclick=()=>$('#importFile').click();$('#importFile').onchange=async e=>{const file=e.target.files[0];if(!file)return;try{const data=JSON.parse(await file.text()),incoming=Array.isArray(data)?data:data.tasks;if(!Array.isArray(incoming)||!incoming.every(t=>t&&typeof t.title==='string'&&statuses.some(s=>s[0]===t.status)))throw Error();if(!confirm(`Import ${incoming.length} tasks? This replaces the tasks on this device.`))return;tasks=incoming.map(t=>({id:typeof t.id==='string'?t.id:crypto.randomUUID?.()||String(Date.now()+Math.random()),title:t.title.slice(0,180),description:typeof t.description==='string'?t.description.slice(0,1200):'',status:t.status,due:typeof t.due==='string'?t.due:'',tags:Array.isArray(t.tags)?t.tags.filter(x=>typeof x==='string').slice(0,8):[]}));undo=null;save();render();notify('Board imported')}catch{notify('Import failed: choose a valid Daymark backup')}finally{e.target.value=''}};load();render()})();
