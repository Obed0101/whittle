+</head><body><main class="app"><header class="topbar"><div class="brand"><span class="mark" aria-hidden="true">▦</span> daymark</div><div class="actions"><label class="sr" for="search">Search tasks</label><input class="search" id="search" type="search" placeholder="⌕  Search tasks…"><button class="btn" id="exportBtn" title="Download a backup">Export</button><button class="btn" id="importBtn">Import</button><input id="importFile" type="file" accept="application/json,.json" hidden><button class="btn primary" id="newBtn">＋ <span class="desktop-label">New task</span></button></div></header><section class="hero"><div><div class="eyebrow" id="today"></div><h1>Your board</h1><p class="subtitle">A little progress, every day.</p></div><div class="stats" aria-live="polite"><div><b id="activeCount">0</b>active</div><div><b id="doneCount">0</b>completed</div><div><b id="overdueCount">0</b>overdue</div></div></section><section class="board" id="board" aria-label="Kanban board"></section><footer class="bottom"><span>Saved on this device · <button class="textbtn" id="undoBtn" disabled>Undo delete</button></span><button class="textbtn" id="clearDone">Clear completed</button></footer></main><div class="modal-back" id="modal" hidden><section class="dialog" role="dialog" aria-modal="true" aria-labelledby="formTitle"><h2 id="formTitle">New task</h2><form id="taskForm"><input type="hidden" id="taskId"><div class="field"><label for="title">Task</label><input id="title" maxlength="180" required placeholder="What needs doing?"></div><div class="field"><label for="description">Notes <span style="font-weight:400;color:var(--muted)">(optional)</span></label><textarea id="description" maxlength="1200" placeholder="Add a few details…"></textarea></div><div class="formrow"><div class="field"><label for="status">Column</label><select id="status"><option value="todo">To do</option><option value="doing">In progress</option><option value="done">Done</option></select></div><div class="field"><label 