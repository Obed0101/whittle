+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title>Daymark — your personal board</title><link rel="stylesheet" href="style.css">
+</head>
+<body>
+<div class="app">
+<header class="topbar"><a class="brand" href="#" aria-label="Daymark home"><span class="brand-icon">✳</span><span>daymark</span></a><div class="header-actions"><button class="icon-btn" id="themeToggle" aria-label="Toggle color theme" title="Toggle theme">☾</button><button class="icon-btn" id="exportBtn" aria-label="Export board" title="Export board">↓</button><button class="icon-btn" id="importBtn" aria-label="Import board" title="Import board">↑</button><input type="file" id="importFile" accept="application/json,.json" hidden></div></header>
+<main><section class="welcome"><div><p class="eyebrow" id="today"></p><h1>Your board<span class="period">.</span></h1><p class="subtitle">A little clarity goes a long way.</p></div><button class="primary" id="newTask"><span>＋</span> New task</button></section>
+<section class="toolbar"><div class="searchbox"><span aria-hidden="true">⌕</span><input id="search" type="search" placeholder="Find a task..." aria-label="Search tasks"><kbd>/</kbd></div><div class="filters"><select id="priorityFilter" aria-label="Filter by priority"><option value="all">All priorities</option><option value="high">High priority</option><option value="medium">Medium priority</option><option value="low">Low priority</option></select><button class="text-btn" id="clearFilters">Clear filters</button></div></section>
+<div class="board" id="board" aria-label="Kanban board"></div><footer><span id="boardStats"></span><button class="text-btn" id="resetBoard">Restore starter board</button></footer></main>
+</div>
+<div class="modal-backdrop" id="modalBackdrop" hidden><section class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle"><div class="modal-head"><div><p class="eyebrow">MAKE IT HAPPEN</p><h2 id="modalTitle">New task</h2></div><button class="icon-btn close" id="closeModal" aria-label="Close dialog">×</button></div><form id="taskForm"><input type="hidden" id="taskId"><label class="field">Task name<input id="taskTitle" required maxlength="120" placeholder="What needs doing?" autocomplete="off"></label><label class="field">Details <span class="optional">(optional)</span><textarea id="taskDescription" rows="3" maxlength="1000" placeholder="Add a little context..."></textarea></label><div class="form-row"><label class="field">Column<select id="taskColumn"></select></label><label class="field">Priority<select id="taskPriority"><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option></select></label></div><div class="form-row"><label class="field">Due date<input id="taskDue" type="date"></label><label class="field">Tag <span class="optional">(optional)</span><input id="taskTag" maxlength="24" placeholder="e.g. Personal"></label></div><div class="modal-actions"><button class="danger text-btn" type="button" id="deleteTask" hidden>Delete task</button><span class="spacer"></span><button class="secondary" type="button" id="cancelModal">Cancel</button><button class="primary" type="submit">Save task</button></div></form></section></div>
+<div class="toast" id="toast" role="status" aria-live="polite"></div>
+<script src="app.js"></script>
+</body></html>
