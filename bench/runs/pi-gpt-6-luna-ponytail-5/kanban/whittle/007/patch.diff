bbing}.card.dragging{opacity:.42}.card-title{font-size:13px;line-height:1.5;font-weight:600;margin:0 0 6px;overflow-wrap:anywhere}.card-desc{font-size:11px;color:#849089;line-height:1.55;margin:0 0 11px;white-space:pre-wrap;overflow-wrap:anywhere}.card-bottom{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:11px}.badges{display:flex;align-items:center;gap:6px;flex-wrap:wrap}.priority{font-size:9px;font-weight:600;padding:4px 7px;border-radius:5px;text-transform:capitalize}.priority.high{color:#bd655c;background:#faeeeb}.priority.medium{color:#ad7b34;background:#faf3e5}.priority.low{color:#6b8c79;background:#edf4ef}.tag{font-size:9px;color:#657b70;background:#f0f3ef;border-radius:5px;padding:4px 7px}.due{font-size:10px;color:#87918c;white-space:nowrap}.due.overdue{color:#c56659;font-weight:600}.due.soon{color:#b27c32}.empty{color:#a0aaa3;text-align:center;font-size:11px;padding:48px 12px}.board footer,footer{display:flex;justify-content:space-between;align-items:center;color:#96a099;font-size:11px;padding-top:21px}.modal-backdrop{position:fixed;inset:0;background:#19251f70;display:grid;place-items:center;padding:20px;z-index:5;backdrop-filter:blur(3px)}.modal-backdrop[hidden]{display:none}.modal{width:min(100%,510px);max-height:90vh;overflow-y:auto;background:var(--paper);border-radius:16px;padding:25px 27px;box-shadow:0 20px 60px #17251d40;animation:pop .15s ease}@keyframes pop{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}.modal-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:22px}.modal-head h2{font:700 22px Manrope,sans-serif;margin:0;letter-spacing:-.6px}.close{font-size:24px;border:0;background:transparent}.field{display:flex;flex-direction:column;gap:7px;font-size:11px;font-weight:600;color:#59665f;margin-bottom:16px}.field input,.field textarea,.field select{width:100%;border:1px solid var(--line);background:var(--paper);color:var(--ink);border-radius:8px;padding:11px