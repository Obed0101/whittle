+(()=>{'use strict';
+const KEY='daymark-board-v1',THEME='daymark-theme';
+const initial=[{id:'t1',title:'Plan the week ahead',description:'Pick three things that would make this week feel like a win.',column:'todo',priority:'medium',due:'',tag:'Personal',created:1},{id:'t2',title:'Tidy up your workspace',description:'Clear the desk and make room to think.',column:'todo',priority:'low',due:'',tag:'',created:2},{id:'t3',title:'Make time for a proper lunch',description:'Step away from the screen, even if it is just for 30 minutes.',column:'progress',priority:'low',due:'',tag:'Wellbeing',created:3},{id:'t4',title:'Celebrate the small wins',description:'Progress is progress. Take a moment to notice it.',column:'done',priority:'low',due:'',tag:'',created:4}];
+const columns=[['todo','To do'],['progress','In progress'],['done','Done']];let tasks=load(),query='',priority='all',toastTimer;const $=id=>document.getElementById(id),board=$('board'),modal=$('modalBackdrop'),form=$('taskForm');
+function load(){try{let x=JSON.parse(localStorage.getItem(KEY));return Array.isArray(x)?x.filter(t=>t&&t.id&&t.title&&columns.some(c=>c[0]===t.column)):structuredClone(initial)}catch{return structuredClone(initial)}}function save(){try{localStorage.setItem(KEY,JSON.stringify(tasks))}catch{notify('Could not save: browser storage is full. Export your board to keep a backup.')}}
+function escape(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+function dateText(d){if(!d)return'';const date=new Date(d+'T00:00:00');return date.toLocaleDateString(undefined,{month:'short',day:'numeric'})}
+function render(){const today=new Date();$('today').textContent=today.toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'}).toUpperCase();board.innerHTML='';let shown=0;for(const [id,name] of columns){const items=tasks.filter(t=>t.column===id&&(!query||(t.title+' '+t.description+' '+t.tag).toLowerCase().includes(query))&&(priority==='all'||t.priority===priority)).sort((a,b)=>(a.created||0)-(b.created||0));shown+=items.length;const col=document.createElement('section');col.className='column';col.dataset.col=id;col.innerHTML=`<div class="column-head"><div class="col-name"><span class="dot"></span>${name}<span class="count">${items.length}</span></div><button class="add-small" aria-label="Add task to ${name}" title="Add task">＋</button></div><div class="cards" role="list" aria-label="${name} tasks">${items.length?items.map(cardHTML).join(''):'<div class="empty">Nothing here just yet</div>'}</div>`;col.querySelector('.add-small').onclick=()=>openTask('',id);col.addEventListener('dragover',e=>{e.preventDefault();col.classList.add('drag-over')});col.addEventListener('dragleave',e=>{if(!col.contains(e.relatedTarget))col.classList.remove('drag-over')});col.addEventListener('drop',e=>{e.preventDefault();col.classList.remove('drag-over');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){const old=t.column;t.column=id;save();render();notify(`Moved to ${name}`,()=>{t.column=old;save();render()})}});board.append(col)}$('boardStats').textContent=`${shown} ${shown===1?'task':'tasks'} showing · ${tasks.length} total`;board.querySelectorAll('.card').forEach(el=>{el.onclick=()=>openTask(el.dataset.id);el.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();openTask(el.dataset.id)}};el.ondragstart=e=>{el.classList.add('dragging');e.dataTransfer.setData('text/plain',el.dataset.id);e.dataTransfer.effectAllowed='move'};el.ondragend=()=>el.classList.remove('dragging')})}
+function cardHTML(t){const due=t.due?new Date(t.due+'T00:00:00'):null,now=new Date();now.setHours(0,0,0,0);let dueClass=due&&due<now&&t.column!=='done'?'overdue':due&&+due===+now?'soon':'';return `<article class="card" role="listitem" tabindex="0" draggable="true" data-id="${escape(t.id)}" aria-label="${escape(t.title)}, ${escape(t.priority)} priority"><h3 class="card-title">${escape(t.title)}</h3>${t.description?`<p class="card-desc">${escape(t.description)}</p>`:''}<div class="card-bottom"><div class="badges"><span class="priority ${escape(t.priority)}">${escape(t.priority)}</span>${t.tag?`<span class="tag">${escape(t.tag)}</span>`:''}</div>${due?`<span class="due ${dueClass}">${dueClass==='overdue'?'Overdue · ':''}${dateText(t.due)}</span>`:''}</div></article>`}
+function openTask(id='',column='todo'){const t=tasks.find(x=>x.id===id);$('modalTitle').textContent=t?'Edit task':'New task';$('taskId').value=t?.id||'';$('taskTitle').value=t?.title||'';$('taskDescription').value=t?.description||'';$('taskColumn').innerHTML=columns.map(([v,n])=>`<option value="${v}">${n}</option>`).join('');$('taskColumn').value=t?.column||column;$('taskPriority').value=t?.priority||'medium';$('taskDue').value=t?.due||'';$('taskTag').value=t?.tag||'';$('deleteTask').hidden=!t;modal.hidden=false;document.body.style.overflow='hidden';setTimeout(()=>$('taskTitle').focus(),20)}function close(){modal.hidden=true;document.body.style.overflow=''}
+form.onsubmit=e=>{e.preventDefault();const id=$('taskId').value,existing=tasks.find(t=>t.id===id),data={id:id||crypto.randomUUID(),title:$('taskTitle').value.trim(),description:$('taskDescription').value.trim(),column:$('taskColumn').value,priority:$('taskPriority').value,due:$('taskDue').value,tag:$('taskTag').value.trim(),created:existing?.created||Date.now()};if(!data.title)return;if(existing)Object.assign(existing,data);else tasks.push(data);save();close();render();notify(existing?'Task updated':'Task added',()=>{tasks=tasks.filter(t=>t.id!==data.id);save();render()})};$('deleteTask').onclick=()=>{const id=$('taskId').value,t=tasks.find(x=>x.id===id),idx=tasks.indexOf(t);tasks.splice(idx,1);save();close();render();notify('Task deleted',()=>{tasks.splice(idx,0,t);save();render()})};
+function notify(msg,undo){const el=$('toast');el.innerHTML=escape(msg)+(undo?'<button>Undo</button>':'');el.classList.add('show');clearTimeout(toastTimer);if(undo)el.querySelector('button').onclick=()=>{undo();el.classList.remove('show')};toastTimer=setTimeout(()=>el.classList.remove('show'),4500)}
+$('newTask').onclick=()=>openTask();$('closeModal').onclick=$('cancelModal').onclick=close;modal.onclick=e=>{if(e.target===modal)close()};document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!modal.hidden)close();if(e.key==='/'&&!/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)){e.preventDefault();$('search').focus()}});$('search').oninput=e=>{query=e.target.value.toLowerCase().trim();render()};$('priorityFilter').onchange=e=>{priority=e.target.value;render()};$('clearFilters').onclick=()=>{$('search').value='';$('priorityFilter').value='all';query='';priority='all';render()};$('themeToggle').onclick=()=>{document.body.classList.toggle('dark');localStorage.setItem(THEME,document.body.classList.contains('dark')?'dark':'light')};if(localStorage.getItem(THEME)==='dark')document.body.classList.add('dark');$('exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify({format:'daymark',version:1,exportedAt:new Date().toISOString(),tasks},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`daymark-board-${new Date().toISOString().slice(0,10)}.json`;a.click();URL.revokeObjectURL(a.href);notify('Board exported')};$('importBtn').onclick=()=>$('importFile').click();$('importFile').onchange=async e=>{const file=e.target.files[0];if(!file)return;try{const data=JSON.parse(await file.text()),incoming=Array.isArray(data)?data:data.tasks;if(!Array.isArray(incoming)||incoming.some(t=>!t||typeof t.title!=='string'||!columns.some(c=>c[0]===t.column)))throw Error();if(!confirm(`Replace your current board with ${incoming.length} imported tasks?`))return;tasks=incoming.map(t=>({...t,id:String(t.id||crypto.randomUUID()),title:t.title.slice(0,120),description:String(t.description||'').slice(0,1000),priority:['high','medium','low'].includes(t.priority)?t.priority:'medium',due:/^\d{4}-\d{2}-\d{2}$/.test(t.due||'')?t.due:'',tag:String(t.tag||'').slice(0,24)}));save();render();notify('Board imported')}catch{notify('That file is not a valid Daymark board')}e.target.value=''};$('resetBoard').onclick=()=>{if(confirm('Replace your tasks with the starter board? This cannot be undone.')){tasks=structuredClone(initial);save();render();notify('Starter board restored')}};
+render();
+})();
