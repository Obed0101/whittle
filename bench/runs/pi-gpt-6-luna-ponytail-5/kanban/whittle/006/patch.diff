+<body><main class="app"><header class="top"><div class="brand"><div class="mark" aria-hidden="true">✳</div><div><h1>Daymark</h1><small>Your personal workspace</small></div></div><div class="actions"><button class="btn textbtn" id="exportBtn" title="Download a backup">↓ Export</button><button class="btn textbtn" id="importBtn" title="Restore from a backup">↑ Import</button><input id="fileInput" type="file" accept="application/json,.json" class="hidden"><button class="btn iconbtn" id="themeBtn" aria-label="Toggle dark mode" title="Toggle dark mode">◐</button></div></header><section class="intro"><div><h2>Good things, in progress.</h2><p>A calm place to keep the next thing moving.</p></div><div class="stats" id="stats" aria-live="polite"></div></section><div class="toolbar"><label class="search"><span aria-hidden="true">⌕</span><input id="search" type="search" placeholder="Search tasks…" aria-label="Search tasks"></label><select id="filter" aria-label="Filter by label"><option value="">All labels</option></select><button class="btn primary" id="newBtn">＋ New task</button></div><section class="board" id="board" aria-label="Kanban board"></section><div class="footer">Saved on this device · <button class="tiny" id="clearFilters">Clear search & filters</button></div></main><div class="overlay" id="overlay" role="dialog" aria-modal="true" aria-labelledby="dialogTitle"><form class="dialog" id="taskForm"><h2 id="dialogTitle">New task</h2><div class="field"><label for="title">Task</label><input id="title" maxlength="120" required placeholder="What needs doing?"></div><div class="field"><label for="description">Notes</label><textarea id="description" maxlength="2000" placeholder="Add context, links, or next steps…"></textarea></div><div class="twocol"><div class="field"><label for="status">Column</label><select id="status"></select></div><div class="field"><label for="due">Due date</label><input id="due" type="date"></div></div><div class="field"><label for="labels">Labels <span style="font-weight:400">(comma separated)</span></label><input id="labels" maxlength="160" placeholder="Work, Personal"></div><div class="dialogactions"><button type="button" class="btn danger hidden" id="deleteBtn">Delete</button><div class="rightactions"><button type="button" class="btn" id="cancelBtn">Cancel</button><button class="btn primary" type="submit">Save task</button></div></div></form></div><div class="toast" id="toast" role="status" aria-live="polite"></div>
+<script>
+(()=>{'use strict';const KEY='daymark-board-v1',STATUSES=[['inbox','Inbox'],['next','Up next'],['doing','In progress'],['done','Done']];let tasks=[],editing=null,undoState=null,toastTimer;const $=s=>document.querySelector(s),board=$('#board');const today=()=>new Date().toISOString().slice(0,10);function load(){try{const x=JSON.parse(localStorage.getItem(KEY));if(Array.isArray(x))tasks=x.filter(t=>t&&typeof t.id==='string'&&typeof t.title==='string'&&STATUSES.some(s=>s[0]===t.status)).map(t=>({...t,labels:Array.isArray(t.labels)?t.labels:[]}));}catch{tasks=[]}}function save(){try{localStorage.setItem(KEY,JSON.stringify(tasks));$('#stats').textContent=`${tasks.filter(t=>t.status!=='done').length} active · ${tasks.length} total`;renderFilters()}catch{notify('Could not save. Your browser storage may be full.')}}function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function renderFilters(){let chosen=$('#filter').value,labels=[...new Set(tasks.flatMap(t=>t.labels))].sort((a,b)=>a.localeCompare(b));$('#filter').innerHTML='<option value="">All labels</option>'+labels.map(x=>`<option value="${esc(x)}">${esc(x)}</option>`).join('');$('#filter').value=labels.includes(chosen)?chosen:''}function render(){save();let q=$('#search').value.toLowerCase().trim(),label=$('#filter').value,shown=tasks.filter(t=>(!q||[t.title,t.description,...t.labels].join(' ').toLowerCase().includes(q))&&(!label||t.labels.includes(label)));board.innerHTML=STATUSES.map(([id,name])=>{let cards=shown.filter(t=>t.status===id);return `<section class="column" data-status="${id}" aria-label="${name}"><header class="colhead"><div class="colname"><i class="dot"></i>${name}<span class="count">${cards.length}</span></div><button class="colmenu" data-add="${id}" aria-label="Add task to ${name}" title="Add task">+</button></header><div class="cards">${cards.map(cardHTML).join('')}</div><button class="addcard" data-add="${id}">＋ Add a task</button></section>`}).join('')||'<div class="empty"><strong>No tasks yet</strong>Capture a task and give it a place to land.</div>';bindCards()}function cardHTML(t){let late=t.due&&t.due<today()&&t.status!=='done';return `<article class="card" draggable="true" tabindex="0" data-id="${esc(t.id)}" aria-label="${esc(t.title)}"><div class="cardtop"><h3>${esc(t.title)}</h3><span class="cardtools"><button class="tiny" data-edit="${esc(t.id)}" aria-label="Edit ${esc(t.title)}" title="Edit">✎</button></span></div>${t.description?`<p>${esc(t.description)}</p>`:''}<div class="cardfoot"><div class="tags">${t.labels.map(l=>`<span class="tag">${esc(l)}</span>`).join('')}</div>${t.due?`<span class="due ${late?'late':''}">${late?'Overdue · ':''}${new Date(t.due+'T12:00:00').toLocaleDateString(undefined,{month:'short',day:'numeric'})}</span>`:''}</div></article>`}function bindCards(){document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>open(null,b.dataset.add));document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=e=>{e.stopPropagation();open(b.dataset.edit)});document.querySelectorAll('.card').forEach(c=>{c.onclick=e=>{if(!e.target.closest('button'))open(c.dataset.id)};c.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();open(c.dataset.id)}};c.ondragstart=e=>{e.dataTransfer.setData('text/plain',c.dataset.id);e.dataTransfer.effectAllowed='move';c.classList.add('dragging')};c.ondragend=()=>c.classList.remove('dragging')});document.querySelectorAll('.column').forEach(col=>{col.ondragover=e=>{e.preventDefault();col.classList.add('dragover')};col.ondragleave=()=>col.classList.remove('dragover');col.ondrop=e=>{e.preventDefault();col.classList.remove('dragover');let t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=col.dataset.status;render()}}})}function open(id,status){editing=id;let t=tasks.find(x=>x.id===id);$('#taskForm').reset();$('#status').innerHTML=STATUSES.map(([v,n])=>`<option value="${v}">${n}</option>`).join('');$('#dialogTitle').textContent=t?'Edit task':'New task';$('#deleteBtn').classList.toggle('hidden',!t);if(t){$('#title').value=t.title;$('#description').value=t.description||'';$('#status').value=t.status;$('#due').value=t.due||'';$('#labels').value=t.labels.join(', ')}else $('#status').value=status||'inbox';$('#overlay').classList.add('open');$('#title').focus()}function close(){ $('#overlay').classList.remove('open');editing=null}function notify(msg,undo=false){let n=$('#toast');n.innerHTML=esc(msg)+(undo?' · <button id="undo" style="color:white;background:none;border:0;text-decoration:underline;cursor:pointer">Undo</button>':'');n.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>n.classList.remove('show'),4000);if(undo)$('#undo').onclick=()=>{if(undoState){tasks=undoState;undoState=null;render();n.classList.remove('show')}}}$('#newBtn').onclick=()=>open();$('#cancelBtn').onclick=close;$('#overlay').onclick=e=>{if(e.target===$('#overlay'))close()};document.onkeydown=e=>{if(e.key==='Escape')close();if((e.metaKey||e.ctrlKey)&&e.key==='Enter'&&$('#overlay').classList.contains('open'))$('#taskForm').requestSubmit()};$('#taskForm').onsubmit=e=>{e.preventDefault();let t=tasks.find(x=>x.id===editing);if(!t){t={id:crypto.randomUUID?crypto.randomUUID():String(Date.now()),created:Date.now()};tasks.push(t)}Object.assign(t,{title:$('#title').value.trim(),description:$('#description').value.trim(),status:$('#status').value,due:$('#due').value,labels:[...new Set($('#labels').value.split(',').map(x=>x.trim()).filter(Boolean))],updated:Date.now()});close();render();notify('Task saved')};$('#deleteBtn').onclick=()=>{undoState=tasks.map(t=>({...t,labels:[...t.labels]}));tasks=tasks.filter(t=>t.id!==editing);close();render();notify('Task deleted',true)};$('#search').oninput=render;$('#filter').onchange=render;$('#clearFilters').onclick=()=>{$('#search').value='';$('#filter').value='';render()};$('#themeBtn').onclick=()=>{document.body.classList.toggle('dark');localStorage.setItem('daymark-dark',document.body.classList.contains('dark')?'1':'0')};if(localStorage.getItem('daymark-dark')==='1')document.body.classList.add('dark');$('#exportBtn').onclick=()=>{let blob=new Blob([JSON.stringify({format:'daymark',version:1,exported:new Date().toISOString(),tasks},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`daymark-${today()}.json`;a.click();URL.revokeObjectURL(a.href);notify('Backup downloaded')};$('#importBtn').onclick=()=>$('#fileInput').click();$('#fileInput').onchange=async e=>{let f=e.target.files[0];if(!f)return;try{let data=JSON.parse(await f.text()),incoming=Array.isArray(data)?data:data.tasks;if(!Array.isArray(incoming))throw Error();let cleaned=incoming.filter(t=>t&&typeof t.title==='string'&&STATUSES.some(s=>s[0]===t.status)).map(t=>({...t,id:crypto.randomUUID?crypto.randomUUID():String(Date.now()+Math.random()),labels:Array.isArray(t.labels)?t.labels:[]}));if(!confirm(`Replace your current board with ${cleaned.length} imported tasks? Export first if you want a backup.`))return;undoState=tasks.map(t=>({...t,labels:[...t.labels]}));tasks=cleaned;render();notify('Board imported',true)}catch{notify('That file is not a valid Daymark backup')}finally{e.target.value=''}};load();render()})();
+</script></body></html>
