+:root{--bg:#f5f6f3;--panel:#fff;--ink:#20251f;--muted:#788078;--line:#e7eae4;--green:#466b50;--soft:#edf3ed;--shadow:0 10px 35px #21351b0b;--red:#b84f48}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.45 Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}body.dark{--bg:#171b18;--panel:#222824;--ink:#e7ece7;--muted:#9ba59c;--line:#353e37;--green:#9cc5a1;--soft:#29372c;--shadow:0 10px 35px #0003;--red:#ff8278}button,input,textarea,select{font:inherit;color:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid #84ad89;outline-offset:2px}.app{max-width:1500px;margin:auto;padding:30px 38px 60px}.top{display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:flex;align-items:center;gap:12px}.mark{width:38px;height:38px;border-radius:12px;background:var(--green);display:grid;place-items:center;color:white;font-size:19px}.brand h1{font-size:19px;margin:0;letter-spacing:-.5px}.brand small{display:block;color:var(--muted);font-size:12px}.actions{display:flex;gap:9px;align-items:center}.btn{border:1px solid var(--line);background:var(--panel);border-radius:9px;padding:9px 13px;font-weight:600;font-size:13px}.btn:hover{border-color:#aab8aa}.btn.primary{background:var(--green);border-color:var(--green);color:#fff}.iconbtn{height:37px;width:39px;padding:0;font-size:17px}.intro{margin:42px 0 25px;display:flex;align-items:flex-end;justify-content:space-between;gap:20px}.intro h2{font-size:30px;letter-spacing:-1.2px;margin:0 0 5px}.intro p{margin:0;color:var(--muted)}.stats{color:var(--muted);font-size:13px}.toolbar{display:flex;gap:10px;margin-bottom:19px;align-items:center}.search{position:relative;flex:1;max-width:380px}.search input{width:100%;border:1px solid var(--line);background:var(--panel);border-radius:9px;padding:10px 12px 10px 36px}.search span{position:absolute;top:9px;left:12px;color:var(--muted)}.toolbar select{border:1px solid var(--line);background:var(--panel);border-radius:9px;padding:10px 30px 10px 12px}.board{display:grid;grid-template-columns:repeat(4,minmax(245px,1fr));gap:15px;align-items:start;overflow-x:auto;padding-bottom:16px}.column{background:#eef0ec;border-radius:13px;padding:12px;min-height:240px;border:1px solid transparent}.dark .column{background:#1d231f}.column.dragover{border-color:var(--green);background:var(--soft)}.colhead{display:flex;align-items:center;justify-content:space-between;padding:2px 3px 12px}.colname{font-weight:700;font-size:13px;display:flex;align-items:center;gap:8px}.dot{width:8px;height:8px;border-radius:50%;background:#93a498}.column:nth-child(2) .dot{background:#d6a953}.column:nth-child(3) .dot{background:#7295be}.column:nth-child(4) .dot{background:#70a27b}.count{font-size:11px;color:var(--muted);background:var(--panel);padding:2px 7px;border-radius:12px}.colmenu{border:0;background:transparent;color:var(--muted);font-size:19px;padding:0 6px}.cards{display:grid;gap:9px;min-height:50px}.card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px 12px 10px;box-shadow:var(--shadow);cursor:grab}.card:active{cursor:grabbing}.card.dragging{opacity:.4}.cardtop{display:flex;justify-content:space-between;gap:8px}.card h3{font-size:14px;line-height:1.35;margin:0;font-weight:650}.card p{color:var(--muted);font-size:12px;margin:8px 0 0;white-space:pre-wrap;overflow-wrap:anywhere}.cardfoot{display:flex;align-items:center;justify-content:space-between;margin-top:12px;gap:8px}.tags{display:flex;gap:5px;flex-wrap:wrap}.tag{font-size:10px;padding:3px 7px;border-radius:5px;background:var(--soft);color:var(--green);font-weight:650}.due{font-size:11px;color:var(--muted);white-space:nowrap}.due.late{color:var(--red);font-weight:700}.cardtools{display:flex;gap:4px;opacity:0}.card:hover .cardtools,.card:focus-within .cardtools{opacity:1}.tiny{border:0;background:transparent;color:var(--muted);padding:2px 4px}.addcard{border:1px dashed #c8d0c7;background:transparent;color:var(--muted);border-radius:8px;width:100%;padding:9px;text-align:left;font-size:12px;margin-top:9px}.addcard:hover{background:var(--panel);color:var(--ink)}.empty{text-align:center;color:var(--muted);padding:80px 20px;grid-column:1/-1}.empty strong{display:block;color:var(--ink);font-size:17px;margin-bottom:6px}.footer{color:var(--muted);font-size:11px;text-align:right;margin-top:5px}.overlay{position:fixed;inset:0;background:#1015107a;display:none;place-items:center;padding:20px;z-index:5}.overlay.open{display:grid}.dialog{width:min(500px,100%);background:var(--panel);border-radius:15px;padding:24px;box-shadow:0 24px 80px #0004}.dialog h2{margin:0 0 20px;font-size:19px}.field{display:grid;gap:6px;margin:13px 0}.field label{font-size:12px;font-weight:700;color:var(--muted)}.field input,.field textarea,.field select{background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:10px;width:100%}.field textarea{resize:vertical;min-height:95px}.twocol{display:grid;grid-template-columns:1fr 1fr;gap:12px}.dialogactions{display:flex;justify-content:space-between;align-items:center;margin-top:22px}.rightactions{display:flex;gap:8px}.danger{color:var(--red)}.toast{position:fixed;bottom:22px;left:50%;transform:translate(-50%,20px);background:#27352a;color:white;border-radius:9px;padding:11px 17px;font-size:13px;opacity:0;transition:.2s;pointer-events:none;z-index:10}.toast.show{opacity:1;transform:translate(-50%,0)}.hidden{display:none!important} @media(max-width:850px){.app{padding:20px 17px 40px}.board{grid-template-columns:repeat(4,minmax(260px,80vw))}.intro{margin-top:30px}}@media(max-width:530px){.actions .textbtn{display:none}.intro{align-items:flex-start;flex-direction:column}.intro h2{font-size:26px}.toolbar{flex-wrap:wrap}.search{max-width:none;flex-basis:100%}.top{align-items:flex-start}.brand small{display:none}.twocol{grid-template-columns:1fr 1fr}}@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
