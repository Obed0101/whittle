+(()=>{'use strict';const KEY='daymark-board-v1',THEME='daymark-theme';let tasks=[],view='board',dragId=null,toastTimer;const $=s=>document.querySelector(s),board=$('#board'),dialog=$('#taskDialog'),form=$('#taskForm');const columns=[['todo','To do','todo'],['doing','In progress','doing'],['done','Done','done']];const escape=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function load(){try{const d=JSON.parse(localStorage.getItem(KEY)||'[]');tasks=Array.isArray(d)?d.filter(t=>t&&typeof t.id==='string'&&typeof t.title==='string'&&columns.some(c=>c[0]===t.status)):[]}catch{tasks=[]}if(localStorage.getItem(THEME)==='dark')document.body.classList.add('dark')}function save(){try{localStorage.setItem(KEY,JSON.stringify(tasks));$('#saveStatus').textContent='All changes saved'}catch{$('#saveStatus').textContent='Could not save changes';notify('Storage is full. Export a backup before continuing.')}}function notify(s){const n=$('#toast');n.textContent=s;n.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>n.classList.remove('show'),2500)}function dueText(d){if(!d)return'';const day=new Date(d+'T00:00:00');return day.toLocaleDateString(undefined,{month:'short',day:'numeric'})}function render(){const q=$('#search').value.trim().toLowerCase(),p=$('#filterPriority').value;const filtered=tasks.filter(t=>(!q||(t.title+' '+(t.notes||'')).toLowerCase().includes(q))&&(p==='all'||t.priority===p));board.classList.toggle('list',view==='list');board.innerHTML=columns.map(([status,name,cls])=>{const list=filtered.filter(t=>t.status===status);return `<section class="column ${cls}"><div class="column-head"><div class="col-name"><span class="dot"></span>${name}<span class="count">${list.length}</span></div><button class="add-inline" data-add="${status}" aria-label="Add task to ${name}">＋ Add</button></div><div class="cards" data-status="${status}">${list.length?list.map(card).join(''):'<div class="empty">Nothing here yet</div>'}</div></section>`}).join('')+(filtered.length?'':'<div class="no-results">No tasks match your search.</div>');$('#taskCount').textContent=`${tasks.length} task${tasks.length===1?'':'s'} · ${tasks.filter(t=>t.status==='done').length} completed`;board.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>openNew(b.dataset.add));board.querySelectorAll('.task-title,.task-edit').forEach(b=>b.onclick=()=>openEdit(b.closest('.task').dataset.id));board.querySelectorAll('.task').forEach(el=>{el.ondragstart=e=>{dragId=el.dataset.id;el.classList.add('dragging');e.dataTransfer.effectAllowed='move';e.dataTransfer.setData('text/plain',dragId)};el.ondragend=()=>el.classList.remove('dragging')});board.querySelectorAll('.cards').forEach(el=>{el.ondragover=e=>{e.preventDefault();el.classList.add('dragover')};el.ondragleave=()=>el.classList.remove('dragover');el.ondrop=e=>{e.preventDefault();el.classList.remove('dragover');const id=e.dataTransfer.getData('text/plain')||dragId;const t=tasks.find(x=>x.id===id);if(t){t.status=el.dataset.status;save();render()}}})}function card(t){const overdue=t.due&&t.due<new Date().toISOString().slice(0,10)&&t.status!=='done';return `<article class="task" draggable="true" data-id="${escape(t.id)}"><p class="task-title" tabindex="0" role="button" aria-label="Edit ${escape(t.title)}">${escape(t.title)}</p>${t.notes?`<p class="task-note">${escape(t.notes)}</p>`:''}<div class="task-meta"><span class="priority ${escape(t.priority)}">${escape(t.priority)} priority</span><span class="due ${overdue?'overdue':''}">${overdue?'Overdue · ':''}${dueText(t.due)}</span><button class="task-edit" aria-label="Edit task ${escape(t.title)}">···</button></div></article>`}function openNew(status='todo'){form.reset();$('#taskId').value='';$('#taskStatus').value=status;$('#taskPriority').value='medium';$('#dialogTitle').textContent='New task';$('#deleteTask').hidden=true;dialog.showModal();$('#taskTitle').focus()}function openEdit(id){const t=tasks.find(x=>x.id===id);if(!t)return;$('#taskId').value=t.id;$('#taskTitle').value=t.title;$('#taskNotes').value=t.notes||'';$('#taskPriority').value=t.priority||'medium';$('#taskDue').value=t.due||'';$('#taskStatus').value=t.status;$('#dialogTitle').textContent='Edit task';$('#deleteTask').hidden=false;dialog.showModal();$('#taskTitle').focus()}document.querySelectorAll('.close').forEach(b=>b.onclick=()=>dialog.close());$('#addTaskTop').onclick=()=>openNew();form.onsubmit=e=>{e.preventDefault();const id=$('#taskId').value,entry={id:id||crypto.randomUUID(),title:$('#taskTitle').value.trim(),notes:$('#taskNotes').value.trim(),priority:$('#taskPriority').value,due:$('#taskDue').value,status:$('#taskStatus').value};if(!entry.title)return;if(id)tasks[tasks.findIndex(t=>t.id===id)]=entry;else tasks.unshift(entry);save();render();dialog.close();notify(id?'Task updated':'Task added')};$('#deleteTask').onclick=()=>{const id=$('#taskId').value;if(!id)return;if(confirm('Delete this task? This cannot be undone.')){tasks=tasks.filter(t=>t.id!==id);save();render();dialog.close();notify('Task deleted')}};$('#search').oninput=render;$('#filterPriority').onchange=render;document.querySelectorAll('.view-tab').forEach(b=>b.onclick=()=>{view=b.dataset.view;document.querySelectorAll('.view-tab').forEach(x=>{const active=x===b;x.classList.toggle('active',active);x.setAttribute('aria-selected',active)});render()});$('#themeToggle').onclick=()=>{document.body.classList.toggle('dark');localStorage.setItem(THEME,document.body.classList.contains('dark')?'dark':'light')};$('#exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify({version:1,exportedAt:new Date().toISOString(),tasks},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='daymark-backup-'+new Date().toISOString().slice(0,10)+'.json';a.click();URL.revokeObjectURL(a.href);notify('Backup downloaded')};$('#importFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{const data=JSON.parse(await f.text()),incoming=Array.isArray(data)?data:data.tasks;if(!Array.isArray(incoming)||!incoming.every(t=>t&&typeof t.title==='string'&&columns.some(c=>c[0]===t.status)))throw Error();if(confirm(`Replace your board with ${incoming.length} imported task${incoming.length===1?'':'s'}? Export first if you want to keep the current board.`)){tasks=incoming.map(t=>({id:typeof t.id==='string'?t.id:crypto.randomUUID(),title:t.title,notes:t.notes||'',priority:['high','medium','low'].includes(t.priority)?t.priority:'medium',due:t.due||'',status:t.status}));save();render();notify('Backup restored')}}catch{notify('That backup file is invalid')}e.target.value=''};$('#clearDone').onclick=()=>{const n=tasks.filter(t=>t.status==='done').length;if(!n)return notify('No completed tasks to clear');if(confirm(`Permanently delete ${n} completed task${n===1?'':'s'}?`)){tasks=tasks.filter(t=>t.status!=='done');save();render();notify('Completed tasks cleared')}};$('#today').textContent=new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'});board.addEventListener('keydown',e=>{if((e.key==='Enter'||e.key===' ')&&e.target.matches('.task-title')){e.preventDefault();openEdit(e.target.closest('.task').dataset.id)}});load();render()})();
