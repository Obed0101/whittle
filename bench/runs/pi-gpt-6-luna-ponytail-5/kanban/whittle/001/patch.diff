+<dialog id="taskDialog"><form id="taskForm"><div class="dialog-head"><div><p class="eyebrow">TASK DETAILS</p><h2 id="dialogTitle">A new task</h2></div><button type="button" class="icon-button close" aria-label="Close">×</button></div><label class="field">What needs doing?<input id="taskTitle" maxlength="120" required placeholder="Give it a clear name"></label><label class="field">A little more detail <span class="optional">OPTIONAL</span><textarea id="taskNotes" rows="3" maxlength="2000" placeholder="Notes, links, or the first small step…"></textarea></label><div class="field-row"><label class="field">Status<select id="taskStatus"></select></label><label class="field">Priority<select id="taskPriority"><option value="none">None</option><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option></select></label></div><div class="field-row"><label class="field">Due date<input id="taskDue" type="date"></label><label class="field">Tag<input id="taskTag" maxlength="24" placeholder="e.g. Personal"></label></div><div class="dialog-foot"><button type="button" id="deleteTask" class="button danger-button hidden">Delete</button><span class="spacer"></span><button type="button" class="button subtle close">Cancel</button><button class="button primary" type="submit">Save task</button></div></form></dialog>
