+(()=>{'use strict';const KEY='dayboard-data-v1',columns=[['todo','To do'],['doing','In progress'],['done','Done']];let tasks=[],query='',undoTimer;const $=id=>document.getElementById(id),board=$('board');function safeLoad(){try{const x=JSON.parse(localStorage.getItem(KEY));if(Array.isArray(x))tasks=x.filter(t=>t&&typeof t.id==='string'&&typeof t.title==='string').map(t=>({id:t.id,title:t.title.slice(0,120),description:String(t.description||'').slice(0,1000),status:columns.some(c=>c[0]===t.status)?t.status:'todo',priority:['high','low','normal'].includes(t.priority)?t.priority:'normal',due:/^\d{4}-\d{2}-\d{2}$/.test(t.due||'')?t.due:'',created:Number(t.created)||Date.now(),updated:Number(t.updated)||Date.now()}))}catch{tasks=[]}}function save(){try{localStorage.setItem(KEY,JSON.stringify(tasks))}catch{notify('Could not save: browser storage is unavailable.')}}function escape(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function render(){board.innerHTML='';let shown=tasks.filter(t=>(t.title+' '+t.description).toLowerCase().includes(query));columns.forEach(([key,label])=>{let col=document.createElement('section');col.className='column';col.dataset.status=key;col.innerHTML=`<div class="col-head"><div class="col-title"><span class="dot"></span>${label}<span class="count">${tasks.filter(t=>t.status===key).length}</span></div><button class="add-card" aria-label="Add task to ${label}" title="Add task">＋</button></div><div class="cards" aria-label="${label} tasks"></div>`;let list=col.querySelector('.cards'),items=shown.filter(t=>t.status===key);if(!items.length)list.innerHTML=`<div class="empty">${query?'No matching tasks':'Nothing here yet'}</div>`;items.forEach(t=>{let card=document.createElement('article');card.className='card';card.draggable=true;card.tabIndex=0;card.dataset.id=t.id;let due=t.due?new Date(t.due+'T00:00:00'):null,late=due&&t.status!=='done'&&due<new Date(new Date().toDateString());card.inne