tatus').value=t?.status||status;$('priority').value=t?.priority||'normal';$('due').value=t?.due||'';$('modalTitle').textContent=t?'Edit task':'New task';$('deleteTask').hidden=!t;$('modalBack').hidden=false;$('title').focus()}function close(){$('modalBack').hidden=true}function notify(message,undo){let el=$('toast');el.innerHTML=escape(message)+(undo?' <button id="undo">Undo</button>':'');el.hidden=false;clearTimeout(undoTimer);undoTimer=setTimeout(()=>el.hidden=true,undo?6000:3000);if(undo)el.querySelector('#undo').onclick=()=>{tasks=undo();save();render();el.hidden=true}}function remove(id){let i=tasks.findIndex(t=>t.id===id);if(i<0)return;let removed=tasks.splice(i,1)[0];save();render();notify('Task deleted.',()=>{tasks.splice(i,0,removed);return tasks})}$('taskForm').onsubmit=e=>{e.preventDefault();let id=$('taskId').value,existing=tasks.find(t=>t.id===id),item={id:id||crypto.randomUUID(),title:$('title').value.trim(),description:$('description').value.trim(),status:$('status').value,priority:$('priority').value,due:$('due').value,created:existing?.created||Date.now(),updated:Date.now()};if(!item.title)return;if(existing)Object.assign(existing,item);else tasks.unshift(item);save();render();close()};$('deleteTask').onclick=()=>{let id=$('taskId').value;close();remove(id)};$('cancel').onclick=close;$('newTask').onclick=()=>open(null);$('modalBack').addEventListener('click',e=>{if(e.target===$('modalBack'))close()});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!$('modalBack').hidden)close();if((e.metaKey||e.ctrlKey)&&e.key==='Enter'&&!$('modalBack').hidden)$('taskForm').requestSubmit()});$('search').oninput=e=>{query=e.target.value.trim().toLowerCase();render()};$('theme').onclick=()=>{document.body.classList.toggle('dark');localStorage.setItem('dayboard-dark',document.body.classList.contains('dark')?'1':'0')};if(localStorage.getItem('dayboard-dark')==='1')document.body.classList.add('dark');$('export').onclick=()=>{let blob=new Blob([JSON.stringify