+<body><div class="app"><header class="top"><div class="brand"><span class="logo" aria-hidden="true">↗</span> daymark</div><div class="actions"><button class="iconbtn" id="undo" title="Undo last change" aria-label="Undo last change">↶</button><button class="iconbtn" id="export">Export</button><button class="iconbtn" id="importBtn">Import</button><input class="sr" type="file" id="importFile" accept="application/json"><span class="avatar" aria-label="Personal board">Y</span></div></header><main><section class="intro"><div><div class="eyebrow" id="today"></div><h1>Your board</h1><p>A little progress, every day.</p></div><button class="primary" id="newTask">＋ &nbsp;New task</button></section><section class="toolbar"><div class="filters"><input id="search" class="search" type="search" placeholder="⌕  Search tasks…" aria-label="Search tasks"><button class="filter active" data-filter="All">All</button><button class="filter" data-filter="Work">Work</button><button class="filter" data-filter="Personal">Personal</button><button class="filter" data-filter="Health">Health</button></div><label class="sr" for="sort">Sort tasks</label><select class="sort" id="sort"><option value="manual">Manual order</option><option value="due">Due date</option><option value="newest">Recently added</option></select></section><section class="board" id="board" aria-label="Kanban board"></section></main></div><div id="modalRoot"></div><div class="toast hidden" id="toast" role="status"></div>
+<script>
+(()=>{'use strict';const KEY='daymark-board-v1',statuses=[['todo','To do'],['doing','In progress'],['done','Done']];let tasks=[],filter='All',query='',sort='manual',dragId=null,undoStack=[],toastTimer;const $=s=>document.querySelector(s),today=new Date();$('#today').textContent=today.toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'});function uid(){return crypto.randomUUID?crypto.randomUUID():Date.now().toString(36)+Math.random().toString(36).slice(2)}function seed(){return[{id:uid(),title:'Plan the week',description:'Choose the 3 things that matter most.',category:'Personal',status:'todo',due:'',created:Date.now()-3000},{id:uid(),title:'Send project proposal',description:'Share the draft and ask for feedback.',category:'Work',status:'todo',due:'',created:Date.now()-2000},{id:uid(),title:'Book a dentist appointment',description:'',category:'Health',status:'doing',due:'',created:Date.now()-1000}]}function save(){localStorage.setItem(KEY,JSON.stringify({version:1,tasks}))}function snapshot(){undoStack.push(JSON.stringify(tasks));if(undoStack.length>30)undoStack.shift()}function notice(text){let t=$('#toast');t.textContent=text;t.classList.remove('hidden');clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.add('hidden'),2400)}function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function render(){let root=$('#board');root.innerHTML=statuses.map(([status,label])=>{let list=tasks.filter(t=>t.status===status&& (filter==='All'||t.category===filter)&&(!query||`${t.title} ${t.description}`.toLowerCase().includes(query))).sort((a,b)=>sort==='due'?(a.due||'9999').localeCompare(b.due||'9999'):sort==='newest'?b.created-a.created:0);return `<section class="column" data-status="${status}"><div class="colhead"><div class="coltitle"><i class="dot"></i>${label}<span class="count">${tasks.filter(t=>t.status===status).length}</span></div><button class="colmenu" aria-label="Add task to ${label}" data-add="${status}">＋</button></div><div class="cards" data-drop="${status}">${list.map(t=>`<article class="card" draggable="true" tabindex="0" data-id="${esc(t.id)}"><h3>${esc(t.title)}</h3>${t.description?`<p class="desc">${esc(t.description)}</p>`:''}<div class="cardfoot"><div><span class="tag ${esc(t.category)}">${esc(t.category)}</span>${t.due?` <span class="due ${t.due<new Date().toISOString().slice(0,10)&&status!=='done'?'late':''}">${esc(new Date(t.due+'T00:00:00').toLocaleDateString(undefined,{month:'short',day:'numeric'}))}</span>`:''}</div><div class="cardbuttons"><button data-edit="${esc(t.id)}" aria-label="Edit ${esc(t.title)}">✎</button><button data-delete="${esc(t.id)}" aria-label="Delete ${esc(t.title)}">×</button></div></div></article>`).join('')}</div><button class="addcard" data-add="${status}">＋ Add a task</button></section>`}).join('');root.querySelectorAll('.card').forEach(c=>{c.addEventListener('dragstart',e=>{dragId=c.dataset.id;c.classList.add('dragging');e.dataTransfer.setData('text/plain',dragId)});c.addEventListener('dragend',()=>c.classList.remove('dragging'));c.addEventListener('keydown',e=>{if(e.altKey&&['ArrowLeft','ArrowRight'].includes(e.key)){e.preventDefault();move(c.dataset.id,e.key==='ArrowRight'?1:-1)}})});root.querySelectorAll('[data-drop]').forEach(el=>{el.addEventListener('dragover',e=>e.preventDefault());el.addEventListener('drop',e=>{e.preventDefault();let id=e.dataTransfer.getData('text/plain')||dragId,t=tasks.find(x=>x.id===id);if(t&&t.status!==el.dataset.drop){snapshot();t.status=el.dataset.drop;save();render()}})})}function move(id,delta){let t=tasks.find(x=>x.id===id),i=statuses.findIndex(x=>x[0]===t?.status),n=Math.max(0,Math.min(statuses.length-1,i+delta));if(t&&i!==n){snapshot();t.status=statuses[n][0];save();render();notice('Task moved')}}function openModal(task=null,status='todo'){let root=$('#modalRoot'),edit=!!task;root.innerHTML=`<div class="overlay" role="presentation"><form class="modal" role="dialog" aria-modal="true" aria-labelledby="formTitle"><h2 id="formTitle">${edit?'Edit task':'New task'}</h2><div class="field"><label for="title">Task</label><input id="title" maxlength="120" required placeholder="What needs doing?" value="${esc(task?.title||'')}"></div><div class="field"><label for="description">Notes <span style="font-weight:400;color:#85867d">(optional)</span></label><textarea id="description" maxlength="1000" placeholder="Add a little context…">${esc(task?.description||'')}</textarea></div><div class="row"><div class="field"><label for="category">List</label><select id="category">${['Work','Personal','Health'].map(c=>`<option ${task?.category===c?'selected':''}>${c}</option>`).join('')}</select></div><div class="field"><label for="status">Status</label><select id="status">${statuses.map(([v,l])=>`<option value="${v}" ${(task?.status||status)===v?'selected':''}>${l}</option>`).join('')}</select></div></div><div class="field"><label for="due">Due date <span style="font-weight:400;color:#85867d">(optional)</span></label><input type="date" id="due" value="${esc(task?.due||'')}"></div><div class="modalfoot">${edit?`<button type="button" class="danger" id="deleteTask">Delete task</button>`:'<span></span>'}<div class="right"><button type="button" class="cancel" id="cancel">Cancel</button><button class="primary">${edit?'Save changes':'Add task'}</button></div></div></form></div>`;let form=root.querySelector('form');$('#title').focus();root.querySelector('.overlay').addEventListener('click',e=>{if(e.target.classList.contains('overlay'))root.innerHTML=''});$('#cancel').onclick=()=>root.innerHTML='';form.onsubmit=e=>{e.preventDefault();let title=$('#title').value.trim();if(!title)return;snapshot();let data={title,description:$('#description').value.trim(),category:$('#category').value,status:$('#status').value,due:$('#due').value};if(edit)Object.assign(task,data);else tasks.push({id:uid(),...data,created:Date.now()});save();root.innerHTML='';render();notice(edit?'Changes saved':'Task added')};if(edit)$('#deleteTask').onclick=()=>{if(confirm(`Delete “${task.title}”?`)){snapshot();tasks=tasks.filter(t=>t.id!==task.id);save();root.innerHTML='';render();notice('Task deleted')}};form.onkeydown=e=>{if(e.key==='Escape'){root.innerHTML=''}}}document.addEventListener('click',e=>{let a=e.target.closest('[data-add]'),ed=e.target.closest('[data-edit]'),del=e.target.closest('[data-delete]');if(a)openModal(null,a.dataset.add);if(ed)openModal(tasks.find(t=>t.id===ed.dataset.edit));if(del){let t=tasks.find(x=>x.id===del.dataset.delete);if(t&&confirm(`Delete “${t.title}”?`)){snapshot();tasks=tasks.filter(x=>x.id!==t.id);save();render();notice('Task deleted')}}});$('#newTask').onclick=()=>openModal();$('#search').oninput=e=>{query=e.target.value.toLowerCase().trim();render()};$('#sort').onchange=e=>{sort=e.target.value;render()};document.querySelectorAll('.filter').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelector('.filter.active').classList.remove('active');b.classList.add('active');render()});$('#undo').onclick=()=>{if(!undoStack.length)return notice('Nothing to undo');tasks=JSON.parse(undoStack.pop());save();render();notice('Change undone')};$('#export').onclick=()=>{let blob=new Blob([JSON.stringify({format:'daymark',version:1,exportedAt:new Date().toISOString(),tasks},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='daymark-board.json';a.click();URL.revokeObjectURL(a.href);notice('Board exported')};$('#importBtn').onclick=()=>$('#importFile').click();$('#importFile').onchange=async e=>{try{let data=JSON.parse(await e.target.files[0].text()),incoming=Array.isArray(data)?data:data.tasks;if(!Array.isArray(incoming)||incoming.some(t=>!t||typeof t.title!=='string'||!statuses.some(s=>s[0]===t.status)||!['Work','Personal','Health'].includes(t.category)))throw Error();if(!confirm(`Replace your board with ${incoming.length} imported tasks?`))return;snapshot();tasks=incoming.map(t=>({id:String(t.id||uid()),title:t.title.slice(0,120),description:String(t.description||'').slice(0,1000),category:t.category,status:t.status,due:/^\d{4}-\d{2}-\d{2}$/.test(t.due||'')?t.due:'',created:Number(t.created)||Date.now()}));save();render();notice('Board imported')}catch{notice('That file is not a valid Daymark board')}finally{e.target.value=''}};try{let data=JSON.parse(localStorage.getItem(KEY)||'null');tasks=data?.version===1&&Array.isArray(data.tasks)?data.tasks:seed()}catch{tasks=seed()}if(!localStorage.getItem(KEY))save();render()})();
