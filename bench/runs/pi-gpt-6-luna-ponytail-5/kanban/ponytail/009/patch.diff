index 0000000..3e05c4f
--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,20 @@
+(() => {
+const KEY='daymark-board-v1', defaults=[{id:'todo',name:'To do'},{id:'doing',name:'In progress'},{id:'waiting',name:'Up next'},{id:'done',name:'Done'}];
+const seed=[{id:uid(),title:'Make this board yours',notes:'Add a task, set a due date, or drag cards between columns. Your board saves automatically.',priority:'low',column:'todo',tags:['getting started'],due:''},{id:uid(),title:'Pick one thing to focus on',notes:'A clear next step beats a perfect plan.',priority:'medium',column:'doing',tags:[],due:''}];
+function uid(){return Math.random().toString(36).slice(2,10)}
+let state;try{state=JSON.parse(localStorage.getItem(KEY))}catch{}if(!state||!Array.isArray(state.columns)||!Array.isArray(state.tasks))state={columns:defaults,tasks:seed};
+const $=s=>document.querySelector(s), board=$('#board'), dialog=$('#taskDialog'), form=$('#taskForm');let filter='all', query='';
+function persist(){try{localStorage.setItem(KEY,JSON.stringify(state));$('#saveStatus').textContent='Saved on this device'}catch{$('#saveStatus').textContent='Could not save — storage is full'}}
+function dateKey(d=new Date()){return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
+function render(){const now=dateKey();$('#todayLabel').textContent=new Intl.DateTimeFormat(undefined,{weekday:'long'}).format(new Date()).toUpperCase();$('#todayDate').textContent=new Intl.DateTimeFormat(undefined,{month:'long',day:'numeric'}).format(new Date());let active=state.tasks.filter(t=>t.column!=='done').length;$('#taskSummary').textContent=`${active} active task${active===1?'':'s'} · ${state.tasks.length} total`;
+board.innerHTML='';state.columns.forEach(col=>{const wrap=document.createElement('section');wrap.className='column';wrap.dataset.column=col.id;const visible=state.tasks.filter(t=>t.column===col.id&&matches(t,now));wrap.innerHTML=`<div class="column-head"><span class="column-dot"></span><span class="column-title"></span><span class="count">${visible.length}</span><button class="column-add" title="Add task here" aria-label="Add task to ${esc(col.name)}">+</button></div><div class="cards"></div>`;wrap.querySelector('.column-title').textContent=col.name;wrap.querySelector('.column-add').onclick=()=>openTask(null,col.id);const cards=wrap.querySelector('.cards');if(!visible.length){const empty=document.createElement('div');empty.className='empty';empty.textContent=query||filter!=='all'?'No matching tasks':'Drop a task here or add one';cards.append(empty)}visible.forEach(t=>cards.append(makeCard(t,now)));wrap.addEventListener('dragover',e=>{e.preventDefault();wrap.classList.add('drag-over')});wrap.addEventListener('dragleave',e=>{if(!wrap.contains(e.relatedTarget))wrap.classList.remove('drag-over')});wrap.addEventListener('drop',e=>{e.preventDefault();wrap.classList.remove('drag-over');const task=state.tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(task){task.column=col.id;persist();render()}});board.append(wrap)})}
+function matches(t,now){if(filter==='today'&&t.due!==now)return false;if(filter==='overdue'&&(!t.due||t.due>=now||t.column==='done'))return false;const hay=[t.title,t.notes,...(t.tags||[])].join(' ').toLowerCase();return hay.includes(query)}
+function makeCard(t,now){const card=document.createElement('article');card.className='card';card.draggable=true;card.dataset.id=t.id;const top=document.createElement('div');top.className='card-top';const priority=document.createElement('span');priority.className=`priority ${t.priority}`;priority.textContent=t.priority;const more=document.createElement('button');more.className='more';more.setAttribute('aria-label','Edit '+t.title);more.textContent='···';more.onclick=()=>openTask(t.id);top.append(priority,more);card.append(top);const title=document.createElement('h3');title.textContent=t.title;card.append(title);if(t.notes){const note=document.createElement('p');note.className='card-note';note.textContent=t.notes;card.append(note)}if(t.tags?.length){const tags=document.createElement('div');tags.className='tags';t.tags.forEach(x=>{const tag=document.createElement('span');tag.className='tag';tag.textContent=x;tags.append(tag)});card.append(tags)}const bottom=document.createElement('div');bottom.className='card-bottom';const due=document.createElement('span');due.className='due';if(t.due){due.textContent='◷ '+new Intl.DateTimeFormat(undefined,{month:'short',day:'numeric'}).format(new Date(t.due+'T12:00:00'));if(t.due<now&&t.column!=='done')due.classList.add('late');else if(t.due===now)due.classList.add('today')}const action=document.createElement('span');action.textContent=t.column==='done'?'✓ complete':'Open task';bottom.append(due,action);card.append(bottom);card.onclick=e=>{if(!e.target.closest('button'))openTask(t.id)};card.ondragstart=e=>{e.dataTransfer.setData('text/plain',t.id);card.classList.add('dragging')};card.ondragend=()=>card.classList.remove('dragging');return card}
+function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+function openTask(id,column){const t=state.tasks.find(x=>x.id===id);$('#dialogTitle').textContent=t?'Edit task':'New task';$('#taskId').value=t?.id||'';$('#taskName').value=t?.title||'';$('#taskNotes').value=t?.notes||'';$('#taskPriority').value=t?.priority||'medium';$('#taskDue').value=t?.due||'';$('#taskTags').value=(t?.tags||[]).join(', ');$('#taskColumn').innerHTML=state.columns.map(c=>`<option value="${esc(c.id)}">${esc(c.name)}</option>`).join('');$('#taskColumn').value=t?.column||column||state.columns[0]?.id;$('#deleteTask').style.visibility=t?'visible':'hidden';dialog.showModal();setTimeout(()=>$('#taskName').focus(),0)}
+form.onsubmit=e=>{e.preventDefault();const id=$('#taskId').value;const data={id:id||uid(),title:$('#taskName').value.trim(),notes:$('#taskNotes').value.trim(),priority:$('#taskPriority').value,due:$('#taskDue').value,column:$('#taskColumn').value,tags:[...new Set($('#taskTags').value.split(',').map(x=>x.trim()).filter(Boolean))]};if(!data.title)return;if(id)Object.assign(state.tasks.find(t=>t.id===id),data);else state.tasks.push(data);persist();dialog.close();render()};
+function close(){dialog.close()}$('#closeDialog').onclick=close;$('#cancelDialog').onclick=close;$('#deleteTask').onclick=()=>{const id=$('#taskId').value;if(id&&confirm('Delete this task? This cannot be undone.')){state.tasks=state.tasks.filter(t=>t.id!==id);persist();close();render()}};
+document.querySelectorAll('.filter').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelector('.filter.active').classList.remove('active');b.classList.add('active');render()});$('#search').oninput=e=>{query=e.target.value.toLowerCase().trim();render()};$('#clearSearch').onclick=()=>{$('#search').value='';query='';render()};document.addEventListener('keydown',e=>{if(e.key==='/'&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();$('#search').focus()}if(e.key==='Escape'&&dialog.open)close();if(e.key==='n'&&!dialog.open&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName))openTask()});$('#addTask').onclick=()=>openTask();
+$('#export').onclick=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(state,null,2)],{type:'application/json'}));a.download=`daymark-backup-${dateKey()}.json`;a.click();URL.revokeObjectURL(a.href)};
+render();
+})();
