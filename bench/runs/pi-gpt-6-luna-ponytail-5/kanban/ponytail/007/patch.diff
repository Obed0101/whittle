+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#f6f7f9"><title>Daymark — Personal kanban</title><link rel="stylesheet" href="styles.css">
+</head>
+<body>
+<header class="topbar"><a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d</span><span>daymark</span></a><div class="top-actions"><label class="search"><span aria-hidden="true">⌕</span><input id="search" type="search" placeholder="Find a task…" aria-label="Search tasks"><kbd>/</kbd></label><button class="icon-btn" id="exportBtn" title="Export board" aria-label="Export board">⇩</button><button class="icon-btn" id="importBtn" title="Import board" aria-label="Import board">⇧</button><input id="importFile" type="file" accept="application/json" hidden><button class="avatar" id="helpBtn" title="Keyboard shortcuts" aria-label="Keyboard shortcuts">?</button></div></header>
+<main class="app"><div class="welcome"><div><p class="eyebrow">YOUR SPACE · <span id="today"></span></p><h1>Make room for <em>good work.</em></h1><p class="subtitle">A little progress, every day.</p></div><button class="primary" id="addTask">＋ <span>New task</span></button></div>
+<div class="toolbar"><div class="filters" role="group" aria-label="Filter by priority"><button class="filter active" data-filter="all">Everything <span id="countAll">0</span></button><button class="filter" data-filter="high">High priority</button><button class="filter" data-filter="due">Due soon</button></div><div class="board-tools"><span id="boardStats" class="stats"></span><button id="clearDone" class="text-button">Clear completed</button></div></div>
+<section id="board" class="board" aria-label="Kanban board"></section><footer><span>Small steps count.</span><span>Saved on this device <i class="saved-dot"></i></span></footer></main>
+<dialog id="taskDialog"><form id="taskForm"><div class="modal-head"><div><p class="eyebrow" id="dialogEyebrow">NEW TASK</p><h2 id="dialogTitle">Add to your list</h2></div><button type="button" class="close" aria-label="Close">×</button></div><input type="hidden" id="taskId"><label class="field-label" for="taskName">What needs doing?</label><input id="taskName" class="text-input" maxlength="120" required placeholder="Give it a clear name…"><label class="field-label" for="taskNotes">A few details <span class="optional">OPTIONAL</span></label><textarea id="taskNotes" class="text-input" rows="3" maxlength="1000" placeholder="Add context, links, or a next step…"></textarea><div class="form-row"><label class="field-label">Priority<select id="taskPriority" class="text-input"><option value="normal">Normal</option><option value="high">High</option><option value="low">Low</option></select></label><label class="field-label">Due date<input id="taskDue" class="text-input" type="date"></label></div><label class="field-label" for="taskColumn">Column</label><select id="taskColumn" class="text-input"></select><div class="modal-actions"><button type="button" id="deleteTask" class="delete-button">Delete task</button><div><button type="button" class="secondary close">Cancel</button><button class="primary" type="submit">Save task</button></div></div></form></dialog>
+<dialog id="helpDialog"><div class="modal-head"><div><p class="eyebrow">QUICK HELP</p><h2>Your board, your pace.</h2></div><button class="close" aria-label="Close">×</button></div><p class="help-copy">Drag tasks between columns, or use the column menu on each task. Your board is saved automatically in this browser.</p><div class="shortcuts"><span>New task</span><kbd>N</kbd><span>Search</span><kbd>/</kbd><span>Close dialog</span><kbd>Esc</kbd></div><button class="primary help-done close">Got it</button></dialog>
+<div id="toast" role="status" aria-live="polite"></div><script src="app.js"></script></body></html>
