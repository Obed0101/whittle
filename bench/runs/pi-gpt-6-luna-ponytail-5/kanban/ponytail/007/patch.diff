index 0000000..988956b
--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,17 @@
+(() => {
+const columns=[['inbox','Up next'],['doing','In progress'],['waiting','On hold'],['done','Done']];
+const key='daymark-board-v1';let tasks=[],filter='all',query='',toastTimer;
+const $=s=>document.querySelector(s), board=$('#board'), dialog=$('#taskDialog');
+function fresh(){return [{id:uid(),title:'Plan a good week',notes:'Pick three things that matter most.',priority:'normal',due:'',status:'inbox',completed:false},{id:uid(),title:'Make space for focus',notes:'Block an hour for uninterrupted work.',priority:'high',due:'',status:'doing',completed:false},{id:uid(),title:'Take a proper break',notes:'A walk counts. So does doing nothing.',priority:'low',due:'',status:'done',completed:true}]}
+function uid(){return crypto.randomUUID?crypto.randomUUID():Date.now().toString(36)+Math.random().toString(36).slice(2)}
+try{const saved=JSON.parse(localStorage.getItem(key));tasks=Array.isArray(saved)?saved.filter(t=>t&&typeof t.id==='string'&&typeof t.title==='string'&&columns.some(c=>c[0]===t.status)).map(t=>({...t,priority:['high','low','normal'].includes(t.priority)?t.priority:'normal',notes:typeof t.notes==='string'?t.notes:'',due:typeof t.due==='string'?t.due:'',completed:!!t.completed})):fresh()}catch{tasks=fresh()}
+function persist(){localStorage.setItem(key,JSON.stringify(tasks));}
+function dateLabel(value){if(!value)return '';const d=new Date(value+'T00:00:00'),today=new Date();today.setHours(0,0,0,0);const diff=Math.round((d-today)/86400000);return diff===0?'Today':diff===1?'Tomorrow':diff===-1?'Yesterday':d.toLocaleDateString(undefined,{month:'short',day:'numeric'})}
+function render(){board.innerHTML='';const visible=tasks.filter(t=>{const hay=(t.title+' '+t.notes).toLowerCase(),matches=hay.includes(query);return matches&&(filter==='all'||filter==='high'&&t.priority==='high'||filter==='due'&&t.due&&new Date(t.due+'T23:59:59')>=new Date())});for(const [id,name] of columns){const items=visible.filter(t=>t.status===id),col=document.createElement('section');col.className='column';col.dataset.col=id;col.innerHTML=`<div class="column-head"><div class="column-title"><i class="column-dot"></i>${name}<span class="column-count">${items.length}</span></div><button class="add-small" aria-label="Add task to ${name}" title="Add task">＋</button></div><div class="cards"></div><button class="column-add">＋ Add a task</button>`;const cards=col.querySelector('.cards');col.querySelectorAll('.add-small,.column-add').forEach(b=>b.onclick=()=>openTask(null,id));for(const t of items){const card=document.createElement('article');card.className='card'+(t.completed?' completed':'');card.draggable=true;card.dataset.id=t.id;const check=document.createElement('button');check.className='check';check.setAttribute('aria-label',t.completed?'Mark incomplete':'Mark complete');check.onclick=()=>{t.completed=!t.completed;if(t.completed)t.status='done';persist();render()};const title=document.createElement('h3');title.textContent=t.title;const more=document.createElement('button');more.className='more';more.textContent='···';more.setAttribute('aria-label','Edit task');more.onclick=()=>openTask(t.id);card.append(check,title,more);if(t.notes){const n=document.createElement('p');n.className='card-note';n.textContent=t.notes;card.append(n)}const foot=document.createElement('div');foot.className='card-footer';if(t.priority!=='normal'){const p=document.createElement('span');p.className='pill '+t.priority;p.textContent=t.priority==='high'?'↑ High':'↓ Low';foot.append(p)}if(t.due){const d=document.createElement('span');d.className='due'+(new Date(t.due+'T23:59:59')<new Date()&&!t.completed?' overdue':'');d.textContent='◷ '+dateLabel(t.due);foot.append(d)}if(foot.childNodes.length)card.append(foot);card.onclick=e=>{if(e.target===card||e.target===title)openTask(t.id)};card.ondragstart=e=>{e.dataTransfer.setData('text/plain',t.id);setTimeout(()=>card.classList.add('dragging'),0)};card.ondragend=()=>card.classList.remove('dragging');cards.append(card)}if(!items.length){const empty=document.createElement('div');empty.className='empty';empty.textContent=query||filter!=='all'?'No matching tasks':'Nothing here just yet';cards.append(empty)}col.ondragover=e=>{e.preventDefault();col.classList.add('drag-over')};col.ondragleave=e=>{if(!col.contains(e.relatedTarget))col.classList.remove('drag-over')};col.ondrop=e=>{e.preventDefault();col.classList.remove('drag-over');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=id;if(id==='done')t.completed=true;persist();render()}};board.append(col)}$('#countAll').textContent=tasks.length;$('#boardStats').textContent=`${tasks.filter(t=>!t.completed).length} open · ${tasks.filter(t=>t.completed).length} completed`}
+function openTask(id,status='inbox'){const t=tasks.find(x=>x.id===id);$('#taskForm').reset();$('#taskId').value=t?.id||'';$('#taskName').value=t?.title||'';$('#taskNotes').value=t?.notes||'';$('#taskPriority').value=t?.priority||'normal';$('#taskDue').value=t?.due||'';$('#taskColumn').innerHTML=columns.map(([v,n])=>`<option value="${v}">${n}</option>`).join('');$('#taskColumn').value=t?.status||status;$('#dialogTitle').textContent=t?'Edit task':'Add to your list';$('#dialogEyebrow').textContent=t?'TASK DETAILS':'NEW TASK';$('#deleteTask').style.visibility=t?'visible':'hidden';dialog.showModal();$('#taskName').focus()}
+$('#taskForm').onsubmit=e=>{e.preventDefault();const id=$('#taskId').value,old=tasks.find(t=>t.id===id),t={id:id||uid(),title:$('#taskName').value.trim(),notes:$('#taskNotes').value.trim(),priority:$('#taskPriority').value,due:$('#taskDue').value,status:$('#taskColumn').value,completed:old?.completed||false};if(!t.title)return;if(t.status==='done')t.completed=true;else if(old?.status==='done'&&t.status!=='done')t.completed=false;if(old)Object.assign(old,t);else tasks.push(t);persist();dialog.close();render()};$('#deleteTask').onclick=()=>{const id=$('#taskId').value;if(id&&confirm('Delete this task? This cannot be undone.')){tasks=tasks.filter(t=>t.id!==id);persist();dialog.close();render()}};
+document.querySelectorAll('.close').forEach(b=>b.onclick=()=>b.closest('dialog').close());$('#addTask').onclick=()=>openTask();$('#search').oninput=e=>{query=e.target.value.toLowerCase();render()};document.querySelectorAll('.filter').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelectorAll('.filter').forEach(x=>x.classList.toggle('active',x===b));render()});$('#clearDone').onclick=()=>{const count=tasks.filter(t=>t.status==='done').length;if(count&&confirm(`Remove ${count} completed ${count===1?'task':'tasks'}?`)){tasks=tasks.filter(t=>t.status!=='done');persist();render()}};
+function showToast(msg){const el=$('#toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2400)}
+$('#exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify({version:1,tasks},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`daymark-${new Date().toISOString().slice(0,10)}.json`;a.click();URL.revokeObjectURL(a.href);showToast('Board exported')};$('#importBtn').onclick=()=>$('#importFile').click();$('#importFile').onchange=async e=>{const file=e.target.files[0];if(!file)return;try{const data=JSON.parse(await file.text()),incoming=Array.isArray(data)?data:data.tasks;if(!Array.isArray(incoming)||incoming.some(t=>!t||typeof t.title!=='string'||!columns.some(c=>c[0]===t.status)||!['high','low','normal'].includes(t.priority))||incoming.length>10000)throw Error();if(confirm(`Replace your board with ${incoming.length} imported tasks?`)){tasks=incoming.map(t=>({...t,id:uid(),title:t.title.slice(0,120),notes:typeof t.notes==='string'?t.notes.slice(0,1000):'',due:typeof t.due==='string'&&/^\d{4}-\d\d-\d\d$/.test(t.due)?t.due:'',completed:!!t.completed}));persist();render();showToast('Board imported')}}catch{showToast('That file is not a valid Daymark board')}e.target.value=''};
+$('#helpBtn').onclick=()=>$('#helpDialog').showModal();document.addEventListener('keydown',e=>{if(e.key==='Escape')return;if(e.target.matches('input,textarea,select'))return;if(e.key.toLowerCase()==='n'){e.preventDefault();openTask()}if(e.key==='/'){e.preventDefault();$('#search').focus()}});$('#today').textContent=new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'});render();
+})();
