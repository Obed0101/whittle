+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f5f5f1"><title>Dayboard — your work, in motion</title>
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<div class="app">
+  <aside class="sidebar">
+    <a class="brand" href="#"><span class="brand-mark">d</span><span>dayboard<small>YOUR PERSONAL SPACE</small></span></a>
+    <div class="side-label">WORKSPACE</div><button class="nav active"><span>▦</span> My board</button>
+    <div class="side-bottom"><div class="tip"><span class="tip-icon">✳</span><b>A little progress<br>adds up.</b><p>Keep your focus on what matters today.</p></div><button id="exportBtn" class="side-action">↗ &nbsp;Export board</button><button id="importBtn" class="side-action">↙ &nbsp;Import board</button><input id="importFile" type="file" accept="application/json" hidden><div class="local-note"><i></i> Saved on this device</div></div>
+  </aside>
+  <main>
+    <header><div class="crumb">WORKSPACE <span>/</span> MY BOARD</div><div class="header-right"><span class="date" id="today"></span><button class="avatar" title="Personal workspace">Y</button></div></header>
+    <section class="intro"><div><div class="eyebrow"><span></span> YOUR PERSONAL KANBAN</div><h1>Make room for <em>progress.</em></h1><p>A clear view of what’s moving, what’s next, and what can wait.</p></div><button class="primary" id="addTask"><span>＋</span> New task</button></section>
+    <section class="toolbar"><div class="search"><span>⌕</span><input id="search" placeholder="Find a task…" aria-label="Find a task"><kbd>⌘ K</kbd></div><div class="filters"><button class="filter active" data-filter="all">All tasks <b id="allCount">0</b></button><button class="filter" data-filter="today">Due today <b id="todayCount">0</b></button><button class="filter" data-filter="overdue">Overdue <b id="overdueCount">0</b></button></div><button class="icon-button" id="clearDone" title="Clear completed tasks">✓<span> Clear done</span></button></section>
+    <section class="board" id="board"></section>
+    <footer><span>Drag cards between columns to keep things moving.</span><span>Changes save automatically <b>·</b> <button id="resetBtn">Reset sample board</button></span></footer>
+  </main>
+</div>
+<dialog id="taskDialog"><form id="taskForm"><div class="modal-head"><div><div class="eyebrow"><span></span> TASK DETAILS</div><h2 id="dialogTitle">New task</h2></div><button type="button" class="close" id="closeDialog" aria-label="Close">×</button></div><label>Task name<input id="taskTitle" required maxlength="120" placeholder="What needs doing?"></label><label>Notes <span class="optional">· optional</span><textarea id="taskNotes" maxlength="1000" rows="3" placeholder="Add a little context…"></textarea></label><div class="form-row"><label>Column<select id="taskStatus"><option value="backlog">To do</option><option value="progress">In progress</option><option value="done">Done</option></select></label><label>Due date<input id="taskDue" type="date"></label></div><label>Priority<select id="taskPriority"><option value="normal">No priority</option><option value="high">High</option><option value="low">Low</option></select></label><div class="modal-actions"><button type="button" class="delete-task" id="deleteTask">Delete task</button><button type="button" class="secondary" id="cancelDialog">Cancel</button><button class="primary" type="submit">Save task</button></div></form></dialog>
+<div class="toast" id="toast" role="status"></div>
+<script src="app.js"></script>
+</body></html>
