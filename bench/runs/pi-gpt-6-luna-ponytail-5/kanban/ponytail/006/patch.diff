acing:1.3px;color:#92968d}.crumb span{margin:0 9px;color:#c7c9c2}.header-right{display:flex;align-items:center;gap:16px}.date{font-size:11px;color:#7f847b}.avatar{border:0;background:#dce9dc;border-radius:50%;width:29px;height:29px;font:700 11px 'DM Sans';color:#386045}.intro{display:flex;justify-content:space-between;align-items:flex-end;padding:43px 0 29px}.eyebrow{font-size:9px;letter-spacing:1.4px;color:#81867d;font-weight:700}.intro h1{font:700 32px Manrope,sans-serif;letter-spacing:-1.3px;margin:11px 0 7px}.intro h1 em{font-style:normal;color:var(--green)}.intro p{margin:0;color:#81867d;font-size:12px}.primary{border:0;border-radius:7px;background:var(--green);color:white;padding:11px 15px;font:600 12px 'DM Sans';cursor:pointer;box-shadow:0 2px 4px #315d431c}.primary:hover{background:#315d43}.primary span{font-size:17px;vertical-align:-1px;margin-right:5px}.toolbar{height:52px;border-bottom:1px solid var(--line);display:flex;align-items:flex-start;gap:22px}.search{width:232px;height:34px;border:1px solid #e7e8e2;border-radius:6px;background:#fff;display:flex;align-items:center;padding:0 9px;color:#92968d}.search>span{font-size:20px;transform:rotate(-20deg);margin-right:7px}.search input{border:0;outline:0;width:100%;font:11px 'DM Sans';color:var(--ink)}kbd{white-space:nowrap;border:1px solid #e8e9e4;border-radius:3px;padding:2px 4px;font-size:9px;color:#969990}.filters{display:flex;gap:6px;align-items:center}.filter{background:transparent;border:0;color:#81867d;font:500 11px 'DM Sans';padding:9px 8px;cursor:pointer}.filter b{font-size:9px;background:#eeefeb;border-radius:8px;padding:2px 6px;margin-left:4px;color:#74796f}.filter.active{color:#315d43;border-bottom:2px solid var(--green)}.filter.active b{background:#e4eee4;color:#315d43}.icon-button{margin-left:auto;border:0;background:transparent;color:#878b83;font:500 10px 'DM Sans';padding:10px;cursor:pointer}.icon-button:hover{color:var(--orange)}.board{display:grid;grid-template-columns:repeat(3,minmax(0,1fr