diff --git a/board/app.js b/board/app.js
new file mode 100644
index 0000000..d2767ae
--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,23 @@
+const KEY='dayboard-v1';
+const samples=[
+ {id:'a1',title:'Plan the week ahead',notes:'Pick the three things that would make this week feel like a win.',status:'backlog',priority:'high',due:''},
+ {id:'a2',title:'Book annual checkup',notes:'Find a time that works and add it to the calendar.',status:'backlog',priority:'normal',due:''},
+ {id:'a3',title:'Refresh portfolio case study',notes:'Tighten the story and choose the strongest screenshots.',status:'progress',priority:'high',due:''},
+ {id:'a4',title:'Read 20 pages',notes:'A small daily habit is still a habit.',status:'progress',priority:'low',due:''},
+ {id:'a5',title:'Send thank-you note',notes:'',status:'done',priority:'normal',due:''}
+];
+const columns=[['backlog','TO DO'],['progress','IN PROGRESS'],['done','DONE']];let tasks=load(),filter='all',query='',editing=null;
+function load(){try{const value=JSON.parse(localStorage.getItem(KEY));return Array.isArray(value)?value:samples.map(x=>({...x}))}catch{return samples.map(x=>({...x}))}}
+function save(){localStorage.setItem(KEY,JSON.stringify(tasks));render()}
+const $=s=>document.querySelector(s), todayISO=()=>new Date().toISOString().slice(0,10);
+function render(){const now=todayISO();const visible=tasks.filter(t=>(!query||`${t.title} ${t.notes}`.toLowerCase().includes(query))&&(filter==='all'||filter==='today'&&t.due===now&&t.status!=='done'||filter==='overdue'&&t.due&&t.due<now&&t.status!=='done'));$('#allCount').textContent=tasks.length;$('#todayCount').textContent=tasks.filter(t=>t.due===now&&t.status!=='done').length;$('#overdueCount').textContent=tasks.filter(t=>t.due&&t.due<now&&t.status!=='done').length;
+ $('#board').innerHTML=columns.map(([status,label])=>{const list=visible.filter(t=>t.status===status);return `<section class="column"><div class="column-head"><div class="column-title">${label}<span class="count">${tasks.filter(t=>t.status===status).length}</span></div><button class="add-column" data-new="${status}" aria-label="Add task to ${label}">＋</button></div><div class="cards" data-status="${status}">${list.length?list.map(card).join(''):'<div class="empty">Nothing here right now</div>'}</div></section>`}).join('');
+ document.querySelectorAll('.card').forEach(el=>{el.addEventListener('click',()=>openTask(el.dataset.id));el.addEventListener('dragstart',e=>{e.dataTransfer.setData('text/plain',el.dataset.id);e.dataTransfer.effectAllowed='move'})});document.querySelectorAll('.cards').forEach(el=>{el.addEventListener('dragover',e=>{e.preventDefault();el.classList.add('drag-over')});el.addEventListener('dragleave',()=>el.classList.remove('drag-over'));el.addEventListener('drop',e=>{e.preventDefault();el.classList.remove('drag-over');const task=tasks.find(t=>t.id===e.dataTransfer.getData('text/plain'));if(task){task.status=el.dataset.status;save()}})});document.querySelectorAll('[data-new]').forEach(b=>b.onclick=()=>openTask(null,b.dataset.new))}
+function card(t){const due=t.due?new Date(t.due+'T12:00:00').toLocaleDateString(undefined,{month:'short',day:'numeric'}):'';const cls=t.due&&t.due<todayISO()&&t.status!=='done'?'late':t.due===todayISO()?'today':'';return `<article class="card" draggable="true" data-id="${esc(t.id)}"><div class="card-top"><span class="priority ${t.priority==='normal'?'':t.priority}">${t.priority==='normal'?'':t.priority==='high'?'↑ HIGH':'↓ LOW'}</span><button class="card-menu" aria-label="Edit ${esc(t.title)}">···</button></div><h3>${esc(t.title)}</h3>${t.notes?`<p class="card-notes">${esc(t.notes)}</p>`:''}<div class="card-foot"><span class="due ${cls}">${due?`${cls==='late'?'! ':''}${due}`:' '}</span><span class="edit-hint">↗</span></div></article>`}
+function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+function openTask(id,status='backlog'){editing=id;const t=tasks.find(x=>x.id===id);$('#dialogTitle').textContent=t?'Edit task':'New task';$('#taskTitle').value=t?.title||'';$('#taskNotes').value=t?.notes||'';$('#taskStatus').value=t?.status||status;$('#taskDue').value=t?.due||'';$('#taskPriority').value=t?.priority||'normal';$('#deleteTask').hidden=!t;$('#taskDialog').showModal();$('#taskTitle').focus()}
+$('#taskForm').addEventListener('submit',e=>{e.preventDefault();const data={title:$('#taskTitle').value.trim(),notes:$('#taskNotes').value.trim(),status:$('#taskStatus').value,due:$('#taskDue').value,priority:$('#taskPriority').value};if(!data.title)return;if(editing){Object.assign(tasks.find(t=>t.id===editing),data)}else tasks.push({id:crypto.randomUUID(),...data});$('#taskDialog').close();save();toast('Task saved')});
+function toast(s){const t=$('#toast');t.textContent=s;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),1900)}
+$('#deleteTask').onclick=()=>{if(editing&&confirm('Delete this task?')){tasks=tasks.filter(t=>t.id!==editing);$('#taskDialog').close();save();toast('Task deleted')}};$('#closeDialog').onclick=$('#cancelDialog').onclick=()=>$('#taskDialog').close();$('#addTask').onclick=()=>openTask();$('#search').oninput=e=>{query=e.target.value.trim().toLowerCase();render()};document.querySelectorAll('.filter').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelectorAll('.filter').forEach(x=>x.classList.toggle('active',x===b));render()});$('#clearDone').onclick=()=>{const n=tasks.filter(t=>t.status==='done').length;if(n&&confirm(`Clear ${n} completed task${n===1?'':'s'}?`)){tasks=tasks.filter(t=>t.status!=='done');save();toast('Completed tasks cleared')}};
+$('#exportBtn').onclick=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(tasks,null,2)],{type:'application/json'}));a.download='dayboard.json';a.click();URL.revokeObjectURL(a.href)};$('#importBtn').onclick=()=>$('#importFile').click();$('#importFile').onchange=async e=>{try{const data=JSON.parse(await e.target.files[0].text());if(!Array.isArray(data)||data.some(t=>!t||typeof t.title!=='string'||!['backlog','progress','done'].includes(t.status)))throw Error();if(confirm(`Replace your board with ${data.length} imported tasks?`)){tasks=data.map(t=>({id:String(t.id||crypto.randomUUID()),title:t.title.slice(0,120),notes:String(t.notes||'').slice(0,1000),status:t.status,priority:['high','low'].includes(t.priority)?t.priority:'normal',due:/^\d{4}-\d{2}-\d{2}$/.test(t.due||'')?t.due:''}));save();toast('Board imported')}}catch{alert('That file is not a valid Dayboard export.')}e.target.value=''};$('#resetBtn').onclick=()=>{if(confirm('Replace this board with the sample tasks? This cannot be undone.')){tasks=samples.map(t=>({...t}));filter='all';query='';$('#search').value='';save();toast('Sample board restored')}};
+document.addEventListener('keydown',e=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();$('#search').focus()}if(e.key==='Escape'&&$('#taskDialog').open)$('#taskDialog').close()});$('#today').textContent=new Date().toLocaleDateString(undefined,{weekday:'short',month:'short',day:'numeric'});render();
