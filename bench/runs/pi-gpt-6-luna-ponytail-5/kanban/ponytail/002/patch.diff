+  }
+  function card(t){const due=dateLabel(t.due);return `<article class="task-card" data-id="${esc(t.id)}" tabindex="0" aria-label="${esc(t.title)}"><div class="task-top"><span class="priority ${esc(t.priority||'medium')}">${esc(t.priority||'medium')}</span><div class="card-menu-wrap"><button class="card-menu" data-menu="${esc(t.id)}" aria-label="Task options">···</button></div></div><div class="task-title">${esc(t.title)}</div>${t.description?`<div class="task-description">${esc(t.description)}</div>`:''}${due.text?`<div class="task-meta"><span class="due ${due.cls}">◷ ${due.text}</span></div>`:''}</article>`}
+  function openTask(id,status='todo'){const t=tasks.find(x=>x.id===id);$('#taskId').value=t?.id||'';$('#dialogTitle').textContent=t?'Edit task':'New task';$('#taskTitle').value=t?.title||'';$('#taskDescription').value=t?.description||'';$('#taskPriority').value=t?.priority||'medium';$('#taskDue').value=t?.due||'';$('#deleteTask').hidden=!t;const current=t?.status||status;$('#statusOptions').innerHTML=statuses.map(([s,n])=>`<button type="button" class="status-choice ${current===s?'active':''}" data-status-choice="${s}">${n}</button>`).join('');$('#statusOptions').querySelectorAll('button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.status-choice').forEach(x=>x.classList.remove('active'));b.classList.add('active')});dialog.showModal();$('#taskTitle').focus()}
