+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f7f7f4">
+<title>Daymark — Personal Kanban</title>
+<link rel="stylesheet" href="styles.css">
+</head>
+<body>
+<div class="app-shell">
+  <aside class="sidebar">
+    <a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d</span><span>daymark</span></a>
+    <div class="workspace-label">YOUR WORKSPACE</div>
+    <button class="nav-item active" id="boardNav"><span class="nav-icon">▦</span> My board <span class="nav-count" id="totalCount">0</span></button>
+    <div class="sidebar-bottom"><div class="local-note"><span class="sync-dot"></span><span><b>Saved on this device</b><small>Your board stays private</small></span></div><button class="text-button" id="exportBtn">Export backup</button><label class="text-button import-label" for="importFile">Import backup</label><input type="file" id="importFile" accept="application/json" hidden></div>
+  </aside>
+  <main class="main">
+    <header class="topbar"><div class="breadcrumb">Workspace <span>/</span> <b>My board</b></div><div class="top-actions"><button class="icon-button" id="helpBtn" title="Keyboard shortcuts" aria-label="Keyboard shortcuts">?</button><div class="avatar" title="Your personal workspace">Y</div></div></header>
+    <section class="board-heading"><div><div class="eyebrow" id="todayLabel">PERSONAL WORKSPACE</div><h1>My board<span class="heading-period">.</span></h1><p class="subheading">A little progress, every day.</p></div><button class="primary-button" id="addTask"><span>＋</span> New task <kbd>N</kbd></button></section>
+    <section class="toolbar" aria-label="Board controls"><label class="search"><span>⌕</span><input id="searchInput" type="search" placeholder="Search tasks…" aria-label="Search tasks"><kbd>/</kbd></label><div class="filters"><button class="filter-button" id="priorityFilter">Priority <span>⌄</span></button><button class="filter-button" id="sortButton">Recently added <span>⌄</span></button><button class="filter-button clear-filter" id="clearFilters" hidden>Clear</button></div><div class="view-label"><span class="view-dot"></span> BOARD VIEW</div></section>
+    <section class="board" id="board" aria-label="Kanban board"></section>
+    <footer class="board-footer"><span>Make space for what matters.</span><span id="footerStats"></span></footer>
+  </main>
+</div>
+<div class="toast" id="toast" role="status" aria-live="polite"></div>
+<dialog id="taskDialog"><form id="taskForm" method="dialog"><div class="dialog-head"><div><div class="eyebrow">TASK DETAILS</div><h2 id="dialogTitle">New task</h2></div><button type="button" class="icon-button close-button" id="closeDialog" aria-label="Close">×</button></div><input type="hidden" id="taskId"><label class="field-label" for="taskTitle">Task name <em>*</em></label><input class="field-input" id="taskTitle" maxlength="140" required placeholder="What needs to get done?"><label class="field-label" for="taskDescription">Notes <span>optional</span></label><textarea class="field-input" id="taskDescription" rows="4" maxlength="1000" placeholder="Add a little context…"></textarea><div class="field-row"><div><label class="field-label" for="taskPriority">Priority</label><select class="field-input" id="taskPriority"><option value="medium">Medium</option><option value="high">High</option><option value="low">Low</option></select></div><div><label class="field-label" for="taskDue">Due date <span>optional</span></label><input class="field-input" id="taskDue" type="date"></div></div><div class="field-label status-label">Column</div><div class="status-options" id="statusOptions"></div><div class="dialog-actions"><button type="button" class="delete-button" id="deleteTask" hidden>Delete task</button><span class="action-spacer"></span><button type="button" class="secondary-button" id="cancelDialog">Cancel</button><button class="primary-button" type="submit">Save task</button></div></form></dialog>
+<dialog id="helpDialog" class="help-dialog"><button type="button" class="icon-button close-button" id="closeHelp" aria-label="Close">×</button><div class="eyebrow">A FEW SHORTCUTS</div><h2>Keep your hands moving.</h2><p><kbd>N</kbd> Create a task</p><p><kbd>/</kbd> Search your board</p><p><kbd>Esc</kbd> Close a dialog</p><button class="secondary-button" id="gotIt">Got it</button></dialog>
+<script src="app.js"></script>
+</body></html>
