+<body><main class="shell"><header class="top"><div class="brand"><span class="mark">◫</span> daymark</div><div class="topright"><span class="date" id="today"></span><button class="btn" id="export">Export</button><button class="btn" id="importBtn">Import</button><input id="importFile" type="file" accept="application/json" hidden><button class="btn primary" id="newTask">＋ Add task</button></div></header>
+<section class="heading"><div><div class="eyebrow">Your personal workspace</div><h1>Make room for what matters.</h1><p class="sub">A little progress, every day.</p></div><div class="stats"><div><strong id="activeStat">0</strong>in progress</div><div><strong id="doneStat">0</strong>completed</div><div><strong id="focusStat">0</strong>due today</div></div></section>
+<div class="toolbar"><div class="search"><input id="search" placeholder="Search your tasks…" aria-label="Search tasks"></div><select class="filter" id="priorityFilter" aria-label="Filter by priority"><option value="all">All priorities</option><option value="high">High priority</option><option value="medium">Medium priority</option><option value="low">Low priority</option></select><span class="hint">Drag cards to move them between columns</span></div><section class="board" id="board"></section><div class="footer"><span>Your board is saved automatically on this device.</span><span>Keep it small. Keep it moving.</span></div></main>
+<div class="modalback" id="backdrop"><form class="modal" id="taskForm"><button type="button" class="close" id="close" aria-label="Close">×</button><h2 id="modalTitle">Add a task</h2><input type="hidden" id="taskId"><div class="field"><label for="title">Task</label><input id="title" maxlength="120" required placeholder="What needs doing?"></div><div class="field"><label for="description">Notes <span style="font-weight:400;color:#81877f">(optional)</span></label><textarea id="description" maxlength="1000" placeholder="A little context…"></textarea></div><div class="row"><div class="field"><label for="priority">Priority</label><select id="priority"><option value="low">Low</option><option value="medium" selected>Medium</option><option value="high">High</option></select></div><div class="field"><label for="due">Due date <span style="font-weight:400;color:#81877f">(optional)</span></label><input id="due" type="date"></div></div><div class="field"><label for="status">Column</label><select id="status"></select></div><div class="modalactions"><button type="button" class="btn danger" id="delete" hidden>Delete task</button><div class="right"><button type="button" class="btn" id="cancel">Cancel</button><button class="btn primary" type="submit">Save task</button></div></div></form></div><div class="toast" id="toast" role="status"></div>
+<script>
+(()=>{'use strict';const KEY='daymark-board-v1',columns=[['todo','To do'],['doing','In progress'],['done','Done']];let tasks=[];try{const saved=JSON.parse(localStorage.getItem(KEY)||'[]');if(Array.isArray(saved))tasks=saved.filter(t=>t&&typeof t.id==='string'&&typeof t.title==='string'&&columns.some(c=>c[0]===t.status)).map(t=>({...t,description:String(t.description||''),priority:['low','medium','high'].includes(t.priority)?t.priority:'medium'}))}catch{};const $=s=>document.querySelector(s),esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),save=()=>localStorage.setItem(KEY,JSON.stringify(tasks));$('#today').textContent=new Intl.DateTimeFormat(undefined,{weekday:'short',month:'short',day:'numeric'}).format(new Date());const status=$('#status');columns.forEach(([id,name])=>status.add(new Option(name,id)));function render(){const query=$('#search').value.trim().toLowerCase(),priority=$('#priorityFilter').value;$('#board').innerHTML=columns.map(([id,name])=>{const list=tasks.filter(t=>t.status===id&&(!query||(t.title+' '+t.description).toLowerCase().includes(query))&&(priority==='all'||t.priority===priority));return `<section class="column" data-status="${id}"><div class="colhead"><i class="dot"></i><span class="colname">${name}</span><span class="count">${tasks.filter(t=>t.status===id).length}</span><button class="addsmall" data-add="${id}" aria-label="Add to ${name}">＋</button></div><div class="cards">${list.length?list.map(t=>`<article class="card" draggable="true" data-id="${esc(t.id)}"><button class="menu" data-edit="${esc(t.id)}" aria-label="Edit ${esc(t.title)}">···</button><div class="cardtitle">${esc(t.title)}</div>${t.description?`<div class="carddesc">${esc(t.description)}</div>`:''}<div class="tags"><span class="tag ${t.priority==='high'?'urgent':t.priority==='medium'?'soon':''}">${t.priority[0].toUpperCase()+t.priority.slice(1)}</span></div>${t.due?`<div class="due ${t.due<new Date().toISOString().slice(0,10)&&id!=='done'?'late':''}">${t.due<new Date().toISOString().slice(0,10)&&id!=='done'?'Overdue · ':''}${new Date(t.due+'T12:00:00').toLocaleDateString(undefined,{month:'short',day:'numeric'})}</div>`:''}</article>`).join(''):`<div class="empty">${query||priority!=='all'?'No matching tasks':'Nothing here yet'}</div>`}</div></section>`}).join('');$('#activeStat').textContent=tasks.filter(t=>t.status==='doing').length;$('#doneStat').textContent=tasks.filter(t=>t.status==='done').length;$('#focusStat').textContent=tasks.filter(t=>t.due===new Date().toISOString().slice(0,10)&&t.status!=='done').length;}
+function open(task=null,defaultStatus='todo'){const form=$('#taskForm');form.reset();$('#taskId').value=task?.id||'';$('#modalTitle').textContent=task?'Edit task':'Add a task';$('#title').value=task?.title||'';$('#description').value=task?.description||'';$('#priority').value=task?.priority||'medium';$('#due').value=task?.due||'';status.value=task?.status||defaultStatus;$('#delete').hidden=!task;$('#backdrop').classList.add('open');$('#title').focus()}function close(){ $('#backdrop').classList.remove('open') }$('#newTask').onclick=()=>open();$('#close').onclick=$('#cancel').onclick=close;$('#backdrop').addEventListener('click',e=>{if(e.target===$('#backdrop'))close()});document.addEventListener('keydown',e=>{if(e.key==='Escape')close()});$('#taskForm').onsubmit=e=>{e.preventDefault();const id=$('#taskId').value,entry={id:id||crypto.randomUUID(),title:$('#title').value.trim(),description:$('#description').value.trim(),priority:$('#priority').value,due:$('#due').value,status:status.value};if(!entry.title)return;if(id)tasks[tasks.findIndex(t=>t.id===id)]=entry;else tasks.unshift(entry);save();render();close();toast(id?'Task updated':'Task added')};$('#delete').onclick=()=>{const id=$('#taskId').value;if(confirm('Delete this task?')){tasks=tasks.filter(t=>t.id!==id);save();render();close();toast('Task deleted')}};$('#search').oninput=render;$('#priorityFilter').onchange=render;$('#board').onclick=e=>{const add=e.target.closest('[data-add]'),edit=e.target.closest('[data-edit]');if(add)open(null,add.dataset.add);if(edit){const t=tasks.find(x=>x.id===edit.dataset.edit);if(t)open(t)}};let dragged=null;$('#board').addEventListener('dragstart',e=>{const card=e.target.closest('.card');if(card){dragged=card.dataset.id;card.classList.add('dragging');e.dataTransfer.effectAllowed='move';e.dataTransfer.setData('text/plain',dragged)}});$('#board').addEventListener('dragend',e=>{e.target.closest('.card')?.classList.remove('dragging');document.querySelectorAll('.column').forEach(c=>c.classList.remove('over'))});$('#board').addEventListener('dragover',e=>{const col=e.target.closest('.column');if(col){e.preventDefault();document.querySelectorAll('.column').forEach(c=>c.classList.toggle('over',c===col))}});$('#board').addEventListener('drop',e=>{const col=e.target.closest('.column'),id=e.dataTransfer.getData('text/plain')||dragged;if(col&&id){e.preventDefault();const t=tasks.find(x=>x.id===id);if(t){t.status=col.dataset.status;save();render()}}});function toast(text){const el=$('#toast');el.textContent=text;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),1800)}$('#export').onclick=()=>{const blob=new Blob([JSON.stringify({version:1,tasks},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='daymark-board.json';a.click();URL.revokeObjectURL(a.href);toast('Board exported')};$('#importBtn').onclick=()=>$('#importFile').click();$('#importFile').onchange=async e=>{const file=e.target.files[0];if(!file)return;try{const data=JSON.parse(await file.text()),items=Array.isArray(data)?data:data.tasks;if(!Array.isArray(items)||items.some(t=>!t||typeof t.title!=='string'||!columns.some(c=>c[0]===t.status)))throw Error();if(!confirm(`Import ${items.length} tasks? This replaces your current board.`))return;tasks=items.map(t=>({id:crypto.randomUUID(),title:t.title.slice(0,120),description:String(t.description||'').slice(0,1000),priority:['low','medium','high'].includes(t.priority)?t.priority:'medium',due:/^\d{4}-\d{2}-\d{2}$/.test(t.due||'')?t.due:'',status:t.status}));save();render();toast('Board imported')}catch{alert('Could not import: choose a valid Daymark JSON export.')}finally{e.target.value=''}};render()})();
+</script></body></html>
