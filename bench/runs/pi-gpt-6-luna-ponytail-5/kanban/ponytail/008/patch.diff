+<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#f6f5f1"><title>Daymark — Personal Kanban</title>
+<style>
+:root{--bg:#f6f5f1;--paper:#fff;--ink:#202522;--muted:#81877f;--line:#e9e9e3;--green:#28634b;--wash:#e9f1eb;--shadow:0 6px 22px #26392b0b}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,textarea,select{font:inherit;color:inherit}button{cursor:pointer}.shell{max-width:1440px;margin:auto;padding:28px 42px 50px}.top{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding:0 0 22px}.brand{display:flex;align-items:center;gap:11px;font-weight:700;font-size:15px;letter-spacing:-.3px}.mark{width:29px;height:29px;background:var(--green);border-radius:9px;display:grid;place-items:center;color:white;font-size:17px}.topright{display:flex;gap:9px;align-items:center}.date{color:var(--muted);margin-right:12px;font-size:13px}.btn{border:1px solid var(--line);background:var(--paper);border-radius:8px;padding:9px 13px;font-size:13px;font-weight:600}.btn:hover{border-color:#bbc7bc}.primary{background:var(--green);color:white;border-color:var(--green)}.primary:hover{background:#1e503b}.heading{display:flex;align-items:flex-end;justify-content:space-between;padding:34px 0 24px}.eyebrow{color:var(--green);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.3px}.heading h1{font-size:32px;letter-spacing:-1.2px;margin:5px 0 4px}.sub{margin:0;color:var(--muted)}.stats{display:flex;gap:25px;color:var(--muted);font-size:12px}.stats strong{display:block;color:var(--ink);font-size:18px;margin-bottom:1px}.toolbar{display:flex;gap:10px;align-items:center;margin-bottom:17px}.search{position:relative;max-width:270px;flex:1}.search input{width:100%;height:38px;padding:0 12px 0 34px;border:1px solid var(--line);border-radius:8px;background:var(--paper);outline:none}.search:before{content:'⌕';position:absolute;left:12px;top:6px;color:var(--muted);font-size:20px}.filter{height:38px;border:1px solid var(--line);background:var(--paper);border-radius:8px;padding:0 30px 0 11px;color:#555}.hint{margin-left:auto;color:var(--muted);font-size:12px}.board{display:grid;grid-template-columns:repeat(4,minmax(220px,1fr));gap:15px;align-items:start}.column{background:#efeee9;border-radius:11px;padding:12px;min-height:300px;transition:background .15s}.column.over{background:#e4ece4}.colhead{display:flex;align-items:center;padding:2px 3px 12px}.dot{width:8px;height:8px;border-radius:50%;background:#9ba49a;margin-right:9px}.column:nth-child(2) .dot{background:#d5a34e}.column:nth-child(3) .dot{background:#6d9c85}.column:nth-child(4) .dot{background:#84948a}.colname{font-weight:700;font-size:13px}.count{margin-left:7px;color:#969b94;font-size:12px}.addsmall{margin-left:auto;border:0;background:transparent;color:#858b84;font-size:20px;padding:0 4px;line-height:1}.addsmall:hover{color:var(--green)}.cards{display:grid;gap:9px;min-height:45px}.card{background:var(--paper);border:1px solid #ecece7;border-radius:9px;padding:12px;box-shadow:var(--shadow);cursor:grab;position:relative}.card:active{cursor:grabbing}.card.dragging{opacity:.45}.cardtitle{font-weight:650;font-size:13px;line-height:1.4;padding-right:18px}.carddesc{color:var(--muted);font-size:12px;margin-top:6px;white-space:pre-wrap;line-height:1.45}.tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:10px}.tag{font-size:10px;font-weight:650;padding:3px 7px;border-radius:20px;background:#f0f2ed;color:#657066}.tag.urgent{background:#fae9e5;color:#a94c38}.tag.soon{background:#f8f0dd;color:#99722c}.due{font-size:11px;color:var(--muted);margin-top:9px}.due.late{color:#b54c3c;font-weight:650}.menu{position:absolute;right:8px;top:8px;border:0;background:none;color:#a2a69f;font-size:18px;line-height:1;padding:2px 5px}.empty{color:#a1a59e;text-align:center;padding:19px 5px;font-size:12px;border:1px dashed #d9dbd4;border-radius:8px}.footer{display:flex;justify-content:space-between;color:var(--muted);font-size:11px;margin-top:18px}.modalback{position:fixed;inset:0;background:#17231c66;display:none;place-items:center;padding:18px;z-index:5}.modalback.open{display:grid}.modal{width:min(470px,100%);background:var(--paper);border-radius:13px;padding:23px;box-shadow:0 20px 70px #0003}.modal h2{font-size:19px;margin:0 0 20px}.field{margin-bottom:14px}.field label{display:block;font-size:12px;font-weight:650;margin-bottom:6px}.field input,.field textarea,.field select{width:100%;border:1px solid var(--line);border-radius:7px;padding:10px;outline:none;background:white}.field input:focus,.field textarea:focus,.field select:focus{border-color:#7f9f89;box-shadow:0 0 0 3px #28634b12}.field textarea{resize:vertical;min-height:75px}.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.modalactions{display:flex;justify-content:space-between;margin-top:20px}.modalactions .right{display:flex;gap:8px}.danger{color:#b54c3c;border-color:#f0d9d4}.close{border:0;background:none;font-size:22px;color:var(--muted);float:right;margin-top:-5px}.toast{position:fixed;bottom:22px;left:50%;transform:translate(-50%,20px);opacity:0;background:#25392c;color:white;padding:10px 15px;border-radius:8px;transition:.2s;pointer-events:none;font-size:13px}.toast.show{opacity:1;transform:translate(-50%,0)}@media(max-width:1000px){.board{grid-template-columns:repeat(2,minmax(220px,1fr))}.shell{padding:22px}}@media(max-width:560px){.shell{padding:15px}.top{padding-bottom:15px}.date,.hint{display:none}.heading{padding:25px 0 17px;align-items:flex-start;gap:10px;flex-direction:column}.heading h1{font-size:28px}.stats{gap:18px}.board{grid-template-columns:1fr}.column{min-height:120px}.toolbar .filter{max-width:130px}.footer{gap:10px;flex-wrap:wrap}}
