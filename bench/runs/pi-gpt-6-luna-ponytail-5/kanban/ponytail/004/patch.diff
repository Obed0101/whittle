+      <button class="nav-item" id="today-nav"><span class="nav-icon">◷</span> Due soon</button>
+      <button class="nav-item" id="completed-nav"><span class="nav-icon">✓</span> Completed</button>
+      <div class="sidebar-bottom"><div class="avatar">Y</div><div><strong>Your space</strong><small>Personal workspace</small></div><button class="icon-button tiny" id="data-menu" title="Data options" aria-label="Data options">···</button></div>
+    </aside>
+    <main class="main">
+      <header class="topbar"><div class="breadcrumb">Your space <span>/</span> <b>My board</b></div><div class="top-actions"><span class="saved-status"><i></i> Saved locally</span><button class="icon-button" id="help-btn" aria-label="About this board" title="About">?</button></div></header>
+      <section class="board-wrap">
+        <div class="board-heading"><div><div class="eyebrow">PERSONAL WORKSPACE <span>·</span> PRIVATE</div><h1>My board <button class="icon-button title-edit" id="rename-board" aria-label="Rename board" title="Rename board">✎</button></h1><p class="subtitle">A little progress, every day.</p></div><div class="heading-actions"><button class="button ghost" id="export-btn"><span>↥</span> Export</button><button class="button primary" id="add-task"><span class="plus">＋</span> Add task</button></div></div>
+        <div class="toolbar"><div class="view-tabs"><button class="tab active" data-view="board">Board</button><button class="tab" data-view="list">List</button></div><div class="toolbar-right"><label class="search"><span>⌕</span><input id="search" type="search" placeholder="Search tasks..." aria-label="Search tasks"><kbd>⌘ K</kbd></label><select id="sort" aria-label="Sort tasks"><option value="manual">Recently updated</option><option value="due">Due date</option><option value="priority">Priority</option><option value="created">Date created</option></select><button class="icon-button filter-btn" id="filter-btn" aria-label="Filter tasks" title="Filter by priority">☷<span class="filter-dot"></span></button></div></div>
+        <div class="board" id="board" aria-label="Kanban board"></div>
+        <div class="list-view hidden" id="list-view"></div>
+        <footer class="board-footer"><span>Everything saved on this device</span><button id="clear-search" class="text-button hidden">Clear search</button><span><kbd>⌘</kbd> <kbd>K</kbd> to search</span></footer>
+      </section>
+    </main>
+  </div>
+  <div class="toast" id="toast" role="status" aria-live="polite"></div>
