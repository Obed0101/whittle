+    const all=tasks.slice().sort((a,b)=>b.updated-a.updated);$('#list-view').innerHTML=all.length?'<div class="list-row list-header"><span></span><span>Task</span><span>Status</span><span>Priority</span><span>Due date</span><span></span></div>'+all.map(t=>`<div class="list-row"><input class="check-task" type="checkbox" data-check="${esc(t.id)}" ${t.status==='done'?'checked':''} aria-label="Complete ${esc(t.title)}"><span class="list-name" data-edit="${esc(t.id)}">${esc(t.title)}</span><select class="list-status" data-status="${esc(t.id)}">${columns.map(c=>`<option value="${c.id}" ${c.id===t.status?'selected':''}>${c.name}</option>`).join('')}</select><span>${t.priority!=='none'?`<span class="priority ${t.priority}"><i></i>${t.priority}</span>`:'—'}</span><span>${t.due?dueInfo(t.due).text:'—'}</span><button class="card-more" data-edit="${esc(t.id)}" aria-label="Edit task">···</button></div>`).join(''):'<div class="list-empty">No tasks match. Try a different search.</div>';
+  }
+  function card(t){const due=t.due?dueInfo(t.due):null;return `<article class="task-card ${t.status==='done'?'is-complete':''}" draggable="true" data-task="${esc(t.id)}"><div class="card-top"><input class="check-task" type="checkbox" data-check="${esc(t.id)}" ${t.status==='done'?'checked':''} aria-label="Complete ${esc(t.title)}"><span class="task-name" data-edit="${esc(t.id)}">${esc(t.title)}</span><button class="card-more" data-edit="${esc(t.id)}" aria-label="Edit task">···</button></div>${t.notes?`<p class="task-note">${esc(t.notes)}</p>`:''}<div class="card-meta">${t.label?`<span class="label-chip">${esc(t.label)}</span>`:''}${t.priority!=='none'?`<span class="priority ${t.priority}"><i></i>${t.priority[0].toUpperCase()+t.priority.slice(1)}</span>`:''}${due?`<span class="due ${due.class}">${due.text}</span>`:''}</div></article>`}
+  const dialog=$('#task-dialog');
+  function openTask(id='',status='todo'){const t=state.tasks.find(x=>x.id===id);$('#task-id').value=t?.id||'';$('#task-title').value=t?.title||'';$('#task-notes').value=t?.notes||'';$('#task-status').innerHTML=columns.map(c=>`<option value="${c.id}">${c.name}</option>`).join('');$('#task-status').value=t?.status||status;$('#task-priority').value=t?.priority||'none';$('#task-due').value=t?.due||'';$('#task-label').value=t?.label||'';$('#dialog-title').textContent=t?'Edit task':'Add a task';$('#dialog-eyebrow').textContent=t?'TASK DETAILS':'NEW TASK';$('#save-task').textContent=t?'Save changes':'Add task';$('#delete-task').classList.toggle('hidden',!t);dialog.showModal();setTimeout(()=>$('#task-title').focus(),50)}
+  $('#task-form').addEventListener('submit',e=>{e.preventDefault();let id=$('#task-id').value,t=state.tasks.find(x=>x.id===id),now=Date.now();const data={title:$('#task-title').value.trim(),notes:$('#task-notes').value.trim(),status:$('#task-status').value,priority:$('#task-priority').value,due:$('#task-due').value,label:$('#task-label').value.trim(),updated:now};if(!data.title)return;if(t)Object.assign(t,data);else state.tasks.push({id:uid(),...data,created:now});persist();dialog.close();render();notify(t?'Task updated':'Task added')});
+  document.addEventListener('click',e=>{const edit=e.target.closest('[data-edit]');if(edit){openTask(edit.dataset.edit);return}const add=e.target.closest('[data-add]');if(add){openTask('',add.dataset.add);return}const check=e.target.closest('[data-check]');if(check){const t=state.tasks.find(x=>x.id===check.dataset.check);if(t){t.status=check.checked?'done':'todo';t.updated=Date.now();persist();render();notify(check.checked?'Nice work — task completed':'Task moved to To do')}return}if(e.target.closest('.close-dialog')){e.target.closest('dialog').close()}});
+  $('#delete-task').onclick=()=>{const id=$('#task-id').value;state.tasks=state.tasks.filter(t=>t.id!==id);persist();dialog.close();render();notify('Task deleted')};
+  $('#board').addEventListener('dragstart',e=>{const card=e.target.closest('.task-card');if(card){e.dataTransfer.setData('text/plain',card.dataset.task);e.dataTransfer.effectAllowed='move';setTimeout(()=>card.classList.add('dragging'),0)}});$('#board').addEventListener('dragend',e=>e.target.closest('.task-card')?.classList.remove('dragging'));$('#board').addEventListener('dragover',e=>{const list=e.target.closest('.task-list');if(list){e.preventDefault();list.classList.add('drag-over')}});$('#board').addEventListener('dragleave',e=>{const list=e.target.closest('.task-list');if(list&&!list.contains(e.relatedTarget))list.classList.remove('drag-over')});$('#board').addEventListener('drop',e=>{const list=e.target.closest('.task-list');if(!list)return;e.preventDefault();list.classList.remove('drag-over');const t=state.tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=list.dataset.drop;t.updated=Date.now();persist();render()}});
+  $('#search').oninput=e=>{query=e.target.value.trim().toLowerCase();render()};$('#sort').onchange=e=>{sort=e.target.value;render()};$('#filter-btn').onclick=()=>{const choices=['','high','medium','low','none'],labels=['All priorities','High priority','Medium priority','Low priority','No priority'];let i=choices.indexOf(filter);filter=choices[(i+1)%choices.length];$('#filter-btn').title=labels[(i+1)%choices.length];render()};$$('.tab').forEach(b=>b.onclick=()=>{view=b.dataset.view;render()});
+  $('#today-nav').onclick=()=>{const on=!$('#today-nav').classList.contains('selected');$('#today-nav').classList.toggle('selected',on);$('#completed-nav').classList.remove('selected');render()};$('#completed-nav').onclick=()=>{const on=!$('#completed-nav').classList.contains('selected');$('#completed-nav').classList.toggle('selected',on);$('#today-nav').classList.remove('selected');render()};$('#clear-search').onclick=()=>{$('#search').value='';query='';filter='';$('#today-nav').classList.remove('selected');$('#completed-nav').classList.remove('selected');render()};
+  function download(){const blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='my-board-backup.json';a.click();URL.revokeObjectURL(a.href);notify('Backup downloaded')};$('#export-btn').onclick=download;$('#settings-export').onclick=download;$('#data-menu').onclick=()=>$('#data-dialog').showModal();$('#help-btn').onclick=()=>$('#info-dialog').showModal();$('#rename-board').onclick=()=>{const name=prompt('Name your board',state.boardName||'My board');if(name?.trim()){state.boardName=name.trim().slice(0,50);persist();render()}};
+  $('#import-file').onchange=async e=>{try{const imported=JSON.parse(await e.target.files[0].text());if(!Array.isArray(imported.tasks)||!imported.tasks.every(t=>t.id&&typeof t.title==='string'&&columns.some(c=>c.id===t.status)))throw Error();state={tasks:imported.tasks,boardName:typeof imported.boardName==='string'?imported.boardName:'My board'};persist();render();$('#data-dialog').close();notify('Backup restored')}catch{notify('That backup file could not be read')}e.target.value=''};
+  $('#reset-board').onclick=()=>{if(confirm('Replace this board with the original sample tasks? This cannot be undone.')){state={tasks:sample,boardName:'My board'};persist();render();$('#data-dialog').close();notify('Board reset')}};
+  $('#sort').onchange=$('#sort').onchange||null;document.addEventListener('change',e=>{const s=e.target.closest('[data-status]');if(s){const t=state.tasks.find(x=>x.id===s.dataset.status);if(t){t.status=s.value;t.updated=Date.now();persist();render()}}});document.addEventListener('keydown',e=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();$('#search').focus()}if(e.key==='Escape')$$('dialog[open]').forEach(d=>d.close())});
