+(() => {
+  const STORAGE='monday-personal-board-v1';
+  const columns=[{id:'todo',name:'To do',color:'#9ba39c'},{id:'doing',name:'In progress',color:'#d2a35e'},{id:'done',name:'Done',color:'#72a184'}];
+  const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
+  const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+  const uid=()=>Math.random().toString(36).slice(2,10);
+  const sample=[['Sketch out the week','Pick three things that would make this week feel good.','todo','low','Today',''],['Book a dentist appointment','','todo','medium','Personal',''],['Tidy up the reading list','Save the articles I actually want to read.','todo','none','',''],['Finish the project proposal','Get a first draft down. It doesn’t need to be perfect.','doing','high','Work',''],['Take a proper lunch break','','doing','low','',''],['Sort out the hallway shelf','','done','none','Home','']].map(([title,notes,status,priority,label,due],i)=>({id:uid(),title,notes,status,priority,label,due,created:Date.now()-i*86400000,updated:Date.now()-i*3600000}));
+  let state;try{const saved=JSON.parse(localStorage.getItem(STORAGE));state=saved&&Array.isArray(saved.tasks)&&saved.tasks.every(t=>t.id&&t.title&&columns.some(c=>c.id===t.status))?saved:{tasks:sample,boardName:'My board'};}catch{state={tasks:sample,boardName:'My board'};}
+  let view='board',filter='',query='',sort='manual',toastTimer;
+  const persist=()=>{localStorage.setItem(STORAGE,JSON.stringify(state));$('.saved-status').innerHTML='<i></i> Saved locally';};
+  function notify(msg){const el=$('#toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2300)}
+  function dueInfo(date){if(!date)return '';const d=new Date(date+'T00:00:00'),today=new Date();today.setHours(0,0,0,0);const delta=Math.round((d-today)/86400000);return {text:delta===0?'Today':delta===1?'Tomorrow':d.toLocaleDateString(undefined,{month:'short',day:'numeric'}),class:delta<0?'overdue':delta<=2?'soon':''}}
+  function visibleTasks(){let list=state.tasks.filter(t=>t.status!=='done'||$('#completed-nav').classList.contains('selected'));if($('#today-nav').classList.contains('selected'))list=list.filter(t=>t.due&&t.due<=new Date(Date.now()+86400000).toISOString().slice(0,10)&&t.status!=='done');if(filter)list=list.filter(t=>t.priority===filter);if(query)list=list.filter(t=>(t.title+' '+t.notes+' '+t.label).toLowerCase().includes(query));return list}
+  function render(){document.title=`${state.boardName||'My board'} — Monday`;document.querySelector('h1').childNodes[0].textContent=(state.boardName||'My board')+' ';const tasks=visibleTasks();$('#total-count').textContent=state.tasks.filter(t=>t.status!=='done').length;$('#filter-btn').classList.toggle('filtered',!!filter);$('#clear-search').classList.toggle('hidden',!query&&!filter&&!$('#today-nav').classList.contains('selected')&&!$('#completed-nav').classList.contains('selected'));
+    $('#board').classList.toggle('hidden',view!=='board');$('#list-view').classList.toggle('hidden',view!=='list');$$('.tab').forEach(b=>b.classList.toggle('active',b.dataset.view===view));
