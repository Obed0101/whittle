+<style>
+:root{--ink:#22251f;--muted:#777b70;--line:#e7e8e1;--paper:#f6f6f2;--white:#fff;--green:#52745b;--green-pale:#e7eee5;--shadow:0 8px 24px #22251f0d}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:14px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,textarea,select{font:inherit}button{cursor:pointer}.app{max-width:1440px;margin:auto;padding:0 44px}.topbar{height:76px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:11px;font-weight:700;letter-spacing:-.4px;font-size:17px}.mark{height:28px;width:28px;border-radius:9px;background:var(--green);color:#fff;display:grid;place-items:center;font-size:17px}.top-actions,.tools{display:flex;align-items:center;gap:10px}.avatar{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:#e8d9c7;color:#6b503b;font-size:12px;font-weight:700}.icon-btn,.quiet{border:0;background:transparent;color:var(--muted);padding:8px;border-radius:8px}.icon-btn:hover,.quiet:hover{background:#ecece6;color:var(--ink)}.hero{display:flex;justify-content:space-between;align-items:flex-end;padding:39px 0 26px}.eyebrow{color:var(--green);font-size:11px;text-transform:uppercase;letter-spacing:1.2px;font-weight:700}.hero h1{font:500 34px/1.15 Georgia,serif;letter-spacing:-.7px;margin:8px 0 7px}.sub{margin:0;color:var(--muted)}.primary{border:0;background:var(--green);color:white;padding:11px 16px;border-radius:8px;font-weight:600;box-shadow:0 2px 3px #263e2a20}.primary:hover{background:#426349}.primary span{font-size:17px;margin-right:5px}.tools{border-top:1px solid var(--line);padding:16px 0 19px;justify-content:space-between}.filters{display:flex;gap:5px}.filter{border:0;background:transparent;color:var(--muted);padding:7px 12px;border-radius:7px;font-size:13px}.filter.active{background:var(--white);color:var(--ink);box-shadow:0 1px 4px #22251f13}.search{position:relative}.search input{width:200px;border:1px solid var(--line);background:transparent;border-radius:8px;padding:8px 11px 8px 32px;outline:none}.search input:focus{border-color:#a1b19e}.search:before{content:'⌕';position:absolute;left:11px;top:5px;font-size:19px;color:var(--muted)}.board{display:grid;grid-template-columns:repeat(3,minmax(260px,1fr));gap:18px;padding-bottom:50px}.column{min-width:0}.col-head{display:flex;justify-content:space-between;align-items:center;padding:4px 2px 12px}.col-title{display:flex;align-items:center;gap:9px;font-weight:650}.dot{width:8px;height:8px;border-radius:50%;background:#92958b}.column:nth-child(2) .dot{background:#d39b46}.column:nth-child(3) .dot{background:#6a9a77}.count{color:#999;font-size:12px;font-weight:400}.add-card{border:1px dashed #d8dad2;background:transparent;width:100%;padding:10px;color:#85897f;text-align:left;border-radius:9px;margin-bottom:9px}.add-card:hover{background:white;border-color:#b9c5b7;color:var(--green)}.stack{min-height:145px;border-radius:10px;transition:background .15s}.stack.dragover{background:#e9eee6}.card{background:var(--white);border:1px solid #eaebe5;border-radius:9px;padding:14px 14px 12px;margin-bottom:9px;box-shadow:0 2px 7px #22251f08;cursor:grab}.card:active{cursor:grabbing}.card.dragging{opacity:.4}.card-top{display:flex;justify-content:space-between;align-items:start}.tag{font-size:10px;letter-spacing:.35px;text-transform:uppercase;font-weight:700;color:#777;background:#f0f0eb;border-radius:4px;padding:3px 6px}.tag.work{color:#56775d;background:#eaf0e8}.tag.personal{color:#8c6c47;background:#f5eee4}.tag.learning{color:#6c719a;background:#eeeff7}.card-menu{border:0;background:transparent;color:#a1a398;padding:0 3px;font-size:17px;line-height:1}.card h3{font-size:14px;line-height:1.4;margin:10px 0 5px;font-weight:650}.description{font-size:12px;color:var(--muted);margin:0 0 12px;white-space:pre-wrap}.card-foot{display:flex;justify-content:space-between;align-items:center;color:#96998f;font-size:11px}.due{display:flex;align-items:center;gap:5px}.due.overdue{color:#bb594c}.due.soon{color:#b18439}.priority{letter-spacing:1px;color:#d29a46}.empty{color:#a2a59b;font-size:12px;text-align:center;padding:23px 10px;border:1px dashed #e0e1db;border-radius:9px}.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:#242922;color:white;padding:10px 16px;border-radius:8px;opacity:0;pointer-events:none;transition:opacity .2s}.toast.show{opacity:1}.modal-backdrop{position:fixed;inset:0;background:#1d211d70;display:none;align-items:center;justify-content:center;padding:20px;z-index:3}.modal-backdrop.open{display:flex}.modal{width:min(480px,100%);background:white;border-radius:14px;padding:25px;box-shadow:0 20px 70px #0003}.modal h2{font:500 25px Georgia,serif;margin:0 0 20px}.field{display:block;margin:0 0 15px}.field span{display:block;font-size:12px;font-weight:650;margin-bottom:6px}.field input,.field textarea,.field select{width:100%;border:1px solid var(--line);border-radius:7px;padding:10px 11px;outline:none;background:#fff}.field input:focus,.field textarea:focus,.field select:focus{border-color:#8ca28a}.field textarea{resize:vertical;min-height:72px}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.modal-actions{display:flex;justify-content:space-between;align-items:center;margin-top:21px}.delete{border:0;background:transparent;color:#b4574c;padding:8px}.save-actions{display:flex;gap:8px}.secondary{border:1px solid var(--line);background:white;padding:9px 13px;border-radius:7px}.small{font-size:12px;color:var(--muted)}@media(max-width:800px){.app{padding:0 20px}.board{grid-template-columns:repeat(3,290px);overflow-x:auto;margin-right:-20px;padding-right:20px}.hero{padding-top:29px}}@media(max-width:480px){.app{padding:0 15px}.hero{align-items:flex-start;gap:16px;flex-direction:column}.hero h1{font-size:30px}.tools{align-items:flex-start;gap:12px;flex-direction:column}.search input{width:min(340px,calc(100vw - 30px))}.board{margin-right:-15px;padding-right:15px}.topbar{height:64px}}
+</style></head>
+<body><div class="app"><header class="topbar"><div class="brand"><span class="mark">↗</span> daymark</div><div class="top-actions"><button class="icon-btn" id="export" title="Export board">⇩</button><button class="icon-btn" id="import" title="Import board">⇧</button><div class="avatar" title="Your personal board">JD</div><input type="file" id="importFile" accept="application/json" hidden></div></header>
+<section class="hero"><div><div class="eyebrow">A little progress, every day</div><h1>Your board</h1><p class="sub" id="dateLine"></p></div><button class="primary" id="newTask"><span>＋</span> Add a task</button></section>
+<div class="tools"><div class="filters" role="group" aria-label="Filter tasks"><button class="filter active" data-filter="all">Everything</button><button class="filter" data-filter="work">Work</button><button class="filter" data-filter="personal">Personal</button><button class="filter" data-filter="learning">Learning</button></div><label class="search"><input id="search" type="search" placeholder="Find a task…" aria-label="Find a task"></label></div>
+<main class="board" id="board"></main><div class="small" style="padding:0 0 24px">Your board is saved on this device. Drag cards to move them.</div></div><div class="toast" id="toast"></div>
+<div class="modal-backdrop" id="backdrop"><form class="modal" id="taskForm"><h2 id="modalTitle">Add a task</h2><label class="field"><span>Task</span><input name="title" required maxlength="100" placeholder="What needs doing?"></label><label class="field"><span>Notes <span class="small">(optional)</span></span><textarea name="description" maxlength="500" placeholder="A little context…"></textarea></label><div class="form-row"><label class="field"><span>Column</span><select name="status"><option value="todo">To do</option><option value="doing">In progress</option><option value="done">Done</option></select></label><label class="field"><span>Category</span><select name="category"><option value="work">Work</option><option value="personal">Personal</option><option value="learning">Learning</option></select></label></div><div class="form-row"><label class="field"><span>Due date</span><input name="due" type="date"></label><label class="field"><span>Priority</span><select name="priority"><option value="normal">Normal</option><option value="high">High</option></select></label></div><div class="modal-actions"><button type="button" class="delete" id="deleteTask" hidden>Delete task</button><div class="save-actions"><button type="button" class="secondary" id="cancel">Cancel</button><button class="primary" type="submit">Save task</button></div></div></form></div>
+<script>
+(()=>{const KEY='daymark-board-v1',columns=[['todo','To do'],['doing','In progress'],['done','Done']];let tasks=load(),filter='all',query='',editing=null;const board=document.querySelector('#board'),form=document.querySelector('#taskForm'),backdrop=document.querySelector('#backdrop'),toastEl=document.querySelector('#toast');document.querySelector('#dateLine').textContent=new Intl.DateTimeFormat(undefined,{weekday:'long',month:'long',day:'numeric'}).format(new Date());
+function load(){try{const x=JSON.parse(localStorage.getItem(KEY));return Array.isArray(x)?x.filter(t=>t&&typeof t.id==='string'&&typeof t.title==='string'&&columns.some(c=>c[0]===t.status)):[]}catch{return []}}function persist(){localStorage.setItem(KEY,JSON.stringify(tasks))}function esc(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function render(){board.innerHTML=columns.map(([status,label])=>{const list=tasks.filter(t=>t.status===status&&(filter==='all'||t.category===filter)&&(!query||`${t.title} ${t.description}`.toLowerCase().includes(query)));return `<section class="column" data-column="${status}"><div class="col-head"><div class="col-title"><i class="dot"></i>${label}<span class="count">${tasks.filter(t=>t.status===status).length}</span></div><button class="icon-btn quick-add" data-status="${status}" aria-label="Add to ${label}">＋</button></div><button class="add-card quick-add" data-status="${status}">＋ Add a task</button><div class="stack" data-drop="${status}">${list.length?list.map(card).join(''):'<div class="empty">Nothing here for now</div>'}</div></section>`}).join('');board.querySelectorAll('.quick-add').forEach(b=>b.onclick=()=>open(null,b.dataset.status));board.querySelectorAll('.card').forEach(c=>{c.onclick=e=>{if(!e.target.closest('.card-menu'))open(c.dataset.id)};c.ondragstart=e=>{e.dataTransfer.setData('text/plain',c.dataset.id);c.classList.add('dragging')};c.ondragend=()=>c.classList.remove('dragging')});board.querySelectorAll('.stack').forEach(s=>{s.ondragover=e=>{e.preventDefault();s.classList.add('dragover')};s.ondragleave=()=>s.classList.remove('dragover');s.ondrop=e=>{e.preventDefault();s.classList.remove('dragover');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=s.dataset.drop;persist();render()}}})}
+function card(t){const due=t.due?new Date(t.due+'T00:00:00'):null,today=new Date();today.setHours(0,0,0,0);const dueClass=due&&due<today&&t.status!=='done'?'overdue':due&&Math.ceil((due-today)/864e5)<=2&&t.status!=='done'?'soon':'';return `<article class="card" draggable="true" data-id="${esc(t.id)}"><div class="card-top"><span class="tag ${esc(t.category)}">${esc(t.category||'work')}</span><button class="card-menu" aria-label="Edit ${esc(t.title)}">···</button></div><h3>${esc(t.title)}</h3>${t.description?`<p class="description">${esc(t.description)}</p>`:''}<div class="card-foot"><span class="due ${dueClass}">${due?`◷ ${due.toLocaleDateString(undefined,{month:'short',day:'numeric'})}`:' '}</span>${t.priority==='high'?'<span class="priority" title="High priority">▲</span>':''}</div></article>`}
+function open(id,status='todo'){editing=id;const t=tasks.find(x=>x.id===id);form.reset();form.elements.title.value=t?.title||'';form.elements.description.value=t?.description||'';form.elements.status.value=t?.status||status;form.elements.category.value=t?.category||'work';form.elements.due.value=t?.due||'';form.elements.priority.value=t?.priority||'normal';document.querySelector('#modalTitle').textContent=t?'Edit task':'Add a task';document.querySelector('#deleteTask').hidden=!t;backdrop.classList.add('open');form.elements.title.focus()}function close(){backdrop.classList.remove('open')}form.onsubmit=e=>{e.preventDefault();const d=new FormData(form),item={id:editing||crypto.randomUUID(),title:d.get('title').trim(),description:d.get('description').trim(),status:d.get('status'),category:d.get('category'),due:d.get('due'),priority:d.get('priority')};if(editing)tasks[tasks.findIndex(t=>t.id===editing)]=item;else tasks.unshift(item);persist();render();close()};document.querySelector('#newTask').onclick=()=>open();document.querySelector('#cancel').onclick=close;backdrop.onclick=e=>{if(e.target===backdrop)close()};document.onkeydown=e=>{if(e.key==='Escape')close()};document.querySelector('#deleteTask').onclick=()=>{if(editing&&confirm('Delete this task?')){tasks=tasks.filter(t=>t.id!==editing);persist();render();close()}};document.querySelectorAll('.filter').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelectorAll('.filter').forEach(x=>x.classList.toggle('active',x===b));render()});document.querySelector('#search').oninput=e=>{query=e.target.value.toLowerCase();render()};document.querySelector('#export').onclick=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(tasks,null,2)],{type:'application/json'}));a.download='daymark-board.json';a.click();URL.revokeObjectURL(a.href)};document.querySelector('#import').onclick=()=>document.querySelector('#importFile').click();document.querySelector('#importFile').onchange=async e=>{try{const data=JSON.parse(await e.target.files[0].text());if(!Array.isArray(data)||data.some(t=>!t||typeof t.title!=='string'||!columns.some(c=>c[0]===t.status)))throw Error();if(confirm('Replace your current board with this import?')){tasks=data.map(t=>({...t,id:crypto.randomUUID()}));persist();render();toast('Board imported')}}catch{alert('That file is not a valid Daymark board.')}e.target.value=''};function toast(msg){toastEl.textContent=msg;toastEl.classList.add('show');setTimeout(()=>toastEl.classList.remove('show'),2200)}render()})();
+</script></body></html>
