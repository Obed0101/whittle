--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,27 @@
+(() => {
+  const KEY='daymark-board-v1', statuses=[['todo','To do'],['progress','In progress'],['done','Done']];
+  const starter=[
+    {id:'a1',title:'Plan a slower, more intentional week',notes:'Choose the three things that would make this week feel like a win.',status:'todo',priority:'high',due:'',tag:'Mindful living',created:Date.now()-50000},
+    {id:'a2',title:'Book a dentist appointment',notes:'Find a slot that works before the end of the month.',status:'todo',priority:'medium',due:'',tag:'Life admin',created:Date.now()-40000},
+    {id:'a3',title:'Read 20 pages before bed',notes:'Put the phone away and pick up the book.',status:'todo',priority:'low',due:'',tag:'Daily ritual',created:Date.now()-30000},
+    {id:'a4',title:'Refresh my personal budget',notes:'Review subscriptions and set a savings target for next month.',status:'progress',priority:'medium',due:'',tag:'Money',created:Date.now()-20000},
+    {id:'a5',title:'Get outside for a long walk',notes:'A change of scenery does wonders.',status:'done',priority:'low',due:'',tag:'Wellbeing',created:Date.now()-10000}
+  ];
+  let tasks; try { const saved=JSON.parse(localStorage.getItem(KEY)); tasks=Array.isArray(saved)?saved.filter(validTask):starter; } catch { tasks=starter; }
+  const $=s=>document.querySelector(s), board=$('#board'), dialog=$('#taskDialog'), form=$('#taskForm');
+  function validTask(t){return t&&typeof t.id==='string'&&typeof t.title==='string'&&statuses.some(s=>s[0]===t.status)&&['low','medium','high'].includes(t.priority)}
+  function persist(){localStorage.setItem(KEY,JSON.stringify(tasks));$('#saveState').innerHTML='<i></i> Saved locally'}
+  function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+  function dateLabel(raw){if(!raw)return '';const d=new Date(raw+'T00:00:00'),today=new Date();today.setHours(0,0,0,0);const diff=Math.round((d-today)/86400000);return {text:diff<0?`Overdue · ${d.toLocaleDateString('en',{month:'short',day:'numeric'})}`:diff===0?'Due today':diff===1?'Due tomorrow':`Due ${d.toLocaleDateString('en',{month:'short',day:'numeric'})}`,cls:diff<0?'overdue':diff===0?'today':''}}
+  function render(){const q=$('#search').value.trim().toLowerCase(),priority=$('#priorityFilter').value;board.innerHTML='';statuses.forEach(([status,name])=>{const list=tasks.filter(t=>t.status===status&&(!q||`${t.title} ${t.notes||''} ${t.tag||''}`.toLowerCase().includes(q))&&(priority==='all'||t.priority===priority));const col=document.createElement('section');col.className='column';col.dataset.status=status;col.innerHTML=`<div class="column-head"><div class="column-title"><i class="col-symbol"></i>${name}<span class="count">${list.length}</span></div><div class="column-actions"><button class="quick-add" aria-label="Add task to ${name}" title="Add task">＋</button></div></div><div class="column-body" data-status="${status}">${list.length?list.map(card).join(''):`<div class="empty">${q||priority!=='all'?'No matching tasks':'Nothing here just yet'}</div>`}</div><button class="add-in-column" data-add="${status}">＋ &nbsp;Add a task</button>`;board.append(col)});$('#taskTotal').textContent=`${tasks.length} ${tasks.length===1?'task':'tasks'}`;$('#dayCount').textContent=`${tasks.filter(t=>t.status==='done').length} completed so far`;
+    board.querySelectorAll('.task-card').forEach(el=>{el.addEventListener('click',e=>{if(!e.target.closest('.task-menu'))openTask(el.dataset.id)});el.addEventListener('dragstart',e=>{e.dataTransfer.setData('text/plain',el.dataset.id);e.dataTransfer.effectAllowed='move';el.classList.add('dragging')});el.addEventListener('dragend',()=>el.classList.remove('dragging'))});board.querySelectorAll('.column').forEach(col=>{col.addEventListener('dragover',e=>{e.preventDefault();col.classList.add('drag-over')});col.addEventListener('dragleave',e=>{if(!col.contains(e.relatedTarget))col.classList.remove('drag-over')});col.addEventListener('drop',e=>{e.preventDefault();col.classList.remove('drag-over');const task=tasks.find(t=>t.id===e.dataTransfer.getData('text/plain'));if(task&&task.status!==col.dataset.status){task.status=col.dataset.status;persist();render()}})});board.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>openTask(null,b.dataset.add));board.querySelectorAll('.quick-add').forEach(b=>b.onclick=()=>openTask(null,b.closest('.column').dataset.status));board.querySelectorAll('.task-menu').forEach(b=>b.onclick=e=>{e.stopPropagation();openTask(b.closest('.task-card').dataset.id)})}
+  function card(t){const due=dateLabel(t.due);return `<article class="task-card" draggable="true" data-id="${esc(t.id)}" tabindex="0" aria-label="Edit ${esc(t.title)}"><div class="task-top"><span class="priority ${t.priority}">${t.priority} priority</span><button class="task-menu" aria-label="Edit task">···</button></div><h3 class="task-title">${esc(t.title)}</h3>${t.notes?`<p class="task-notes">${esc(t.notes)}</p>`:''}<div class="task-meta">${t.tag?`<span class="tag">${esc(t.tag)}</span>`:'<span></span>'}${due?`<span class="due ${due.cls}">${due.text}</span>`:''}</div></article>`}
+  function openTask(id,status='todo'){const t=tasks.find(x=>x.id===id);$('#taskId').value=t?.id||'';$('#taskTitle').value=t?.title||'';$('#taskNotes').value=t?.notes||'';$('#taskPriority').value=t?.priority||'medium';$('#taskDue').value=t?.due||'';$('#taskTag').value=t?.tag||'';$('#dialogTitle').textContent=t?'Edit task':'A new task';$('#deleteTask').style.visibility=t?'visible':'hidden';$('#taskColumn').innerHTML=statuses.map(([v,n])=>`<option value="${v}">${n}</option>`).join('');$('#taskColumn').value=t?.status||status;dialog.showModal();$('#taskTitle').focus()}
+  form.onsubmit=e=>{e.preventDefault();const id=$('#taskId').value,title=$('#taskTitle').value.trim();if(!title)return;const data={id:id||crypto.randomUUID(),title,notes:$('#taskNotes').value.trim(),priority:$('#taskPriority').value,due:$('#taskDue').value,tag:$('#taskTag').value.trim(),status:$('#taskColumn').value,created:tasks.find(t=>t.id===id)?.created||Date.now()};if(id)tasks=tasks.map(t=>t.id===id?data:t);else tasks.push(data);persist();render();dialog.close();toast(id?'Task updated':'Task added')};
+  function toast(text){const t=$('#toast');t.textContent=text;t.classList.add('show');clearTimeout(toast.timer);toast.timer=setTimeout(()=>t.classList.remove('show'),2200)}
+  $('#addTask').onclick=()=>openTask();$('#closeDialog').onclick=$('#cancelDialog').onclick=()=>dialog.close();$('#deleteTask').onclick=()=>{const id=$('#taskId').value;if(id&&confirm('Delete this task? This can’t be undone.')){tasks=tasks.filter(t=>t.id!==id);persist();render();dialog.close();toast('Task deleted')}};$('#search').oninput=render;$('#priorityFilter').onchange=render;
+  $('#exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify({version:1,tasks},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`daymark-board-${new Date().toISOString().slice(0,10)}.json`;a.click();URL.revokeObjectURL(a.href)};
+  $('#importBtn').onclick=()=>$('#importFile').click();$('#importFile').onchange=async e=>{try{const data=JSON.parse(await e.target.files[0].text()),list=Array.isArray(data)?data:data.tasks;if(!Array.isArray(list)||!list.every(validTask))throw Error();if(confirm(`Replace your board with ${list.length} imported tasks?`)){tasks=list;persist();render();toast('Board imported')}}catch{toast('Could not import: invalid board file')}e.target.value=''};
+  document.addEventListener('keydown',e=>{if(dialog.open)return;if(e.key==='/'&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();$('#search').focus()}if(e.key.toLowerCase()==='n'&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName))openTask()});
+  $('#todayDate').textContent=new Intl.DateTimeFormat('en',{weekday:'short',month:'short',day:'numeric'}).format(new Date());persist();render();
+})();
diff --git a/board/index.html b/board/index.html
new file mode 100644
index 0000000..078440f
--- /dev/null
+++ b/board/index.html
@@ -0,0 +1,23 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="theme-color" content="#f6f7f9"><title>Daymark — Personal Kanban</title>
+  <link rel="stylesheet" href="style.css">
+</head>
+<body>
+  <header class="topbar">
+    <a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d</span><span>daymark</span></a>
+    <div class="top-actions"><span class="save-state" id="saveState"><i></i> Saved locally</span><button class="icon-btn" id="exportBtn" title="Export board" aria-label="Export board">↓</button><button class="icon-btn" id="importBtn" title="Import board" aria-label="Import board">↑</button><input id="importFile" type="file" accept="application/json" hidden><button class="avatar" aria-label="Personal board">M</button></div>
+  </header>
+  <main class="page">
+    <section class="welcome"><div><div class="eyebrow"><span class="sun">✳</span> YOUR PERSONAL WORKSPACE</div><h1>Make room for <em>what matters.</em></h1><p class="subheading">A little progress, every day.</p></div><div class="date-card"><span class="date-icon">◷</span><div><strong id="todayDate"></strong><small id="dayCount"></small></div></div></section>
+    <section class="toolbar"><div class="board-label"><span class="board-dot"></span><strong>My board</strong><span class="divider"></span><span id="taskTotal">0 tasks</span></div><div class="tools"><label class="search"><span>⌕</span><input id="search" type="search" placeholder="Search tasks…" aria-label="Search tasks"><kbd>/</kbd></label><select id="priorityFilter" aria-label="Filter by priority"><option value="all">All priorities</option><option value="high">High priority</option><option value="medium">Medium priority</option><option value="low">Low priority</option></select><button class="primary-btn" id="addTask"><span>＋</span> Add task</button></div></section>
+    <section class="board" id="board" aria-label="Kanban board"></section>
+    <footer><span>Small steps add up.</span><span><span class="keyboard-hint"><kbd>/</kbd> search</span><span class="keyboard-hint"><kbd>N</kbd> new task</span></span></footer>
+  </main>
+  <dialog id="taskDialog"><form id="taskForm"><div class="modal-head"><div><span class="eyebrow">TASK DETAILS</span><h2 id="dialogTitle">A new task</h2></div><button type="button" class="icon-btn close" id="closeDialog" aria-label="Close">×</button></div><input type="hidden" id="taskId"><label class="field-label" for="taskTitle">Task name <span>*</span></label><input class="text-input" id="taskTitle" maxlength="120" required placeholder="What needs doing?"><label class="field-label" for="taskNotes">Notes <small>OPTIONAL</small></label><textarea class="text-input" id="taskNotes" rows="3" maxlength="1000" placeholder="Add a little context…"></textarea><div class="form-row"><div><label class="field-label" for="taskPriority">Priority</label><select class="text-input" id="taskPriority"><option value="low">Low</option><option value="medium" selected>Medium</option><option value="high">High</option></select></div><div><label class="field-label" for="taskDue">Due date <small>OPTIONAL</small></label><input class="text-input" id="taskDue" type="date"></div></div><div class="form-row"><div><label class="field-label" for="taskColumn">Column</label><select class="text-input" id="taskColumn"></select></div><div><label class="field-label" for="taskTag">Tag <small>OPTIONAL</small></label><input class="text-input" id="taskTag" maxlength="24" placeholder="e.g. Personal"></div></div><div class="modal-foot"><button type="button" class="delete-btn" id="deleteTask">Delete task</button><div><button type="button" class="secondary-btn" id="cancelDialog">Cancel</button><button class="primary-btn" type="submit">Save task</button></div></div></form></dialog>
+  <div class="toast" id="toast" role="status" aria-live="polite"></div>
+  <script src="app.js"></script>
+</body>
+</html>
