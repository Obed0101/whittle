diff --git a/board/app.js b/board/app.js
new file mode 100644
index 0000000..5c6a00f
--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,18 @@
+(() => {
+  const KEY='daymark-board-v1', statuses=[['todo','To do'],['doing','In progress'],['later','Up next'],['done','Done']];
+  const seed=[{id:crypto.randomUUID(),title:'Plan the week ahead',notes:'Pick three things that would make this week feel good.',priority:'medium',due:'',status:'todo',created:Date.now()},{id:crypto.randomUUID(),title:'Make time for a proper lunch',notes:'Step away from the desk, even if it is just for 20 minutes.',priority:'low',due:'',status:'doing',created:Date.now()}];
+  let tasks; try{const saved=JSON.parse(localStorage.getItem(KEY));tasks=Array.isArray(saved)?saved.filter(validTask):seed}catch{tasks=seed}
+  const board=document.querySelector('#board'),dialog=document.querySelector('#taskDialog'),form=document.querySelector('#taskForm'),search=document.querySelector('#searchInput'),filter=document.querySelector('#priorityFilter');let editing=null,toastTimer;
+  function validTask(t){return t&&typeof t.id==='string'&&typeof t.title==='string'&&statuses.some(s=>s[0]===t.status)&&['low','medium','high'].includes(t.priority)}
+  function save(){localStorage.setItem(KEY,JSON.stringify(tasks));document.querySelector('#storageNote').textContent='Saved on this device'}
+  function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+  function dateText(value){if(!value)return '';const d=new Date(value+'T00:00:00');return d.toLocaleDateString(undefined,{month:'short',day:'numeric'})}
+  function render(){const q=search.value.trim().toLowerCase(),p=filter.value;board.innerHTML='';for(const [status,label] of statuses){const items=tasks.filter(t=>t.status===status&&(!q||`${t.title} ${t.notes||''}`.toLowerCase().includes(q))&&(p==='all'||p===t.priority));const col=document.createElement('section');col.className='column';col.dataset.status=status;col.innerHTML=`<div class="column-head"><span class="column-dot"></span><h2>${label}</h2><span class="count">${items.length}</span><button class="column-add" aria-label="Add task to ${label}" title="Add task">＋</button></div><div class="cards">${items.length?items.map(cardHTML).join(''):`<div class="empty">Nothing here just yet.<br><button>Add a task</button></div>`}</div>`;col.querySelector('.column-add').onclick=()=>openNew(status);col.querySelector('.empty button').onclick=()=>openNew(status);col.addEventListener('dragover',e=>{e.preventDefault();col.classList.add('drag-over')});col.addEventListener('dragleave',()=>col.classList.remove('drag-over'));col.addEventListener('drop',e=>{e.preventDefault();col.classList.remove('drag-over');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=status;save();render()}});col.querySelectorAll('.task-card').forEach(el=>{el.onclick=()=>openEdit(el.dataset.id);el.ondragstart=e=>{e.dataTransfer.setData('text/plain',el.dataset.id);el.classList.add('dragging')};el.ondragend=()=>el.classList.remove('dragging')});board.append(col)}document.querySelector('#taskTotal').textContent=`${tasks.length} ${tasks.length===1?'task':'tasks'}`}
+  function cardHTML(t){const due=t.due?new Date(t.due+'T00:00:00'):null,today=new Date();today.setHours(0,0,0,0);const cls=!due?'':t.status==='done'?'done':due<today?'overdue':due.getTime()===today.getTime()?'soon':'';return `<article class="task-card" draggable="true" data-id="${esc(t.id)}" tabindex="0" aria-label="${esc(t.title)}, ${t.priority} priority"><div class="task-top"><span class="priority ${t.priority}">${t.priority}</span><button class="card-menu" title="Edit task" aria-label="Edit ${esc(t.title)}">···</button></div><div class="card-title">${esc(t.title)}</div>${t.notes?`<div class="card-notes">${esc(t.notes)}</div>`:''}<div class="card-footer"><span>${t.status==='done'?'Completed':'Personal'}</span>${t.due?`<span class="due ${cls}">◷ ${dateText(t.due)}</span>`:''}</div></article>`}
+  function openNew(status='todo'){editing=null;form.reset();form.elements.priority.value='medium';form.elements.status.value=status;document.querySelector('#dialogTitle').textContent='New task';document.querySelector('#deleteTask').hidden=true;dialog.showModal();form.elements.title.focus()}
+  function openEdit(id){const t=tasks.find(x=>x.id===id);if(!t)return;editing=id;form.elements.title.value=t.title;form.elements.notes.value=t.notes||'';form.elements.priority.value=t.priority;form.elements.due.value=t.due||'';form.elements.status.value=t.status;document.querySelector('#dialogTitle').textContent='Edit task';document.querySelector('#deleteTask').hidden=false;dialog.showModal();form.elements.title.focus()}
+  function notify(msg){const el=document.querySelector('#toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200)}
+  statuses.forEach(([id,label])=>form.elements.status.add(new Option(label,id)));document.querySelector('#todayLabel').textContent=new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'});document.querySelector('#newTask').onclick=()=>openNew();document.querySelector('#closeDialog').onclick=document.querySelector('#cancelDialog').onclick=()=>dialog.close();form.onsubmit=e=>{e.preventDefault();const data=new FormData(form),title=data.get('title').trim();if(!title)return;const item={id:editing||crypto.randomUUID(),title,notes:data.get('notes').trim(),priority:data.get('priority'),due:data.get('due'),status:data.get('status'),created:Date.now()};if(editing)tasks[tasks.findIndex(t=>t.id===editing)]=item;else tasks.unshift(item);save();render();dialog.close();notify(editing?'Task updated':'Task added')};document.querySelector('#deleteTask').onclick=()=>{if(editing&&confirm('Delete this task?')){tasks=tasks.filter(t=>t.id!==editing);save();render();dialog.close();notify('Task deleted')}};search.oninput=render;filter.onchange=render;document.querySelector('#clearDone').onclick=()=>{const n=tasks.filter(t=>t.status==='done').length;if(n&&confirm(`Delete ${n} completed ${n===1?'task':'tasks'}?`)){tasks=tasks.filter(t=>t.status!=='done');save();render();notify('Completed tasks cleared')}};
+  document.querySelector('#exportBtn').onclick=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify({version:1,tasks},null,2)],{type:'application/json'}));a.download=`daymark-${new Date().toISOString().slice(0,10)}.json`;a.click();URL.revokeObjectURL(a.href);notify('Board exported')};document.querySelector('#importBtn').onclick=()=>document.querySelector('#importFile').click();document.querySelector('#importFile').onchange=async e=>{const file=e.target.files[0];e.target.value='';if(!file)return;try{const data=JSON.parse(await file.text()),incoming=Array.isArray(data)?data:data.tasks;if(!Array.isArray(incoming)||!incoming.every(validTask))throw Error();if(confirm(`Replace your board with ${incoming.length} imported tasks? Export first if you want a backup.`)){tasks=incoming;save();render();notify('Board imported')}}catch{alert('That file is not a valid Daymark board export.')}};
+  render();
+})();
diff --git a/board/index.html b/board/index.html
new file mode 100644
index 0000000..14a4a70
--- /dev/null
+++ b/board/index.html
@@ -0,0 +1,25 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f6f5f1">
+<title>Daymark — Personal board</title>
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<div class="app">
+  <header class="topbar">
+    <a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d</span><span>daymark</span></a>
+    <div class="date-label" id="todayLabel"></div>
+    <div class="header-actions"><button class="icon-button" id="exportBtn" title="Export board" aria-label="Export board">↥</button><button class="icon-button" id="importBtn" title="Import board" aria-label="Import board">↧</button><input type="file" id="importFile" accept="application/json" hidden><button class="avatar" title="Your personal board">Y</button></div>
+  </header>
+  <main>
+    <section class="welcome"><div><div class="eyebrow"><span class="live-dot"></span> YOUR SPACE, YOUR PACE</div><h1>Make room for <em>what matters.</em></h1><p class="intro">A little progress, every day.</p></div><button class="primary-button" id="newTask"><span>＋</span> Add a task</button></section>
+    <section class="toolbar" aria-label="Board controls"><div class="view-title"><span class="grid-icon">▦</span><strong>My board</strong><span class="task-total" id="taskTotal">0 tasks</span></div><div class="controls"><label class="search"><span>⌕</span><input id="searchInput" type="search" placeholder="Search tasks…" aria-label="Search tasks"></label><select id="priorityFilter" aria-label="Filter by priority"><option value="all">All priorities</option><option value="high">High priority</option><option value="medium">Medium priority</option><option value="low">Low priority</option></select><button class="text-button" id="clearDone" title="Remove all completed tasks">Clear done</button></div></section>
+    <section class="board" id="board" aria-label="Kanban board"></section>
+    <footer><span>Small steps add up.</span><span id="storageNote">Saved on this device</span></footer>
+  </main>
+</div>
+<dialog id="taskDialog"><form id="taskForm" method="dialog"><div class="dialog-head"><div><div class="eyebrow">MAKE IT HAPPEN</div><h2 id="dialogTitle">New task</h2></div><button type="button" class="close-button" id="closeDialog" aria-label="Close">×</button></div><label class="field">Task name<input name="title" maxlength="120" placeholder="What needs doing?" required autofocus></label><label class="field">Notes <span class="optional">(optional)</span><textarea name="notes" rows="3" maxlength="1000" placeholder="Add a little context…"></textarea></label><div class="form-row"><label class="field">Priority<select name="priority"><option value="low">Low</option><option value="medium" selected>Medium</option><option value="high">High</option></select></label><label class="field">Due date<input name="due" type="date"></label></div><label class="field">Column<select name="status" id="statusSelect"></select></label><div class="dialog-actions"><button type="button" class="delete-button" id="deleteTask" hidden>Delete task</button><span class="spacer"></span><button type="button" class="secondary-button" id="cancelDialog">Cancel</button><button class="primary-button" type="submit">Save task</button></div></form></dialog>
+<div class="toast" id="toast" role="status" aria-live="polite"></div>
+<script src="app.js"></script>
+</body></html>
