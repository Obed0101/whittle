rd{background:#fff;border:1px solid #ebe9e3;border-radius:9px;padding:12px 12px 10px;box-shadow:0 2px 4px #282b2005;cursor:grab;transition:box-shadow .15s,transform .15s}.task-card:hover{box-shadow:var(--shadow);transform:translateY(-1px)}.task-card:active{cursor:grabbing}.task-card.dragging{opacity:.4}.task-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}.priority{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;display:flex;align-items:center;gap:5px}.priority:before{content:'';width:6px;height:6px;border-radius:50%;background:currentColor}.priority.high{color:#c66b56}.priority.medium{color:#c4974e}.priority.low{color:#709171}.card-menu{border:0;background:none;color:#aaa;cursor:pointer;font-size:18px;line-height:12px;padding:0 2px}.card-title{font-size:13px;font-weight:600;line-height:1.45;overflow-wrap:anywhere}.card-notes{font-size:11px;color:#898b83;line-height:1.5;margin-top:5px;white-space:pre-wrap;overflow-wrap:anywhere}.card-footer{display:flex;align-items:center;justify-content:space-between;margin-top:12px;padding-top:9px;border-top:1px solid #f0efeb;color:#96978f;font-size:10px}.due{display:flex;align-items:center;gap:4px}.due.overdue{color:#bd604e;font-weight:600}.due.soon{color:#ba8a43}.due.done{color:#7b8e7a}.empty{border:1px dashed #dddbd3;border-radius:8px;padding:20px 9px;text-align:center;color:#a1a199;font-size:11px;line-height:1.6}.empty button{border:0;background:none;color:var(--green);font:600 11px 'DM Sans';cursor:pointer}footer{height:60px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;color:#999a92;font-size:11px}dialog{border:0;border-radius:14px;padding:0;width:min(460px,calc(100% - 32px));box-shadow:0 20px 70px #17201530;color:var(--ink)}dialog::backdrop{background:#22291f66;backdrop-filter:blur(2px)}dialog form{padding:25px}.dialog-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:22px}.dialo