+@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
+:root{color-scheme:light;--ink:#20231f;--muted:#858980;--line:#e9eae5;--paper:#fff;--bg:#f7f7f4;--green:#3d765a;--green-dark:#315f49;--soft:#edf3ee;--shadow:0 16px 50px #20231f1a}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px 'DM Sans',sans-serif;-webkit-font-smoothing:antialiased}.topbar{height:66px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 max(calc((100vw - 1190px)/2),34px);background:#fff}.brand{text-decoration:none;color:var(--ink);font-weight:700;font-size:15px;letter-spacing:-.4px;display:flex;align-items:center;gap:9px}.brand-mark{display:grid;place-items:center;width:27px;height:27px;border-radius:8px;background:var(--green);color:white;font:800 17px Manrope}.top-actions{display:flex;align-items:center;gap:10px}.saved{font-size:11px;color:var(--muted);margin-right:7px}.icon-button,.avatar{border:0;background:transparent;color:#686e65;cursor:pointer;width:34px;height:34px;border-radius:8px;font-size:20px}.icon-button:hover,.avatar:hover{background:var(--bg)}.avatar{background:#e9eee8;color:var(--green);font-weight:700;font-size:13px}.workspace{max-width:1190px;margin:auto;padding:55px 34px 26px}.heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:37px}.eyebrow{font-size:10px;font-weight:700;letter-spacing:1.45px;color:#92968c}.heading h1{font:700 38px/1.1 Manrope,sans-serif;letter-spacing:-1.7px;margin:11px 0 7px}.period{color:var(--green)}.subtitle{margin:0;color:#868a81;font-size:14px}.primary,.secondary{font:600 13px 'DM Sans';border:0;border-radius:8px;padding:11px 16px;cursor:pointer}.primary{background:var(--green);color:white;box-shadow:0 2px 4px #315f4925}.primary:hover{background:var(--green-dark)}.heading .primary{padding:12px 17px}.heading .primary span{font-size:17px;vertical-align:-1px;margin-right:4px}.toolbar{height:48px;display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}.search-wrap{height:38px;width:260px;display:flex;align-items:center;gap:9px;padding:0 12px;border:1px solid var(--line);border-radius:7px;background:white;color:#9a9d94}.search-wrap span{font-size:20px;transform:rotate(-20deg)}.search-wrap input{border:0;outline:0;width:100%;font:13px 'DM Sans';color:var(--ink)}.search-wrap:focus-within{border-color:#a9c4ae}.toolbar-right{display:flex;align-items:center;gap:10px}.filter-label{font-size:12px;color:var(--muted)}select{font:12px 'DM Sans';border:1px solid var(--line);background:white;color:#565b53;border-radius:6px;padding:8px 28px 8px 10px;cursor:pointer}.text-button{border:0;background:none;font:500 12px 'DM Sans';color:#797e74;cursor:pointer;padding:8px}.text-button:hover{color:var(--green)}.board{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px;align-items:start}.column{min-height:310px;border:1px solid var(--line);border-radius:10px;background:#f1f2ee;padding:15px 13px 12px;transition:background .15s,border .15s}.column.drag-over{background:#e8f0e9;border-color:#a9c4ae}.column-head{display:flex;align-items:center;justify-content:space-between;padding:1px 3px 13px}.column-name{display:flex;align-items:center;gap:8px;font:700 12px Manrope;letter-spacing:.1px}.dot{width:8px;height:8px;border-radius:50%;background:#b5b7ae}.column[data-status="doing"] .dot{background:#d2a34c}.column[data-status="done"] .dot{background:#71937a}.count{font:500 11px 'DM Sans';color:#92968c;background:#e7e8e3;padding:3px 7px;border-radius:5px}.cards{display:flex;flex-direction:column;gap:9px;min-height:245px}.card{position:relative;background:#fff;border:1px solid #e9eae5;border-radius:8px;padding:13px 13px 11px;box-shadow:0 1px 2px #22220808;cursor:grab;transition:transform .15s,box-shadow .15s}.card:hover{box-shadow:0 4px 12px #20231f12;transform:translateY(-1px)}.card.dragging{opacity:.4}.card-title{font-size:13px;line-height:1.5;font-weight:600;overflow-wrap:anywhere;padding-right:15px}.card.done .card-title{text-decoration:line-through;color:#969990}.card-notes{font-size:11px;line-height:1.5;color:#8b8f86;margin-top:6px;white-space:pre-wrap;overflow-wrap:anywhere}.card-bottom{display:flex;justify-content:space-between;align-items:center;margin-top:12px;gap:5px}.tag-list{display:flex;gap:4px;flex-wrap:wrap}.tag{background:#f1f2ef;color:#777c73;border-radius:4px;padding:3px 6px;font-size:10px}.priority{font-size:10px;font-weight:600;display:flex;align-items:center;gap:4px}.priority:before{content:'';width:6px;height:6px;border-radius:50%;background:currentColor}.priority.high{color:#c06b55}.priority.medium{color:#bd9341}.priority.low{color:#68886c}.due{font-size:10px;color:#858980;white-space:nowrap}.due.overdue{color:#c16a56;font-weight:600}.due.soon{color:#b58a3e}.card-meta{display:flex;align-items:center;gap:9px;min-width:0}.card-empty{padding:23px 8px;text-align:center;color:#a1a49c;font-size:11px;border:1px dashed #dcded7;border-radius:7px;line-height:1.6}.add-inline{width:100%;text-align:left;border:0;background:transparent;color:#92968c;padding:10px 4px 4px;font:500 12px 'DM Sans';cursor:pointer}.add-inline:hover{color:var(--green)}footer{display:flex;justify-content:space-between;color:#a0a39b;font-size:11px;padding:20px 2px}kbd{font:11px monospace;border:1px solid #dedfd9;border-radius:3px;padding:1px 4px;color:#777}.dialog-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:23px}.dialog-head h2{font:700 23px Manrope;margin:6px 0 0;letter-spacing:-.6px}.close{font-size:24px}.field-label{display:block;font-size:12px;font-weight:600;margin:15px 0 7px}.field-label span{color:#c16a56}.field-label small{float:right;font-weight:400;color:#9a9d94}input,textarea{font:13px 'DM Sans';color:var(--ink)}#task-form>input,#task-form textarea,.field-row input,.field-row select{width:100%;border:1px solid var(--line);border-radius:6px;padding:10px 11px;outline:0;background:white}#task-form>input:focus,#task-form textarea:focus,.field-row input:focus,.field-row select:focus{border-color:#9bb99f}textarea{resize:vertical;line-height:1.5}.field-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field-row select{padding:10px}.dialog-actions{display:flex;align-items:center;gap:8px;margin-top:25px;border-top:1px solid var(--line);padding-top:16px}.dialog-actions>span{flex:1}.delete-button{color:#b65f4d;margin-right:auto}.secondary{background:#f1f2ee;color:#575c54}.secondary:hover{background:#e8e9e4}dialog{border:0;border-radius:12px;width:min(460px,calc(100vw - 30px));padding:25px;box-shadow:var(--shadow);color:var(--ink)}dialog::backdrop{background:#1e241f66;backdrop-filter:blur(2px)}.toast{position:fixed;bottom:22px;left:50%;transform:translate(-50%,15px);background:#242a25;color:#fff;padding:10px 16px;border-radius:7px;font-size:12px;opacity:0;pointer-events:none;transition:.2s}.toast.show{opacity:1;transform:translate(-50%,0)}
+@media(max-width:760px){.topbar{padding:0 18px}.workspace{padding:38px 18px 20px}.board{grid-template-columns:1fr;gap:11px}.column{min-height:120px}.cards{min-height:38px}.heading{margin-bottom:26px}.toolbar{margin-bottom:13px}.search-wrap{width:min(45vw,260px)}footer{padding-top:16px}}@media(max-width:440px){.saved{display:none}.heading h1{font-size:33px}.toolbar{height:auto;align-items:flex-start;gap:8px;flex-direction:column}.toolbar-right{width:100%;justify-content:flex-end}.search-wrap{width:100%}.heading .primary{padding:10px 12px}.workspace{padding-top:30px}}
