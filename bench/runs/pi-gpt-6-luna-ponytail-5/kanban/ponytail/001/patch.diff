diff --git a/board/app.js b/board/app.js
new file mode 100644
index 0000000..0fd91da
--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,27 @@
+(() => {
+  const KEY='daymark-board-v1', statuses=['todo','doing','done'], names={todo:'To do',doing:'In progress',done:'Done'};
+  const $=s=>document.querySelector(s), board=$('#board'), dialog=$('#task-dialog'), form=$('#task-form');
+  let tasks=[];
+  try { const stored=JSON.parse(localStorage.getItem(KEY)||'[]'); if(Array.isArray(stored)) tasks=stored.filter(t=>t&&typeof t.id==='string'&&typeof t.title==='string'&&statuses.includes(t.status)); } catch {}
+  let editing=null, query='', filter='all', toastTimer;
+  $('#today-label').textContent=`YOUR SPACE · ${new Intl.DateTimeFormat('en',{weekday:'long',month:'long',day:'numeric'}).format(new Date()).toUpperCase()}`;
+  function save(){try{localStorage.setItem(KEY,JSON.stringify(tasks));$('#save-status').textContent='Saved on this device';}catch{$('#save-status').textContent='Could not save';notify('Storage is full. Export a backup and remove some tasks.');}}
+  function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
+  function dueText(value){if(!value)return '';const d=new Date(value+'T00:00:00'),today=new Date();today.setHours(0,0,0,0);const days=Math.round((d-today)/86400000);return {text:days<0?`${Math.abs(days)}d overdue`:days===0?'Today':days===1?'Tomorrow':d.toLocaleDateString('en',{month:'short',day:'numeric'}),class:days<0?'overdue':days<2?'soon':''};}
+  function render(){board.innerHTML=statuses.map(status=>{const list=tasks.filter(t=>t.status===status&&matches(t));return `<section class="column" data-status="${status}"><div class="column-head"><div class="column-name"><i class="dot"></i>${names[status]}</div><span class="count">${tasks.filter(t=>t.status===status).length}</span></div><div class="cards" data-list="${status}">${list.length?list.map(card).join(''):`<div class="card-empty">${query||filter!=='all'?'No matching tasks':'Nothing here yet — add a task to get started.'}</div>`}</div><button class="add-inline" data-add="${status}">＋ Add a task</button></section>`;}).join('');}
+  function matches(t){return (!query||`${t.title} ${t.notes||''} ${(t.tags||[]).join(' ')}`.toLowerCase().includes(query))&&(filter==='all'||t.priority===filter);}
+  function card(t){const due=dueText(t.due),tags=(t.tags||[]).map(x=>`<span class="tag">${esc(x)}</span>`).join('');return `<article class="card ${t.status==='done'?'done':''}" draggable="true" data-id="${esc(t.id)}"><div class="card-title">${esc(t.title)}</div>${t.notes?`<div class="card-notes">${esc(t.notes)}</div>`:''}<div class="card-bottom"><div class="card-meta">${t.priority&&t.priority!=='none'?`<span class="priority ${t.priority}">${t.priority[0].toUpperCase()+t.priority.slice(1)}</span>`:''}${due.text?`<span class="due ${due.class}">${esc(due.text)}</span>`:''}</div><div class="tag-list">${tags}</div></div></article>`;}
+  function notify(text){const el=$('#toast');el.textContent=text;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2600);}
+  function openTask(task=null,status='todo'){editing=task?.id||null;form.reset();$('#dialog-title').textContent=task?'Edit task':'New task';$('#delete-task').style.visibility=task?'visible':'hidden';if(task){$('#task-title').value=task.title;$('#task-notes').value=task.notes||'';$('#task-priority').value=task.priority||'none';$('#task-due').value=task.due||'';$('#task-tags').value=(task.tags||[]).join(', ');}form.dataset.status=status;dialog.showModal();$('#task-title').focus();}
+  $('#add-task').onclick=()=>openTask();
+  board.addEventListener('click',e=>{const add=e.target.closest('[data-add]');if(add)openTask(null,add.dataset.add);const c=e.target.closest('.card');if(c)openTask(tasks.find(t=>t.id===c.dataset.id));});
+  $('.close').onclick=$('#cancel-task').onclick=()=>dialog.close();dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close();});
+  form.addEventListener('submit',e=>{e.preventDefault();const title=$('#task-title').value.trim();if(!title)return;const data={title,notes:$('#task-notes').value.trim(),priority:$('#task-priority').value,due:$('#task-due').value,tags:[...new Set($('#task-tags').value.split(',').map(x=>x.trim()).filter(Boolean))]};if(editing)Object.assign(tasks.find(t=>t.id===editing),data);else tasks.push({id:crypto.randomUUID?crypto.randomUUID():String(Date.now())+Math.random(),status:form.dataset.status||'todo',...data});save();render();dialog.close();});
+  $('#delete-task').onclick=()=>{if(editing&&confirm('Delete this task?')){tasks=tasks.filter(t=>t.id!==editing);save();render();dialog.close();}};
+  $('#search').addEventListener('input',e=>{query=e.target.value.trim().toLowerCase();render();});$('#priority-filter').onchange=e=>{filter=e.target.value;render();};
+  $('#clear-done').onclick=()=>{const count=tasks.filter(t=>t.status==='done').length;if(!count)return notify('No completed tasks to clear.');if(confirm(`Delete ${count} completed task${count===1?'':'s'}?`)){tasks=tasks.filter(t=>t.status!=='done');save();render();notify('Completed tasks cleared.');}};
+  let dragged=null;board.addEventListener('dragstart',e=>{const c=e.target.closest('.card');if(!c)return;dragged=c.dataset.id;c.classList.add('dragging');e.dataTransfer.effectAllowed='move';e.dataTransfer.setData('text/plain',dragged);});board.addEventListener('dragend',e=>{e.target.closest('.card')?.classList.remove('dragging');document.querySelectorAll('.drag-over').forEach(x=>x.classList.remove('drag-over'));});board.addEventListener('dragover',e=>{const col=e.target.closest('.column');if(col){e.preventDefault();col.classList.add('drag-over');}});board.addEventListener('dragleave',e=>{const col=e.target.closest('.column');if(col&&!col.contains(e.relatedTarget))col.classList.remove('drag-over');});board.addEventListener('drop',e=>{const col=e.target.closest('.column');if(!col)return;e.preventDefault();col.classList.remove('drag-over');const id=e.dataTransfer.getData('text/plain')||dragged,task=tasks.find(t=>t.id===id);if(task&&task.status!==col.dataset.status){task.status=col.dataset.status;save();render();}});
+  $('#export-btn').onclick=()=>{const blob=new Blob([JSON.stringify({version:1,tasks},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`daymark-backup-${new Date().toISOString().slice(0,10)}.json`;a.click();URL.revokeObjectURL(a.href);notify('Backup downloaded.');};
+  $('#import-btn').onclick=()=>$('#import-file').click();$('#import-file').onchange=async e=>{const file=e.target.files[0];if(!file)return;try{const data=JSON.parse(await file.text()),incoming=Array.isArray(data)?data:data.tasks;if(!Array.isArray(incoming)||incoming.some(t=>!t||typeof t.title!=='string'||!statuses.includes(t.status)))throw Error();if(!confirm(`Replace your board with ${incoming.length} imported tasks?`))return;tasks=incoming.map(t=>({id:crypto.randomUUID?crypto.randomUUID():String(Date.now())+Math.random(),status:t.status,title:t.title.slice(0,120),notes:String(t.notes||'').slice(0,1000),priority:['none','high','medium','low'].includes(t.priority)?t.priority:'none',due:/^\d{4}-\d{2}-\d{2}$/.test(t.due||'')?t.due:'',tags:Array.isArray(t.tags)?t.tags.filter(x=>typeof x==='string').map(x=>x.slice(0,40)).slice(0,20):[]}));save();render();notify('Board restored.');}catch{notify('That backup could not be read.');}finally{e.target.value='';}};
+  document.addEventListener('keydown',e=>{if((e.metaKey||e.ctrlKey)&&e.key==='Enter'&&!dialog.open)openTask();});render();
+})();
diff --git a/board/index.html b/board/index.html
new file mode 100644
index 0000000..d84ca79
--- /dev/null
+++ b/board/index.html
@@ -0,0 +1,32 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
+  <meta name="theme-color" content="#f7f7f4"><title>Daymark — Personal board</title>
+  <link rel="stylesheet" href="style.css">
+</head>
+<body>
+  <header class="topbar">
+    <a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d</span> daymark</a>
+    <div class="top-actions"><span class="saved" id="save-status">Saved on this device</span><button class="icon-button" id="export-btn" title="Export backup" aria-label="Export backup">↓</button><button class="icon-button" id="import-btn" title="Import backup" aria-label="Import backup">↑</button><input type="file" id="import-file" accept="application/json" hidden><button class="avatar" title="Personal workspace">Y</button></div>
+  </header>
+  <main class="workspace">
+    <section class="heading">
+      <div><div class="eyebrow" id="today-label">YOUR SPACE · TODAY</div><h1>My board<span class="period">.</span></h1><p class="subtitle">A little progress, every day.</p></div>
+      <button class="primary" id="add-task"><span>＋</span> New task</button>
+    </section>
+    <section class="toolbar" aria-label="Board tools"><div class="search-wrap"><span>⌕</span><input id="search" type="search" placeholder="Find a task…" aria-label="Find a task"></div><div class="toolbar-right"><label class="filter-label" for="priority-filter">Show</label><select id="priority-filter"><option value="all">Everything</option><option value="high">High priority</option><option value="medium">Medium priority</option><option value="low">Low priority</option></select><button class="text-button" id="clear-done">Clear completed</button></div></section>
+    <section class="board" id="board" aria-label="Kanban board"></section>
+    <footer><span>Move work forward, one card at a time.</span><span><kbd>＋</kbd> New task</span></footer>
+  </main>
+  <dialog id="task-dialog"><form id="task-form">
+    <div class="dialog-head"><div><div class="eyebrow">MAKE IT HAPPEN</div><h2 id="dialog-title">New task</h2></div><button type="button" class="icon-button close" aria-label="Close">×</button></div>
+    <label class="field-label" for="task-title">Task name <span>*</span></label><input id="task-title" name="title" maxlength="120" placeholder="What needs doing?" required>
+    <label class="field-label" for="task-notes">Notes</label><textarea id="task-notes" name="notes" rows="3" maxlength="1000" placeholder="Add a few details…"></textarea>
+    <div class="field-row"><div><label class="field-label" for="task-priority">Priority</label><select id="task-priority" name="priority"><option value="none">No priority</option><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select></div><div><label class="field-label" for="task-due">Due date</label><input id="task-due" name="due" type="date"></div></div>
+    <label class="field-label" for="task-tags">Tags <small>Separate with commas</small></label><input id="task-tags" name="tags" maxlength="120" placeholder="work, personal">
+    <div class="dialog-actions"><button type="button" class="text-button delete-button" id="delete-task">Delete task</button><span></span><button type="button" class="secondary" id="cancel-task">Cancel</button><button class="primary" type="submit">Save task</button></div>
+  </form></dialog>
+  <div class="toast" id="toast" role="status" aria-live="polite"></div>
+  <script src="app.js"></script>
+</body></html>
