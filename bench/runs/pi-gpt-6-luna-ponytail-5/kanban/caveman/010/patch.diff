--- /dev/null
+++ b/board/index.html
@@ -0,0 +1,38 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width,initial-scale=1">
+  <meta name="theme-color" content="#f6f7f5">
+  <title>Daymark — Personal Kanban</title>
+  <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+  <div class="app-shell">
+    <aside class="sidebar">
+      <a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d</span><span>daymark</span></a>
+      <div class="workspace-label">WORKSPACE</div>
+      <button class="workspace-switch"><span class="workspace-dot"></span> Personal space <span class="chevron">⌄</span></button>
+      <div class="nav-label">YOUR SPACE</div>
+      <button class="nav-item active"><span class="nav-icon">▦</span> My board <span class="nav-count" id="sidebar-count">0</span></button>
+      <button class="nav-item" id="focus-nav"><span class="nav-icon">◷</span> Focus today</button>
+      <div class="sidebar-bottom"><div class="sidebar-tip"><span class="tip-icon">✳</span><div><strong>A little progress adds up.</strong><p>Make space for what matters today.</p></div></div><button class="profile"><span class="avatar">Y</span><span class="profile-copy"><strong>Your board</strong><small>Personal workspace</small></span><span class="more">···</span></button></div>
+    </aside>
+    <main class="main">
+      <header class="topbar"><div class="breadcrumbs">Personal space <span>/</span> <strong>My board</strong></div><div class="top-actions"><button class="icon-button" id="help-button" aria-label="Keyboard shortcuts" title="Keyboard shortcuts">?</button><button class="avatar small-avatar" aria-label="Profile">Y</button></div></header>
+      <section class="content">
+        <div class="page-heading"><div><div class="eyebrow"><span class="live-dot"></span> YOUR PERSONAL WORKSPACE</div><h1>My board <button class="title-menu" aria-label="Board options">⌄</button></h1><p class="subtitle">A clear space for everything on your mind.</p></div><div class="heading-actions"><button class="button button-secondary" id="export-button"><span>↗</span> Export</button><button class="button button-primary" id="add-task"><span class="plus">＋</span> Add task <kbd>N</kbd></button></div></div>
+        <section class="summary-row" aria-label="Board summary"><div class="summary-card"><span class="summary-icon indigo">▦</span><div><span class="summary-label">IN PROGRESS</span><strong id="stat-progress">0</strong></div></div><div class="summary-card"><span class="summary-icon amber">◷</span><div><span class="summary-label">DUE SOON</span><strong id="stat-due">0</strong></div></div><div class="summary-card"><span class="summary-icon green">✓</span><div><span class="summary-label">COMPLETED THIS WEEK</span><strong id="stat-done">0</strong></div></div><div class="summary-note"><span>✦</span><div><strong>Small steps, big momentum.</strong><p>Keep your focus on one thing at a time.</p></div></div></section>
+        <div class="board-toolbar"><div class="view-tabs"><button class="view-tab selected" data-view="board">Board</button><button class="view-tab" data-view="list">List</button></div><div class="toolbar-right"><label class="search-box"><span>⌕</span><input id="search" type="search" placeholder="Search tasks..." aria-label="Search tasks"><kbd>/</kbd></label><select id="priority-filter" aria-label="Filter by priority"><option value="all">All priorities</option><option value="high">High priority</option><option value="medium">Medium priority</option><option value="low">Low priority</option></select><button class="button button-secondary sort-button" id="sort-button">↕ <span>Sort</span></button></div></div>
+        <div class="board" id="board" aria-label="Kanban board"></div>
+        <div class="list-view hidden" id="list-view"></div>
+        <footer class="board-footer"><span><span class="live-dot"></span> Changes saved automatically</span><button id="clear-completed">Clear completed</button><span class="footer-count" id="footer-count"></span></footer>
+      </section>
+    </main>
+  </div>
+  <dialog id="task-dialog" class="task-dialog"><form id="task-form"><div class="dialog-head"><div><span class="eyebrow">TASK DETAILS</span><h2 id="dialog-title">Add a task</h2></div><button type="button" class="close-button" data-close aria-label="Close">×</button></div><label class="field-label" for="task-title">Task name <span>*</span></label><input class="text-field" id="task-title" maxlength="120" placeholder="What needs to get done?" required><label class="field-label" for="task-description">Description <small>OPTIONAL</small></label><textarea class="text-field description-field" id="task-description" maxlength="500" placeholder="Add a few details..."></textarea><div class="field-row"><div><label class="field-label" for="task-status">Status</label><select class="text-field" id="task-status"><option value="todo">To do</option><option value="doing">In progress</option><option value="done">Done</option></select></div><div><label class="field-label" for="task-priority">Priority</label><select class="text-field" id="task-priority"><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option></select></div></div><div class="field-row"><div><label class="field-label" for="task-due">Due date</label><input class="text-field" type="date" id="task-due"></div><div><label class="field-label" for="task-label">Label</label><input class="text-field" id="task-label" maxlength="24" placeholder="e.g. Personal"></div></div><div class="dialog-actions"><button type="button" class="button button-danger hidden" id="delete-task">Delete task</button><span class="dialog-spacer"></span><button type="button" class="button button-secondary" data-close>Cancel</button><button class="button button-primary" type="submit">Save task</button></div></form></dialog>
+  <dialog id="shortcuts-dialog" class="shortcuts-dialog"><button class="close-button shortcut-close" data-close aria-label="Close">×</button><span class="eyebrow">QUICK ACTIONS</span><h2>Keyboard shortcuts</h2><div class="shortcut-row"><span>Add a task</span><kbd>N</kbd></div><div class="shortcut-row"><span>Search</span><kbd>/</kbd></div><div class="shortcut-row"><span>Close dialog</span><kbd>Esc</kbd></div><p>Shortcuts work when you're not typing.</p></dialog>
+  <div id="toast" class="toast" role="status" aria-live="polite"></div>
+  <script src="app.js"></script>
+</body>
+</html>
