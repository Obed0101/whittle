diff --git a/board/app.js b/board/app.js
new file mode 100644
index 0000000..b0ac245
--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,32 @@
+(() => {
+  const KEY = 'daymark-kanban-v1';
+  const columns = [{id:'todo',name:'To do',color:'todo-color'}, {id:'doing',name:'In progress',color:'doing-color'}, {id:'done',name:'Done',color:'done-color'}];
+  const starter = [
+    {id:'seed-1',title:'Plan the week ahead',description:'Take a little time to map out the priorities.',status:'todo',priority:'medium',due:'',label:'Personal',created:Date.now()-40000},
+    {id:'seed-2',title:'Book a dentist appointment',description:'Find a time that works next week.',status:'todo',priority:'low',due:'',label:'Life admin',created:Date.now()-30000},
+    {id:'seed-3',title:'Review notes from Monday',description:'Pull out the key decisions and next steps.',status:'doing',priority:'high',due:'',label:'Work',created:Date.now()-20000},
+    {id:'seed-4',title:'Set up a simple morning routine',description:'Start small: water, stretch, and a proper breakfast.',status:'done',priority:'low',due:'',label:'Wellbeing',created:Date.now()-10000}
+  ];
+  let tasks = load(), editingId = null, sortNewest = false, view = 'board', toastTimer;
+  const $ = s => document.querySelector(s), board = $('#board'), dialog = $('#task-dialog');
+  function load(){try{const v=JSON.parse(localStorage.getItem(KEY));return Array.isArray(v)?v:starter.slice()}catch{return starter.slice()}}
+  function save(){localStorage.setItem(KEY,JSON.stringify(tasks)); updateStats()}
+  function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+  function dateText(value){if(!value)return '';const d=new Date(value+'T00:00:00');return d.toLocaleDateString(undefined,{month:'short',day:'numeric'})}
+  function filtered(){const q=$('#search').value.trim().toLowerCase(),p=$('#priority-filter').value;return tasks.filter(t=>(!q||`${t.title} ${t.description||''} ${t.label||''}`.toLowerCase().includes(q))&&(p==='all'||t.priority===p))}
+  function render(){const shown=filtered();board.innerHTML=columns.map(c=>{const items=shown.filter(t=>t.status===c.id).sort((a,b)=>sortNewest?b.created-a.created:(a.order??a.created)-(b.order??b.created));return `<section class="column" data-column="${c.id}"><div class="column-head"><span class="column-indicator ${c.color}"></span><h2>${c.name}</h2><span class="column-count">${items.length}</span><button class="column-add" data-add="${c.id}" aria-label="Add task to ${c.name}" title="Add task">＋</button></div><div class="column-drop" data-drop="${c.id}">${items.length?items.map(card).join(''):'<div class="empty-column">Drop a task here, or add one</div>'}</div></section>`}).join('');
+    board.classList.toggle('hidden',view!=='board');$('#list-view').classList.toggle('hidden',view!=='list');$('#list-view').innerHTML=shown.map(t=>`<div class="list-row" data-edit="${esc(t.id)}"><span class="list-name">${esc(t.title)}</span><span class="list-status">${columns.find(c=>c.id===t.status)?.name}</span><span class="priority ${t.priority}">${t.priority}</span><span>${dateText(t.due)||'—'}</span></div>`).join('')||'<div class="empty-column">No tasks match your search.</div>';
+    $('#sidebar-count').textContent=tasks.filter(t=>t.status!=='done').length;$('#footer-count').textContent=`${tasks.length} ${tasks.length===1?'task':'tasks'}`;updateStats();}
+  function card(t){const today=new Date();today.setHours(0,0,0,0);const due=t.due?new Date(t.due+'T00:00:00'):null;const overdue=due&&due<today&&t.status!=='done',soon=due&&!overdue&&due<=new Date(today.getTime()+3*86400000)&&t.status!=='done';return `<article class="task-card" draggable="true" data-id="${esc(t.id)}"><div class="task-top"><span class="priority ${esc(t.priority)}">${esc(t.priority[0].toUpperCase()+t.priority.slice(1))} priority</span><button class="card-menu" data-edit="${esc(t.id)}" aria-label="Edit ${esc(t.title)}">···</button></div><h3>${esc(t.title)}</h3>${t.description?`<p class="task-description">${esc(t.description)}</p>`:''}${t.label?`<span class="card-label">${esc(t.label)}</span>`:''}<div class="card-meta"><span class="due-date ${overdue?'overdue':soon?'soon':''}">${t.due?`◷ ${dateText(t.due)}${overdue?' · overdue':''}`:'<span>Added recently</span>'}</span><span class="task-actions">${t.status!=='done'?`<button data-move="${esc(t.id)}" title="Move to next column">Move →</button>`:`<button data-move="${esc(t.id)}" title="Reopen task">Reopen ↶</button>`}</span></div></article>`}
+  function updateStats(){const now=new Date();const soon=new Date();soon.setDate(now.getDate()+7);const week=Date.now()-7*86400000;$('#stat-progress').textContent=tasks.filter(t=>t.status==='doing').length;$('#stat-due').textContent=tasks.filter(t=>t.status!=='done'&&t.due&&new Date(t.due+'T00:00:00')<=soon&&new Date(t.due+'T00:00:00')>=new Date(now.toDateString())).length;$('#stat-done').textContent=tasks.filter(t=>t.status==='done'&&(t.completedAt||0)>=week).length}
+  function openTask(task=null,status='todo'){editingId=task?.id||null;$('#dialog-title').textContent=task?'Edit task':'Add a task';$('#task-title').value=task?.title||'';$('#task-description').value=task?.description||'';$('#task-status').value=task?.status||status;$('#task-priority').value=task?.priority||'medium';$('#task-due').value=task?.due||'';$('#task-label').value=task?.label||'';$('#delete-task').classList.toggle('hidden',!task);dialog.showModal();setTimeout(()=>$('#task-title').focus(),50)}
+  function closeDialogs(){document.querySelectorAll('dialog[open]').forEach(d=>d.close())}
+  function notify(text){const el=$('#toast');el.textContent=text;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200)}
+  $('#task-form').addEventListener('submit',e=>{e.preventDefault();const title=$('#task-title').value.trim();if(!title)return;const status=$('#task-status').value;const data={title,description:$('#task-description').value.trim(),status,priority:$('#task-priority').value,due:$('#task-due').value,label:$('#task-label').value.trim()};if(editingId){const t=tasks.find(x=>x.id===editingId);Object.assign(t,data);if(status==='done'&&t.completedAt==null)t.completedAt=Date.now();if(status!=='done')delete t.completedAt}else tasks.unshift({...data,id:crypto.randomUUID?.()||String(Date.now()),created:Date.now(),...(status==='done'?{completedAt:Date.now()}:{})});save();render();dialog.close();notify(editingId?'Task updated':'Task added')});
+  $('#delete-task').addEventListener('click',()=>{if(!editingId)return;tasks=tasks.filter(t=>t.id!==editingId);save();render();dialog.close();notify('Task deleted')});document.querySelectorAll('[data-close]').forEach(b=>b.addEventListener('click',closeDialogs));$('#add-task').addEventListener('click',()=>openTask());$('#help-button').addEventListener('click',()=>$('#shortcuts-dialog').showModal());$('#focus-nav').addEventListener('click',()=>{$('#priority-filter').value='all';$('#search').value='';view='board';document.querySelectorAll('.view-tab').forEach(b=>b.classList.toggle('selected',b.dataset.view==='board'));render();notify('Focus on one task at a time')});
+  board.addEventListener('click',e=>{const add=e.target.closest('[data-add]'),edit=e.target.closest('[data-edit]'),move=e.target.closest('[data-move]');if(add)openTask(null,add.dataset.add);else if(edit){const t=tasks.find(x=>x.id===edit.dataset.edit);if(t)openTask(t)}else if(move){const t=tasks.find(x=>x.id===move.dataset.move);if(t){t.status=t.status==='todo'?'doing':t.status==='doing'?'done':'todo';if(t.status==='done')t.completedAt=Date.now();else delete t.completedAt;save();render()}}});$('#list-view').addEventListener('click',e=>{const row=e.target.closest('[data-edit]');if(row){const t=tasks.find(x=>x.id===row.dataset.edit);if(t)openTask(t)}});
+  board.addEventListener('dragstart',e=>{const c=e.target.closest('.task-card');if(!c)return;e.dataTransfer.setData('text/plain',c.dataset.id);e.dataTransfer.effectAllowed='move';setTimeout(()=>c.classList.add('dragging'),0)});board.addEventListener('dragend',e=>e.target.closest('.task-card')?.classList.remove('dragging'));board.addEventListener('dragover',e=>{const drop=e.target.closest('[data-drop]');if(drop){e.preventDefault();drop.classList.add('drag-over')}});board.addEventListener('dragleave',e=>{const drop=e.target.closest('[data-drop]');if(drop&&!drop.contains(e.relatedTarget))drop.classList.remove('drag-over')});board.addEventListener('drop',e=>{const drop=e.target.closest('[data-drop]');if(!drop)return;e.preventDefault();drop.classList.remove('drag-over');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=drop.dataset.drop;if(t.status==='done')t.completedAt=Date.now();else delete t.completedAt;save();render()}});
+  $('#search').addEventListener('input',render);$('#priority-filter').addEventListener('change',render);$('#sort-button').addEventListener('click',()=>{sortNewest=!sortNewest;render();notify(sortNewest?'Newest tasks first':'Custom order')});document.querySelectorAll('.view-tab').forEach(b=>b.addEventListener('click',()=>{view=b.dataset.view;document.querySelectorAll('.view-tab').forEach(x=>x.classList.toggle('selected',x===b));render()}));$('#clear-completed').addEventListener('click',()=>{const count=tasks.filter(t=>t.status==='done').length;if(!count){notify('No completed tasks to clear');return}if(confirm(`Delete ${count} completed ${count===1?'task':'tasks'}? This cannot be undone.`)){tasks=tasks.filter(t=>t.status!=='done');save();render();notify('Completed tasks cleared')}});
+  $('#export-button').addEventListener('click',()=>{const blob=new Blob([JSON.stringify({exportedAt:new Date().toISOString(),tasks},null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=`daymark-board-${new Date().toISOString().slice(0,10)}.json`;a.click();URL.revokeObjectURL(url);notify('Board exported')});document.addEventListener('keydown',e=>{if(e.key==='Escape')closeDialogs();if(e.target.matches('input,textarea,select,[contenteditable]'))return;if(e.key.toLowerCase()==='n'){e.preventDefault();openTask()}if(e.key==='/'){e.preventDefault();$('#search').focus()}});
+  render();
+})();
diff --git a/board/index.html b/board/index.html
new file mode 100644
