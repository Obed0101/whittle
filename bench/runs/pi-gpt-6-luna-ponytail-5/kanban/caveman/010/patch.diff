+:root{--ink:#202325;--muted:#858b89;--line:#e9ebe8;--paper:#fff;--canvas:#f7f8f6;--green:#2e7258;--green-dark:#245c47;--shadow:0 3px 14px #26392c0a;--font:'DM Sans',sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--canvas);color:var(--ink);font-family:var(--font);font-size:14px;-webkit-font-smoothing:antialiased}button,input,textarea,select{font:inherit;color:inherit}button{cursor:pointer}.app-shell{min-height:100vh}.sidebar{position:fixed;inset:0 auto 0 0;width:244px;background:#fff;border-right:1px solid var(--line);padding:27px 16px;display:flex;flex-direction:column;z-index:2}.brand{display:flex;align-items:center;gap:10px;color:#202725;text-decoration:none;font:800 20px Manrope,sans-serif;letter-spacing:-.8px;margin:0 0 43px 8px}.brand-mark{display:grid;place-items:center;width:28px;height:28px;border-radius:9px;background:#326e56;color:white;font:800 19px Manrope}.workspace-label,.nav-label{font-size:10px;font-weight:700;letter-spacing:1px;color:#a0a5a1;margin:0 0 10px 8px}.workspace-switch,.nav-item{border:0;background:transparent;text-align:left;width:100%;height:40px;border-radius:7px;display:flex;align-items:center;padding:0 10px;color:#545b58;font-weight:500}.workspace-switch{border:1px solid var(--line);margin-bottom:31px;color:#313735}.workspace-dot{width:8px;height:8px;border-radius:50%;background:#d3a567;margin-right:10px}.chevron{margin-left:auto;color:#929995}.nav-label{margin-bottom:8px}.nav-item{gap:11px;margin-bottom:3px}.nav-item.active{background:#f0f5f1;color:#326e56;font-weight:600}.nav-icon{font-size:17px;width:17px;text-align:center}.nav-count{margin-left:auto;font-size:11px;color:#858c88}.sidebar-bottom{margin-top:auto}.sidebar-tip{display:flex;gap:11px;padding:13px 10px 17px;border-bottom:1px solid var(--line);margin-bottom:12px}.tip-icon{color:#ce9a49;font-size:17px}.sidebar-tip strong{font-size:11px}.sidebar-tip p{font-size:10px;color:#919793;line-height:1.55;margin:5px 0 0}.profile{width:100%;display:flex;align-items:c