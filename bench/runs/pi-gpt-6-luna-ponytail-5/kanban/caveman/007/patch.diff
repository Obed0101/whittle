diff --git a/board/app.js b/board/app.js
new file mode 100644
index 0000000..9b0711d
--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,30 @@
+(() => {
+'use strict';
+const KEY='daymark-board-v1';
+const columns=[['todo','To do'],['doing','In progress'],['done','Done']];
+const $=id=>document.getElementById(id);
+const els={board:$('board'),search:$('search'),sort:$('sortSelect'),dialog:$('taskDialog'),form:$('taskForm'),settings:$('settingsDialog'),help:$('helpDialog')};
+let tasks=[], boardName='My board', dragId=null, toastTimer;
+const uid=()=>Math.random().toString(36).slice(2,10)+Date.now().toString(36);
+function load(){try{const d=JSON.parse(localStorage.getItem(KEY));if(d&&Array.isArray(d.tasks)){tasks=d.tasks.filter(t=>t&&t.id&&t.title).map(t=>({...t,status:columns.some(c=>c[0]===t.status)?t.status:'todo',tags:Array.isArray(t.tags)?t.tags:[]}));boardName=typeof d.boardName==='string'?d.boardName:'My board'}}catch{tasks=[]}}
+function save(){try{localStorage.setItem(KEY,JSON.stringify({version:1,boardName,tasks}))}catch{notify('Could not save. Browser storage may be full.')};render()}
+function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+function dayDiff(date){if(!date)return null;return Math.round((new Date(date+'T00:00:00')-new Date(new Date().toDateString()))/86400000)}
+function activeFilters(){return $('priorityFilter').value!=='all'||$('tagFilter').value!=='all'||$('dueFilter').value!=='all'}
+function filtered(){let q=els.search.value.trim().toLowerCase(),p=$('priorityFilter').value,tag=$('tagFilter').value,due=$('dueFilter').value;return tasks.filter(t=>{if(q&&![t.title,t.description,...t.tags].join(' ').toLowerCase().includes(q))return false;if(p!=='all'&&t.priority!==p)return false;if(tag!=='all'&&!t.tags.includes(tag))return false;let n=dayDiff(t.due);if(due==='overdue'&&!(n<0&&t.status!=='done'))return false;if(due==='today'&&n!==0)return false;if(due==='week'&&!(n>=0&&n<=7))return false;if(due==='none'&&t.due)return false;return true})}
+function render(){const tags=[...new Set(tasks.flatMap(t=>t.tags))].sort();let tf=$('tagFilter'),wanted=tf.value;tf.innerHTML='<option value="all">All tags</option>'+tags.map(t=>`<option value="${esc(t)}">${esc(t)}</option>`).join('');if(tags.includes(wanted))tf.value=wanted;
+const matched=filtered();$('filterDot').classList.toggle('show',activeFilters());$('clearFilters').classList.toggle('show',activeFilters());$('totalCount').textContent=tasks.length;$('visibleCount').textContent=`${matched.length} task${matched.length===1?'':'s'}`;$('today').textContent=new Intl.DateTimeFormat(undefined,{weekday:'long',month:'long',day:'numeric'}).format(new Date());document.querySelector('h1').childNodes[0].textContent=boardName+' ';
+els.board.innerHTML=columns.map(([id,label])=>{let list=matched.filter(t=>t.status===id);if(els.sort.value!=='manual')list.sort((a,b)=>{if(els.sort.value==='due')return (a.due||'9999').localeCompare(b.due||'9999');if(els.sort.value==='priority')return ({high:0,medium:1,low:2,none:3}[a.priority]??3)-({high:0,medium:1,low:2,none:3}[b.priority]??3);return (b.created||0)-(a.created||0)});return `<section class="column ${id}" data-status="${id}"><header class="column-head"><span class="column-dot"></span><span class="column-title">${label}</span><span class="column-count">${list.length}</span><button class="column-add" data-new="${id}" title="Add to ${label}" aria-label="Add task to ${label}">＋</button></header><div class="task-list" data-drop="${id}">${list.length?list.map(card).join(''):`<div class="empty-state"><strong>${activeFilters()||els.search.value?'No matching tasks':'Nothing here yet'}</strong>${activeFilters()||els.search.value?'Try adjusting your search or filters.':'Drop a task here, or add one with ＋'}</div>`}</div></section>`}).join('');}
+function card(t){let n=dayDiff(t.due),date=t.due?new Intl.DateTimeFormat(undefined,{month:'short',day:'numeric'}).format(new Date(t.due+'T00:00:00')):'';return `<article class="task-card" draggable="true" data-id="${esc(t.id)}" tabindex="0" role="button" aria-label="Edit ${esc(t.title)}"><div class="task-title">${esc(t.title)}</div>${t.description?`<div class="task-desc">${esc(t.description)}</div>`:''}<div class="task-meta">${t.priority&&t.priority!=='none'?`<span class="priority ${t.priority}">⚑ ${t.priority[0].toUpperCase()+t.priority.slice(1)}</span>`:''}${t.tags.slice(0,3).map(x=>`<span class="tag">${esc(x)}</span>`).join('')}${date?`<span class="due ${n<0&&t.status!=='done'?'late':n>=0&&n<=2?'soon':''}">◷ ${n<0&&t.status!=='done'?'Overdue · ':''}${date}</span>`:''}<button class="card-edit" data-edit="${esc(t.id)}" aria-label="Edit task">✎</button></div></article>`}
+function notify(s){let t=$('toast');t.textContent=s;t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),2400)}
+function openTask(id='',status='todo'){let t=tasks.find(x=>x.id===id);$('taskId').value=t?.id||'';$('taskName').value=t?.title||'';$('taskDescription').value=t?.description||'';$('taskStatus').value=t?.status||status;$('taskPriority').value=t?.priority||'none';$('taskDue').value=t?.due||'';$('taskTags').value=t?.tags.join(', ')||'';$('dialogTitle').textContent=t?'Edit task':'New task';$('deleteTask').hidden=!t;els.dialog.showModal();setTimeout(()=>$('taskName').focus(),50)}
+$('addTask').onclick=()=>openTask();$('renameBoard').onclick=()=>{let n=prompt('Name your board',boardName);if(n&&n.trim()){boardName=n.trim().slice(0,50);save()}};$('settingsBtn').onclick=()=>els.settings.showModal();$('helpBtn').onclick=()=>els.help.showModal();document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>els.dialog.close());
+els.form.onsubmit=e=>{e.preventDefault();let id=$('taskId').value,t=tasks.find(x=>x.id===id);let data={id:id||uid(),title:$('taskName').value.trim(),description:$('taskDescription').value.trim(),status:$('taskStatus').value,priority:$('taskPriority').value,due:$('taskDue').value,tags:[...new Set($('taskTags').value.split(',').map(x=>x.trim()).filter(Boolean).map(x=>x.slice(0,30)))],created:t?.created||Date.now()};if(!data.title)return;if(t)Object.assign(t,data);else tasks.push(data);els.dialog.close();save();notify(t?'Task updated':'Task added')};
+$('deleteTask').onclick=()=>{let id=$('taskId').value,t=tasks.find(x=>x.id===id);if(t&&confirm(`Delete “${t.title}”?`)){tasks=tasks.filter(x=>x.id!==id);els.dialog.close();save();notify('Task deleted')}};
+els.board.addEventListener('click',e=>{let n=e.target.closest('[data-new]'),edit=e.target.closest('[data-edit]'),cardEl=e.target.closest('.task-card');if(n)openTask('',n.dataset.new);else if(edit||cardEl)openTask((edit||cardEl).dataset.edit||cardEl.dataset.id)});els.board.addEventListener('keydown',e=>{if((e.key==='Enter'||e.key===' ')&&e.target.classList.contains('task-card')){e.preventDefault();openTask(e.target.dataset.id)}});
+els.board.addEventListener('dragstart',e=>{let c=e.target.closest('.task-card');if(c){dragId=c.dataset.id;c.classList.add('dragging');e.dataTransfer.effectAllowed='move';e.dataTransfer.setData('text/plain',dragId)}});els.board.addEventListener('dragend',e=>{e.target.closest('.task-card')?.classList.remove('dragging');document.querySelectorAll('.drag-over').forEach(x=>x.classList.remove('drag-over'))});els.board.addEventListener('dragover',e=>{let col=e.target.closest('.column');if(col){e.preventDefault();col.classList.add('drag-over')}});els.board.addEventListener('dragleave',e=>{let col=e.target.closest('.column');if(col&&!col.contains(e.relatedTarget))col.classList.remove('drag-over')});els.board.addEventListener('drop',e=>{let col=e.target.closest('.column');if(!col)return;e.preventDefault();col.classList.remove('drag-over');let id=e.dataTransfer.getData('text/plain')||dragId,t=tasks.find(x=>x.id===id);if(t&&t.status!==col.dataset.status){t.status=col.dataset.status;save()}});
+els.search.oninput=render;els.sort.onchange=render;$('filterBtn').onclick=()=>{$('filterPanel').hidden=!$('filterPanel').hidden};['priorityFilter','tagFilter','dueFilter'].forEach(x=>$(x).onchange=render);$('clearFilters').onclick=()=>{$('priorityFilter').value='all';$('tagFilter').value='all';$('dueFilter').value='all';els.search.value='';render()};$('viewMenu').onclick=()=>notify('Board view is active');
+function download(){let blob=new Blob([JSON.stringify({version:1,exportedAt:new Date().toISOString(),boardName,tasks},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='daymark-board-'+new Date().toISOString().slice(0,10)+'.json';a.click();URL.revokeObjectURL(a.href);notify('Board backup downloaded')}$('exportBtn').onclick=download;$('importBtn').onclick=()=>$('importFile').click();$('importFile').onchange=async e=>{let f=e.target.files[0];if(!f)return;try{let d=JSON.parse(await f.text());if(!d||!Array.isArray(d.tasks)||d.tasks.some(t=>!t||typeof t.title!=='string'))throw Error();if(confirm(`Import ${d.tasks.length} tasks? This replaces your current board.`)){tasks=d.tasks.map(t=>({...t,id:uid(),status:columns.some(c=>c[0]===t.status)?t.status:'todo',tags:Array.isArray(t.tags)?t.tags:[]}));boardName=typeof d.boardName==='string'?d.boardName:'My board';save();els.settings.close();notify('Board imported')}}catch{alert('That file is not a valid Daymark board backup.')}e.target.value=''};$('resetBtn').onclick=()=>{if(confirm('Delete every task from this board? This cannot be undone. Export a backup first if needed.')){tasks=[];save();els.settings.close();notify('Board reset')}};
+document.addEventListener('keydown',e=>{if(e.key==='Escape')return;if(['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName)||els.dialog.open||els.settings.open||els.help.open)return;if(e.key.toLowerCase()==='n')openTask();if(e.key==='/'){e.preventDefault();els.search.focus()}});
+load();render();
+})();
