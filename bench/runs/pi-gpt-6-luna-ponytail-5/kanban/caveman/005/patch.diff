+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
+<meta name="theme-color" content="#f6f5f0"><title>Daymark — Personal board</title>
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<div class="app-shell">
+<aside class="sidebar">
+  <a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d</span><span>daymark<span class="brand-period">.</span></span></a>
+  <div class="workspace-label">YOUR SPACE</div>
+  <button class="nav-item active" id="boardNav"><span class="nav-icon">▦</span> My board <span class="nav-count" id="navCount">0</span></button>
+  <button class="nav-item" id="todayNav"><span class="nav-icon">◷</span> Due today</button>
+  <button class="nav-item" id="upcomingNav"><span class="nav-icon">↗</span> Upcoming</button>
+  <div class="sidebar-bottom"><div class="focus-card"><span class="focus-spark">✳</span><p>Make room for<br><strong>what matters.</strong></p><span class="focus-note">One thing at a time.</span></div><div class="local-note"><span class="local-dot"></span> Saved on this device</div></div>
+</aside>
+<main class="main">
+  <header class="topbar"><div class="breadcrumb">PERSONAL SPACE <span>/</span> <b id="viewLabel">My board</b></div><div class="top-actions"><button class="icon-button" id="helpButton" title="Keyboard shortcuts" aria-label="Keyboard shortcuts">?</button><div class="avatar" title="Your personal workspace">Y</div></div></header>
+  <section class="content">
+    <div class="heading-row"><div><div class="eyebrow" id="dateLabel">YOUR DAY, AT A GLANCE</div><h1 id="pageTitle">My board<span class="title-period">.</span></h1><p class="subtitle" id="subtitle">A little progress, every day.</p></div><button class="primary-button" id="newTask"><span>＋</span> New task <kbd>N</kbd></button></div>
+    <div class="toolbar"><div class="board-stats"><span class="stat-dot"></span><span id="taskSummary">0 tasks in progress</span><span class="stat-divider">·</span><span id="doneSummary">0 completed</span></div><div class="tools"><label class="search-box"><span>⌕</span><input id="search" type="search" placeholder="Search tasks..." aria-label="Search tasks"><kbd>/</kbd></label><button class="filter-button" id="filterButton"><span>☷</span> Filter <span class="filter-count" id="filterCount"></span></button><div class="filter-popover hidden" id="filterPopover"><label>Priority<select id="priorityFilter"><option value="all">All priorities</option><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select></label><label>Due date<select id="dueFilter"><option value="all">Any time</option><option value="overdue">Overdue</option><option value="today">Due today</option><option value="week">Next 7 days</option><option value="none">No due date</option></select></label><button class="text-button" id="clearFilters">Clear filters</button></div></div></div>
+    <section class="board" id="board" aria-label="Kanban board"></section>
+    <footer class="board-footer"><span>DRAG TASKS TO UPDATE THEIR STATUS</span><button class="text-button" id="clearDone">Clear completed</button></footer>
+  </section>
+</main>
+</div>
+<div class="toast" id="toast" role="status"></div>
+<dialog id="taskDialog"><form id="taskForm"><div class="dialog-top"><div><span class="eyebrow">TASK DETAILS</span><h2 id="dialogTitle">New task</h2></div><button type="button" class="icon-button close-dialog" aria-label="Close">×</button></div><input type="hidden" id="taskId"><label class="field-label" for="taskTitle">Task name</label><input class="text-input title-input" id="taskTitle" maxlength="120" placeholder="What needs doing?" required><label class="field-label" for="taskDescription">Notes <span class="optional">OPTIONAL</span></label><textarea class="text-input" id="taskDescription" rows="3" maxlength="500" placeholder="Add a few details..."></textarea><div class="field-row"><label class="field-label">Status<select class="text-input" id="taskStatus"><option value="todo">To do</option><option value="doing">In progress</option><option value="done">Done</option></select></label><label class="field-label">Priority<select class="text-input" id="taskPriority"><option value="medium">Medium</option><option value="high">High</option><option value="low">Low</option></select></label></div><label class="field-label" for="taskDue">Due date <span class="optional">OPTIONAL</span></label><input class="text-input" id="taskDue" type="date"><div class="dialog-actions"><button type="button" class="delete-button hidden" id="deleteTask">Delete task</button><span class="action-spacer"></span><button type="button" class="secondary-button close-dialog">Cancel</button><button class="primary-button" type="submit" id="saveTask">Add task</button></div></form></dialog>
+<div class="overlay hidden" id="helpOverlay"><div class="help-card"><button class="icon-button close-help" aria-label="Close">×</button><span class="eyebrow">A FEW SHORTCUTS</span><h2>Keep your flow.</h2><p><kbd>N</kbd> New task</p><p><kbd>/</kbd> Search tasks</p><p><kbd>Esc</kbd> Close dialog</p><button class="secondary-button close-help">Got it</button></div></div>
+<script src="app.js"></script>
+</body></html>
