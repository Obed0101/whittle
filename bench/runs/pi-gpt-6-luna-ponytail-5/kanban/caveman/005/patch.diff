diff --git a/board/app.js b/board/app.js
new file mode 100644
index 0000000..8a939b3
--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,39 @@
+(() => {
+  const KEY='daymark-board-v1';
+  const initial=[
+    {id:'seed1',title:'Plan the week ahead',description:'Choose the three things that would make this week feel good.',status:'todo',priority:'medium',due:'',created:Date.now()-5000},
+    {id:'seed2',title:'Send the project update',description:'Share a quick note with the team on where things stand.',status:'todo',priority:'high',due:'',created:Date.now()-4000},
+    {id:'seed3',title:'Make space for a walk',description:'A short reset outside counts.',status:'doing',priority:'low',due:'',created:Date.now()-3000}
+  ];
+  let tasks;
+  try { const saved=JSON.parse(localStorage.getItem(KEY)); tasks=Array.isArray(saved)?saved:initial; } catch { tasks=initial; }
+  let view='board', searchTerm='', toastTimer;
+  const $=id=>document.getElementById(id), board=$('board'), dialog=$('taskDialog');
+  const labels={todo:'To do',doing:'In progress',done:'Done'};
+  const esc=s=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+  const today=()=>{const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`};
+  function save(){localStorage.setItem(KEY,JSON.stringify(tasks));render()}
+  function notify(msg){const el=$('toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200)}
+  function visible(task){if(searchTerm&&!`${task.title} ${task.description}`.toLowerCase().includes(searchTerm))return false;const p=$('priorityFilter').value,d=$('dueFilter').value;if(p!=='all'&&task.priority!==p)return false;const date=task.due||'';if(d==='overdue'&&!(date&&date<today()&&task.status!=='done'))return false;if(d==='today'&&date!==today())return false;if(d==='week'){const end=new Date();end.setDate(end.getDate()+7);const endStr=`${end.getFullYear()}-${String(end.getMonth()+1).padStart(2,'0')}-${String(end.getDate()).padStart(2,'0')}`;if(!(date>=today()&&date<=endStr))return false}if(d==='none'&&date)return false;if(view==='today'&&date!==today())return false;if(view==='upcoming'&&!(date>today()))return false;return true}
+  function render(){
+    $('viewLabel').textContent=view==='board'?'My board':view==='today'?'Due today':'Upcoming';$('pageTitle').innerHTML=esc($('viewLabel').textContent)+'<span class="title-period">.</span>';
+    $('subtitle').textContent=view==='board'?'A little progress, every day.':view==='today'?'Everything you planned for today.':'A look at what’s coming up.';
+    $('dateLabel').textContent=new Intl.DateTimeFormat('en',{weekday:'long',month:'long',day:'numeric'}).format(new Date()).toUpperCase();
+    const active=tasks.filter(t=>t.status!=='done').length,done=tasks.filter(t=>t.status==='done').length;$('taskSummary').textContent=`${active} ${active===1?'task':'tasks'} in progress`;$('doneSummary').textContent=`${done} completed`;$('navCount').textContent=active;
+    const filtering=$('priorityFilter').value!=='all'||$('dueFilter').value!=='all';$('filterCount').textContent=filtering?'•':'';
+    board.innerHTML=Object.keys(labels).map(status=>{const list=tasks.filter(t=>t.status===status&&visible(t));return `<section class="column" data-status="${status}"><div class="column-head"><span class="column-dot"></span><h2>${labels[status]}</h2><span class="column-count">${tasks.filter(t=>t.status===status).length}</span><button class="column-add" data-add="${status}" title="Add to ${labels[status]}" aria-label="Add to ${labels[status]}">＋</button></div><div class="task-list" data-drop="${status}">${list.length?list.map(card).join(''):`<div class="empty-state"><div><strong>${searchTerm||filtering?'No matching tasks':'Nothing here yet'}</strong>${searchTerm||filtering?'Try changing your search or filters.':'Add a task or move one here.'}</div></div>`}</div></section>`}).join('');
+    board.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>openNew(b.dataset.add));board.querySelectorAll('.task-card').forEach(el=>{el.addEventListener('dblclick',()=>openEdit(el.dataset.id));el.addEventListener('dragstart',e=>{e.dataTransfer.setData('text/plain',el.dataset.id);setTimeout(()=>el.classList.add('dragging'),0)});el.addEventListener('dragend',()=>el.classList.remove('dragging'))});board.querySelectorAll('[data-drop]').forEach(el=>{el.addEventListener('dragover',e=>{e.preventDefault();el.classList.add('drag-over')});el.addEventListener('dragleave',()=>el.classList.remove('drag-over'));el.addEventListener('drop',e=>{e.preventDefault();el.classList.remove('drag-over');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t&&t.status!==el.dataset.drop){t.status=el.dataset.drop;save();notify(`Moved to ${labels[t.status]}`)}})});
+    board.querySelectorAll('[data-menu]').forEach(b=>b.onclick=e=>{e.stopPropagation();document.querySelectorAll('.task-menu').forEach(m=>m.classList.add('hidden'));b.nextElementSibling.classList.toggle('hidden')});board.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>openEdit(b.dataset.edit));board.querySelectorAll('[data-move]').forEach(b=>b.onclick=()=>{const t=tasks.find(x=>x.id===b.dataset.id);t.status=b.dataset.move;save();notify(`Moved to ${labels[t.status]}`)});board.querySelectorAll('[data-remove]').forEach(b=>b.onclick=()=>remove(b.dataset.remove));
+  }
+  function card(t){let due='';if(t.due){const d=new Date(`${t.due}T00:00:00`),fmt=new Intl.DateTimeFormat('en',{month:'short',day:'numeric'}).format(d),cls=t.due<today()&&t.status!=='done'?'overdue':t.due===today()?'today':'';due=`<span class="due ${cls}">${cls==='overdue'?'Overdue · ':''}${fmt}</span>`}return `<article class="task-card" draggable="true" data-id="${esc(t.id)}"><div class="task-top"><span class="priority ${esc(t.priority)}">${esc(t.priority)}</span><div class="task-menu-wrap"><button class="more-button" data-menu aria-label="Task actions">···</button><div class="task-menu hidden"><button data-edit="${esc(t.id)}">Edit task</button>${t.status!=='todo'?`<button data-move="todo" data-id="${esc(t.id)}">Move to To do</button>`:''}${t.status!=='doing'?`<button data-move="doing" data-id="${esc(t.id)}">Move to In progress</button>`:''}${t.status!=='done'?`<button data-move="done" data-id="${esc(t.id)}">Mark complete</button>`:''}<button data-remove="${esc(t.id)}">Delete task</button></div></div></div><h3>${esc(t.title)}</h3>${t.description?`<p class="task-desc">${esc(t.description)}</p>`:''}<div class="task-meta">${due}</div></article>`}
+  function openNew(status='todo'){ $('taskForm').reset();$('taskId').value='';$('taskStatus').value=status;$('dialogTitle').textContent='New task';$('saveTask').textContent='Add task';$('deleteTask').classList.add('hidden');dialog.showModal();$('taskTitle').focus() }
+  function openEdit(id){const t=tasks.find(x=>x.id===id);if(!t)return;$('taskId').value=t.id;$('taskTitle').value=t.title;$('taskDescription').value=t.description||'';$('taskStatus').value=t.status;$('taskPriority').value=t.priority;$('taskDue').value=t.due||'';$('dialogTitle').textContent='Edit task';$('saveTask').textContent='Save changes';$('deleteTask').classList.remove('hidden');dialog.showModal();$('taskTitle').focus()}
+  function remove(id){if(!confirm('Delete this task? This cannot be undone.'))return;tasks=tasks.filter(t=>t.id!==id);save();notify('Task deleted')}
+  $('taskForm').onsubmit=e=>{e.preventDefault();const id=$('taskId').value,task={id:id||crypto.randomUUID(),title:$('taskTitle').value.trim(),description:$('taskDescription').value.trim(),status:$('taskStatus').value,priority:$('taskPriority').value,due:$('taskDue').value,created:Date.now()};if(!task.title)return;if(id){tasks[tasks.findIndex(t=>t.id===id)]=task;notify('Changes saved')}else{tasks.push(task);notify('Task added')}dialog.close();save()};
+  $('newTask').onclick=()=>openNew();$('deleteTask').onclick=()=>{const id=$('taskId').value;dialog.close();remove(id)};document.querySelectorAll('.close-dialog').forEach(b=>b.onclick=()=>dialog.close());
+  $('search').oninput=e=>{searchTerm=e.target.value.toLowerCase().trim();render()};$('filterButton').onclick=()=> $('filterPopover').classList.toggle('hidden');$('priorityFilter').onchange=render;$('dueFilter').onchange=render;$('clearFilters').onclick=()=>{$('priorityFilter').value='all';$('dueFilter').value='all';$('search').value='';searchTerm='';render()};
+  function setView(v){view=v;document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));$(v==='board'?'boardNav':v==='today'?'todayNav':'upcomingNav').classList.add('active');render()}
+  $('boardNav').onclick=()=>setView('board');$('todayNav').onclick=()=>setView('today');$('upcomingNav').onclick=()=>setView('upcoming');$('clearDone').onclick=()=>{const count=tasks.filter(t=>t.status==='done').length;if(!count){notify('No completed tasks to clear');return}if(confirm(`Delete ${count} completed ${count===1?'task':'tasks'}? This cannot be undone.`)){tasks=tasks.filter(t=>t.status!=='done');save();notify('Completed tasks cleared')}};
+  $('helpButton').onclick=()=> $('helpOverlay').classList.remove('hidden');document.querySelectorAll('.close-help').forEach(b=>b.onclick=()=> $('helpOverlay').classList.add('hidden'));$('helpOverlay').onclick=e=>{if(e.target===$('helpOverlay'))$('helpOverlay').classList.add('hidden')};document.addEventListener('click',e=>{if(!e.target.closest('.task-menu-wrap'))document.querySelectorAll('.task-menu').forEach(m=>m.classList.add('hidden'));if(!e.target.closest('.tools'))$('filterPopover').classList.add('hidden')});document.addEventListener('keydown',e=>{if(e.key==='Escape'){$('helpOverlay').classList.add('hidden');$('filterPopover').classList.add('hidden')}if(e.target.matches('input,textarea,select')||dialog.open)return;if(e.key.toLowerCase()==='n'){e.preventDefault();openNew()}if(e.key==='/'){e.preventDefault();$('search').focus()}});
+  render();
+})();
