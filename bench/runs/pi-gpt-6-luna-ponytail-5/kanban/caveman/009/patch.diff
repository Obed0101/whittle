+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#f5f4f0">
+<title>Daymark — Personal Kanban</title>
+<link rel="stylesheet" href="style.css">
+</head>
+<body>
+<div class="app-shell">
+<aside class="rail"><a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d</span></a><div class="rail-rule"></div><button class="rail-btn active" aria-label="Board" title="Board">▦</button><button class="rail-btn" id="focusBtn" aria-label="Focus mode" title="Focus mode">◉</button><div class="rail-bottom"><button class="rail-btn" id="helpBtn" aria-label="Keyboard shortcuts" title="Keyboard shortcuts">?</button></div></aside>
+<main class="main">
+<header class="topbar"><div class="crumb"><span class="crumb-muted">Personal</span><span class="slash">/</span><strong>My board</strong></div><div class="top-actions"><span class="today-label" id="todayLabel"></span><button class="icon-button" id="exportBtn" title="Export board" aria-label="Export board">↥</button><label class="icon-button import-button" title="Import board" aria-label="Import board">↧<input type="file" id="importInput" accept="application/json,.json" hidden></label><button class="avatar" title="Your workspace">Y</button></div></header>
+<section class="welcome"><div><p class="eyebrow">YOUR SPACE, YOUR PACE</p><h1>Make room for <em>what matters.</em></h1><p class="subhead">A little progress, every day.</p></div><div class="week-card"><span class="week-icon">✳</span><div><strong id="weekCount">0 tasks done</strong><span>this week</span></div><div class="week-dots" id="weekDots" aria-hidden="true"></div></div></section>
+<section class="toolbar"><div class="toolbar-left"><div class="view-label"><span class="view-icon">▦</span> Board <span class="tiny-chevron">⌄</span></div><span class="toolbar-divider"></span><label class="search"><span>⌕</span><input id="searchInput" type="search" placeholder="Search tasks..." aria-label="Search tasks"><kbd>/</kbd></label></div><div class="toolbar-right"><button class="filter-btn" id="filterBtn">☷ <span>Filter</span><span class="filter-count" id="filterCount"></span></button><button class="primary-btn" id="addTaskBtn"><span>＋</span> Add task <kbd>N</kbd></button></div></section>
+<div class="filter-panel" id="filterPanel" hidden><label>Priority<select id="priorityFilter"><option value="all">Any priority</option><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select></label><label>Due date<select id="dueFilter"><option value="all">Any date</option><option value="overdue">Overdue</option><option value="today">Due today</option><option value="upcoming">Upcoming</option><option value="none">No due date</option></select></label><button class="clear-filters" id="clearFilters">Clear filters</button></div>
+<section class="board" id="board" aria-label="Kanban board"></section>
+<footer class="footer"><span><span class="save-dot"></span> Saved on this device</span><span>Drag cards to move them <span class="footer-sep">·</span> <button id="shortcutsLink">Keyboard shortcuts</button></span></footer>
+</main></div>
+<div class="modal-backdrop" id="modalBackdrop" hidden><section class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle"><div class="modal-header"><div><p class="eyebrow">A SMALL STEP FORWARD</p><h2 id="modalTitle">New task</h2></div><button class="close-btn" id="closeModal" aria-label="Close">×</button></div><form id="taskForm"><label class="field-label" for="taskTitle">Task name</label><input id="taskTitle" class="title-input" maxlength="120" placeholder="What needs doing?" required><label class="field-label" for="taskNotes">Notes <span>optional</span></label><textarea id="taskNotes" rows="3" maxlength="1000" placeholder="Add a few details..."></textarea><div class="field-row"><label><span class="field-label">Column</span><select id="taskStatus"><option value="todo">To do</option><option value="doing">In progress</option><option value="done">Done</option></select></label><label><span class="field-label">Priority</span><select id="taskPriority"><option value="none">No priority</option><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select></label></div><div class="field-row"><label><span class="field-label">Due date <span>optional</span></span><input type="date" id="taskDue"></label><label><span class="field-label">Label <span>optional</span></span><input id="taskLabel" maxlength="30" placeholder="e.g. Work"></label></div><div class="modal-footer"><button type="button" class="delete-btn" id="deleteTask" hidden>Delete task</button><span class="form-spacer"></span><button type="button" class="cancel-btn" id="cancelModal">Cancel</button><button class="primary-btn" type="submit" id="saveTask">Add task</button></div></form></section></div>
+<div class="toast" id="toast" role="status" aria-live="polite"></div>
+<div class="help-backdrop" id="helpBackdrop" hidden><section class="help-card" role="dialog" aria-modal="true" aria-labelledby="helpTitle"><button class="close-btn help-close" id="closeHelp" aria-label="Close">×</button><p class="eyebrow">A FEW HANDY KEYS</p><h2 id="helpTitle">Shortcuts</h2><div class="shortcut"><span>New task</span><kbd>N</kbd></div><div class="shortcut"><span>Search</span><kbd>/</kbd></div><div class="shortcut"><span>Close dialog</span><kbd>Esc</kbd></div><div class="shortcut"><span>Focus mode</span><kbd>F</kbd></div></section></div>
+<script src="app.js"></script>
+</body></html>
