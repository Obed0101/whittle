+  $('#addTaskBtn').onclick=()=>openModal();$('#searchInput').addEventListener('input',render);$('#priorityFilter').onchange=render;$('#dueFilter').onchange=render;$('#filterBtn').onclick=()=>{$('#filterPanel').hidden=!$('#filterPanel').hidden};$('#clearFilters').onclick=()=>{$('#priorityFilter').value='all';$('#dueFilter').value='all';render()};
+  function help(open){$('#helpBackdrop').hidden=!open}$('#helpBtn').onclick=$('#shortcutsLink').onclick=()=>help(true);$('#closeHelp').onclick=()=>help(false);$('#helpBackdrop').onclick=e=>{if(e.target.id==='helpBackdrop')help(false)};
+  $('#focusBtn').onclick=()=>{document.body.classList.toggle('focus-mode');notify(document.body.classList.contains('focus-mode')?'Focus mode on':'Focus mode off')};
+  $('#exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify({version:1,exportedAt:new Date().toISOString(),tasks},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`daymark-board-${dateOnly()}.json`;a.click();URL.revokeObjectURL(a.href);notify('Board exported')};
+  $('#importInput').onchange=async e=>{const file=e.target.files[0];if(!file)return;try{const data=JSON.parse(await file.text()),incoming=Array.isArray(data)?data:data.tasks;if(!Array.isArray(incoming))throw Error();if(!confirm(`Import ${incoming.length} tasks? This replaces your current board.`))return;tasks=incoming.filter(t=>t&&typeof t.title==='string'&&columns.some(([s])=>s===t.status)).map(t=>({...t,id:String(t.id||uid())}));save();render();notify(`${tasks.length} tasks imported`)}catch{notify('Invalid board file')}finally{e.target.value=''}};
