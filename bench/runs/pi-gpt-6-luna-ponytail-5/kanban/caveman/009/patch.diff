+  function dueText(date){if(!date)return'';const d=new Date(date+'T00:00:00'),today=new Date(dateOnly()+'T00:00:00'),diff=Math.round((d-today)/86400000);if(diff===0)return'Due today';if(diff===1)return'Tomorrow';return d.toLocaleDateString(undefined,{month:'short',day:'numeric'});}
+  function matches(t){const q=$('#searchInput').value.trim().toLowerCase();if(q&&!`${t.title} ${t.notes||''} ${t.label||''}`.toLowerCase().includes(q))return false;const p=$('#priorityFilter').value,d=$('#dueFilter').value,today=dateOnly();if(p!=='all'&&t.priority!==p)return false;if(d==='overdue'&&(!t.due||t.due>=today||t.status==='done'))return false;if(d==='today'&&t.due!==today)return false;if(d==='upcoming'&&(!t.due||t.due<=today))return false;if(d==='none'&&t.due)return false;return true;}
+  function render(){board.innerHTML='';for(const [status,title] of columns){const items=tasks.filter(t=>t.status===status),shown=items.filter(matches);const col=document.createElement('section');col.className='column';col.dataset.status=status;col.innerHTML=`<div class="column-head"><span class="column-dot"></span><span class="column-title">${title}</span><span class="count">${items.length}</span><button class="column-add" aria-label="Add task to ${title}" title="Add task">＋</button></div><div class="card-list"></div>`;const list=col.querySelector('.card-list');col.querySelector('.column-add').onclick=()=>openModal(null,status);for(const t of shown){const card=document.createElement('article');card.className='task-card';card.draggable=true;card.dataset.id=t.id;const due=t.due?`<span class="due-chip ${t.due<dateOnly()&&t.status!=='done'?'overdue':t.due<=dateOnly()?'soon':''}">◷ ${escape(dueText(t.due))}</span>`:'';card.innerHTML=`<button class="card-menu" aria-label="Edit ${escape(t.title)}" title="Edit task">···</button><h3>${escape(t.title)}</h3>${t.notes?`<p class="task-notes">${escape(t.notes)}</p>`:''}<div class="card-meta">${t.priority&&t.priority!=='none'?`<span class="priority priority-${t.priority}">${t.priority[0].toUpperCase()+t.priority.slice(1)}</span>`:''}${t.label?`<span class="label-chip">${escape(t.label)}</span>`:''}${due}<span class="card-created">${t.created?new Date(t.created).toLocaleDateString(undefined,{month:'short',day:'numeric'}):''}</span></div>`;card.querySelector('.card-menu').onclick=e=>{e.stopPropagation();openModal(t.id)};card.onclick=()=>openModal(t.id);card.addEventListener('dragstart',e=>{e.dataTransfer.setData('text/plain',t.id);e.dataTransfer.effectAllowed='move';setTimeout(()=>card.classList.add('dragging'),0)});card.addEventListener('dragend',()=>card.classList.remove('dragging'));list.append(card)}if(!shown.length){const empty=document.createElement('div');empty.className='empty-hint';empty.textContent=items.length?'No tasks match your filters':'Add a task to get started';if(!items.length)empty.onclick=()=>openModal(null,status);list.append(empty)}col.addEventListener('dragover',e=>{e.preventDefault();col.classList.add('drag-over')});col.addEventListener('dragleave',e=>{if(!col.contains(e.relatedTarget))col.classList.remove('drag-over')});col.addEventListener('drop',e=>{e.preventDefault();col.classList.remove('drag-over');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t&&t.status!==status){t.status=status;t.updated=new Date().toISOString();save();render();notify(`Moved to ${title}`)}});board.append(col)}$('#filterCount').textContent=[$('#priorityFilter').value!=='all',$('#dueFilter').value!=='all'].filter(Boolean).length||'';updateWeek();}
+  function updateWeek(){const now=new Date(),start=new Date(now);start.setHours(0,0,0,0);start.setDate(start.getDate()-((start.getDay()+6)%7));const done=tasks.filter(t=>t.status==='done'&&t.completedAt&&new Date(t.completedAt)>=start).length;$('#weekCount').textContent=`${done} task${done===1?'':'s'} done`;const dots=$('#weekDots');dots.innerHTML=Array.from({length:5},(_,i)=>`<i class="${i<Math.min(done,5)?'filled':''}"></i>`).join('')}
+  function openModal(id=null,status='todo'){editing=id;const t=tasks.find(x=>x.id===id);$('#modalTitle').textContent=t?'Edit task':'New task';$('#saveTask').textContent=t?'Save changes':'Add task';$('#deleteTask').hidden=!t;$('#taskTitle').value=t?.title||'';$('#taskNotes').value=t?.notes||'';$('#taskStatus').value=t?.status||status;$('#taskPriority').value=t?.priority||'none';$('#taskDue').value=t?.due||'';$('#taskLabel').value=t?.label||'';modal.hidden=false;setTimeout(()=>$('#taskTitle').focus(),30)}
+  function closeModal(){modal.hidden=true;editing=null;form.reset()}
+  form.addEventListener('submit',e=>{e.preventDefault();const title=$('#taskTitle').value.trim();if(!title){$('#taskTitle').focus();return}const prev=tasks.find(t=>t.id===editing);const t={id:prev?.id||uid(),title,notes:$('#taskNotes').value.trim(),status:$('#taskStatus').value,priority:$('#taskPriority').value,due:$('#taskDue').value,label:$('#taskLabel').value.trim(),created:prev?.created||new Date().toISOString(),updated:new Date().toISOString(),completedAt:$('#taskStatus').value==='done'?(prev?.status==='done'?prev.completedAt:new Date().toISOString()):null};if(prev)tasks[tasks.indexOf(prev)]=t;else tasks.unshift(t);save();closeModal();render();notify(prev?'Task updated':'Task added')});
