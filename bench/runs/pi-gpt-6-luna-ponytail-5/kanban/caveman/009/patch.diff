+(() => {
+  'use strict';
+  const KEY='daymark-board-v1';
+  const columns=[['todo','To do'],['doing','In progress'],['done','Done']];
+  const $=s=>document.querySelector(s), board=$('#board'), modal=$('#modalBackdrop'), form=$('#taskForm');
+  let tasks=[],editing=null,toastTimer;
+  const uid=()=>Math.random().toString(36).slice(2,10)+Date.now().toString(36);
+  const escape=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+  const dateOnly=()=>{const d=new Date();return new Date(d.getTime()-d.getTimezoneOffset()*60000).toISOString().slice(0,10)};
+  function load(){try{const d=JSON.parse(localStorage.getItem(KEY));if(Array.isArray(d))tasks=d.filter(t=>t&&typeof t.title==='string'&&columns.some(([s])=>s===t.status)).map(t=>({...t,id:String(t.id||uid()),priority:['high','medium','low','none'].includes(t.priority)?t.priority:'none'}));}catch{tasks=[]}}
