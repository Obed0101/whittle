+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f7f7f5"><title>Daymark — Personal board</title>
+<link rel="stylesheet" href="styles.css">
+</head>
+<body>
+<div class="app-shell">
+<aside class="sidebar">
+  <a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d</span><span>daymark<small>YOUR PERSONAL WORKSPACE</small></span></a>
+  <div class="workspace"><div class="avatar">M</div><div><b>My workspace</b><small>Personal</small></div><span class="chevron">⌄</span></div>
+  <div class="nav-label">WORKSPACE</div>
+  <button class="nav-item active" id="boardNav"><span class="nav-icon">▦</span> My board <span class="nav-count" id="navCount">0</span></button>
+  <button class="nav-item" id="todayNav"><span class="nav-icon">◷</span> Due soon</button>
+  <button class="nav-item" id="archiveNav"><span class="nav-icon">▤</span> Completed</button>
+  <div class="sidebar-bottom"><div class="focus-card"><span class="focus-icon">✳</span><b>A little progress<br>adds up.</b><p>Keep your focus on what matters today.</p><div class="focus-dots"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div></div><button class="profile"><span class="profile-avatar">M</span><span><b>My space</b><small>Local workspace</small></span><span class="more">•••</span></button></div>
+</aside>
+<main class="main">
+  <header class="topbar"><div class="breadcrumbs">My workspace <span>/</span> <b>My board</b></div><div class="top-actions"><button class="icon-button" id="helpBtn" title="Keyboard shortcuts">?</button><button class="icon-button" id="themeBtn" title="Toggle appearance">◐</button><button class="share-btn" id="exportBtn"><span>↥</span> Export</button><button class="add-task" id="newTaskBtn"><span>＋</span> New task</button></div></header>
+  <section class="page-heading"><div><div class="eyebrow"><span class="live-dot"></span> YOUR SPACE <span class="eyebrow-sep">/</span> PERSONAL</div><h1>My board <button class="title-menu" aria-label="Board options">⌄</button></h1><p>Make room for what matters.</p></div><div class="heading-right"><span class="updated" id="updatedLabel">All changes saved</span><div class="face-stack"><span>M</span><span>✦</span></div></div></section>
+  <section class="toolbar"><div class="toolbar-left"><label class="search"><span>⌕</span><input id="searchInput" placeholder="Search tasks..." aria-label="Search tasks"><kbd>⌘ K</kbd></label><button class="filter-button" id="filterBtn"><span>☷</span> Filter <i id="filterDot"></i></button><select class="sort-select" id="sortSelect" aria-label="Sort tasks"><option value="manual">Board order</option><option value="due">Due date</option><option value="priority">Priority</option><option value="created">Recently added</option></select></div><div class="toolbar-right"><span class="view-label">VIEW</span><button class="view-toggle selected" aria-label="Board view">▦</button><button class="view-toggle" id="listViewBtn" aria-label="List view">☰</button></div></section>
+  <div class="filter-popover" id="filterPopover"><b>Filter by priority</b><label><input type="checkbox" value="high"> <i class="priority-dot high"></i> High</label><label><input type="checkbox" value="medium"> <i class="priority-dot medium"></i> Medium</label><label><input type="checkbox" value="low"> <i class="priority-dot low"></i> Low</label><button id="clearFilters">Clear filters</button></div>
+  <section class="board" id="board" aria-label="Kanban board"></section>
+  <footer class="board-footer"><span><span class="footer-star">✳</span> A clear mind starts with a clear board.</span><span id="taskSummary">0 tasks</span></footer>
+</main></div>
+<div class="modal-backdrop" id="modalBackdrop" hidden><section class="task-modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle"><div class="modal-top"><span class="modal-kicker">TASK DETAILS</span><button class="icon-button close-modal" aria-label="Close">×</button></div><h2 id="modalTitle">Create a task</h2><form id="taskForm"><input type="hidden" id="taskId"><label class="field-label" for="taskTitle">Task name</label><input class="text-field title-field" id="taskTitle" placeholder="What needs to get done?" required maxlength="120"><label class="field-label" for="taskDescription">Description <span>OPTIONAL</span></label><textarea class="text-field" id="taskDescription" rows="3" placeholder="Add a few details..."></textarea><div class="field-row"><div><label class="field-label" for="taskStatus">Status</label><select class="text-field" id="taskStatus"></select></div><div><label class="field-label" for="taskPriority">Priority</label><select class="text-field" id="taskPriority"><option value="none">No priority</option><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select></div></div><div class="field-row"><div><label class="field-label" for="taskDue">Due date</label><input class="text-field" type="date" id="taskDue"></div><div><label class="field-label" for="taskTag">Label</label><select class="text-field" id="taskTag"><option value="">No label</option><option>Work</option><option>Personal</option><option>Health</option><option>Learning</option></select></div></div><div class="modal-actions"><button type="button" class="delete-task" id="deleteTask" hidden>Delete task</button><span class="modal-spacer"></span><button type="button" class="cancel-btn close-modal">Cancel</button><button class="save-btn" type="submit">Create task <span>↗</span></button></div></form></section></div>
+<div class="toast" id="toast" role="status"></div><input type="file" id="importFile" accept="application/json" hidden>
+<script src="app.js"></script>
+</body></html>
