--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,36 @@
+(() => {
+const KEY='daymark-board-v1';
+const defaultState={tasks:[
+ {id:'a1',title:'Plan the week ahead',description:'Review priorities and make space for deep work.',status:'To do',priority:'medium',tag:'Personal',due:dateOffset(1),created:Date.now()-800000},
+ {id:'a2',title:'Send proposal to Morgan',description:'Include the updated timeline and budget.',status:'To do',priority:'high',tag:'Work',due:dateOffset(0),created:Date.now()-700000},
+ {id:'a3',title:'Book dentist appointment',description:'Find a slot for next month.',status:'To do',priority:'low',tag:'Health',due:'',created:Date.now()-600000},
+ {id:'a4',title:'Finish homepage wireframes',description:'Get feedback on the first pass before Friday.',status:'In progress',priority:'high',tag:'Work',due:dateOffset(2),created:Date.now()-500000},
+ {id:'a5',title:'Read 20 pages',description:'A small bit of progress every day.',status:'In progress',priority:'none',tag:'Learning',due:'',created:Date.now()-400000},
+ {id:'a6',title:'Morning run',description:'',status:'Done',priority:'low',tag:'Health',due:dateOffset(0),created:Date.now()-300000},
+ {id:'a7',title:'Tidy up project notes',description:'',status:'Done',priority:'none',tag:'Work',due:'',created:Date.now()-200000}
+],statuses:['To do','In progress','Done']};
+function dateOffset(n){const d=new Date();d.setDate(d.getDate()+n);return d.toISOString().slice(0,10)}
+let state;try{state=JSON.parse(localStorage.getItem(KEY))||defaultState}catch{state=defaultState}
+if(!Array.isArray(state.tasks)||!Array.isArray(state.statuses))state=defaultState;
+let search='',sort='manual',filters=[],view='board',activeNav='board',dragId=null;
+const $=s=>document.querySelector(s), board=$('#board'), modal=$('#modalBackdrop'), form=$('#taskForm');
+const esc=s=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+function save(){localStorage.setItem(KEY,JSON.stringify(state));$('#updatedLabel').textContent='All changes saved';$('#navCount').textContent=state.tasks.filter(t=>t.status!=='Done').length}
+function formatDate(str){if(!str)return '';let d=new Date(str+'T12:00:00');return d.toLocaleDateString(undefined,{month:'short',day:'numeric'})}
+function visibleTasks(){let tasks=state.tasks.filter(t=>(!search||(t.title+' '+t.description+' '+t.tag).toLowerCase().includes(search.toLowerCase()))&&(!filters.length||filters.includes(t.priority))&&(activeNav==='archive'?t.status==='Done':activeNav==='today'?t.due&&t.due<=dateOffset(7)&&t.status!=='Done':true));if(sort!=='manual')tasks.sort((a,b)=>sort==='due'?(a.due||'9999').localeCompare(b.due||'9999'):sort==='priority'?['high','medium','low','none'].indexOf(a.priority)-['high','medium','low','none'].indexOf(b.priority):b.created-a.created);return tasks}
+function render(){let tasks=visibleTasks();board.innerHTML=state.statuses.map(status=>{let items=tasks.filter(t=>t.status===status);return `<section class="column" data-status="${esc(status)}"><header class="column-head"><i class="column-dot"></i><span class="column-title">${esc(status)}</span><span class="column-count">${items.length}</span><button class="column-add" data-add="${esc(status)}" aria-label="Add task to ${esc(status)}">＋</button></header><div class="task-list" data-list="${esc(status)}">${items.length?items.map(card).join(''):'<div class="empty-column">Nothing here yet</div>'}</div><button class="column-add-card" data-add="${esc(status)}">＋ Add a task</button></section>`}).join('');
+$('#taskSummary').textContent=`${state.tasks.length} task${state.tasks.length===1?'':'s'} · ${state.tasks.filter(t=>t.status==='Done').length} completed`;$('#navCount').textContent=state.tasks.filter(t=>t.status!=='Done').length;$('#filterDot').style.cssText=filters.length?'width:5px;height:5px;background:#4d8061;border-radius:50%;margin-left:5px':'';document.body.classList.toggle('list-view',view==='list');wireCards()}
+function card(t){let today=dateOffset(0),dueClass=t.due&&t.due<today&&t.status!=='Done'?'overdue':t.due&&t.due<=dateOffset(2)&&t.status!=='Done'?'soon':'';return `<article class="task-card" draggable="true" data-id="${esc(t.id)}"><div class="card-top">${t.tag?`<span class="tag ${esc(t.tag)}">${esc(t.tag)}</span>`:'<span></span>'}<button class="card-menu" data-edit="${esc(t.id)}" aria-label="Task options">•••</button></div><h3>${esc(t.title)}</h3>${t.description?`<p class="task-desc">${esc(t.description)}</p>`:''}<div class="card-bottom">${t.due?`<span class="due ${dueClass}">${dueClass==='overdue'?'! ':''}◷ ${formatDate(t.due)}</span>`:'<span></span>'}${t.priority!=='none'?`<span class="priority"><i class="priority-dot ${esc(t.priority)}"></i>${t.priority[0].toUpperCase()+t.priority.slice(1)}</span>`:''}</div></article>`}
+function wireCards(){document.querySelectorAll('.task-card').forEach(el=>{el.addEventListener('click',e=>{if(!e.target.closest('.card-menu'))openModal(el.dataset.id)});el.addEventListener('dragstart',()=>{dragId=el.dataset.id;el.classList.add('dragging')});el.addEventListener('dragend',()=>el.classList.remove('dragging'))});document.querySelectorAll('.column').forEach(col=>{col.addEventListener('dragover',e=>{e.preventDefault();col.classList.add('drag-over')});col.addEventListener('dragleave',()=>col.classList.remove('drag-over'));col.addEventListener('drop',e=>{e.preventDefault();col.classList.remove('drag-over');let t=state.tasks.find(x=>x.id===dragId);if(t){t.status=col.dataset.status;save();render()}})});document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>openModal('',b.dataset.add));document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=e=>{e.stopPropagation();openModal(b.dataset.edit)})}
+function openModal(id='',status=state.statuses[0]){form.reset();$('#taskId').value=id;$('#taskStatus').innerHTML=state.statuses.map(s=>`<option>${esc(s)}</option>`).join('');let t=state.tasks.find(x=>x.id===id);$('#modalTitle').textContent=t?'Edit task':'Create a task';$('#deleteTask').hidden=!t;$('#taskId').value=t?.id||'';$('#taskTitle').value=t?.title||'';$('#taskDescription').value=t?.description||'';$('#taskStatus').value=t?.status||status;$('#taskPriority').value=t?.priority||'none';$('#taskDue').value=t?.due||'';$('#taskTag').value=t?.tag||'';$('.save-btn').innerHTML=t?'Save changes <span>↗</span>':'Create task <span>↗</span>';modal.hidden=false;setTimeout(()=>$('#taskTitle').focus(),30)}
+function closeModal(){modal.hidden=true}
+form.addEventListener('submit',e=>{e.preventDefault();let id=$('#taskId').value,t=state.tasks.find(x=>x.id===id),data={title:$('#taskTitle').value.trim(),description:$('#taskDescription').value.trim(),status:$('#taskStatus').value,priority:$('#taskPriority').value,due:$('#taskDue').value,tag:$('#taskTag').value};if(!data.title)return;if(t)Object.assign(t,data);else state.tasks.unshift({id:crypto.randomUUID?.()||String(Date.now()),...data,created:Date.now()});save();render();closeModal();toast(t?'Task updated':'Task created')});
+$('#deleteTask').onclick=()=>{let id=$('#taskId').value;if(confirm('Delete this task? This cannot be undone.')){state.tasks=state.tasks.filter(t=>t.id!==id);save();render();closeModal();toast('Task deleted')}};
+document.querySelectorAll('.close-modal').forEach(b=>b.onclick=closeModal);modal.addEventListener('click',e=>{if(e.target===modal)closeModal()});$('#newTaskBtn').onclick=()=>openModal();$('#searchInput').oninput=e=>{search=e.target.value;render()};$('#sortSelect').onchange=e=>{sort=e.target.value;render()};$('#filterBtn').onclick=()=>$('#filterPopover').classList.toggle('open');document.querySelectorAll('#filterPopover input').forEach(i=>i.onchange=()=>{filters=[...document.querySelectorAll('#filterPopover input:checked')].map(x=>x.value);render()});$('#clearFilters').onclick=()=>{filters=[];document.querySelectorAll('#filterPopover input').forEach(i=>i.checked=false);render()};$('#listViewBtn').onclick=()=>{view=view==='list'?'board':'list';render();document.querySelectorAll('.view-toggle').forEach(x=>x.classList.toggle('selected',x.id==='listViewBtn'?view==='list':view==='board'))};
+function setNav(name){activeNav=name;document.querySelectorAll('.nav-item').forEach(x=>x.classList.remove('active'));({board:'#boardNav',today:'#todayNav',archive:'#archiveNav'}[name]&&$( {board:'#boardNav',today:'#todayNav',archive:'#archiveNav'}[name]).classList.add('active'));$('.breadcrumbs b').textContent=name==='today'?'Due soon':name==='archive'?'Completed':'My board';render()}
+$('#boardNav').onclick=()=>setNav('board');$('#todayNav').onclick=()=>setNav('today');$('#archiveNav').onclick=()=>setNav('archive');$('#themeBtn').onclick=()=>{document.body.classList.toggle('dark');localStorage.setItem('daymark-dark',document.body.classList.contains('dark'))};if(localStorage.getItem('daymark-dark')==='true')document.body.classList.add('dark');
+$('#exportBtn').onclick=()=>{let blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='daymark-board.json';a.click();URL.revokeObjectURL(a.href);toast('Board exported')};
+$('#helpBtn').onclick=()=>alert('Keyboard shortcuts\n\n⌘ / Ctrl + K — Search tasks\nN — New task\nEsc — Close dialog');document.addEventListener('keydown',e=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();$('#searchInput').focus()}if(e.key==='Escape'){closeModal();$('#filterPopover').classList.remove('open')}if(e.key.toLowerCase()==='n'&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName)&&modal.hidden)openModal()});
+let toastTimer;function toast(s){let el=$('#toast');el.textContent=s;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2100)}
+render();
+})();
