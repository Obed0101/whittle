diff --git a/board/app.js b/board/app.js
new file mode 100644
index 0000000..6cfdfca
--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,27 @@
+(()=>{'use strict';
+const KEY='daymark-board-v1', statuses=['todo','doing','done'], names={todo:'To do',doing:'In progress',done:'Done'};
+const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
+let tasks=[], view='board', layout='board', search='', priorityFilter='all',labelFilter='all',sortNewest=false,toastTimer;
+const uid=()=>`${Date.now().toString(36)}${Math.random().toString(36).slice(2,7)}`;
+function load(){try{const parsed=JSON.parse(localStorage.getItem(KEY));if(Array.isArray(parsed))tasks=parsed.filter(t=>t&&typeof t.title==='string'&&statuses.includes(t.status)).map(t=>({...t,id:t.id||uid(),priority:['high','medium','low'].includes(t.priority)?t.priority:'medium',label:t.label||'',description:t.description||'',due:t.due||'',created:t.created||Date.now()}));}catch{tasks=[]}}
+function save(){try{localStorage.setItem(KEY,JSON.stringify(tasks));}catch{notify('Could not save. Check browser storage space.')}}
+function notify(msg){const el=$('#toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2300)}
+function dateString(d){if(!d)return'';const dt=new Date(d+'T12:00:00');return dt.toLocaleDateString(undefined,{month:'short',day:'numeric'})}
+function isToday(s){return s===new Date().toISOString().slice(0,10)}
+function filtered(){let arr=tasks.filter(t=>{if(view==='today'&&!isToday(t.due))return false;if(view==='upcoming'&&(!t.due||t.due<new Date().toISOString().slice(0,10)||t.status==='done'))return false;if(view==='done'&&t.status!=='done')return false;if(view==='board'&&t.status==='done'){}if(search&&!`${t.title} ${t.description} ${t.label}`.toLowerCase().includes(search.toLowerCase()))return false;if(priorityFilter!=='all'&&t.priority!==priorityFilter)return false;if(labelFilter!=='all'&&t.label!==labelFilter)return false;return true});return arr.sort((a,b)=>sortNewest?b.created-a.created:(a.due||'9999').localeCompare(b.due||'9999'))}
+function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+function card(t){const today=isToday(t.due),over=t.due&&t.due<new Date().toISOString().slice(0,10)&&t.status!=='done';return `<article class="task-card" draggable="true" data-id="${esc(t.id)}"><div class="card-top"><span class="priority ${t.priority}">${t.priority[0].toUpperCase()+t.priority.slice(1)} priority</span><button class="card-menu" data-edit="${esc(t.id)}" aria-label="Edit ${esc(t.title)}">···</button></div><h3>${esc(t.title)}</h3>${t.description?`<p>${esc(t.description)}</p>`:''}<div class="card-meta">${t.label?`<span class="label-chip">${esc(t.label)}</span>`:''}${t.due?`<span class="due-date ${over?'overdue':today?'today':''}">◷ ${over?'Overdue · ':''}${dateString(t.due)}</span>`:''}<button class="card-check" data-complete="${esc(t.id)}" title="${t.status==='done'?'Mark incomplete':'Mark complete'}">${t.status==='done'?'✓':''}</button></div></article>`}
+function render(){const arr=filtered();$('#todayCount').textContent=tasks.filter(t=>isToday(t.due)&&t.status!=='done').length;let title={board:'My board',today:'Due today',upcoming:'Upcoming',done:'Completed'}[view];$('#crumb').textContent=title;$('#pageTitle').innerHTML=`${title} <span class="title-spark">✳</span>`;$('#pageSubtitle').textContent={board:'A clear mind starts with a clear plan.',today:'A little focus goes a long way.',upcoming:'Keep an eye on what’s coming up.',done:'Look how far you’ve come.'}[view];$('#dateLabel').textContent=new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'}).toUpperCase();$('#taskSummary').textContent=`${tasks.length} task${tasks.length===1?'':'s'} total`;
+const board=$('#boardView');board.innerHTML='';statuses.forEach(status=>{let set=arr.filter(t=>t.status===status);if(view==='done'&&status!=='done'||view!=='done'&&status==='done')return;const col=document.createElement('section');col.className='column';col.dataset.status=status;col.innerHTML=`<div class="column-head"><span class="column-dot"></span><span class="column-title">${names[status]}</span><span class="column-count">${set.length}</span>${status!=='done'?`<button class="column-add" data-add="${status}" aria-label="Add to ${names[status]}">＋</button>`:''}</div><div class="task-stack" data-drop="${status}">${set.length?set.map(card).join(''):`<div class="empty-column">${view==='board'?'Nothing here yet':'No matching tasks'}</div>`}</div>`;board.append(col)});
+const list=$('#listView');list.innerHTML=`<div class="list-header"><span>TASK</span><span>STATUS</span><span>PRIORITY</span><span>DUE DATE</span><span></span></div>`+(arr.length?arr.map(t=>`<div class="list-row" data-row="${esc(t.id)}"><span class="list-title">${esc(t.title)}</span><span class="status-pill ${t.status}">${names[t.status]}</span><span class="list-priority priority ${t.priority}">${t.priority}</span><span class="list-due">${dateString(t.due)||'—'}</span><button class="card-menu" data-edit="${esc(t.id)}" aria-label="Edit task">···</button></div>`).join(''):'<div class="list-empty">No tasks found. Add a task to get started.</div>');$('#boardView').classList.toggle('hidden',layout==='list');list.classList.toggle('hidden',layout!=='list');$('#filterDot').classList.toggle('on',priorityFilter!=='all'||labelFilter!=='all');const labels=[...new Set(tasks.map(t=>t.label).filter(Boolean))];const sel=$('#labelFilter');const old=labelFilter;sel.innerHTML='<option value="all">All labels</option>'+labels.map(x=>`<option value="${esc(x)}">${esc(x)}</option>`).join('');sel.value=labels.includes(old)?old:'all';labelFilter=sel.value;}
+function openModal(task=null,status='todo'){const form=$('#taskForm');form.reset();$('#taskId').value=task?.id||'';$('#taskTitle').value=task?.title||'';$('#taskDescription').value=task?.description||'';$('#taskStatus').value=task?.status||status;$('#taskPriority').value=task?.priority||'medium';$('#taskDue').value=task?.due||'';$('#taskLabel').value=task?.label||'';$('#modalTitle').textContent=task?'Edit task':'Add a task';$('#deleteTask').classList.toggle('hidden',!task);$('#taskModal').classList.remove('hidden');setTimeout(()=>$('#taskTitle').focus(),30)}function closeModal(){$('#taskModal').classList.add('hidden')}
+$('#taskForm').addEventListener('submit',e=>{e.preventDefault();const id=$('#taskId').value,existing=tasks.find(t=>t.id===id);const t={id:id||uid(),title:$('#taskTitle').value.trim(),description:$('#taskDescription').value.trim(),status:$('#taskStatus').value,priority:$('#taskPriority').value,due:$('#taskDue').value,label:$('#taskLabel').value.trim(),created:existing?.created||Date.now()};if(!t.title)return;if(existing)Object.assign(existing,t);else tasks.unshift(t);save();closeModal();render();notify(existing?'Task updated':'Task added')});
+$('#deleteTask').onclick=()=>{const id=$('#taskId').value;if(confirm('Delete this task? This cannot be undone.')){tasks=tasks.filter(t=>t.id!==id);save();closeModal();render();notify('Task deleted')}};
+$('#newTaskBtn').onclick=()=>openModal();$('#closeModal').onclick=closeModal;$('#cancelModal').onclick=closeModal;$('#taskModal').addEventListener('click',e=>{if(e.target===$('#taskModal'))closeModal()});document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal();if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();$('#searchInput').focus()}if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='n'){e.preventDefault();openModal()}});
+document.addEventListener('click',e=>{const edit=e.target.closest('[data-edit]');if(edit){e.stopPropagation();openModal(tasks.find(t=>t.id===edit.dataset.edit));return}const add=e.target.closest('[data-add]');if(add){openModal(null,add.dataset.add);return}const done=e.target.closest('[data-complete]');if(done){const t=tasks.find(x=>x.id===done.dataset.complete);if(t){t.status=t.status==='done'?'todo':'done';save();render();notify(t.status==='done'?'Task completed':'Task reopened')}return}const row=e.target.closest('[data-row]');if(row)openModal(tasks.find(t=>t.id===row.dataset.row))});
+document.addEventListener('dragstart',e=>{const cardEl=e.target.closest('.task-card');if(cardEl){e.dataTransfer.setData('text/plain',cardEl.dataset.id);e.dataTransfer.effectAllowed='move';setTimeout(()=>cardEl.classList.add('dragging'),0)}});document.addEventListener('dragend',e=>e.target.closest('.task-card')?.classList.remove('dragging'));document.addEventListener('dragover',e=>{const drop=e.target.closest('[data-drop]');if(drop){e.preventDefault();drop.classList.add('drag-over')}});document.addEventListener('dragleave',e=>{const drop=e.target.closest('[data-drop]');if(drop&&!drop.contains(e.relatedTarget))drop.classList.remove('drag-over')});document.addEventListener('drop',e=>{const drop=e.target.closest('[data-drop]');if(!drop)return;e.preventDefault();drop.classList.remove('drag-over');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=drop.dataset.drop;save();render()}});
+$$('.nav-item[data-view]').forEach(b=>b.onclick=()=>{$$('.nav-item[data-view]').forEach(x=>x.classList.toggle('active',x===b));view=b.dataset.view;render()});$$('.tab').forEach(b=>b.onclick=()=>{$$('.tab').forEach(x=>x.classList.toggle('active',x===b));layout=b.dataset.layout;render()});$('#searchInput').oninput=e=>{search=e.target.value;render()};$('#filterBtn').onclick=()=>$('#filterPanel').classList.toggle('hidden');$('#priorityFilter').onchange=e=>{priorityFilter=e.target.value;render()};$('#labelFilter').onchange=e=>{labelFilter=e.target.value;render()};$('#clearFilters').onclick=()=>{priorityFilter='all';labelFilter='all';$('#priorityFilter').value='all';render()};$('#sortBtn').onclick=()=>{sortNewest=!sortNewest;render();notify(sortNewest?'Sorted by recently added':'Sorted by due date')};
+function backup(){const blob=new Blob([JSON.stringify({version:1,exported:new Date().toISOString(),tasks},null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`daymark-backup-${new Date().toISOString().slice(0,10)}.json`;a.click();URL.revokeObjectURL(a.href);notify('Board backup downloaded')}
+$('#backupBtn').onclick=backup;$('#workspaceMenu').onclick=()=>{if(confirm('Import a board backup? This replaces tasks currently on this device.'))$('#importFile').click()};$('#importFile').onchange=async e=>{const file=e.target.files[0];if(!file)return;try{const obj=JSON.parse(await file.text()),incoming=Array.isArray(obj)?obj:obj.tasks;if(!Array.isArray(incoming)||incoming.some(t=>!t||typeof t.title!=='string'||!statuses.includes(t.status)))throw Error();if(confirm(`Replace your board with ${incoming.length} imported tasks?`)){tasks=incoming.map(t=>({...t,id:t.id||uid(),created:t.created||Date.now()}));save();render();notify('Board imported')}}catch{notify('Invalid backup file')}e.target.value=''};$('#helpBtn').onclick=()=>alert('Add tasks with the button or ⌘/Ctrl + N. Drag cards between columns, click a card to edit, and use ⌘/Ctrl + K to search. Your board saves in this browser. Back up from the workspace menu.');
+load();render();
+})();
