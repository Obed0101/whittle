+$('#exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`daymark-board-${dateOffset(0)}.json`;a.click();URL.revokeObjectURL(a.href);toast('Board exported')};$('#importBtn').onclick=()=>$('#importFile').click();$('#importFile').onchange=async e=>{try{const parsed=JSON.parse(await e.target.files[0].text());if(!Array.isArray(parsed.columns)||!Array.isArray(parsed.tasks))throw Error();if(!confirm('Replace your current board with this import?'))return;data=parsed;save();render();toast('Board imported')}catch{toast('Could not import that board file')}e.target.value=''};
+$('#helpBtn').onclick=()=>alert('Add tasks with New task or N. Drag cards between columns to update their status. Search and filters help you find work. Your board saves in this browser. Export a JSON backup from the top bar.');$('#mobileMenu').onclick=()=>$('#sidebar').classList.toggle('mobile-open');document.addEventListener('click',e=>{if(!e.target.closest('#filterBtn,#filterPopover'))$('#filterPopover').classList.remove('open')});$('#todayLabel').textContent=new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'}).toUpperCase();render();
+})();
