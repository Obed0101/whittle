new file mode 100644
index 0000000..cbf79e5
--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,45 @@
+(() => {
+'use strict';
+const KEY='daymark-board-v1';
+const defaults={columns:[{id:'todo',name:'To do'},{id:'doing',name:'In progress'},{id:'later',name:'Up next'},{id:'done',name:'Done'}],tasks:[
+{id:'t1',title:'Plan the week ahead',description:'Choose the three things that would make this week feel successful.',status:'todo',priority:'high',due:dateOffset(0),label:'Personal',created:Date.now()-86400000*2},
+{id:'t2',title:'Book annual check-up',description:'Find a time that works and add it to the calendar.',status:'todo',priority:'medium',due:dateOffset(3),label:'Life admin',created:Date.now()-86400000},
+{id:'t3',title:'Finish reading “Four Thousand Weeks”',description:'Pick up where I left off — chapter 6.',status:'todo',priority:'low',due:'',label:'Personal',created:Date.now()-3600000},
+{id:'t4',title:'Tidy up project notes',description:'Collect loose notes and move action items onto the board.',status:'doing',priority:'medium',due:dateOffset(1),label:'Work',created:Date.now()-3600000},
+{id:'t5',title:'Take a proper lunch break',description:'Step away from the desk. No screens.',status:'doing',priority:'none',due:'',label:'Wellbeing',created:Date.now()-7200000},
+{id:'t6',title:'Send the proposal draft',description:'Share with Alex for a quick review before Friday.',status:'later',priority:'high',due:dateOffset(5),label:'Work',created:Date.now()-86400000*3},
+{id:'t7',title:'Set up monthly savings transfer',description:'',status:'later',priority:'low',due:'',label:'Money',created:Date.now()-86400000*4},
+{id:'t8',title:'Clear the kitchen counter',description:'',status:'done',priority:'none',due:'',label:'Home',created:Date.now()-3600000,completed:Date.now()}
+]};
+function dateOffset(n){const d=new Date();d.setDate(d.getDate()+n);return d.toISOString().slice(0,10)}
+const $=s=>document.querySelector(s), esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+let data;try{data=JSON.parse(localStorage.getItem(KEY))||structuredClone(defaults)}catch{data=structuredClone(defaults)}
+if(!Array.isArray(data.columns)||!Array.isArray(data.tasks))data=structuredClone(defaults);
+let view='board',query='',priorityFilter='all',dueFilter='all',sortMode='manual',toastTimer;
+const save=()=>{localStorage.setItem(KEY,JSON.stringify(data));$('.saved-state').innerHTML='<i></i> Saved locally'};
+const toast=s=>{const el=$('#toast');el.textContent=s;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200)};
+const colName=id=>data.columns.find(c=>c.id===id)?.name||'To do';
+function dueText(d){if(!d)return'';const x=new Date(d+'T12:00:00'),today=new Date();today.setHours(0,0,0,0);const delta=Math.round((x-today)/86400000);if(delta===0)return'Today';if(delta===1)return'Tomorrow';return x.toLocaleDateString(undefined,{month:'short',day:'numeric'})}
+function visibleTasks(){return data.tasks.filter(t=>{if(query&&!`${t.title} ${t.description} ${t.label}`.toLowerCase().includes(query))return false;if(priorityFilter!=='all'&&t.priority!==priorityFilter)return false;if(dueFilter!=='all'){let n=t.due?Math.round((new Date(t.due+'T12:00:00')-new Date(new Date().toDateString()))/86400000):null;if(dueFilter==='none'&&t.due)return false;if(dueFilter==='overdue'&&!(n<0&&t.status!=='done'))return false;if(dueFilter==='today'&&n!==0)return false;if(dueFilter==='week'&&!(n>=0&&n<=7))return false}return true})}
+function render(){renderNav();const tasks=visibleTasks();$('#taskSummary').textContent=`${tasks.length} task${tasks.length===1?'':'s'}`;const week=Date.now()-7*86400000;$('#progressSummary').textContent=`${data.tasks.filter(t=>t.status==='done'&&t.completed>week).length} completed this week`;
+$('#filterCount').textContent=(priorityFilter!=='all'||dueFilter!=='all')?'•':'';
+$('#boardView').classList.toggle('hidden',view!=='board');$('#listView').classList.toggle('hidden',view!=='list');
+$('#boardView').innerHTML=data.columns.map(c=>{let cards=tasks.filter(t=>t.status===c.id);if(sortMode==='due')cards.sort((a,b)=>(a.due||'9999').localeCompare(b.due||'9999'));if(sortMode==='priority')cards.sort((a,b)=>['high','medium','low','none'].indexOf(a.priority)-['high','medium','low','none'].indexOf(b.priority));if(sortMode==='created')cards.sort((a,b)=>b.created-a.created);return `<section class="board-column" data-column="${esc(c.id)}"><div class="column-head"><i class="column-color"></i><span class="column-title">${esc(c.name)}</span><span class="task-count">${cards.length}</span><button class="column-more" data-columns title="Manage columns">···</button></div><div class="task-list" data-drop="${esc(c.id)}">${cards.length?cards.map(cardHTML).join(''):`<div class="empty-column">Nothing here yet</div>`}</div><button class="add-task-inline" data-add="${esc(c.id)}">＋ Add a task</button></section>`}).join('');
+$('#listView').innerHTML=`<div class="list-row list-header"><span></span><span>TASK</span><span>STATUS</span><span>PRIORITY</span><span>DUE DATE</span><span></span></div>`+(tasks.length?tasks.map(t=>`<div class="list-row"><input class="list-check" type="checkbox" data-done="${esc(t.id)}" ${t.status==='done'?'checked':''} aria-label="Mark ${esc(t.title)} complete"><span class="list-title" data-edit="${esc(t.id)}">${esc(t.title)}</span><span class="list-status">${esc(colName(t.status))}</span><span class="priority priority-${esc(t.priority)}">${priorityIcon(t.priority)} ${t.priority==='none'?'—':esc(t.priority)}</span><span class="${t.due&&t.due<dateOffset(0)&&t.status!=='done'?'due-date overdue':'due-date'}">${t.due?dueText(t.due):'—'}</span><button class="icon-button tiny" data-edit="${esc(t.id)}" aria-label="Edit">···</button></div>`).join(''):`<div class="empty-column">No tasks match. Try changing your search or filters.</div>`);
+}
+function priorityIcon(p){return p==='high'?'↑':p==='medium'?'→':p==='low'?'↓':''}
+function cardHTML(t){const due=t.due?dueText(t.due):'',late=t.due&&t.due<dateOffset(0)&&t.status!=='done',today=t.due===dateOffset(0);return `<article class="task-card" draggable="true" data-task="${esc(t.id)}"><button class="card-edit" data-edit="${esc(t.id)}" aria-label="Edit task">···</button>${t.label?`<span class="card-label">${esc(t.label)}</span>`:''}<div class="card-title">${esc(t.title)}</div>${t.description?`<div class="card-desc">${esc(t.description)}</div>`:''}<div class="card-meta">${t.priority!=='none'?`<span class="priority priority-${esc(t.priority)}"><i>${priorityIcon(t.priority)}</i>${esc(t.priority)}</span>`:''}${due?`<span class="due-date ${late?'overdue':today?'due-today':''}">${late?'! ':''}${esc(due)}</span>`:''}</div></article>`}
