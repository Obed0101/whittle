+function openTask(id='',status=''){const t=data.tasks.find(x=>x.id===id);$('#taskForm').reset();$('#taskId').value=t?.id||'';$('#modalTitle').textContent=t?'Edit task':'Create a task';$('#taskTitle').value=t?.title||'';$('#taskDescription').value=t?.description||'';$('#taskStatus').value=t?.status||status||data.columns[0].id;$('#taskPriority').value=t?.priority||'none';$('#taskDue').value=t?.due||'';$('#taskLabel').value=t?.label||'';$('#deleteTask').classList.toggle('hidden',!t);showModal('#taskModal');setTimeout(()=>$('#taskTitle').focus(),80)}
+function showModal(s){$(s).classList.add('open');$(s).setAttribute('aria-hidden','false')};function closeModals(){$$('.modal-backdrop').forEach(m=>{m.classList.remove('open');m.setAttribute('aria-hidden','true')})}function $$(s){return [...document.querySelectorAll(s)]}
+$('#newTask').onclick=()=>openTask();$('#boardView').addEventListener('click',e=>{const add=e.target.closest('[data-add]'),edit=e.target.closest('[data-edit]');if(add)openTask('',add.dataset.add);if(edit)openTask(edit.dataset.edit);if(e.target.closest('[data-columns]'))manageColumns()});$('#listView').addEventListener('click',e=>{const edit=e.target.closest('[data-edit]');if(edit)openTask(edit.dataset.edit)});
+$('#taskForm').addEventListener('submit',e=>{e.preventDefault();let id=$('#taskId').value,t=data.tasks.find(x=>x.id===id),status=$('#taskStatus').value;const item={id:id||crypto.randomUUID(),title:$('#taskTitle').value.trim(),description:$('#taskDescription').value.trim(),status,priority:$('#taskPriority').value,due:$('#taskDue').value,label:$('#taskLabel').value.trim(),created:t?.created||Date.now(),completed:status==='done'?(t?.completed||Date.now()):null};if(t)Object.assign(t,item);else data.tasks.unshift(item);save();closeModals();render();toast(t?'Task updated':'Task created')});$('#deleteTask').onclick=()=>{const id=$('#taskId').value;if(confirm('Delete this task? This cannot be undone.')){data.tasks=data.tasks.filter(t=>t.id!==id);save();closeModals();render();toast('Task deleted')}};
+$('#boardView').addEventListener('dragstart',e=>{const card=e.target.closest('.task-card');if(card){e.dataTransfer.setData('text/plain',card.dataset.task);e.dataTransfer.effectAllowed='move';setTimeout(()=>card.classList.add('dragging'),0)}});$('#boardView').addEventListener('dragend',e=>{const c=e.target.closest('.task-card');if(c)c.classList.remove('dragging');$$('.drop-active').forEach(x=>x.classList.remove('drop-active'))});$('#boardView').addEventListener('dragover',e=>{const target=e.target.closest('[data-drop]');if(target){e.preventDefault();target.closest('.board-column').classList.add('drop-active')}});$('#boardView').addEventListener('dragleave',e=>{const col=e.target.closest('.board-column');if(col&&!col.contains(e.relatedTarget))col.classList.remove('drop-active')});$('#boardView').addEventListener('drop',e=>{const target=e.target.closest('[data-drop]');if(!target)return;e.preventDefault();const t=data.tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=target.dataset.drop;if(t.status==='done')t.completed=Date.now();else t.completed=null;save();render()}});
+$('#search').oninput=e=>{query=e.target.value.trim().toLowerCase();render()};$('#priorityFilter').onchange=e=>{priorityFilter=e.target.value;render()};$('#dueFilter').onchange=e=>{dueFilter=e.target.value;render()};$('#filterBtn').onclick=()=>$('#filterPopover').classList.toggle('open');$('#clearFilters').onclick=()=>{$('#priorityFilter').value='all';$('#dueFilter').value='all';priorityFilter=dueFilter='all';render()};$('#sortSelect').onchange=e=>{sortMode=e.target.value;render()};$$('.view-btn').forEach(b=>b.onclick=()=>{$$('.view-btn').forEach(x=>x.classList.toggle('selected',x===b));view=b.dataset.view;render()});
+$('#listView').addEventListener('change',e=>{if(e.target.matches('[data-done]')){const t=data.tasks.find(x=>x.id===e.target.dataset.done);if(t){t.status=e.target.checked?'done':data.columns[0].id;t.completed=e.target.checked?Date.now():null;save();render()}}});$('#clearCompleted').onclick=()=>{const n=data.tasks.filter(t=>t.status==='done').length;if(n&&confirm(`Delete all ${n} completed task${n===1?'':'s'}? This cannot be undone.`)){data.tasks=data.tasks.filter(t=>t.status!=='done');save();render();toast('Completed tasks cleared')}};
+$('#addColumn').onclick=()=>manageColumns();$('#boardMenu').onclick=()=>manageColumns();function manageColumns(){renderColumnManager();showModal('#columnsModal')}
+function renderColumnManager(){$('#columnManager').innerHTML=data.columns.map(c=>`<div class="manage-column"><i class="column-color"></i><input class="text-input" value="${esc(c.name)}" maxlength="24" data-rename="${esc(c.id)}"><button data-remove="${esc(c.id)}" title="Remove column" aria-label="Remove ${esc(c.name)}">×</button></div>`).join('');$('#columnManager').querySelectorAll('[data-rename]').forEach(i=>i.onchange=()=>{data.columns.find(c=>c.id===i.dataset.rename).name=i.value.trim()||'Untitled';save();render();renderColumnManager()});$('#columnManager').querySelectorAll('[data-remove]').forEach(b=>b.onclick=()=>{if(data.columns.length<=1){toast('Keep at least one column');return}const id=b.dataset.remove,name=colName(id);if(!confirm(`Remove “${name}”? Tasks move to “${data.columns.find(c=>c.id!==id).name}”.`))return;let next=data.columns.find(c=>c.id!==id).id;data.tasks.forEach(t=>{if(t.status===id)t.status=next});data.columns=data.columns.filter(c=>c.id!==id);save();render();renderColumnManager()})}
