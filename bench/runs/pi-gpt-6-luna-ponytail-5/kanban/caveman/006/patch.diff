+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f5f6f8">
+<title>Daymark — Personal Kanban</title><link rel="stylesheet" href="styles.css">
+</head>
+<body>
+<div class="app-shell">
+<aside class="sidebar" id="sidebar">
+  <a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d</span><span>daymark</span></a>
+  <div class="workspace-label">WORKSPACE</div><button class="workspace"><span class="avatar">Y</span><span class="workspace-copy"><strong>My workspace</strong><small>Personal board</small></span><span class="chevron">⌄</span></button>
+  <nav class="nav" aria-label="Main navigation"><a class="nav-link active" href="#board"><span class="nav-icon">▦</span>My board</a><a class="nav-link" href="#focus" id="focusNav"><span class="nav-icon">◷</span>Focus today</a></nav>
+  <div class="side-section"><div class="section-head"><span>YOUR BOARD</span><button class="icon-button tiny" id="addColumn" title="Add column" aria-label="Add column">＋</button></div><div id="columnNav"></div></div>
+  <div class="sidebar-bottom"><div class="tip-card"><span class="tip-icon">✳</span><strong>Make room for what matters.</strong><p>A little progress, every day.</p></div><button class="help-link" id="helpBtn"><span>ⓘ</span> How it works</button></div>
+</aside>
+<main class="main" id="board">
+  <header class="topbar"><button class="mobile-menu icon-button" id="mobileMenu" aria-label="Open menu">☰</button><div class="breadcrumb">My workspace <span>/</span> <strong>My board</strong></div><div class="top-actions"><span class="saved-state"><i></i> Saved locally</span><button class="icon-button" id="exportBtn" title="Export board" aria-label="Export board">↥</button><button class="icon-button" id="importBtn" title="Import board" aria-label="Import board">↧</button><input type="file" id="importFile" accept="application/json" hidden><button class="avatar user-avatar" title="Your profile">Y</button></div></header>
+  <section class="content">
+    <div class="page-heading"><div><div class="eyebrow" id="todayLabel">YOUR PERSONAL SPACE</div><h1>My board <button class="title-menu icon-button tiny" id="boardMenu" aria-label="Board options">···</button></h1><p class="subtitle">Keep your priorities clear and your momentum going.</p></div><button class="primary-button" id="newTask"><span>＋</span> New task</button></div>
+    <div class="toolbar"><div class="view-switch"><button class="view-btn selected" data-view="board">▦ <span>Board</span></button><button class="view-btn" data-view="list">☷ <span>List</span></button></div><div class="toolbar-right"><label class="search"><span>⌕</span><input id="search" type="search" placeholder="Search tasks…" aria-label="Search tasks"><kbd>/</kbd></label><button class="filter-button" id="filterBtn">☷ <span>Filter</span><b id="filterCount" class="filter-count"></b></button><div class="filter-popover" id="filterPopover"><strong>Filter tasks</strong><label>Priority<select id="priorityFilter"><option value="all">All priorities</option><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select></label><label>Due date<select id="dueFilter"><option value="all">Any date</option><option value="overdue">Overdue</option><option value="today">Due today</option><option value="week">Next 7 days</option><option value="none">No due date</option></select></label><button id="clearFilters" class="text-button">Clear filters</button></div><button class="sort-button" id="sortBtn">↕ <span>Sort</span><select id="sortSelect" aria-label="Sort tasks"><option value="manual">Manual</option><option value="due">Due date</option><option value="priority">Priority</option><option value="created">Recently added</option></select></button></div></div>
+    <div class="board-summary"><span id="taskSummary">0 tasks</span><span class="summary-dot">·</span><span id="progressSummary">0 completed this week</span><button id="clearCompleted" class="text-button">Clear completed</button></div>
+    <div class="board" id="boardView" aria-label="Kanban board"></div><div class="list-view hidden" id="listView"></div>
+    <footer class="board-footer"><span>Small steps add up.</span><span><kbd>N</kbd> new task <span class="footer-sep">·</span> <kbd>/</kbd> search</span></footer>
+  </section>
+</main>
+</div>
