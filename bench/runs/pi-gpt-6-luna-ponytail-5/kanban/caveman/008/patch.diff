+(() => {
+  const KEY = 'daymark-board-v1';
+  const columns = [{id:'todo',name:'To do'},{id:'doing',name:'In progress'},{id:'done',name:'Completed'}];
+  const samples = [
+    {id:'s1',title:'Plan the week ahead',description:'Review priorities and make room for focused work.',status:'todo',date:'',created:1},
+    {id:'s2',title:'Book dentist appointment',description:'Call the clinic and check available times.',status:'todo',date:'',created:2},
+    {id:'s3',title:'Read 20 pages',description:'Pick up where I left off in the evening.',status:'todo',date:'',created:3},
+    {id:'s4',title:'Send project update',description:'Share the latest milestones with the team.',status:'doing',date:'',created:4},
+    {id:'s5',title:'Tidy up the workspace',description:'Clear the desk and file loose notes.',status:'doing',date:'',created:5},
+    {id:'s6',title:'Morning walk',description:'A little fresh air before the day gets busy.',status:'done',date:'',created:6}
+  ];
+  let tasks = load(), filter = 'all', query = '', sortDue = false, editing = null, toastTimer;
+  const $ = s => document.querySelector(s), board = $('#board'), dialog = $('#taskDialog');
+  function load(){try{const value=JSON.parse(localStorage.getItem(KEY));return Array.isArray(value)?value:samples.map(x=>({...x}));}catch{return samples.map(x=>({...x}));}}
+  function save(){localStorage.setItem(KEY,JSON.stringify(tasks));}
+  function escape(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
+  function dateLabel(){const d=new Date();$('#dateLabel').textContent=new Intl.DateTimeFormat('en',{weekday:'long',month:'long',day:'numeric'}).format(d).toUpperCase();}
+  function dueInfo(date){if(!date)return '';const d=new Date(date+'T00:00:00'),now=new Date();now.setHours(0,0,0,0);const diff=Math.round((d-now)/86400000);let text=diff<0?`Overdue · ${new Intl.DateTimeFormat('en',{month:'short',day:'numeric'}).format(d)}`:diff===0?'Today':diff===1?'Tomorrow':new Intl.DateTimeFormat('en',{month:'short',day:'numeric'}).format(d);return `<span class="due ${diff<0?'overdue':diff===0?'today':''}"><span class="due-icon">◷</span>${text}</span>`;}
+  function render(){
+    const visible=tasks.filter(t=>(filter==='all'||filter==='active'&&t.status!=='done'||filter==='done'&&t.status==='done')&&(!query||(t.title+' '+t.description).toLowerCase().includes(query)));
+    board.innerHTML=columns.map(col=>{let items=visible.filter(t=>t.status===col.id);if(sortDue)items.sort((a,b)=>(a.date||'9999').localeCompare(b.date||'9999'));return `<section class="column" data-status="${col.id}"><div class="column-head"><div class="column-name"><span class="column-dot"></span>${col.name}<span class="column-count">${items.length}</span></div><button class="add-inline" data-add="${col.id}" aria-label="Add to ${col.name}">+</button></div><div class="task-list" data-drop="${col.id}">${items.length?items.map(t=>`<article class="task-card" draggable="true" data-id="${escape(t.id)}"><div class="card-top"><input class="check" type="checkbox" ${t.status==='done'?'checked':''} aria-label="Mark ${escape(t.title)} ${t.status==='done'?'incomplete':'complete'}"><div class="task-title">${escape(t.title)}</div><button class="card-menu" aria-label="Task options">···</button></div>${t.description?`<div class="task-description">${escape(t.description)}</div>`:''}<div class="card-meta">${dueInfo(t.date)}</div></article>`).join(''):`<div class="empty"><strong>${query?'No matching tasks':emptyTitle(col.id)}</strong>${query?'Try another search':emptyHint(col.id)}</div>`}</div></section>`}).join('');
+    const open=tasks.filter(t=>t.status!=='done').length;$('#totalCount').textContent=open;$('#allNum').textContent=tasks.length;$('#summary').textContent=`${open} active · ${tasks.filter(t=>t.status==='done').length} completed`;bindCards();
+  }
+  function emptyTitle(id){return id==='todo'?'Nothing on your list yet':id==='doing'?'No tasks in progress':'A clean slate';}
+  function emptyHint(id){return id==='todo'?'Add a task to get started.':id==='doing'?'Move a task here when you begin.':'Finished tasks will show up here.';}
+  function bindCards(){document.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>openNew(b.dataset.add));document.querySelectorAll('.check').forEach(b=>b.onchange=()=>{const t=tasks.find(x=>x.id===b.closest('.task-card').dataset.id);t.status=b.checked?'done':'todo';save();render();});document.querySelectorAll('.card-menu').forEach(b=>b.onclick=()=>{const card=b.closest('.task-card'),t=tasks.find(x=>x.id===card.dataset.id);openEdit(t);});document.querySelectorAll('.task-card').forEach(card=>{card.ondblclick=()=>openEdit(tasks.find(t=>t.id===card.dataset.id));card.ondragstart=e=>{e.dataTransfer.setData('text/plain',card.dataset.id);e.dataTransfer.effectAllowed='move';card.classList.add('dragging');};card.ondragend=()=>card.classList.remove('dragging');});document.querySelectorAll('.task-list').forEach(list=>{list.ondragover=e=>{e.preventDefault();list.classList.add('drag-over');};list.ondragleave=()=>list.classList.remove('drag-over');list.ondrop=e=>{e.preventDefault();list.classList.remove('drag-over');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=list.dataset.drop;save();render();}};});}
+  function openNew(status='todo'){editing=null;$('#taskForm').reset();$('#taskStatus').value=status;$('#modalEyebrow').textContent='NEW TASK';$('#modalTitle').textContent='Add a task';$('#saveTask').textContent='Add task';dialog.showModal();setTimeout(()=>$('#taskTitle').focus(),50);}
+  function openEdit(t){if(!t)return;editing=t.id;$('#taskForm').reset();$('#taskTitle').value=t.title;$('#taskDescription').value=t.description||'';$('#taskStatus').value=t.status;$('#taskDate').value=t.date||'';$('#modalEyebrow').textContent='EDIT TASK';$('#modalTitle').textContent='Edit task';$('#saveTask').textContent='Save changes';dialog.showModal();setTimeout(()=>$('#taskTitle').focus(),50);}
+  $('#taskForm').onsubmit=e=>{e.preventDefault();const item={title:$('#taskTitle').value.trim(),description:$('#taskDescription').value.trim(),status:$('#taskStatus').value,date:$('#taskDate').value};if(!item.title)return;if(editing){Object.assign(tasks.find(t=>t.id===editing),item);notify('Task updated');}else{tasks.unshift({id:crypto.randomUUID?crypto.randomUUID():String(Date.now()),...item,created:Date.now()});notify('Task added to your board');}save();dialog.close();render();};
+  $('#newTask').onclick=()=>openNew();$('#closeDialog').onclick=$('#cancelDialog').onclick=()=>dialog.close();dialog.onclick=e=>{if(e.target===dialog)dialog.close();};$('#search').oninput=e=>{query=e.target.value.trim().toLowerCase();render();};document.querySelectorAll('.filter').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelectorAll('.filter').forEach(x=>x.classList.toggle('active',x===b));render();});$('#sortBtn').onclick=()=>{sortDue=!sortDue;render();notify(sortDue?'Sorted by due date':'Default task order');};$('#clearDone').onclick=()=>{const count=tasks.filter(t=>t.status==='done').length;if(!count){notify('No completed tasks to clear');return;}if(confirm(`Delete ${count} completed ${count===1?'task':'tasks'}? This cannot be undone.`)){tasks=tasks.filter(t=>t.status!=='done');save();render();notify('Completed tasks cleared');}};
+  $('#todayNav').onclick=()=>{filter='all';query=new Date().toISOString().slice(0,10);$('#search').value='';query='';render();document.querySelectorAll('.filter').forEach(x=>x.classList.toggle('active',x.dataset.filter==='all'));const today=new Date().toISOString().slice(0,10);document.querySelectorAll('.task-card').forEach(c=>{const t=tasks.find(x=>x.id===c.dataset.id);c.hidden=!(t.date===today&&t.status!=='done');});notify('Showing tasks due today');};$('#upcomingNav').onclick=()=>{const today=new Date().toISOString().slice(0,10);filter='all';query='';$('#search').value='';render();document.querySelectorAll('.task-card').forEach(c=>{const t=tasks.find(x=>x.id===c.dataset.id);c.hidden=!(t.date>today&&t.status!=='done');});notify('Showing upcoming tasks');};$('#boardNav').onclick=()=>{query='';$('#search').value='';filter='all';document.querySelectorAll('.filter').forEach(x=>x.classList.toggle('active',x.dataset.filter==='all'));render();};$('#exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify(tasks,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='daymark-tasks.json';a.click();URL.revokeObjectURL(url);notify('Tasks exported');};$('#helpBtn').onclick=()=>alert('Shortcuts\n\n⌘/Ctrl + K — Search tasks\nN — Add a task\nDouble-click a task — Edit');document.addEventListener('keydown',e=>{if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();$('#search').focus();}if(e.key.toLowerCase()==='n'&&!dialog.open&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName)){e.preventDefault();openNew();}if(e.key==='Escape'&&dialog.open)dialog.close();});function notify(text){const el=$('#toast');el.textContent=text;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200);}dateLabel();render();
+})();
