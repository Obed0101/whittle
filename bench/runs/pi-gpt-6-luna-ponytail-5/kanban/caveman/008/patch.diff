+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="theme-color" content="#f6f7f5">
+  <title>Daymark — Personal Kanban</title>
+  <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+  <div class="app-shell">
+    <aside class="sidebar">
+      <a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d</span><span>daymark</span></a>
+      <div class="workspace"><div class="avatar">A</div><div><strong>Alex Morgan</strong><small>Personal workspace</small></div><span class="chevron">⌄</span></div>
+      <div class="nav-label">WORKSPACE</div>
+      <button class="nav-item active" id="boardNav"><span class="nav-icon">▦</span>My board <span class="nav-count" id="totalCount">0</span></button>
+      <button class="nav-item" id="todayNav"><span class="nav-icon">◷</span>Due today</button>
+      <button class="nav-item" id="upcomingNav"><span class="nav-icon">▤</span>Upcoming</button>
+      <div class="side-bottom"><div class="tip-icon">✦</div><strong>Make space for focus</strong><p>A little progress, every day, adds up.</p><button class="text-button" id="clearDone">Clear completed tasks <span>→</span></button><div class="profile"><div class="avatar">A</div><div><strong>Alex Morgan</strong><small>Free plan</small></div><button class="dots" aria-label="More options">···</button></div></div>
+    </aside>
+    <main class="main">
+      <header class="topbar"><div class="breadcrumb">Workspace <span>/</span> <strong>My board</strong></div><div class="top-actions"><label class="search"><span>⌕</span><input id="search" placeholder="Search tasks..." aria-label="Search tasks"><kbd>⌘ K</kbd></label><button class="icon-button" id="helpBtn" title="Keyboard shortcuts">?</button><div class="top-avatar">A</div></div></header>
+      <section class="board-wrap">
+        <div class="heading-row"><div><div class="eyebrow" id="dateLabel"></div><h1>My board <span class="private">⌑ Private</span></h1><p class="subtitle">A clear mind starts with a clear plan.</p></div><button class="primary-button" id="newTask"><span>＋</span> New task</button></div>
+        <div class="toolbar"><div class="filters" role="group" aria-label="Filter tasks"><button class="filter active" data-filter="all">All tasks <span id="allNum">0</span></button><button class="filter" data-filter="active">In progress</button><button class="filter" data-filter="done">Completed</button></div><div class="view-tools"><span class="board-summary" id="summary"></span><button class="icon-button" id="sortBtn" title="Sort by due date">↕</button><button class="icon-button view-toggle" title="Board view">▦</button></div></div>
+        <div class="board" id="board"></div>
+        <footer class="board-footer"><span><span class="online-dot"></span> Your board is saved on this device</span><button id="exportBtn">Export tasks <span>↗</span></button></footer>
+      </section>
+    </main>
+  </div>
+  <dialog id="taskDialog"><form id="taskForm"><div class="modal-head"><div><span class="modal-eyebrow" id="modalEyebrow">NEW TASK</span><h2 id="modalTitle">Add a task</h2></div><button type="button" class="close" id="closeDialog" aria-label="Close">×</button></div><label class="field-label" for="taskTitle">Task name</label><input id="taskTitle" name="title" placeholder="What needs to get done?" maxlength="120" required autofocus><label class="field-label" for="taskDescription">Notes <span>OPTIONAL</span></label><textarea id="taskDescription" name="description" placeholder="Add a little context..." rows="3" maxlength="500"></textarea><div class="field-row"><div><label class="field-label" for="taskStatus">Column</label><select id="taskStatus" name="status"><option value="todo">To do</option><option value="doing">In progress</option><option value="done">Completed</option></select></div><div><label class="field-label" for="taskDate">Due date <span>OPTIONAL</span></label><input id="taskDate" type="date" name="date"></div></div><div class="modal-actions"><button type="button" class="cancel-button" id="cancelDialog">Cancel</button><button class="primary-button" id="saveTask">Add task</button></div></form></dialog>
+  <div class="toast" id="toast" role="status"></div>
+  <script src="app.js"></script>
+</body>
+</html>
