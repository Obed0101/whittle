diff --git a/board/app.js b/board/app.js
new file mode 100644
index 0000000..3712689
--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,43 @@
+(() => {
+  const KEY='daymark-board-v1';
+  const defaults=[
+    {id:'sample-1',title:'Sketch out the week',description:'Pick three things that would make this week feel meaningful.',status:'todo',priority:'medium',due:'',created:Date.now()-300000},
+    {id:'sample-2',title:'Get outside for a walk',description:'A little fresh air between calls.',status:'todo',priority:'low',due:'',created:Date.now()-200000},
+    {id:'sample-3',title:'Send project update',description:'Share the latest progress and next steps.',status:'progress',priority:'high',due:'',created:Date.now()-100000},
+    {id:'sample-4',title:'Clear the desk',description:'',status:'done',priority:'none',due:'',created:Date.now()}
+  ];
+  let tasks; try { tasks=JSON.parse(localStorage.getItem(KEY)); if(!Array.isArray(tasks)) tasks=null; } catch { tasks=null; }
+  if(!tasks){tasks=defaults;save();}
+  let filterToday=false, query='', sort='manual', toastTimer;
+  const $=s=>document.querySelector(s), board=$('#board'), modal=$('#modal');
+  const statuses=[['todo','To do','todo'],['progress','In progress','progress'],['done','Done','done']];
+  const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+  function save(){localStorage.setItem(KEY,JSON.stringify(tasks));}
+  function notify(msg){const t=$('#toast');t.textContent=msg;t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),2200);}
+  const today=()=>new Date().toISOString().slice(0,10);
+  function render(){
+    const visible=tasks.filter(t=>(!filterToday||t.due===today())&&(!query||`${t.title} ${t.description}`.toLowerCase().includes(query)));
+    const counts={todo:tasks.filter(t=>t.status==='todo').length,progress:tasks.filter(t=>t.status==='progress').length,done:tasks.filter(t=>t.status==='done').length};
+    $('#total-count').textContent=tasks.length;$('#count-todo').textContent=counts.todo;$('#count-progress').textContent=counts.progress;$('#count-done').textContent=counts.done;
+    $('#stat-open').textContent=counts.todo+counts.progress;$('#stat-progress').textContent=counts.progress;$('#stat-done').textContent=counts.done;$('#visible-count').textContent=`${visible.length} ${visible.length===1?'task':'tasks'}`;
+    board.innerHTML=statuses.map(([key,label,dot])=>{let list=visible.filter(t=>t.status===key);if(sort==='due')list.sort((a,b)=>(a.due||'9999').localeCompare(b.due||'9999'));if(sort==='priority'){const p={high:0,medium:1,low:2,none:3};list.sort((a,b)=>p[a.priority]-p[b.priority]);}if(sort==='created')list.sort((a,b)=>b.created-a.created);
+      return `<section class="column" data-status="${key}"><header class="column-head"><i class="flow-dot dot-${dot}"></i><h3>${label}</h3><span class="col-count">${list.length}</span><button class="column-add" data-status="${key}" title="Add task">＋</button></header><div class="task-list">${list.length?list.map(card).join(''):`<div class="empty-column">${query?'No matching tasks':'Nothing here yet'}</div>`}</div><button class="add-column-task" data-status="${key}">＋ Add a task</button></section>`;
+    }).join('');
+  }
+  function card(t){let due='';if(t.due){const d=new Date(t.due+'T00:00:00'),delta=Math.round((d-new Date(new Date().toDateString()))/86400000);due=d.toLocaleDateString(undefined,{month:'short',day:'numeric'});let cls=delta<0&&t.status!=='done'?' overdue':delta<=2&&delta>=0&&t.status!=='done'?' soon':'';due=`<span class="due${cls}">◷ ${esc(due)}${delta<0&&t.status!=='done'?' · overdue':''}</span>`;}
+    const pr=t.priority&&t.priority!=='none'?`<span class="priority priority-${esc(t.priority)}">${esc(t.priority[0].toUpperCase()+t.priority.slice(1))}</span>`:'';
+    return `<article class="task-card ${t.status==='done'?'done-card':''}" draggable="true" data-id="${esc(t.id)}"><div class="task-top"><p class="task-title">${esc(t.title)}</p><button class="task-menu" data-edit="${esc(t.id)}" aria-label="Edit task">···</button></div>${t.description?`<p class="task-desc">${esc(t.description)}</p>`:''}<div class="task-meta">${pr}${due}<span class="card-spacer"></span><button class="check-task" data-toggle="${esc(t.id)}" aria-label="${t.status==='done'?'Mark not done':'Mark done'}">✓</button></div></article>`;
+  }
+  function openTask(task=null,status='todo'){const f=$('#task-form');f.reset();$('#task-id').value=task?.id||'';$('#task-title').value=task?.title||'';$('#task-description').value=task?.description||'';$('#task-status').value=task?.status||status;$('#task-priority').value=task?.priority||'none';$('#task-due').value=task?.due||'';$('#modal-title').textContent=task?'Edit task':'Add a task';$('#delete-task').hidden=!task;modal.hidden=false;setTimeout(()=>$('#task-title').focus(),30);}
+  function close(){modal.hidden=true;}
+  $('#task-form').addEventListener('submit',e=>{e.preventDefault();const id=$('#task-id').value, data={title:$('#task-title').value.trim(),description:$('#task-description').value.trim(),status:$('#task-status').value,priority:$('#task-priority').value,due:$('#task-due').value};if(!data.title)return;if(id){Object.assign(tasks.find(t=>t.id===id),data);}else tasks.unshift({id:crypto.randomUUID?crypto.randomUUID():String(Date.now()),...data,created:Date.now()});save();render();close();notify(id?'Task updated':'Task added');});
+  $('#add-task').onclick=()=>openTask();document.querySelectorAll('.close-modal').forEach(b=>b.onclick=close);modal.addEventListener('click',e=>{if(e.target===modal)close();});
+  $('#delete-task').onclick=()=>{const id=$('#task-id').value;if(confirm('Delete this task? This cannot be undone.')){tasks=tasks.filter(t=>t.id!==id);save();render();close();notify('Task deleted');}};
+  board.addEventListener('click',e=>{const edit=e.target.closest('[data-edit]');if(edit){openTask(tasks.find(t=>t.id===edit.dataset.edit));return;}const toggle=e.target.closest('[data-toggle]');if(toggle){const t=tasks.find(x=>x.id===toggle.dataset.toggle);t.status=t.status==='done'?'todo':'done';save();render();return;}const add=e.target.closest('[data-status]');if(add)openTask(null,add.dataset.status);});
+  board.addEventListener('dragstart',e=>{const c=e.target.closest('.task-card');if(!c)return;e.dataTransfer.setData('text/plain',c.dataset.id);e.dataTransfer.effectAllowed='move';c.classList.add('dragging');});board.addEventListener('dragend',e=>e.target.closest('.task-card')?.classList.remove('dragging'));board.addEventListener('dragover',e=>{const col=e.target.closest('.column');if(col){e.preventDefault();col.classList.add('drag-over');}});board.addEventListener('dragleave',e=>{const col=e.target.closest('.column');if(col&&!col.contains(e.relatedTarget))col.classList.remove('drag-over');});board.addEventListener('drop',e=>{const col=e.target.closest('.column');if(!col)return;e.preventDefault();col.classList.remove('drag-over');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=col.dataset.status;save();render();}});
+  $('#search').oninput=e=>{query=e.target.value.trim().toLowerCase();render();};$('#sort-select').onchange=e=>{sort=e.target.value;render();};$('#today-filter').onclick=()=>{filterToday=!filterToday;$('#today-filter').classList.toggle('active',filterToday);render();};
+  $('#export-btn').onclick=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(tasks,null,2)],{type:'application/json'}));a.download=`daymark-board-${today()}.json`;a.click();URL.revokeObjectURL(a.href);notify('Board exported');};$('#import-btn').onclick=()=>$('#import-file').click();$('#import-file').onchange=async e=>{try{const data=JSON.parse(await e.target.files[0].text());if(!Array.isArray(data)||data.some(t=>!t.title||!['todo','progress','done'].includes(t.status)))throw Error();if(confirm('Replace your current board with imported tasks?')){tasks=data;save();render();notify('Board imported');}}catch{notify('Invalid board file');}e.target.value='';};
+  $('#theme-toggle').onclick=()=>{document.body.classList.toggle('dark');localStorage.setItem('daymark-dark',document.body.classList.contains('dark')?'1':'0');};if(localStorage.getItem('daymark-dark')==='1')document.body.classList.add('dark');$('#manage-columns').onclick=()=>notify('Your three workflow columns are ready to use.');
+  document.addEventListener('keydown',e=>{if(e.key==='Escape')close();if((e.key.toLowerCase()==='n'&&!e.metaKey&&!e.ctrlKey)&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName)){e.preventDefault();openTask();}if(e.key==='/'&&!['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName)){e.preventDefault();$('#search').focus();}if((e.metaKey||e.ctrlKey)&&e.key==='Enter'){e.preventDefault();openTask();}});
+  $('#date-label').textContent=new Date().toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'}).toUpperCase();render();
+})();
