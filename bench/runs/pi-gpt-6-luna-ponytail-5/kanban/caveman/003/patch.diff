+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f7f7f4">
+<title>Daymark — Personal board</title><link rel="stylesheet" href="styles.css">
+</head>
+<body>
+<div class="app-shell">
+<aside class="sidebar">
+  <a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d</span><span>daymark<span class="brand-dot">.</span></span></a>
+  <div class="workspace-label">WORKSPACE</div>
+  <button class="nav-item active"><span class="nav-icon">▦</span> My board <span class="nav-count" id="total-count">0</span></button>
+  <button class="nav-item" id="today-filter"><span class="nav-icon">◷</span> Due today</button>
+  <div class="side-divider"></div>
+  <div class="workspace-label">YOUR FLOW <button class="tiny-btn" id="manage-columns" title="Manage columns">＋</button></div>
+  <div class="flow-list"><div><i class="flow-dot dot-todo"></i> To do <span id="count-todo">0</span></div><div><i class="flow-dot dot-progress"></i> In progress <span id="count-progress">0</span></div><div><i class="flow-dot dot-done"></i> Done <span id="count-done">0</span></div></div>
+  <div class="sidebar-bottom"><div class="quote-mark">“</div><p>Small steps, every day.</p><span>YOUR DAILY REMINDER</span><button id="theme-toggle" class="theme-toggle" title="Toggle dark mode">◐ <span>Appearance</span></button></div>
+</aside>
+<main class="main">
+<header class="topbar"><div class="breadcrumb">Workspace <span>/</span> <strong>My board</strong></div><div class="top-actions"><div class="avatar" title="Your personal workspace">M</div></div></header>
+<section class="content">
+<div class="greeting-row"><div><div class="eyebrow" id="date-label"></div><h1>Your board<span class="period">.</span></h1><p class="subtitle">Make room for what matters.</p></div><button class="primary-btn" id="add-task"><span>＋</span> Add a task <kbd>N</kbd></button></div>
+<div class="stats-row"><div class="stat"><span class="stat-icon purple">✳</span><div><strong id="stat-open">0</strong><span>open tasks</span></div></div><div class="stat"><span class="stat-icon amber">↗</span><div><strong id="stat-progress">0</strong><span>in progress</span></div></div><div class="stat"><span class="stat-icon green">✓</span><div><strong id="stat-done">0</strong><span>completed</span></div></div><div class="focus-note"><span>✦</span> <strong>Focus on progress, not perfection.</strong></div></div>
+<div class="board-toolbar"><div class="board-title"><h2>My tasks</h2><span id="visible-count">0 tasks</span></div><div class="tools"><label class="search"><span>⌕</span><input id="search" type="search" placeholder="Search tasks…" aria-label="Search tasks"><kbd>/</kbd></label><select id="sort-select" aria-label="Sort tasks"><option value="manual">Manual order</option><option value="due">Due date</option><option value="priority">Priority</option><option value="created">Recently added</option></select><button id="export-btn" class="icon-btn" title="Export board as JSON" aria-label="Export board">⇩</button><button id="import-btn" class="icon-btn" title="Import board JSON" aria-label="Import board">⇧</button><input id="import-file" type="file" accept="application/json" hidden></div></div>
+<div class="board" id="board"></div>
+<div class="board-footer"><span><kbd>⌘</kbd> <kbd>Enter</kbd> quick add</span><span>Your board saves automatically on this device <i class="saved-dot"></i></span></div>
+</section></main></div>
+<div class="modal-backdrop" id="modal" hidden><section class="task-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title"><div class="modal-head"><div><span class="eyebrow">TASK DETAILS</span><h2 id="modal-title">Add a task</h2></div><button class="icon-btn close-modal" aria-label="Close">×</button></div><form id="task-form"><input type="hidden" id="task-id"><label class="field-label" for="task-title">What needs doing?</label><input id="task-title" class="title-input" maxlength="120" placeholder="e.g. Plan the week ahead" required><label class="field-label" for="task-description">Notes <span>OPTIONAL</span></label><textarea id="task-description" rows="3" maxlength="1000" placeholder="Add a little context…"></textarea><div class="form-grid"><label><span class="field-label">STATUS</span><select id="task-status"><option value="todo">To do</option><option value="progress">In progress</option><option value="done">Done</option></select></label><label><span class="field-label">PRIORITY</span><select id="task-priority"><option value="none">No priority</option><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option></select></label><label><span class="field-label">DUE DATE</span><input id="task-due" type="date"></label></div><div class="modal-actions"><button type="button" class="delete-btn" id="delete-task" hidden>Delete task</button><span class="spacer"></span><button type="button" class="secondary-btn close-modal">Cancel</button><button class="primary-btn" type="submit">Save task</button></div></form></section></div>
+<div id="toast" role="status" aria-live="polite"></div>
+<script src="app.js"></script>
+</body></html>
