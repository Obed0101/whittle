index 0000000..7246a1a
--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,29 @@
+(() => {
+  const KEY = 'daymark-board-v1';
+  const columns = [{id:'todo',name:'To do'},{id:'doing',name:'In progress'},{id:'done',name:'Done'}];
+  const starter = [
+    {id:'welcome-1',title:'Plan the week ahead',description:'Take a few minutes to decide what a good week looks like.',priority:'medium',due:'',column:'todo',created:Date.now()-3000},
+    {id:'welcome-2',title:'Make time for a proper lunch',description:'A small reminder to step away from the screen.',priority:'low',due:'',column:'todo',created:Date.now()-2000},
+    {id:'welcome-3',title:'Tidy up your task list',description:'Add a task, set a priority, or move cards between lists.',priority:'none',due:'',column:'doing',created:Date.now()-1000}
+  ];
+  let tasks = load(); let toastTimer;
+  const board = document.querySelector('#board'), dialog = document.querySelector('#taskDialog'), form = document.querySelector('#taskForm');
+  function load(){try{const raw=localStorage.getItem(KEY);if(raw===null)return starter;const parsed=JSON.parse(raw);return Array.isArray(parsed)?parsed.filter(t=>t&&t.id&&t.title&&columns.some(c=>c.id===t.column)):starter}catch{return starter}}
+  function persist(){localStorage.setItem(KEY,JSON.stringify(tasks)); updateCounts()}
+  function updateCounts(){document.querySelector('#taskCount').textContent=tasks.length;document.querySelector('#doneCount').textContent=tasks.filter(t=>t.column==='done').length}
+  function escapeHTML(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+  function dateLabel(value){if(!value)return '';const d=new Date(value+'T00:00:00'),today=new Date();today.setHours(0,0,0,0);const diff=Math.round((d-today)/86400000);return {text:diff===0?'Today':diff===1?'Tomorrow':diff===-1?'Yesterday':d.toLocaleDateString(undefined,{month:'short',day:'numeric'}),overdue:diff<0}}
+  function render(){const query=document.querySelector('#searchInput').value.trim().toLowerCase(), priority=document.querySelector('#priorityFilter').value;board.innerHTML='';for(const col of columns){const list=tasks.filter(t=>t.column===col.id), shown=list.filter(t=>(!query||`${t.title} ${t.description||''}`.toLowerCase().includes(query))&&(priority==='all'||t.priority===priority));const section=document.createElement('section');section.className='column';section.dataset.column=col.id;section.innerHTML=`<div class="column-head"><span class="column-dot"></span><span class="column-title">${col.name}</span><span class="column-count">${list.length}</span><button class="column-add" data-add="${col.id}" title="Add to ${col.name}" aria-label="Add task to ${col.name}">＋</button></div><div class="task-list" data-drop="${col.id}"></div>`;const taskList=section.querySelector('.task-list');if(!shown.length)taskList.innerHTML=`<div class="empty-column">${list.length?'No matching tasks':'Nothing here yet'}</div>`;shown.forEach(task=>taskList.append(makeCard(task)));board.append(section)}updateCounts()}
+  function makeCard(t){const card=document.createElement('article');card.className='task-card';card.draggable=true;card.tabIndex=0;card.dataset.id=t.id;const due=dateLabel(t.due);const moveTo=columns[(columns.findIndex(c=>c.id===t.column)+1)%columns.length];card.innerHTML=`<div class="card-top"><div class="card-title">${escapeHTML(t.title)}</div><button class="card-menu" title="Edit task" aria-label="Edit ${escapeHTML(t.title)}">···</button></div>${t.description?`<p class="card-description">${escapeHTML(t.description)}</p>`:''}<div class="card-footer">${t.priority!=='none'?`<span class="priority ${t.priority}">${t.priority}</span>`:''}${due.text?`<span class="due ${due.overdue&&t.column!=='done'?'overdue':''}">${due.overdue&&t.column!=='done'?'⚑ ':''}${due.text}</span>`:''}<span class="move-actions"><button data-move="${moveTo.id}" title="Move to ${moveTo.name}" aria-label="Move to ${moveTo.name}">→</button></span></div>`;card.addEventListener('click',e=>{if(!e.target.closest('button'))openTask(t.id)});card.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();openTask(t.id)}});card.querySelector('.card-menu').onclick=()=>openTask(t.id);card.querySelector('[data-move]').onclick=e=>{e.stopPropagation();move(t.id,moveTo.id)};card.addEventListener('dragstart',e=>{e.dataTransfer.setData('text/plain',t.id);e.dataTransfer.effectAllowed='move';card.classList.add('dragging')});card.addEventListener('dragend',()=>card.classList.remove('dragging'));return card}
+  function move(id,column){const t=tasks.find(x=>x.id===id);if(t){t.column=column;persist();render()}}
+  function openTask(id='',column='todo'){const t=tasks.find(x=>x.id===id);form.reset();document.querySelector('#taskId').value=t?.id||'';document.querySelector('#dialogTitle').textContent=t?'Edit task':'Add a task';document.querySelector('#taskTitle').value=t?.title||'';document.querySelector('#taskDescription').value=t?.description||'';document.querySelector('#taskPriority').value=t?.priority||'none';document.querySelector('#taskDue').value=t?.due||'';document.querySelector('#taskColumn').innerHTML=columns.map(c=>`<option value="${c.id}">${c.name}</option>`).join('');document.querySelector('#taskColumn').value=t?.column||column;document.querySelector('#deleteTask').style.visibility=t?'visible':'hidden';dialog.showModal();setTimeout(()=>document.querySelector('#taskTitle').focus(),50)}
+  form.addEventListener('submit',e=>{e.preventDefault();const id=document.querySelector('#taskId').value, data={title:document.querySelector('#taskTitle').value.trim(),description:document.querySelector('#taskDescription').value.trim(),priority:document.querySelector('#taskPriority').value,due:document.querySelector('#taskDue').value,column:document.querySelector('#taskColumn').value};if(!data.title)return;const existing=tasks.find(t=>t.id===id);if(existing)Object.assign(existing,data);else tasks.unshift({id:crypto.randomUUID?crypto.randomUUID():String(Date.now()),...data,created:Date.now()});persist();render();dialog.close();showToast(id?'Task updated':'Task added')});
+  document.querySelector('#deleteTask').onclick=()=>{const id=document.querySelector('#taskId').value;if(id&&confirm('Delete this task? This cannot be undone.')){tasks=tasks.filter(t=>t.id!==id);persist();render();dialog.close();showToast('Task deleted')}};
+  document.querySelectorAll('.close-dialog').forEach(b=>b.onclick=()=>b.closest('dialog').close());document.querySelector('#addTaskTop').onclick=()=>openTask();board.addEventListener('click',e=>{const b=e.target.closest('[data-add]');if(b)openTask('',b.dataset.add)});
+  board.addEventListener('dragover',e=>{const zone=e.target.closest('[data-drop]');if(zone){e.preventDefault();zone.classList.add('drag-over')}});board.addEventListener('dragleave',e=>{const zone=e.target.closest('[data-drop]');if(zone&&!zone.contains(e.relatedTarget))zone.classList.remove('drag-over')});board.addEventListener('drop',e=>{const zone=e.target.closest('[data-drop]');if(zone){e.preventDefault();zone.classList.remove('drag-over');move(e.dataTransfer.getData('text/plain'),zone.dataset.drop)}});
+  document.querySelector('#searchInput').addEventListener('input',render);document.querySelector('#priorityFilter').addEventListener('change',render);document.querySelector('#clearDone').onclick=()=>{const n=tasks.filter(t=>t.column==='done').length;if(n&&confirm(`Clear ${n} completed ${n===1?'task':'tasks'}?`)){tasks=tasks.filter(t=>t.column!=='done');persist();render();showToast('Completed tasks cleared')}};
+  document.querySelector('#exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify({exported:new Date().toISOString(),tasks},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`daymark-board-${new Date().toISOString().slice(0,10)}.json`;a.click();URL.revokeObjectURL(a.href);showToast('Board exported')};
+  document.querySelector('#helpBtn').onclick=()=>document.querySelector('#helpDialog').showModal();document.addEventListener('keydown',e=>{if(e.key==='Escape')return;if(dialog.open||document.querySelector('#helpDialog').open)return;if(e.key==='n'&&!/input|textarea|select/i.test(e.target.tagName)){e.preventDefault();openTask()}if(e.key==='/'&&!/input|textarea|select/i.test(e.target.tagName)){e.preventDefault();document.querySelector('#searchInput').focus()}});
+  function showToast(msg){const el=document.querySelector('#toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2100)}
+  document.querySelector('#todayLabel').textContent=new Date().toLocaleDateString(undefined,{weekday:'short',month:'short',day:'numeric'});render();
+})();
diff --git a/board/index.html b/board/index.html
new file mode 100644
index 0000000..fa1233c
--- /dev/null
+++ b/board/index.html
@@ -0,0 +1,33 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="theme-color" content="#f6f7f5"><title>Daymark — Personal Kanban</title>
+  <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+  <div class="app-shell">
+    <aside class="sidebar">
+      <a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d</span><span>daymark</span></a>
+      <div class="workspace-label">YOUR WORKSPACE</div>
+      <button class="nav-item active" id="boardNav"><span class="nav-icon">▦</span> My board <span class="nav-count" id="taskCount">0</span></button>
+      <div class="sidebar-rule"></div>
+      <div class="sidebar-tip"><span class="tip-icon">✳</span><strong>A little progress<br>goes a long way.</strong><p>Focus on what matters today. The rest can wait.</p></div>
+      <div class="sidebar-bottom"><span class="avatar">Y</span><div><strong>Your space</strong><small>Personal workspace</small></div><button class="icon-button" id="exportBtn" title="Export board" aria-label="Export board">↗</button></div>
+    </aside>
+    <main class="main">
+      <header class="topbar"><div class="breadcrumb">Workspace <span>/</span> <strong>My board</strong></div><div class="top-actions"><span class="today" id="todayLabel"></span><button class="icon-button help-button" id="helpBtn" title="Keyboard shortcuts" aria-label="Keyboard shortcuts">?</button></div></header>
+      <section class="content">
+        <div class="heading-row"><div><div class="eyebrow">YOUR PERSONAL WORKSPACE</div><h1>My board <span class="sparkle">✳</span></h1><p class="subtitle">Make space for the work that matters.</p></div><button class="primary-button" id="addTaskTop"><span>＋</span> Add task</button></div>
+        <div class="toolbar"><div class="search-wrap"><span>⌕</span><input id="searchInput" type="search" placeholder="Search tasks..." aria-label="Search tasks"><kbd>/</kbd></div><div class="toolbar-right"><label class="filter-wrap"><span>◉</span><select id="priorityFilter" aria-label="Filter by priority"><option value="all">All priorities</option><option value="high">High priority</option><option value="medium">Medium priority</option><option value="low">Low priority</option></select></label><button class="text-button" id="clearDone">Clear completed <span id="doneCount">0</span></button></div></div>
+        <div class="board" id="board" aria-label="Kanban board"></div>
+        <footer class="board-footer"><span><span class="live-dot"></span> Saved automatically</span><span>Drag cards to move them between lists</span></footer>
+      </section>
+    </main>
+  </div>
+  <dialog id="taskDialog"><form id="taskForm" method="dialog"><div class="modal-head"><div><div class="eyebrow">TASK DETAILS</div><h2 id="dialogTitle">Add a task</h2></div><button type="button" class="icon-button close-dialog" aria-label="Close">×</button></div><input type="hidden" id="taskId"><label class="field-label" for="taskTitle">Task name</label><input class="field" id="taskTitle" maxlength="140" placeholder="What needs to get done?" required><label class="field-label" for="taskDescription">Notes <span>optional</span></label><textarea class="field" id="taskDescription" rows="3" maxlength="500" placeholder="Add a little context..."></textarea><div class="field-row"><div><label class="field-label" for="taskPriority">Priority</label><select class="field" id="taskPriority"><option value="none">No priority</option><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select></div><div><label class="field-label" for="taskDue">Due date <span>optional</span></label><input class="field" id="taskDue" type="date"></div></div><label class="field-label" for="taskColumn">List</label><select class="field" id="taskColumn"></select><div class="modal-actions"><button type="button" class="delete-button" id="deleteTask">Delete task</button><div><button type="button" class="secondary-button close-dialog">Cancel</button><button class="primary-button" type="submit">Save task</button></div></div></form></dialog>
+  <dialog id="helpDialog"><div class="modal-head"><div><div class="eyebrow">QUICK TIPS</div><h2>Make it yours</h2></div><button class="icon-button close-dialog" aria-label="Close">×</button></div><p class="help-copy">Everything is saved on this device automatically. Drag cards between lists, or use the arrows on a card. Select a card to edit it.</p><div class="shortcut"><span>New task</span><kbd>N</kbd></div><div class="shortcut"><span>Search</span><kbd>/</kbd></div><div class="shortcut"><span>Close dialog</span><kbd>Esc</kbd><button class="primary-button help-done close-dialog">Got it</button></div></dialog>
+  <div class="toast" id="toast" role="status" aria-live="polite"></div>
+  <script src="app.js"></script>
+</body>
+</html>
