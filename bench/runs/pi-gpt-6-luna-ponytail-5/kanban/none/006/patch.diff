+(()=>{'use strict';const KEY='dayboard.tasks.v1',defaults=[{id:'welcome-1',title:'Write down what’s on your mind',description:'Get it out of your head and onto the board. You can sort it out later.',priority:'low',column:'todo',tag:'A good start'},{id:'welcome-2',title:'Choose one thing to focus on',description:'The best next step is usually smaller than you think.',priority:'high',column:'todo',tag:'Focus'},{id:'welcome-3',title:'Make a little progress',description:'Move a task here when you begin. One thing at a time.',priority:'medium',column:'doing'},{id:'welcome-4',title:'Celebrate a finished thing',description:'Done is a lovely place to be.',priority:'low',column:'done'}];let tasks;try{tasks=JSON.parse(localStorage.getItem(KEY));if(!Array.isArray(tasks))tasks=defaults}catch{tasks=defaults}const columns=[['todo','To do'],['doing','In progress'],['done','Done']],$=s=>document.querySelector(s),board=$('#board'),dialog=$('#taskDialog'),form=$('#taskForm');const escape=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function persist(){try{localStorage.setItem(KEY,JSON.stringify(tasks));$('#saveStatus').innerHTML='<i></i> All changes saved'}catch{$('#saveStatus').innerHTML='<i></i> Could not save'}}function dayLabel(){const d=new Date();$('#weekday').textContent=d.toLocaleDateString(undefined,{weekday:'long'});$('#today').textContent=d.toLocaleDateString(undefined,{month:'long',day:'numeric'});}
+function render(){let q=$('#search').value.trim().toLowerCase(),priority=$('#priorityFilter').value;board.innerHTML=columns.map(([key,label])=>{let list=tasks.filter(t=>t.column===key&&(!q||`${t.title} ${t.description||''} ${t.tag||''}`.toLowerCase().includes(q))&&(priority==='all'||t.priority===priority));return `<section class="column" data-column="${key}"><div class="column-head"><div class="column-name"><span class="dot"></span>${label}<span class="count">${tasks.filter(t=>t.column===key).length}</span></div><button class="add-inline" data-add="${key}" aria-label="Add task to ${label}" title="Add task">＋</button></div><div class="card-list" data-drop="${key}">${list.length?list.map(card).join(''):`<div class="empty">${q||priority!=='all'?'No matching tasks.':'A clear space for what’s next.'}${!q&&priority==='all'&&key==='todo'?'<br><button data-add="todo">Add your first task</button>':''}</div>`}</div></section>`}).join('');$('#taskSummary').textContent=`${tasks.length} task${tasks.length===1?'':'s'} · ${tasks.filter(t=>t.column!=='done').length} open`;bindBoard()}
+function card(t){let due='',cls='';if(t.due){let today=new Date();today.setHours(0,0,0,0);let d=new Date(t.due+'T00:00:00');due=d.toLocaleDateString(undefined,{month:'short',day:'numeric'});if(d<today&&t.column!=='done')cls='overdue';else if((d-today)/86400000<=2&&t.column!=='done')cls='soon'}return `<article class="task-card" draggable="true" data-id="${escape(t.id)}" tabindex="0" aria-label="${escape(t.title)}"><div class="card-top"><span class="priority ${escape(t.priority)}">${escape(t.priority)}</span><button class="more" data-edit="${escape(t.id)}" aria-label="Edit ${escape(t.title)}">···</button></div><h3>${escape(t.title)}</h3>${t.description?`<p class="task-desc">${escape(t.description)}</p>`:''}<div class="card-meta">${t.tag?`<span class="tag">${escape(t.tag)}</span>`:'<span></span>'}${due?`<span class="due ${cls}">${cls==='overdue'?'Overdue · ':''}${due}</span>`:''}</div></article>`}
+function bindBoard(){board.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>openTask(null,b.dataset.add));board.querySelectorAll('[data-edit]').forEach(b=>b.onclick=e=>{e.stopPropagation();openTask(b.dataset.edit)});board.querySelectorAll('.task-card').forEach(c=>{c.onclick=e=>{if(!e.target.closest('.more'))openTask(c.dataset.id)};c.ondragstart=e=>{e.dataTransfer.setData('text/plain',c.dataset.id);setTimeout(()=>c.classList.add('dragging'),0)};c.ondragend=()=>c.classList.remove('dragging')});board.querySelectorAll('[data-drop]').forEach(el=>{el.ondragover=e=>{e.preventDefault();el.classList.add('drag-over')};el.ondragleave=()=>el.classList.remove('drag-over');el.ondrop=e=>{e.preventDefault();el.classList.remove('drag-over');let t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.column=el.dataset.drop;persist();render()}}})}
+function openTask(id,column='todo'){form.reset();$('#taskId').value=id||'';$('#taskColumn').value=column;$('#taskPriority').value='medium';$('#modalTitle').textContent=id?'Edit task':'A new thing';$('#deleteTask').style.visibility=id?'visible':'hidden';if(id){let t=tasks.find(x=>x.id===id);if(!t)return;$('#taskTitle').value=t.title;$('#taskDescription').value=t.description||'';$('#taskPriority').value=t.priority||'medium';$('#taskDue').value=t.due||'';$('#taskTag').value=t.tag||'';$('#taskColumn').value=t.column}dialog.showModal();setTimeout(()=>$('#taskTitle').focus(),50)}form.onsubmit=e=>{e.preventDefault();let id=$('#taskId').value,t={id:id||crypto.randomUUID(),title:$('#taskTitle').value.trim(),description:$('#taskDescription').value.trim(),priority:$('#taskPriority').value,due:$('#taskDue').value,tag:$('#taskTag').value.trim(),column:$('#taskColumn').value};if(!t.title)return;if(id)tasks[tasks.findIndex(x=>x.id===id)]=t;else tasks.unshift(t);persist();render();dialog.close();toast(id?'Task updated':'Task added')};function removeTask(){let id=$('#taskId').value;if(!id)return;tasks=tasks.filter(t=>t.id!==id);persist();render();dialog.close();toast('Task deleted')}$('#deleteTask').onclick=removeTask;$('#closeDialog').onclick=$('#cancelDialog').onclick=()=>dialog.close();dialog.onclick=e=>{if(e.target===dialog)dialog.close()};$('#search').oninput=render;$('#priorityFilter').onchange=render;let toastTimer;function toast(msg){let el=$('#toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200)}$('#newTask').onclick=()=>openTask();$('#clearDone').onclick=()=>{let n=tasks.filter(t=>t.column==='done').length;if(!n){toast('Nothing completed to clear');return}if(confirm(`Remove ${n} completed task${n===1?'':'s'}?`)){tasks=tasks.filter(t=>t.column!=='done');persist();render();toast('Completed tasks cleared')}};$('#helpBtn').onclick=()=>alert('Keyboard shortcuts\n\nN — New task\n/ — Search tasks