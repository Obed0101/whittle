+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f5f5f2">
+<title>Dayboard — Personal Kanban</title><link rel="stylesheet" href="style.css">
+</head>
+<body>
+<div class="app-shell">
+<header class="topbar"><a class="brand" href="#" aria-label="Dayboard home"><span class="brand-mark">d.</span><span>dayboard</span></a><div class="top-actions"><span class="save-status" id="saveStatus"><i></i> All changes saved</span><button class="icon-button" id="helpBtn" aria-label="Keyboard shortcuts" title="Keyboard shortcuts">?</button><button class="avatar" id="clearDone" title="Clear completed tasks">✓</button></div></header>
+<main>
+<section class="heading"><div><div class="eyebrow"><span class="sun">✳</span> YOUR PERSONAL WORKSPACE</div><h1>Make room for <em>what matters.</em></h1><p class="subtitle">A little progress, every day.</p></div><div class="date-card"><span id="weekday"></span><strong id="today"></strong><span class="date-dot">●</span></div></section>
+<section class="toolbar"><div class="board-title"><span class="board-icon">▦</span><div><strong>My board</strong><small id="taskSummary">0 tasks</small></div></div><div class="tools"><label class="search"><span>⌕</span><input id="search" type="search" placeholder="Find a task..." aria-label="Search tasks"><kbd>/</kbd></label><select id="priorityFilter" aria-label="Filter by priority"><option value="all">All priorities</option><option value="high">High priority</option><option value="medium">Medium priority</option><option value="low">Low priority</option></select><button class="primary-button" id="newTask"><span>＋</span> New task <kbd>N</kbd></button></div></section>
+<section class="board" id="board" aria-label="Kanban board"></section>
+<footer><span><b>Tip</b> Drag cards between columns to keep your day flowing.</span><span>Made for focus <span class="heart">♥</span></span></footer>
+</main></div>
+<dialog id="taskDialog"><form id="taskForm"><div class="modal-top"><div><span class="eyebrow">TASK DETAILS</span><h2 id="modalTitle">A new thing</h2></div><button type="button" class="close" id="closeDialog" aria-label="Close">×</button></div><input type="hidden" id="taskId"><label class="field-label" for="taskTitle">What needs doing?</label><input class="text-field" id="taskTitle" maxlength="120" required placeholder="Give it a clear name"><label class="field-label" for="taskDescription">A few details <span>OPTIONAL</span></label><textarea class="text-field" id="taskDescription" rows="3" maxlength="500" placeholder="Add context, links, or a next step..."></textarea><div class="field-row"><div><label class="field-label" for="taskPriority">Priority</label><select class="text-field" id="taskPriority"><option value="low">Low</option><option value="medium" selected>Medium</option><option value="high">High</option></select></div><div><label class="field-label" for="taskDue">Due date <span>OPTIONAL</span></label><input class="text-field" type="date" id="taskDue"></div></div><label class="field-label" for="taskTag">Label <span>OPTIONAL</span></label><input class="text-field" id="taskTag" maxlength="24" placeholder="e.g. Work, Personal"><label class="field-label" for="taskColumn">Column</label><select class="text-field" id="taskColumn"><option value="todo">To do</option><option value="doing">In progress</option><option value="done">Done</option></select><div class="modal-actions"><button type="button" id="deleteTask" class="delete-button">Delete task</button><div><button type="button" class="secondary-button" id="cancelDialog">Cancel</button><button class="primary-button" type="submit">Save task <span>↗</span></button></div></div></form></dialog>
+<div class="toast" id="toast" role="status" aria-live="polite"></div><script src="app.js"></script>
+</body></html>
