+  function load(){try{const value=JSON.parse(localStorage.getItem(KEY));tasks=Array.isArray(value)?value:seed;if(!value)localStorage.setItem(KEY,JSON.stringify(tasks));}catch{tasks=seed;save()}}
+  function save(){localStorage.setItem(KEY,JSON.stringify(tasks));$('totalCount').textContent=tasks.filter(t=>t.status!=='done').length}
+  function escapeHtml(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+  function dateInfo(date){if(!date)return null;const d=new Date(date+'T00:00:00'),now=new Date();now.setHours(0,0,0,0);const diff=Math.round((d-now)/86400000);return{label:diff===0?'Today':diff===1?'Tomorrow':d.toLocaleDateString(undefined,{month:'short',day:'numeric'}),cls:diff<0?'overdue':diff<=2?'soon':''}}
+  function visible(task){if(page==='today'&&!task.due)return false;if(page==='today'&&task.status==='done')return false;if(page==='archive'&&task.status!=='done')return false;if(page!=='archive'&&page!=='today'&&task.status==='done')return false;if(filter!=='all'&&task.priority!==filter)return false;return !query||`${task.title} ${task.description||''} ${task.tag||''}`.toLowerCase().includes(query)}
+  function render(){save();board.classList.toggle('list-view',view==='list');board.innerHTML='';let shown=0;
+    for(const [status,label] of columns){let items=tasks.filter(t=>t.status===status&&visible(t));if(sortMode===1)items.sort((a,b)=>({high:0,medium:1,low:2,none:3}[a.priority]-{high:0,medium:1,low:2,none:3}[b.priority]));if(sortMode===2)items.sort((a,b)=>(a.due||'9999').localeCompare(b.due||'9999'));shown+=items.length;
+      const section=document.createElement('section');section.className='column';section.dataset.status=status;
+      section.innerHTML=`<div class="column-head"><span class="column-indicator"></span><h2>${label}</h2><span class="column-count">${items.length}</span><button class="column-add" aria-label="Add task to ${label}" title="Add task">＋</button></div><div class="cards" data-status="${status}"></div>`;
+      const cards=section.querySelector('.cards');
+      for(const t of items){const date=dateInfo(t.due),card=document.createElement('article');card.className='task-card'+(t.status==='done'?' is-done':'');card.draggable=true;card.dataset.id=t.id;
+        card.innerHTML=`<div class="card-top"><input class="task-check" type="checkbox" aria-label="Mark ${escapeHtml(t.title)} complete" ${t.status==='done'?'checked':''}><span class="task-name">${escapeHtml(t.title)}</span><button class="card-menu" aria-label="Edit task">···</button></div>${t.description?`<p class="task-desc">${escapeHtml(t.description)}</p>`:''}<div class="card-meta">${t.priority&&t.priority!=='none'?`<span class="priority ${t.priority}">${t.priority[0].toUpperCase()+t.priority.slice(1)}</span>`:''}${t.tag?`<span class="tag">${escapeHtml(t.tag)}</span>`:''}${date?`<span class="due ${date.cls}">${date.label}</span>`:''}</div>`;
+        card.addEventListener('click',e=>{if(!e.target.closest('.task-check'))openTask(t.id)});card.querySelector('.task-check').addEventListener('change',e=>{t.status=e.target.checked?'done':'todo';save();render();if(t.status==='done')toast('Nice work — task completed!')});card.addEventListener('dragstart',e=>{e.dataTransfer.setData('text/plain',t.id);e.dataTransfer.effectAllowed='move';card.classList.add('dragging')});card.addEventListener('dragend',()=>card.classList.remove('dragging'));cards.append(card)}
+      cards.addEventListener('dragover',e=>{e.preventDefault();cards.classList.add('drag-over')});cards.addEventListener('dragleave',e=>{if(!cards.contains(e.relatedTarget))cards.classList.remove('drag-over')});cards.addEventListener('drop',e=>{e.preventDefault();cards.classList.remove('drag-over');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=status;save();render()}});section.querySelector('.column-add').addEventListener('click',()=>openTask(null,status));board.append(section);
+    }
+    $('emptySearch').hidden=shown!==0;const isArchive=page==='archive';$('clearCompleted').parentElement.style.visibility=isArchive?'hidden':'visible';
+  }
+  function openTask(id=null,status='todo'){editing=id;const t=tasks.find(x=>x.id===id);$('modalTitle').textContent=t?'Edit task':'Create a task';$('taskTitle').value=t?.title||'';$('taskDescription').value=t?.description||'';$('taskStatus').value=t?.status||status;$('taskPriority').value=t?.priority||'none';$('taskDue').value=t?.due||'';$('taskTag').value=t?.tag||'';$('deleteTaskBtn').style.visibility=t?'visible':'hidden';dialog.showModal();setTimeout(()=>$('taskTitle').focus(),30)}
+  function close(){dialog.close()}
+  form.addEventListener('submit',e=>{e.preventDefault();const title=$('taskTitle').value.trim();if(!title){$('taskTitle').focus();return}const data={title,description:$('taskDescription').value.trim(),status:$('taskStatus').value,priority:$('taskPriority').value,due:$('taskDue').value,tag:$('taskTag').value.trim()};if(editing){Object.assign(tasks.find(t=>t.id===editing),data);toast('Task updated')}else{tasks.unshift({id:crypto.randomUUID?crypto.randomUUID():String(Date.now()),...data,created:Date.now()});toast('Task added')}save();render();close()});
+  $('newTaskBtn').onclick=()=>openTask();$('closeDialog').onclick=close;$('cancelDialog').onclick=close;$('deleteTaskBtn').onclick=()=>{if(editing&&confirm('Delete this task? This can’t be undone.')){tasks=tasks.filter(t=>t.id!==editing);close();render();toast('Task deleted')}};
+  $('searchInput').addEventListener('input',e=>{query=e.target.value.trim().toLowerCase();render()});$('priorityFilter').onchange=e=>{filter=e.target.value;render()};$('sortBtn').onclick=()=>{sortMode=(sortMode+1)%3;$('sortBtn').innerHTML=sortMode===0?'↕ <span>Sort</span>':sortMode===1?'↑ <span>Priority</span>':'↑ <span>Due date</span>';render()};
