+    {title:'Book a checkup',description:'Find a time that works and add it to the calendar.',status:'todo',priority:'low',tag:'Life admin',due:'',created:2},
+    {title:'Finish reading that chapter',description:'Just 20 minutes is a good start.',status:'progress',priority:'none',tag:'Personal',due:'',created:3},
+    {title:'Tidy up the workspace',description:'Clear the desk and reset for a fresh start.',status:'done',priority:'none',tag:'Home',due:'',created:4}
