+      <section class="content">
+        <div class="welcome-row"><div><div class="eyebrow" id="todayLabel">YOUR PERSONAL SPACE</div><h1 id="pageTitle">My board <span class="title-spark">✳</span></h1><p class="subtitle" id="pageSubtitle">A clear view of what’s moving, and what’s next.</p></div><button class="primary-button" id="newTaskBtn"><span>＋</span> New task <kbd>N</kbd></button></div>
+        <div class="toolbar"><div class="view-tabs"><button class="view-tab selected" data-view="board">Board</button><button class="view-tab" data-view="list">List</button></div><div class="toolbar-right"><label class="search-box"><span>⌕</span><input id="searchInput" placeholder="Search tasks..." aria-label="Search tasks"><kbd>/</kbd></label><select id="priorityFilter" aria-label="Filter by priority"><option value="all">All priorities</option><option value="high">High priority</option><option value="medium">Medium priority</option><option value="low">Low priority</option></select><button id="sortBtn" class="secondary-button" title="Sort tasks">↕ <span>Sort</span></button></div></div>
+        <div class="board" id="board" aria-label="Kanban board"></div>
