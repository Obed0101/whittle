+  $('boardNav').onclick=()=>setPage('board');$('todayNav').onclick=()=>setPage('today');$('archiveNav').onclick=()=>setPage('archive');$('clearFilters').onclick=()=>{$('searchInput').value='';$('priorityFilter').value='all';query='';filter='all';render()};$('clearCompleted').onclick=()=>{const count=tasks.filter(t=>t.status==='done').length;if(count&&confirm(`Permanently clear ${count} completed ${count===1?'task':'tasks'}?`)){tasks=tasks.filter(t=>t.status!=='done');render();toast('Completed tasks cleared')}};
+  function toast(msg){const el=$('toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2300)}
+  $('exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify({version:1,tasks},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`daymark-backup-${new Date().toISOString().slice(0,10)}.json`;a.click();URL.revokeObjectURL(a.href);toast('Backup downloaded')};$('importBtn').onclick=()=>$('importFile').click();$('importFile').onchange=async e=>{try{const parsed=JSON.parse(await e.target.files[0].text()),incoming=Array.isArray(parsed)?parsed:parsed.tasks;if(!Array.isArray(incoming)||incoming.some(t=>!t.title||!columns.some(c=>c[0]===t.status)))throw Error();if(confirm(`Import ${incoming.length} tasks? This replaces your current board.`)){tasks=incoming.map(t=>({...t,id:t.id||String(Date.now()+Math.random())}));render();toast('Board imported')}}catch{alert('That file does not look like a valid Daymark backup.')}e.target.value=''};
