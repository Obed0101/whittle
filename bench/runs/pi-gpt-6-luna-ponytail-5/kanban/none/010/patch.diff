diff --git a/board/app.js b/board/app.js
new file mode 100644
index 0000000..23ab9a2
--- /dev/null
+++ b/board/app.js
@@ -0,0 +1,26 @@
+(() => {
+const columns=[{id:'todo',title:'To do'},{id:'doing',title:'In progress'},{id:'done',title:'Done'}];
+const seed=[{id:'welcome-1',title:'Make this board yours',description:'Add a task, set a due date, and move it along as you go. Your board saves automatically.',status:'todo',priority:'medium',due:'',created:1},{id:'welcome-2',title:'Focus on one thing at a time',description:'A short list is a kind list. Keep the next step small and doable.',status:'doing',priority:'low',due:'',created:2}];
+let tasks;try{const stored=JSON.parse(localStorage.getItem('daymark-tasks'));tasks=Array.isArray(stored)?stored:seed}catch{tasks=seed}
+let query='',priority='all',sortNewest=false,activeFilter='all',toastTimer;
+const $=s=>document.querySelector(s), board=$('#boardView'), list=$('#listView'), dialog=$('#taskDialog');
+function save(){localStorage.setItem('daymark-tasks',JSON.stringify(tasks));$('#savedStatus').textContent='✓ Saved on this device';render()}
+function dateLabel(value){if(!value)return '';const d=new Date(value+'T00:00:00'),today=new Date();today.setHours(0,0,0,0);const diff=Math.round((d-today)/86400000);if(diff===0)return 'Today';if(diff===1)return 'Tomorrow';if(diff===-1)return 'Yesterday';return d.toLocaleDateString(undefined,{month:'short',day:'numeric'})}
+function visible(t){if(query&&!`${t.title} ${t.description}`.toLowerCase().includes(query.toLowerCase()))return false;if(priority!=='all'&&t.priority!==priority)return false;if(activeFilter==='today'&&t.due!==new Date().toISOString().slice(0,10))return false;if(activeFilter==='upcoming'&&(!t.due||t.due<new Date().toISOString().slice(0,10)))return false;return true}
+function render(){const shown=tasks.filter(visible);$('#totalCount').textContent=tasks.length;$('#todayCount').textContent=tasks.filter(t=>t.due===new Date().toISOString().slice(0,10)).length;$('#footerCount').textContent=`${tasks.length} ${tasks.length===1?'task':'tasks'} · saved automatically`;
+ board.innerHTML=columns.map(c=>{const group=shown.filter(t=>t.status===c.id).sort((a,b)=>sortNewest?b.created-a.created:a.created-b.created);return `<section class="column ${c.id}" data-column="${c.id}"><div class="column-head"><span class="column-mark"></span><span class="column-title">${c.title}</span><span class="column-count">${group.length}</span><button class="column-add" data-add="${c.id}" title="Add to ${c.title}">＋</button></div><div class="task-list" data-drop="${c.id}">${group.length?group.map(card).join(''):`<div class="empty-state">${query||activeFilter!=='all'?'No matching tasks here.':'Nothing here just yet.'}<br><button data-add="${c.id}">＋ Add a task</button></div>`}</div></section>`}).join('');
+ list.innerHTML=`<div class="list-row header"><span>Task</span><span>Status</span><span>Priority</span><span>Due date</span><span></span></div>`+(shown.length?shown.slice().sort((a,b)=>sortNewest?b.created-a.created:a.created-b.created).map(t=>`<div class="list-row"><span class="list-title">${esc(t.title)}</span><span class="list-status">${columns.find(c=>c.id===t.status).title}</span><span class="priority ${t.priority}">${t.priority}</span><span class="list-date">${dateLabel(t.due)||'—'}</span><span class="list-actions"><button data-edit="${t.id}" title="Edit">✎</button><button data-delete="${t.id}" title="Delete">×</button></span></div>`).join(''):`<div class="list-row">No tasks match your filters.</div>`);
+}
+function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+function card(t){const due=dateLabel(t.due),today=new Date().toISOString().slice(0,10),dueClass=t.due&&t.due<today&&t.status!=='done'?'overdue':t.due===today?'soon':'';return `<article class="task-card" draggable="true" data-id="${esc(t.id)}"><div class="card-top"><span class="priority ${t.priority}">${t.priority}</span><button class="card-menu" data-edit="${esc(t.id)}" title="Edit task">···</button></div><h3>${esc(t.title)}</h3>${t.description?`<p class="task-description">${esc(t.description)}</p>`:''}<div class="card-bottom"><span class="due-date ${dueClass} ${due?'':'no-date'}">${due?esc(due):'No date'}</span><span class="card-actions">${t.status!=='todo'?`<button class="card-action" data-move="${esc(t.id)}" data-to="${t.status==='done'?'doing':'todo'}" title="Move back">←</button>`:''}${t.status!=='done'?`<button class="card-action" data-move="${esc(t.id)}" data-to="${t.status==='todo'?'doing':'done'}" title="${t.status==='todo'?'Start task':'Complete task'}">${t.status==='todo'?'→':'✓'}</button>`:`<button class="card-action" data-move="${esc(t.id)}" data-to="todo" title="Reopen task">↶</button>`}</span></div></article>`}
+function openTask(task=null,status='todo'){const f=$('#taskForm');f.reset();$('#taskId').value=task?.id||'';$('#taskTitle').value=task?.title||'';$('#taskDescription').value=task?.description||'';$('#taskStatus').value=task?.status||status;$('#taskPriority').value=task?.priority||'medium';$('#taskDue').value=task?.due||'';$('#dialogTitle').textContent=task?'Edit task':'New task';$('#saveTask').innerHTML=task?'Save changes <span>→</span>':'Add task <span>→</span>';dialog.showModal();setTimeout(()=>$('#taskTitle').focus(),50)}
+function notify(msg){const el=$('#toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200)}
+$('#taskForm').addEventListener('submit',e=>{e.preventDefault();const id=$('#taskId').value,data={title:$('#taskTitle').value.trim(),description:$('#taskDescription').value.trim(),status:$('#taskStatus').value,priority:$('#taskPriority').value,due:$('#taskDue').value};if(!data.title)return;if(id){tasks=tasks.map(t=>t.id===id?{...t,...data}:t);notify('Task updated')}else{tasks.push({id:crypto.randomUUID?crypto.randomUUID():String(Date.now()),...data,created:Date.now()});notify('Task added to your board')}dialog.close();save()});
+$('#addTask').onclick=()=>openTask();$('#closeDialog').onclick=$('#cancelDialog').onclick=()=>dialog.close();dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});
+document.addEventListener('click',e=>{const add=e.target.closest('[data-add]');if(add)openTask(null,add.dataset.add);const edit=e.target.closest('[data-edit]');if(edit){const t=tasks.find(x=>x.id===edit.dataset.edit);if(t)openTask(t)}const del=e.target.closest('[data-delete]');if(del){const t=tasks.find(x=>x.id===del.dataset.delete);if(t&&confirm(`Delete “${t.title}”? This can't be undone.`)){tasks=tasks.filter(x=>x.id!==t.id);save();notify('Task deleted')}}const move=e.target.closest('[data-move]');if(move){tasks=tasks.map(t=>t.id===move.dataset.move?{...t,status:move.dataset.to}:t);save();notify('Task moved')}});
+board.addEventListener('dragstart',e=>{const c=e.target.closest('.task-card');if(c){e.dataTransfer.setData('text/plain',c.dataset.id);e.dataTransfer.effectAllowed='move';setTimeout(()=>c.classList.add('dragging'),0)}});board.addEventListener('dragend',e=>{const c=e.target.closest('.task-card');if(c)c.classList.remove('dragging');document.querySelectorAll('.drag-over').forEach(x=>x.classList.remove('drag-over'))});board.addEventListener('dragover',e=>{const drop=e.target.closest('[data-drop]');if(drop){e.preventDefault();drop.classList.add('drag-over')}});board.addEventListener('dragleave',e=>{const drop=e.target.closest('[data-drop]');if(drop&&!drop.contains(e.relatedTarget))drop.classList.remove('drag-over')});board.addEventListener('drop',e=>{const drop=e.target.closest('[data-drop]');if(drop){e.preventDefault();const id=e.dataTransfer.getData('text/plain');tasks=tasks.map(t=>t.id===id?{...t,status:drop.dataset.drop}:t);save()}});
+$('#search').addEventListener('input',e=>{query=e.target.value;render()});$('#priorityFilter').addEventListener('change',e=>{priority=e.target.value;render()});$('#sortBtn').onclick=()=>{sortNewest=!sortNewest;$('#sortBtn').innerHTML=sortNewest?'↕ <span>Newest</span>':'↕ <span>Oldest</span>';render()};
+$('#boardTab').onclick=()=>{$('#boardTab').classList.add('selected');$('#listTab').classList.remove('selected');board.classList.remove('hidden');list.classList.add('hidden')};$('#listTab').onclick=()=>{$('#listTab').classList.add('selected');$('#boardTab').classList.remove('selected');list.classList.remove('hidden');board.classList.add('hidden')};
+function setFilter(f){activeFilter=f;$('.breadcrumb strong').textContent=f==='today'?'Due today':f==='upcoming'?'Upcoming':'My board';document.querySelectorAll('.nav-item').forEach(x=>x.classList.remove('active'));(f==='today'?$('#todayNav'):f==='upcoming'?$('#upcomingNav'):document.querySelector('.nav-item')).classList.add('active');render()}$('#todayNav').onclick=()=>setFilter(activeFilter==='today'?'all':'today');$('#upcomingNav').onclick=()=>setFilter(activeFilter==='upcoming'?'all':'upcoming');document.querySelector('.nav-item.active').onclick=()=>setFilter('all');
+$('#helpBtn').onclick=()=>$('#helpPop').classList.toggle('hidden');document.addEventListener('keydown',e=>{if(e.key==='Escape')$('#helpPop').classList.add('hidden');if(dialog.open)return;if((e.key==='n'||e.key==='N')&&!e.metaKey&&!e.ctrlKey&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();openTask()}if((e.key==='/'||e.metaKey&&e.key==='k')&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();$('#search').focus()}});render();
+})();
