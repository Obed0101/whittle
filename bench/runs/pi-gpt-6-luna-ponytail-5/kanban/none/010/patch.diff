+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="theme-color" content="#f7f6f2"><title>Daymark — Personal board</title>
+  <link rel="stylesheet" href="style.css">
+</head>
+<body>
+<div class="app-shell">
+  <aside class="sidebar">
+    <a class="brand" href="#"><span class="brand-mark">d<span>·</span></span><span>daymark<small>YOUR PERSONAL WORKSPACE</small></span></a>
+    <div class="side-label">WORKSPACE</div>
+    <button class="nav-item active"><span class="nav-icon">▦</span> My board <span class="nav-count" id="totalCount">0</span></button>
+    <button class="nav-item" id="todayNav"><span class="nav-icon">◷</span> Due today <span class="nav-count" id="todayCount">0</span></button>
+    <button class="nav-item" id="upcomingNav"><span class="nav-icon">⌁</span> Upcoming</button>
+    <div class="side-label projects-label">YOUR FOCUS</div>
+    <div class="focus-note"><span class="focus-dot"></span><span><strong>Make room for what matters.</strong><small>A little progress, every day.</small></span></div>
+    <div class="sidebar-bottom"><div class="avatar">Y</div><span><strong>Your space</strong><small>Just for you</small></span><span class="more-dots">···</span></div>
+  </aside>
+  <main class="main">
+    <header class="topbar"><div class="breadcrumb">Workspace <span>/</span> <strong>My board</strong></div><div class="top-actions"><span class="saved-status" id="savedStatus">✓ Saved on this device</span><button class="icon-button" id="helpBtn" title="Keyboard shortcuts">?</button><div class="avatar small-avatar">Y</div></div></header>
+    <section class="content">
+      <div class="heading-row"><div><div class="eyebrow"><span class="sun">✳</span> YOUR SPACE, YOUR PACE</div><h1>My board<span class="title-period">.</span></h1><p class="subtitle">A clear mind starts with a clear plan.</p></div><button class="primary-button" id="addTask"><span>＋</span> New task <kbd>N</kbd></button></div>
+      <div class="toolbar"><div class="view-tabs"><button class="view-tab selected" id="boardTab">Board</button><button class="view-tab" id="listTab">List</button></div><div class="toolbar-right"><label class="search-wrap"><span>⌕</span><input id="search" type="search" placeholder="Find a task..." aria-label="Find a task"><kbd>⌘ K</kbd></label><select id="priorityFilter" aria-label="Filter by priority"><option value="all">All priorities</option><option value="high">High priority</option><option value="medium">Medium priority</option><option value="low">Low priority</option></select><button class="sort-button" id="sortBtn">↕ <span>Sort</span></button></div></div>
+      <div id="boardView" class="board-grid"></div>
+      <div id="listView" class="list-view hidden"></div>
+      <footer class="board-footer"><span><span class="footer-spark">✳</span> Small steps still move you forward.</span><span id="footerCount"></span></footer>
+    </section>
+  </main>
+</div>
+<div class="toast" id="toast" role="status"></div>
+<dialog id="taskDialog"><form id="taskForm"><div class="modal-head"><div><div class="eyebrow">MAKE IT HAPPEN</div><h2 id="dialogTitle">New task</h2></div><button type="button" class="close-button" id="closeDialog" aria-label="Close">×</button></div><label class="field-label" for="taskTitle">What needs doing?</label><input class="title-input" id="taskTitle" name="title" placeholder="Give your task a name" required maxlength="100"><label class="field-label" for="taskDescription">A few details <span class="optional">OPTIONAL</span></label><textarea id="taskDescription" name="description" rows="3" placeholder="Add a note, link, or next step..."></textarea><div class="form-row"><div><label class="field-label" for="taskStatus">Column</label><select id="taskStatus" name="status"><option value="todo">To do</option><option value="doing">In progress</option><option value="done">Done</option></select></div><div><label class="field-label" for="taskPriority">Priority</label><select id="taskPriority" name="priority"><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option></select></div><div><label class="field-label" for="taskDue">Due date</label><input id="taskDue" name="due" type="date"></div></div><div class="modal-actions"><button type="button" class="cancel-button" id="cancelDialog">Cancel</button><button class="primary-button" type="submit" id="saveTask">Add task <span>→</span></button></div><input type="hidden" id="taskId"></form></dialog>
+<div class="help-pop hidden" id="helpPop"><strong>Keyboard shortcuts</strong><p><kbd>N</kbd> New task</p><p><kbd>/</kbd> Search tasks</p><p><kbd>Esc</kbd> Close dialog</p></div>
+<script src="app.js"></script>
+</body></html>
