if(existing)Object.assign(existing,t);else tasks.push(t);persist();close();toast(existing?'Task updated':'Task added')};$('#delete-task').onclick=()=>{const id=$('#task-id').value,t=tasks.find(x=>x.id===id);if(t&&confirm(`Delete “${t.title}”? This can't be undone.`)){tasks=tasks.filter(x=>x.id!==id);persist();close();toast('Task deleted')}};$('#search').oninput=e=>{query=e.target.value.toLowerCase();render()};$('#filter-priority').onchange=e=>{filter=e.target.value;render()};$('#sort-btn').onclick=()=>{sortMode=(sortMode+1)%3;$('#sort-btn').innerHTML=sortMode===1?'↕ <span>Due date</span>':sortMode===2?'↕ <span>Newest</span>':'↕ <span>Sort</span>';render()};$$('[data-drop]').forEach(zone=>{zone.ondragover=e=>{e.preventDefault();zone.classList.add('drag-over')};zone.ondragleave=()=>zone.classList.remove('drag-over');zone.ondrop=e=>{e.preventDefault();zone.classList.remove('drag-over');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=zone.dataset.drop;persist()}}});$('#theme-btn').onclick=()=>{document.body.classList.toggle('dark');localStorage.setItem('daymark-dark',document.body.classList.contains('dark')?'1':'0')};if(localStorage.getItem('daymark-dark')==='1')document.body.classList.add('dark');$('#focus-nav').onclick=()=>{filter='all';$('#filter-priority').value='all';$$('.column').forEach(c=>c.hidden=c.dataset.status==='done');toast(`${tasks.filter(t=>t.status!=='done').length} tasks to focus on`)};$$('.nav-item.active').forEach(b=>b.onclick=()=>$$('.column').forEach(c=>c.hidden=false));$('#list-view').onclick=()=>toast('Board view keeps things simple — list view is coming soon.');$('#help-btn').onclick=()=>toast('Shortcuts: N add task · / search · Esc close');document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!modal.hidden)close();if(e.key==='n'&&!modal.hidden===false&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();openTask()}if(e.key==='/'&&modal.hidden&&!['INPUT','TEXTAREA'].includes