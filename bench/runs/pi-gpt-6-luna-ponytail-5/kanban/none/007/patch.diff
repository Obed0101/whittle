+(()=>{'use strict';const KEY='daymark-board-v1';const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];const statuses=['todo','doing','done'];let tasks=[];try{tasks=JSON.parse(localStorage.getItem(KEY)||'[]');if(!Array.isArray(tasks))tasks=[]}catch{tasks=[]}let filter='all',query='',sortMode=0,toastTimer;const modal=$('#modal'),form=$('#task-form');const persist=()=>{localStorage.setItem(KEY,JSON.stringify(tasks));render()};const esc=s=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function toast(msg){const el=$('#toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200)}function dateText(v){if(!v)return '';const d=new Date(v+'T00:00:00');return d.toLocaleDateString(undefined,{month:'short',day:'numeric'})}function render(){let visible=tasks.filter(t=>(filter==='all'||t.priority===filter)&&(!query||`${t.title} ${t.description} ${t.label}`.toLowerCase().includes(query)));if(sortMode)visible.sort((a,b)=>sortMode===1?(a.due||'9999').localeCompare(b.due||'9999'):b.created-a.created);for(const status of statuses){const list=$(`[data-drop="${status}"]`),items=visible.filter(t=>t.status===status);$(`[data-status="${status}"] .count`).textContent=items.length;list.innerHTML=items.map(t=>`<article class="task-card" draggable="true" data-id="${esc(t.id)}" tabindex="0" aria-label="${esc(t.title)}"><div class="card-top">${t.priority!=='none'?`<span class="priority ${esc(t.priority)}">${esc(t.priority[0].toUpperCase()+t.priority.slice(1))}</span>`:'<span></span>'}<button class="card-menu" data-edit="${esc(t.id)}" aria-label="Edit task">···</button></div><h3>${esc(t.title)}</h3>${t.description?`<p>${esc(t.description)}</p>`:''}<div class="card-meta">${t.label?`<span class="label-pill">${esc(t.label)}</span>`:''}${t.due?`<span class="due ${t.due<new Date().toISOString().slice(0,10)&&status!=='done'?'overdue':''}">${t.due<new