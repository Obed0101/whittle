+  <div class="side-label">WORKSPACE</div>
+  <nav><button class="nav-item active"><span>▦</span> My board <span class="nav-count" id="side-count">0</span></button><button class="nav-item" id="focus-nav"><span>◷</span> Focus today</button></nav>
