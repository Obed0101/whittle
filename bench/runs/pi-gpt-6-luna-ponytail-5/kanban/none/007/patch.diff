+      <section class="column" data-status="doing"><header class="column-head"><div><span class="status-dot doing-dot"></span><h2>In progress</h2><span class="count">0</span></div><button class="column-add" data-add="doing" title="Add to In progress">＋</button></header><div class="task-list" data-drop="doing"></div><button class="quick-add" data-add="doing">＋ <span>Add a task</span></button></section>
+      <section class="column" data-status="done"><header class="column-head"><div><span class="status-dot done-dot"></span><h2>Done</h2><span class="count">0</span></div><button class="column-add" data-add="done" title="Add to Done">＋</button></header><div class="task-list" data-drop="done"></div><button class="quick-add" data-add="done">＋ <span>Add a task</span></button></section>
+    </div>
