+</aside>
+<main class="main">
+  <header class="topbar"><div class="breadcrumb">My workspace <span>/</span> <b>Personal board</b></div><div class="top-actions"><button class="icon-btn" id="help-btn" title="Keyboard shortcuts">⌘</button><button class="icon-btn" id="theme-btn" title="Toggle dark mode">◐</button><span class="top-avatar">M</span></div></header>
+  <section class="content">
+    <div class="board-heading"><div><div class="eyebrow"><span class="live-dot"></span> YOUR SPACE, YOUR PACE</div><h1>Personal board <button class="title-menu" title="Board options">⌄</button></h1><p class="subtitle">Make room for what matters.</p></div><button class="primary-btn" id="add-task"><span>＋</span> Add a task <kbd>N</kbd></button></div>
+    <div class="toolbar"><div class="view-tabs"><button class="view-tab active">Board</button><button class="view-tab" id="list-view">List <span class="soon">↗</span></button></div><div class="tools"><label class="search"><span>⌕</span><input id="search" type="search" placeholder="Search tasks..." aria-label="Search tasks"><kbd>/</kbd></label><select id="filter-priority" aria-label="Filter by priority"><option value="all">All priorities</option><option value="high">High priority</option><option value="medium">Medium priority</option><option value="low">Low priority</option></select><button class="sort-btn" id="sort-btn">↕ <span>Sort</span></button></div></div>
