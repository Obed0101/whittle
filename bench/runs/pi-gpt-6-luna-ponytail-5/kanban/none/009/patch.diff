+(()=>{'use strict';const KEY='daymark-board-v1';const columns=[['todo','To do'],['progress','In progress'],['done','Done']];const today=new Date();today.setHours(0,0,0,0);const isoToday=()=>new Date().toISOString().slice(0,10);const uid=()=>Math.random().toString(36).slice(2,10);const sample=[{id:uid(),title:'Plan the week ahead',description:'Choose the three things that would make this week feel meaningful.',status:'todo',priority:'high',due:isoToday(),created:Date.now()-300000},{id:uid(),title:'Book a dentist appointment',description:'Call the clinic on Oak Street.',status:'todo',priority:'normal',due:'',created:Date.now()-200000},{id:uid(),title:'Read for 20 minutes',description:'Pick up where I left off in The Creative Act.',status:'todo',priority:'low',due:'',created:Date.now()-100000},{id:uid(),title:'Review monthly budget',description:'',status:'progress',priority:'normal',due:'',created:Date.now()-80000},{id:uid(),title:'Tidy up the workspace',description:'Clear the desk and sort loose notes.',status:'done',priority:'low',due:'',created:Date.now()-50000}];let tasks=load(),filter='all',view='board',editing=null,dragId=null,toastTimer;const $=id=>document.getElementById(id);function load(){try{const data=JSON.parse(localStorage.getItem(KEY));if(Array.isArray(data))return data.filter(x=>x&&x.id&&x.title).map(x=>({...x,status:columns.some(c=>c[0]===x.status)?x.status:'todo',priority:['low','normal','high'].includes(x.priority)?x.priority:'normal'}))}catch(e){}return sample}function save(){localStorage.setItem(KEY,JSON.stringify(tasks));render()}function dateLabel(){const d=new Date();$('dateLabel').textContent=d.toLocaleDateString(undefined,{weekday:'short',month:'short',day:'numeric'})}function dueInfo(t){if(!t.due)return null;const d=new Date(t.due+'T00:00:00');const diff=Math.round((d-today)/86400000);return{diff,label:diff===0?'Today':diff===1?'Tomorrow':diff===-1?'Yesterday':d.toLocaleDateString(undefined,{month:'short',day:'numeric'})}}function visible(t){if(view==='today')return t.status!=='done'&&t.due===isoToday();if(view==='overdue')return t.status!=='done'&&t.due&&t.due<isoToday();if(view==='done')return t.status==='done';if(filter==='active'&&t.status==='done')return false;if(filter==='priority'&&t.priority!=='high')return false;const q=$('search').value.trim().toLowerCase();return !q||[t.title,t.description,t.priority].join(' ').toLowerCase().includes(q)}function render(){const board=$('board');board.innerHTML='';for(const [status,label] of columns){let items=tasks.filter(t=>t.status===status&&visible(t));const sort=$('sort').value;if(sort==='due')items.sort((a,b)=>(a.due||'9999').localeCompare(b.due||'9999'));if(sort==='priority'){const rank={high:0,normal:1,low:2};items.sort((a,b)=>rank[a.priority]-rank[b.priority])}if(sort==='created')items.sort((a,b)=>b.created-a.created);const col=document.createElement('section');col.className='column';col.dataset.status=status;col.innerHTML=`<div class="column-head"><span class="dot"></span><h2>${label}</h2><span class="column-count">${items.length}</span><button class="add-inline" aria-label="Add task to ${label}" title="Add task">＋</button></div><div class="cards"></div>`;const cards=col.querySelector('.cards');col.querySelector('.add-inline').onclick=()=>openForm(null,status);if(items.length===0){const empty=document.createElement('div');empty.className='empty';empty.innerHTML=`${view==='board'?'Nothing here just yet.':'No matching tasks.'}${view==='board'&&status==='todo'?'<button type="button">Add your first task</button>':''}`;const add=empty.querySelector('button');if(add)add.onclick=()=>openForm(null,status);cards.append(empty)}items.forEach(t=>cards.append(makeCard(t)));col.addEventListener('dragover',e=>{e.preventDefault();col.classList.add('drag-over')});col.addEventListener('dragleave',()=>col.classList.remove('drag-over'));col.addEventListener('drop',e=>{e.preventDefault();col.classList.remove('drag-over');const t=tasks.find(x=>x.id===dragId);if(t){t.status=status;save();notify('Task moved to '+label.toLowerCase())}});board.append(col)}const active=tasks.filter(t=>t.status!=='done'),overdue=active.filter(t=>t.due&&t.due<isoToday());$('todayCount').textContent=active.filter(t=>t.due===isoToday()).length||'';$('overdueCount').textContent=overdue.length||'';const weekStart=new Date(today);weekStart.setDate(today.getDate()-today.getDay());const week=tasks.filter(t=>t.status==='done'&&t.completedAt&&t.completedAt>=weekStart.getTime());const pct=week.length?Math.min(100,week.length/5*100):0;$('weekProgress').style.width=pct+'%';$('weekCount').textContent=`${week.length} / 5 done`;$('focusText').textContent=week.length>=5?'A lovely week of progress.':`${5-week.length} small win${5-week.length===1?'':'s'} to your weekly goal.`;document.querySelectorAll('.nav-item').forEach(b=>b.classList.toggle('active',b.dataset.view===view));document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('active',b.dataset.filter===filter))}function makeCard(t){const card=document.createElement('article');card.className='card';card.draggable=true;card.dataset.id=t.id;const top=document.createElement('div');top.className='card-top';const title=document.createElement('div');title.className='card-title';title.textContent=t.title;const more=document.createElement('button');more.className='more';more.type='button';more.textContent='···';more.title='Edit task';more.setAttribute('aria-label','Edit '+t.title);more.onclick=()=>openForm(t.id);top.append(title,more);card.append(top);if(t.description){const desc=document.createElement('div');desc.className='card-desc';desc.textContent=t.description;card.append(desc)}const tag=document.createElement('span');tag.className='tag '+(t.priority==='high'?'urgent':t.priority==='normal'?'normal':'');tag.textContent=t.priority==='high'?'High priority':t.priority==='normal'?'Normal':'Low';card.append(tag);const foot=document.createElement('div');foot.className='card-footer';const due=dueInfo(t);const dueEl=document.createElement('span');dueEl.className='due'+(due&&due.diff<0&&t.status!=='done'?' late':due&&due.diff===0?' today':due&&due.diff===1?' soon':'');dueEl.textContent=due?'◷ '+due.label:'';foot.append(dueEl);if(t.status!=='done'){const check=document.createElement('button');check.className='card-check';check.type='button';check.textContent='✓ Done';check.onclick=()=>{t.status='done';t.completedAt=Date.now();save();notify('Nice work — task completed')};foot.append(check)}else{const done=document.createElement('span');done.className='card-check';done.textContent='✓ Complete';foot.append(done)}card.append(foot);card.addEventListener('dragstart',()=>{dragId=t.id;card.classList.add('dragging')});card.addEventListener('dragend',()=>card.classList.remove('dragging'));card.addEventListener('dblclick',()=>openForm(t.id));return card}function openForm(id,status='todo'){editing=id;const t=tasks.find(x=>x.id===id);$('formTitle').textContent=t?'Edit task':'New task';$('titleInput').value=t?.title||'';$('descriptionInput').value=t?.description||'';$('statusInput').value=t?.status||status;$('priorityInput').value=t?.priority||'normal';$('dueInput').value=t?.due||'';$('deleteBtn').hidden=!t;$('overlay').hidden=false;setTimeout(()=>$('titleInput').focus(),30)}function closeForm(){$('overlay').hidden=true;editing=null}function notify(text){const el=$('toast');el.textContent=text;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200)}$('taskForm').onsubmit=e=>{e.preventDefault();const title=$('titleInput').value.trim();if(!title)return;const data={title,description:$('descriptionInput').value.trim(),status:$('statusInput').value,priority:$('priorityInput').value,due:$('dueInput').value};if(editing){Object.assign(tasks.find(x=>x.id===editing),data)}else tasks.unshift({id:uid(),...data,created:Date.now()});closeForm();save();notify(editing?'Task updated':'Task added')};$('deleteBtn').onclick=()=>{if(editing&&confirm('Delete this task? This cannot be undone.')){tasks=tasks.filter(t=>t.id!==editing);closeForm();save();notify('Task deleted')}};$('newBtn').onclick=()=>openForm();$('closeBtn').onclick=$('cancelBtn').onclick=closeForm;$('overlay').onclick=e=>{if(e.target===$('overlay'))closeForm()};document.addEventListener('keydown',e=>{if(e.key==='Escape')closeForm();if((e.metaKey||e.ctrlKey)&&e.key==='Enter'&&!$('overlay').hidden)$('taskForm').requestSubmit()});$('search').oninput=render;$('sort').onchange=render;document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;view='board';render()});document.querySelectorAll('.nav-item').forEach(b=>b.onclick=()=>{view=b.dataset.view;filter='all';$('search').value='';render();$('sidebar').classList.remove('open')});$('menuBtn').onclick=()=>$('sidebar').classList.toggle('open');$('exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify({app:'daymark',version:1,tasks},null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='daymark-backup-'+isoToday()+'.json';a.click();URL.revokeObjectURL(a.href);notify('Board backup downloaded')};$('importBtn').onclick=()=>$('fileInput').click();$('fileInput').onchange=async e=>{try{const data=JSON.parse(await e.target.files[0].text()),list=Array.isArray(data)?data:data.tasks;if(!Array.isArray(list)||list.some(t=>!t.title))throw Error();if(confirm(`Replace your board with ${list.length} imported tasks?`)){tasks=list.map(t=>({id:t.id||uid(),title:String(t.title).slice(0,120),description:String(t.description||'').slice(0,600),status:columns.some(c=>c[0]===t.status)?t.status:'todo',priority:['low','normal','high'].includes(t.priority)?t.priority:'normal',due:t.due||'',created:t.created||Date.now(),completedAt:t.completedAt}));save();notify('Board restored')}}catch(err){alert('That file does not look like a Daymark backup.')}e.target.value=''};dateLabel();render()})();
