+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="theme-color" content="#f7f7f5">
+  <title>Daymark — Personal board</title>
+  <link rel="stylesheet" href="styles.css">
+</head>
+<body>
+  <div class="app-shell">
+    <aside class="sidebar">
+      <a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">d</span><span>daymark</span></a>
+      <div class="workspace-label">WORKSPACE</div>
+      <button class="workspace-switch"><span class="workspace-avatar">Y</span><span class="workspace-name">Your workspace</span><span class="chevron">⌄</span></button>
+      <div class="nav-label">MENU</div>
+      <nav class="main-nav" aria-label="Main navigation">
+        <button class="nav-item active" data-view="board"><span class="nav-icon">▦</span>My board</button>
+        <button class="nav-item" data-view="today"><span class="nav-icon">◷</span>Due today<span class="nav-count" id="todayCount">0</span></button>
+        <button class="nav-item" data-view="completed"><span class="nav-icon">✓</span>Completed</button>
+      </nav>
+      <div class="sidebar-bottom">
+        <div class="focus-card"><div class="focus-spark">✳</div><strong>A little progress<br>goes a long way.</strong><p>Keep showing up. You're doing great.</p><div class="focus-dots"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div></div>
+        <button class="profile"><span class="profile-avatar">J</span><span><strong>Jamie Parker</strong><small>Personal plan</small></span><span class="profile-more">···</span></button>
+      </div>
+    </aside>
+    <main class="main">
+      <header class="topbar"><div class="breadcrumbs"><span>Workspace</span><b>/</b><strong id="crumb">My board</strong></div><div class="top-actions"><span class="saved-status"><i></i> All changes saved</span><button class="icon-button" id="helpBtn" aria-label="Keyboard shortcuts" title="Keyboard shortcuts">?</button><button class="avatar-small">J</button></div></header>
+      <section class="content">
+        <div class="heading-row"><div><div class="eyebrow" id="dateLabel">YOUR SPACE · TODAY</div><h1 id="pageTitle">My board<span class="title-period">.</span></h1><p class="subtitle" id="pageSubtitle">A clear mind starts with a clear plan.</p></div><button class="primary-button" id="addTask"><span>＋</span> Add a task <kbd>N</kbd></button></div>
+        <div class="toolbar"><div class="board-tabs"><button class="tab active" data-filter="all">Everything <span id="allCount">0</span></button><button class="tab" data-filter="priority">High priority <span id="priorityCount">0</span></button></div><div class="tools"><label class="search-box"><span>⌕</span><input id="search" type="search" placeholder="Search tasks…" aria-label="Search tasks"><kbd>/</kbd></label><button class="filter-button" id="sortBtn" title="Sort tasks">↕ <span>Sort</span></button></div></div>
+        <div class="board" id="board" aria-label="Kanban board"></div>
+        <footer class="board-footer"><span><span class="shortcut">N</span> new task <span class="footer-sep">·</span> drag cards to move them</span><button id="clearDone" class="clear-done">Clear completed</button></footer>
+      </section>
+    </main>
+  </div>
+  <div class="toast" id="toast" role="status"></div>
+  <dialog id="taskDialog" class="task-dialog"><form id="taskForm"><div class="dialog-head"><div><span class="dialog-kicker">TASK DETAILS</span><h2 id="dialogTitle">Add a task</h2></div><button type="button" class="close-button" id="closeDialog" aria-label="Close">×</button></div><input type="hidden" id="taskId"><label class="field-label" for="taskName">What needs doing?</label><input id="taskName" class="text-field" maxlength="120" placeholder="Give your task a name…" required><label class="field-label" for="taskDescription">A few details <span>OPTIONAL</span></label><textarea id="taskDescription" class="text-field" rows="3" maxlength="500" placeholder="Add notes, links, or next steps…"></textarea><div class="field-grid"><div><label class="field-label" for="taskStatus">Column</label><select id="taskStatus" class="text-field"><option value="todo">To do</option><option value="doing">In progress</option><option value="done">Done</option></select></div><div><label class="field-label" for="taskPriority">Priority</label><select id="taskPriority" class="text-field"><option value="normal">Normal</option><option value="high">High priority</option><option value="low">Low priority</option></select></div></div><div class="field-grid"><div><label class="field-label" for="taskDue">Due date</label><input id="taskDue" type="date" class="text-field"></div><div><label class="field-label" for="taskTag">Label</label><input id="taskTag" class="text-field" maxlength="24" placeholder="e.g. Personal"></div></div><div class="dialog-actions"><button type="button" id="deleteTask" class="delete-button">Delete task</button><button type="button" class="cancel-button" id="cancelDialog">Cancel</button><button class="primary-button save-button" type="submit">Save task <span>→</span></button></div></form></dialog>
+  <dialog id="helpDialog" class="help-dialog"><button class="close-button help-close" id="closeHelp">×</button><span class="dialog-kicker">A FEW SHORTCUTS</span><h2>Work a little faster.</h2><div class="shortcut-row"><span>Add a new task</span><kbd>N</kbd></div><div class="shortcut-row"><span>Focus search</span><kbd>/</kbd></div><div class="shortcut-row"><span>Close dialog</span><kbd>Esc</kbd></div><p>Everything is saved automatically in this browser.</p></dialog>
+  <script src="app.js"></script>
+</body>
+</html>
