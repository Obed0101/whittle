+  $('#deleteTask').onclick=()=>{let id=$('#taskId').value;if(id&&confirm('Delete this task? This cannot be undone.')){tasks=tasks.filter(t=>t.id!==id);persist();dialog.close();render();toast('Task deleted')}};
+  $('#addTask').onclick=()=>openTask();$('#closeDialog').onclick=$('#cancelDialog').onclick=()=>dialog.close();dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});
