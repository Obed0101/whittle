+(() => {
+  const KEY='daymark-board-v1';
+  const defaults=[
+    {id:'welcome-1',title:'Plan a slow Sunday morning',description:'Coffee, a good book, and absolutely no rushing.',status:'todo',priority:'normal',tag:'Personal',due:'',created:1},
+    {id:'welcome-2',title:'Book annual check-up',description:'Call the clinic and ask for an appointment in June.',status:'todo',priority:'high',tag:'Life admin',due:'',created:2},
+    {id:'welcome-3',title:'Water the balcony plants',description:'The basil is looking a little dramatic.',status:'todo',priority:'low',tag:'Home',due:'',created:3},
+    {id:'welcome-4',title:'Sort out the hallway shelf',description:'Measure first, then look for something secondhand.',status:'doing',priority:'normal',tag:'Home',due:'',created:4},
+    {id:'welcome-5',title:'Read 20 pages',description:'Pick up where you left off in the green book.',status:'doing',priority:'normal',tag:'For me',due:'',created:5},
+    {id:'welcome-6',title:'Send the birthday card',description:'A little note goes a long way.',status:'done',priority:'normal',tag:'Personal',due:'',created:6}
+  ];
+  const columns=[['todo','To do'],['doing','In progress'],['done','Done']];
+  const $=s=>document.querySelector(s); const board=$('#board'), dialog=$('#taskDialog'), form=$('#taskForm');
+  let tasks=load(), filter='all', view='board', query='', sortNewest=false, toastTimer;
+  function load(){try{const x=JSON.parse(localStorage.getItem(KEY));return Array.isArray(x)?x:defaults.map(t=>({...t}))}catch{return defaults.map(t=>({...t}))}}
+  function persist(){localStorage.setItem(KEY,JSON.stringify(tasks));$('.saved-status').innerHTML='<i></i> All changes saved'}
+  function escape(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
+  function dateLabel(){const d=new Date();$('#dateLabel').textContent='YOUR SPACE · '+d.toLocaleDateString(undefined,{weekday:'long',month:'long',day:'numeric'}).toUpperCase()}
+  function visibleTasks(){return tasks.filter(t=>{if(view==='today'&&(!t.due||t.due!==new Date().toISOString().slice(0,10)||t.status==='done'))return false;if(view==='completed'&&t.status!=='done')return false;if(view==='board'&&filter==='priority'&&t.priority!=='high')return false;return !query||[t.title,t.description,t.tag].join(' ').toLowerCase().includes(query.toLowerCase())})}
+  function render(){dateLabel();let active=tasks.filter(t=>t.status!=='done');$('#allCount').textContent=active.length;$('#priorityCount').textContent=active.filter(t=>t.priority==='high').length;$('#todayCount').textContent=active.filter(t=>t.due===new Date().toISOString().slice(0,10)).length;let shown=visibleTasks();board.innerHTML='';
+    if(view==='completed'){$('#pageTitle').innerHTML='Completed<span class="title-period">.</span>';$('#crumb').textContent='Completed';$('#pageSubtitle').textContent='Look at everything you have already done.'}
+    else if(view==='today'){$('#pageTitle').innerHTML='Due today<span class="title-period">.</span>';$('#crumb').textContent='Due today';$('#pageSubtitle').textContent='A gentle nudge for what needs attention today.'}
+    else{$('#pageTitle').innerHTML='My board<span class="title-period">.</span>';$('#crumb').textContent='My board';$('#pageSubtitle').textContent='A clear mind starts with a clear plan.'}
+    columns.forEach(([status,label])=>{let col=document.createElement('section');col.className='column '+status;col.dataset.status=status;let items=shown.filter(t=>t.status===status);col.innerHTML=`<div class="column-head"><i class="column-dot"></i><span class="column-title">${label}</span><span class="column-count">${items.length}</span><button class="column-add" aria-label="Add task to ${label}" title="Add task">＋</button></div><div class="card-list"></div>`;let list=col.querySelector('.card-list');if(sortNewest)items=[...items].sort((a,b)=>b.created-a.created);if(items.length)items.forEach(t=>list.append(card(t)));else list.innerHTML=`<div class="empty-state"><b>${query?'No matches here':'Nothing here yet'}</b>${query?'Try another search.':'Add a task or drop one here.'}</div>`;col.querySelector('.column-add').onclick=()=>openTask(null,status);col.addEventListener('dragover',e=>{e.preventDefault();col.classList.add('drag-over')});col.addEventListener('dragleave',e=>{if(!col.contains(e.relatedTarget))col.classList.remove('drag-over')});col.addEventListener('drop',e=>{e.preventDefault();col.classList.remove('drag-over');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=status;persist();render()}});board.append(col)});
+    $('#clearDone').style.visibility=tasks.some(t=>t.status==='done')?'visible':'hidden';document.querySelectorAll('.nav-item').forEach(n=>n.classList.toggle('active',n.dataset.view===view));document.querySelectorAll('.tab').forEach(n=>n.classList.toggle('active',n.dataset.filter===filter));}
+  function card(t){let el=document.createElement('article');el.className='task-card';el.draggable=true;el.dataset.id=t.id;let tagClass=/home|admin/i.test(t.tag||'')?'orange':/me|work/i.test(t.tag||'')?'purple':'';let due='';if(t.due){let d=new Date(t.due+'T00:00:00'),today=new Date();today.setHours(0,0,0,0);let diff=Math.round((d-today)/86400000);due=`<span class="due ${diff<0&&t.status!=='done'?'overdue':diff<=1&&t.status!=='done'?'soon':''}">${diff===0?'◷ Today':diff===1?'◷ Tomorrow':diff<0&&t.status!=='done'?`◷ ${Math.abs(diff)}d overdue`:'◷ '+d.toLocaleDateString(undefined,{month:'short',day:'numeric'})}</span>`}else due='<span class="due"></span>';el.innerHTML=`<div class="card-top">${t.tag?`<span class="tag ${tagClass}">${escape(t.tag)}</span>`:'<span></span>'}<button class="card-menu" aria-label="Edit task" title="Edit task">···</button></div><h3>${escape(t.title)}</h3>${t.description?`<p>${escape(t.description)}</p>`:''}<div class="card-bottom">${due}<span class="priority ${t.priority==='low'?'low':''}">${t.priority==='high'?'<span class="priority-mark">▲</span> High':t.priority==='low'?'↓ Low':''}</span></div>`;el.onclick=e=>{if(!e.target.closest('.card-menu'))openTask(t.id)};el.querySelector('.card-menu').onclick=e=>{e.stopPropagation();openTask(t.id)};el.addEventListener('dragstart',e=>{e.dataTransfer.setData('text/plain',t.id);e.dataTransfer.effectAllowed='move';setTimeout(()=>el.classList.add('dragging'),0)});el.addEventListener('dragend',()=>el.classList.remove('dragging'));return el}
+  function openTask(id,status='todo'){let t=tasks.find(x=>x.id===id);$('#dialogTitle').textContent=t?'Edit task':'Add a task';$('#taskId').value=t?.id||'';$('#taskName').value=t?.title||'';$('#taskDescription').value=t?.description||'';$('#taskStatus').value=t?.status||status;$('#taskPriority').value=t?.priority||'normal';$('#taskDue').value=t?.due||'';$('#taskTag').value=t?.tag||'';$('#deleteTask').style.visibility=t?'visible':'hidden';dialog.showModal();setTimeout(()=>$('#taskName').focus(),50)}
+  function toast(msg){let el=$('#toast');el.textContent=msg;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2200)}
