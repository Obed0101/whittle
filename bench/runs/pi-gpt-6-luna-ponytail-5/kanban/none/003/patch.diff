+(()=>{'use strict';const KEY='daymark-board-v1',columns=[['todo','To do'],['doing','In progress'],['done','Done']];let tasks=[],filter='all',query='',sort='manual',editing=null,focusOnly=false,toastTimer;const $=s=>document.querySelector(s),board=$('#board'),dialog=$('#taskDialog'),form=$('#taskForm');const today=()=>{let d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`};const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,7);function load(){try{const x=JSON.parse(localStorage.getItem(KEY));if(Array.isArray(x))tasks=x.filter(t=>t&&t.id&&t.title)}catch{}if(!tasks.length){tasks=[{id:uid(),title:'Plan a slower morning',details:'Leave a little room before the day gets busy.',status:'todo',priority:'low',tag:'Personal',due:'',created:Date.now()-5000},{id:uid(),title:'Send the notes from Thursday',details:'Pull together the decisions and share with the team.',status:'todo',priority:'high',tag:'Work',due:today(),created:Date.now()-4000},{id:uid(),title:'Book a table for Saturday',details:'Somewhere new, somewhere with good light.',status:'doing',priority:'medium',tag:'Life admin',due:'',created:Date.now()-3000},{id:uid(),title:'Pick up a few groceries',details:'Oat milk, lemons, something green.',status:'doing',priority:'low',tag:'Personal',due:'',created:Date.now()-2000},{id:uid(),title:'Take an actual lunch break',details:'Walk around the block. No scrolling.',status:'done',priority:'medium',tag:'Wellbeing',due:'',created:Date.now()-1000,completed:Date.now()}];save()}}function save(){localStorage.setItem(KEY,JSON.stringify(tasks));render()}function esc(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function showToast(s){let e=$('#toast');e.textContent=s;e.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>e.classList.remove('show'),2300)}function visible(t){if(focusOnly&&t.status==='done')return false;if(filter==='today'&&t.due!==today())return false;if(filter==='priority'&&t.priority!=='high')return false;if(query&&!`${t.title} ${t.details} ${t.tag}`.toLowerCase().includes(query))return false;return true}function render(){let open=tasks.filter(t=>t.status!=='done').length,due=tasks.filter(t=>t.status!=='done'&&t.due===today()).length,done=tasks.filter(t=>t.status==='done').length;$('#openCount').textContent=open;$('#dueCount').textContent=due;$('#doneCount').textContent=done;$('#allCount').textContent=tasks.length;let week=tasks.filter(t=>t.completed&&Date.now()-t.completed<7*864e5).length;$('#momentumText').textContent=`${Math.min(week,5)} / 5 tasks`;$('#momentumBar').style.width=`${Math.min(week/5*100,100)}%`;$('#todayLabel').textContent=new Intl.DateTimeFormat(undefined,{weekday:'long',month:'long',day:'numeric'}).format(new Date()).toUpperCase();board.innerHTML='';for(const [status,name] of columns){let col=document.createElement('section');col.className=`column ${status}`;col.dataset.status=status;col.innerHTML=`<div class="column-head"><i class="column-mark"></i><strong>${name}</strong><span class="count">${tasks.filter(t=>t.status===status).length}</span><button class="column-add" aria-label="Add task to ${name}" title="Add task">＋</button></div><div class="task-list"></div>`;let list=col.querySelector('.task-list'),arr=tasks.filter(t=>t.status===status&&visible(t));if(sort!=='manual')arr.sort((a,b)=>sort==='due'?((a.due||'9999').localeCompare(b.due||'9999')):sort==='priority'?({high:0,medium:1,low:2}[a.priority]-{high:0,medium:1,low:2}[b.priority]):(b.created||0)-(a.created||0));for(const t of arr)list.append(makeCard(t));if(!arr.length){let empty=document.createElement('div');empty.className='empty-column';empty.innerHTML=tasks.some(t=>t.status===status)?'No matching tasks':'Nothing here yet';if(!tasks.some(t=>t.status===status)){let b=document.createElement('button');b.textContent='+ Add a task';b.onclick=()=>openTask(null,status);empty.append(b)}list.append(empty)}col.querySelector('.column-add').onclick=()=>openTask(null,status);col.addEventListener('dragover',e=>{e.preventDefault();col.classList.add('drag-over')});col.addEventListener('dragleave',()=>col.classList.remove('drag-over'));col.addEventListener('drop',e=>{e.preventDefault();col.classList.remove('drag-over');let t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=status;if(status==='done')t.completed=Date.now();else delete t.completed;save()}});board.append(col)}}function makeCard(t){let c=document.createElement('article');c.className='task-card';c.draggable=true;c.dataset.id=t.id;let due='';if(t.due){let d=new Date(t.due+'T00:00:00');due=d.toLocaleDateString(undefined,{month:'short',day:'numeric'});if(t.due<today()&&t.status!=='done')due=`Overdue · ${due}`}c.innerHTML=`<div class="task-top"><button class="task-check" aria-label="${t.status==='done'?'Reopen':'Complete'} task">${t.status==='done'?'✓':''}</button><div class="task-title" tabindex="0">${esc(t.title)}</div><button class="more-button" aria-label="Edit task">···</button></div>${t.details?`<div class="task-details">${esc(t.details)}</div>`:''}<div class="task-meta"><span class="priority ${esc(t.priority)}">${esc(t.priority||'medium')}</span>${t.tag?`<span class="tag">${esc(t.tag)}</span>`:''}${due?`<span class="due ${t.due<today()&&t.status!=='done'?'overdue':t.due===today()?'today':''}">${esc(due)}</span>`:''}</div>`;c.querySelector('.task-check').onclick=()=>{t.status=t.status==='done'?'todo':'done';if(t.status==='done')t.completed=Date.now();else delete t.completed;save()};c.querySelector('.task-title').onclick=()=>openTask(t);c.querySelector('.task-title').onkeydown=e=>{if(e.key==='Enter')openTask(t)};c.querySelector('.more-button').onclick=()=>openTask(t);c.ondragstart=e=>{e.dataTransfer.setData('text/plain',t.id);c.classList.add('dragging')};c.ondragend=()=>c.classList.remove('dragging');return c}function openTask(t=null,status='todo'){editing=t?.id||null;$('#dialogTitle').textContent=t?'Edit task':'New task';$('#taskTitle').value=t?.title||'';$('#taskDetails').value=t?.details||'';$('#taskStatus').value=t?.status||status;$('#taskPriority').value=t?.priority||'medium';$('#taskDue').value=t?.due||'';$('#taskTag').value=t?.tag||'';$('#deleteTaskBtn').style.visibility=t?'visible':'hidden';dialog.showModal();setTimeout(()=>$('#taskTitle').focus(),30)}form.onsubmit=e=>{e.preventDefault();let title=$('#taskTitle').value.trim();if(!title)return;let t=tasks.find(x=>x.id===editing);if(!t){t={id:uid(),created:Date.now()};tasks.unshift(t)}Object.assign(t,{title,details:$('#taskDetails').value.trim(),status:$('#taskStatus').value,priority:$('#taskPriority').value,due:$('#taskDue').value,tag:$('#taskTag').value.trim()});if(t.status==='done'&&!t.completed)t.completed=Date.now();if(t.status!=='done')delete t.completed;dialog.close();save();showToast(editing?'Task updated':'Task added');editing=null};$('#deleteTaskBtn').onclick=()=>{if(editing&&confirm('Delete this task? This cannot be undone.')){tasks=tasks.filter(t=>t.id!==editing);dialog.close();editing=null;save();showToast('Task deleted')}};$('.close-dialog').onclick=$('.cancel-dialog').onclick=()=>dialog.close();dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});document.querySelectorAll('.filter').forEach(b=>b.onclick=()=>{filter=b.dataset.filter;document.querySelectorAll('.filter').forEach(x=>x.classList.toggle('active',x===b));focusOnly=false;render()});$('#searchInput').oninput=e=>{query=e.target.value.trim().toLowerCase();render()};$('#sortSelect').onchange=e=>{sort=e.target.value;render()};$('#newTaskBtn').onclick=()=>openTask();$('#focusNav').onclick=()=>{focusOnly=!focusOnly;filter='all';document.querySelectorAll('.filter').forEach(x=>x.classList.toggle('active',x.dataset.filter==='all'));$('#focusNav').classList.toggle('active',focusOnly);render();showToast(focusOnly?'Showing open tasks':'Showing all tasks')};$('#clearDoneBtn').onclick=()=>{let n=tasks.filter(t=>t.status==='done').length;if(!n)return showToast('No completed tasks to clear');if(confirm(`Clear ${n} completed task${n===1?'':'s'}?`)){tasks=tasks.filter(t=>t.status!=='done');save();showToast('Completed tasks cleared')}};$('#exportBtn').onclick=()=>{let a=document.createElement('a'),url=URL.createObjectURL(new Blob([JSON.stringify({version:1,tasks},null,2)],{type:'application/json'}));a.href=url;a.download=`daymark-backup-${today()}.json`;a.click();URL.revokeObjectURL(url);showToast('Board backup downloaded')};$('#importBtn').onclick=()=>$('#importFile').click();$('#importFile').onchange=async e=>{try{let data=JSON.parse(await e.target.files[0].text()),incoming=Array.isArray(data)?data:data.tasks;if(!Array.isArray(incoming)||!incoming.every(t=>t&&typeof t.title==='string'))throw Error();if(confirm(`Import ${incoming.length} tasks? This replaces your current board.`)){tasks=incoming.map(t=>({...t,id:uid()}));save();showToast('Board imported')}}catch{showToast('That backup file could not be read')}e.target.value=''};$('#helpBtn').onclick=()=>alert('Keyboard shortcuts\n\nN — New task\n/ — Search tasks\nEsc — Close dialog\n\nDrag cards between columns to update their status.');document.addEventListener('keydown',e=>{if(e.key==='Escape'&&dialog.open)dialog.close();if(dialog.open||e.ctrlKey||e.metaKey||e.altKey)return;if(e.key.toLowerCase()==='n'&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();openTask()}if(e.key==='/'&&!['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){e.preventDefault();$('#searchInput').focus()}});load();render()})();
