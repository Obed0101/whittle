+      <div class="stats-row"><div class="stat"><span class="stat-icon green">↗</span><span><strong id="openCount">0</strong><small>Open tasks</small></span></div><div class="stat"><span class="stat-icon amber">◷</span><span><strong id="dueCount">0</strong><small>Due today</small></span></div><div class="stat"><span class="stat-icon violet">✓</span><span><strong id="doneCount">0</strong><small>Completed</small></span></div><div class="progress-wrap"><div class="progress-copy"><span>WEEKLY MOMENTUM</span><strong id="momentumText">0 / 5 tasks</strong></div><div class="progress-track"><div id="momentumBar"></div></div></div></div>
