+(() => {
+  const KEY='daymark-board-v1';
+  const seed=[
+    {id:'a1',title:'Plan the week ahead',desc:'Take a little time to decide what a good week looks like.',status:'backlog',priority:'high',due:'',label:'Planning',created:1},
+    {id:'a2',title:'Book annual check-up',desc:'Find a time that works and add it to the calendar.',status:'backlog',priority:'medium',due:'',label:'Personal',created:2},
+    {id:'a3',title:'Tidy up the reading list',desc:'Pick the next book and make some space on the shelf.',status:'backlog',priority:'low',due:'',label:'Home',created:3},
+    {id:'a4',title:'Finish draft of project brief',desc:'A first pass is enough. Share it for feedback when ready.',status:'progress',priority:'high',due:'',label:'Work',created:4},
+    {id:'a5',title:'Get outside for a walk',desc:'A short break still counts.',status:'progress',priority:'none',due:'',label:'Wellbeing',created:5},
+    {id:'a6',title:'Set up a monthly budget check-in',desc:'Keep it simple: review, adjust, move on.',status:'done',priority:'medium',due:'',label:'Personal',created:6}
+  ];
+  let tasks; try { tasks=JSON.parse(localStorage.getItem(KEY))||seed; } catch { tasks=seed; }
+  if(!Array.isArray(tasks)) tasks=seed;
+  let view='board', filter='all', query='', sortNewest=false, toastTimer;
+  const $=id=>document.getElementById(id), board=$('board'), dialog=$('taskDialog');
+  const columns=[['backlog','To do'],['progress','In progress'],['done','Done']];
+  const save=()=>localStorage.setItem(KEY,JSON.stringify(tasks));
+  const esc=s=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+  function notify(msg){const t=$('toast');t.textContent=msg;t.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.classList.remove('show'),2200)}
+  function dueText(date){if(!date)return '';const d=new Date(date+'T00:00:00'),today=new Date();today.setHours(0,0,0,0);const diff=Math.round((d-today)/86400000);return {text:diff<0?`Overdue · ${d.toLocaleDateString('en',{month:'short',day:'numeric'})}`:diff===0?'Today':diff===1?'Tomorrow':d.toLocaleDateString('en',{month:'short',day:'numeric'}),class:diff<0?'overdue':diff<=2?'soon':''}}
+  function visible(t){if(view==='today'){if(t.status==='done'||!t.due)return false;const d=new Date(t.due+'T00:00:00'),now=new Date();now.setHours(0,0,0,0);return (d-now)/86400000<=7} if(view==='completed'&&t.status!=='done')return false;if(view==='board'&&t.status==='done'){} if(filter==='high'&&t.priority!=='high')return false;return !query||`${t.title} ${t.desc} ${t.label}`.toLowerCase().includes(query.toLowerCase())}
+  function render(){const filtered=tasks.filter(visible);$('allCount').textContent=tasks.filter(t=>t.status!=='done').length;$('dueCount').textContent=tasks.filter(t=>t.status!=='done'&&t.due&&new Date(t.due+'T00:00:00')<=new Date(Date.now()+7*86400000)).length;
+    $('taskSummary').textContent=`${tasks.length} ${tasks.length===1?'task':'tasks'} total`;
+    const titles={board:['My board','A clear view of what matters right now.'],today:['Due soon','A little heads-up on what’s coming up.'],completed:['Completed','Look at how far you’ve come.']};$('pageTitle').innerHTML=`${titles[view][0]} <span class="title-dot"></span>`;$('crumb').textContent=titles[view][0];$('pageSubtitle').textContent=titles[view][1];$('filters').style.display=view==='board'?'flex':'none';$('clearCompleted').style.display=tasks.some(t=>t.status==='done')?'block':'none';
+    board.innerHTML='';columns.forEach(([status,title])=>{const col=document.createElement('section');col.className='column';col.dataset.status=status;const list=filtered.filter(t=>t.status===status).sort((a,b)=>sortNewest?b.created-a.created:a.created-b.created);col.innerHTML=`<div class="column-head"><i class="column-indicator"></i><span class="column-title">${title}</span><span class="column-count">${list.length}</span><button class="column-add" aria-label="Add task to ${title}" title="Add task">+</button></div><div class="cards"></div>`;const cards=col.querySelector('.cards');list.forEach(t=>cards.append(card(t)));if(!list.length)cards.innerHTML=`<div class="empty-column">${view==='today'?'Nothing due here.':view==='completed'?'No completed tasks yet.':'A little breathing room.'}${view==='board'&&status!=='done'?'<br><button class="empty-add">+ Add a task</button>':''}</div>`;col.querySelector('.column-add').onclick=()=>openTask(null,status);col.querySelector('.empty-add')?.addEventListener('click',()=>openTask(null,status));col.addEventListener('dragover',e=>{e.preventDefault();col.classList.add('drag-over')});col.addEventListener('dragleave',()=>col.classList.remove('drag-over'));col.addEventListener('drop',e=>{e.preventDefault();col.classList.remove('drag-over');const t=tasks.find(x=>x.id===e.dataTransfer.getData('text/plain'));if(t){t.status=status;save();render()}});board.append(col)});
+  }
+  function card(t){const el=document.createElement('article');el.className='task-card'+(t.status==='done'?' done-card':'');el.draggable=true;const due=dueText(t.due);el.innerHTML=`<div class="card-top"><span class="priority ${esc(t.priority)}"><i></i>${t.priority==='none'?'':esc(t.priority[0].toUpperCase()+t.priority.slice(1))}</span><button class="card-menu" aria-label="Edit ${esc(t.title)}">···</button></div><h3>${esc(t.title)}</h3>${t.desc?`<p class="card-description">${esc(t.desc)}</p>`:''}<div class="card-meta">${t.label?`<span class="tag">${esc(t.label)}</span>`:''}${due?`<span class="due ${due.class}">◷ ${esc(due.text)}</span>`:''}</div>`;el.onclick=()=>openTask(t.id);el.querySelector('.card-menu').onclick=e=>{e.stopPropagation();openTask(t.id)};el.addEventListener('dragstart',e=>{e.dataTransfer.setData('text/plain',t.id);e.dataTransfer.effectAllowed='move';el.classList.add('dragging')});el.addEventListener('dragend',()=>el.classList.remove('dragging'));return el}
+  function openTask(id,status='backlog'){const t=tasks.find(x=>x.id===id);$('taskForm').reset();$('taskId').value=t?.id||'';$('dialogTitle').textContent=t?'Edit task':'New task';$('taskName').value=t?.title||'';$('taskDesc').value=t?.desc||'';$('taskStatus').value=t?.status||status;$('taskPriority').value=t?.priority||'none';$('taskDue').value=t?.due||'';$('taskLabel').value=t?.label||'';$('deleteTask').style.display=t?'block':'none';dialog.showModal();setTimeout(()=>$('taskName').focus(),50)}
+  $('addTask').onclick=()=>openTask();$('taskForm').onsubmit=e=>{e.preventDefault();const id=$('taskId').value, data={title:$('taskName').value.trim(),desc:$('taskDesc').value.trim(),status:$('taskStatus').value,priority:$('taskPriority').value,due:$('taskDue').value,label:$('taskLabel').value.trim()};if(!data.title)return;if(id){Object.assign(tasks.find(t=>t.id===id),data);notify('Task updated')}else{tasks.unshift({id:crypto.randomUUID?crypto.randomUUID():String(Date.now()),...data,created:Date.now()});notify('Task added')}save();dialog.close();render()};
+  function removeTask(){const id=$('taskId').value;if(id&&confirm('Delete this task? This can’t be undone.')){tasks=tasks.filter(t=>t.id!==id);save();dialog.close();render();notify('Task deleted')}}$('deleteTask').onclick=removeTask;$('closeDialog').onclick=$('cancelDialog').onclick=()=>dialog.close();$('searchInput').oninput=e=>{query=e.target.value;render()};$('sortBtn').onclick=()=>{sortNewest=!sortNewest;render();notify(sortNewest?'Showing newest first':'Showing oldest first')};$('filters').onclick=e=>{const b=e.target.closest('[data-filter]');if(!b)return;filter=b.dataset.filter;document.querySelectorAll('.filter').forEach(x=>x.classList.toggle('active',x===b));render()};document.querySelector('.side-nav').onclick=e=>{const b=e.target.closest('[data-view]');if(!b)return;view=b.dataset.view;document.querySelectorAll('.nav-item').forEach(x=>x.classList.toggle('active',x===b));render()};$('clearCompleted').onclick=()=>{const count=tasks.filter(t=>t.status==='done').length;if(count&&confirm(`Clear ${count} completed ${count===1?'task':'tasks'}?`)){tasks=tasks.filter(t=>t.status!=='done');save();render();notify('Completed tasks cleared')}};
+  $('helpBtn').onclick=()=> $('helpDialog').showModal();$('closeHelp').onclick=$('gotIt').onclick=()=> $('helpDialog').close();$('profileBtn').onclick=()=>notify('Your board is saved on this device');document.addEventListener('keydown',e=>{if(e.key==='Escape')return;if(e.target.matches('input,textarea,select')){if(e.key==='Escape')e.target.blur();return}if(e.key.toLowerCase()==='n'){e.preventDefault();openTask()}if(e.key==='/'){e.preventDefault();$('searchInput').focus()}});
+  $('dateLabel').textContent=new Date().toLocaleDateString('en',{weekday:'long',month:'long',day:'numeric'}).toUpperCase();render();
+})();
