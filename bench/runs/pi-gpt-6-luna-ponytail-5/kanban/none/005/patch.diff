+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f7f8fa">
+<title>Daymark — Personal board</title><link rel="stylesheet" href="styles.css">
+</head>
+<body>
+<div class="app-shell">
+  <aside class="sidebar">
+    <a class="brand" href="#" aria-label="Daymark home"><span class="brand-mark">◒</span><span>daymark</span></a>
+    <div class="workspace-label">PERSONAL WORKSPACE</div>
+    <nav class="side-nav" aria-label="Main navigation">
+      <button class="nav-item active" data-view="board"><span>▦</span> My board</button>
+      <button class="nav-item" data-view="today"><span>◷</span> Due soon <span class="nav-count" id="dueCount">0</span></button>
+      <button class="nav-item" data-view="completed"><span>✓</span> Completed</button>
+    </nav>
+    <div class="sidebar-bottom"><div class="tip-card"><span class="tip-icon">✳</span><strong>Make room for focus.</strong><p>A small list you trust beats a big list you avoid.</p></div><button class="profile" id="profileBtn"><span class="avatar">Y</span><span><strong>Your workspace</strong><small>Personal plan</small></span><span class="profile-dots">···</span></button></div>
+  </aside>
+  <main class="main-area">
+    <header class="topbar"><div class="breadcrumb">Workspace <span>/</span> <strong id="crumb">My board</strong></div><div class="top-actions"><button class="icon-button" id="helpBtn" aria-label="Keyboard shortcuts" title="Keyboard shortcuts">?</button><button class="avatar mini">Y</button></div></header>
+    <section class="content">
+      <div class="page-heading"><div><div class="eyebrow" id="dateLabel">YOUR SPACE, AT YOUR PACE</div><h1 id="pageTitle">My board <span class="title-dot"></span></h1><p id="pageSubtitle">A clear view of what matters right now.</p></div><button class="primary-button" id="addTask"><span>＋</span> Add task <kbd>N</kbd></button></div>
+      <div class="toolbar"><div class="filter-tabs" id="filters"><button class="filter active" data-filter="all">All tasks <span id="allCount">0</span></button><button class="filter" data-filter="high">High priority</button></div><div class="tools"><label class="search"><span>⌕</span><input id="searchInput" placeholder="Search tasks..." aria-label="Search tasks"><kbd>/</kbd></label><button class="sort-button" id="sortBtn">↕ <span>Sort</span></button></div></div>
+      <div class="board" id="board" aria-label="Kanban board"></div>
+      <div class="board-footer"><span><span class="live-dot"></span> Saved automatically</span><span id="taskSummary"></span><button id="clearCompleted" class="text-button">Clear completed</button></div>
+    </section>
+  </main>
+</div>
+<div class="toast" id="toast" role="status"></div>
+<dialog id="taskDialog" class="task-dialog"><form id="taskForm"><div class="dialog-top"><div><div class="eyebrow">TASK DETAILS</div><h2 id="dialogTitle">New task</h2></div><button type="button" class="close-button" id="closeDialog" aria-label="Close">×</button></div><input type="hidden" id="taskId"><label class="field-label" for="taskName">Task name <span>*</span></label><input class="text-field" id="taskName" maxlength="100" placeholder="What needs to get done?" required><label class="field-label" for="taskDesc">Notes <small>optional</small></label><textarea class="text-field" id="taskDesc" rows="3" maxlength="500" placeholder="Add a little context..."></textarea><div class="field-row"><div><label class="field-label" for="taskStatus">Status</label><select class="text-field" id="taskStatus"><option value="backlog">To do</option><option value="progress">In progress</option><option value="done">Done</option></select></div><div><label class="field-label" for="taskPriority">Priority</label><select class="text-field" id="taskPriority"><option value="none">No priority</option><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select></div></div><div class="field-row"><div><label class="field-label" for="taskDue">Due date</label><input class="text-field" id="taskDue" type="date"></div><div><label class="field-label" for="taskLabel">Label</label><input class="text-field" id="taskLabel" maxlength="24" placeholder="e.g. Personal"></div></div><div class="dialog-actions"><button type="button" class="delete-button" id="deleteTask">Delete task</button><span class="spacer"></span><button type="button" class="secondary-button" id="cancelDialog">Cancel</button><button class="primary-button" type="submit">Save task</button></div></form></dialog>
+<dialog id="helpDialog" class="help-dialog"><button class="close-button help-close" id="closeHelp">×</button><div class="eyebrow">A FEW SHORTCUTS</div><h2>Move at your pace.</h2><p><kbd>N</kbd> Add a task <kbd>/</kbd> Search <kbd>Esc</kbd> Close dialogs</p><p>Drag a task between columns to update its status. Your board is saved on this device.</p><button class="primary-button" id="gotIt">Got it</button></dialog>
+<script src="app.js"></script>
+</body></html>
