+document.getElementById('newTask').onclick=()=>openTask();document.getElementById('cancel').onclick=close;wrap.addEventListener('click',e=>{if(e.target===wrap)close()});document.addEventListener('keydown',e=>{if(e.key==='Escape')close();if((e.metaKey||e.ctrlKey)&&e.key==='Enter'&&wrap.classList.contains('open'))form.requestSubmit()});form.onsubmit=e=>{e.preventDefault();let id=document.getElementById('taskId').value,t={id:id||crypto.randomUUID(),title:document.getElementById('title').value.trim(),description:document.getElementById('description').value.trim(),category:document.getElementById('category').value,priority:document.getElementById('prioritySelect').value,due:document.getElementById('dueDate').value,status:document.getElementById('status').value};if(!t.title)return;if(id)data[data.findIndex(x=>x.id===id)]=t;else data.unshift(t);save();render();close();notify(id?'Task updated':'Task added')};document.getElementById('deleteTask').onclick=()=>{let id=document.getElementById('taskId').value;if(id&&confirm('Delete this task? This cannot be undone.')){data=data.filter(t=>t.id!==id);save();render();close();notify('Task deleted')}};document.getElementById('filters').onclick=e=>{let b=e.target.closest('[data-filter]');if(!b)return;activeFilter=b.dataset.filter;document.querySelectorAll('.filter').forEach(x=>x.classList.toggle('active',x===b));render()};document.getElementById('search').oninput=e=>{query=e.target.value.trim().toLowerCase();render()};document.getElementById('sort').onchange=e=>{sort=e.target.value;render()};document.getElementById('clearDone').onclick=()=>{let n=data.filter(t=>t.status==='done').length;if(!n){notify('No completed tasks to clear');return}if(confirm(`Remove ${n} completed ${n===1?'task':'tasks'}?`)){data=data.filter(t=>t.status!=='done');save();render();notify('Completed tasks cleared')}};document.getElementById('exportBtn').onclick=()=>{let blob=new Blob([JSON.stringify({exported:new Date().toISOString(),tasks:data},null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`daymark-board-${today()}.json`;a.click();URL.revokeObjectURL(a.href);notify('Board backup downloaded')};render()})();
