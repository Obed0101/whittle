+<script>
+(()=>{'use strict';const KEY='daymark-board-v1',columns=[['todo','To do'],['progress','In progress'],['done','Done']];const today=()=>{let d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`};const dateLabel=document.getElementById('dateLabel');dateLabel.textContent=new Intl.DateTimeFormat(undefined,{weekday:'short',month:'short',day:'numeric'}).format(new Date());let data;try{data=JSON.parse(localStorage.getItem(KEY))}catch{};if(!Array.isArray(data))data=[{id:'a1',title:'Plan the week ahead',description:'Take a moment to choose what deserves your attention.',category:'personal',priority:'medium',due:today(),status:'todo'},{id:'a2',title:'Send project update',description:'Share the latest milestones and next steps with the team.',category:'work',priority:'high',due:'',status:'todo'},{id:'a3',title:'Book a dentist appointment',description:'',category:'health',priority:'low',due:'',status:'todo'},{id:'a4',title:'Review the reading list',description:'Pick one book to start this month.',category:'personal',priority:'low',due:'',status:'progress'},{id:'a5',title:'Refresh portfolio homepage',description:'',category:'work',priority:'medium',due:'',status:'progress'},{id:'a6',title:'Get outside for a walk',description:'A short reset counts.',category:'health',priority:'low',due:'',status:'done'}];let activeFilter='all',query='',sort='manual',dragId=null,toastTimer;const board=document.getElementById('board'),wrap=document.getElementById('modalWrap'),form=document.getElementById('taskForm');function save(){localStorage.setItem(KEY,JSON.stringify(data))}function esc(s){return String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function dueInfo(d){if(!d)return'';let delta=Math.round((new Date(d+'T00:00:00')-new Date(today()+'T00:00:00'))/86400000),label=delta<0?`${Math.abs(delta)}d overdue`:delta===0?'Today':delta===1?'Tomorrow':new Intl.DateTimeFormat(undefined,{month:'short',day:'numeric'}).format(new Date(d+'T00:00:00'));return `<span class="due ${delta<0?'overdue':delta===0?'today':''}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>${label}</span>`}function included(t){if(activeFilter==='today'&&t.due!==today())return false;if(activeFilter==='overdue'&&(!t.due||t.due>=today()||t.status==='done'))return false;if(activeFilter==='high'&&t.priority!=='high')return false;return !query||`${t.title} ${t.description} ${t.category}`.toLowerCase().includes(query)}
+function render(){let open=data.filter(t=>t.status!=='done').length,done=data.filter(t=>t.status==='done').length,overdue=data.filter(t=>t.due&&t.due<today()&&t.status!=='done').length;document.getElementById('summary').innerHTML=`<span class="summary-item"><b>${open}</b> open tasks</span><span class="summary-sep"></span><span class="summary-item"><b>${done}</b> completed</span>${overdue?`<span class="summary-sep"></span><span class="summary-item" style="color:#bd6251"><b style="color:#bd6251">${overdue}</b> overdue</span>`:''}<span class="summary-sep"></span><span class="progress"><i style="width:${data.length?Math.round(done/data.length*100):0}%"></i></span><span class="summary-item">${data.length?Math.round(done/data.length*100):0}% complete</span>`;board.innerHTML=columns.map(([key,label])=>{let tasks=data.filter(t=>t.status===key&&included(t));if(sort==='due')tasks.sort((a,b)=>(a.due||'9999').localeCompare(b.due||'9999'));if(sort==='priority')tasks.sort((a,b)=>({high:0,medium:1,low:2}[a.priority]||0)-({high:0,medium:1,low:2}[b.priority]||0));return `<section class="column" data-status="${key}"><div class="col-head"><div class="col-title"><i class="dot"></i>${label}<span class="count">${tasks.length}</span></div><button class="add-small" data-add="${key}" title="Add to ${label}" aria-label="Add task to ${label}">+</button></div><div class="cards" data-list="${key}">${tasks.length?tasks.map(card).join(''):'<div class="empty"><b>Nothing here just yet</b>Drop a task here, or add one.</div>'}</div></section>`}).join('');board.querySelectorAll('.card').forEach(el=>{el.addEventListener('dragstart',e=>{dragId=el.dataset.id;el.classList.add('dragging');e.dataTransfer.effectAllowed='move'});el.addEventListener('dragend',()=>{el.classList.remove('dragging');dragId=null;board.querySelectorAll('.column').forEach(c=>c.classList.remove('drag-over'))});el.addEventListener('click',e=>{if(!e.target.closest('.menu-btn'))openTask(el.dataset.id)})});board.querySelectorAll('.column').forEach(col=>{col.addEventListener('dragover',e=>{e.preventDefault();col.classList.add('drag-over')});col.addEventListener('dragleave',e=>{if(!col.contains(e.relatedTarget))col.classList.remove('drag-over')});col.addEventListener('drop',e=>{e.preventDefault();col.classList.remove('drag-over');let t=data.find(x=>x.id===dragId);if(t){t.status=col.dataset.status;save();render()}})});board.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>openTask(null,b.dataset.add));board.querySelectorAll('.menu-btn').forEach(b=>b.onclick=e=>{e.stopPropagation();openTask(b.closest('.card').dataset.id)})}
+function card(t){let pr=t.priority||'low';return `<article class="card" draggable="true" data-id="${esc(t.id)}" tabindex="0" role="button" aria-label="Edit ${esc(t.title)}"><div class="card-top"><h3>${esc(t.title)}</h3><button class="menu-btn" aria-label="Edit task">···</button></div>${t.description?`<p class="card-desc">${esc(t.description)}</p>`:''}<div class="card-bottom"><div class="meta">${dueInfo(t.due)}</div><span class="tag ${['work','personal','health'].includes(t.category)?t.category:''}">${esc((t.category||'other').replace(/^./,c=>c.toUpperCase()))}</span></div><div style="margin-top:9px"><span class="priority ${pr}"><i></i>${pr[0].toUpperCase()+pr.slice(1)} priority</span></div></article>`}
